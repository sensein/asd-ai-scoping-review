    slr:journal "Autism Research, 9(8), 888-898" ;
    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Clinician DSM-IV diagnosis confirmed only by the AQ-Child questionnaire; the authors state ADOS and ADI-R were unavailable, so no standardised observational instrument underpins the labels." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "Convenience clinical sample with 33% ASD prevalence versus ~1% in the population - a spectrum bias the authors themselves flag - but with unusually careful construction of two separately matched control groups and identical sex ratios." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "The cluster number K and the participant-level decision threshold were tuned to maximise accuracy on the same 87 participants, and K-means quantisation was fitted over all participants' fixations including the held-out one, so the reported figures are optimistic despite the leave-one-out outer loop." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "All 87 participants contributed data and were classified; index and reference assessments are contemporaneous; no exclusions or missing data reported." ] ;
            slr:overall_judgment "high" ;
            slr:tool_used "QUADAS-2" ] .

<urn:slr:article:80626146cad2> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Autism Spectrum Disorder (ASD) is increasingly prevalent [1], but long waitlists hinder children’s access to expedient diagnosis and treatment. To begin addressing this problem, we developed an automated system to detect ASD using acoustic and text features drawn from short, unstructured conversations with naïve conversation partners (confederates). Seventy children (35 with ASD and 35 typically developing (TD)) discussed a range of generic topics (e.g., pets, family, hobbies, and sports) with confederates for approximately 5 minutes. A total of 624 features (352 acoustic + 272 text) were incorporated into a Gradient Boosting Model. To reduce dimensionality and avoid overfitting, we dropped insignificant features and applied feature reduction using Principal Component Analysis. Our final model was accurate substantially above chance levels. Predictive features were both acoustic-phonetic and lexical, from both participants and confederates. The goal of this project is to develop an automatic detection system for ASD that relies on very brief, generic, and natural conversations, which can eventually be used for ASD prescreening and triage in realworld settings such as doctor’s offices and schools." ;
    dcterms:bibliographicCitation "Cho S; Liberman M; Ryant N; Cola M; Schultz RT; Parish-Morris J (2019). Automatic Detection of Autism Spectrum Disorder in Children Using Acoustic and Text Features from Brief Natural Conversations. *In*." ;
    dcterms:creator "Cho S",
        "Cola M",
        "Liberman M",
        "Parish-Morris J",
        "Ryant N",
        "Schultz RT" ;
    dcterms:title "Automatic Detection of Autism Spectrum Disorder in Children Using Acoustic and Text Features from Brief Natural Conversations" ;
    bibo:pmid "local_51533de4" ;
    fabio:hasPublicationYear 2019 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are participant characteristics reported consistently?" ;
                            slr:justification "The demographic table's sex counts sum to 25 rather than the stated 35 in both groups." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are comparison groups matched on the variables that matter?" ;
                            slr:justification "Matched and tested on full-scale, verbal and non-verbal IQ and sex ratio, with age difference also tested." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the sample appropriate and adequate for the stated target?" ;
                            slr:justification "70 children is respectable for this corpus but modest for a screening claim; single site, native English speakers only." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are participants and recruitment adequately described?" ;
                            slr:justification "Group sizes, ages, three IQ measures, ADOS-2 severity scores and SCQ scores all reported with group comparisons; confederate characteristics also given." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "low" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the elicitation ecologically valid for the stated deployment?" ;
                            slr:justification "Unstructured conversation with a non-expert partner is deliberately chosen over ADOS-derived speech precisely to support community prescreening." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the behavioral data acquisition described reproducibly?" ;
                            slr:justification "Recording apparatus, conversation instruction, duration, confederate blinding and assignment, and the full transcription training and reliability protocol are specified." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the reference standard appropriate and independently applied?" ;
                            slr:justification "Clinical Best Estimate with ADOS-2 under DSM-5, applied to both confirm and rule out, with severity scores reported." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are predictors defined without knowledge of outcome?" ;
                            slr:justification "Confederates were unaware of participants' diagnostic status; features are extracted by automated toolkits from verbatim transcripts and audio." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "low" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the sample size adequate for the feature dimensionality?" ;
                            slr:justification "624 features against 70 children, but explicitly reduced to 24-39 per fold and then to 10 principal components, with the overfitting risk reasoned about openly." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are potential confounds tested?" ;
                            slr:justification "Age, sex and IQ were added as model inputs and reported as unhelpful or harmful, consistent with prior matching." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is a meaningful performance ceiling established?" ;
                            slr:justification "Human raters on a matched 12-conversation subset provide an empirical benchmark showing the task is difficult for people too." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is there external or independent validation?" ;
                            slr:justification "None; larger datasets and real-world application are named as future work." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is feature selection nested within the validation loop?" ;
                            slr:justification "Correlation filtering and PCA both performed within each cross-validation fold, with per-fold selection counts reported." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "low" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are claims proportionate to the evidence?" ;
                            slr:justification "The authors state explicitly that the approach 'is not yet valuable as a method for diagnosing ASD, which still needs to be diagnosed by expert clinicians'." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the dataset accessible or its access conditions stated?" ;
                            slr:justification "No data availability statement for a corpus that would be highly valuable and is highly sensitive." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is code available?" ;
                            slr:justification "None, though all toolkits, configurations and thresholds are named." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are ethics, consent and assent reported?" ;
                            slr:justification "Named IRB approval and oversight, written parental informed consent, and verbal assent from the children." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are per-class results and asymmetries reported?" ;
                            slr:justification "TD 85.71% versus ASD 65.71% reported prominently with precision, recall and F1 per class." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "some concerns" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Hardware: a 'Biosensor' recording device placed on a table between the two speakers, with two HD video cameras facing opposite directions to capture both participants simultaneously and four embedded directional microphones. Software: sox for format conversion; openSMILE with the ComParE13 configuration (25 ms window, 10 ms step) for acoustic low-level descriptors; XTrans for time-aligned orthographic transcription; base R, qdap and LIWC plus a custom author script for text features; scikit-learn (SimpleImputer, PCA, GradientBoostingClassifier) in Python." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-019" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Engineer features that directly capture semantic and pragmatic appropriateness turn by turn, since that is what human raters used and the model lacked; enlarge the dataset to improve performance and enable real-world deployment; and test whether longer conversations (10 rather than 5 minutes) and designated topics improve performance. All three are grounded in specific observed shortfalls rather than generic." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-019" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Index terms: clinical speech, machine learning, Autism Spectrum Disorder. Task vocabulary: 'automatic detection system', 'prescreening and triage', 'brief, generic, and natural conversations', 'naive conversation partners (confederates)', 'real-world settings such as doctor's offices and schools'. The prescreening-and-triage framing, explicitly distinguished from diagnosis, is more careful than most of the corpus." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-019" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No data availability statement and no code release, which is a real gap for a corpus this valuable. Method reporting is otherwise strong: the openSMILE configuration and window/step sizes, the full list of 44 low-level descriptors, the exact feature arithmetic (44 x 2 speakers x 4 functionals = 352), the six text-feature groups totalling 272, the voiceless-frame exclusion rule, the pitch normalisation formula with the 5th-percentile baseline, the correlation threshold (p<0.025), the number of components retained (10), the classifier, the libraries, and the annotation training and reliability criteria are all specified. The pipeline is re-implementable; the conversations are not accessible." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-019" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two groups of 35: children with ASD and typically developing children, plus 22 young adult confederates (19 female) who served as conversation partners and whose speech was also analysed. The confederates are effectively a third participant group whose data enter the model - an unusual design in this corpus. No other-diagnosis comparison group." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-019" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The strongest reference standard in the corpus: diagnoses were confirmed for the ASD group and ruled out for the TD group using the Clinical Best Estimate process informed by ADOS-2 and adhering to DSM-5 criteria. Crucially the same rigorous process was applied to controls, not just cases - the inverse of the common corpus pattern where control screening is better specified than case ascertainment. Symptom severity was additionally characterised with ADOS-2 Calibrated Severity Scores and the Social Communication Questionnaire for both groups." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-019" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Speech and language jointly: acoustic-phonetic properties (voicing probability, pitch, jitter, shimmer, HNR, energy, MFCCs, zero-crossing rate and their deltas) and lexical/discourse properties (pause and overlap metrics, turn metrics, speaking rate, word complexity, LIWC psycholinguistic categories, lexical entropy and diversity, parts of speech, formality, polarity). Distinctively, all of these are computed for both the child and the adult conversation partner." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-019" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Handcrafted features at two levels: frame-level acoustic descriptors summarised per speaker per conversation by four statistical functionals, and text-derived lexical, syntactic and discourse counts. These are then projected onto 10 principal components for modelling, so the classifier operates on a learned low-dimensional linear subspace of handcrafted features rather than on the features directly." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-019" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Clinic/research setting at a hospital autism centre. Newly collected data; the design deliberately departs from the field's reliance on ADOS-derived or highly structured speech samples in favour of naturalistic conversation with a non-expert partner." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-019" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Accuracy, precision, recall and F1 per class and averaged, plus a ROC curve with AUC - and, unusually, the identical metric set computed for human raters so the two can be read side by side. Headline: 75.71% accuracy, AUC 75.43%, with the per-class asymmetry (TD 85.71%, ASD 65.71%) reported prominently rather than buried in an average. No confidence intervals." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-019" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional; a single 5-minute conversation per child with no follow-up. The data are highly sensitive - audio and video of identifiable children in unscripted personal conversation, plus verbatim transcripts. Ethics reporting is complete and among the best in the corpus: IRB approval and oversight from the Children's Hospital of Philadelphia, written parental informed consent, and verbal assent from the children themselves. No anonymization or retention procedure for the recordings is described." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-019" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "'children with ASD', 'children on the autism spectrum', 'ASD children', 'typically developing (TD) children', 'TDC', and one appearance of 'ASD patients' in the discussion. Predominantly person-first with the notable use of 'children on the autism spectrum' in the introduction, and 'typically developing' rather than 'normal' throughout." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-019" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two-way fusion. Across modality: 352 acoustic and 272 text features are concatenated into a single 624-dimensional vector, then reduced by correlation filtering and PCA - so acoustic and lexical information are combined at feature level. Across speaker: features from the child and the confederate are both included, and the results show confederate features were selected in all 70 folds for several jitter and HNR measures, making interlocutor behaviour an explicit part of the model. Demographic and clinical variables were tested as additional inputs and reported as unhelpful (age and sex) or harmful (IQ), which the authors correctly attribute to prior matching - a negative fusion result reported rather than omitted." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-019" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Well developed. Selection frequency across the 70 folds is reported per feature, distinguishing features chosen in all folds from those chosen occasionally, which is a more informative importance measure than a single ranking. Post-hoc linear regressions give directions and significance for key features. The substantive findings are specific: autistic children showed higher median HNR-delta, lower voicing-probability variability and reduced pitch dynamism (lower IQR of F0-delta); and confederates showed higher HNR-delta and lower jitter when talking to autistic children. The paper also collects qualitative human-rater justifications - flat intonation, long response latency, brief responses, frequent 'I don't know', topic changes, few follow-up questions - and uses them to diagnose what the automatic feature set is missing." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-019" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Goal: automatic ASD prescreening and triage from brief natural conversation, explicitly aimed at community settings such as doctors' offices and schools and motivated by diagnostic waitlists. Main findings: 75.71% accuracy, AUC 0.754; markedly better at identifying TD (85.71%) than ASD (65.71%) children; human raters reached 83.33% on a matched subset, so the model approaches but does not match human performance; confederate speech features were among the most consistently predictive; and adding age, sex or IQ did not improve and IQ worsened performance because the groups were already matched on them." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-019" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "INTERSPEECH 2019 (Graz) - a speech science and technology venue, not an autism or clinical journal, though the author list spans a linguistic data consortium, a hospital autism centre and university paediatrics and psychiatry departments." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-019" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Reported by the authors: performance is limited by 5-minute samples and generic topics compared with ADOS evaluations designed to elicit ASD-like features; human raters outperformed the model, which the authors read as evidence that the feature set fails to capture topicality, relevance, appropriateness and conversational flow at a turn-by-turn level; ASD is harder to predict than TD because of phenotypic heterogeneity; and the approach 'is not yet valuable as a method for diagnosing ASD, which still needs to be diagnosed by expert clinicians'. Identifiable in review: the demographic table's sex counts sum to 25 rather than 35 in both groups; the confederate features that are among the most consistently selected mean part of the signal is an interlocutor's response to the child rather than the child's own behaviour, which limits transfer to any self-administered or partner-free screening context; all participants were native English speakers at a single site, with no ethnicity or socioeconomic data; confederates were 19 of 22 female, so partner-sex variation is minimal; and n=70 makes 75.71% equal to 53 of 70 children." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-019" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Feature selection is explicitly nested: univariate correlation filtering is performed 'within each cross-validation fold' (selecting 24-39 features per fold, 60 distinct features overall) and PCA is applied 'within each CV fold', with leave-one-out cross-validation over 70 children. This is the correct structure and avoids the selection leakage that affects most of the corpus. Robustness is further probed by testing whether demographic and IQ variables improve the model - they do not - which is a form of confound check. What is absent: external or independent validation, any held-out site, calibration analysis, and any real-world deployment test despite community prescreening being the stated goal. The human-rater comparison functions as an informal ceiling estimate rather than a validation." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-019" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Full-scale, verbal and non-verbal IQ measured with the WASI-II for both groups and used as matching variables with all comparisons tested. ADOS-2 Calibrated Severity Scores (overall, social affect, restricted and repetitive behaviour) and SCQ lifetime scores reported for both groups with group comparisons. All participants were native English speakers. Comorbid conditions are not described." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-019" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2019. The paper characterises the speech-and-autism literature as drawing overwhelmingly on either highly structured elicitation (reading sentences or word lists) or semi-structured clinical interviews with an autism expert, chiefly ADOS evaluations, and argues these 'produce results that may not generalize to the everyday conversations that impact the lives of children on the autism spectrum'. It cites specific prior accuracies for calibration - roughly 74% from pitch features on 146 children, roughly 69% from speech rate and rhythm on 69 children - and identifies interlocutor speech features as an emerging and underused signal, noting prior findings that psychologists' speech predicted children's symptom severity better than the children's own features. This move from clinical-elicitation corpora toward naturalistic interaction is one of the clearest trend statements in the corpus." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-019" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "ASD n=35, mean age 11.42 +/- 2.51, full-scale IQ 105.51, verbal IQ 104.97, non-verbal IQ 104.63. TD n=35, mean age 10.57 +/- 2.82, full-scale IQ 107.14, verbal IQ 105.83, non-verbal IQ 105.97. Age difference non-significant (t=1.33, p=0.19); IQ differences non-significant on all three measures (p=0.6, 0.78, 0.68); sex ratio matched by design and non-significant (chi-square=0.06, p=0.8). This is among the best-matched samples in the corpus - matched and tested on full-scale, verbal and non-verbal IQ as well as sex. The one defect is that the printed sex counts ('13 f., 12 m.' and '11 f., 14 m.') sum to 25 rather than the stated 35 per group." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-019" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A 5-minute unstructured 'get-to-know-you' conversation with a novel young adult confederate blind to diagnostic status and assigned by availability. No conversational prompts were given to either speaker. Recordings were made with a device placed between the speakers carrying two opposed HD cameras and four directional microphones. Transcription used a rigorous protocol: two junior annotators (one segmenting pause groups, one transcribing words) plus a senior annotator with at least six months' experience reviewing and correcting every file, with all annotators having completed at least 10 hours of Quick Transcription training modified for clinical ASD interviews and having achieved over 90% agreement with a gold-standard transcript before independent work." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-019" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Supervised learning: a Gradient Boosting Classifier from scikit-learn. Principal Component Analysis is used unsupervised for dimensionality reduction. No comparison against alternative classifiers, which removes best-of-many selection optimism but also leaves the algorithm choice unjustified empirically." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-019" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "Single session; approximately 5 minutes of unstructured conversation per child" ;
                    slr:study_design "Cross-sectional case-control classification study with a parallel human-rater benchmark" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: 35 (13 female); comparison: 35 (11 female)" ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "Five minutes of unstructured conversation with a naive partner supported ASD classification at 75.71% accuracy (AUC 0.754), approaching but not matching two briefly-trained undergraduate raters who reached 83.33% on a matched subset. Both the model and the humans were markedly better at identifying typically developing children than autistic ones, which the authors attribute to phenotypic heteroge",
                        "Overall accuracy 75.71%, AUC 75.43%. Per class: TD accuracy 85.71% (30/35), ASD accuracy 65.71% (23/35); ASD precision 0.82, recall 0.66, F1 0.73; TD precision 0.71, recall 0.86, F1 0.78. Human raters on a matched 12-conversation subset: mean accuracy 83.33% (Student A 91.7%, Student B 75%), ASD accuracy 67%, TD accuracy 100%" ;
                    slr:outcome "Accuracy, precision, recall and F1 reported per class and averaged, plus a ROC curve with AUC, and the same metric set computed for human raters for direct comparison" ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "Overall accuracy 75.71%, AUC 75.43%. Per class: TD accuracy 85.71% (30/35), ASD accuracy 65.71% (23/35); ASD precision 0.82, recall 0.66, F1 0.73; TD precision 0.71, recall 0.86, F1 0.78. Human raters on a matched 12-conversation subset: mean accuracy 83.33% (Student A 91.7%, Student B 75%), ASD accuracy 67%, TD accuracy 100%; Five minutes of unstructured conversation with a naive partner supported ASD classification at 75.71% accuracy (AUC 0.754), approaching but not matching two briefly-trained undergraduate raters who reached 83.33% on a matched subset. Both the model and the humans were markedly better at identifying typically developing children than autistic ones, which the authors attribute to phenotypic heteroge" ] ] ;
    slr:content_sha256 "6ff3f8dd98b5a271af8caed5fdc2fb3f133799fbac5500916e8548f3b3161e2a" ;
