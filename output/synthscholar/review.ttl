    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "Partition sizes are stated exactly (240/5542, 60/1411, 100/2868), test labels were withheld and scored by third parties, and every configuration is reported on both validation and test without selective omission." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "The autism label is inherited from the benchmark with no diagnostic instrument, criterion or clinician role reported and no summary of the source ascertainment." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Roughly twenty configurations were evaluated across architectures, inputs and encodings; features are computed per scanpath, and the authors themselves conclude that per-child gaze bias in a 28-participant pool is likely driving performance." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Twenty-eight children with age reported only for the autistic group and no sex, IQ, severity or recruitment information for either; group comparability cannot be assessed on any variable." ] ;
            slr:overall_judgment "high" ;
