<urn:slr:article:4c9af7f322c3> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "In this contribution, a model for revealing the presence of autism spectrum disorder by exploiting visual information is developed. This condition is characterized by a deﬁcit in social behaviour and nonverbal interactions such as speciﬁc facial expressions, reduced eye contact, and body gestures. Advancements in multimedia technologies can help in understanding symptoms for early detection of the disorder. In the proposed model, both the image content and the viewing behaviour are used for deﬁning relevant features to be used in a machine learning-based classiﬁer. A training phase is realized by taking multiple images and scanpaths representing the viewing behaviour of persons affected and not by the disorder. The inﬂuence of speciﬁc objects in the scene is considered. Finally, the number of ﬁxations towards centre of the scene and duration for which a subject looked at the central area is also considered. A decision tree based classiﬁer is used for training the model. The achieved results show that by taking into account the semantic and image features extracted from content, ﬁxation, and center-bias, it is possible to estimate the presence of autism spectrum disorder. The results obtained in the performed experiments are promising even if they show room for improvement." ;
    dcterms:bibliographicCitation "Arru G; Mazumdar P; Battisti F (2019). Exploiting Visual Behaviour for Autism Spectrum Disorder Identification. *2019 IEEE International Conference on Multimedia & Expo Workshops (ICMEW)*." ;
    dcterms:creator "Arru G",
        "Battisti F",
        "Mazumdar P" ;
    dcterms:title "Exploiting Visual Behaviour for Autism Spectrum Disorder Identification" ;
    bibo:pmid "local_05ef29e5" ;
    fabio:hasPublicationYear 2019 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are participants and recruitment adequately described?" ;
                            slr:justification "No counts, ages, genders, recruitment or selection criteria for either group." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the sample appropriate and adequate for the stated target?" ;
                            slr:justification "Unknown sample; unit of analysis is the scanpath rather than the person." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are comparison groups matched?" ;
                            slr:justification "Unknown; age unavailable in the dataset, which the authors flag as materially limiting given age-dependent fixation behaviour." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the feature construction well motivated?" ;
                            slr:justification "Each feature family is grounded in specific cited findings about ASD visual behaviour, including centre bias and reduced attention to socially prominent objects." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the reference standard appropriate and independently applied?" ;
                            slr:justification "No diagnostic information of any kind." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are predictors defined without knowledge of outcome?" ;
                            slr:justification "All features are computed automatically from scanpaths and images by named algorithms." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the behavioral data acquisition described reproducibly?" ;
                            slr:justification "No acquisition details at all - no eye tracker, viewing conditions, durations or calibration - since the data are inherited." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the validation subject-independent?" ;
                            slr:justification "Subject identity is randomised and inconsistent across images, so the same individual's scanpaths can appear in training and test." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is evaluation performed on a genuinely held-out set?" ;
                            slr:justification "Organiser-provided test set with labels withheld from the authors." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is feature importance or ablation reported?" ;
                            slr:justification "None, despite three interpretable feature families and a model that provides importance natively." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are alternative models compared?" ;
                            slr:justification "Only a single random forest configuration is evaluated." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the reported performance clinically meaningful?" ;
                            slr:justification "Specificity 50.56% is chance level; recall is achieved by over-calling ASD." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is performance reported completely and without inflation?" ;
                            slr:justification "Accuracy, recall, specificity, precision, F1 and AUC all reported together, exposing the chance-level specificity rather than concealing it." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are limitations discussed?" ;
                            slr:justification "A substantive discussion of age-dependence and content-dependence of ASD fixation behaviour, and an explicit acknowledgement that the model generalises features across subjects when it should not." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the dataset accessible or its access conditions stated?" ;
                            slr:justification "A public Grand Challenge benchmark is used and named, though no access reference is given in the paper." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are ethics and data provenance reported?" ;
                            slr:justification "No ethics, consent or provenance statement for the secondary data." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is code available?" ;
                            slr:justification "None; software versions and configurations unreported." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "some concerns" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Handcrafted numeric features - 30 scalar statistics per scanpath spanning content-relative fixation allocation, fixation and saccade dynamics, spatial coverage and refixation, saliency-weighted attention, and centre-proximity measures. No raw scanpath sequences, images or learned embeddings are fed to the classifier, though deep models (YOLO) and a saliency model are used upstream to define the regions the features are computed against." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-022" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "'persons affected by autism spectrum disorder', 'persons with ASD', 'ASD subjects', 'ASD patient', 'the patient', 'Typically Developing (TD) infants', 'TD persons', 'non-ASD subjects', 'typically developed toddlers'. Notably medicalised - 'patient' and 'affected by' recur - though the introduction does acknowledge the alternative term 'Autism Spectrum Condition' in its opening sentence before using 'disorder' throughout." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-022" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Supervised learning. Algorithm: random forest via MATLAB TreeBagger with 128 trees and bootstrap aggregation, selected on the stated grounds that it performs well on all-numeric feature sets with a numeric class label. Mean-shift clustering is used unsupervised as a feature-construction step. No alternative classifiers are compared." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-022" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "IEEE International Conference on Multimedia and Expo Workshops (ICMEW) 2019, as an entry to the Saliency4ASD Grand Challenge - a multimedia/computer-vision venue, not an autism or clinical venue." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-022" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Not reported at any level. No sample sizes, no ages, no age ranges, no standard deviations, no gender distribution, and no matching information for either group. The authors state explicitly that age 'is not available in the given dataset' and treat this as a substantive limitation on their model, since they cite evidence that ASD fixation behaviour differs markedly between toddlers, young children and grown-up children. This is the least participant-characterised study in the corpus so far." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-022" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Gaze: fixation coordinates, durations and derived saccadic amplitudes during natural-scene viewing. Uniquely in this corpus, gaze features are combined with computed properties of the stimulus itself - detected object regions and a bottom-up saliency map - so the representation is jointly behavioural and stimulus-derived rather than purely behavioural." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-022" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None reported. No cognitive, linguistic, adaptive or severity measures, and no comorbidity information - consistent with the complete absence of participant metadata in the source dataset as used here." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-022" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional; a single scanpath per subject per image with no temporal or longitudinal component. The data are fixation coordinates over public stimulus images, with subject identifiers already randomised by the dataset providers, so re-identification risk is minimal. No ethics approval, consent or data-protection statement appears - understandable for secondary use of a released challenge dataset but not acknowledged as such anywhere in the paper." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-022" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The fullest metric set in the corpus so far: accuracy (59.30%), recall/sensitivity (68.43%), specificity (50.56%), F1 (61.64%), precision (56.96%) and AUC-ROC (59.50%), all reported together for the held-out test set. Reporting specificity alongside recall is what makes the result interpretable - it shows recall is achieved largely by over-calling ASD, with specificity at chance. No confidence intervals or per-class confusion matrix." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-022" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2019. The related-work section surveys the eye-tracking-plus-machine-learning turn in some breadth, citing web-browsing gaze classification, saccade-based classification on six subjects, and a 700-image saliency study finding stronger centre bias and reduced saliency for faces in ASD. It also cites contrary evidence - that social orienting is 'not qualitatively impaired' in ASD and that the excess-mouth, diminished-eye gaze hypothesis has poor support - making it one of the few corpus papers to acknowledge that the underlying behavioural claims are contested. The existence of a dedicated Grand Challenge with a shared dataset is itself evidence of the field's move toward benchmark-based evaluation around 2019." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-022" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Single behavioural modality, but with genuine cross-source integration: three feature families (image content, fixation behaviour, centre bias) are concatenated for the classifier, and two of them require fusing gaze data with image-analysis outputs (YOLO object masks and SDSP saliency maps). This gaze-plus-stimulus-content fusion is a distinctive design in the corpus, though its contribution is never ablated so the value of each family is unknown. No integration with clinical, cognitive or demographic data - the latter being impossible given the dataset." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-022" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two groups by dataset label - ASD and typically developing - but the paper reports no participant counts for either group, only image counts (300 training, 100 test). The unit of analysis throughout is the scanpath rather than the person, and subject identifiers are explicitly randomised and inconsistent across images, so participant-level group composition is not recoverable." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-022" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Incorporate object semantics - the type of object fixated rather than merely whether a fixation fell on an object - motivated by evidence that ASD subjects look at the mouth rather than the eye region of faces; and study in depth which areas of fixation coverage ASD subjects miss, on the argument that what fails to attract attention may be as diagnostic as what attracts it. The discussion additionally implies, without stating it as a formal direction, that features must be adapted by participant age." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-022" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Not reported. Class labels are inherited from the Saliency4ASD challenge dataset with no description of how the original diagnoses were established, what instruments were used, or how typically developing status was confirmed." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-022" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Index terms: Autism spectrum disorder, Object detection, Fixations, Centre bias, Classification, Visual saliency. Task vocabulary: 'revealing the presence of autism spectrum disorder', 'ASD identification', 'early detection', 'visual behaviour', 'scanpath', 'centre bias', 'saliency'. The computer-vision vocabulary (saliency, object detection, ROI) dominates over clinical vocabulary." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-022" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. No feature importance, saliency analysis or ablation is performed, and no behavioural feature is identified as informative - a notable gap given that random forests supply out-of-bag importance measures for free and the feature set is explicitly organised into three interpretable families. The paper's interpretive content is instead a literature-grounded argument about why the features should work and why age moderates them." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-022" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Evaluation on an organiser-held-out test set with labels withheld is methodologically stronger than the internal cross-validation used by most of the corpus, and it makes the result directly comparable against other challenge entrants. But the design has a structural limitation the authors flag without connecting to validity: subject identity is randomised and inconsistent across images, so partitioning by subject is impossible and the same individual's scanpaths may fall on both sides of the split. Combined with per-image rather than per-person analysis, the reported figures estimate scanpath-level discriminability, not person-level diagnostic accuracy. No external validation beyond the challenge test set, no bias analysis, no class-imbalance handling, and no deployment or real-time consideration." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-022" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Setting not reported - this is entirely secondary analysis of an existing benchmark dataset (Saliency4ASD, IEEE ICME 2019 Grand Challenge), with no data collection by the authors and no description of the original acquisition conditions." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-022" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Reported by the authors, and unusually thoughtfully for a four-page workshop paper: ASD fixation behaviour changes with age, with toddlers, young children and grown-up children differing markedly and adults with ASD showing no visible difference in fixation duration between objects and non-objects, so 'the ASD subject age is very important for detecting the condition' - yet age was unavailable in the dataset; and fixation behaviour also depends on image content, since young ASD children do not differ from TD children on scenes containing both faces and objects of circumscribed interest, so 'ASD condition cannot be generalized over age, fixation behaviour, and image content' whereas the model generalises all features over all subjects. Identifiable in review: specificity of 50.56% is chance level and the model is therefore near-useless for ruling out ASD, which the summary framing of '60% accuracy' obscures; no participant counts, ages or genders exist at all; subject identity is not consistent across images so subject-independent evaluation is impossible and the same person's scanpaths can appear in both training and test sets; the unit of analysis is a scanpath not a person, so this is not a person-level diagnostic result; and no feature importance is reported despite the model providing it natively." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-022" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Free viewing of 2D natural scene images, per the source dataset. No task instruction, viewing duration, stimulus presentation details or calibration procedure is described, since none of it was performed by these authors. The analysis pipeline adds its own processing tasks - YOLO object detection and SDSP saliency estimation over each stimulus image." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-022" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Goal: identify ASD from visual behaviour during image viewing, developed for the Saliency4ASD Grand Challenge. Main findings: accuracy 59.30%, recall 68.43%, specificity 50.56%, F1 61.64%, precision 56.96%, AUC-ROC 59.50% on the organiser's held-out test set. The authors describe this as promising with room for improvement, and attribute the limitation primarily to the absence of age information and to the age-dependence of ASD fixation behaviour." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-022" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No acquisition hardware, since no data were collected. Software: YOLO (You Only Look Once) for object detection, chosen to segment images into object and non-object regions; SDSP (saliency detection by combining simple priors) for saliency, chosen for low computational complexity; mean-shift clustering with a Gaussian kernel and a distance/scale threshold of 100 for region-of-interest extraction; MATLAB TreeBagger for the random forest." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-022" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Mixed. The source dataset is a public benchmark with an organiser-defined train/test split, which is the strongest form of comparability in this corpus - results are directly comparable against other challenge entrants. The feature set is fully enumerated in a table with definitions and the saliency feature is given as an explicit equation, the ROI clustering threshold (100) and centre-proximity radius (100 pixels) are stated, and the classifier and tree count (128) are named. But no code is released, no random seeds are given, no software versions are specified, and the object-detection and saliency models are named without configuration details." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-022" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "Not reported - viewing durations per image are not stated, and the unit of analysis is a single scanpath over a single image" ;
                    slr:study_design "Cross-sectional classification study on a shared benchmark dataset with an organiser-provided train/test split; the authors performed no data collection" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: Not reported - the paper gives image and scanpath counts but never states the number of participants in either group; comparison: Not reported" ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "Accuracy 59.30%, recall 68.43%, specificity 50.56%, F1 61.64%, precision 56.96%, AUC-ROC 59.50%. Specificity at 50.56% is essentially chance, meaning the model barely distinguishes typically developing scanpaths from random assignment",
                        "Combining image-content, fixation-behaviour and centre-bias features from a single scanpath yielded only 59.3% accuracy and an AUC of 0.595 on the held-out Saliency4ASD test set, with specificity at chance level. The authors report this candidly as 'promising for future improvements' and devote most of their discussion to explaining why performance is limited: fixation behaviour in ASD changes sub" ;
                    slr:outcome "Accuracy, recall/sensitivity, specificity, F1, precision and AUC-ROC - the most complete metric set of any study so far in the corpus" ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "Accuracy 59.30%, recall 68.43%, specificity 50.56%, F1 61.64%, precision 56.96%, AUC-ROC 59.50%. Specificity at 50.56% is essentially chance, meaning the model barely distinguishes typically developing scanpaths from random assignment; Combining image-content, fixation-behaviour and centre-bias features from a single scanpath yielded only 59.3% accuracy and an AUC of 0.595 on the held-out Saliency4ASD test set, with specificity at chance level. The authors report this candidly as 'promising for future improvements' and devote most of their discussion to explaining why performance is limited: fixation behaviour in ASD changes sub" ] ] ;
    slr:content_sha256 "41e3160b6c48b904fc774b0412092bb0441c7cd8e1e203b2481ce1b20709b8f6" ;
    slr:full_text_artifact [ a slr:StoredArtifact ;
            prov:wasDerivedFrom <urn:slr:article:4c9af7f322c3> ;
            prov:wasGeneratedBy [ a prov:Activity,
                        slr:ToolInvocation ;
