    slr:not_retrieved 0 ;
    slr:reporting_standard "PRISMA_2020" ;
    slr:research_question "To characterise how computation-based (machine learning and other computational) autism prediction studies that use behavioral data are designed, conducted and reported: who is studied and how they are described, in what settings and with what tasks, hardware and software the behavioral data are collected, how datasets are shared and how reproducibility and bias are handled, which behavioral modalities are operationalised and how they are combined, which computational methods, representations, evaluation metrics, interpretability techniques and validation strategies are used, and how the publication landscape has evolved over time." ;
    slr:screened_title_abstract 170 ;
    slr:screening_decision_record [ a prov:Activity,
                slr:ScreeningDecisionRecord ;
            dcterms:title "Finding the forest in the trees: Using machine learning and online cognitive and perceptual measures to predict adult autism diagnosis" ;
            bibo:pmid "local_7b19a959" ;
            slr:assessed_on "title_abstract" ;
            slr:decision "include" ;
            slr:decision_rationale "Machine learning applied to online performance-based cognitive and perceptual measures to predict adult autism diagnosis, with accuracy, sensitivity, specificity and F1 reported." ;
            slr:screening_stage "title_abstract" ],
        [ a prov:Activity,
                slr:ScreeningDecisionRecord ;
            dcterms:title "AI-Powered Human-Computer Interaction Assisting Early Identification of Emotional and Facial Symptoms of Autism Spectrum Disorder in Children: &#x201C;A Deep Learning-Based Enhanced Facial Feature Recognition System&#x201D;" ;
            bibo:pmid "local_261afa51" ;
            slr:assessed_on "title_abstract" ;
            slr:decision "include" ;
            slr:decision_rationale "Title and abstract describe a deep learning system classifying children as autistic or non-autistic from facial images, trained on a Kaggle dataset of 2,836 images with MobileNet, Xception and InceptionV3 transfer learning, reporting 95% accuracy. Human participants (in the form of photographs), a computational model and an autism classification target are present. Whether static facial appearance constitutes behavioural data required full-text assessment." ;
            slr:screening_stage "title_abstract" ],
        [ a prov:Activity,
                slr:ScreeningDecisionRecord ;
            dcterms:title "A deep learning latent variable model to identify children with autism through motor abnormalities" ;
            bibo:pmid "local_a22f97df" ;
            slr:assessed_on "full_text" ;
            slr:decision "include" ;
            slr:decision_rationale "Full text confirms a primary computational study: 60 children aged 5-10 (30 ASD diagnosed by DSM-5 plus ADOS-2, 30 TD), a tablet reimplementation of the Leiter-3 cognitive battery capturing finger trajectories at 40 Hz, 12 kinematic and touch features per trajectory averaged per task, a variational autoencoder with an attached softmax predictor trained jointly, 10-fold cross-validation reporting 91.2% +/- 5.6% accuracy, and a Monte Carlo feature-perturbation analysis of the latent space. Eligible on all criteria. Charted with the caveat that the unit of cross-validation is the task observation rather than the child (see rubric and appraisal)." ;
            slr:full_text_source "user_supplied_pdf" ;
            slr:screening_stage "full_text" ],
        [ a prov:Activity,
                slr:ScreeningDecisionRecord ;
            dcterms:title "Investigation of Eye-Tracking Scan Path as a Biomarker for Autism Screening Using Machine Learning Algorithms" ;
            bibo:pmid "local_8b5fb23b" ;
            slr:assessed_on "full_text" ;
            slr:decision "include" ;
            slr:decision_rationale "Full text confirms supervised binary classification of autism from 547 public gaze-path images using boosted decision trees, deep SVM, decision jungle and a convolutional neural network, evaluated by five-fold cross-validation on original and augmented datasets and additionally by leave-one-out cross-validation on a one-image-per-participant subset." ;
            slr:full_text_source "user_supplied_pdf" ;
            slr:screening_stage "full_text" ],
        [ a prov:Activity,
                slr:ScreeningDecisionRecord ;
            dcterms:title "Very early detection of Autism Spectrum Disorders based on acoustic analysis of pre-verbal vocalizations of 18-month old toddlers" ;
            bibo:pmid "local_76fc33d0" ;
            slr:assessed_on "title_abstract" ;
            slr:decision "include" ;
            slr:decision_rationale "Acoustic-prosodic ML classification of ASD vs TD toddlers from pre-verbal vocalisations - computational model on behavioral (vocal) data with an autism prediction target." ;
            slr:screening_stage "title_abstract" ],
        [ a prov:Activity,
                slr:ScreeningDecisionRecord ;
            dcterms:title "Application of artificial intelligence in modern healthcare for diagnosis of autism spectrum disorder" ;
            bibo:pmid "local_0f5a351e" ;
            slr:assessed_on "title_abstract" ;
            slr:decision "include" ;
            slr:decision_rationale "Title and abstract describe deep transfer-learning models classifying autism from facial images of children using a 2,940-image Kaggle dataset, reporting 98% accuracy. Facial appearance is within the review's behavioural modality scope, an autism classification target is present, and the work is a primary computational study." ;
            slr:screening_stage "title_abstract" ],
        [ a prov:Activity,
                slr:ScreeningDecisionRecord ;
            dcterms:title "Deep learning-based detection of autism spectrum disorder and emotion recognition in children" ;
            bibo:pmid "local_86a67a4f" ;
            slr:assessed_on "full_text" ;
            slr:decision "include" ;
            slr:decision_rationale "Full text confirms a computational study on two Kaggle corpora: a facial-image dataset labelled autism versus non-autism, split 2,526 training, 280 testing and 80 validation - the standard partition of the Piosenka autistic-children collection charted seven times elsewhere in this review - and a separate emotion dataset of 703 training and 130 testing images. A hybrid ResNet50V2-InceptionV3 was fitted for the autism task and an enhanced MobileNet for six-way emotion recognition. Included, with the record noting that the autism corpus's positive class is harvested from autism-associated online sources, and that the reported metric set for the autism model is internally inconsistent." ;
            slr:full_text_source "user_supplied_pdf" ;
            slr:screening_stage "full_text" ],
        [ a prov:Activity,
                slr:ScreeningDecisionRecord ;
            dcterms:title "Use of Oculomotor Behavior to Classify Children with Autism and Typical Development: A Novel Implementation of the Machine Learning Approach" ;
            bibo:pmid "local_3ba6d25c" ;
            slr:assessed_on "full_text" ;
            slr:decision "include" ;
            slr:decision_rationale "Full text confirms a primary computational study: 19 children with ASD and 20 with TD (after exclusion of 4 for tracking failure), head-mounted Tobii Pro Glasses 2 at 50 Hz during a structured conversation, six entropy/range features of gaze allocation computed over non-overlapping segments of 1-10 s, SVM with forward feature selection and tenfold cross-validation classifying segments, then a threshold classifier aggregating segment labels to a per-child decision. Accuracy, sensitivity, specificity and an ROC are reported. Eligible on all criteria. Charted with the caveat that the validation design pools segments across children (see rubric and appraisal)." ;
            slr:full_text_source "user_supplied_pdf" ;
            slr:screening_stage "full_text" ],
        [ a prov:Activity,
                slr:ScreeningDecisionRecord ;
            dcterms:title "Artificial Intelligence-Based Detection of Autism Spectrum Disorder Using Linguistic Features" ;
            bibo:pmid "local_786b6280" ;
            slr:assessed_on "full_text" ;
            slr:decision "include" ;
            slr:decision_rationale "Full text confirms a secondary-analysis computational study on transcribed child speech from TalkBank: 30 autistic and 34 typically developing children aged 3 to 6, drawn from the Eigsti and Nadig corpora in ASDBank and supplemented from the Warren and Kuczaj corpora in CHILDES. Six linguistic features were computed in child-alone and child-to-investigator ratio forms using the Stanza NLP package, and seven models were compared over 50 random 75/25 train-test splits. Spontaneous speech produced during play is behaviour the child generated, within the review's modality scope." ;
            slr:full_text_source "user_supplied_pdf" ;
            slr:screening_stage "full_text" ],
        [ a prov:Activity,
                slr:ScreeningDecisionRecord ;
            dcterms:title "Classifying Individuals with ASD Through Facial Emotion Recognition and Eye-Tracking" ;
            bibo:pmid "local_96c87d36" ;
            slr:assessed_on "full_text" ;
            slr:decision "include" ;
            slr:decision_rationale "Full text confirms 23 individuals with ASD and 35 typically developing controls, Tobii eye tracking during the DARE emotion recognition task, task/gaze/deep face features, random forest with leave-one-subject-out cross-validation, and reported AUC, accuracy, sensitivity and specificity at fixation, trial and subject levels." ;
            slr:full_text_source "user_supplied_pdf" ;
            slr:screening_stage "full_text" ],
        [ a prov:Activity,
                slr:ScreeningDecisionRecord ;
            dcterms:title "Eye-movement analysis on facial expression for identifying children and adults with neurodevelopmental disorders" ;
