    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Dataset 1 is a public screening download with no recruitment or demographic distributions reported. Dataset 2's 100 original clinical samples have no source, citation, country, institution or participant description, and contain no non-ASD class." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "No diagnostic procedure is described for either dataset. Dataset 1's target is a binary traits field; Dataset 2's four severity classes are asserted with no instrument named, supported only by an inter-rater kappa of 0.92 against an unstated standard." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Dataset 1's predictor set includes the AQ, SRS, Q-CHAT and CARS scores as predictors of an ASD-traits label. Dataset 2 uses 4,220 features for 400 samples derived from 100 originals, with no base-learner hyperparameters or seed reported for either." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Dataset 1's split ordering is correct and explicitly leakage-aware. Dataset 2's 80/10/10 split and 5-fold cross-validation are applied to the fourfold-augmented set, so transformed copies of the same clinical sample fall on both sides, and the test partition holds 40 samples against 4,220 features." ] ;
            slr:overall_judgment "high" ;
            slr:tool_used "QUADAS-2" ] .

<https://doi.org/10.3389/fncom.2026.1626315> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Autism Spectrum Disorder (ASD) is a neurodevelopmental disorder that is marked by a lack of communication skills in social situations and repetitive and stereotypical Behaviors. The most widespread form of diagnosing ASD among children is based on psychological screening test along with monitoring of the Behavioral pattern, especially repetitive Behaviors. Some of these Behaviors include hand-ﬂapping, head banging and spinning which are common among ASD children. In our research, we examine abnormal Behavioral patterns that may reﬂect ASD through the videos of children engaged in the everyday activities in the unstructured settings. A publicly available multiclass Self-Stimulatory Behavior Dataset (SSBD) is use in classify autistic Behavior. Before training the model, the dataset is thoroughly pre-processed (region-of-interest (ROI) detection and image cropping to eliminate irrelevant background objects). Moreover, information-augmenting methods are used to reduce overﬁtting and increase training efciency and generalization efectiveness. In order to obtain spatiotemporal details successfully, a number of deep learning models are tested, such as studied CNN-GRU model, 3D-CNN + LSTM, MobileNet, VGG16, and EfcientNet-B7. The ﬁndings of the experiment prove that the proposed CNN-GRU model is superior to all competing methods. The model with a k- fold cross-validation provides a steady accuracy of 0.9284 ± 0.0039–0.9294 ± 0.0038, which means that the model is robust and consistent across the folds. The efectiveness of the proposed approach is additionally justiﬁed by the comparisons with state-of-the-art methods. The results show that the systems based on the action recognition can help clinicians monitor the Behavioral trends and facilitate the quick, accurate, and efective screening of ASD. The proposed approach works efectively in predicting Behavior in real-life, uncontrolled videos and shows tremendous potential for real-world clinical implementation as a decision-support tool." ;
    dcterms:bibliographicCitation "Jabbar U; Waseem Iqbal M; Nechifor A; Abaker M; Khairalseed MA; Antohi VM; Fortea C; Stefanescu CA (2026). Deep learning based approach for Behavior classification in diagnoses of Autism Spectrum Disorder using naturalistic videos. *Frontiers in Computational Neuroscience*. https://doi.org/10.3389/fncom.2026.1626315" ;
    dcterms:creator "Abaker M",
        "Antohi VM",
        "Fortea C",
        "Jabbar U",
        "Khairalseed MA",
        "Nechifor A",
        "Stefanescu CA",
        "Waseem Iqbal M" ;
    dcterms:title "Deep learning based approach for Behavior classification in diagnoses of Autism Spectrum Disorder using naturalistic videos" ;
    bibo:doi "10.3389/fncom.2026.1626315" ;
    bibo:pmid "local_8d43288c" ;
    fabio:hasPublicationYear 2026 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Data source and eligibility described" ;
                            slr:justification "The dataset is correctly attributed and its provenance honestly described as parent-posted YouTube videos, but no eligibility criteria, demographics or per-class counts are given." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Sample size justified" ;
                            slr:justification "No justification; 75 videos yield an unstated number of clips, with 303 samples appearing only in a confusion matrix." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Participants appropriate to the question" ;
                            slr:justification "Videos of autistic children only, with no non-autistic comparison, behind a screening claim; number of distinct children unreported." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Comparison controlled" ;
                            slr:justification "All five architectures trained on the same data under identical hyperparameters, with per-fold standard deviations and paired t-tests at a corrected threshold." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Model choice justified" ;
                            slr:justification "The rationale for a recurrent component is correct - behaviour is temporal and requires sequence modelling across frames - unlike studies applying recurrent models to single static inputs." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Predictors defined and measured appropriately" ;
                            slr:justification "Spontaneous behaviour observed in natural settings, with ROI cropping to remove background - the most ecologically valid input in the charted corpus." ;
                            slr:rating "Low" ] ;
                    slr:overall_concern "unclear" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Outcome definition and ascertainment" ;
                            slr:justification "Labels are behaviour-segment annotations; no diagnostic ascertainment exists for any child." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Outcome matches the stated claim" ;
                            slr:justification "Four-way movement classification within an all-autistic dataset is presented in the title and abstract as diagnosis and screening for ASD." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Performance measures adequate" ;
                            slr:justification "Per-fold means and standard deviations, per-class F1, two confusion matrices and corrected paired significance tests - but no per-class counts and no stated chance level." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Analysis unit matches the clinical claim" ;
                            slr:justification "Claims concern children; metrics are computed over clips from 75 videos with an unknown number of children behind them." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Ethical basis for data reuse" ;
                            slr:justification "No ethics or consent statement for reuse of identifiable children's home videos whose parent-posted provenance the paper itself describes." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Validation design guards against optimism" ;
                            slr:justification "No video-level or child-level grouping in the folds; the value of k is unstated; near-zero fold variance is interpreted as robustness." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Limitations and overinterpretation" ;
                            slr:justification "A full limitations column applied to eleven prior studies and only dataset-availability remarks about this one; the decision-support hedge is contradicted by the title and abstract." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Validation accuracy and loss, precision, recall and F1 per architecture; per-fold means with standard deviations for every model and metric; per-class F1; two confusion matrices; learning curves; and paired t-tests with a Bonferroni-adjusted threshold of 0.0125. The statistical reporting is among the better examples in this corpus - the standard deviations are given rather than implied, and the multiple-comparison correction is stated explicitly. What is missing bears directly on interpretation: per-class sample counts are not reported, so the 25% chance level for a four-class problem cannot be checked against the actual class balance; the value of k is never given; and the very small per-fold standard deviations (under 0.004 across five architectures) are read as evidence that the model is robust and consistent across the folds when, over clips drawn from only 75 videos, near-identical fold results are equally consistent with folds that are near-identical resamples of the same recordings." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-161" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2026, published 18 March, 174 days from submission with one revision round. The framing is internally split. The objectives section states that the system should be used as a clinical decision support system and not an independent diagnostic system - an accurate and unusually explicit limit. The title, abstract and conclusion pull the other way, placing the work in diagnoses of Autism Spectrum Disorder, claiming it facilitates the quick, accurate, and effective screening of ASD, and asserting tremendous potential for real-world clinical implementation. What the study actually demonstrates is that a CNN-GRU distinguishes four movement categories in home video at about 93% under a clip-level split, which is a behaviour-recognition result and a useful one; the screening language is added on top of it." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-161" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Frontiers in Computational Neuroscience 20:1626315, with a 174-day review including a substantial revision. The review did not surface the absent ethics statement for reuse of identifiable children's home videos, the unreported number of distinct children, the absence of a non-autistic comparison behind a screening claim, or the reading of near-zero fold variance as robustness." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-161" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "ASD, autism spectrum disorder, autistic children, ASD children, ASD youngsters, abnormal Behavioral patterns, stereotypical Behaviors, normal Behavior. The stereotyped/normal opposition is applied to movements rather than to children, which is the more defensible usage, but the framing describes self-stimulatory behaviours as abnormal throughout and the fourth class as normal. No autistic or community perspective appears, and there is no discussion of self-stimulatory behaviour as regulatory rather than pathological." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-161" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. No age, sex, ethnicity, geography or setting information for any child. The videos are consumer home recordings of unknown provenance, and the paper does not report even the age range of the children whose behaviour it classifies." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-161" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. No cognitive, adaptive, language or severity measure." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-161" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The stated goal is to classify four behaviour categories - arm flapping, spinning, head banging and normal behaviour - from naturalistic, unstructured video, using a CNN-GRU architecture, in order to help clinicians monitor behavioural trends. Headline findings: CNN-GRU reaches k-fold accuracy 0.9294 +/- 0.0038 and validation accuracy 0.96, outperforming MobileNet (0.9193), 3D-CNN+LSTM (0.8912), EfficientNet-B7 (0.8808) and VGG16, with paired t-tests significant against all four at a corrected threshold of 0.0125. Per class, the two clearly distinct repetitive behaviours (arm flapping, head banging) reach F1 0.98 while spinning and normal behaviour reach 0.94 and 0.93." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-161" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None, and not required by the task as executed - but required by the task as described. The videos are annotated for when a behaviour occurs, not for whether the child has a diagnosis; no clinical assessment, instrument or assessor exists for anyone in the dataset. The paper's title nonetheless places the work in diagnoses of Autism Spectrum Disorder and its abstract states that the approach facilitates quick, accurate and effective screening of ASD. Those claims do not follow from a four-way discrimination among arm flapping, head banging, spinning and other movement in videos of children who are all autistic." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-161" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Mixed, with real strengths on the comparative design. Reproducible: the source dataset is public and correctly attributed to its originators, the preprocessing chain is described in order, all five architectures were deliberately trained under identical hyperparameters to make the comparison fair, per-fold standard deviations are reported for every model and metric, and paired t-tests with a corrected significance threshold of 0.0125 are tabulated. Not reproducible: the value of k, the number of frames or clips extracted, the number of distinct children, per-class sample counts, the unit at which folds were formed, the learning rate, batch size and epoch count, any seed, and any code or data-availability statement." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-161" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cropped frame sequences from annotated behaviour segments, after region-of-interest detection to remove irrelevant background and augmentation to reduce overfitting. The ROI step is well motivated for uncontrolled home video, where background and framing differ systematically between recordings." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-161" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Self-stimulatory motor behaviour observed in natural settings: arm flapping, head banging and spinning, against a fourth class of non-stereotyped movement. This is the corpus's clearest instance of behaviour being observed directly rather than inferred from a photograph, a checklist or a questionnaire - the behaviours are the ones clinicians actually watch for, recorded where they actually occur. The confusion-matrix analysis adds a substantive behavioural observation: errors concentrate between spinning and the two repetitive classes, attributed to overlap in motion dynamics, and normal behaviour is moderately confused with the repetitive classes in the held-out test." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-161" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No study setting - the defining property of the data is precisely that there is none. The videos are unstructured home recordings made by families in everyday environments, which is the source of both the design's principal strength (ecological validity, behaviours observed rather than reported) and its principal uncontrolled variance (camera, framing, lighting, distance and activity all vary by video and are perfectly confounded with the child)." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-161" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Autism Spectrum Disorder; Behavior analysis; CNN-GRU; deep learning; naturalistic video. Five terms, and naturalistic video is the one that matters - it names the study's genuine distinguishing property in a corpus dominated by downloaded photographs and checklists." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-161" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional secondary analysis. There is no ethics statement, consent statement or exemption claim anywhere in the article. The omission is more pointed than in the questionnaire studies because the paper itself describes the data's provenance: parents and caretakers posted their videos on websites that are accessible to the public, and the dataset consists of URLs to 75 YouTube videos of identifiable autistic children. Whether a parent posting a home video to YouTube thereby consents to its use as machine learning training data is exactly the question the study needed to address and does not raise." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-161" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A custom CNN-GRU hybrid, with GRU selected over LSTM on the stated grounds of simpler gating, fewer parameters, greater training stability and less overfitting under repeated k-fold retraining. Four comparators - VGG16, MobileNet, EfficientNet-B7 and 3D-CNN+LSTM - were fitted by the authors on the same data under identical hyperparameters, which makes this one of the few architecture comparisons in the corpus that is actually controlled." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-161" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The evaluation is better constructed than most in this corpus and still cannot support the claim the title makes. On the credit side: k-fold cross-validation with per-fold standard deviations reported for all five architectures, an independent test evaluation with its own confusion matrix, identical hyperparameters across models to make the comparison fair, and paired t-tests against every baseline at a corrected threshold. On the debit side, three things. First, the unit: 75 source videos are segmented into clips and the k-fold matrix covers 303 samples, with no video-level or child-level grouping described, so clips from the same recording - same child, same room, same camera, same clothing - fall on both sides of every fold. In naturalistic video this is the strongest available shortcut, because recording identity is far easier to learn than movement type. Second, the reported stability is read backwards: standard deviations below 0.004 across five different architectures are presented as robustness, whereas over clips from 75 videos they indicate that the folds contain much the same material. Third, and separately from any of this, the task is not the task claimed. Four-way discrimination among arm flapping, head banging, spinning and other movement, in videos of children who are all autistic, cannot yield screening for ASD, because no non-autistic person appears anywhere in the data - a screening claim requires a comparison the design does not contain. The paper's own hedge, that the system is intended as a clinical decision support system and not an independent diagnostic system, is the correct reading and sits uneasily beside a title placing the work in diagnoses of ASD and an abstract promising effective screening." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-161" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No controlled acquisition equipment - the recordings are consumer video of unknown origin. Python OpenCV was used for frame extraction. Region-of-interest detection and cropping were applied to remove background objects, which is the appropriate response to uncontrolled framing. No deep learning framework, version, seed or hardware is named." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-161" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The paper announces that it will discuss its weaknesses, and the only self-directed remarks concern the data - that SSBD is the sole freely available dataset of its kind, that it is somewhat helpful but does not fully meet the study's conditions, and that no existing dataset does. Against that, a full column of Table 1 assigns a specific limitation to each of eleven prior studies (did not describe the pre-processing and model development steps; need to improve results; implemented a basic CNN model that performs binary classification and was tested on a small dataset). Unmentioned for this study: that folds are formed over clips from 75 videos with no video-level or child-level grouping; that the number of distinct children is unknown; that there is no non-autistic comparison group behind a screening claim; that no ethics statement accompanies the reuse of identifiable children's home videos; and that per-class counts and the chance level are unreported." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-161" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Announced in the paper's structure but not developed in the extracted text." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-161" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No fusion - video only. The CNN-GRU combination is spatial-plus-temporal modelling within one modality, and the architectural rationale is stated properly: convolutional layers extract spatial features from single frames while autism-related behaviour is a temporal phenomenon requiring sequence modelling across frames. That is a correct justification for a recurrent component, unlike the several studies in this corpus that apply LSTMs to single static inputs." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-161" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No model interpretability, but a genuine and clinically sensible error analysis. Spinning is confused with the repetitive classes because of overlapping motion dynamics, and normal behaviour is confused with the repetitive classes in the independent test set - both of which are the errors one would predict from the physics of the behaviours, and both of which point at the harder discrimination (is this movement stereotyped or not?) rather than the easier one (is this flapping or banging?)." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-161" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No participants and no groups. The data are 75 YouTube videos of approximately 90 seconds each from the Self-Stimulatory Behaviour Dataset, uploaded by parents and caretakers, segmented into frame clips by behaviour type using the dataset's original annotations. The number of distinct children is never stated - a consequential omission, since 75 videos may represent fewer than 75 children and the k-fold confusion matrix reports 303 samples, so the analysis unit is the clip. Crucially there is no non-autistic comparison group: all four classes, including normal Behavior, are drawn from videos of autistic children, so the study is a behaviour-recognition problem within one population rather than a diagnostic contrast between populations." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-161" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No imposed task. Naturalistic recordings of children engaged in everyday activities, with behaviour episodes delimited by the SSBD annotations of start and finish times. This is the most ecologically valid data source in the charted corpus - no laboratory, no stimulus, no instruction, and behaviours that occurred spontaneously in the child's own environment." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-161" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "VGG16, MobileNet, EfficientNet-B7 and 3D-CNN+LSTM, all fitted by the authors on the same data under identical settings, with paired t-tests reported against the proposed model. Plus a related-work tab" ;
                    slr:study_design "Retrospective secondary analysis of a public naturalistic video dataset; four-class behaviour classification with k-fold cross-validation, five architectures compared under identic…" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: Not applicable in the usual sense - the dataset consists of videos of autistic children only, so all four classes come from the same population.; comparison: There is no non-autistic comparison group. The fourth class, normal Behavior, is non-stereotyped movement drawn from the same autistic children's videos." ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "CNN-GRU k-fold accuracy 0.9294 +/- 0.0038 with per-fold standard deviations under 0.004 across all metrics; validation accuracy 0.96 with validation loss 0.16; precision 0.96, recall 0.95-0.96, F1 0.96. Baselines: MobileNet 0.9193, 3D-CNN+LSTM 0.8912, EfficientNet-B7 0.8808, VGG16 lowest. Per class, arm flapping and head banging reach F1 0.98 while normal behaviour and spinning reach 0.93 and 0.94" ;
                    slr:outcome "Validation accuracy and loss per architecture; precision, recall and F1 per architecture; per-fold mean and standard deviation for accuracy, precision, recall and two further columns; per-class F1; two confusion matrices (k-fold and independent test); learning curves; and paired t-tests with p-value" ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "CNN-GRU k-fold accuracy 0.9294 +/- 0.0038 with per-fold standard deviations under 0.004 across all metrics; validation accuracy 0.96 with validation loss 0.16; precision 0.96, recall 0.95-0.96, F1 0.96. Baselines: MobileNet 0.9193, 3D-CNN+LSTM 0.8912, EfficientNet-B7 0.8808, VGG16 lowest. Per class, arm flapping and head banging reach F1 0.98 while normal behaviour and spinning reach 0.93 and 0.94" ] ] ;
