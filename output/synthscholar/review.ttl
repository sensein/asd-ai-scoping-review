<urn:slr:article:b7546602bf4b> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Autism spectrum disorder (ASD) is a complex and lifelong neurodevelopmental condition that occurs in early childhood and is associated with unusual movement and gait disturbances. An automated and accurate recognition of ASD gait provides assistance in diagnosis and clinical decision-making as well as improving targeted treatment. This paper explores the use of two well-known machine learning classifiers, artificial neural network (ANN) and support vector machine (SVM) in distinguishing ASD and normal gait patterns based on prominent gait features derived from three-dimensional (3D) ground reaction forces (GRFs) data. The 3D GRFs data of 30 children with ASD and 30 typically developing children were obtained using two force plates during self-determined speed of barefoot walking. Time-series parameterization techniques were applied to the 3D GRFs waveforms to extract the significant gait features. The stepwise method of discriminant analysis (SWDA) was employed to determine the dominant GRF gait features in order to classify ASD and typically developing groups. The 10-fold cross-validation test results indicate that the ANN model with three dominant GRF input features outperformed the kernelbased SVM models with 93.3% accuracy, 96.7% sensitivity, and 90.0% specificity. The findings of this study demonstrate the reliability of using the 3D GRF input features, in combination with SWDA feature selection and ANN classification model as an appropriate method that may be beneficial for the diagnosis of ASD gait as well as for evaluation purpose of the treatment programs." ;
    dcterms:bibliographicCitation "Hasan CZC; Jailani R; Tahir NM (2018). ANN and SVM Classifiers in Identifying Autism Spectrum Disorder Gait Based on Three-Dimensional Ground Reaction Forces. *TENCON 2018 - 2018 IEEE Region 10 Confere*." ;
    dcterms:creator "Hasan CZC",
        "Jailani R",
        "Tahir NM" ;
    dcterms:title "ANN and SVM Classifiers in Identifying Autism Spectrum Disorder Gait Based on Three-Dimensional Ground Reaction Forces" ;
    bibo:pmid "local_44b58f21" ;
    fabio:hasPublicationYear 2018 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the sample appropriate and adequate for the stated target?" ;
                            slr:justification "60 children, all mild-category ASD, with a single stance phase per child as the behavioral sample." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are participants and recruitment adequately described?" ;
                            slr:justification "Recruitment sources, ages, heights and body masses are reported; gender, diagnostic route and severity instrument are not." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are comparison groups matched?" ;
                            slr:justification "No matching claimed or tested; mean ages differ by ~0.9 years and no gender data exist." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the behavioral sample per participant adequate?" ;
                            slr:justification "One stance phase of one limb from one selected trial per child, discarding within-subject gait variability." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the reference standard appropriate and independently applied?" ;
                            slr:justification "No diagnostic instrument or procedure reported; 'mild category' is unsupported by any measure." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are predictors defined without knowledge of outcome?" ;
                            slr:justification "GRF features are computed automatically from force-plate waveforms." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the behavioral data acquisition described reproducibly?" ;
                            slr:justification "Force plates, walkway length, sampling rate, filter order and cut-off, normalisation scheme, trial validity criterion and the full 20-feature definition table are all specified." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "some concerns" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is hyperparameter search separated from performance estimation?" ;
                            slr:justification "Exhaustive grid search over kernels, C, gamma, polynomial degree and ANN hidden-layer size performed outside cross-validation." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the sample size adequate for the modelling?" ;
                            slr:justification "60 subjects against a final three input features is comparatively reasonable, but the selection that produced those three saw all 60 labels." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is fold-level variability reported?" ;
                            slr:justification "Means over ten folds and ten iterations with no standard deviations." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is feature selection nested within the validation loop?" ;
                            slr:justification "SWDA used group labels across the whole dataset before the folds were drawn." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is there external or independent validation?" ;
                            slr:justification "None; a larger dataset is named as needed." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are effect directions reported for the informative features?" ;
                            slr:justification "The three significant features are identified but which group shows higher or earlier values is never stated." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are sample bias, imbalance and limitations discussed?" ;
                            slr:justification "No limitations section; only a single sentence noting that a larger dataset is needed." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the dataset accessible or its access conditions stated?" ;
                            slr:justification "No data availability statement." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are ethics, consent and privacy handling reported?" ;
                            slr:justification "Parent-project ethics approval named; no consent statement or data-protection provision." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is feature selection reported transparently?" ;
                            slr:justification "The complete p-value distribution for all 20 candidate features is published, showing exactly how the three were chosen." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is code or an implementation available?" ;
                            slr:justification "None, though toolboxes and hyperparameter grids are named." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "high" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Laboratory setting - a dedicated human motion gait analysis laboratory with force plates embedded in an instrumented walkway. Data were newly collected within a larger institutional research project but are reused here from the authors' earlier published work, so this paper is a secondary analysis of an in-house dataset rather than a new collection." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-011" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "ASD n=30, mean age 8.63 +/- 2.16 years, height 1.29 +/- 0.14 m, mass 31.21 +/- 14.20 kg. TD n=30, mean age 9.52 +/- 1.96 years, height 1.27 +/- 0.13 m, mass 28.03 +/- 10.57 kg. No gender distribution is reported for either group, and no age matching is claimed or statistically tested despite a ~0.9-year mean difference - material for a gait study in children, where maturation changes force profiles. Height and body mass are reported, which is appropriate since GRF amplitudes are normalised to body weight, but the large mass SD in the ASD group (14.20 kg) is not discussed." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-011" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two groups of 30: children with ASD (all mild category) and typically developing children. Group sizes, mean age, height and body mass are reported for both. Recruitment is split within the ASD group - 14 from the National Autism Society of Malaysia centre and 16 from the local community via parents approached through social media - which is unusually specific. No other-diagnosis comparison group." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-011" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Handcrafted time-series parameterisation: each GRF waveform is reduced to its local peaks, minima and the relative times at which they occur, with amplitudes normalised to percentage body weight and times to percentage of stance phase. This yields 20 scalar features, reduced to three by feature selection. No raw waveforms, time series or learned representations are used." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-011" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "'children with ASD', 'individuals with ASD', 'ASD subjects', 'ASD group', 'typically developing (TD) children', 'TD healthy children', 'normal children', 'normal gait patterns', 'ASD population'. Person-first for the participants but the comparison condition is repeatedly framed as 'normal' rather than 'typical' - 'ASD and normal gait', 'normal children' - which positions autistic gait as pathological by contrast; the paper also groups ASD gait with 'pathological gait' alongside cerebral palsy, stroke and Parkinson's disease." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-011" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Stepwise discriminant analysis with Wilks' lambda provides the interpretability, and the paper publishes the complete p-value distribution for all 20 candidate features - unusually transparent, since it lets a reader see exactly how sharp the separation between selected and discarded features is (three at p<=0.005, next best Fy1 at 0.084). The three retained features are interpreted anatomically as spanning loading response, mid-stance and terminal stance, and the altered second vertical peak is related to gait instability and body-weight support difficulties by analogy with cerebral palsy. The direction of each group difference is not reported." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-011" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional; a single walking session with no follow-up and no repeated measurement. The data are numeric force-plate traces rather than identifiable media, so privacy risk is minimal. Ethics approval is reported at the level of the parent project (Research Ethics Committee of Universiti Teknologi MARA), but no participant or parental consent statement and no anonymization or data-protection procedure is described." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-011" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Goal: automated ASD gait recognition to assist diagnosis, clinical decision-making and treatment targeting, plus identification of dominant GRF biomarkers. Main findings: three of 20 GRF features were statistically significant discriminators (Tx1 p=0.005, Ty2 p<0.001, Fz3 p<0.001); a three-input ANN achieved 93.3% accuracy, 96.7% sensitivity and 90.0% specificity, outperforming SVM-RBF (85.0%), SVM-polynomial (83.3%) and SVM-linear (78.3%) as well as the authors' earlier KNN approach." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-011" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2018. The paper notes that machine learning has been proven effective for automated gait recognition in cerebral palsy, post-stroke and Parkinson's disease, but that 'research in the area of automated recognition of ASD gait using machine learning techniques based on GRFs gait features is less prevalent' - positioning autism gait analysis as lagging behind other clinical gait populations, and its own contribution as an incremental extension of the authors' prior KNN study on the same data." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-011" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Supervised learning. Algorithms: a three-layer feed-forward artificial neural network trained by scaled conjugate gradient backpropagation, and support vector machines with linear, polynomial and RBF kernels. Stepwise discriminant analysis serves as a statistical feature-selection stage. The authors note that comparative studies often favour SVM, which makes their ANN result a departure from expectation." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-011" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Not reported. Participants are described only as 'previously diagnosed with a mild category of ASD' with no instrument, diagnostic criteria, diagnosing clinician or confirmation procedure named. Control status is asserted rather than screened. Since diagnostic label is the classification target, this is the study's most serious reporting gap." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-011" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Reported by the authors: only that evaluation on a larger dataset is needed to confirm the observations - there is no limitations section as such. Identifiable in review: feature selection by SWDA used group labels on the full dataset before cross-validation, and the exhaustive hyperparameter grid search (three SVM kernels, six C values, three polynomial degrees, 21 gamma values, 50 ANN hidden-layer sizes) was likewise performed outside the folds, so 93.3% is not an unbiased generalisation estimate; the reported figure is also the best of four classifier configurations; no gender data at all, so sex bias cannot be assessed in a literature with strong male skew; groups differ by ~0.9 years in mean age with no matching test, and gait matures with age; body mass SD is large and unequal; ASD recruitment is split across a specialist centre and social-media outreach with no comparison between subgroups; only one stance phase of one limb from one trial represents each child, so within-subject gait variability - itself a reported feature of autistic movement - is entirely discarded." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-011" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Weak. 10-fold cross-validation repeated over ten iterations is used and is explicitly motivated by small sample size, but both the label-using SWDA feature selection and the exhaustive hyperparameter grid search were performed on the complete dataset before the folds were drawn, so information from every test fold informed both the feature set and the model configuration. There is no external or independent validation, no held-out site, no class-imbalance issue (30/30), no statistical comparison between classifiers, no bias mitigation, and no real-time or deployment analysis - though clinical diagnosis and treatment evaluation are named as intended applications." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-011" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Straight barefoot walking along a 6.5-metre walkway at self-determined speed, with the two force plates positioned so that one foot strikes each. Trials were accepted only on a clean foot strike on each plate. Only a single left-limb stance phase from one selected valid trial per participant was analysed - an extremely small behavioral sample per child, and the selection criterion for which valid trial to use is not stated." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-011" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "TENCON 2018 - the IEEE Region 10 Conference. A general engineering/technology venue, neither autism-specific nor clinical, and broader than the specialist computer-vision and speech venues elsewhere in this corpus." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-011" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two directions only: deeper exploration of kinematic and kinetic gait parameters beyond ground reaction forces, and evaluation on a larger dataset. No proposals for external validation, for comparison against other motor-affected conditions, or for addressing the demographic and methodological gaps." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-011" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Author keywords: artificial neural network, autism spectrum disorder, gait classification, ground reaction force, support vector machine. Task vocabulary: 'automated recognition', 'gait disturbances', 'prominent biomarkers', 'pathological gait', 'clinical decision-making'. The framing situates autism alongside cerebral palsy, post-stroke and Parkinson's gait as a pathological gait recognition problem." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-011" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No data availability statement, no code release and no random seeds. Method reporting is otherwise good: the full 20-feature definition table, the complete SWDA p-value distribution for every feature, the SWDA entry and removal criteria, the sampling rate and filter settings, the SVM kernel types with their C and gamma grids, the polynomial degree range, and the ANN architecture and training function are all specified. The pipeline is re-implementable in principle but the analysis cannot be reproduced without the data." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-011" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Hardware: two independent Advanced Mechanical Technology Inc. force plates embedded consecutively in a 6.5 m walkway, recording medial-lateral, anterior-posterior and vertical forces at 1000 Hz. Software: second-order low-pass Butterworth filter with 30 Hz cut-off; IBM SPSS Statistics v21 for stepwise discriminant analysis; MATLAB R2015a Statistics and Machine Learning Toolbox and Neural Network Toolbox for SVM and ANN classification." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-011" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Single modality, but with a form of within-modality fusion: features from all three orthogonal GRF components (medial-lateral, anterior-posterior, vertical) are pooled into one candidate set, and the three surviving features happen to come one from each component - so the discriminative signal is genuinely distributed across all three force directions. No combination with clinical, cognitive or demographic data." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-011" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. No cognitive, linguistic or adaptive-functioning measures are reported for either group, and no autism severity instrument underlies the 'mild category' description. The only functional criteria are physical - no history of lower-extremity injury and ability to walk independently. Comorbidities are not otherwise described." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-011" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Accuracy, sensitivity and specificity, reported for all four classifier configurations. Headline: 93.3% accuracy, 96.7% sensitivity, 90.0% specificity for the ANN. No AUC, F1, precision, confidence intervals or fold-level variance, despite averaging over ten folds and ten iterations where a standard deviation would have been readily available." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-011" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Motor behavior: ground reaction forces during walking - the kinetic rather than kinematic aspect of gait, measuring the forces generated against the ground in three directions rather than limb trajectories or joint angles." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-011" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "Single session; a single left-limb stance from one selected valid trial per subject was analysed" ;
                    slr:study_design "Cross-sectional case-control classification study; an explicit methodological extension of the authors' earlier KNN-based study on the same cohort" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder (mild category)" ;
                    slr:sample_size_text "ASD/index: 30; comparison: 30" ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "ANN with scaled conjugate gradient: 93.3% accuracy, 96.7% sensitivity, 90.0% specificity. SVM-RBF 85.0% / 93.3% / 76.7%; SVM-polynomial 83.3% / 86.7% / 80.0%; SVM-linear 78.3% / 76.7% / 80.0%. The authors report this outperforms their previous KNN attempt on the same data",
                        "Three ground-reaction-force features - relative time to maximum supination, relative time to zero anterior-posterior force at mid-stance, and second vertical peak force - were statistically significant discriminators of ASD from typically developing gait, and a small feed-forward neural network using only these three features classified at 93.3% accuracy, outperforming all three SVM kernel variant" ;
                    slr:outcome "Accuracy, sensitivity and specificity per classifier" ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "ANN with scaled conjugate gradient: 93.3% accuracy, 96.7% sensitivity, 90.0% specificity. SVM-RBF 85.0% / 93.3% / 76.7%; SVM-polynomial 83.3% / 86.7% / 80.0%; SVM-linear 78.3% / 76.7% / 80.0%. The authors report this outperforms their previous KNN attempt on the same data; Three ground-reaction-force features - relative time to maximum supination, relative time to zero anterior-posterior force at mid-stance, and second vertical peak force - were statistically significant discriminators of ASD from typically developing gait, and a small feed-forward neural network using only these three features classified at 93.3% accuracy, outperforming all three SVM kernel variant" ] ] ;
