    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "some" ;
                    slr:supporting_quote "Consecutive clinical recordings with a clinically ascertained comparison group including language and developmental delay, and groups close on age and sex; but no cognitive or language measure in a cohort defined by limited verbal fluency, and the 20-second, 50-vocalisation minimum excludes an unreported number of the least verbal children." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "ADOS-2 administered by a clinician with research reliability, with raw scores used as the continuous target; the comparison group's low scores are instrument-verified." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "Participant-level 80:20 splits repeated 50 times with the ADOS distribution matched on four moments across partitions, hyperparameters tuned by random search under five-fold cross-validation, and results reported as means with standard deviations." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "Session durations, total detected speech per segmentation method and signal-to-noise ratio are all reported, but no accounting is given of children excluded by the minimum-speech requirement, and the composition of the 27-child comparison group between delay and typical development is not stated." ] ;
            slr:overall_judgment "some" ;
            slr:tool_used "QUADAS-2" ] .

<urn:slr:article:902ddbc85707> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Digitally-delivered healthcare is well suited to address current inequities in the delivery of care due to barriers of access to healthcare facilities. As the COVID-19 pandemic phases out, we have a unique opportunity to capitalize on the current familiarity with telemedicine approaches and continue to advocate for main­ stream adoption of remote care delivery. In this paper, we specifically focus on the ability of GuessWhat? a smartphone-based charades-style gamified therapeutic intervention for autism spectrum disorder (ASD) to generate a signal that distinguishes children with ASD from neurotypical (NT) children. We demonstrate the feasibility of using “in-the-wild”, naturalistic gameplay data to distinguish between ASD and NT by children by training a random forest classifier to discern the two classes (AU-ROC = 0.745, recall = 0.769). This performance demonstrates the potential for GuessWhat? to facilitate screening for ASD in historically difficult-toreach communities. To further examine this potential, future work should expand the size of the training sample and interrogate differences in predictive ability by demographic." ;
    dcterms:bibliographicCitation "Deveau N; Washington P; Leblanc E; Husic A; Dunlap K; Penev Y; Kline A; Mutlu OC; Wall DP (2022). Machine learning models using mobile game play accurately classify children with autism. *Intell*." ;
    dcterms:creator "Deveau N",
        "Dunlap K",
        "Husic A",
        "Kline A",
        "Leblanc E",
        "Mutlu OC",
        "Penev Y",
        "Wall DP",
        "Washington P" ;
    dcterms:title "Machine learning models using mobile game play accurately classify children with autism" ;
    bibo:pmid "local_6dcefc34" ;
    fabio:hasPublicationYear 2022 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are comparison groups matched on age?" ;
                            slr:justification "Only a whole-sample figure of 7.10 +/- 5.82 years, which is arithmetically impossible given inclusion at ages 3 to 12." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is developmental or language level measured?" ;
                            slr:justification "No cognitive, language, adaptive or severity measure, in a study whose primary feature is response latency." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are comparison groups matched on sex?" ;
                            slr:justification "67.9% versus 47.6% male among those reporting, with four comparison children not reporting and no comparison made." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are participants and recruitment adequately described?" ;
                            slr:justification "Four recruitment channels, inclusion criteria, group sizes and collection window given; no group-specific ages and no clinical characterisation." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is demographic fairness assessed?" ;
                            slr:justification "Acknowledged as impossible at this sample size, with a commitment to assess it as recruitment expands." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are the features defined precisely?" ;
                            slr:justification "Both families given with formulae and with the restriction to 17 CAFE prompts justified." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the measured interval attributable to the child?" ;
                            slr:justification "Duration spans prompt onset to the parent's tilt, so it includes the parent's recognition and labelling time - stated by the authors." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the elicitation context described reproducibly?" ;
                            slr:justification "Game mechanics, tilt-labelling convention, 90-second limit, prompt source and the four recorded event fields all specified." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the labeller blinded?" ;
                            slr:justification "The parent generates every accuracy label and knows their child's diagnosis; the authors propose an unblinded-examiner replication to address this." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the reference standard appropriate and independently applied?" ;
                            slr:justification "Parent report, mitigated by requiring confirmation of formal assessment and therapy reporting, but unverified." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "some concerns" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the unit of analysis stated?" ;
                            slr:justification "Features described as per-session while the sample is described as 49 children; child-disjointness cannot be confirmed." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is feature selection nested?" ;
                            slr:justification "Feature family chosen by inspecting importances across all 28 iterations, then models retrained on the subset." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is hyperparameter selection nested?" ;
                            slr:justification "Inner four-fold grid search selecting by AU-ROC, outer held-out fold for estimation, repeated seven times for 28 estimates." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are multiple model families compared on identical folds?" ;
                            slr:justification "Four families under two feature conditions with four metrics each, all sixteen results reported." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is uncertainty quantified?" ;
                            slr:justification "Distributions were bootstrapped from 28 estimates but no confidence intervals are printed, and no chance baseline is reported." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the modelling constrained appropriately for the sample size?" ;
                            slr:justification "Hyperparameter grids deliberately restricted toward regularisation because of n = 49." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is preprocessing performed within cross-validation folds?" ;
                            slr:justification "Outlier removal, imputation, standardisation and SMOTE all applied per split, with leakage named as the reason." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "low" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is privacy addressed substantively?" ;
                            slr:justification "The modality uses only four event fields per trial, so no imagery or audio is involved at all - a structural rather than procedural privacy property." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the principal confound acknowledged?" ;
                            slr:justification "The authors state that duration may measure the parent's labelling speed rather than the child's response." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the dataset accessible or its access conditions stated?" ;
                            slr:justification "No availability statement." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are feature-level findings reported and interpreted?" ;
                            slr:justification "Importances analysed across all folds, tested between families and aggregated by emotion, but no direction of effect is given for any feature." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are ethics and consent reported?" ;
                            slr:justification "Stanford IRB approval stated without a protocol number." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the result reported without inflation?" ;
                            slr:justification "AU-ROC 0.745 presented as demonstrating feasibility and potential rather than accuracy." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is code available?" ;
                            slr:justification "Not mentioned, though packages and hyperparameter grids are specified." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "some concerns" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None analysed. No cognitive, language, adaptive or severity measure was obtained for either group, and no comorbidity data are reported despite the diagnostic menu having captured alternative labels and despite therapy type having been collected. The absence matters for the specific construct at issue: response latency in an emotion-enactment task depends on receptive language, processing speed and motor planning, none of which is measured, and the sample spans ages 3 to 12 with no age reported by group. The authors list co-occurring diagnoses among the dimensions they cannot examine at this sample size." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-091" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "'children with ASD', 'children with autism', 'individuals with ASD', against 'neurotypical (NT) children'. Person-first throughout, with 'neurotypical' preferred over 'typically developing'. The framing is oriented toward access and equity rather than deficit: the introduction is organised around rural and low-socioeconomic disparities in identification, the observation that 'up to 80 pct. of counties in the U.S. lack sufficient diagnostic resources', and the argument that questionnaire-based screening performs worse for non-white and lower-education caregivers. The game itself is described as 'a gamified therapeutic intervention' designed to be 'an engaging and fun way for parents and children to interact', so the data collection is framed as a by-product of something intended to benefit the family rather than as extraction. The paper also engages briefly with the ethics of framing, noting 'some disagreement about the patient as a consumer model' before arguing that user experience nonetheless matters for engagement." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-091" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two limitations are stated and both are substantive, and one further caveat appears in the discussion that is arguably more important than either. The stated limitations are that the sample is too small to evaluate performance across demographic dimensions - gender, ethnicity, nationality, age and co-occurring diagnoses - with a commitment to demographic fairness validation as recruitment expands; and that the study should be reproduced 'in a clinical setting in which the person displaying the prompts to the child is neither a parent nor informed of the child's diagnosis', which would remove both parental leniency in labelling and the unblinding of the person generating the labels. The discussion caveat is the one that bears on the headline: 'the duration-based measures in this study could capture the speed with which a parent marks a prompt as correct as opposed to the speed with which it takes the child to answer the prompt' - so the feature family carrying nearly all the signal may be measuring the parent. The authors also diagnose why the accuracy features failed, attributing the ceiling effect to 'parents incorrectly labeling or a game design that was too easy for the majority of children regardless of diagnosis'. Not acknowledged: the implausible age standard deviation; the absence of any group-specific demographics; and the unit-of-analysis ambiguity." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-091" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No keyword list appears in the extracted text. The operative vocabulary is digital phenotyping, gamified therapeutic, remote screening, telehealth and health equity - a digital-health and access register rather than a machine-learning one, matching a paper whose contribution is a deployment argument supported by a modest classifier." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-091" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Four directions, two of which would directly test the study's own weaknesses. Reproducing the paradigm with an examiner who is neither the parent nor informed of the diagnosis would isolate the child's contribution to the duration measure from the parent's and would blind the labeller - addressing the confound and the unblinding in a single design change, and it is the right experiment. Expanding recruitment to permit demographic subgroup validation follows directly from the equity framing that motivates the study, since a tool proposed to reduce disparities must be shown not to perform differentially across the groups it is meant to serve. The remaining two are extending prompts beyond CAFE images to video, and investigating how the parent-child dyadic relationship shapes the signal - the latter framed as scientific rather than merely methodological." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-091" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Goal: determine whether the GuessWhat game generates a signal separating autistic from neurotypical children using only objective gameplay metadata, as a step toward an easily deployed remote screening tool. Main findings: AU-ROC 0.745 with recall 0.769 for the best model (random forest on duration features); duration features significantly more important than accuracy features (t = 5.15, p = 1e-5); accuracy features uninformative because they cluster at ceiling in both groups; three of four classifiers improved or held when accuracy features were removed; and disgust, surprise and sadness prompts carried the most importance among duration features." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-091" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Four classifier families selected on three reasoned criteria rather than by convention: no a priori assumption about linearity, so both linear and non-linear families are tested; the small sample, motivating families 'that offered considerable flexibility to prevent overfitting through regularization'; and interpretability, 'to gain insight into the specific aspects of gameplay that predict ASD'. The hyperparameter grids are tabulated in full and were deliberately restricted 'to include hyperparameters that would lead to more regularization and less overfitting' - so the search space itself was biased against complexity because of n = 49, which is a considered decision rather than a default. The spread across families is informative: tree-based methods reach AU-ROC 0.73-0.75 while linear methods reach 0.67-0.71, and linear SVM achieves the highest precision at 0.70 while tree methods achieve the highest recall, so the choice among them is a genuine operating-point decision. Model selection is stated as 'the simplest model resulting in the highest average of AU-ROC and Recall', a criterion declared before the comparison rather than fitted to it." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-091" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Among the best-handled in the corpus on the dimensions the paper controls. Leakage is named explicitly and designed against: 'To avoid incorporating information from the distribution of the training data into the test set (i.e., data leakage), we carried out the following preprocessing steps separately for each test-train split of the data' - covering outlier removal, k-nearest-neighbour imputation, standardisation and SMOTE upsampling. Performing imputation and resampling inside the fold rather than on the full dataset is the correct handling and is violated by several studies here, including Liao and colleagues who select features on the whole sample and Kanhirakadavath and colleagues who fit principal components before splitting. The validation structure is genuine nested cross-validation - inner four-fold grid search selecting hyperparameters by AU-ROC, outer held-out fold estimating performance, repeated seven times for 28 estimates - so hyperparameter selection cannot contaminate the reported figures. Two residual issues. Feature selection was performed by inspecting importances across the 28 iterations and then retraining on the duration subset, so that selection used information from all folds; the effect is likely small since the selection is a binary family choice made on a large and statistically tested difference, but it is not nested. And the unit of analysis is not stated, so whether the folds are child-disjoint cannot be confirmed. Set against the corpus, the reported AU-ROC of 0.745 is modest precisely because these controls are in place, and the paper presents it as feasibility rather than accuracy." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-091" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional, with data accumulated opportunistically across nearly four years as families played and shared. Stanford Institutional Review Board approval is stated, though without a protocol number, and recruitment channels are named. The privacy position is a genuine design property rather than a claim: because the analysis uses only four event fields per trial - start time, end time, correct flag, skip flag - no imagery, audio or identifiable content is involved at all, which the authors present as enabling screening 'in a privacy-preserved manner' and contrast with computer-vision approaches where 'privacy concerns are at the forefront'. Among the three GuessWhat studies in this corpus, this is the only one whose modality raises no confidentiality question." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-091" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None beyond a smartphone the family already owns - iOS or Android, with internet access, and no model, sensor or specification requirement, because the data are event timestamps rather than recordings. This is the most minimal data-collection footprint in the review and it is the paper's principal translational argument: a screening signal derived from four fields per trial imposes no bandwidth cost for video upload, no storage burden, no annotation pipeline and no privacy exposure. Analysis used Python with scikit-learn and XGBoost, with hyperparameter grids tabulated for all four classifier families." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-091" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Parent report, with a described mitigation that is more substantive than most. Caregivers were required to confirm that the diagnosis 'came from a formal medical assessment', to select a diagnostic label from a menu including several distinctions that a family without evaluation experience would be unlikely to navigate - Autism Spectrum Disorder, Autistic Disorder, PDD-NOS, Asperger Syndrome, ADHD/ADD, anxiety, speech and language delay - and to report the specific therapies their child was receiving, on the reasoning that 'this information requires a specialized understanding of the autism diagnosis and subsequent treatment prescriptions'. That is a coherent design: it uses the specificity of diagnostic and treatment vocabulary as an indirect check on whether a formal evaluation occurred. It remains parent report, with no instrument, clinician contact or record verification, and the therapy information collected as part of the check is never described or analysed. Comparison-group status rests on parental assertion with no screening at all." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-091" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Participants' own homes with no researcher present, no equipment provision and no environmental control - 'this study was conducted remotely' - which is the design's entire point. The equity argument is developed at length and with specifics rather than as a gesture: prevalence is similar in rural (0.9%) and urban (1.0%) areas but rural communities face limited access to identification and intervention services; up to 80% of US counties lack sufficient diagnostic resources; and existing questionnaire-based screening 'require[s] literacy and perform[s] worse with non-white and lower education caregivers', so digitising those questionnaires 'risks exacerbating current disparities'. The proposed alternative - deriving signal from behaviour rather than from caregiver report - would in principle be insensitive to caregiver literacy, though the game itself still requires a smartphone, internet access and English." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-091" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The weakest demographic reporting relative to the paper's methodological care elsewhere. Sex is given as 19 male and 9 female among autistic children and 10 male, 7 female and 4 unspecified among comparison children - so 67.9% versus 47.6% male among those reporting - with no comparison or discussion. Age is reported only as a whole-sample figure of 7.10 +/- 5.82 years, with no group-specific means, and that figure is arithmetically implausible: with inclusion restricted to ages 3 to 12, a standard deviation of 5.82 cannot arise, since the entire range spans nine years. Whether this is a transcription error or a computation over a different variable cannot be determined. No IQ, language, adaptive or severity measure for either group. The authors identify the consequence in their limitations - 'the sample size was too small to evaluate the predictive power of our models across various demographic dimensions, including gender, ethnicity, nationality, age and other diagnosis' - and commit to demographic fairness validation as recruitment expands, which is the right commitment but does not substitute for reporting what was collected." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-091" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Mean AU-ROC, recall, accuracy and precision reported for all four classifiers under both feature conditions - sixteen complete result rows - with the values being means across 28 nested cross-validation iterations rather than single-split point estimates, and with distributions bootstrapped from those 28 sets. Reporting the full grid rather than only the winner exposes the tradeoff structure: linear SVM has the best precision on the full feature set while tree methods have the best recall, and XGBoost is the only model that degrades on the reduced set. The metric-selection reasoning is also made explicit, with the authors arguing for choosing 'the model that results in the highest average of AU-ROC and Recall' and undertaking to discuss the practical considerations of each metric. What is missing: no confidence intervals are printed despite distributions having been bootstrapped, and no chance or trivial baseline is reported - which matters at n = 49, where an AU-ROC of 0.745 estimated over 28 folds of roughly 12 held-out children each carries substantial uncertainty." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-091" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Thirty-four scalar features per child, derived directly from four event fields with no signal processing, feature learning or dimensionality reduction. The representation is maximally interpretable - each feature is 'percent correct on the disgust prompt' or 'mean response duration on the surprise prompt' - which is what makes the feature-importance analysis meaningful and what allows the finding to be stated in behavioural terms. Restricting to the 17 most commonly presented prompts 'in order to minimize missing-data imputation' is a sensible data-quality decision that is stated and justified. The one unresolved representational question is aggregation: features are described as computed 'for a single session of gameplay' while the sample is 49 children, and the paper does not state whether a child playing several sessions contributes several rows. If it does, the nested cross-validation would not be child-disjoint and the estimates would inherit the within-subject leakage that the paper is otherwise careful to avoid." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-091" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A 90-second charades game in which the parent holds the phone against their forehead displaying a prompt they cannot see, the child acts it out, and the parent guesses and labels the outcome by tilting the phone. The prompts analysed are 17 CAFE facial-emotion photographs spanning anger, fear, sadness, happiness, surprise, disgust and neutrality, so the task requires the child to recognise an emotion and enact it recognisably to another person - a compound demand the authors characterise carefully as 'a complex interaction between child performance and parent interpretation', functioning as 'a proxy for emotion recognition' that 'likely captures components of theory of mind, metacognition and many other phenomena, as well'. The design's strength is that the parent's guessing behaviour makes the child's enactment functionally consequential rather than performed for a camera. Its corresponding weakness, which the authors state, is that the parent is inside the measurement loop: they set the end of every timed interval and they generate every accuracy label." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-091" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2022. The framing is a health-equity and access argument built around the COVID-19 transition to remote care, and it is more specific than the corpus norm at each step. Prevalence is similar in rural (0.9%) and urban (1.0%) areas, but rural communities face limited access to identification and intervention, and 'up to 80 pct. of counties in the U.S. lack sufficient diagnostic resources'. The critique of existing screening is where the paper is sharpest, and it is a critique this review should record: caregiver-report questionnaires 'require literacy and perform worse with non-white and lower education caregivers', so 'naively deploying digitized versions of diagnostic questionnaires risks exacerbating current disparities in the early identification of ASD'. That argument - that digitising an instrument inherits and can amplify its demographic bias - is made by no other paper here, and it motivates the study's choice to derive signal from a child's behaviour rather than a caregiver's report. The paper also engages with adoption as a design problem, noting that 'delays in the adoption of telehealth have been attributed to unengaged and resisting users' and that 'simply providing the current physician interaction through a smartphone may not be the best way of providing remote care', which is why the data collection is embedded in a game with progression mechanics rather than an assessment. Whether the resulting AU-ROC of 0.745 supports the deployment ambition is a separate question, and the abstract is appropriately hedged, claiming feasibility and 'potential' rather than accuracy." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-091" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Strong on modelling, weak on participants, with one substantive ambiguity. Fully reported: the game mechanics including the tilt-labelling convention; the four event fields recorded; the rationale for restricting to CAFE prompts; both feature definitions with their formulae; the complete preprocessing sequence with its ordering, the three-standard-deviation outlier rule, k = 3 for imputation, and SMOTE; the explicit statement that preprocessing occurs within each split; the nested cross-validation structure with outer and inner fold counts and the seven repetitions; the selection criterion of AU-ROC in the inner loop; hyperparameter grids for all four classifiers; the deliberate bias of the search space toward regularisation; and all sixteen performance figures across two feature conditions. Not reported: group-specific ages; any demographic comparison; the therapy information collected as a diagnostic check; whether a child contributing multiple sessions supplies multiple rows to the dataset; the IRB protocol number; and any data or code release. The unit-of-analysis ambiguity is the most consequential gap given the paper's otherwise careful leakage handling." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-091" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Single modality with no fusion, but the feature-family comparison functions as a well-executed ablation and yields the study's clearest finding. Two families of seventeen features each - accuracy and duration - are compared in three ways: by model-derived importance across all 28 cross-validation iterations for all four classifiers, by a statistical test of the difference in mean importance (t = 5.15, p = 1e-5), and by retraining on the duration subset alone. All three converge: duration dominates, and removing accuracy improves or maintains performance in three of four classifiers, with XGBoost the only exception. The diagnosis of why is equally clean - accuracy scores cluster at ceiling in both groups, so the feature carries no variance to exploit - and the authors offer two candidate explanations, lenient parental labelling or a game too easy for most children, either of which would be actionable in redesign. This is what a feature ablation should look like, and it is more informative than the several fusion claims elsewhere in this corpus that rest on an accuracy delta alone." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-091" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The most thorough feature-importance analysis in the corpus relative to the size of the study. Importances are extracted from the best model at each of the 28 cross-validation iterations for each of the four classifier families and displayed as per-iteration heatmaps, so stability across folds is directly visible rather than asserted from a single fit. The two feature families are then compared statistically, yielding a large and significant separation (t = 5.15, p = 1e-5), and importances are aggregated by emotion category to give an interpretable ranking. The finding that disgust prompts carry the most importance, followed by surprise and sadness, is then connected to independent evidence that 'younger children are worse at discriminating facial expressions of disgust and surprise when images of these expressions are presented alongside specific other emotions', suggesting these emotions require more cognitive development to process - a mechanistic account that generates a testable prediction rather than a post hoc rationalisation. The authors immediately temper it, warning against 'an oversimplified understanding of these features'. The one weakness is that no direction of effect is reported: it is not stated whether autistic children took longer or shorter on disgust prompts, so the finding is that the feature discriminates without saying how." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-091" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Emotion recognition, targeted through a compound behaviour whose composite nature the authors are unusually careful about. The stated construct is grounded in prior work showing that autistic and neurotypical children differ both in 'the ability to correctly identify an emotion and the reaction time required to do so', and the two feature families map onto exactly those two components. But the measured behaviour is not the child's recognition alone: it is the child recognising the emotion, planning and executing an enactment, and the parent interpreting that enactment and responding. The paper states this rather than eliding it, describing the process as 'a complex interaction between child performance and parent interpretation' and noting that treating it as a proxy for emotion recognition risks 'an oversimplified understanding', since it 'likely captures components of theory of mind, metacognition and many other phenomena, as well'. That is the right level of caution for a construct that no single measurement isolates, and it is rarer in this corpus than it should be." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-091" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Intelligence-Based Medicine 6:100057 (2022), an Elsevier open-access journal. Authorship spans Stanford's Departments of Biomedical Data Science, Bioengineering, Pediatrics and Electrical Engineering, from the same group and the same GuessWhat platform as the crowdsourced speech study and the gaze study elsewhere in this corpus - three papers analysing three different data streams from one app. No competing-interest declaration appears in the extracted text, though the senior author declares founding Cognoa in both companion papers. The paper carries some marks of light editing, including a placeholder left in the methods ('need figure/graphic showing this') and a misspelling in the introduction." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-091" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two groups from a remotely recruited convenience sample: 28 children with a parent-reported formal autism diagnosis (19 male, 9 female) and 21 neurotypical children (10 male, 7 female, 4 not reporting sex), 49 in total, with data accumulated between April 2017 and February 2021. Recruitment ran through four channels - the app's existing user base, the Hartwell Foundation's KidsFirst autism research database, ResearchMatch.org and Facebook advertisements - which is a more diverse sampling frame than the single-channel recruitment typical here, though all routes select for families with smartphones, internet access and English literacy, and the last two select for research-engaged families. No other-diagnosis comparison group, though the diagnostic menu presented to parents included ADHD/ADD, anxiety and speech and language delay, so children with those labels would presumably have been identifiable had they been recruited. The class imbalance is modest (28 to 21) and is handled by SMOTE upsampling applied within each cross-validation split rather than to the whole dataset." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-091" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "90-second gameplay sessions; data accumulated between April 2017 and February 2021" ;
                    slr:study_design "Cross-sectional classification on a remotely collected convenience sample, structured as a comparison of four classifier families with a feature-family ablation" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Children aged 3 to 12 with a parent-reported formal autism diagnosis" ;
                    slr:sample_size_text "ASD/index: 28 children (19 male, 9 female); comparison: 21 children (10 male, 7 female, 4 not providing sex information)" ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "Event metadata alone - prompt onset, prompt end, and a parent's correct-or-incorrect label - supported autism classification at AU-ROC 0.745 and recall 0.769 in 49 children, using no video, audio or imagery of any kind. The signal resides almost entirely in response latency rather than task accuracy: duration features were significantly more important than accuracy features (t = 5.15, p = 1e-5), a",
                        "Full feature set: XGBoost best at AU-ROC 0.74 and recall 0.76, random forest 0.73 and 0.76, linear SVM 0.70 and 0.70 with the highest precision at 0.70, logistic regression 0.67 and 0.67. Duration-only subset: random forest best at AU-ROC 0.75, recall 0.77, accuracy 0.72 and precision 0.67; linear SVM 0.71 and 0.74; logistic regression 0.69 and 0.69; XGBoost fell to 0.70 and 0.72, the only model t" ;
                    slr:outcome "Mean AU-ROC, recall, accuracy and precision across the 28 cross-validation iterations, reported for all four classifiers under both the full 34-feature set and the 17-feature duration-only subset" ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "Full feature set: XGBoost best at AU-ROC 0.74 and recall 0.76, random forest 0.73 and 0.76, linear SVM 0.70 and 0.70 with the highest precision at 0.70, logistic regression 0.67 and 0.67. Duration-only subset: random forest best at AU-ROC 0.75, recall 0.77, accuracy 0.72 and precision 0.67; linear SVM 0.71 and 0.74; logistic regression 0.69 and 0.69; XGBoost fell to 0.70 and 0.72, the only model t; Event metadata alone - prompt onset, prompt end, and a parent's correct-or-incorrect label - supported autism classification at AU-ROC 0.745 and recall 0.769 in 49 children, using no video, audio or imagery of any kind. The signal resides almost entirely in response latency rather than task accuracy: duration features were significantly more important than accuracy features (t = 5.15, p = 1e-5), a" ] ] ;
