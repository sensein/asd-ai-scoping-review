    slr:journal "Bulletin of Elec" ;
    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "Both groups recorded under an identical protocol in the same controlled environment with standardised lighting, fixed resolution and frame rate, and the landmark representation discards appearance, clothing, skin tone and background before modelling - genuine acquisition and confound control. But facial mesh geometry retains sex-linked morphology in a sample whose classes differ sharply by sex, no landmark-detection failure handling is reported, and camera distance and angle are unstated." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "No diagnostic instrument, criteria, clinician qualification, setting or date is given for the 50 children described as diagnosed with autism, and no screening procedure is described for the comparison group - in a prospective study that designed its own protocol and therefore had the opportunity to document ascertainment." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "Subject-independent stratified 5-fold cross-validation with the mechanism and its anti-leakage purpose stated explicitly, class ratio preserved across folds, and four overfitting controls specified with their parameters. All 100 children contribute; no attrition is reported." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Fifty autistic and 50 typically developing children with no recruitment source stated, no age distribution by group across a 5-to-9 range, no cognitive or language characterisation, and a 32-percentage-point sex imbalance between groups (84% male against 52%) that is reported without adjustment or discussion." ] ;
            slr:overall_judgment "high" ;
            slr:tool_used "QUADAS-2" ] .

<https://doi.org/10.3389/fped.2020.00290> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "ORIGINAL RESEARCH published: 05 June 2020 doi: 10.3389/fped.2020.00290 Frontiers in Pediatrics | www.frontiersin.org 1 June 2020 | Volume 8 | Article 290 Edited by: Sara Calderoni, Fondazione Stella Maris (IRCCS), Italy Reviewed by: Whitney I. Mattson, Nationwide Children’s Hospital, United States Lori-Ann Rosalind Sacrey, University of Alberta, Canada *Correspondence: Xiaoyan Ke kexiaoyan@njmu.edu.cn Specialty section: This article was submitted to Child and Adolescent Psychiatry, a section of the journal Frontiers in Pediatrics Received: 05 January 2020 Accepted: 07 May 2020 Published: 05 June 2020 Citation: Qiu N, Tang C, Zhai M, Huang W, Weng J, Li C, Xiao X, Fu J, Zhang L, Xiao T, Fang H and Ke X (2020) Application of the Still-Face Paradigm in Early Screening for High-Risk Autism Spectrum Disorder in Infants and Toddlers. Front. Pediatr. 8:290. doi: 10.3389/fped.2020.00290 Application of the Still-Face Paradigm in Early Screening for High-Risk Autism Spectrum Disorder in Infants and Toddlers Nana Qiu 1, Chuangao Tang 2, Mengyao Zhai 1, Wanqing Huang 3, Jiao Weng 1, Chunyan Li 1, Xiang Xiao 1, Junli Fu 1, Lili Zhang 4, Ting Xiao 1, Hui Fang 1 and Xiaoyan Ke 1* 1 Nanjing Brain Hospital Afﬁliated to Nanjing Medical University, Nanjing, China, 2 School of Biological Science & Medical Engineering, Southeast University, Nanjing, China, 3 College of Telecommunications & Information Engineering, Nanjing University of Posts and Telecommunications, Nanjing, China, 4 Wuxi Children’s Hospital, Wuxi, China" ;
    dcterms:bibliographicCitation "Qiu N; Tang C; Zhai M; Huang W; Weng J; Li C; Xiao X; Fu J; Zhang L; Xiao T; Fang H; Ke X (2020). Application of the Still-Face Paradigm in Early Screening for High-Risk Autism Spectrum Disorder in Infants and Toddlers. **. https://doi.org/10.3389/fped.2020.00290" ;
