        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "Although the accuracy rate is not high, it is important to note that this is largely due to the limited amount of data available in the dataset, with only 547 images available for both classes. Future works can explore data augmentation techniques, such as GANs, to tackle the issue of limited data availability." ] ;
            oa:hasTarget <urn:slr:article:ff89c89464cc> ;
