            slr:screening_stage "full_text" ],
        [ a prov:Activity,
                slr:ScreeningDecisionRecord ;
            dcterms:title "Hierarchical POMDP Framework for a Robot-Assisted ASD Diagnostic Protocol" ;
            bibo:pmid "local_9528024b" ;
            slr:assessed_on "full_text" ;
            slr:decision "include" ;
            slr:decision_rationale "Full text confirms 15 preschool children (8 with ASD, 7 typically developing), a four-task robot-administered protocol with NAO robots, POMDP belief inference over autism-related states, and an exploratory evaluation of the resulting belief distributions against expert behavioural assessment. Included as a computational assessment study, with the important caveat that it reports belief distributions rather than classification accuracy." ;
            slr:full_text_source "user_supplied_pdf" ;
            slr:screening_stage "full_text" ],
        [ a prov:Activity,
