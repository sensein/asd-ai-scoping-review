    slr:journal "Journal of C" ;
    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "Each respondent contributes one row, so the split unit is the person; 80/20 partitions are tabulated with absolute sizes for all four datasets; class distributions are reported and the decision not to oversample is explained. Sound mechanics on a degenerate task." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Ten binary responses to a screening questionnaire, answered by a parent, relative or health professional for the child bands, together with registration metadata. Nothing measured, observed or elicited; and the index test's inputs determine the reference standard arithmetically." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Self-selected users of autism screening applications, aggregated by third parties, with positive rates of 69% among toddlers and 61% among adolescents that reflect help-seeking rather than population prevalence. Age, gender and ethnicity are present as fields but no distribution is reported for any of them." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "No clinical diagnosis exists for any respondent. The class variable is the summed A1-A10 item score thresholded at the instrument's published cut-off - a deterministic function of the model's own inputs, with the sum additionally present among the tabulated fields." ] ;
            slr:overall_judgment "high" ;
            slr:tool_used "QUADAS-2" ] .

<urn:slr:article:7663a08834eb> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Autism Spectrum Disorder (ASD) is a neurodevelopmental disorder that affects how people talk to each other and act. The fact that ASD is becoming more common and that diagnosing it can be difficult means that early detection is important for improving treatment outcomes. This study's goal is to use lightweight ensemble Convolutional Neural Networks (CNN) to make it easier to classify ASD from facial photos. The study looks at different CNN architectures, like MobileNetV2 and EfficientNet variations, to find the best model for diagnosing ASD quickly and accurately. The method involves training and testing five lightweight CNN models on a set of facial photos. We use preprocessing methods like scaling and data augmentation to help the model learn better. The study tests how well ensemble CNN models work by combining predictions from different architectures using averaging and voting methods. We use important performance metrics like accuracy, precision, recall, and F1-score to see how well each model works. The results show that the best balance between accuracy and computational efficiency is achieved by combining MobileNetV2 and EfficientNetB0. This combination achieves an accuracy of 0.8299, a precision of 0.8514, a recall of 0.8182, and an F1_score of 0.8344. Other models, like ResNet50 combined with EfficientNetB0, have higher precision but lower recall, making them less useful for finding all ASD cases. This study was also compared with other researchers, and the proposed study was found to have greater accuracy than other researchers. The results show that ensemble CNN models can significantly improve the accuracy of classifying ASD compared to single CNNs. This study shows that lightweight ensemble CNN models are good at finding ASD in pictures of people's faces. The method is fast and can be used on devices with limited processing power, making it a good way to find ASD early in both clinical and real-world settings." ;
    dcterms:bibliographicCitation "Nugroho AK; Priyanto JE; Vinski DSP (2025). Detection of Autism Spectrum Disorder (ASD) Using Lightweight Ensemble CNN Based on Facial Images for Improved Diagnostic Accuracy. *International Journal of*." ;
    dcterms:creator "Nugroho AK",
        "Priyanto JE",
        "Vinski DSP" ;
    dcterms:title "Detection of Autism Spectrum Disorder (ASD) Using Lightweight Ensemble CNN Based on Facial Images for Improved Diagnostic Accuracy" ;
    bibo:pmid "local_0a39cca9" ;
    fabio:hasPublicationYear 2025 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Participant selection and spectrum representativeness" ;
                            slr:justification "A mixed public and clinic-sourced image corpus with no ascertainment, no spectrum description, and the number of distinct children unreported." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Handling of missing data and attrition" ;
                            slr:justification "Exact class counts are reported and augmentation operations specified; no image-quality criteria, exclusions or source-wise counts are given." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Comparison group adequacy" ;
                            slr:justification "Images labelled normal whose source is not identified - the fact that determines whether the mixed-source design mitigates or compounds the branch's provenance confound." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Confounder control" ;
                            slr:justification "No age, sex or ancestry data, in a corpus combining international web-scraped images with photographs from an Indonesian clinic, where all three would be expected to differ by source." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Index test definition and prespecification" ;
                            slr:justification "Five pairings, both combination rules and the softmax-plus-threshold structure are specified in advance; hyperparameters and the decision threshold value are not." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Reference standard quality" ;
                            slr:justification "None described for either source, including the autism-centre portion where clinical diagnoses would have been obtainable." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Measurement standardisation" ;
                            slr:justification "Two image sources with different cameras, lighting and photographic conventions, partially addressed by contrast-adjustment augmentation but never tested by a source-wise analysis." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Outcome measurement blinding" ;
                            slr:justification "Classification is fully automated with no human rater at inference." ;
                            slr:rating "Low" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Data splitting and leakage control" ;
                            slr:justification "Image-level 80:20 split with no cross-validation, the number of distinct children unreported, and no source-held-out evaluation despite two identifiable sources being available." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Performance estimation and chance level" ;
                            slr:justification "Four internally consistent metrics per pairing with learning curves interpreted for stability, and a screening-appropriate reading of the precision-recall trade-off. No specificity, AUC, confusion matrix, interval or chance baseline." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Preprocessing and feature selection nesting" ;
                            slr:justification "No feature selection is performed; augmentation ordering relative to splitting is unstated, and rotation, flip and contrast variants of one photograph are near-duplicates." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Sample size adequacy for the modelling" ;
                            slr:justification "Lightweight architectures on 2,936 images is a reasonable match; the effective sample depends on the unreported number of distinct children." ;
                            slr:rating "Unclear" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Ethics, consent and conflicts" ;
                            slr:justification "No ethics or consent statement anywhere, despite part of the corpus comprising identifiable photographs of children attending an autism centre. Funding and competing interests are also absent." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Completeness of methods reporting" ;
                            slr:justification "Class counts, both sources, split ratio, preprocessing and augmentation operations, all five pairings, both combination rules, four metrics each and learning curves are reported. Source proportions, participant counts, augmentation ordering and hyperparameters are not." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Data, code and protocol availability" ;
                            slr:justification "The Kaggle portion is public; the clinic-sourced portion is not described as available; no code is released." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Reporting of results and uncertainty" ;
                            slr:justification "Point estimates only across four metrics, with no specificity, confusion matrix, confidence interval or chance baseline." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Acknowledgement of limitations" ;
                            slr:justification "No limitations section, and a conclusion that repeats the results paragraph almost verbatim without critical reflection." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Decision-level ensembling rather than modality fusion. Two CNNs classify independently and their outputs are combined by probability averaging or majority voting, with the stated rationale that this 'makes the system more reliable and accurate by lowering the chance of errors from a single model and making it better at generalizing new data'. Five pairings are compared, which gives real architectural breadth, and the pairings deliberately combine a lightweight backbone with an EfficientNet variant of differing scale. No ablation reports single-model performance against the ensembles, so the claimed ensembling gain is asserted rather than demonstrated." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-140" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Published 2025 by an electrical engineering group at Universitas Semarang with collaborators at Institut Kesehatan Indonesia and a Jakarta stem-cell laboratory. For this review the study is the tenth built on the Kaggle facial-image corpus family and the only one to supplement it with images from a clinical service - an autism centre in Semarang - which makes it both the branch's most interesting variation and its clearest missed opportunity. Mixing a web-scraped collection with clinic photographs could have anchored part of the corpus in real diagnoses; instead the paper reports neither the proportion from each source nor how they distribute across the two classes, so a reader cannot tell whether the addition reduces the provenance confound documented across the other nine studies or replaces it with a sharper one, in which Indonesian clinic photographs and international web images are separable by ancestry, camera and setting alone. The paper's own description of what the network extracts - 'the shape of the face, the expression on it, and the texture of the skin' - is unusually candid about the range of information a whole-image CNN receives, and names skin texture, which is exactly the kind of property that tracks image source rather than the child. The remedy was in the study's hands: with two identifiable sources it could have trained on one and tested on the other, and that single experiment would have been the most informative result in the entire facial-image branch of this review. Three further observations. The reported 0.8299 accuracy with precision 0.8514, recall 0.8182 and F1 0.8344 is internally consistent and among the branch's lower figures, and the study benchmarks itself against comparators at 0.7500 and 0.8050 rather than against the high-nineties claims elsewhere. Its precision-recall discussion is the branch's best, correctly judging a high-precision low-recall model 'less useful for finding all ASD cases'. And its account of rising prevalence is accurate where most of this corpus is alarmist, attributing the change from 1 in 150 to 1 in 36 to diagnostic criteria, awareness and broader age-range detection. Against this: no ethics or consent statement anywhere, despite identifiable photographs of children attending a clinical service; no diagnostic ascertainment described even for that portion; no demographic data; image-level splitting with the number of children unreported; no specificity or confusion matrix; and no limitations section." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-140" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Plain and largely accurate, with one notable feature. Autism is 'a developmental disorder that affects how a person talks, interacts with others, and thinks and acts', and the description of the spectrum is correct - conditions 'that used to be called classic autism, Asperger's syndrome, and undefined pervasive developmental disability are now part of ASD. This spectrum shows how different people can have very different symptoms'. 'Normal' is used as the class label for non-autistic children, which is the least careful terminology choice. What sets the framing apart is the treatment of rising prevalence: the paper records the increase from 1 in 150 in the early 2000s to 1 in 36 in 2023 and attributes it correctly to 'changes in how autism is diagnosed, more people and healthcare professionals being aware of it, and better detection of autism across a wider range of ages' - an accurate account that most papers in this corpus replace with an alarm narrative. The Indonesian framing is also specific rather than generic, noting the scarcity of national statistics and the reliance on Ministry of Health reports and local studies. No neurodiversity framing appears and no autistic person is reported as involved." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-140" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. No severity, cognitive, adaptive or language measure exists for any image." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-140" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No acquisition equipment is described. The architectural argument is explicitly about deployment hardware: MobileNetV2 and EfficientNetB0 were chosen 'because they are fast and have small models', using depthwise separable convolutions and compound scaling so that inference is quick enough for 'devices with limited processing power, like mobile phones or edge devices used in clinical settings'. That is a coherent design rationale for a low-resource context and connects the architecture choice to the stated Indonesian setting, where the paper notes national statistics are scarce." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-140" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The aim is to identify a lightweight CNN ensemble that classifies autism from facial photographs accurately enough for deployment on mobile or edge devices. Five pairings were compared - MobileNetV2 with EfficientNetB0, B5 and B7; ResNet50 with EfficientNetB0; VGG16 with EfficientNetB0 - combined by probability averaging or majority voting. The best, MobileNetV2 with EfficientNetB0, reached accuracy 0.8299, precision 0.8514, recall 0.8182 and F1 0.8344, an internally consistent set and among the lower figures in this branch. Two aspects of the reporting are better than the branch norm. The precision-recall trade-off is interpreted in screening terms: ResNet50 with EfficientNetB0 achieved 'higher precision but lower recall, making them less useful for finding all ASD cases', which correctly identifies that a screening instrument's priority is not missing cases. And the learning curves are read substantively for stability and overfitting rather than displayed decoratively, with some pairings noted to show 'slower learning with more fluctuations, indicating less stable models that might struggle with generalization'. The comparison table places the result against two prior studies at 0.7500 and 0.8050 - modest comparators, and the study does not claim to have exceeded the high-nineties figures reported elsewhere in the branch." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-140" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Facial appearance, described more honestly than in most of this branch. Rather than asserting a specific craniofacial phenotype, the paper says the network finds 'important patterns in the image, such as the shape of the face, the expression on it, and the texture of the skin'. That enumeration is accurate about what a whole-image CNN actually receives, and it names two properties - expression and skin texture - that are not morphological and would vary with photographic circumstance rather than with the child. Naming skin texture as a used feature is particularly pointed in a corpus mixing an internationally scraped collection with photographs from an Indonesian clinic, since skin appearance in an image is jointly determined by ancestry, lighting and camera. No landmark geometry or morphometric quantity is computed anywhere." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-140" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "International Journal of Advanced Computer Science and Applications 16(7):229ff, 2025. An open-access computer science venue, and the profile follows: the ensemble pipeline, augmentation, split ratio and metric tables are documented, while the corpus's dual provenance is left unquantified, no ethics statement appears despite clinic-sourced images, no limitations section is provided, and the conclusion repeats the results paragraph verbatim. An unedited template placeholder survives in the keyword list." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-140" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. The photographs were taken outside any study, in unknown circumstances, for both portions of the corpus. The paper's description of what the network extracts - face shape, expression and skin texture - underlines the consequence: with no task and no controlled acquisition, expression at the captured instant is free to vary with why the photograph was taken, and skin texture with the camera that took it." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-140" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Accuracy, precision, recall and F1 for each of the five pairings, with training and validation curves. The metric set supports one genuinely useful observation - that a pairing with higher precision but lower recall is 'less useful for finding all ASD cases', which is the correct screening-oriented reading and is articulated in almost no other study in this branch. What is missing is specificity, AUC, confusion matrices and confidence intervals, and no chance baseline is stated despite the exactly balanced construction placing it at 50%. The comparison table cites two prior studies at 0.7500 and 0.8050 rather than the high-nineties figures reported by other Kaggle-corpus work, so the study positions itself against modest comparators." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-140" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No limitations section exists, and the conclusion repeats the results paragraph almost verbatim without critical reflection. What should have been stated: the proportion of Kaggle against Semarang images and their distribution across classes is unreported, which is the single fact determining whether mixing sources mitigates the branch's provenance confound or creates a sharper one aligned with ancestry, camera and setting; no diagnostic ascertainment is described even for the clinic-sourced portion, forgoing the study's clearest opportunity to improve on its predecessors; the split is at image level with the number of distinct children unreported; augmentation ordering relative to splitting is unstated and rotation, flip and contrast variants of one photograph are near-duplicates; no demographic data exist in a study classifying faces; no specificity, AUC or confusion matrix is given, so the error profile behind a recall of 0.8182 is uninspectable; and there is no ethics or consent statement despite part of the corpus coming from a clinical service." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-140" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Adequate on the pipeline and deficient on the corpus. Reported: total image count and exact class balance, both sources by name, the 80:20 split ratio, the preprocessing and augmentation operations (resizing, normalisation, rotation, flipping, contrast adjustment), all five ensemble pairings with their constituent architectures, both combination rules, the softmax-plus-threshold decision structure, four metrics for each pairing, learning curves for each, and a comparison table against prior work. Not reported: the proportion of images from each source and their distribution across classes, the number of distinct children, whether augmentation preceded splitting, hyperparameters, per-class error breakdowns, ethics arrangements, funding and code." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-140" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None described for either source. For the Kaggle portion the labels are folder membership in a collection whose autistic class was harvested from autism-associated online content - the position documented across nine other studies in this review. For the Semarang autism-centre portion, children attending a clinical service would ordinarily carry clinical diagnoses, and this is the one point at which the study could have improved on its predecessors; but no instrument, criteria, clinician, assessment date or procedure is reported, and the paper's provenance sentence explicitly leaves the sources open, saying the data 'could come from a variety of places, such as clinics, past research, or relevant public statistics'. The opportunity to anchor part of the corpus in real diagnoses is therefore present and unrealised." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-140" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Resized and normalised face images augmented by rotation, flipping and contrast adjustment. Contrast adjustment is worth noting because it partially normalises a property that would differ systematically between image sources; whether it is sufficient to remove a source signal is untested, and no source-wise analysis is performed." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-140" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Five ensemble pairings of pretrained convolutional networks, combined at the decision level by averaging or voting. The selection criterion is explicitly computational: lightweight architectures using depthwise separable convolutions and compound scaling, chosen for fast inference on constrained hardware. That is an appropriate design goal for a low-resource deployment context and is argued rather than assumed. Comparing five pairings with learning curves for each is more architectural breadth than most single-model papers in this branch offer, and the authors' reading of those curves for stability - identifying which pairings learn smoothly and which fluctuate - is a legitimate diagnostic use rather than a decorative one." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-140" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two thousand nine hundred and thirty-six facial images, balanced at 1,468 labelled autistic and 1,468 labelled normal, drawn from two sources - Kaggle and 'data from an autism center in Semarang'. The mixed provenance is what distinguishes this study from the other nine Kaggle-corpus papers charted in this review, and it cuts both ways. Supplementing a web-scraped collection with images from an actual clinical service is in principle an improvement, since clinic-attending children have real diagnoses; but the paper never states how many images came from each source, nor whether the clinic contributed to the autistic class only or to both. If the autistic images are predominantly Indonesian clinic photographs while the comparison images are predominantly international web-scraped ones, the two classes would be separable by ancestry, camera and setting without any facial phenotype being involved - a sharper confound than the pure-Kaggle studies face. The paper's own account of provenance is loose enough to leave this open: the data 'could come from a variety of places, such as clinics, past research, or relevant public statistics'. No age, sex, ancestry, cognitive, language or clinical information is reported for either class, and the number of distinct children behind 2,936 images is never stated." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-140" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "An 80:20 image-level split with no cross-validation, no separately described validation partition, and no participant-level partitioning; the number of distinct children behind 2,936 images is never stated. Augmentation by rotation, flipping and contrast adjustment is applied without specifying whether it preceded the split, and such variants of a single photograph are near-duplicates rather than independent observations. These are the standard weaknesses of this branch. What is distinctive here is a confound the mixed corpus introduces and the paper leaves entirely unexamined. The images come from two sources - Kaggle and an autism centre in Semarang - and neither the proportion from each nor their distribution across the two classes is reported. If the clinic supplied predominantly autistic images while the comparison class came predominantly from the international web collection, the classes would be separable by ancestry, camera, lighting and photographic convention without any facial phenotype being involved, and the reported 0.8299 would measure source rather than diagnosis. The paper's own account of what the network extracts - face shape, expression and skin texture - is consistent with that reading. The remedy is available and unused: with two identifiable sources in hand, a source-held-out evaluation, or simply a source-by-class table, would settle the question directly. Two elements of the analysis nonetheless stand above the branch norm: the learning curves are interpreted for stability and overfitting rather than displayed without comment, and the precision-recall trade-off across pairings is read in screening terms, with a high-precision low-recall model correctly judged 'less useful for finding all ASD cases'." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-140" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Entirely absent, and unusually consequential here. No age, sex, ancestry, socioeconomic, cognitive or comorbidity information is reported for either class. The mixed-source corpus makes ancestry a specific rather than generic concern: a Kaggle collection assembled from international web sources and a set of photographs from an autism centre in Semarang would be expected to differ systematically in ancestry, in camera and lighting, and in photographic convention, and the paper's own description of the extracted features - 'the shape of the face, the expression on it, and the texture of the skin' - names skin texture explicitly as something the network uses. Without a source-wise breakdown of the classes, none of this can be examined, and a source-held-out evaluation, which the mixed corpus would have made straightforward, is not performed." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-140" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None separately stated. The step this study most needs is a source-held-out evaluation - training on Kaggle images and testing on Semarang images, or the reverse - which its own mixed corpus makes available and which would establish directly whether the models detect a facial phenotype or the character of an image source. Reporting the source-by-class breakdown would be the prerequisite." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-140" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. No attribution, saliency or feature analysis is reported. The omission is pointed here because the paper itself names skin texture among the features the network uses, and because the mixed-source corpus makes it directly testable whether the models respond to image source - a saliency or source-classification analysis would have addressed the study's central ambiguity and neither is attempted." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-140" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional secondary and clinic-sourced analysis with no longitudinal element. No ethics or consent statement appears anywhere in the paper. This is a more serious omission than for the purely Kaggle-based studies charted elsewhere in this review: part of the corpus consists of facial photographs of children attending an autism centre in Semarang, so identifiable images of clinically attending children were obtained and used with no reported institutional approval and no consent process. Funding and competing interests are not stated." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-140" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two settings, imperfectly distinguished. Part of the corpus is the Kaggle collection, which has no setting - the images were harvested from internet sources by a third party. Part comes from an autism centre in Semarang, which is a clinical service setting and the same kind of environment in which the proposed edge-deployed tool would run. The mixture is potentially valuable and is undermined by the absence of any breakdown: without knowing how many images came from each source and how they distribute across the two classes, a reader cannot tell whether the clinic data broadens the corpus or introduces a setting confound aligned with the label. A source-held-out analysis would have answered this directly and is not attempted." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-140" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Keywords: autism spectrum disorder, early detection, ensemble convolutional neural network, facial images, classification, accuracy. Method- and task-facing, with the modality named. The leading keyword field contains the placeholder word 'Component', which suggests a template was not fully edited." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-140" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:study_design "Retrospective algorithm-development study comparing five lightweight CNN ensemble pairings on a mixed public and clinic-sourced facial image corpus" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: ; comparison: 1,468 labelled normal" ] ] ;
