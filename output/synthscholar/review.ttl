    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the comparison group screened for autism specifically?" ;
                            slr:justification "Screened on three general developmental instruments, but the authors note 'we did not assess the CARS in TD Children'." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are comparison groups matched on age and sex?" ;
                            slr:justification "Both cohorts matched on both variables with tests reported, and both additionally entered as ANCOVA covariates." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are participants and recruitment adequately described?" ;
                            slr:justification "Recruitment sources, screening instruments, demographics per cohort with tests, and CARS for the autistic groups." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is developmental or cognitive level measured?" ;
                            slr:justification "None in either group; the authors defend the use of chronological age and concede a developmental test should be added." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is spectrum bias acknowledged?" ;
                            slr:justification "Named explicitly, its cause identified, and its direction stated as overestimation of discriminative ability in practice." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "some concerns" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the eye-tracking acquisition described reproducibly?" ;
                            slr:justification "Tracker, sampling rate, spatial resolution, monitor, viewing distance, room conditions, calibration target and fixation thresholds all specified." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the reference standard appropriate and independently applied?" ;
                            slr:justification "DSM-5 plus CARS with no observational instrument, acknowledged as due to limited access to ADOS/ADI-R." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are quality-control exclusions quantified?" ;
                            slr:justification "Calibration failure and off-screen fixation both trigger exclusion; no counts are given for either group." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are the stimuli described and justified?" ;
                            slr:justification "All five paradigms with durations, content, area definitions and a rationale citing specific prior work for each." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is lateral position bias controlled?" ;
                            slr:justification "Biological motion and face-versus-dot paradigms presented in both left-right arrangements and averaged." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the fixation measure normalised against tracking success?" ;
                            slr:justification "Percentages are computed against total stimulus duration rather than valid tracked time, so reduced looking anywhere lowers every area simultaneously." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "some concerns" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are single-feature results tested against chance?" ;
                            slr:justification "Per-area accuracies plotted against permutation-derived 95% confidence intervals." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are effect sizes reported?" ;
                            slr:justification "Cohen's d for every group contrast in each cohort, which makes the developmental pattern legible." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the unit of analysis the participant?" ;
                            slr:justification "Ten scalar percentages per child, with leave-one-out cross-validation described in full." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are covariates and assumption violations handled?" ;
                            slr:justification "Age and gender covaried throughout, Levene's test with weighted least squares substitution, Tukey correction, multivariate-t adjustment for interaction contrasts." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are the age cohorts modelled separately?" ;
                            slr:justification "Separate classifiers per cohort, which is what permits the age-specific feature ranking." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is there independent validation?" ;
                            slr:justification "Acknowledged; no external cohort." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the classifier specified?" ;
                            slr:justification "No kernel, hyperparameters or implementation reported." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "low" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are negative findings reported?" ;
                            slr:justification "No fixation-CARS association, and toddler comparison children failing to prefer upright biological motion contrary to prior work." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the dataset accessible or its access conditions stated?" ;
                            slr:justification "Raw data offered by the authors without undue reservation; no repository." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are ethics and consent reported?" ;
                            slr:justification "Hospital ethics committee approval, written guardian consent, and separate consent for publication of potentially identifiable data." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the non-social reduction interpreted?" ;
                            slr:justification "Fixation is reduced on the moving dot, electric fan and inverted figure as well as social areas, with no discussion of what this implies for a social-attention account." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the prevalence implication quantified?" ;
                            slr:justification "Predictive values deliberately omitted with the reasoning given and the calculation performed - 4.2% PPV at 1% prevalence." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is prior data overlap disclosed?" ;
                            slr:justification "Partial reuse of preschool video-clip data from an earlier publication by the same group is stated." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "low" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Participant-level leave-one-out cross-validation, described in enough detail to confirm that each held-out child's classifier was 'determined using only the data from the other subjects, omitting the one predicted'. Cohorts were modelled separately, so no information crosses between them. Single-area classifications were tested against non-parametric permutation, which is what establishes that several areas do not exceed chance rather than leaving weak accuracies to be read as weak positives. The statistical analyses are protected by covariate adjustment, variance-assumption testing with an appropriate substitution, Tukey correction and multivariate-t adjustment for the interaction contrasts. Three gaps remain. There is no independent validation cohort, acknowledged. The two quality-control exclusions - calibration failure and off-screen fixation - are described but their counts are not reported, and both plausibly operate differentially by group, so the analysed sample is a compliant subset of unknown size and composition. And the reference standard is DSM-5 plus CARS without observational confirmation, which bounds what any validation can establish. The most valuable validation-adjacent contribution, though, is not internal: by calculating that 80% sensitivity and 82% specificity yields a 4.2% positive predictive value at 1% prevalence, the paper supplies the translation step that converts a cross-validated accuracy into a statement about deployment, and it is the only study in the corpus to do so numerically." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-085" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Goal: determine whether eye-tracking differences between autistic and typically developing children are the same in toddlers and preschoolers, and identify which paradigms discriminate at which age. Main findings: reduced fixation time percentage in nine of ten areas of interest with a main effect of diagnosis, but a main effect of age group on only one area; significant diagnosis-by-age interaction on the eye area, where toddlers did not differ (p = 0.93) but preschoolers did (p = 0.006); single-area classification rankings that largely invert between cohorts, with mouth, upright walking, moving dot and baby face discriminating toddlers and eyes, duck, infant face and fan discriminating preschoolers; full-model accuracy of 80% in toddlers and 71% in preschoolers; only preschool comparison children showing the expected preference for upright biological motion; and no association between any fixation measure and CARS severity." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-085" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Five short paradigms totalling roughly 40 seconds, each pairing a social element against a non-social competitor within a single display, and each with a stated theoretical rationale drawn from a specific prior literature. The design's strongest feature is its use of position-switched replicates: both the biological motion and the face-versus-dot paradigms were presented twice with left and right positions swapped and the fixation percentages averaged, which controls for any lateral gaze bias - a source of artefact that most paired-display studies in this corpus do not address. The paradigms also span a graded range of social content, from a full face with moving mouth, through point-light biological motion, to a still infant face, against competitors ranging from an abstract moving dot to an electric fan to clipart animals - which is what makes the age-specific ranking analysis informative, since it identifies which level of social content carries signal at which age. The brevity is a practical virtue for 18-month-olds and a limitation for reliability: a 5-second still-image trial yields one fixation percentage per child with no within-child replication from which stability could be estimated." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-085" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional with two age cohorts sampled independently rather than followed longitudinally - so the developmental claim rests on a cross-sectional age contrast, which the design cannot distinguish from cohort effects, though this is a standard and reasonable compromise. Ethics reporting is complete: approval by the Ethics Committee of Shenzhen Maternity and Child Healthcare Hospital, written informed consent from legal guardians, and separate written consent obtained specifically for publication of potentially identifiable images or data. Partial overlap with a prior publication by the same group is disclosed rather than concealed: 'A portion of preschool data using paradigm (video clip) data had been used in a previous study... However, this study used more comprehensive paradigms and the findings presented in this study have never been published before.' Raw data are offered on request." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-085" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "CARS scores were obtained for the autistic groups only and only for children aged 2 and over, at 32.3 +/- 1.5 in toddlers and 33.0 +/- 2.1 in preschoolers - both close to the cut-off of 30, so the samples sit at the milder end of the CARS range with narrow standard deviations, which limits the severity gradient available for correlation. The severity data are nonetheless used analytically, in a multiple regression of fixation time percentage on CARS with age and gender as covariates across all autistic children, returning no significant association on any area of interest (p values from 0.13 to 0.99). That null is reported without qualification and is important: it means the gaze measures separate the groups on average without tracking how autistic an individual child is, which converges with the same finding in the Keles adult study and bears on whether such measures could serve as severity or outcome measures rather than only as classifiers. No cognitive, language or adaptive measure was collected for either group, and no comorbidity or medication information." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-085" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "'children with ASD', 'individuals with ASD', 'ASD children' and 'toddler ASD' used interchangeably, against 'TD children' and 'typically developing individuals'. The acronym is frequently used adjectivally and occasionally as a bare group label ('toddler ASD, and TD is similar'). The framing is conventional and deficit-oriented - autism 'involves deficits in face processing', gaze is 'aberrant', and the literature on 'gaze abnormalities' is reviewed at length - but the paper is careful about the state of the evidence in a way that softens this: it notes that 'the precise nature of these deficits and the relationships between anomalous face processing and atypical socio-emotional function in ASD remain unclear', and cites a review finding that 'the excessive mouth and diminished eye gaze hypothesis of ASD is not generally supported'. That willingness to report that a widely repeated claim lacks support is uncommon in this corpus." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-085" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A hospital-based child mental health and rehabilitation centre in Shenzhen, with testing conducted in 'a dark and soundproof room' at a fixed 65 cm viewing distance with the child's centre of vision aligned to the monitor centre. This is a tightly controlled laboratory environment rather than a point-of-care setting, which suits the measurement but limits the deployment claim - a dark soundproof room with a calibrated remote tracker is not a paediatric waiting area. The recruitment asymmetry is present but mitigated: autistic children came from the hospital's rehabilitation centre while comparison children came either from a local kindergarten or from routine check-ups at the same hospital's outpatient ward, so a proportion of the comparison group was recruited within the same institution." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-085" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Comprehensive and appropriately chosen. Means and standard deviations for all ten areas across all four groups; F statistics with degrees of freedom and p values for diagnosis, age group and interaction effects on every area; Cohen's d for every group contrast within each cohort; accuracy, sensitivity and specificity for the full model in each cohort; and per-area classification performance plotted against permutation-derived 95% confidence intervals so that non-significant areas are visually identifiable. Reporting effect sizes alongside p values is what makes the developmental comparison legible - the mouth separates toddlers at d = 0.81 and preschoolers at d = 0.44, the eyes separate preschoolers at d = 0.74 and toddlers at d = 0.12 - and these are more informative than the significance pattern alone. Reporting sensitivity and specificity separately exposes the preschool model's weakness, where 81% sensitivity comes with 61% specificity, meaning nearly two in five typically developing preschoolers would be flagged. The deliberate omission of predictive values, with the reasoning and the calculated 4.2% PPV given in the limitations, is a more useful treatment than reporting them uncritically would have been." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-085" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two cohorts, each with two groups. Toddler cohort: 55 autistic children (aged 1.5-3, including eight aged 1.6-1.8) and 40 typically developing. Preschool cohort: 37 autistic children (aged 3-5) and 41 typically developing. Autistic participants came from the Child Mental Health and Rehabilitation Center of a maternity and child healthcare hospital; comparison children from a local kindergarten or from routine annual check-ups in the same hospital's outpatient ward. No developmental-delay or other-diagnosis comparison group, and the authors identify the consequence explicitly as spectrum bias. The two-cohort structure is the study's design contribution: rather than treating age as a covariate to be adjusted away, the cohorts are analysed both jointly through a diagnosis-by-age-group interaction and separately through cohort-specific classifiers, which is what permits the finding that different areas of interest discriminate at different ages. A discrepancy sits unreconciled between the 37 + 41 = 78 preschoolers reported in the results and the 'N = 74 for preschool' stated in the leave-one-out description, and exclusion counts from the two quality-control steps - calibration failure and off-screen fixation - are not reported for either cohort." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-085" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Frontiers in Psychiatry 13:899521 (2022), in the Child and Adolescent Psychiatry section - a clinical psychiatry venue. Authorship spans the Athinoula A. Martinos Center for Biomedical Imaging and the Departments of Psychiatry and Medicine at Massachusetts General Hospital and Harvard Medical School with the Department of Child Psychiatry and Rehabilitation at Shenzhen Maternity and Child Healthcare Hospital, with two co-first authors and two corresponding authors spanning the two sites. The inclusion of a biostatistician from MGH's Department of Medicine is visible in the analysis, which is more statistically careful than any comparable study in the corpus. Funded by Chinese national and provincial sources. The international collaboration also explains the diagnostic constraint being stated so directly: a US-based team publishing on a Chinese cohort has every reason to flag the absence of ADOS and to name its cause." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-085" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Ten scalar percentages per child, so the unit is unambiguously the participant and leave-one-out cross-validation is genuinely participant-level. Two representational choices deserve note. Averaging the position-switched replicates before analysis removes lateral bias but also discards the only within-child replication in the design, so no reliability estimate is available. And normalising by stimulus duration rather than by on-screen looking time is the choice that produces the study's interpretive ambiguity: because the denominator is total presentation time rather than valid tracked time, a child who looks away, blinks, or loses tracking accrues a lower percentage on every area simultaneously. That is consistent with the observed pattern of reduction across nine of ten areas including non-social ones, and it is precisely the normalisation that Keles and colleagues explicitly avoid by dividing by frames with successful on-screen gaze specifically 'to control for possible individual differences between participants in their total on-screen gaze time'. The contrast between the two studies on this single methodological point is instructive." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-085" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Keywords: autism, eye tracking, percentage of fixation time, machine learning, toddler, preschool, support vector machine. Two of the seven name age bands, which accurately signals that the developmental comparison rather than the classification is the paper's subject." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-085" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "An SMI RED250 remote tracker at 250 Hz with 0.03 degree spatial resolution, viewing a 22-inch LCD at 1024x768 from 65 cm in a dark, soundproof room, with the child's centre of vision aligned to the screen centre. Calibration used five points with a dynamic pink rabbit as the target, and - importantly - 'those who failed to follow the dynamic pink rabbit fixation did not continue in the experiment', so calibration failure was an exclusion rather than a tolerated source of noise. A second quality step used Gaze Replay path playback before analysis 'to exclude the subjects whose fixation point deviates from the screen to reduce systematic errors'. Both steps are good practice for a toddler paradigm and both are likely to remove children differentially by group, since compliance with a calibration target and sustained on-screen looking are themselves plausibly reduced in autism - yet no exclusion counts are given for either step in either group, which is the most consequential reporting omission in the paper. Fixation detection thresholds are stated (duration above 100 ms, displacement below one degree) and analysis used BeGaze and R-studio 3.5.2." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-085" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A support vector machine on ten interpretable percentages, fitted separately for each age cohort. Modelling is subordinate to the statistical analysis throughout: the paper's primary evidence is a set of ANCOVAs with covariates, variance-assumption testing, post-hoc correction and effect sizes, and classification is used to answer the supplementary question of whether the measures combine usefully and which paradigms contribute at which age. That ordering suits a study whose contribution is a developmental finding rather than a screening product. Fitting the cohorts separately rather than pooling with an age covariate is the decision that makes the age-specific feature rankings possible and is the right one given that the entire hypothesis concerns differential patterns. The classifier itself is under-specified - no kernel, no hyperparameters, no implementation named - which matters less here than it would in a study whose headline was the accuracy, but which prevents replication of the classification component." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-085" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Interpretability is inherent in the design rather than added afterwards, since each feature is a named percentage on a named region and every group difference is reported with its direction and effect size. The per-area classification analysis then functions as a formal importance ranking, tested against permutation rather than asserted, and the finding that the rankings differ substantially between cohorts is the study's central claim. The eye-area result is the clearest example and is properly interpreted: comparison children's eye-looking rises from 17.6% at toddler age to 29.2% at preschool age while autistic children's stays flat at 15.4% and 15.1%, so the group difference emerges developmentally rather than being present from the outset. The authors offer a mechanistic account - that toddlers with typical development use visual mouth information for language acquisition, reducing eye attention, and that as language becomes more auditorily meaningful preschool attention shifts to the eyes - which is testable and which explains both the mouth and eye interactions coherently. Against this, the paper offers no interpretation at all of the finding that fixation is reduced on non-social areas, which is the observation most in tension with the social-attention framing it works within." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-085" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Visual attention allocation, operationalised as the proportion of stimulus time spent fixating each of ten predefined regions. The construct is deliberately layered across paradigms, moving from face parts (eyes versus mouth), through configural biological motion (upright versus inverted point-light figures), to social-versus-geometric competition (mouthing face versus moving dot), to non-social object tracking (duck, helicopter), to static social-versus-object preference (infant face versus fan). That gradation is what makes the age-comparison informative, since it can localise which level of social content is discriminative at which age. The finding that reduction appears at nearly every level, including for an abstract moving dot and an electric fan, is the study's most consequential result for construct validity and is left uninterpreted: a child who fixates less on the fan as well as less on the baby face is not showing selective social disinterest, and the measure may be indexing how much of the stimulus period was spent fixating anything at all." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-085" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2022. The framing is the standard early-detection argument, but the paper's positioning is developmental rather than translational. Its motivating observation is that 'few studies have investigated the eye tracking differences across different chronological age groups' despite evidence that brain alterations in autism differ across ages, and its specific clinical rationale for the 3-year boundary is that 'a proportion of the children identified with possible autism before age 3 do not meet criteria for autism at later follow-up' while 'many children are not diagnosed with ASD until age 3 or older despite displaying symptoms much earlier'. The literature review is unusually careful about what is and is not established, reporting Frazier's meta-analysis of 122 studies as finding a reliable pattern of gaze abnormality that 'persists across ages and worsens during perception of human interactions' while also noting that 'adding perceptual complexity to stimuli or increasing cognitive load during attention-heavy tasks does not increase gaze abnormalities in autism', and citing a review concluding that 'the excessive mouth and diminished eye gaze hypothesis of ASD is not generally supported'. The comparative claims are likewise measured: rather than asserting superiority, the authors situate their 80% and 71% against a meta-analysis of MRI-based classification reporting sensitivity 0.83 and specificity 0.84 for structural and 0.69 and 0.66 for functional imaging, concluding only that 'our findings based on the eye tracking are comparable with results obtained from sophisticated brain imaging tools' - a comparison whose point is cost and accessibility rather than accuracy." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-085" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Reported per cohort with tests, and both cohorts are matched on both variables. Toddlers: autistic 2.4 +/- 0.5 years and 50 boys to 5 girls, comparison 2.2 +/- 0.6 years and 33 boys to 7 girls, with p = 0.27 for age and p = 0.22 for gender. Preschoolers: autistic 4.6 +/- 0.5 years and 33 boys to 4 girls, comparison 4.8 +/- 0.3 years and 33 boys to 8 girls, with p = 0.11 and p = 0.29. Age and gender were then additionally entered as covariates in every ANCOVA despite already being matched, which is belt-and-braces and appropriate. What is absent is any measure of developmental or cognitive level in either group - no Mullen, Bayley, Griffiths or equivalent - and the authors address this directly rather than omitting it, arguing that 'predominant ASD studies used chronological age instead of developmental age' and that 'in practice, a child transition from Toddler to preschooler is typically based on the chronological age without developmental testing', while conceding that 'future studies may also need to consider adding a developmental test'. The argument is reasonable for defining the cohorts but does not address the confound: two groups matched on chronological age but differing in developmental level would differ in where they look for reasons unrelated to diagnosis, and nothing in the data can separate these." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-085" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Five directions, tightly tied to the stated limitations. Validate on independent datasets. Recruit 'a broad spectrum of the ASD and non-ASD participants' to address spectrum bias - the direct remedy for the acknowledged overestimation. Add developmental assessment alongside chronological age. Resolve the biological motion inconsistency, where their toddler comparison group failed to show a preference that prior work reports, with the authors noting that 'the age range for our study is between 1.5 and 3, while the previous study focused only on 2-year-olds, so we cannot exclude the possibility that the discrepancy is due to age range difference'. And exploit the age-specific paradigm rankings: 'elucidating the role of different paradigms in ASD classification across different stages may shed light on developing paradigms for earlier ASD detection, particularly for toddlers between 1.5 and 3 years old or even younger' - which is the concrete translational implication of the study's central finding." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-085" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Five limitations are stated and each is substantive, but two passages go considerably beyond the corpus norm. The prevalence discussion is the most valuable: rather than reporting predictive values, the authors explain why they will not, and then calculate the answer - 'using the above toddler values of 80% sensitivity and 82% specificity, and assuming 1% prevalence in the population, the PPV is approximately 4.2%. On the other hand, using these same values, NPV is greater than 99%.' They note that readers can perform the calculation themselves and that omitting predictive values 'is consistent with previous ASD studies on this topic', citing three. The spectrum bias passage is equally direct, naming the phenomenon, identifying its cause in the exclusion of psychiatric and neurological histories from the comparison group, and stating its direction: discriminative ability 'may be overestimated in medical practice'. The other three limitations are the absence of ADOS/ADI-R confirmation with its stated cause, the absence of CARS in comparison children, the small sample without independent validation, and the absence of developmental assessment with a reasoned defence of using chronological age. What is not addressed: that fixation reduction appears across non-social as well as social areas and may therefore index general attention rather than social attention; that the off-area residual is never reported by group; that the two quality-control exclusions may operate differentially by group and their counts are unreported; and the 78-versus-74 discrepancy." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-085" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "DSM-5 diagnosis by experienced physicians with a CARS score above 30 required for children aged 2 and over, described as 'in line with the ADOS standard'. The absence of an observational instrument is stated as the study's first limitation together with its cause - limited access to ADOS and ADI-R in China - which is a candid acknowledgement of a resource constraint rather than a methodological choice. The comparison group is screened more thoroughly than in most studies here: three instruments (the Ages and Stages Questionnaires Chinese Version, the Chinese children warning signs checklist, and the Developmental Screening Parent Questionnaire for Children Aged 0-6) covering communication and language, physical ability, social skills, problem solving and intelligence, administered by a study physician through onsite assessment and parent interview, with exclusion of any psychiatric or neurological history. The authors nonetheless flag the asymmetry: 'we did not assess the CARS in TD Children', so comparison participants were screened on general development but never on autism-specific symptomatology with the same instrument used to establish the cases." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-085" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Single modality with no cross-modal fusion, but two forms of within-modality combination are examined and both are informative. The first is combining the ten areas into a single classifier versus using each alone: the full ten-area model reached 80% and 71% while individual areas ranged from significant to indistinguishable from chance under permutation testing, and critically the set of areas exceeding chance differs between cohorts. The second is the within-paradigm pairing, where each social area sits opposite a size-matched non-social competitor in the same display, so the design supports comparing relative preference rather than absolute looking. The biological motion paradigm is analysed this way explicitly, with paired t-tests comparing upright against inverted within each of the four groups - and the result is a clean negative for three of them, with only preschool comparison children showing the expected preference. That the paper runs and reports this within-subject preference analysis, rather than only the between-group percentage comparison, is what allows it to engage substantively with the prior biological motion literature and to identify where it does not replicate." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-085" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Strong on statistics and stimuli, weak on flow and on the classifier. Fully reported: recruitment sources and screening instruments for both groups; the diagnostic basis with its acknowledged limitation; demographics per cohort with tests; every paradigm with duration, content, area-of-interest definition and rationale; the position-switching and averaging procedure; tracker model, sampling rate, spatial resolution, monitor, resolution, viewing distance, room conditions and calibration procedure with its exclusion rule; fixation detection thresholds; the complete statistical model including covariates, variance assumption testing, the weighted least squares substitution, post-hoc correction method and the multivariate-t adjustment for interaction contrasts; means and standard deviations for all ten areas in all four groups; F statistics and p values for all three ANCOVA effects on all ten areas; Cohen's d for every contrast; and the leave-one-out procedure. Not reported: exclusion counts at either quality-control step; the SVM kernel, hyperparameters or implementation; the reconciliation between 78 and 74 preschoolers; and any code. Raw data are offered on request." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-085" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "One session per child comprising five short paradigms totalling approximately 40 seconds of stimulus" ;
                    slr:study_design "Cross-sectional case-control study with two independent age cohorts analysed both jointly, via diagnosis-by-age-group ANCOVA, and separately, via cohort-specific classification" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Toddlers aged 1.5-3 years and preschoolers aged 3-5 years with autism" ;
                    slr:sample_size_text "ASD/index: 55 toddlers and 37 preschoolers; comparison: 40 toddlers and 41 preschoolers" ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "Across five short paradigms, autistic children showed reduced fixation time percentage in nine of ten areas of interest, but the pattern of which areas discriminate changes with age. The clearest developmental finding is on the eyes: toddlers with and without autism did not differ (15.4% against 17.6%, p = 0.93), whereas preschoolers did (15.1% against 29.2%, p = 0.006), because typical eye-lookin",
                        "Toddler cohort: 80% accuracy, 80% sensitivity, 82% specificity. Preschool cohort: 71% accuracy, 81% sensitivity, 61% specificity - so performance was better in the younger cohort, and the preschool model's specificity is weak. ANCOVA showed a significant main effect of diagnosis on nine of ten areas (p < 0.001 for six of them), a main effect of age group on only one area (the dynamic moving dot, p" ;
                    slr:outcome "Accuracy, sensitivity and specificity for the full ten-area model in each cohort; per-area accuracy, sensitivity and specificity against permutation thresholds; Cohen's d for every group contrast; F statistics and p values for all ANCOVA effects" ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "Toddler cohort: 80% accuracy, 80% sensitivity, 82% specificity. Preschool cohort: 71% accuracy, 81% sensitivity, 61% specificity - so performance was better in the younger cohort, and the preschool model's specificity is weak. ANCOVA showed a significant main effect of diagnosis on nine of ten areas (p < 0.001 for six of them), a main effect of age group on only one area (the dynamic moving dot, p; Across five short paradigms, autistic children showed reduced fixation time percentage in nine of ten areas of interest, but the pattern of which areas discriminate changes with age. The clearest developmental finding is on the eyes: toddlers with and without autism did not differ (15.4% against 17.6%, p = 0.93), whereas preschoolers did (15.1% against 29.2%, p = 0.006), because typical eye-lookin" ] ] ;
