    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Age and sex are included as predictors while the test population differs systematically on both; outlier values were replaced by the mean with no criterion or timing stated; and the ensemble's reported AUC of 0.90 is inconsistent with constituent AUCs of 0.57-0.68." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "Participant counts and group compositions are reported for both experiments and Table 2's transposed AQ means are the only overt inconsistency, but no calibration success, gaze-point counts, data-quality or exclusion figures are given." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "No diagnostic assessment in the preliminary experiment - the label is a questionnaire median split - and no instrument, criteria or diagnostician reported for the test participants' existing diagnoses, with no AQ administered to them." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "The preliminary positive class is a median split of AQ scores in a non-clinical adult sample well below the clinical cut-off; the test sample differs from the training population by roughly twelve years of mean age and is entirely male, on variables that are themselves model features." ] ;
            slr:overall_judgment "high" ;
            slr:tool_used "QUADAS-2" ] .

<https://doi.org/10.1145/3379155.3391334> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Eye tracking has become a powerful tool in the study of autism spectrum disorder (ASD). Current, large-scale efforts aim to identify specific eye-tracking stimuli to be used as biomarkers for ASD, with the intention of informing the diagnostic process, monitoring therapeutic response, predicting outcomes, or identifying subgroups with the spectrum. However, there are hundreds of candidate experimental paradigms, each of which contains dozens or even hundreds of individual stimuli. Each stimuli is associated with an array of potential derived outcome variables, thus the number of variables to consider can be enormous. Standard variable selection techniques are not applicable to this problem, because selection must be done at the level of stimuli and not individual variables. In other words, this is a grouped variable selection problem. In this work, we apply lasso, group lasso, and a new technique, Sparsely Grouped Input Variables for Neural Network (SGIN), to select experimental stimuli for group discrimination and regression with clinical variables. Using a dataset obtained from children with and without ASD who were administered a battery containing 109 different stimuli presentations involving 9647 features, we are able to retain strong group separation even with only 11 out of the 109 stimuli. This work sets the stage for concerted techniques designed around engines to iteratively refine and define next-generation biomarkers using eye tracking for psychiatric conditions. http://github.com/beibinli/SGIN Permission to make digital or hard copies of all or part of this work for personal or classroom use is granted without fee provided that copies are not made or distributed for profit or commercial advantage and that copies bear this notice and the full citation on the first page. Copyrights for components of this work owned by others than the author(s) must be honored. Abstracting with credit is permitted. To copy otherwise, or republish, to post on servers or to redistribute to lists, requires prior specific permission and/or a fee. Request permissions from permissions@acm.org. ETRA ’20 Full Papers, June 2–5, 2020, Stuttgart, Germany © 2020 Copyright held by the owner/author(s). Publication rights licensed to ACM. ACM ISBN 978-1-4503-7133-9/20/06...$15.00 https://doi.org/10.1145/3379155.3391334" ;
    dcterms:bibliographicCitation "Li B; Barney E; Hudac C; Nuechterlein N; Ventola P; Shapiro L; Shic F (2020). Selection of Eye-Tracking Stimuli for Prediction by Sparsely Grouped Input Variables for Neural Networks: towards Biomarker Refinement for Autism. *ETRA '20 Full Papers: ACM Symposium on Eye Tracking Research and Applications*. https://doi.org/10.1145/3379155.3391334" ;
    dcterms:creator "Barney E",
        "Hudac C",
        "Li B",
        "Nuechterlein N",
        "Shapiro L",
        "Shic F",
        "Ventola P" ;
    dcterms:title "Selection of Eye-Tracking Stimuli for Prediction by Sparsely Grouped Input Variables for Neural Networks: towards Biomarker Refinement for Autism" ;
    bibo:doi "10.1145/3379155.3391334" ;
    bibo:pmid "local_cd9e45eb" ;
    fabio:hasPublicationYear 2020 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are participants and recruitment adequately described?" ;
                            slr:justification "Cohort-level age, sex and diagnostic composition given; group-wise demographics and IQ asserted as balanced but not tabulated." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the sample appropriate and adequate for the stated target?" ;
                            slr:justification "64 children against 9,647 features and 109 groups; only 30 have full ADOS, SRS and Vineland, which the authors name as limiting power for severity prediction." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the comparison group clinically realistic?" ;
                            slr:justification "Non-autistic group deliberately includes language delay and other developmental concerns rather than typical development only." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are comparison groups matched on the variables that matter?" ;
                            slr:justification "Age and sex stated non-significant; IQ measured for all but group-wise values not reported." ;
                            slr:rating "Partly" ] ;
                    slr:overall_concern "some concerns" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are predictors defined without knowledge of outcome?" ;
                            slr:justification "Features are computed by automated fixation identification over expert-annotated ROIs, with selection performed by the models themselves." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the behavioral data acquisition described reproducibly?" ;
                            slr:justification "Tracker, sampling rate, monitor, viewing distance, calibration scheme, measured calibration error, all six paradigms with construct rationale, stimulus durations and per-stimulus feature counts." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is data quality assessed and reported?" ;
                            slr:justification "Calibration accuracy, calibration stability and collection rate as quality controls, with 95% trimmed mean calibration error of 0.751 degrees." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the reference standard appropriate and independently applied?" ;
                            slr:justification "ADOS, SRS-2, Vineland-3 and Stanford-Binet administered by clinicians and trained psychometrists." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "low" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are all methods evaluated on identical splits?" ;
                            slr:justification "The same training/validation partitions are used across all models explicitly for fair comparison." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the performance-parsimony trade-off reported rather than a point estimate?" ;
                            slr:justification "Accuracy, AUC, precision, sensitivity, specificity and regression r all plotted against number of sparsified groups." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is selection stability assessed?" ;
                            slr:justification "100 bootstrap runs per method with per-paradigm discard probabilities, exposing group lasso's near-bimodal behaviour." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is normalisation fitted within training folds?" ;
                            slr:justification "Features normalised on the training set before each cross-validation fold." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are negative results reported?" ;
                            slr:justification "Failure to predict ADOS, SRS and Vineland above chance is reported prominently and discussed." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is model and operating-point selection separated from performance estimation?" ;
                            slr:justification "Sparsity level, hyperparameters and the identification of SGIN as best all determined against the same 10-fold estimate." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "some concerns" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is a confound in the feature set acknowledged?" ;
                            slr:justification "Data-quality variables ranking among the top features are explained as reflecting non-compliance and attention difficulties rather than being hidden." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the dataset accessible or its access conditions stated?" ;
                            slr:justification "Data and processing pipeline available upon request; not openly deposited." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is code available?" ;
                            slr:justification "Machine learning code open sourced at github.com/beibinli/SGIN, with libraries and versions named." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are ethics and consent reported?" ;
                            slr:justification "IRB approval from both Yale University and Seattle Children's Research Institute covering experiments, acquisition and analysis." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the validation limitation stated?" ;
                            slr:justification "The authors state unprompted that validation performance may be over-optimistic and does not represent real-world performance." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "low" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Passive visual attention across six distinct social-cognitive constructs, decomposed into oculomotor mechanics (fixation counts and durations, saccade durations, first-saccade timing, exploration order), region-of-interest allocation (bodies, heads, eyes, mouths, activities, distractors), event-locked response latency, and data-quality measures (percentage of gaze on screen, missing data, proportion of events meeting quality requirements). Including quality metrics as candidate features rather than as exclusion criteria is a distinctive choice, and it pays off - one such feature appears third in the SHAP ranking, which the authors interpret as non-compliance during socially oriented content being itself informative." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-047" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Three sparsity-inducing methods compared on identical splits - lasso, group lasso and the paper's SGIN - against a panel of non-sparse baselines (linear and RBF SVM, decision tree, random forest, linear and logistic regression) run 100 times each. SGIN extends group l1 regularisation to a multi-layer non-linear network by penalising the Frobenius norm of the parameter block connecting each input group to all first-hidden-layer neurons, and introduces a Stochastic Blockwise Coordinated Gradient Descent optimiser that converges faster and finds more sparse groups than plain SGD. The comparison is informative precisely because the winner is not the most accurate model: non-sparse linear baselines reach about 84% accuracy against SGIN's 78-80%, but they remove nothing, so they cannot shorten the battery at all." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-047" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "9,647 features organised into 109 groups, one per stimulus - the grouping is the methodological point, since acquisition cost is incurred per stimulus and not per derived variable, so selection must respect that structure. Group sizes are unequal by paradigm (41 to 177 features per stimulus) and group lasso's square-root-of-group-size weighting accounts for this. The regime is p >> k > n, with 9,647 features and 109 groups against 64 participants, which the paper states explicitly as the reason standard variable selection is inapplicable. Missing values imputed by unsupervised Expectation-Maximization." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-047" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Keywords: eye-tracking, feature selection, group selection, stimuli selection, paradigm selection, neural network, autism. Four of seven concern selection and only one names autism - the paper is a methods contribution to biomarker refinement, with autism as the application domain." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-047" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional; a single session per child with no follow-up, though the motivating application - monitoring treatment response and predicting later outcomes - is inherently longitudinal and the paper acknowledges much work remains before eye tracking can serve it. Data are gaze recordings with linked clinical scores. Governance is fully reported: IRB approval from both Yale University and Seattle Children's Research Institute covering experiments, acquisition and analysis." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-047" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2020. The framing is explicitly regulatory and infrastructural rather than clinical-need-driven: it situates itself among 'large-scale ongoing efforts in progress to develop next generation biomarker applications', cites the FDA-NIH Biomarker Working Group, and identifies validation studies aimed at markers of treatment response, predictors of later outcomes and subgrouping for intervention response. Its diagnosis of the field's practical bottleneck is precise and rarely stated elsewhere in this corpus: 'the longer the session associated with a biomarker, the more burdensome that biomarker becomes, and the less likely it will be to see practical implementation', with long batteries 'often stressful for young children and infants' and shorter sessions reducing burden, improving data quality and requiring less staff time. It also criticises current selection practice - 'straightforward winnowing of experimental batteries based on independent trial discriminability' - for ignoring interrelationships between trials that machine learning can capture, while warning that overfitting risk in the large-p small-n regime demands specialised techniques." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-047" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Among the best in the corpus. Reported: all six paradigms with their construct rationale, stimulus counts, durations and per-stimulus feature counts with standard deviations; the eye tracker, monitor, refresh rate, resolution, viewing distance, calibration scheme and measured calibration error; the fixation identification algorithm; the ROI annotation scheme including the non-overlap rule and composite variables; the imputation method; the network architecture, layer sizes, activation, bias handling, learning rate schedule, epochs and batch sizes; the optimisation algorithm; and the identity of every comparator method. Code is open sourced on GitHub and the data and processing pipeline are offered on request. Missing: group-wise demographics, the diagnostic decision procedure, and the specific 11 stimuli that constituted the best sparse subset." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-047" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Reported for the whole cohort only: 64 children, mean age 76.32 +/- 16.3 months (about 6.4 years), 43 male and 21 female. Group-wise ages and sexes are not tabulated; the paper states there is 'no significant difference for age and sex between the ASD and non-ASD population' without giving means or test statistics. Stanford-Binet IQ was obtained for all participants, which is unusual and important, though group-wise IQ is likewise not reported - a notable gap given that IQ turned out to be the one clinical variable the eye-tracking features could predict. No ethnicity or socioeconomic reporting. The authors flag that findings 'may reflect developmental properties of ASD specific to the school-age period'." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-047" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Goal: select a parsimonious subset of eye-tracking stimuli that preserves discriminative and predictive power, treating selection as a grouped variable problem. Main findings: 11 of 109 stimuli retained 78.13% accuracy and 82.91% AUC; SGIN was the only method achieving sparsity and accuracy together, with lasso 15 points worse at comparable sparsity and group lasso behaving near-bimodally; Dyadic Bids was the most-retained paradigm and Social Referencing the most-discarded; and the features predicted IQ (r = 0.54) but failed above chance for ADOS severity, SRS and Vineland." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-047" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Acknowledged with unusual directness: 'We acknowledge that the validation performance might be over-optimistic and does not represent real-world performance for ASD/non-ASD classification'; only 64 participants with just 30 having full ADOS, Vineland and SRS measurement; limited power to characterise autism heterogeneity; results possibly specific to the school-age period; selected paradigms not guaranteed stable across runs because the p > n problem may have no unique optimum; and that much remains before eye tracking can be used practically for treatment optimisation or long-term outcome prediction. Identifiable in review but not stated: group-wise ages, sexes and IQs are asserted as balanced but never tabulated, which matters greatly given that IQ is the one variable the features do predict; the sparsity operating point, the hyperparameters and the identification of SGIN as best were all determined against the same 10-fold estimate; and the non-autistic group's heterogeneity, while a design strength, means the classifier's target is 'autism versus other developmental presentations', which is not the same construct as 'autism versus typical development' and complicates comparison with the rest of this corpus." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-047" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two complementary interpretability layers. At the paradigm level, bootstrap discard probabilities rank the six paradigms and reveal a surprise the authors flag themselves - Social Referencing, designed to probe automaticity of information-seeking from others, is the most discarded. At the feature level, SHAP values over the trained network yield a top-10 list spanning gaze duration to activities and to eyes, latency to biological and non-biological motion, exploration timing (start times of the 4th, 9th and 10th fixations or regions), and data quality. The interpretation offered for the quality feature is candid and important: autistic children 'can provide poorer quality data due to non-compliance and attention issues during presentation of socially-oriented scene content', so a variable normally treated as measurement noise is functioning as behavioural signal." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-047" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "10-fold cross-validation with identical splits across all methods and training-set-fitted normalisation per fold, plus 100 bootstrap runs to assess selection stability. Two limitations, one acknowledged and one not. Acknowledged: the authors state directly that validation performance may be over-optimistic and does not represent real-world performance. Not stated: the operating point on the sparsity curve, the hyperparameters and the conclusion that SGIN is best were all determined against that same 10-fold estimate, and no held-out cohort, external site or independent battery was used. The paper's own framing is careful about this - it describes the work as setting 'the stage for concerted techniques designed around engines to iteratively refine and define next-generation biomarkers' rather than as delivering a validated biomarker." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-047" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Extend group sparsity to bi-level, hierarchical, tree-structured and overlapping group definitions so that paradigms can be organised into nested subgroups; replace expert-annotated event windows with data-driven identification of the informative time periods within stimuli; expand the sample to characterise heterogeneity, since limited power constrains severity prediction; design stimuli specifically for predicting ADOS, SRS and Vineland rather than reusing paradigms built for group separation, and develop modelling techniques suited to those outcomes; and test the robustness of selected stimuli on larger unseen data." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-047" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "'children with autism', 'children with ASD', 'individuals with ASD', 'non-ASD', 'children without ASD', 'typical development'. Consistently person-first, and the non-autistic group is named by what it is not rather than being called healthy or normal - accurate given its composition. The framing is biomarker-development rather than deficit-focused, referencing the FDA-NIH Biomarker Working Group and treating eye tracking as 'a powerful marker of cognition and human variability'." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-047" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Accuracy, precision, recall, specificity and AUC, all plotted as functions of the number of sparsified groups rather than reported as single points - so the deliverable is a trade-off curve between battery length and discriminative power, which is exactly the quantity a biomarker designer needs. Pearson correlation for the four regression targets, likewise plotted against sparsity, with random guessing anchored at r = 0. Selection stability is quantified as discard probability per paradigm over 100 bootstrap runs. No confidence intervals on the accuracy curves and no statistical test between methods." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-047" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The most complete clinical characterisation in the corpus for a subset of participants: ADOS severity (autism symptom severity), SRS total (reciprocal social behaviour), Vineland-3 ABC across communication, daily living skills and socialisation (adaptive functioning), and Stanford-Binet IQ for the full cohort. Critically, these are not merely tabulated but used as regression targets, which is what allows the paper's central negative finding - that eye-tracking features predict IQ but not autism severity or adaptive functioning." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-047" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "One cohort of 64 children split 32 autistic and 32 non-autistic, with the non-autistic group deliberately heterogeneous - 'typical development, language delay, and other developmental concerns'. This is one of only a few studies in the corpus whose comparison group is a clinically referred mixed-diagnosis sample rather than typically developing children, which raises the difficulty of the task and makes the result far more relevant to real screening. Clinical instrumentation is deep for a subset: ADOS severity, SRS total and Vineland-3 ABC for 30 of the 32 autistic children, and Stanford-Binet IQ for all 64." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-047" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Six passive-viewing paradigms totalling 109 stimuli, each designed by clinical psychologists 'to characterize features known to be atypical or impaired in individuals with ASD' and each targeting a distinct construct: social motivation and shared play (Activity Monitoring), primitive social preference (Biomotion), sensitivity to social overtures (Dyadic Bids), naturalistic scene viewing (Dynamic Scenes), automaticity of information-seeking from others (Social Referencing), and interest in and comprehension of others' intentions (Theory of Mind). Passive viewing with no instruction is a deliberate design decision justified by the observation that autistic individuals are differentially affected by verbal instruction, so implicit-attention paradigms generalise better across ability and age. Stimuli were presented in counterbalanced orders." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-047" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "ETRA '20, the ACM Symposium on Eye Tracking Research and Applications (Stuttgart), full papers track - the field's dedicated eye-tracking venue, published open access with support from the University of Washington, Yale and Seattle Children's." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-047" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "SR EyeLink 1000 Plus at 500 Hz binocular; Samsung SyncMaster 2233RZ 22-inch at 60 Hz, 1680 x 1050; 650 mm viewing distance; Neurobehavioral Systems Presentation with embedded calibration and behavioural management; Dynamic Programming on Distance Dispersion fixation identification; expert frame-level ROI annotation; PyTorch, sklearn and pyglmnet in Python 3.6. Quality control is quantified - 95% trimmed mean calibration error of 0.751 visual degrees - which almost no other eye-tracking study in this corpus reports." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-047" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Laboratory eye-tracking at Seattle Children's Research Institute and Yale University, with acquisition protocols aligned to a published multi-site standard and a delivery system providing embedded 5-point calibrations and the ability to insert video breaks for behavioural management. Funded by NIH awards K01 MH104739, R21 MH103550 and R03 MH092618, an NSF Expedition in Socially Assistive Robotics, and a Simons Foundation award." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-047" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No cross-modal fusion; the study is gaze-only. What it does instead is the inverse of fusion and arguably more useful: it asks how much of a large multi-paradigm battery can be discarded. The result is that 89.9% of stimuli can be removed with modest accuracy loss, and the paradigm-level analysis shows the retained signal concentrates in Dyadic Bids and Theory of Mind, both of which include visual response latency features, while Biomotion also has latency features but lacks discrete ROI measures on heads, faces, eyes and bodies. The authors hypothesise that Dyadic Bids and Theory of Mind features subsume information available in the other paradigms - a redundancy argument that is the mirror image of the fusion arguments elsewhere in this corpus." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-047" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Clinician-assigned diagnostic labels supported by an unusually complete instrument battery: ADOS severity scores administered as direct assessment by trained administrators, SRS-2 caregiver questionnaire, Vineland-3 structured caregiver interview, and Stanford-Binet IQ administered directly to every child. Each instrument is described with its purpose and administration mode. The one gap is that the diagnostic decision procedure itself - which instruments determined the ASD label, against which criteria - is not stated, and ADOS, SRS and Vineland were obtained for only 30 of the 32 autistic participants." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-047" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "One session per child covering 109 stimuli in counterbalanced orders; individual stimuli last 15 s (Biomotion, Dyadic Bids, Social Referencing, Theory of Mind), 20 s (Activity Monitoring) or 60 s (Dyn" ;
                    slr:study_design "Methodological study on a clinical eye-tracking cohort, comparing three sparsity-inducing selection methods for classification and for four regression targets" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "School-age children with autism" ;
                    slr:sample_size_text "ASD/index: 32 (30 with full ADOS, SRS and Vineland measurement); comparison: 32" ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "Eleven of 109 eye-tracking stimuli were sufficient to retain 78% accuracy and 0.83 AUC in separating autistic from non-autistic children, demonstrating substantial redundancy in a standard research battery and showing that a much shorter session could carry most of the discriminative signal. SGIN was the only method that achieved sparsification and high accuracy simultaneously: lasso sparsified bu",
                        "With 99 of 109 stimuli removed (89.9% sparsity), SGIN retained 78.13% accuracy and 82.91% AUC; with only 11 stimuli retained it still achieved good accuracy and AUC. Lasso with 71 stimuli removed reached only 65.6% accuracy and 70.8% AUC, about 15% worse. Group lasso performed comparably to SGIN on average (79.71% accuracy, 79.72% AUC) but 'either removes no groups or many, and rarely anything in-" ;
                    slr:outcome "Accuracy, precision, recall, specificity and AUC for classification, all plotted as functions of the number of sparsified groups rather than as single points - so the entire accuracy-versus-parsimony trade-off curve is the result. Pearson correlation for the four regression targets, again plotted ag" ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "With 99 of 109 stimuli removed (89.9% sparsity), SGIN retained 78.13% accuracy and 82.91% AUC; with only 11 stimuli retained it still achieved good accuracy and AUC. Lasso with 71 stimuli removed reached only 65.6% accuracy and 70.8% AUC, about 15% worse. Group lasso performed comparably to SGIN on average (79.71% accuracy, 79.72% AUC) but 'either removes no groups or many, and rarely anything in-; Eleven of 109 eye-tracking stimuli were sufficient to retain 78% accuracy and 0.83 AUC in separating autistic from non-autistic children, demonstrating substantial redundancy in a standard research battery and showing that a much shorter session could carry most of the discriminative signal. SGIN was the only method that achieved sparsification and high accuracy simultaneously: lasso sparsified bu" ] ] ;
    slr:content_sha256 "086b3322d5327c84bbee49ee463f407764b1395eb763d3d34e91e0df87f7a5b8" ;
