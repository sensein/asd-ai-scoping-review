            slr:screening_stage "title_abstract" ],
        [ a prov:Activity,
                slr:ScreeningDecisionRecord ;
            dcterms:title "Semantic mapping reveals distinct patterns in descriptions of social relations in adults with autism spectrum disorder" ;
            bibo:pmid "local_be8aa62f" ;
