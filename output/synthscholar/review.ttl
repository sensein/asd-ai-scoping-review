        [ a prov:Activity,
                slr:ScreeningDecisionRecord ;
            dcterms:title "Data Mining–Based Model for Computer-Aided Diagnosis of" ;
            bibo:pmid "local_84bcd4ed" ;
            slr:assessed_on "full_text" ;
            slr:decision "include" ;
            slr:decision_rationale "Full text confirms a computational study on a public facial-image corpus: 2,932 images, 1,466 labelled autistic and 1,466 neurotypical, described as 'collected from platforms such as Kaggle and ASD-related websites', with DeepFace producing 100,352 features per image and a multilayer perceptron classifying autism status under a 90.48/9.51 image-level split with 10-fold cross-validation on the training portion. This is the seventh study in the review built on this corpus family. The gelotophobia component is charted as reported but carries no data of its own - the paper's ethics section states that the GELOPH<15> questionnaire 'was not directly administered to participants in this study'." ;
            slr:full_text_source "user_supplied_pdf" ;
            slr:screening_stage "full_text" ],
        [ a prov:Activity,
                slr:ScreeningDecisionRecord ;
            dcterms:title "Computer-aided autism diagnosis based on visual attention models using eye tracking" ;
            bibo:pmid "local_241ec2c2" ;
            slr:assessed_on "title_abstract" ;
            slr:decision "include" ;
            slr:decision_rationale "Visual attention models learned separately for autistic and typically developing groups from eye-tracking data over video stimuli, used as a supervised classifier for autism diagnosis - a computational model on behavioral data with an autism classification target." ;
            slr:screening_stage "title_abstract" ],
        [ a prov:Activity,
                slr:ScreeningDecisionRecord ;
            dcterms:title "Predictive model using autism" ;
            bibo:pmid "local_cd7545e2" ;
            slr:assessed_on "full_text" ;
            slr:decision "include" ;
            slr:decision_rationale "Full text confirms a prospective clinical study at Showa University Karasuyama Hospital, Tokyo. Ninety adults with full-scale IQ above 85 were assessed - 40 with schizophrenia recruited April 2022 to December 2023 and 50 with autism recruited October 2018 to December 2020 - with diagnoses established by consensus among several expert psychiatrists under DSM-5 criteria. Critically for eligibility, the paper states that 'ASD diagnosis was a good clinical estimate, as neither the ADOS-2 nor the Autism Diagnostic Interview-Revised (ADI-R) was employed in the assessment process', so the index measurement is independent of the reference standard and none of the circularity that disqualified the questionnaire-item studies applies here. The modelled inputs are ADOS-2 Module 4 item codes - trained-clinician ratings of behaviour the participant produced during 15 standardised interactive activities designed to elicit social interaction, communication and repetitive behaviour - which is a record of observed behaviour under a controlled paradigm, the same category as the human-coded free-play indicators included elsewhere in this review and a different category from a respondent's questionnaire judgements. Included." ;
            slr:full_text_source "user_supplied_pdf" ;
            slr:screening_stage "full_text" ],
        [ a prov:Activity,
                slr:ScreeningDecisionRecord ;
            dcterms:title "Detection of Autism Spectrum Disorder (ASD) Using Lightweight Ensemble CNN Based on Facial Images for Improved Diagnostic Accuracy" ;
            bibo:pmid "local_0a39cca9" ;
            slr:assessed_on "full_text" ;
            slr:decision "include" ;
            slr:decision_rationale "Full text confirms a computational study on 2,936 facial images - 1,468 labelled autistic and 1,468 labelled normal - drawn from Kaggle together with data from an autism centre in Semarang, Indonesia, split 80:20 and modelled with five lightweight CNN ensembles combining MobileNetV2, ResNet50 and VGG16 with EfficientNet variants under averaging and voting. Included, with the record noting that the corpus mixes a public web-scraped collection with clinic-sourced images without reporting the proportion from each, and that no clinical ascertainment is described for either." ;
            slr:full_text_source "user_supplied_pdf" ;
            slr:screening_stage "full_text" ],
        [ a prov:Activity,
                slr:ScreeningDecisionRecord ;
            dcterms:title "Prediction for children with autism spectrum disorder based on digital behavioral features during free play" ;
            bibo:pmid "local_abad69fd" ;
            slr:assessed_on "title_abstract" ;
            slr:decision "include" ;
            slr:decision_rationale "Title and abstract describe 123 autistic and 123 neurotypical children aged 1-6 engaging in a 1.5-minute videotaped free play with fixed toys, coded for 19 autistic behaviours expanded into 81 digital behaviour indicators, with a stepwise logistic regression prediction model reaching AUC 0.826, sensitivity 85.4% and specificity 68.3%. Human participants, an observed behavioural modality, a computational prediction model and an autism target are all present." ;
            slr:screening_stage "title_abstract" ],
        [ a prov:Activity,
