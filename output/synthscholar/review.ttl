    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the sampling frame appropriate to the intended application?" ;
                            slr:justification "Consecutive recruitment at routine well-child visits in four primary care clinics, with a 41:416 ratio approximating screening prevalence." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are comparison groups matched on the variables that matter?" ;
                            slr:justification "Age, sex, ethnicity and caregiver education all differ significantly; only age and missing data were covaried." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is a comparison group with other developmental concerns retained?" ;
                            slr:justification "The 12 children with non-autism diagnoses were excluded for small sample size, removing the clinically decisive contrast." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is cognitive level equated or adjusted?" ;
                            slr:justification "Mullen data exist only for the autistic group (composite 63.64), so the difference cannot be quantified; acknowledged as a limitation." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are participants and recruitment adequately described?" ;
                            slr:justification "Inclusion and exclusion criteria, demographics including race, ethnicity and caregiver education, and clinical scores all tabulated with tests." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "some concerns" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the reference standard appropriate and independently applied?" ;
                            slr:justification "M-CHAT-R/F for all, ADOS-2 Toddler Module and DSM-5 determination by research-reliable licensed psychologists for those referred." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Does the measured signal correspond to the named construct?" ;
                            slr:justification "The authors report on inspection that the movement extends to trunk and shoulders, which the face-only algorithm does not capture." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are acquisition confounds neutralised in the measure?" ;
                            slr:justification "Displacement normalised by inter-eye distance to remove camera-distance effects; entropy tolerance set from population-wide rather than per-participant variance." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are the measures defined reproducibly?" ;
                            slr:justification "Complete multiscale entropy formulation with coarse-graining, m, r, integration range, missing-data handling and the 40% validity gate." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the behavioral data acquisition described reproducibly?" ;
                            slr:justification "All seven movies with durations and content, tripod distance, caregiver and bystander positioning, and the acknowledgement that the room was not laboratory-controlled." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is attention verified rather than assumed?" ;
                            slr:justification "Head-yaw threshold plus an independent automatic gaze estimation, with attention rates of 95% and 93% reported by group." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "low" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are covariates tested?" ;
                            slr:justification "Age and missing-data proportion entered as ANCOVA covariates with no effect; sex, ethnicity, caregiver education and cognition not adjusted." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are negative results reported?" ;
                            slr:justification "The eight-dimensional combination underperformed either feature alone, and Mechanical-Puppy showed no group difference on any measure." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are classifier configurations compared statistically?" ;
                            slr:justification "A variance-based true-difference criterion with an explicit rule for judging models not significantly different." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the validation scheme justified against the methodological literature?" ;
                            slr:justification "Leave-one-out cross-validation adopted with citation to Vabalas et al. (2019) on overoptimistic classification." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is uncertainty quantified?" ;
                            slr:justification "Hanley-McNeil 95% confidence intervals on every AUC, and effect size r on every group comparison." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the unit of analysis the participant?" ;
                            slr:justification "One scalar per feature per movie per child." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "low" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are ethics and consent reported?" ;
                            slr:justification "Written caregiver consent and Duke University Health System IRB approval under two named protocol numbers." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are limitations stated candidly?" ;
                            slr:justification "Sample size, the 40% data gate, the unresolved cognitive difference, and the observation that trunk and shoulders also move." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the dataset accessible or its access conditions stated?" ;
                            slr:justification "No availability statement." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is code available?" ;
                            slr:justification "Not mentioned, though the analysis is fully specified." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are the reported statistics internally consistent?" ;
                            slr:justification "The Results report positive Mullen-movement correlations (r = .36, .39, .34) while the Discussion states that lower-ability children moved more, and builds an interpretation on the latter." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is a competing published interpretation addressed with evidence?" ;
                            slr:justification "The within-group content contrast is used to argue against Martin et al.'s social-modulation hypothesis." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are competing interests disclosed?" ;
                            slr:justification "Extensive and specific - five authors developed the licensed app technology with financial benefit to themselves and Duke, plus advisory, consulting, patent and industry affiliations." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "some concerns" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The most complete statistical reporting in the corpus for a study of this kind. Every group comparison carries an effect size r alongside its p value; the mixed ANOVAs report F with degrees of freedom for group, movie type and their interaction; entropy comparisons are reported per scale across all 30 multiscale resolutions rather than only for the integrated summary; every AUC carries a Hanley-McNeil 95% confidence interval; and classifier configurations are compared by a stated variance-based criterion with the explicit rule that models are 'considered not significantly different' if the interval spans zero. The confidence intervals are essential to reading the result honestly and the paper does not hide what they show: for Blowing-Bubbles the entropy AUC interval runs 0.53 to 0.75, so that single-movie result barely excludes chance, and the intervals on the individual-movie AUCs are uniformly wide because only about 30 autistic children contribute to each. The headline 0.85 is correspondingly better supported than the per-movie figures. Also reported are the attention rates for both groups and the per-movie participant counts after the data-quality gate, both of which bear on whether the measurement was equally successful in the two groups." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-081" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Comprehensive for the autistic group and absent for the comparison group. ADOS-2 Toddler Module calibrated severity scores average 7.56 +/- 1.67 across a range of 2-10, so the sample spans the severity spectrum. The Mullen Scales of Early Learning provide an Early Learning Composite of 63.64 +/- 10.17 alongside Expressive Language (T = 28.08), Receptive Language (T = 23.14), Fine Motor (T = 34.11) and Visual Reception (T = 33.94) T-scores - all substantially below average, indicating a group with considerable developmental delay, and the Fine Motor score is directly relevant since the outcome is a motor measure. The Mullen composite is used analytically, correlated against all three head movement measures. Because no Mullen data exist for the neurotypical group, the cognitive difference between groups cannot be estimated or adjusted, and the authors list this among their limitations: 'The autistic and neurotypical group differed in cognitive ability and, thus, it is not clear the degree to which differences in cognition contributed to our findings.' Comorbidity is not otherwise characterised, and the 12 children with non-autism diagnoses were removed." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-081" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Head movement dynamics during passive viewing, decomposed into three levels: how much the head moves (rate), how sharply that movement changes (acceleration, motivated as relating 'to the magnitude of the instantaneous forces involved in head movement'), and how predictable the movement time series is across temporal scales (multiscale entropy, indexing 'the level of predictability and stability'). The complexity measure is the study's conceptual contribution and is well chosen: rate and acceleration are magnitude measures that could be produced by any source of extra motion, whereas entropy captures the structure of the movement over time and licenses the specific claim that autistic toddlers' movements were 'less predictable and less stable'. The behaviour is explicitly sensorimotor rather than social, and the paper situates it in a substantial literature on motor differences in autism - stereotypies, fine and gross motor impairment, motor planning and coordination, asymmetry in home-video studies of infants later diagnosed, and difficulties in gait, balance, postural control, movement accuracy, manual dexterity and praxis. The authors' own inspection finding, that trunk and shoulders move too, suggests the underlying construct is postural rather than cephalic." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-081" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2022-2023. The framing is developmental and mechanistic rather than diagnostic, positioning head movement as 'one of the early sensorimotor signs associated with autism' and situating it within an established literature on motor differences - stereotypies, fine and gross motor impairment, motor planning and coordination, asymmetry in home videos of infants later diagnosed, and documented difficulties in gait, balance, postural control, movement accuracy, manual dexterity and praxis. What distinguishes the positioning is that the paper engages directly with a competing published interpretation and produces evidence against it: Martin and colleagues found head movement differences only during social stimuli and proposed that autistic children use head movements to modulate their perception of social scenes, whereas this study finds differences during both content types and states plainly that 'our data do not support the hypothesis that the head movements of the autistic toddlers were used to modulate the perception of social stimuli, per se'. It then offers alternatives without overclaiming, noting that 'the nature of these differences in head movement dynamics is not fully understood'. The translational claim is correspondingly modest - computer vision 'offers a scalable means of detecting subtle differences' that 'may be helpful in identifying early behaviors associated with autism' - and the stated endpoint is a multimodal digital phenotyping tool combining this channel with gaze, facial dynamics and response to name, not a standalone diagnostic. Given the disclosed commercial interest in the app, that restraint is notable." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-081" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional in analysis but embedded in a prospective screening pathway, with diagnosis ascertained after app administration at a mean interval of 0.7 months (range -0.1 to 5.9). No longitudinal follow-up of the measures themselves, and the authors identify the developmental course of head movement differences as a future direction. Ethics reporting is complete and specific: written informed consent from caregivers and approval by the Duke University Health System Institutional Review Board under two named protocol numbers. Conflicts of interest are declared at length and are substantial: five authors developed technology related to the app which has been licensed, with both they and Duke University benefiting financially; the senior clinical author sits on four scientific advisory boards, consults for three companies including Apple and receives book royalties; both senior authors have invention disclosures and patent applications registered with Duke's licensing office; and the senior engineering author is affiliated with Apple, with a note that the work was done before and independently of that affiliation. The disclosure is exemplary in its completeness, and the commercial interest in the app is relevant context for a paper reporting the app's discriminative performance." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-081" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Three limitations are stated and each is substantive. The sample, though large overall, contained only 41 autistic children and therefore 'did not offer sufficient power to determine the influence of biological and demographic characteristics, such as sex'. Data from all participants were not used in every analysis because of the 40% attendance threshold. And 'the autistic and neurotypical group differed in cognitive ability and, thus, it is not clear the degree to which differences in cognition contributed to our findings' - a direct acknowledgement that the study's most likely alternative explanation is unresolved. A fourth limitation appears not in the limitations section but in the discussion, and is arguably the most important: inspection of videos from high-movement toddlers 'revealed that the movement involves not just the head but also the upper body including trunk and shoulders, which were not captured by our computer vision algorithm, as we focused solely on the face in this study'. That reframes the construct from head movement to whole-body postural instability, and the authors follow it with a serious engagement with the postural-sway literature. What goes unaddressed: the significant ethnicity and caregiver-education differences, never revisited after the demographic table; the exclusion of the 12 children with non-autism diagnoses, which removes the clinically decisive contrast; the wide confidence intervals on the per-movie AUCs; and the internal contradiction between the Results' positive Mullen correlations and the Discussion's statement that lower-ability children moved more." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-081" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Journal of Child Psychology and Psychiatry 64(1):156-166 (2023, published online 2022), a clinical child mental health journal rather than an engineering venue. Authorship spans Duke's Department of Electrical and Computer Engineering, Department of Psychiatry and Behavioral Sciences, Center for Autism and Brain Development, Global Health Institute, Office of Information Technology, and Department of Biomedical Engineering, Mathematics and Computer Sciences, with two co-senior authors - one clinical, one engineering. Funded by an NIH Autism Centers of Excellence award and two NIMH R01s, with additional support to the engineering authors from NSF, the Department of Defense and industry gifts. The genuinely joint clinical-engineering leadership is visible throughout: the statistical inference is what a clinical journal would require (effect sizes, mixed ANOVA, ANCOVA covariates, non-parametric tests), the measurement engineering is what a computer vision group would produce (landmark normalisation, population-wide entropy tolerance, dual attention criteria), and neither is subordinated to the other. The paper includes a 'Key points' box in the journal's clinical format." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-081" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Seven brief movies totalling about five minutes, split four social and three nonsocial by explicit design, each described with its duration and content. The social movies feature actors smiling, frowning, gesturing and using limited verbal expression; the nonsocial movies feature bubbles moving randomly, a mechanical toy puppy and a puppy appearing at screen positions in a fixed right-right-left pattern. The social/nonsocial split is the analytic instrument rather than a background feature: it enables the within-group contrast that produces the paper's most informative result, and it permits the group-by-content interaction test that adjudicates against Martin and colleagues' interpretation. The paradigm requires nothing of the child beyond sitting and watching, which is what makes it viable at 17 months in a clinic waiting room, and the near-equivalent attention rates of 95% and 93% across groups indicate that it holds toddlers' attention in both groups - an important equivalence, since differential attention would otherwise confound any movement measure. One movie, Mechanical-Puppy, showed no significant group difference on any of the three measures, and this is reported consistently rather than omitted." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-081" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Three directions, each following from a stated limitation. Explore the developmental course of head movement differences and 'elucidate their nature and neurobiological basis', with several concrete hypotheses already advanced - that the movements modulate sensory information generally rather than social perception specifically, that they reflect postural control difficulties that increase with sensory demand, or that like some repetitive behaviours they serve a regulatory function when stimuli are arousing. Extend the computer vision beyond the face to the trunk and shoulders, following directly from the observation that the movement is not confined to the head. And combine head movement 'with other behavioral biomarkers such as gaze, facial dynamics, and response to name' toward a multimodal digital phenotyping tool - which is the group's programmatic direction and is supported here by the demonstration that a single behavioural channel reaches AUC 0.85 in a prevalence-realistic sample." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-081" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Among the most completely reported studies in the corpus. Specified: recruitment setting and inclusion and exclusion criteria; the full screen-and-refer diagnostic pathway with M-CHAT-R/F cut-points; instrument names and administrator qualifications; the demographic table with race, ethnicity, caregiver education and statistical tests; all seven movies with durations and content descriptions; the physical setup including tripod distance, caregiver instructions and positioning of other people; the landmark count and pose angles; the |yaw| < 20 degree attention criterion with its theoretical justification and the additional gaze-based confirmation; the inter-eye normalisation with its rationale; the 10-frame smoothing window; the complete multiscale entropy formulation with the coarse-graining equation, the sample entropy definition, m = 2, r = 0.15 sigma, the use of population-wide sigma with its rationale, integration across the first 10 scales, and the missing-data handling; the 40% data-quality threshold with its justification and the resulting per-movie sample sizes shown in every figure; every statistical test with its Python function; the classifier, kernel, cross-validation scheme and confidence-interval method; and the model-comparison criterion. Missing: no data or code release, no random seeds, and no reporting of how many of the 457 were excluded per movie in aggregate, though per-movie counts are given." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-081" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A single SVM with RBF kernel on two or three interpretable features, chosen because it 'is popular when used on relatively smaller datasets' and paired with leave-one-out cross-validation explicitly 'to minimize the risk of overoptimistic classification', citing Vabalas et al. (2019) - one of only two studies in this corpus to cite the methodological literature on validation bias directly. The modelling is deliberately subordinate to the statistical analysis: the paper's primary evidence is a set of mixed ANOVAs, Mann-Whitney and Wilcoxon tests with effect sizes and ANCOVA covariate control, and classification is used to answer a specific supplementary question - whether the measures 'can be integrated to distinguish autistic and neurotypical toddlers'. That ordering is appropriate for a study whose contribution is a behavioural finding rather than a screening product, and it is unusual in this corpus, where classification accuracy is typically the primary and often the only evidence. Classifier configurations are compared by a formal variance-based true-difference criterion, so the claim that combining across movies beats single movies is tested rather than asserted." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-081" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Interpretability is pursued through the design of the measures rather than through model attribution, and the analysis that carries most weight is the within-group contrast. Because the measures are three physically meaningful quantities, the finding can be stated directly in behavioural terms. The decisive analysis compares social against nonsocial movies within each group: neurotypical toddlers moved more, faster and less predictably during social content (r = 0.47, 0.62, 0.51), while autistic toddlers showed no content-dependent difference at all. That single contrast does three things a between-group difference cannot. It shows the effect is not simply 'autistic children move more' but that neurotypical children modulate movement by content and autistic children do not. It adjudicates directly against Martin and colleagues' published interpretation that increased head movement in autism serves to modulate perception of social stimuli, since on that account the difference should be confined to social content, and here it is not. And it rules out the reading that the measure indexes social engagement, since the group difference persists for nonsocial content. The paper then engages seriously with alternative mechanisms - general sensory modulation, postural control under multisensory demand, a regulatory function analogous to repetitive behaviour - rather than settling on one. The Mullen correlation analysis is the interpretively weakest element and contains an internal contradiction: the Results report positive correlations between Early Learning Composite and all three movement measures during social movies (r = .36, .39, .34), implying higher cognitive ability accompanied more movement, while the Discussion asserts that 'autistic children with lower cognitive abilities showed higher levels of head movement rate, acceleration, and complexity' and builds an interpretation on that reading." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-081" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Reported in full and tested, and the picture is one of multiple significant imbalances. Autistic group: 41 toddlers, 70.7% male, 24.38 +/- 4.73 months. Neurotypical group: 416 toddlers, 50.2% male, 20.59 +/- 3.18 months. Age differs significantly by ANOVA, sex by chi-squared. Two further significant differences appear in the demographic table and are less commonly reported elsewhere in this corpus: Hispanic ethnicity (29.3% versus 7.5%) and caregiver education, where 85.6% of neurotypical caregivers held a four-year college degree or more against 53.7% of autistic caregivers. Age and the proportion of missing data were entered as ANCOVA covariates and did not affect the between-group results; sex was not covaried, with the authors stating that the sample 'did not offer sufficient power to determine the influence of biological and demographic characteristics, such as sex'; ethnicity and caregiver education are reported but never revisited. The last is worth attention in this particular paradigm, since the measurement is of a toddler sitting on a caregiver's lap with 'no special instructions given regarding how to hold the child', so any systematic difference in how caregivers positioned or settled their children would enter the signal directly. Cognitive ability differs markedly - the autistic group's Mullen Early Learning Composite averages 63.64 - and no Mullen data were collected for the neurotypical group, so the difference cannot be quantified or adjusted." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-081" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A genuine prospective screening pathway, which is rare in this corpus and is the study's principal methodological asset. Every participant received the M-CHAT-R/F as part of routine clinical care. Referral for diagnostic evaluation was triggered by a total score of 3 or more initially, 2 or more after follow-up questions, or developmental concerns raised by the pediatrician or parent. Referred children received the ADOS-2 Toddler Module from research-reliable licensed psychologists who determined DSM-5 status, supported by the Mullen Scales of Early Learning. Diagnosis therefore followed rather than preceded enrolment, and the mean interval between diagnosis and app administration was 0.7 months, so the behavioural measurement and the diagnostic determination are close in time. The comparison group's status is partly instrumented rather than assumed, since screen-positive children judged to have no concerns are retained in it. The one gap is that children with a negative M-CHAT-R/F and no raised concern were not directly assessed, so the neurotypical group will contain some proportion of children whose autism was not detected by screening - which biases toward underestimating the group difference rather than inflating it." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-081" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "'autistic toddlers', 'autistic children', 'autistic individuals', 'young autistic children', consistently identity-first including in the title, against 'neurotypical toddlers'. 'Patients' never appears and 'typically developing' is replaced throughout by 'neurotypical'. The framing of the phenomenon is descriptive rather than deficit-oriented - head movements are 'differences' in 'dynamics', autism is 'characterized by differences in social communication', and the interpretive discussion entertains the possibility that the movements 'might also serve a regulatory function' rather than treating them as symptoms to be catalogued. This is among the most careful terminology in the corpus and is consistent with the senior authorship's position in the autism research community." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-081" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Three groups identified, two analysed. Of 457 toddlers recruited during well-child checkups at four pediatric primary care clinics, 41 were subsequently diagnosed with autism under DSM-5 and 416 were classified neurotypical. A third group of 12 who screened positive on the M-CHAT-R/F and received a non-autism diagnosis - language delay without autism is the example given - was excluded from analysis because of small sample size. That exclusion is the design's one substantive omission, since those 12 are precisely the children against whom a screening tool must discriminate, and their removal means the reported AUC reflects autism versus typical development rather than autism versus developmental concern. The neurotypical group is nonetheless better ascertained than most comparison groups in this corpus, being formed of two subsets - children with a negative M-CHAT-R/F and no caregiver or physician concern, and children who screened positive or raised concern but were then judged on the ADOS-2 and psychologist clinical judgment to have no developmental or autism-related concerns. The 41:416 ratio is the study's most consequential structural feature: it approximates the base rate a deployed screening tool would encounter, in contrast to the balanced designs that dominate this review." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-081" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "One scalar per feature per movie per child, so the unit of analysis is the participant throughout and no segment-level inflation is possible. Three representational decisions do substantial confound-neutralising work. Displacement is normalised by a running average of inter-eye distance, removing the effect of a lap-held toddler moving toward or away from the camera, which would otherwise dominate the raw landmark displacement signal. The entropy tolerance uses the population-wide standard deviation rather than each child's own, so a child with more variable movement is not scored against a correspondingly wider tolerance and thereby made to appear more regular - a subtle and correct choice, with a prior paper cited for its detailed justification. And analysis is restricted to segments where the child is attending, established by two independent criteria: a head-yaw threshold justified by central-bias theory for gaze estimation, and an automatic gaze estimation algorithm confirming the child was looking at the screen. That restriction is what allows the authors to argue that the differences 'do not appear to reflect the degree of attention to the movies', and it is reinforced by the near-equal attention rates of 95% and 93%." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-081" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Goal: replicate a prior head-movement-rate finding in a larger sample with redesigned stimuli, and extend it to acceleration and multiscale-entropy complexity, testing whether differences are more pronounced for social content and whether the measures can be combined for classification. Main findings: autistic toddlers showed significantly higher rate (F(1,427) = 42.48), acceleration (F(1,427) = 38.65) and complexity (F(1,427) = 29.68), all p < .0001, with medium to large effect sizes for social movies and small to medium for nonsocial; a significant main effect of movie type with no group-by-type interaction; neurotypical toddlers modulated all three measures by content while autistic toddlers did not; classification reached AUC 0.85 for acceleration across the four social movies and 0.80 for entropy, with the eight-dimensional combination performing worse at 0.73; and neither age nor missing data affected the group comparisons." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-081" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Keywords: Autism; head movements; computer vision; complexity analysis. Four terms, two naming the behavioural construct and two the method - a compact and accurate description of a paper that measures one behaviour precisely rather than surveying many." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-081" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Sound in every respect that this corpus commonly gets wrong, with the residual weakness being confounding rather than leakage. The unit is the participant, since all features are per-child summaries; leave-one-out cross-validation is used and justified by citation to Vabalas et al. on overoptimistic classification; AUCs carry Hanley-McNeil confidence intervals; and classifier configurations are compared by a formal criterion rather than by inspecting point estimates. Two further design properties strengthen the estimate beyond what the cross-validation alone provides. The class ratio of 41:416 approximates real screening prevalence, so the AUC is not estimated under an artificially balanced design - a distinction that matters enormously for translation, since the same AUC implies very different positive predictive value at 9% prevalence than at 50%. And diagnosis followed rather than preceded enrolment, so the sample is not conditioned on already being diagnosed, removing the referral filter that shapes almost every other study here. What remains unaddressed: age and missing data were covaried but sex was not, on stated power grounds; ethnicity and caregiver education differ significantly and are never revisited; cognitive ability differs and cannot be adjusted because Mullen data exist only for the autistic group; the 12 children with non-autism diagnoses were excluded, so the discrimination tested is against typical development rather than against developmental concern; and there is no independent replication cohort, though this study is itself a replication and extension of the group's earlier rate-only finding in a larger sample with redesigned stimuli." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-081" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Deliberately minimal and entirely commodity: an iOS tablet on a tripod, using its own front-facing camera, running a purpose-built app. No external camera, depth sensor, marker, wearable or motion capture. That is what permits administration in a primary-care room by a non-specialist assistant with a caregiver holding the child. The analytic chain is specified in detail - face detection with human-supervised tracking to ensure only the participant's face is followed, 49 2D facial landmarks, head pose angles relative to the tablet, an automatic gaze estimation algorithm, and Python with pingouin for all statistics. Two engineering decisions deserve note because they neutralise obvious confounds. Landmark displacement is normalised by a one-second running average of inter-eye distance, which removes the effect of the child moving closer to or further from the camera - a variance source that would otherwise dominate in a lap-held toddler. And the sample-entropy tolerance uses the population-wide standard deviation rather than each participant's own, chosen explicitly so that 'this choice defined a distance threshold r consistent across participants', which prevents children with more variable movement from being scored on a correspondingly wider tolerance and hence appearing artificially regular." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-081" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Four Duke pediatric primary care clinics during routine well-child checkups - the only truly point-of-care setting in the corpus. The description of environmental control is unusually honest: a quiet room with few distractions was identified at each clinic, but 'although it was quiet and without a lot of distraction, it was not otherwise controlled as in a laboratory setting', with the four rooms noted as similar in size, lighting and presence of distractions. The social arrangement is specified in detail and matters for the measurement: the caregiver held the child on their lap with no instructions on how to do so, sat quietly, and was asked not to guide the child's behaviour or give instructions, while siblings and the administering assistant stayed behind both caregiver and child to reduce distraction. The tablet sat on a tripod approximately 60 cm in front of the child. That the caregiver's holding is uninstructed is a deliberate choice for ecological validity and an uncontrolled source of variance for a measure of postural movement." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-081" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Single modality, with the fusion result confined to combining features within it - and that result is a clean negative. Two features (acceleration, entropy) across four movies gives an eight-dimensional space and AUC 0.73, worse than either feature alone combined across the same four movies (0.85 and 0.80). The authors report this plainly and explain it correctly as the expected behaviour of a moderate-sized dataset as dimensionality grows. Two aspects make the negative result more useful than most. The two features are moderately correlated (r = 0.4-0.5), so combining them adds dimensionality without much independent information - which is the situation in which such degradation is predicted, and the authors report the correlation that makes it interpretable. And combining a single feature across movies did help substantially, lifting acceleration from around 0.68-0.71 on individual movies to 0.85 across four - so aggregation over stimuli was worth far more than aggregation over feature types. The paper's stated future direction is genuine multimodal fusion with gaze, facial dynamics and response to name, which is the group's programme; this study establishes what one channel contributes." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-081" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "One app administration per child during a well-child checkup, comprising seven brief movies totalling roughly five minutes" ;
                    slr:study_design "Prospective cross-sectional study embedded in routine primary-care well-child visits, with diagnostic outcome ascertained subsequently through a screen-and-refer pathway" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Toddlers subsequently diagnosed with autism during routine primary-care screening" ;
                    slr:sample_size_text "ASD/index: 41; comparison: 416" ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "Best classification: AUC 0.85 for mean acceleration combined across the four social movies, and 0.80 for integrated entropy combined across the same movies. Combining both features across all four movies gave 0.73 - worse than either alone. Individual movies were weaker: Rhymes was best, while Blowing-Bubbles gave 0.71 for acceleration, 0.68 for entropy and 0.73 for both; Spinning-Top 0.68, 0.67 a",
                        "In an unselected primary-care sample of 457 toddlers of whom 41 were subsequently diagnosed with autism, computer vision applied to tablet front-camera video showed that autistic toddlers moved their heads more, with greater acceleration and greater multiscale-entropy complexity, while watching brief movies - replicating and extending the group's earlier rate-only finding with medium to large effe" ;
                    slr:outcome "AUC with 95% confidence intervals for every feature configuration and every movie; effect size r for all group comparisons; F statistics and p values for the mixed ANOVAs; and per-scale p values for the entropy comparisons across all 30 multiscale resolutions" ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "Best classification: AUC 0.85 for mean acceleration combined across the four social movies, and 0.80 for integrated entropy combined across the same movies. Combining both features across all four movies gave 0.73 - worse than either alone. Individual movies were weaker: Rhymes was best, while Blowing-Bubbles gave 0.71 for acceleration, 0.68 for entropy and 0.73 for both; Spinning-Top 0.68, 0.67 a; In an unselected primary-care sample of 457 toddlers of whom 41 were subsequently diagnosed with autism, computer vision applied to tablet front-camera video showed that autistic toddlers moved their heads more, with greater acceleration and greater multiscale-entropy complexity, while watching brief movies - replicating and extending the group's earlier rate-only finding with medium to large effe" ] ] ;
