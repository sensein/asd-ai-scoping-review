    slr:journal "Journal of Autism and Dev" ;
    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "DSM-5 plus CARS only; the authors state that ADOS and ADI-R were unavailable and that diagnoses were not confirmed with validated diagnostic tools, listing this as their first limitation." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "All 74 children contributed data and appear in the analyses; calibration and correction procedures preceded a fixed 10-second stimulus identical for every child." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "Five-fold cross-validation with permutation testing of both accuracy and feature weights, and a very low feature-to-sample ratio, but it is not stated whether AOI selection was nested within folds, and two mutually inconsistent sets of performance figures appear in the paper." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "Clinic-recruited cases against kindergarten-recruited controls, age-matched and physician-screened, but with a practical gender imbalance (89% vs 73% male) and a narrow single-site, ethnically homogeneous 4-6 year-old sample." ] ;
            slr:overall_judgment "some" ;
            slr:tool_used "QUADAS-2" ] .

<https://doi.org/10.1007/s10846-018-00975-y> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Autism spectrum disorder (ASD) is a neurodevelopmental disorder that affects people from birth, whose symptoms are found in the early developmental period. The ASD diagnosis is usually performed through several sessions of behavioral observation, exhaustive screening, and manual coding behavior. The early detection of ASD signs in naturalistic behavioral observation may be improved through Child-Robot Interaction (CRI) and technological-based tools for automated behavior assessment. Robot-assisted tools using CRI theories have been of interest in intervention for children with Autism Spectrum Disorder (CwASD), elucidating faster and more significant gains from the diagnosis and therapeutic intervention when compared to classical methods. Additionally, using computer vision to analyze child’s behaviors and automated video coding to summarize the responses would help clinicians to reduce the delay of ASD diagnosis. In this article, a CRI to enhance the traditional tools for ASD diagnosis is proposed. The system relies on computer vision and an unstructured and scalable network of RGBD sensors built upon Robot Operating System (ROS) and machine learning algorithms for automated face analysis. Also, a proof of concept is presented, with participation of three typically developing (TD) children and three children in risk of suffering from ASD." ;
    dcterms:bibliographicCitation "Ramírez-Duque AA; Frizera-Neto A; Bastos TF (2019). Robot-Assisted Autism Spectrum Disorder Diagnostic Based on Artificial Reasoning. *Journal of Intelligent & Robotic Systems, 96(2), 267-281*. https://doi.org/10.1007/s10846-018-00975-y" ;
    dcterms:creator "Bastos TF",
        "Frizera-Neto A",
        "Ramírez-Duque AA" ;
    dcterms:title "Robot-Assisted Autism Spectrum Disorder Diagnostic Based on Artificial Reasoning" ;
    bibo:doi "10.1007/s10846-018-00975-y" ;
    bibo:pmid "local_d587f9cd" ;
    fabio:hasPublicationYear 2019 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Handling of missing data and attrition" ;
                            slr:justification "All six children completed their single session and no attrition is reported, but occlusion failures in the vision pipeline are acknowledged without any account of how affected periods were handled." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Comparison group adequacy" ;
                            slr:justification "Three children asserted to be typically developing with no screening procedure described, so the contrast is between two undefined populations." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Confounder control" ;
                            slr:justification "No developmental measure in three-year-olds, so general developmental level cannot be separated from autism risk; and the mediator order is fixed, confounding the key finding with order, fatigue and novelty." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Participant selection and spectrum representativeness" ;
                            slr:justification "Three children with unenumerated risk factors and no confirmed diagnosis; no severity, cognitive or developmental characterisation in a 36-48 month sample." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Measurement standardisation" ;
                            slr:justification "A fixed protocol with the same stimulus types delivered by both mediators, and face recognition used to isolate the child from other faces in the room. But occlusion by hair, hands and the robot is reported, and the number of cameras and session duration are unstated." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Index test definition and prespecification" ;
                            slr:justification "The pipeline is specified stage by stage with named open-source components, integration details, message types and the HMM inference step; the joint-attention construct is decomposed into three named subtypes in advance." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Outcome measurement blinding" ;
                            slr:justification "The visual-focus-of-attention estimates are automated and therefore blind, but the behavioural interpretation is a qualitative reading by the investigators with no independent coding." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Reference standard quality" ;
                            slr:justification "No diagnostic instrument or assessment for either group; the index group's status is explicitly unconfirmed." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "unclear" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Sample size adequacy for the modelling" ;
                            slr:justification "Three children per group in a single session each - adequate for a technical proof of concept and for nothing else, which the paper acknowledges." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Performance estimation and chance level" ;
                            slr:justification "No diagnostic metric is computed and none is claimed, which is appropriate. But the behavioural comparison carries no statistical test, effect size or uncertainty estimate, and the pipeline's attention estimates are never validated against human coding." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Data splitting and leakage control" ;
                            slr:justification "Not applicable; no model is trained on the study's data and no classifier is fitted." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Preprocessing and feature selection nesting" ;
                            slr:justification "Not applicable. All neural components are pretrained and used unmodified apart from ROS integration." ;
                            slr:rating "Low" ] ;
                    slr:overall_concern "unclear" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Data, code and protocol availability" ;
                            slr:justification "No data or code release, but the system is built on cited open-source projects with repository URLs and specified integration modifications, so the pipeline is reconstructible from published components." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Reporting of results and uncertainty" ;
                            slr:justification "Qualitative behavioural descriptions with no test statistic, effect size, interval or count, alongside a figure of pipeline performance." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Ethics, consent and conflicts" ;
                            slr:justification "Parental consent reported for all volunteers, but no ethics committee approval appears anywhere, in a study recording multi-camera video of three-year-olds. Funding and competing interests are not stated." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Completeness of methods reporting" ;
                            slr:justification "The vision pipeline, open-source components with URLs, ROS integration details, message types, HMM inference, bidirectional architecture, joint-attention protocol with subtypes, mediator sequence, tagged behaviours, participant numbers, ages and sex are all reported. Ethics approval, session duration, camera count, the defining risk factors and any quantitative result are not." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Acknowledgement of limitations" ;
                            slr:justification "No limitations section, but the evaluation is explicitly labelled a proof of concept, the index group is described as without confirmed diagnosis, and the pipeline's occlusion failures are reported. The sample size, the uncounterbalanced order and the absence of coding validation are not addressed." ;
                            slr:rating "Unclear" ] ;
                    slr:overall_concern "unclear" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional with a single session per child, and no follow-up. Parental consent is reported for all volunteers; no ethics committee approval appears in the retrieved text, which is an omission for a study recording video of three-year-olds. Funding and competing interests are not stated." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-031" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Not applicable in the classification sense, and the study does not claim otherwise. No classifier is trained, no held-out set exists, no accuracy, sensitivity, specificity or AUC is computed, and the evaluation is explicitly labelled a proof of concept. The two things it does validate are appropriate to its claims: the vision pipeline's technical performance is reported for the case study together with the occlusion failures encountered, and the behavioural observation is presented qualitatively as a pattern rather than as a discrimination. Four limits bound what can be taken from it. Six children in a single session each cannot support a behavioural claim, and no statistical test, effect size or uncertainty estimate is offered. Neither group has documented diagnostic status - the index group has no confirmed diagnosis and the risk factors are unenumerated, while the comparison group is asserted rather than screened - so the contrast is between two undefined populations. The mediator sequence is not counterbalanced, therapist always preceding robot, so the finding that at-risk children did not initiate joint attention toward the robot is confounded with order, accumulated fatigue and the novelty effect the paper elsewhere says it wishes to exploit. And the behavioural finding rests entirely on automated visual-focus-of-attention estimates from a pipeline whose occlusion failures the paper itself reports, with no reliability comparison against human coding of the same sessions - which the study's own tagged behaviour categories would have made straightforward and which is the single most valuable analysis it could have added." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-031" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Journal of Intelligent and Robotic Systems 96(2):267-281, 2019; received 25 April 2018, accepted 20 December 2018. A robotics and intelligent-systems venue, and the article is written for it: the distributed architecture, message types, library integration and fusion strategy are specified in detail, while the clinical evaluation is a six-child proof of concept with no ethics statement, no diagnostic ascertainment and no statistical analysis. The venue's orientation also accounts for the paper's most valuable contribution to this review, which is infrastructure rather than result." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-031" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None, and the paper says so rather than implying otherwise. The index group comprises 'three children without confirmed ASD diagnosis, but with evidence of risk factors', with the risk factors unspecified and no instrument, screening tool or clinician assessment reported; the comparison group is described as typically developing with no screening procedure. This is a genuinely undetermined diagnostic status on both sides, which the study handles by making no diagnostic claim - it reports a behavioural pattern difference and suggests it 'can be used as evidence to improve the ASD diagnosis' rather than asserting that the groups were correctly separated. For the review the relevant observation is that the transparency is a virtue while the underlying limitation is severe: a behavioural difference between three children with unspecified risk factors and three children of unverified typical development cannot support an inference about autism, and the paper's proof-of-concept framing is the correct standing for it." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-031" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "An in-clinic setup with the therapist, the robot and a caregiver all present in the room, the caregiver instructed not to help the child perform the task. The multi-person setting is what necessitates one of the pipeline's design decisions - face recognition is used specifically to 'differentiate the child's face from other faces detected and found in the scene', since a system measuring a child's gaze in a room containing two adults must first establish which face is the child's. That is a practical requirement of clinical deployment which laboratory single-subject setups do not encounter, and its explicit handling is a strength." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-031" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Keywords: Child-Robot interaction, Autism spectrum disorder, Convolutional neural network, Robot reasoning model, Statistical shape modeling. Balanced between the interaction paradigm, the population and the technical components. Terms carried through the body: joint attention, initiation of joint attention, responding to joint attention, initiation of request behaviour, visual focus of attention, RGBD, ROS, Hidden Markov Model, automated video coding, occlusion." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-031" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Per-camera head pose and gaze vectors published as ROS navigation messages, fused asynchronously and reduced to a timestamped visual-focus-of-attention estimate naming the target the child is looking at. The representation is intentionally semantic rather than raw - the pipeline's output is 'the child is looking at the robot' rather than a feature vector - which is why the analysis can be conducted in the vocabulary of joint-attention subtypes." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-031" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No model is trained on the study's own data. The neural components are pretrained and used as instruments: Dlib's CNN face detector and ResNet face recogniser, and OpenFace's CLNF landmark and gaze estimator, integrated into ROS nodes with the neural model made an attribute of the node class and evaluated on each topic callback. The only inference component developed here is the Hidden Markov Model for visual focus of attention, which infers the attention target from the fused pose and gaze sequence. For a review of computational approaches this is the measurement-infrastructure end of the field: the machine learning does the perceptual work that a human coder would otherwise do frame by frame, and the clinical inference remains with the therapist. The paper's stated purpose supports this reading - automated video coding is intended to 'help the clinicians to reduce the delay of ASD diagnosis' by removing the manual coding burden, not to produce a diagnosis." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-031" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. No severity, cognitive, adaptive or language measure exists for any participant." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-031" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No diagnostic metric of any kind, and none claimed. What is reported is vision-pipeline performance for the case study, presented in a figure and accompanied by an account of the occlusion problems encountered, plus qualitative descriptions of joint-attention events by group and mediator. The absence of any statistical test on the behavioural comparison is the study's main analytic gap, though with three children per group no test would carry weight; the more consequential omission is the lack of any reliability check of the automated attention estimates against human coding, which is the validation the measurement infrastructure needs and which the study's own tagged behaviour categories would have supported." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-031" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The aim is a robot-assisted framework that automates the behavioural coding on which autism diagnosis depends, addressing the delay between when signs are observable and when diagnosis becomes reliable. The technical contribution is an unstructured, scalable network of RGBD sensors on ROS, each node performing local face analysis and publishing head pose and gaze as navigation messages, with a central node fusing them and computing visual focus of attention through a Hidden Markov Model, coupled bidirectionally to a robot whose gaze shifts, facial expressions and sound rewards adapt to the child's performance. The behavioural finding, from six children in single sessions, concerns initiation of joint attention across a within-session transition from therapist to robot mediator: all three typically developing children initiated joint attention toward the therapist, then across the transition, then toward the robot, whereas the three at-risk children initiated only toward the therapist during the transition. The authors describe this as 'a clear difference of behavior pattern' usable 'as evidence to improve the ASD diagnosis'. No classifier is trained, no accuracy is computed, and the evaluation is labelled a proof of concept." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-031" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Age and sex are reported at the level the sample allows - a 36-to-48-month band and a five-boys-one-girl composition - and nothing else. No cognitive, language, adaptive, socioeconomic or comorbidity measure was obtained, which in three-year-olds means that any behavioural difference between the groups could reflect general developmental level rather than autism risk. The absence matters particularly for the reported finding, since initiation of joint attention develops rapidly across this age range and neither group's developmental level is characterised. The risk factors that define the index group are also not enumerated, so what distinguishes the two groups is not stated in any measurable form." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-031" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Six children aged 36 to 48 months, each participating in a single session: three described as 'without confirmed ASD diagnosis, but with evidence of risk factors', and three typically developing children serving as the control group, with five boys and one girl in total. The sample is among the smallest in the review and the paper is explicit that it constitutes 'a proof of concept'. The diagnostic status of both groups is undocumented - the risk factors are not enumerated for the index group and no screening procedure is described for the comparison group - so no participant in the study has an established diagnostic classification. That is unusual in this corpus and is stated openly rather than obscured: the phrase 'without confirmed ASD diagnosis' appears in the methods, and the study makes no diagnostic claim on the basis of these children. At 36 to 48 months both groups sit in the age window where identification is typically still under way, so the risk framing is age-appropriate. No cognitive, language, socioeconomic or comorbidity information is reported." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-031" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Published 2019 by a group at the Universidade Federal do Espirito Santo in Brazil. The framing identifies the problem precisely: autism signs may be observable before ten months while reliable diagnosis is only possible at 18 to 24 months, diagnosis 'is usually performed through several sessions of behavioral observation, exhaustive screening, and manual coding behavior', and automated video coding could 'help the clinicians to reduce the delay'. For this review the study contributes three things, none of them a detection result. It builds the most developed measurement infrastructure in the corpus - an unstructured, scalable multi-camera RGBD network on ROS in which each node performs local face analysis and a fusion node computes visual focus of attention through a Hidden Markov Model - and it does so from cited open-source components, addressing directly the occlusion problem that limits single-camera gaze measurement with a moving child in a room containing two adults and a robot. It specifies its construct more precisely than anything else here, decomposing joint attention into initiation, response and request-initiation subtypes and reporting its finding at that level rather than in aggregate. And it closes the loop between measurement and robot behaviour, with the reasoning module modifying the robot's gaze, expression and rewards according to the child's performance - a design the introduction motivates by observing that earlier robot-assisted diagnostic systems 'have primarily been open loop and remotely operated' and 'are unable to perform autonomous feedback to enhance the interaction'. Its behavioural claim, however, cannot be relied on: six children in single sessions, no documented diagnostic status in either group, no ethics approval reported, an uncounterbalanced mediator order that confounds the key finding with order and novelty, no developmental measure in three-year-olds, and no reliability check of the automated attention estimates against human coding. The paper's own framing is appropriately modest - 'a proof of concept', a group 'without confirmed ASD diagnosis', and a conclusion that the observed pattern 'can be used as evidence to improve the ASD diagnosis' rather than that it discriminates." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-031" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "High at the construct level, not applicable at the model level. Every measured quantity is a named nonverbal behaviour with a clinical referent, and the analytic unit is a joint-attention event of a specified subtype, so results are stated in the vocabulary a clinician uses. No classifier exists whose behaviour would require explanation; the neural components are perceptual instruments whose outputs - a face location, a gaze direction, an attention target - are directly checkable against the video." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-031" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The most architecturally developed measurement infrastructure in the review. An unstructured, scalable network of RGBD sensors runs on ROS, with each camera node performing face detection, recognition, segmentation, tracking, landmark detection, head pose and gaze estimation locally, publishing results as nav_msgs/Odometry messages; a fusion node on the most powerful workstation combines all navigation messages, computes the visual focus of attention through a Hidden Markov Model, and publishes it as a timestamped message naming the attention target. The components are open source and cited with repositories - Dlib for CNN face detection and ResNet face recognition, OpenFace for CLNF landmarks and gaze - with the specific integration modification described (making the neural model an attribute of the ROS node class and evaluating it in each topic callback). Two design consequences matter for the review. Multi-camera fusion addresses occlusion directly, which is the binding practical constraint on gaze measurement in a room with a moving child, an adult and a robot - and the paper reports encountering exactly that, with 'occlusion by hair, hands and the robot' detected. And the architecture is scalable and unstructured by design, meaning cameras can be added without reconfiguration, which is what would make deployment across differently shaped clinic rooms feasible." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-031" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A joint-attention protocol using 'look at, point and speak' stimuli to direct the child's attention toward objects in the room, delivered first by the therapist alone and subsequently by the robot alone. The construct is decomposed into the three standard subtypes - initiation of joint attention, responding to joint attention bids, and initiation of request behaviour - which is a level of construct specification that few studies in this review match, and the within-session mediator transition makes the design a within-subject manipulation: the same child receives the same bid type from a human and then from a robot, so the mediator is the variable and the child is their own control. That is what makes a six-child study capable of producing an interpretable pattern at all. The design's weakness is that the transition is not counterbalanced - therapist always precedes robot - so the group difference in initiation toward the robot is confounded with order, with accumulated fatigue, and with the novelty effect that the paper elsewhere says it intends to leverage." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-031" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Extension of the framework to the other behavioural features the paper names as within its reach - 'eye contact, stereotyped movements of the head, concentration and excessive interest in objects or events' - and continued development of the reasoning module that closes the loop between measurement and robot behaviour. The steps the study most needs are counterbalancing the mediator order, establishing diagnostic status for both groups, validating the automated attention estimates against human coding, and a sample capable of supporting a statistical claim." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-031" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "There is no dedicated limitations section, but the paper's self-description is honest at the points that matter: the evaluation is labelled 'a proof of concept', the index group is described as 'without confirmed ASD diagnosis', and the vision pipeline's occlusion failures are reported rather than omitted. The introduction also identifies the gap in prior work accurately - early robot-assisted diagnostic systems 'have primarily been open loop and remotely operated systems. However, these approaches are unable to perform autonomous feedback to enhance the interaction' - which is the specific deficiency the closed-loop architecture addresses. What is not addressed: six children in single sessions cannot support a behavioural claim, and no statistical test, effect size or uncertainty estimate accompanies the reported difference; neither group has documented diagnostic status; the mediator order is not counterbalanced, confounding the key finding with order, fatigue and novelty; no ethics approval is reported; no developmental measure was obtained in three-year-olds, so general developmental level cannot be separated from autism risk; and the behavioural finding rests on automated visual-focus-of-attention estimates with no reliability check against human coding, in a pipeline whose occlusion problems the paper itself reports." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-031" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Spatial rather than modal fusion, and it is the architecture's central idea. Multiple RGBD cameras each estimate head pose and gaze independently and publish them as ROS odometry messages; a fusion node performs asynchronous matching across all local estimates and computes a single visual focus of attention through a Hidden Markov Model, published with a timestamp and the name of the attention target. Fusing viewpoints to recover a gaze target is a direct answer to the occlusion problem that limits single-camera gaze measurement with moving children - the paper reports occlusion 'by hair, hands and the robot' as encountered in practice - and the HMM adds temporal smoothing so that the attention target is inferred from a sequence rather than frame by frame. No other study in this review builds comparable measurement infrastructure, and the fact that it is assembled from open-source components on ROS makes it reproducible in principle." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-031" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Standard clinical framing of the period, with 'individuals suffering from ASD' and 'children in risk of suffering from ASD' recurring - phrasing that treats autism as an affliction and is less careful than the corpus's better examples. The abbreviation CwASD (children with autism spectrum disorder) is used throughout. Against this, the paper's account of the clinical problem is precise and non-dismissive: diagnosis 'is usually performed through several sessions of behavioral observation, exhaustive screening, and manual coding behavior', signs may be observable before ten months while reliable diagnosis is possible only at 18 or 24 months, and the delay between the two is what the technology addresses. The stated purpose throughout is to 'assist and enhance the traditional practice' and to 'help the clinicians', with the therapist retaining control of the protocol - so the technology is positioned as instrumentation for a clinician rather than as a substitute. No autistic person or family organisation is reported as involved." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-031" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Joint attention, specified with more precision than anywhere else in this review. The construct is decomposed into its three established subtypes - initiation of joint attention, responding to joint attention bids, and initiation of request behaviour - and the measured cues are enumerated: looking toward an object, toward the robot and toward the therapist, pointing, responding to a prompt from either mediator, and self-occlusion. The reported finding is subtype-specific rather than aggregate: initiation of joint attention appeared toward the therapist, across the mediator transition, and toward the robot in all three typically developing children, but only toward the therapist during the transition in the at-risk children. Whatever the sample's limitations, that is a claim about which form of joint attention differs and toward which partner, which is the level of specificity that makes a behavioural finding clinically usable. The paper also notes that the same infrastructure could measure eye contact, stereotyped head movements, concentration and excessive interest in objects, and that joint attention was chosen as this study's scope - so the construct restriction is deliberate." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-031" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Strong for the system and thin for the study. Reported: the complete vision pipeline stage by stage; the open-source libraries with repository URLs and the modification required to run their neural models inside ROS nodes; the inter-node message types; the HMM-based visual-focus-of-attention estimation; the two-channel bidirectional architecture linking robot and web client; the therapist-facing application's role in controlling and registering each protocol step; the joint-attention protocol with its three subtypes and stimulus types; the mediator sequence; the tagged behaviour categories; participant numbers, ages, sex composition and parental consent; and the occlusion failures encountered. Not reported: ethics approval, session duration, the risk factors defining the index group, any screening of the comparison group, the number of cameras used, and any quantitative behavioural result. A reader could rebuild the system from published components and could not reproduce the study." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-031" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:study_design "System-development and architecture study with a single-session proof-of-concept evaluation comparing two small groups qualitatively" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: ; comparison: Three typically developing children" ] ] ;
