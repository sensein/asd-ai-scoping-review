    slr:journal "Frontiers in Robotics and AI, 6, Article 132" ;
    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "Diagnosis independently confirmed by two medical specialists in clinical interviews under ICD-10 criteria with supplementary neuropsychological examination; the double independent confirmation is a genuine strength, though no standardised observational instrument is named and controls are unscreened." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "No ages, sexes or matching information are reported in this paper, so demographic confounding cannot be assessed; the sample is high-functioning adults only, recruited from a single clinic against a university student and staff control group with no screening." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "Repeated nested k-fold cross-validation with 10 outer folds and five permutations, a 5-by-5 inner cycle, participant shuffling before fold definition, PCA fitted inside the inner fold, and parameter optimisation strictly separated from performance evaluation." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "The reduction from 145 to 116 videos is explained (one entire task abandoned after a single dyad misunderstood instructions), and the confusion counts account for all 58 participants, but no participant-level exclusions or missing-data handling are described." ] ;
            slr:overall_judgment "some" ;
            slr:tool_used "QUADAS-2" ] .

<https://doi.org/10.3390/diagnostics15151859> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Background/Objectives: Autism spectrum disorder (ASD) is a neurodevelopmental disorder distinguished by an extensive range of symptoms, including reduced social interaction, communication difficulties and tiresome behaviors. Early detection of ASD is important because it allows for timely intervention, which significantly improves developmental, behavioral, and communicative outcomes in children. However, traditional diagnostic procedures for identifying autism spectrum disorder (ASD) typically involve lengthy clinical examinations, which can be both time-consuming and costly. This research proposes leveraging automated machine learning (AUTOML) to streamline the diagnostic process and enhance its accuracy. Methods: In this study, by collecting data from various rehabilitation centers across Pakistan, we applied a specific AUTOML tool known as Tree-based Pipeline Optimization Tool (TPOT) for ASD detection. Notably, this study marks one of the initial explorations into utilizing AUTOML for ASD detection. The experimentations indicate that the TPOT provided the best pipeline for the dataset, which was verified using a manual machine learning method. Results: The study contributes to the field of ASD diagnosis by using AUTOML to determine the likelihood of ASD in children at prompt stages of evolution. The study also provides an evaluation of precision, recall, and F1-score metrics to confirm the correctness of the diagnosis. The propose TPOT-based AUTOML framework attained an overall accuracy 78%, with a precision of 83%, a recall of 90%, and an F1-score of 86% for the autistic class. Conclusions: In summary, this research offers an encouraging approach to improve the detection of autism spectrum disorders (ASD) in children, which could lead to better results for affected individuals and their families." ;
    dcterms:bibliographicCitation "Ehsan K; Sultan K; Fatima A; Sheraz M; Chuah TC (2025). Early Detection of Autism Spectrum Disorder Through Automated Machine Learning. *Diagnostics, 15(15), Article 1859*. https://doi.org/10.3390/diagnostics15151859" ;
    dcterms:creator "Chuah TC",
        "Ehsan K",
        "Fatima A",
        "Sheraz M",
        "Sultan K" ;
    dcterms:title "Early Detection of Autism Spectrum Disorder Through Automated Machine Learning" ;
    bibo:doi "10.3390/diagnostics15151859" ;
    bibo:pmid "local_8ff20c48" ;
    fabio:hasPublicationYear 2025 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Data source and eligibility described" ;
                            slr:justification "Inclusion and exclusion criteria are stated prospectively (age 2-4, complete responses, parental consent; exclusion for incompleteness or comorbid neurological disorder) - clearer than most of the corpus." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Participants appropriate to the question" ;
                            slr:justification "Respondents recruited through autism rehabilitation centres, so the non-autistic class is a scoring by-product rather than a recruited comparison group; children with comorbid neurological conditions excluded." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Sample size justified" ;
                            slr:justification "No power or sample-size reasoning, and the reported totals are internally inconsistent by eight participants." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Predictors defined and measured appropriately" ;
                            slr:justification "Predictors are five Q-CHAT-10 items that are constituents of the label's own scoring function; the respondent-type field, the one available marker of measurement heterogeneity, was deleted as irrelevant." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Predictors assessed blind to outcome" ;
                            slr:justification "Item deletion was decided by correlating each item against the score and label over the full dataset before the train-test split." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Model development guarded against optimism" ;
                            slr:justification "TPOT's search cross-validated within the training portion only, and the selected pipeline was manually re-implemented with the published parameters and reproduced - an explicit replication step." ;
                            slr:rating "Low" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Outcome determined independently of predictors" ;
                            slr:justification "It is not - the outcome is arithmetically determined by the predictor set, five members of which were then removed." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Outcome definition and ascertainment" ;
                            slr:justification "Outcome is a Boolean derived from the Q-CHAT-10 scoring function; no clinical diagnosis exists for any participant." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Performance measures adequate" ;
                            slr:justification "Per-class precision/recall/F1 with support, macro and weighted averages, ROC and PR curves - a fuller set than most, and the weak non-autistic recall of 0.53 is reported honestly. But the 71.1% majority-class baseline is never stated, the abstract's 78% contradicts the tables' 0.83, and no interval estimate accompanies any figure." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Validation design guards against optimism" ;
                            slr:justification "A single unseeded, unrepeated 80/20 split with no confidence intervals and no external data; feature deletion performed before the split." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Limitations and overinterpretation" ;
                            slr:justification "A real limitations paragraph on external generalisability, with a thoughtful note that comparison against UCI data would introduce socio-clinical bias; but the label circularity, the baseline, the single split and the count discrepancy are all unmentioned, and one sentence claims differentiation of intellectual disability that nothing tests." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Analysis unit matches the clinical claim" ;
                            slr:justification "One row per child; the analysis unit is the child, matching the claim's subject even though the label does not match its object." ;
                            slr:rating "Low" ] ;
                    slr:overall_concern "high" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2025, published 24 July, 46 days from submission to acceptance including one revision round. Framing is assistive and comparatively restrained: an encouraging approach to improve detection, a first step towards early diagnosis within a few minutes saving time and expense. The novelty claim is placed on the population rather than the accuracy - unlike prior work relying on publicly available datasets from high-income countries, this study uses a locally developed dataset reflecting regional demographics and clinical practices - and that is the paper's real contribution to the corpus. The overreach is concentrated in one sentence claiming the system differentiates intellectual disability disorder from ASD using DSM-5-TR-derived questions, which nothing in the study tests." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-142" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Pearson item-label correlations guide feature deletion, and the correlation matrix is shown. No post-hoc model explanation - no permutation or Gini importance from the RandomForest component, no partial dependence, no per-case attribution - despite the model family making all of these trivially available. The discussion raises pipeline interpretability as a consideration for AUTOML users but does not act on it." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-142" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "There is no task or paradigm. The instrument is the ten-item Quantitative Checklist for Autism in Toddlers (Q-CHAT-10) of Allison et al., reproduced in full in Table 2, plus seven auxiliary variables. Behaviour is entirely caregiver-reported and retrospective." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-142" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Diagnostics 15(15):1859 (MDPI) - an open-access clinical diagnostics journal, with academic editors drawn from the biomedical signal-processing community. The venue's clinical framing did not surface the label circularity or the abstract/table accuracy mismatch in review." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-142" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Not confirmed for any participant. This is the defining feature of the study: there is no clinical diagnosis anywhere in the pipeline. The label Class/ASD Traits is generated by the Q-CHAT-10 scoring function applied to the same ten items that supply the features. What is modelled is therefore a scoring rule, not a condition. The one screening instrument used is a caregiver checklist completed variously by parents, caregivers, medical staff or clinicians - and the field recording which of those it was was deleted during preprocessing as irrelevant, discarding the only available indicator of measurement heterogeneity." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-142" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A nine-field tabular row per child: five binary Q-CHAT items plus age in months, binary sex, binary jaundice and binary family history. The feature-selection step is the analytically decisive move and it runs in an unexpected direction. Items A1, A2, A6, A8 and A9 were removed because they correlated highly with the Q-CHAT-10 score - but the Q-CHAT-10 score is the sum of exactly those items, so high correlation is arithmetic necessity, not redundancy. Deleting them does not remove noise; it removes half of the summands that define the label. The reported 0.83 is thus an estimate of how well five items reconstruct the threshold on all ten, which is why this study lands in the low 80s while local_8253c2ec and local_a0d73248, which retained all items, reach 100%." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-142" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A single random 80/20 split: 593 training, 149 test. No cross-validation of the final model, no repeats, no seed, no stratification statement, no interval estimate. TPOT's internal search cross-validates within the training portion, so the pipeline choice is not directly contaminated by the test rows - a cleaner arrangement than most of this corpus - and the manual re-fit with the reported parameters confirms the pipeline is what it claims to be. Two problems dominate nonetheless. First, the validation design cannot address the label's circularity: no split scheme can turn the reconstruction of a checklist threshold into diagnostic accuracy. Second, the test set is 71.1% positive and the paper never states the majority-class baseline, even though it prints it - the SVM comparator's recall of 1.000 at precision 0.718 and accuracy 0.71 is the all-positive classifier, sitting unremarked in the comparison table as though it were a genuine competitor. Read against that baseline, the AUTOML pipeline's contribution is about 12 accuracy points, and the non-autistic recall of 0.53 shows where its errors fall - on precisely the children a screening tool exists to reassure." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-142" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Automated machine learning by genetic programming: TPOT searched pipelines over classical estimators and returned an ensemble of BernoulliNB and RandomForestClassifier. Six manually specified baselines (SVM, KNN, naive Bayes, logistic regression, decision tree, random forest) were fitted for comparison. No deep learning." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-142" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No instrumentation - Google Forms for capture, CSV export. Modelling used the TPOT library (10 generations, population 100, remaining parameters default) with scikit-learn estimators. No versions, no hardware, no seed. The full best-pipeline parameter set is given in Table 4, which is more than most papers in this corpus supply." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-142" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No fusion - a single questionnaire modality, augmented by four static fields (age, sex, jaundice, family history). The study belongs to the corpus's questionnaire-tabular branch alongside local_8253c2ec and local_a0d73248 rather than to any sensor-based branch." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-142" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "ASD, autism spectrum disorder, ASD traits, autistic class, non-autistic class, children with autism, affected individuals. The introduction is unusually careful in one respect - it states that autism is not a sickness or disease but a lifelong neurological developmental disorder - and unusually careless elsewhere, describing symptoms as tiresome behaviors, deficits in public interactivity, and social disablement. The DSM-5 support levels are laid out at length, then never used. No autistic or community perspective is cited." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-142" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "One limitation is stated - no evaluation on public datasets, and the Pakistani rehabilitation-centre sample's demographic and cultural specificity may limit generalisability, with a sensible note that direct comparison against UCI data would itself introduce socio-clinical bias. Unstated: that the label is a deterministic function of the predictors, that five of the ten items were deleted precisely because they predicted the label too well, that the majority-class baseline is 71.1%, that a single unrepeated split underpins every number, that the sample size does not add up, and that respondents were drawn from among parents of children already attending autism rehabilitation services." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-142" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. No IQ, developmental quotient, adaptive behaviour, language level or ASD severity measure. Q-CHAT-10 score is present but is the label's source. Comorbid neurological conditions were an exclusion criterion, so no comorbidity data exist." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-142" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Early social-communication behaviours as reported by a caregiver: response to name, ease of eye contact, requesting gestures, declarative pointing, pretend play, gaze following, comforting a distressed family member, early speech quality, conventional gestures such as waving goodbye, and prolonged purposeless staring. After correlation-based deletion only five of these (A3 requesting gestures, A4 pointing, A5 pretend play, A7 comforting, A10 staring) remain as predictors." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-142" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Several rehabilitation centres across Pakistan, with responses collected on paper and via Google Forms into a Google Sheet. The authors are candid about the context: there is no proper reporting and tracking of ASD cases in the country, and the data had to be recorded from scratch. Neither the number of centres, their names, their catchment, nor the collection dates are given, so site cannot be treated as a variable and the pooled sample cannot be characterised." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-142" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Mixed, with one notable strength. The authors manually rebuilt the TPOT-selected pipeline using the exact reported parameters to verify that the automated result was reproducible - a deliberate replication step that almost no other study in this corpus performs, and the paper's best methodological instinct. Against that: the dataset is not deposited, no code is released, no library versions or random seed are given, the single 80/20 split is unseeded, the participant counts do not reconcile, and two different accuracies (78% and 0.83) appear for the same experiment." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-142" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Age band 2-4 years (recorded in months, no mean or SD); 434 male / 308 female overall with no per-class breakdown; jaundice at birth and family history of ASD recorded as binary fields. Nothing on socioeconomic status, urban/rural location, language, education or which rehabilitation centre each child came from - the last being important, since centre could act as a site effect in a dataset pooled across several centres. The paper does report a sex effect in the data (males give more positive Q-CHAT responses) and interprets it as males being more prone to autism, without considering respondent expectation or referral bias." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-142" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional, no follow-up. Ethics reporting is among the better examples in this corpus in form: Declaration of Helsinki compliance, named committee, protocol number BUIC/H11/SE/46113 with an approval date of 3 April 2023, informed parental consent as an inclusion criterion, and exclusion of children with comorbid neurological disorders. The reviewing body is a Software Engineering Department ethical review committee rather than a clinical or psychological board, which is a mismatch given that the study collects health data on disabled children and advertises a diagnostic use." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-142" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "autism spectrum disorder; AUTOML; TPOT. Three terms, one condition and two tooling names - no participants, no validation, no setting, and nothing marking the study's genuine distinguishing feature, which is that the data come from Pakistan." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-142" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The stated goal is to apply automated machine learning (TPOT) to a locally collected Pakistani dataset to determine the likelihood of ASD in children at early stages and to speed up diagnosis, with an explicit framing as one of the first uses of AUTOML for ASD detection on real-world non-high-income-country data. Headline findings: TPOT selected a BernoulliNB plus RandomForest ensemble; autistic-class precision 0.83, recall 0.90, F1 0.86; non-autistic-class precision 0.68, recall 0.53, F1 0.60; accuracy 0.83 in the results tables but reported as 78% in the abstract; micro-ROC 0.87, macro-ROC 0.81." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-142" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "One group of children aged 2-4 years recruited through Pakistani rehabilitation centres, split by questionnaire outcome rather than by recruitment stream. The paper states 750 participants, but 434 male plus 308 female is 742, and 593 training plus 149 test is also 742; eight children are unaccounted for and the inconsistency is not noted. Class sizes are never stated directly and must be recovered from the test-set support column (106 autistic, 43 non-autistic), implying about 71% positive overall. There is no separate typically developing comparison group in the design sense - both classes come from the same rehabilitation-centre respondent pool, and the questionnaire was described as circulated among trainers and parents of children with autism, which makes the non-autistic class a by-product of scoring rather than a recruited control group." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-142" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Compare other AUTOML libraries; benchmark the model on public datasets such as the UCI ASD screening data to test robustness across populations. Both are reasonable and directly address the stated limitation, but neither touches the circular label that governs the entire result." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-142" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Per-class precision, recall and F1 with support, macro and weighted averages, accuracy, a confusion matrix, micro-average ROC 0.87 and macro-average ROC 0.81, and PR values of 0.892 and 0.728. This is a fuller metric set than most of the corpus offers, and unusually the weaker class is reported honestly (non-autistic recall 0.53). Missing: specificity named as such, calibration, predictive values at a stated prevalence, and any confidence interval. The abstract's 78% does not match the 0.83 in the results and comparison tables - the 0.78 in the table is the weighted-average precision/F1 row, so the headline accuracy has been read off the wrong line." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-142" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "SVM 0.71, KNN 0.74, naive Bayes 0.80, logistic regression 0.757, decision tree 0.70, random forest 0.780, AUTOML 0.83. Notably the SVM row reports recall 1.000 with precision 0.718, which is the signa" ;
                    slr:study_design "Cross-sectional primary data collection (parent/caregiver/clinician-completed questionnaire) followed by supervised binary classification with a single random 80/20 train-test spli…" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: Not reported directly. Inferable from the test-set support column: 106 of 149 test cases (71.1%) are the autistic class, implying roughly 528 of 742 across the full dataset.; comparison: Not reported directly; 43 of 149 test cases (28.9%) are the non-autistic class." ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "The abstract states an overall accuracy of 78% with precision 83%, recall 90% and F1 86% for the autistic class. The results table gives accuracy 0.83, with 0.78 appearing as the weighted-average precision and F1 row; Table 7 also lists AUTOML at 0.83. The abstract has therefore reported a weighted-average column as the accuracy, so the paper carries two different headline accuracies. Non-autistic" ;
                    slr:outcome "Per-class precision, recall and F1 with support counts, macro and weighted averages, accuracy, confusion matrix, micro-average ROC 0.87 and macro-average ROC 0.81, and PR values of 0.892 (autistic) and 0.728 (non-autistic)." ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "The abstract states an overall accuracy of 78% with precision 83%, recall 90% and F1 86% for the autistic class. The results table gives accuracy 0.83, with 0.78 appearing as the weighted-average precision and F1 row; Table 7 also lists AUTOML at 0.83. The abstract has therefore reported a weighted-average column as the accuracy, so the paper carries two different headline accuracies. Non-autistic" ] ] ;
    slr:content_sha256 "641ea2a254f04fe28d2129daaf9c5a65f6ee59fada0e66137314f2bd2aafd1c4" ;
