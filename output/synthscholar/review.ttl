    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "No diagnostic instrument, clinician assessment or screening procedure for either group; the index group explicitly has no confirmed diagnosis and the risk factors are unspecified." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "A well-specified multi-camera pipeline with face recognition to isolate the child from other faces in the room and HMM-based temporal inference of attention target - but occlusion by hair, hands and the robot is reported as encountered, and no reliability check of the automated attention estimates against human coding is performed." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Six children in total, three per group, with the index group described as having 'evidence of risk factors' that are not enumerated and no confirmed diagnosis, and the comparison group asserted as typically developing with no screening described. No cognitive or developmental measure in a 36-48 month sample." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "One session per child with the mediator sequence fixed - therapist always before robot - so the key finding about initiation of joint attention toward the robot is confounded with order, fatigue and novelty. No attrition reported." ] ;
            slr:overall_judgment "high" ;
            slr:tool_used "QUADAS-2" ] .

<https://doi.org/10.1007/s11042-026-21473-6> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Autism spectrum disorder (ASD) is a complex psychological disease described by persis­ tent problems in restricted behaviours, speech, social interaction, and non-verbal commu­ nication. Individuals with ASDs have trouble identifying and connecting with others. The ASD symptoms might arise in an extensive range of conditions. Many dissimilar kinds of functions exist for individuals with ASD. Emerging expert methods for recognising ASD that depend on the facial signs of children are one of the foremost contributions for perceiving ASD at an initial phase. At present, deep learning (DL) models have delivered excellent performance in a diversity of pattern recognition tasks. The utilization of mod­ els that depend on convolutional neural networks (CNNs) was projected by numerous researchers to be utilized in the study of ASD. In this paper, an innovative methodology called Deep Feature Fusion Integrated with Wavelet Neural Network for Autism Spectrum Disorder Identification (DFFWNN-ASDI) utilizing facial images is proposed. The primary goal of the DFFWNN-ASDI technique is to serve as a promising diagnostic aid in clinical settings for the early and non-invasive detection of autism. Initially, the DFFWNN-ASDI technique performs pre-processing by utilising the Gaussian Gabor Filter (GGF) to en­ hance relevant facial features and suppress noise. Furthermore, a feature fusion strategy is implemented by incorporating deep features extracted from VGG16, DenseNet-121, and XceptionNet models, ensuring a rich and diverse representation of facial cues relevant to ASD. Moreover, the wavelet neural network (WNN) technique is employed for detecting ASD. Additionally, the chimp optimisation algorithm (COA) technique is implemented for optimal tuning of WNN parameters to enhance classification performance. Eventually, the Grad-CAM + + technique is applied to provide visual interpretation and abnormality detection. To establish the improved performance of the DFFWNN-ASDI approach, an ex­ tensive set of simulations was conducted under the autism image dataset. The comparison outcomes of the DFFWNN-ASDI model established a greater accuracy value of 98.42% compared to existing approaches across diverse metrics." ;
    dcterms:bibliographicCitation "Shaik J; Shekhar R; Shelke CJ (2026). Received: 28 July 2025 / Revised: 24 January 2026 / Accepted: 2 March 2026. *Multimedia Tools and Applications, 85*. https://doi.org/10.1007/s11042-026-21473-6" ;
    dcterms:creator "Shaik J",
        "Shekhar R",
        "Shelke CJ" ;
    dcterms:title "Received: 28 July 2025 / Revised: 24 January 2026 / Accepted: 2 March 2026" ;
    bibo:doi "10.1007/s11042-026-21473-6" ;
    bibo:pmid "local_e4c2a776" ;
    fabio:hasPublicationYear 2026 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Data source and eligibility described" ;
                            slr:justification "Dataset cited only by reference number, with a formal statement denying that any dataset was analysed." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Sample size justified" ;
                            slr:justification "No justification; image count treated as sample size with no partition counts reported." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Participants appropriate to the question" ;
                            slr:justification "No participants; unnamed public image corpus with unknown per-child composition and no demographics." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Predictors assessed blind to outcome" ;
                            slr:justification "Feature extraction is label-independent, but the chimp optimiser tuned parameters against an unstated objective on an unstated partition." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Predictors defined and measured appropriately" ;
                            slr:justification "Gabor-filtered facial images fused across three backbones, with input resolution, fused dimensionality and wavelet basis all unspecified." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Component contributions established" ;
                            slr:justification "Four pipeline stages each claimed as contributions and none ablated." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Outcome determined independently of predictors" ;
                            slr:justification "Formally independent, but the label's own validity is unestablished." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Outcome definition and ascertainment" ;
                            slr:justification "Outcome is a folder label on a public image corpus; no clinical ascertainment." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Analysis unit matches the clinical claim" ;
                            slr:justification "Claims concern diagnosing children; metrics are computed over images with unknown per-child counts on a corpus that repeats individuals." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Limitations and overinterpretation" ;
                            slr:justification "One genuine and well-aimed limitation on demographic absence and fairness, alongside a diagnostic-aid claim for clinical settings and no acknowledgement of the label, split or consistency problems." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Declarations consistent with the study" ;
                            slr:justification "Ethics states no human participants were involved and data availability states no dataset was generated or analysed, both contradicting the article's contents; privacy preservation is claimed with no mechanism described." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Validation design guards against optimism" ;
                            slr:justification "Single unseeded image-level 70/30 split with no cross-validation, and metaheuristic tuning on an unidentified partition." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Internal consistency of results" ;
                            slr:justification "Testing-phase accuracy exceeds training-phase accuracy and is read as good generalisation; stated 50 epochs disagree with 25-epoch learning curves." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Grad-CAM++ is applied and a visual interpretation figure is shown, described as highlighting the most significant facial regions and improving model transparency. The description also calls this abnormality detection, which reframes model attention as pathology. No quantitative attribution is reported, no facial region is named as consistently salient across images, and no test establishes whether the highlighted regions correspond to anything anatomically meaningful rather than to image-provenance artefacts - the question the branch most needs answered and the one a saliency method is least able to settle on unlabelled web photographs." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-167" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No task or paradigm. Static photographs with no stimulus, interaction or session; the construct is facial morphology and expression." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-167" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Low. The compute environment, the four principal training hyperparameters, the class composition and the pipeline order are all given, which is more than several neighbours provide. Against that: the dataset is identified only by a reference number while the formal data statement denies that any dataset was analysed; no split procedure, partition counts or seed appear; the wavelet basis and network topology are unspecified; the chimp optimiser has no stated objective, search space or budget; no code is released; and the epoch count in the text contradicts the epoch axis of the learning curves." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-167" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. Labels are the folder assignments of a public image corpus, with no clinical diagnosis, instrument, criterion, assessor or date for any image, and no description of how the collection was assembled. The introduction gives a conventional account of ASD as requiring thorough clinical testing and then treats folder labels as sufficient ground truth for a system offered as a diagnostic aid in clinical settings." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-167" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Multimedia Tools and Applications 85:300 (Springer), 218 days with a revision round. A multimedia and computing venue. Review did not surface an ethics declaration stating that no human participants were involved in a study of 2,940 children's photographs, a data-availability statement denying that any dataset was analysed, a test accuracy above training accuracy read as good generalisation, or the mismatch between the stated 50 epochs and the 25-epoch learning curves." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-167" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No modality fusion - a single image source. The paper's fusion is across three ImageNet backbones (VGG16, DenseNet-121, XceptionNet) applied to the same photograph, which is representational concatenation rather than multimodality, and no ablation isolates any backbone's contribution." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-167" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Autism Spectrum Disorder; Facial Images; Wavelet Neural Network; Deep Learning; Chimp Optimisation Algorithm. Three of five terms name pipeline machinery; validation, participants and setting are absent." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-167" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No participants. 2,940 images in two balanced classes of 1,470 - the sixteenth charted reuse of the public autism facial-image corpus, identifiable from that exact composition although the paper names only a reference number rather than a repository. The number of distinct children is unknown and never discussed. Results are reported for a 70% training partition and a 30% testing partition with no counts, no seed and no statement of how the split was drawn." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-167" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A four-stage pipeline: Gaussian Gabor filtering, concatenated features from three pretrained CNNs, a wavelet neural network classifier, and chimp-optimisation parameter tuning, with Grad-CAM++ appended for visualisation. Each stage is named as a contribution and none is ablated, so the reader cannot tell whether the Gabor stage, the three-way fusion, the wavelet classifier or the metaheuristic contributes anything to the reported figure." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-167" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "ASD, autism spectrum disorder, individuals with ASD, children with ASD. The register is medical and dated - ASD is introduced as a complex psychological disease and later as a critical neurodevelopmental condition with excessive medical expenses - and the symptom list includes repetitive and aggressive behaviours, hyperactivity, and cognitive impairment. Grad-CAM++ is described as providing abnormality detection, which frames the highlighted facial regions as abnormalities rather than as model attention. No autistic or community perspective appears." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-167" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Assessment on demographically different and stable datasets to evaluate fairness and generalisability - proportionate to the stated limitation and the only future direction offered." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-167" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No acquisition instrumentation. Compute fully specified (Python 3.6.5, i5-8600K, 16 GB RAM, GTX 1050 Ti 4 GB, 250 GB SSD, 1 TB HDD). Training settings: ReLU, learning rate 0.01, dropout 0.5, 50 epochs, batch size 5 - though the accuracy and loss curves are described over 25 epochs, which does not match." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-167" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2026. Framing is diagnostic-aid: the technique is offered as a promising diagnostic aid in clinical settings for the early and non-invasive detection of autism, and the stated research gap is a computationally efficient, privacy-preserving and accurately optimised framework - with no privacy mechanism described and no runtime measured. The contribution is expressed as a position above seven quoted figures. Its one substantive merit within the branch is its limitation paragraph, which states plainly that the dataset's lack of demographic information prevents any assessment of how facial morphology and expression vary across populations, and commits future work to demographically diverse data - the clearest statement of the branch's central problem made by any of its sixteen members, sitting alongside declarations asserting that the study used no data and involved no human participants." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-167" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. No cognitive, adaptive, language or severity measure; none obtainable from photographs." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-167" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The stated goal is a computationally efficient, privacy-preserving and optimised framework for ASD detection from facial images, combining Gaussian Gabor filtering, fused deep features from VGG16, DenseNet-121 and XceptionNet, a wavelet neural network classifier tuned by the chimp optimisation algorithm, and Grad-CAM++ for visual interpretation. Headline findings: average accuracy 98.42% with precision 98.40%, recall 98.42%, F-measure 98.41% and AUC 98.42% in the 30% testing phase, against quoted comparators from 92.10% to 97.76%." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-167" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. No behaviour is observed or measured. The targets are static facial features enhanced by Gabor filtering, with the paper referring to facial cues relevant to ASD and to expression patterns and facial morphology without identifying any specific feature." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-167" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None reported, and the paper is one of the few in this branch to say so and to explain why it matters: expression patterns and facial morphology differ across demographic factors, and because the dataset carries no such information, their influence on ASD classification and on facial-feature learning cannot be clearly examined. That is an accurate statement of the branch's central data problem, made by a study that then proceeds anyway." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-167" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The evaluation rests on a single image-level partition of 2,940 photographs into 70% training and 30% testing, with no cross-validation, no repetition, no seed and no statement of how the split was drawn. The corpus repeats individuals, so an image-level split does not separate children, and the number of distinct children is unknown - the same defect documented across the other fifteen members of this branch. Two further features are specific to this paper. First, the accuracy inversion: the testing phase reports 98.42% against the training phase's 97.75%, and the learning curves show validation accuracy exceeding training accuracy, which the authors interpret as evidence of good generalisation. The more usual explanation on this corpus is that the partitions are not independent. Second, the chimp optimisation algorithm tuned the classifier's parameters against an unstated objective on an unstated partition, so the reported test figure may be the outcome of a search evaluated on the data it is then reported against. On top of this, the comparison against seven quoted literature figures (92.10% to 97.76%) is drawn from other papers under unknown protocols, and no component of the four-stage pipeline is ablated." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-167" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Accuracy, precision, recall, F-measure and AUC, per class and averaged, for both phases, with confusion matrices, precision-recall and ROC curves. The reporting is dense and contains one telling relationship: the 30% testing-phase average accuracy (98.42%) is higher than the 70% training-phase average accuracy (97.75%), and the per-class figures move in the same direction. A model that performs better on held-out data than on the data it was fitted to is normally a signal that the partition is not independent - shared or near-duplicate images across the split being the usual cause on this corpus - or that the reported training figure is not a resubstitution score. The paper reads the same inversion in its learning curves as good generalisation without overfitting. No confidence interval, no chance level and no variance across runs accompanies any value." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-167" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Gabor-filtered facial images encoded as a concatenation of three backbone feature vectors. Neither the input resolution, the fused vector dimensionality, nor the wavelet basis is stated." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-167" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No setting. A downloaded dataset analysed in Python 3.6.5 on a desktop with an i5-8600K, 16 GB RAM and a GeForce GTX 1050 Ti - a configuration reported in unusual detail for a study whose stated contribution includes computational efficiency, though no runtime or inference-time measurement accompanies it." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-167" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional. The ethics declaration is factually wrong rather than merely permissive: this article does not contain any studies with human participants performed by any of the authors, stated for an analysis of 2,940 photographs of children, with consent to participate and consent to publish both marked not applicable. It is paired with a data-availability statement asserting that no datasets were generated or analysed during the current study, in an article whose results section reports a full metric grid computed on a 2,940-image dataset. Together the two declarations describe a paper that did not use any data, which is the opposite of what the article reports. The framing also claims the framework is privacy-preserving, with no privacy mechanism of any kind described." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-167" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "One stated limitation, and it is the right one: the dataset lacks demographic information, expression patterns and facial morphology vary across demographic factors, and their influence on classification and feature learning therefore cannot be examined - with future work directed at demographically different datasets to assess fairness and generalisability. Within the facial-image branch this is the clearest statement of the problem that undermines all sixteen of its members. What is not stated: that the labels have no diagnostic basis, that the split is at the image level on a corpus that repeats individuals, that the testing-phase accuracy exceeds the training-phase accuracy, that the epoch counts disagree, and that the ethics and data-availability declarations contradict the article's own contents." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-167" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "Literature-quoted figures for CONCAT-SDAE, ViT-B, EfficientNet-B4, VGG-19, GBM, random forest and KNN, none re-run by the authors." ;
                    slr:study_design "Retrospective secondary analysis of a public facial-image dataset; a multi-stage pipeline (Gabor filtering, three-backbone deep feature fusion, wavelet neural network classifier, m…" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: 1,470 autistic; comparison: 1,470 non-autistic" ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "Testing phase (30%): average accuracy 98.42%, precision 98.40%, recall 98.42%, F-measure 98.41%, AUC 98.42%; per class, autistic accuracy 98.02%. Training phase (70%): average accuracy 97.75%, precision 97.80%, recall 97.75%, F-measure 97.76%, AUC 97.75%; per class, autistic 96.56% and non-autistic 98.94%. Quoted comparators range from 92.10% to 97.76% on precision." ;
                    slr:outcome "Accuracy, precision, recall, F-measure and AUC, per class and averaged, for both the training and testing phases; confusion matrices; precision-recall and ROC curves; and training/validation accuracy and loss curves." ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "Testing phase (30%): average accuracy 98.42%, precision 98.40%, recall 98.42%, F-measure 98.41%, AUC 98.42%; per class, autistic accuracy 98.02%. Training phase (70%): average accuracy 97.75%, precision 97.80%, recall 97.75%, F-measure 97.76%, AUC 97.75%; per class, autistic 96.56% and non-autistic 98.94%. Quoted comparators range from 92.10% to 97.76% on precision." ] ] ;
