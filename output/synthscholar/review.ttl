            slr:decision_rationale "A machine-learning approach fusing eye-fixation and facial-expression behavioural data with EEG to classify 40 autistic and 40 typically developing children, reporting 87.50% accuracy for the fused model." ;
            slr:screening_stage "title_abstract" ],
        [ a prov:Activity,
                slr:ScreeningDecisionRecord ;
            dcterms:title "Extraction and Classification of Acoustic Features from Italian Speaking Children with Autism Spectrum Disorders." ;
            bibo:pmid "local_afdb603d" ;
            slr:assessed_on "full_text" ;
            slr:decision "include" ;
            slr:decision_rationale "Full text confirms supervised binary classification of autism from 16 statistically selected acoustic parameters in 14 autistic and 14 typically developing Italian children, using decision trees, K-nearest neighbours, random forests and support vector machines with accuracy, recall, precision, F1 and AUC reported on training and test splits." ;
