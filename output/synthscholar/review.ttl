            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "Groups matched on age, gender, handedness and IQ with all comparisons tested within both samples, but recruitment route is not described, the samples differ substantially in sex composition, and both are high-IQ (means 122-126) adults." ],
                [ a slr:RoBDomainJudgment ;
