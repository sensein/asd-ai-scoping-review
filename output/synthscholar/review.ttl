    slr:journal "2021 2nd International Conference on Robotics, Electrical and Sign" ;
    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Participant characteristics are inherited at second hand with only whole-sample age range and sex split reported, no group-wise demographics, no matching discussion, and cluster composition never disclosed." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Ten-fold cross-validation over 547 images from 59 children with no statement that a child's images were kept together, on a dataset where the originating study demonstrated a 19-point inflation from image-level splitting; k-means clustering was additionally fitted on the full image set including test images." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Image and participant counts are given but cluster sizes, cluster class balance and the mapping between children and clusters are all unreported, so no flow through the analysis can be traced." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Diagnosis is conveyed only as CARS severity classification by psychologists, omitting the ADI-R and ADOS-G confirmation reported in the source study, and non-autistic status is not described at all." ] ;
            slr:overall_judgment "high" ;
            slr:tool_used "QUADAS-2" ] .

<https://doi.org/10.1109/TNSRE.2020.2991675> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "The purpose of this study is to test whether visual processing differences between adults with and without high-functioning autism captured through eye tracking can be used to detect autism. We record the eye movements of adult participants with and without autism while they look for information within web pages. We then use the recorded eye-tracking data to train machine learning classiﬁers to detect the condition. The data was collected as part of two separate studies involving a total of 71 unique participants (31 with autism and 40 control), which enabled the evaluation of the approach on two separate groups of participants, using different stimuli and tasks. We explore the effects of a number of gaze-based and other variables, showing that autism can be detected automatically with around 74% accuracy. These results conﬁrm that eye-tracking data can be used for the automatic detection of high-functioning autism in adults and that visual processing differences between the two groups exist when processing web pages." ;
    dcterms:bibliographicCitation "Yaneva V; Ha LA; Eraslan S; Yesilada Y; Mitkov R (2020). Detecting High-Functioning Autism in Adults Using Eye Tracking and Machine Learning. *IEEE Transactions on Neural Systems and Rehabilitation Engineering, 28(6), 1254-1261*. https://doi.org/10.1109/TNSRE.2020.2991675" ;
    dcterms:creator "Eraslan S",
        "Ha LA",
        "Mitkov R",
        "Yaneva V",
        "Yesilada Y" ;
    dcterms:title "Detecting High-Functioning Autism in Adults Using Eye Tracking and Machine Learning" ;
    bibo:doi "10.1109/TNSRE.2020.2991675" ;
    bibo:pmid "local_95abe653" ;
    fabio:hasPublicationYear 2020 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is control status positively screened?" ;
                            slr:justification "All controls completed the AQ-50 and one was excluded for a high score." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the sample appropriate and adequate for the stated target?" ;
                            slr:justification "68 adults is small for validation, as the authors state, though comparable to the fMRI literature they benchmark against." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are participants and recruitment adequately described?" ;
                            slr:justification "Recruitment routes, inclusion and exclusion criteria, every exclusion with its reason, cross-study overlap, employment, housing and education all reported." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are comparison groups matched on the variables that matter?" ;
                            slr:justification "Education is visibly higher in the control group and unadjusted, on tasks that are fundamentally reading and information search." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "some concerns" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the behavioral data acquisition described reproducibly?" ;
                            slr:justification "Tracker model, sampling rate, accuracy, eye recorded, viewing distance, calibration, monitors, fixation algorithm, time limits and task wording all specified, with stimuli deposited." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the reference standard appropriate and independently applied?" ;
                            slr:justification "Formal diagnosis documented by the recruiting services, all meeting ADOS criteria." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is a confound separated from the effect by design?" ;
                            slr:justification "Capping browse time at 30 s in Study 2 isolates scanning strategy from time spent, and the signal survives." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are predictors defined without knowledge of outcome?" ;
                            slr:justification "Gaze features are computed automatically; AOIs are defined algorithmically by VIPS or as fixed grids." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "low" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the validation split at the participant level?" ;
                            slr:justification "Held-out participants throughout, with per-participant decisions by majority vote over their AOI-level predictions." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are negative results reported?" ;
                            slr:justification "Task complexity, visual complexity, gender, AOI ID and Media ID all reported as unhelpful or harmful." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Does the finding replicate on independent data?" ;
                            slr:justification "Two independent collections with different participants, pages and tasks confirm the main effects, but no externally collected dataset was available." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is model and configuration selection separated from performance estimation?" ;
                            slr:justification "Task, AOI definition, feature set, split ratio and page subset were all chosen on the same 100 splits that produce the reported means." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is performance estimated over repeated splits with uncertainty?" ;
                            slr:justification "100 random splits with 95% confidence intervals for every configuration." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are metrics adequate for the proposed screening use?" ;
                            slr:justification "Only accuracy is reported in the paper; sensitivity and specificity, which determine screening utility, are left to deposited confusion matrices." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "some concerns" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the dataset accessible or its access conditions stated?" ;
                            slr:justification "Eye-tracking data, materials and screenshots deposited in a public repository, with data release stated as an objective of the paper." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the intended use scoped honestly?" ;
                            slr:justification "Explicitly positioned as a screening and referral aid, not a substitute for clinical diagnosis." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are ethics and consent reported?" ;
                            slr:justification "Prior approval from the University of Wolverhampton Ethics Committee, signed consent, debriefing, and ethics named as an open question for future naturalistic recording." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the field's methodology critiqued?" ;
                            slr:justification "Prior EEG and speech results are named as potentially overoptimistic for assigning segments from the same participant to both training and testing." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is code available?" ;
                            slr:justification "Code deposited in the same repository alongside alternative-classifier comparisons and full per-configuration results." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "low" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Develop a serious game that captures visual processing differences without a dedicated eye tracker; move to behavioural data collected in natural environments; test whether aggregating more simple Search tasks beats designing more complex ones, since complexity did not help; and apply the approach to other conditions with atypical attention patterns - dementia, schizophrenia, ADHD. The authors frame three prerequisites: what makes a good discriminating task, how to record outside the laboratory, and how to do so ethically." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-043" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Documented formal diagnosis rather than self-report: autistic participants were recruited through a UK autism charity and a university Enabling Centre, both of which require a copy of the formal diagnosis for service access, and all met ADOS diagnostic criteria. Pre-2013 diagnoses of High-Functioning Autism or Asperger's syndrome were accepted, appropriately for an adult cohort. The control group is the more distinctive part: all completed the 50-item Autism Quotient and one was excluded for a high score, so control status is positively screened rather than assumed - a step almost no other study in this corpus takes." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-043" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Group sizes and exclusions are fully itemised, and functional and educational characteristics are reported in unusual detail: all participants were highly independent adults with no caregiver; 20 autistic participants were employed or in higher education and 8 lived independently on disability benefits; among the autistic group 8 had completed high school, 8 held bachelor's and 3 master's degrees, against 3, 10 and 5 plus one PhD in the control group. All but one participant used the web daily. Ages and sex distributions were tabulated in Table I but that table did not survive extraction. The visible education imbalance favouring controls is not adjusted for, and matters for tasks that are fundamentally reading and information-search tasks. Ethnicity and socioeconomic status are not reported; recruitment was from Wolverhampton and Birmingham." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-043" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No model-explanation method, but extensive experimental interpretation through ablation and design manipulation. The two substantive interpretive results come from controlled comparisons rather than from the model: capping browse time at 30 seconds isolates strategy from duration and shows the groups differ in how they scan, not just how long; and the AOI comparison separates the contribution of page structure from that of spatial granularity. The tentative behavioural reading offered - that autistic adults may scan elements in a different order or be drawn more to images than to text - is explicitly flagged as requiring further analysis rather than asserted from the classifier." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-043" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional; one session per participant per study, with nine participants contributing to both. Data are gaze coordinates plus demographic questionnaire responses. Governance is properly reported - prior ethics committee approval, signed consent forms, debriefing - and the authors go further than compliance by naming ethics as an open research question for any future move to naturalistic recording." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-043" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two groups across two independent collections: 71 adults recruited, 68 retained (28 autistic, 32 control), with 15 per group analysed in Study 1 and 19 per group in Study 2, and 9 participants (6 autistic, 3 control) taking part in both. Exclusions are itemised: in Study 1, three autistic and two control participants for calibration and head-movement problems plus one randomly chosen control to rebalance classes; in Study 2, five controls - one for a high AQ score, three for reported school dyslexia referrals and two for calibration. Adults with high-functioning autism are a substantially under-represented population in this corpus, which is dominated by preschool and school-age children." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-043" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2020. The framing is unusual in taking the measure of its own field before contributing to it. It positions resting-state fMRI as the state of the art for adult autism detection from behavioural data, quoting 79-86% under leave-one-out and 71-83% on unseen data, and notes the practical objection that fMRI is expensive, obtrusive and unsuitable for pregnant women or people with sensory issues, metal implants, claustrophobia or head trauma. It then singles out the EEG (94%) and speech (93%) results as 'potentially overoptimistic' for segment-level splitting, and observes of a comparable child eye-tracking study reporting 85.1% that there was 'no note on how the data was split'. Against that background it positions its own 74-75% as comparable to fMRI at far lower cost, and frames the adult high-functioning population as the underserved case: symptoms are less obvious, lifelong coping strategies mask presentation, and 'unlike for children, critical incidents with adults are not monitored by school staff or parents'." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-043" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No multimodal fusion. Gaze only, with non-gaze metadata (AOI identity, media identity, correct-answer indicator, page visual complexity, participant gender) tested as additional variables and found in almost every case to reduce accuracy. That systematic negative result is itself the paper's fusion finding: on this data, adding non-gaze information hurt." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-043" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A quiet room at the University of Wolverhampton with only researcher and participant present. Autistic participants recruited through a UK autism charity and the university's Enabling Centre; controls by snowball sampling in the Birmingham area. Ethical approval obtained from the University of Wolverhampton Ethics Committee before collection began." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-043" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Goal: test whether gaze during ordinary web-page use detects high-functioning autism in adults, and whether the effect holds across independent participants, stimuli and tasks. Main findings: all four tasks produced a discrimination signal, with best accuracies of 0.75 (Search), 0.74 (Browse, 120 s), 0.73 (Synthesis) and 0.65 (Browse, 30 s); capping browse time showed the groups differ in browsing strategy and not only in time spent; increased task complexity did not increase separability; AOI content and granularity both affect accuracy, with the 2 x 2 grid consistently worst; and page visual complexity and participant gender contribute nothing." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-043" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The best in the corpus. Data, code, materials, page screenshots, task questions, confusion matrices, comparisons against other classifiers, and full results for every data split and page configuration are all deposited at a public repository, and releasing data is stated as an explicit objective of the paper. Apparatus, calibration, viewing distance, fixation algorithm, AOI construction and split procedure are all specified in the text, and results carry 95% confidence intervals. The one gap in the paper itself is that Tables I and II - demographics and the feature list - are the two most reference-critical tables and neither survived text extraction here, though both are presumably in the deposited materials." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-043" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Logistic regression, chosen after testing a set of standard classification algorithms in R with the comparison deposited publicly. A deliberately simple model, appropriate at 30-38 participants, and consistent with the paper's emphasis on characterising the signal and the data representation rather than on architecture. The experimental variables are the task, the AOI definition and the feature set, not the learner." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-043" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "IEEE Transactions on Neural Systems and Rehabilitation Engineering, 28(6), 1254-1261 - an engineering journal with a rehabilitation and assistive-technology orientation, consistent with the authors' backgrounds in language processing and web accessibility rather than clinical psychiatry." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-043" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Intellectual disability and reading disorder were formal exclusions, and three control participants were excluded for school dyslexia referrals, so reading ability is controlled at the eligibility level for a task that depends on reading. Vision not correctable by glasses or lenses was also excluded. No IQ, AQ score (for the autistic group), symptom severity or adaptive functioning measure is reported; functional level is characterised by employment, housing and education instead, which is arguably more informative for an adult cohort though not comparable across studies." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-043" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Gazepoint GP3 at 60 Hz with 0.5-1 degree accuracy, right eye, roughly 65 cm with sensor-controlled distance and nine-point calibration; 19-inch and 17-inch LCD monitors; Gazepoint's position-variance fixation algorithm; extended VIPS for page segmentation into hierarchical elements, using the fifth level (or deeper where a task could be completed by fixating a single element); ViCRAM for visual complexity; R for classification. The eye tracker is deliberately a low-cost consumer-grade device, consistent with the paper's argument that gaze hardware is already commodity technology." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-043" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Index terms: autism, eye tracking, web, screening, diagnostic classification, detection. 'Screening' rather than 'diagnosis' is the operative word and the paper is careful about it - the method 'is not intended to substitute clinical diagnostic procedures where these are available. Rather, its purpose is to be used to identify autistic traits at a wider level and to provide the means to refer for further assessment those people who might be at risk.' That framing is rare in this corpus and materially changes what the accuracy figures need to support." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-043" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Visual attention during naturalistic information-seeking - fixation behaviour across web-page regions during free browsing, targeted search and inferential synthesis. This is a distinctive behavioural target for the corpus: not social attention to faces or eyes, but general visual-information-processing strategy on non-social stimuli. The paper argues this is a feature rather than a limitation, since 'atypical visual-attention patterns reflect higher-order differences in information processing', and it sidesteps the dependence on social stimuli that characterises most gaze work here." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-043" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Real web pages under three task types drawn from a published hierarchy of information needs - browse (no goal), search (locate one element), synthesis (locate two elements and infer a third). Study 1 used six pages spanning low, medium and high visual complexity; Study 2 selected eight from the Alexa top 100 after removing duplicates, non-English pages, search engines and pages requiring authentication, then scoring visual complexity with the ViCRAM tool and randomly selecting four low- and four high-complexity home pages. The rationale for web pages is ecological: they offer mixed textual and visual stimuli organised for a semantic purpose, permitting multiple search strategies, and browsing is 'a highly familiar and naturalistic task' whose data could in principle be captured without laboratory equipment. Time limits were manipulated deliberately across studies to separate strategy differences from duration differences." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-043" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Participant-level splitting throughout, repeated 100 times, with per-participant classification by majority vote over that participant's AOI-level predictions - and the choice is argued for explicitly against the segment-level splitting the authors identify in prior EEG and speech work. Cross-study replication with different participants, stimuli and tasks provides a form of generalisation evidence stronger than repeated splitting alone. Two gaps remain. There is no external validation on independently collected data, which the authors address directly: it 'is currently not feasible for our approach due to the task-specific nature of the data, and the unavailability of comparable data collected independently' - an honest statement of a real constraint, and part of why they released their own data. And configuration selection sits outside the validation loop: task, AOI definition, feature set, split ratio and page subset were all chosen by their performance on the same 100 splits." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-043" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "'adults with and without high-functioning autism', 'participants with autism', 'people on the spectrum', 'people with ASD', 'neurotypical people', 'control group'. Mixed person-first and 'people on the spectrum'; 'neurotypical' rather than 'normal' or 'healthy'. The framing is notable for treating heterogeneity as definitional - 'the term spectrum is used to signify the different types and levels of support that different individuals might need' - and for locating the diagnostic problem in the procedure rather than the person: current diagnosis is 'a highly subjective assessment process' restricted to 'behavioural, historical, and parent-report information' that 'leads to a lack of consistency and reliability'." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-043" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Mean accuracy over 100 random participant-level splits with 95% confidence intervals, reported for every one of the 12 task-by-AOI configurations and for individual pages and page combinations. Confidence intervals are used substantively - the authors read them as showing 'the models are robust in their predictions'. Confusion matrices exist but are deposited rather than printed, and no sensitivity, specificity, precision, recall, F1 or AUC appears in the paper. For a screening application where the cost of false negatives and false positives differ, this omission matters more than for a purely comparative study." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-043" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "AOI-level gaze feature vectors: one row per AOI per page per participant, under three AOI definitions - VIPS page-specific elements at the fifth hierarchical level, a 2 x 2 grid, and a 4 x 4 grid. The AOI comparison is the paper's most transferable methodological result. Page-specific AOIs suit Search tasks, where areas have differing task relevance; grid AOIs lose less for Browse tasks, where all elements are equally relevant; the coarse 2 x 2 grid is always worst; and the finer page-specific segmentation in Study 2 (26.6 AOIs per page against 18.6 in Study 1) may have added noise rather than information, since the 4 x 4 grid outperformed it for Synthesis. The authors conclude there is 'a trade-off between having sufficiently detailed AOIs and not introducing too much noise' and that the optimal number 'is best defined empirically'. Grid AOIs have the additional property that no fixation is lost." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-043" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Acknowledged: that web-searching tasks are unsuitable for very young children; that the sample is small, 'comparable with those of state-of-the-art fMRI studies for autism detection but smaller than the number needed for large validation studies'; that the design cannot explain why some pages discriminate better than others, nor why the harder Synthesis task did not outperform Search; that testing on independently collected data is not currently feasible because the data are task-specific and no comparable independent dataset exists; and, in a footnote, that the better accuracy under the longer browse limit might reflect the different pages and participants rather than the time limit itself. Identifiable in review but not acknowledged: the headline accuracies are maxima over a large configuration space - task, AOI definition, feature set, split ratio and every page subset - selected on the same 100 splits that produce the reported means, so the confidence intervals describe split variability but not selection uncertainty; and the control group's visibly higher educational attainment is left unadjusted in tasks that are fundamentally reading and search tasks." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-043" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "One session per participant per study; 6 web pages in Study 1 and 8 in Study 2, each viewed under two tasks presented in counterbalanced order. Time limits: 120 s per page for Browse 1 and for the Syn" ;
                    slr:study_design "Two independent case-control classification studies with different participants, web pages and tasks, analysed jointly and compared" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Independent adults with high-functioning autism" ;
                    slr:sample_size_text "ASD/index: 28 unique autistic participants retained (15 analysed in Study 1, 19 in Study 2, with 6 taking part in both); comparison: 32 unique control participants retained (15 analysed in Study 1, 19-20 in Study 2, with 3 taking part in both)" ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "Best accuracies by task: Search 0.75 (Apple + Babylon pages), Browse 1 with the 120 s limit 0.74 (Apple + AVG), Synthesis 0.73 (Amazon + Outlook), and Browse 2 with the 30 s limit 0.65 (Outlook). AOI effects: for Browse 1, page-specific and 4 x 4 grid AOIs both gave 0.71 against 0.66 for the 2 x 2 grid; for Browse 2, page-specific 0.65 against 0.60 and 0.61 for the two grids. Every headline figure",
                        "Gaze recorded while adults look at ordinary web pages discriminates high-functioning autism from control at around 74-75% accuracy, and the effect replicates across two collections with different participants, different web pages and different tasks - the paper's central claim being consistency rather than peak accuracy. Capping browsing time at 30 seconds showed that the signal is not merely that" ;
                    slr:outcome "Mean classification accuracy over 100 random splits with 95% confidence intervals, reported for all 12 task-by-AOI configurations and for individual pages and page combinations. Confusion matrices are deposited in the repository rather than printed. No sensitivity, specificity, precision, recall, F1" ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "Best accuracies by task: Search 0.75 (Apple + Babylon pages), Browse 1 with the 120 s limit 0.74 (Apple + AVG), Synthesis 0.73 (Amazon + Outlook), and Browse 2 with the 30 s limit 0.65 (Outlook). AOI effects: for Browse 1, page-specific and 4 x 4 grid AOIs both gave 0.71 against 0.66 for the 2 x 2 grid; for Browse 2, page-specific 0.65 against 0.60 and 0.61 for the two grids. Every headline figure; Gaze recorded while adults look at ordinary web pages discriminates high-functioning autism from control at around 74-75% accuracy, and the effect replicates across two collections with different participants, different web pages and different tasks - the paper's central claim being consistency rather than peak accuracy. Capping browsing time at 30 seconds showed that the signal is not merely that" ] ] ;
