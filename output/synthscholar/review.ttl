    slr:journal "Sādhanā, 51(1), Article 30" ;
    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "The reference standard is a folder name. No clinical diagnosis, instrument, criterion or assessor exists for any image, and the paper does not acknowledge this." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "The index test is described as 3D landmark localisation but operates on 2D photographs with a 2D landmark detector; a millimetre-scale localisation error is reported that the data cannot support. No prespecified threshold, no ablation, and reported metrics are the maximum of an epoch sweep." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "The headline evaluation uses 200 images selected from the 506-image test set by an unstated rule, while the reported confusion matrix totals 300 cases. The metrics computable from the confusion matrix (accuracy 0.957, precision 0.940, recall 0.972) contradict the reported values, and the F1 of 0.925 is inconsistent with the reported precision and recall." ],
                [ a slr:RoBDomainJudgment ;
