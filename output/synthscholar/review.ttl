<https://doi.org/10.1007/s10803-021-05179-2> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Our study investigated the feasibility of using head movement features to identify individuals with autism spectrum disorder (ASD). Children with ASD and typical development (TD) were required to answer ten yes–no questions, and they were encouraged to nod/shake head while doing so. The head rotation range (RR) and the amount of rotation per minute (ARPM) in the pitch (head nodding direction), yaw (head shaking direction) and roll (lateral head inclination) directions were computed, and further fed into machine learning classifiers as the input features. The maximum classification accuracy of 92.11% was achieved with the decision tree classifier with two features (i.e., RR_Pitch and ARPM_Yaw). Our study suggests that head movement dynamics contain objective biomarkers that could identify ASD." ;
    dcterms:bibliographicCitation "Zhao Z; Zhu Z; Zhang X; Tang H; Xing J; Hu X; Lu J; Qu X (2021). Identifying Autism with Head Movement Features by Implementing Machine Learning Algorithms. *Journal of Autism and Developmental Disord*. https://doi.org/10.1007/s10803-021-05179-2" ;
    dcterms:creator "Hu X",
        "Lu J",
        "Qu X",
        "Tang H",
        "Xing J",
        "Zhang X",
        "Zhao Z",
        "Zhu Z" ;
    dcterms:title "Identifying Autism with Head Movement Features by Implementing Machine Learning Algorithms" ;
    bibo:doi "10.1007/s10803-021-05179-2" ;
    bibo:pmid "local_d8e804d6" ;
    fabio:hasPublicationYear 2021 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are participants and recruitment adequately described?" ;
                            slr:justification "Full eligibility criteria, recruitment sources and exclusions given; group-wise ages, sexes and IQ are in a table that did not survive extraction." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the sample appropriate and adequate for the stated target?" ;
                            slr:justification "38 analysed children, acknowledged by the authors as small, with an age range well above the mean age at diagnosis." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are comparison groups matched on the variables that matter?" ;
                            slr:justification "Not matched on IQ per the companion study, but age and IQ are entered as random factors in the feature-discrimination models." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the comparison group screened for the broader phenotype?" ;
                            slr:justification "No autism or ADHD reported in first-degree relatives." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "some concerns" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is human coding independently verified?" ;
                            slr:justification "Two coders blind to purpose and group, with Spearman reliabilities of 0.787 for nodding and 0.895 for shaking." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the reference standard appropriate and independently applied?" ;
                            slr:justification "Licensed psychiatrist with five or more years of experience under DSM-IV, with Raven's IQ confirmation and exclusions." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are predictors defined without knowledge of outcome?" ;
                            slr:justification "Features are computed automatically from pose time series; all six were retained after significance screening so no selection occurred at that stage." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is differential measurement quality examined?" ;
                            slr:justification "OpenFace failed on 3.46% of autistic frames against 0.23% of typically developing frames - reported but not analysed." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the behavioral data acquisition described reproducibly?" ;
                            slr:justification "Seating distance, both cameras with rates and purposes, full question list, the instruction given, interviewer blinding, and the pose-tracking pipeline with published accuracy figures." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "low" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are covariates controlled in the group comparison?" ;
                            slr:justification "Mixed-effects models with age, IQ and all three gesture-frequency measures as random factors, tested by likelihood ratio." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are reported figures internally consistent?" ;
                            slr:justification "The abstract names RR_Pitch and ARPM_Yaw as the best pair while the results section names RR_Roll and ARPM_Yaw." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is uncertainty quantified?" ;
                            slr:justification "No confidence intervals; on 38 participants a single case is worth 2.6 accuracy points." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are all classifiers reported rather than only the winner?" ;
                            slr:justification "All five reported with accuracy, sensitivity, specificity, AUC and ROC curves." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is feature selection separated from performance estimation?" ;
                            slr:justification "All 63 feature subsets tested across five classifiers on the reporting leave-one-out estimate, deliberately, with the maximum quoted." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the validation split at the participant level?" ;
                            slr:justification "Leave-one-out with one participant held out per fold." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is a null result reported?" ;
                            slr:justification "No group difference in head nodding, shaking or non-use frequency, reported with medians and effect sizes and discussed at length." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are ethics and consent reported?" ;
                            slr:justification "Helsinki conformity, written caregiver consent and participant payment disclosed; no ethics committee approval or reference number." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the task design's own limitation identified?" ;
                            slr:justification "The authors state that instructing the gesture may explain the frequency null and that spontaneous contexts should be studied instead." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is code available?" ;
                            slr:justification "OpenFace and MATLAB named; no code and no classifier hyperparameters." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the measurement claim substantiated within the study?" ;
                            slr:justification "The claim that pose tracking detects what human coding cannot is demonstrated by the divergence between blind coder ratings and kinematic measures on the same behaviour." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the dataset accessible or its access conditions stated?" ;
                            slr:justification "No release or availability statement." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "some concerns" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Keywords: Autism, Biomarkers, Diagnosis, Head movement, Machine learning. 'Head movement' is the novel term and the paper's claim to priority - the authors state theirs is 'the first to use head movement related features to detect ASD'." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-064" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Accuracy, sensitivity, specificity and AUC for each classifier's best model, ROC curves for all five, and an accuracy-versus-feature-count plot. Reporting all five classifiers rather than only the winner allows the reader to see that the result is robust across model families. Missing: confusion matrices, confidence intervals and any statistical comparison between classifiers - on 38 participants one case is worth 2.6 accuracy points, so the spread from 81% to 92.11% is about four cases." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-064" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Goal: determine whether head movement dynamics discriminate autistic from typically developing children, and which kinematic features do so. Main findings: 92.11% accuracy with a decision tree on two features, with all five classifiers above 81% using three features or fewer; head nodding, shaking and non-use frequencies did not differ between groups; but rotation range and amount of rotation per minute were significantly greater in autistic children in all three rotational axes after adjusting for age, IQ and gesture frequency." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-064" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Ten yes-no questions with an explicit verbal instruction to nod or shake the head while answering, drawn from the third of four chronologically arranged conversational sessions. The instruction is what makes the study possible - it ensures the target behaviour occurs in every participant, so kinematics can be compared on matched gestures rather than confounded with whether the gesture happened. The authors recognise the cost and state it: prior findings of reduced head gesture use in autism may hold only in spontaneous contexts, so 'our task may not a good one to reveal an ASD vs. TD difference in terms of head nodding/shaking frequency', and future work should examine unintentional gesture use." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-064" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional; a single conversational session per child with no follow-up. Data are frontal and side video of identifiable children. Governance is partially reported - Helsinki conformity and written caregiver informed consent, with payment of 200 CNY disclosed - but no ethics committee approval or reference number is given." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-064" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two groups: 20 autistic children recruited from a local psychiatric hospital and 23 typically developing children from nearby communities, with five excluded for camera technical problems leaving 18 and 20. Participants are the same cohort as a companion study by the same group on conversational eye tracking, but the data come from a different conversational session - the yes-no question session rather than the full four-session conversation. No other-diagnosis comparison group. Participants were paid 200 CNY, which is disclosed." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-064" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two consumer cameras, a Samsung HMX-F90 at 25 Hz and a Logitech C270 at 30 Hz, with only the frontal Logitech feed used for head pose; OpenFace 2.0; MATLAB 2017b. The equipment argument is worth noting: the whole pipeline runs from an ordinary webcam and open-source software, which underpins the authors' claim that head pose tracking suits early screening because it is 'constraint-free' and requires no worn devices or task compliance." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-064" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Eligibility required ages 6-13 in both groups, at least average nonverbal intelligence (IQ 70 or above by Raven's Advanced Progressive Matrices) in the autistic group, and absence of physical or mental disorder plus no autism or ADHD in first-degree relatives for the comparison group. Group-wise ages, sexes and IQ appear in Table 1, which did not survive text extraction; the companion study on the same cohort reports mean ages of 99.6 and 108.8 months, sex ratios of 17:2 and 17:3, and a significant 15-point IQ difference favouring the comparison group. That IQ gap matters here too, and the study handles it better than most: age and IQ are both entered as random factors in the mixed-effects models used to establish which features discriminate, so the reported kinematic differences are adjusted for both. No ethnicity or socioeconomic data." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-064" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No multimodal fusion; a single modality analysed across three axes. What the design does combine is two measurement approaches to the same behaviour - human coding of whether gestures occurred and automated kinematic measurement of how they were executed - and the divergence between them is the paper's most valuable result. Blind human coders found no group difference in gesture frequency; automated tracking found significant differences in every kinematic measure. The authors generalise this appropriately: the 'human perceptual system is good at detecting specific patterns of movement (e.g., head nodding, smiling), but it is not good at giving precise metric measures of movement', so pose tracking has 'an advantage over behavioral coding techniques - finding motor patterns that might be difficult to spot through human observations'. That is a specific, testable claim about what automation adds, and it is demonstrated within a single study." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-064" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Journal of Autism and Developmental Disorders, 52, 3038-3049 - a specialist autism journal rather than an engineering venue, which is consistent with the paper's substantive engagement with the motor-atypicality literature and its careful covariate handling." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-064" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Larger and more behaviourally varied samples given autism's heterogeneity; investigation of unintentional rather than instructed head nodding and shaking, to test whether reduced gesture use appears only in spontaneous contexts; and extension to younger children, with the argument that constraint-free computer vision is particularly suited to early screening since data can be collected in natural settings without worn devices or task instructions." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-064" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Leave-one-out cross-validation at the participant level, correctly implemented and explicitly motivated as overfitting protection. The weakness is the search: the random feature combination approach deliberately tests every subset of the six features, and the authors justify it on the grounds that exhaustive search 'typically yields equal or higher classification accuracy simply owing to the fact that all features and feature combinations could be tested' - which is precisely the property that makes the resulting maximum optimistic. Sixty-three subsets across five classifiers gives 315 fits, all scored on the same leave-one-out estimate, with no outer loop and no held-out set. The mixed-effects feature screening also used all participants, though since all six features passed and all were retained, this contributed no additional selection. There is no independent cohort or external replication." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-064" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A laboratory dyadic setup at Shenzhen University with the child seated 80 cm from a 33-year-old female interviewer blinded to group membership and required to behave and speak identically across participants; autistic children recruited from a local psychiatric hospital, comparison children from nearby communities. Funded by seven Shenzhen and Guangdong municipal, medical-discipline and provincial programmes." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-064" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Five classifiers compared on identical features, each with a short rationale and stated weaknesses, including the acknowledgement that decision trees are 'prone to overfitting' and that random forest 'could well address the overfitting problem of the DT algorithm' - which makes it notable that the decision tree nonetheless produced the highest accuracy, a pattern consistent with the exhaustive search finding a favourable split on a small sample. Reporting that all five classifiers exceeded 81% with three features or fewer is more informative than the single maximum, since it shows the signal is not classifier-specific." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-064" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Head movement during conversational gesture, decomposed into three rotational axes - pitch for nodding, yaw for shaking, roll for lateral inclination - and characterised along two independent dimensions: extremity of rotation (range) and quantity of rotation per unit time. The behavioural target is therefore the manner of gesture execution rather than its occurrence, which is what allows the study to separate gesture use from gesture kinematics. Head gesture is also, unusually for this corpus, a communicative act rather than an incidental behaviour - nodding and shaking carry propositional content in a yes-no exchange." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-064" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Confirmed diagnosis by a licensed psychiatrist with at least five years of clinical experience following DSM-IV criteria, with nonverbal IQ screened by the psychiatrist and confirmed by Raven's Advanced Progressive Matrices, and ADHD and schizophrenia excluded. The companion study on the same cohort adds that diagnosis was further evaluated by a senior psychiatrist with escalation to two more on disagreement, and that ADOS and ADI-R were unavailable. Comparison children were screened for personal disorder and for first-degree relative diagnoses of autism or ADHD." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-064" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2021. The framing combines diagnostic delay with a specific argument for motor markers. On delay, it cites more than a year on average between initial screening and confirmed diagnosis in the United States, and a 35-country meta-analysis giving a mean diagnosis age of 60.48 months, falling to 43.18 months among children aged ten or under. On motor markers, it assembles evidence of atypical motor function in postural control, gait stability, arm movements and gross and fine motor control, and of delayed motor development in infancy that 'could subsequently contribute to the social impairments' - so motor features are argued to be developmentally upstream of the social criteria, not merely correlated with them. It then identifies head movement specifically as documented but unexploited, citing stereotyped head rolling, shaking and banging, greater head turning displacement and velocity when viewing social stimuli, and slower and less frequent head turning in response to name. Its closing claim is notably strong: 'the current diagnostic system of ASD, which are established on behavioral evaluation of social communication and restricted and repetitive behavior, would be greatly challenged' by combining features across neuroimaging, eye tracking, EEG and motion capture." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-064" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "'children with ASD', 'ASD children', 'individuals with ASD', 'children with typical development (TD)', 'the affected children'. Mixed person-first and abbreviated forms. The framing locates the diagnostic problem in procedure and capacity rather than in children: diagnostic accuracy 'might be negatively affected by factors such as caregivers' report bias and clinicians' insufficient experiences of detecting ASD', and 'the shortage in specialists and the lengthy examinations make the diagnostic procedure a time-consuming process'." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-064" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Acknowledged: the small sample, attributed to 'the great difficulty of recruiting a large sample of ASD participants and having them complete the motor tasks', with leave-one-out cross-validation and the small number of retained features offered as mitigation against overfitting; autism's heterogeneity requiring larger and more varied samples; and the age range of 6-13 being 'much older than the mean age at diagnosis', so the study 'could only be viewed as an initial examination of social head behaviors in an older sample to establish proof of concept'. The instructed-gesture confound is also raised directly as an explanation for the frequency null. Not acknowledged: the exhaustive search evaluated 63 feature subsets across five classifiers on the same leave-one-out estimate that is reported, so the headline is a maximum over 315 fits; the abstract and results disagree on which two features produced it; and OpenFace tracking failure was fifteen times higher in the autistic group (3.46% versus 0.23%), which is reported but never examined as a possible source of the group difference." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-064" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Nonverbal IQ via Raven's Advanced Progressive Matrices, used both as an inclusion criterion and, importantly, as a covariate in the feature-discrimination models. No autism severity measure, which the authors acknowledge in calling for future samples with 'different behavioral presentations'. No language or adaptive functioning measures." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-064" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Interpretability is strong because the features are physically meaningful angles and the mixed-effects analysis is conducted separately from the classification. Every feature is tested for group discrimination while controlling age, IQ and all three gesture-frequency measures as random factors, so the reported differences are adjusted rather than raw - a level of covariate control almost no other study in this corpus applies to its features. The resulting interpretation is concrete and clinically legible: autistic children move their heads through larger angles and accumulate more rotation per minute while making the same gestures with the same frequency. The blind human coding provides an independent check on the frequency null, with Spearman reliabilities of 0.787 for nodding and 0.895 for shaking." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-064" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Six features only - rotation range and amount of rotation per minute in each of pitch, yaw and roll. This is the most parsimonious representation in the corpus relative to sample size, and it is arrived at by design rather than by reduction: the two measures are chosen to separate the amplitude of movement from its quantity, and the per-minute normalisation explicitly corrects for participants taking different amounts of time. Spline interpolation is applied to smooth the raw series before computation. The small feature count is what makes exhaustive subset search feasible and also what limits overfitting risk." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-064" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Good. Reported: seating distance, both cameras with sampling rates and their distinct purposes, the full ten-question list in an appendix, the instruction given to participants, interviewer blinding and consistency requirement, OpenFace version with published per-axis accuracy figures and the rationale for choosing it, per-group tracking failure rates, spline interpolation for smoothing, the exact definitions and computation of both features including the velocity-integration procedure and the per-minute normalisation with its rationale, the blind double-coding of gesture occurrence with Spearman reliabilities, the mixed-effects model specification with all fixed and random terms and the likelihood ratio testing approach, the exhaustive feature-combination rationale, all five classifiers, and leave-one-out cross-validation. Missing: ethics approval number, group-wise demographics in the extracted text, classifier hyperparameters, and any data or code release." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-064" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "One yes-no question session per child within a longer conversation, comprising ten questions of variable duration" ;
                    slr:study_design "Cross-sectional case-control classification study using a single conversational session, drawn from a larger four-session protocol" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "School-age children with autism of at least average nonverbal intelligence" ;
                    slr:sample_size_text "ASD/index: 20 recruited, 18 analysed; comparison: 23 recruited, 20 analysed" ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "Decision tree best at 92.11% accuracy with two features, 88.9% sensitivity, 95% specificity and AUC 0.9167. All five classifiers exceeded 81% accuracy with no more than three features, and all produced AUC above 0.81. SVM reached its maximum with a single feature, decision tree with two, and LDA, random forest and ensemble with three",
                        "Head movement kinematics extracted by computer vision from a conversational task classified autistic from typically developing children at 92.11% accuracy using just two features, with all five classifiers exceeding 81% using three features or fewer. The substantive finding is a dissociation between what the gesture is and how it is executed: autistic children nodded and shook their heads just as " ;
                    slr:outcome "Accuracy, sensitivity, specificity and AUC for the best model of each classifier, plus ROC curves for all five and an accuracy-versus-feature-count plot" ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "Decision tree best at 92.11% accuracy with two features, 88.9% sensitivity, 95% specificity and AUC 0.9167. All five classifiers exceeded 81% accuracy with no more than three features, and all produced AUC above 0.81. SVM reached its maximum with a single feature, decision tree with two, and LDA, random forest and ensemble with three; Head movement kinematics extracted by computer vision from a conversational task classified autistic from typically developing children at 92.11% accuracy using just two features, with all five classifiers exceeding 81% using three features or fewer. The substantive finding is a dissociation between what the gesture is and how it is executed: autistic children nodded and shook their heads just as " ] ] ;
