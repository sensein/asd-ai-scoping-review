    slr:journal "Proceedings of the Cognitive Models and Artif" ;
    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Whole face crops from uncontrolled internet photographs, with pose, expression, illumination, resolution and compression all free to vary with the collection route. Three preprocessing configurations including greyscale and CLAHE do attenuate colour and illumination differences, which is more than most of this branch attempts." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "None exists. Labels are folder membership in a public collection; no diagnostic instrument, clinician judgement or record is cited for any image." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "No train-test split, cross-validation scheme or partitioning unit is stated anywhere, the number of distinct children is unreported, and augmentation by zoom and brightness is applied without stating whether it preceded splitting." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "A public Kaggle image assembly whose autistic class was harvested from autism-associated online sources, with the number of distinct children unreported and no age, sex, ancestry or clinical information for either class." ] ;
            slr:overall_judgment "high" ;
            slr:tool_used "QUADAS-2" ] .

<https://doi.org/10.18280/ts.410628> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Received: 12 April 2024 Revised: 7 August 2024 Accepted: 20 August 2024 Available online: 31 December 2024 Autism Spectrum Disorder (ASD) affects brain development, impacting socialization, communication, and creativity in children. Signs typically appear within the first three years, with many children struggling with language acquisition, affecting their learning abilities. Various treatments help manage behaviors, benefiting both children and their parents. The mechanisms by which visual information about facial expressions translates into emotional categories are not well understood. This study proposes a system-level explanation through predictive processing theory. An innovative method combining Fast Mask Recurrent Convolutional Neural Network (FMRCNN) and hybrid Weighed Quantum Particle Swarm Optimization (WQPSO) aims to improve recognition of abnormal facial movements in individuals with ASD. FMRCNN captures temporal relationships and extracts features from input data, while the fast mask mechanism enhances network speed and efficiency by focusing on relevant input regions. The proposed method leverages predictive processing to improve accuracy and efficiency in facial expression recognition. It can identify six emotions: anger, fear, joy, sadness, surprise, and disgust. Results show significant potential in supporting ASD-related challenges, achieving 99.8% accuracy, 99.8% precision, 100% recall, and 94% specificity, surpassing existing systems in ASD facial expression recognition." ;
    dcterms:bibliographicCitation "Devaraj VS; Periyathambi E (2024). Enhanced Autism Spectrum Disorder Facial Expression Recognition Using Hybrid Weighed. **. https://doi.org/10.18280/ts.410628" ;
    dcterms:creator "Devaraj VS",
        "Periyathambi E" ;
    dcterms:title "Enhanced Autism Spectrum Disorder Facial Expression Recognition Using Hybrid Weighed" ;
    bibo:doi "10.18280/ts.410628" ;
    bibo:pmid "local_893dfc22" ;
    fabio:hasPublicationYear 2024 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Handling of missing data and attrition" ;
                            slr:justification "The peak-frame selection rule for CK+ is stated explicitly and justified. No other exclusions or missingness are described, and class distributions are not reported." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Confounder control" ;
                            slr:justification "Not applicable to a multi-class emotion task with no clinical groups. Four brightness variants were evaluated, which is a reasonable illumination-robustness check." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Participant selection and spectrum representativeness" ;
                            slr:justification "No autistic participants at any point; adult volunteers producing instructed expressions, with no demographic reporting in this paper and a population decades older than the children the stated application concerns." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Comparison group adequacy" ;
                            slr:justification "No autism-versus-non-autism contrast exists. A passing reference to an 'ASD-FE dataset' appears once in the results with no description, citation, size or characterisation anywhere in the methods." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Reference standard quality" ;
                            slr:justification "Instructed posed emotion labels from two established affective-computing corpora - sound for the task performed." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Outcome measurement blinding" ;
                            slr:justification "Classification is fully automated with no human rater at inference." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Measurement standardisation" ;
                            slr:justification "Both corpora were collected under laboratory control, with KDEF geometrically standardised across all images - maximal standardisation, at the cost of representing none of the variation a deployed system would face." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Index test definition and prespecification" ;
                            slr:justification "The preprocessing chain and quaternion optimiser formulation are specified, but the optimiser's own control parameters and the network's hyperparameters are not, and the number of emotion classes is stated inconsistently in three places." ;
                            slr:rating "Unclear" ] ;
                    slr:overall_concern "unclear" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Preprocessing and feature selection nesting" ;
                            slr:justification "Preprocessing is uniform and described; the metaheuristic optimiser is the tuning mechanism and the partition on which its fitness was evaluated is not stated." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Performance estimation and chance level" ;
                            slr:justification "Accuracy 99.8% with 100% recall and 94% specificity across six classes, reported without confusion matrices, class-wise results, a definition of multi-class specificity, confidence intervals, a chance baseline or the number of runs behind the means." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Data splitting and leakage control" ;
                            slr:justification "No split, cross-validation scheme or partitioning unit is stated anywhere. CK+ supplies roughly 2.8 peak frames per individual and whether images of the same person span partitions is unknown." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Sample size adequacy for the modelling" ;
                            slr:justification "CK+ supplies 327 peak frames from 118 individuals; KDEF's size is not stated, so the total training and evaluation volume cannot be determined." ;
                            slr:rating "Unclear" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Completeness of methods reporting" ;
                            slr:justification "Corpora, peak-frame rule, preprocessing chain and quaternion algebra are reported; no validation scheme, split, class distribution, optimiser configuration, network hyperparameters or run count is given." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Acknowledgement of limitations" ;
                            slr:justification "No limitations section. The paper identifies in its introduction that staged emotions are easier to detect than spontaneous ones and that the field lacks spontaneous-stimulus work, without connecting either observation to its own design." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Data, code and protocol availability" ;
                            slr:justification "Both corpora are established public resources; no availability statement, no code, no preregistration." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Ethics, consent and conflicts" ;
                            slr:justification "No statements given; secondary analysis of two consented public corpora conventionally requires none, but funding and competing interests are also absent." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Reporting of results and uncertainty" ;
                            slr:justification "Four point estimates and significance tests against three baselines, with no confusion matrices, class-wise breakdowns, intervals, chance baseline, or statement of the units over which the t-tests were computed." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A hybrid of Weighted Quantum Particle Swarm Optimisation with a Fast Mask Recurrent Convolutional Neural Network. The optimiser's distinguishing feature is that it encodes the swarm in quaternion rather than Euclidean space, and the quaternion algebra is set out explicitly through Hamilton's relations, on the stated rationale that this concentrates the search on more productive regions. Comparison against CNN, linear SVM and k-nearest-neighbour baselines with significance tests is more than many papers in this branch offer. What is not reported is the optimiser's own configuration - population size, iteration count, inertia and weighting parameters - or the network's hyperparameters, so the mechanism credited with the improvement cannot be reproduced." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-117" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. A single static image modality throughout. The recurring references to encoding 'physiological signal characteristics' and 'physiological signal properties' in quaternion space describe the optimiser's original application domain rather than anything in this study, where no physiological signal is acquired." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-117" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. No attribution, saliency, feature-importance or error analysis is reported for the classifier. The quaternion formulation is presented in mathematical detail but is a search-space construct, not an explanation of what the network responds to, and the associated claim that it captures physiological signal properties has no referent in the data." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-117" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Accuracy 99.8%, precision 99.8%, recall 100% and specificity 94%, with t-values and p-values against three baselines at p < 0.01. Three problems. The combination is unusual for a balanced multi-class problem - perfect recall alongside 94% specificity - and no confusion matrix, per-class breakdown or definition of multi-class specificity is supplied to make it interpretable. No confidence intervals accompany any figure, and the number of runs behind the reported means is not stated, so the significance tests cannot be assessed. And no chance baseline is given, though six-way classification would place it near 17% under balance." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-117" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional secondary analysis with no longitudinal element. No ethics statement appears, which is conventional for secondary use of two established consented affective-computing corpora. Funding and competing interests are not stated in the retrieved text." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-117" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None is required by the task as executed, since no autism classification is attempted - the labels are posed emotion categories, which are a strong ground truth for emotion recognition and carry no information about autism. The consequence for this review is that the study cannot contribute evidence on any of the diagnostic questions. Its relevance is instead to the review's treatment of how autism framing attaches to work containing no autism data: a reader relying on the title, abstract, keywords and conclusion would record this as an autism study, and it is not one." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-117" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No study setting. Both corpora were collected under laboratory conditions by their original creators, with KDEF in particular geometrically standardised so that eyes and lips fall at fixed image coordinates across all images. That standardisation is the opposite of the conditions the paper's motivating application would face - an autistic child in spontaneous distress, filmed at whatever angle and distance the situation allows - and the mismatch is not discussed. The one robustness check reported, evaluation across four brightness variants of KDEF, addresses illumination but not pose, spontaneity, age or population." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-117" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No acquisition equipment. Preprocessing is described in reasonable detail - grayscale conversion, resizing to 120x110 for a Gabor filter stage and 100x100 for the convolutional network, intensity normalisation, histogram equalisation, face detection with realignment, and landmark or local binary pattern feature extraction. The two-resolution arrangement for the two processing stages is a specific and reproducible detail." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-117" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Keywords: hybrid WQPSO, FMRCNN, facial expression recognition, ASD, computational intelligence, healthcare. The inclusion of ASD in the keyword list, alongside an autism-framed title, ensures the paper is indexed and retrieved as autism research - which is how it entered this corpus - although it contains no autism data. That indexing effect is itself a finding for the review: searches for computational autism work will return studies of this kind, and their reported accuracies will enter informal impressions of the field's performance without ever having concerned autistic people." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-117" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Published December 2024 by a computer science and engineering group at R.M.D. Engineering College, Thiruvallur. For this review the study's value lies in what it illustrates rather than in what it measures, and two lessons carry into the synthesis. The first concerns the boundary between autism-framed and autism-evidenced work. Every framing element here - title, keywords, abstract, introduction, problem statement, conclusion - is written in terms of autistic people and the failure of conventional systems to read their faces, which is a real and under-addressed problem stated with some sympathy; and the entire experimental content is six-way emotion classification on posed expressions from non-autistic adult volunteers, evaluated at peak frames on a corpus whose images are geometrically standardised. A reader relying on title and abstract would record 99.8% as an autism result. The second concerns what such figures mean. The paper's own introduction notes that 'staged emotions are easier to detect than spontaneous ones' and that the field lacks work on spontaneous stimuli, which is precisely why 99.8% on peak-frame posed adult expressions is near the long-established ceiling for that benchmark and carries no implication for autistic children in spontaneous distress - the application the conclusion invokes. Another study charted in this review tests exactly that transfer and finds that affect models trained on neurotypical faces perform poorly on autistic children and improve materially only after fine-tuning on autistic data. Read together, the two studies make the point cleanly: the emotion-recognition benchmark is solved, the autism-relevant problem is not, and the two are frequently reported as though they were the same. Three further defects should be recorded: no validation scheme, split or partitioning unit is stated anywhere; the reported metrics (100% recall with 94% specificity across six classes) are presented without confusion matrices or class-wise results; and the number of emotion classes is given as six, seven and five in three different places." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-117" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Not applicable to a study with no clinical groups, and unreported for the corpora used. No age distribution, sex composition or ancestry is given for either KDEF or CK+, although both are documented in their originating publications. The one demographic fact that matters here is implicit and unremarked: both corpora consist of adult volunteers, while the paper's motivating application concerns autistic children, so the modelled population differs from the target population by several decades of facial development as well as by diagnosis." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-117" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The framing is entirely autism-focused and the content is not, which is the record's central observation. The introduction is written with some care about autistic experience: it notes that autistic people 'frequently struggle with self-regulation, emotional interpretation, and understanding and labeling others' emotions', and that 'these differences can lead to social withdrawal, especially when others react negatively to the atypical responses of individuals with ASD' - which locates part of the difficulty in other people's reactions rather than solely in the autistic person, a formulation better than most in this corpus. The conclusion likewise frames the goal as addressing 'the existing challenges faced by conventional facial expression recognition systems when applied to ASD populations, where nuanced facial cues may be misinterpreted or overlooked', which correctly identifies a technology failure rather than a personal deficit. Against this, autism is described as 'a neurological illness', and the phrase 'the minor changes and quirks typical of the facial movements' of autistic people is dismissive. No autistic person is reported as involved, and no autistic person's face appears in the data." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-117" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None stated. The directions the study most needs are evident from its own framing: evaluate on autistic participants, evaluate on spontaneous rather than posed expression, and test whether a model optimised on posed adult faces transfers to autistic children's faces at all - the last being a question another study in this review answers negatively for a comparable pipeline." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-117" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. No severity, cognitive, adaptive or language measure exists, and none could, since no clinical population was studied." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-117" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Instructed posed expression production, as designed into both corpora. This is the canonical easy case for facial expression recognition: prototypical, maximally intense, produced deliberately, and captured at the peak frame - CK+ explicitly uses 'the peak frame of each sequence' because 'it includes the greatest information relating to emotions'. Selecting peak frames maximises separability and is standard practice for benchmarking, but it removes precisely the subtlety the paper claims to address. The paradigm gap is therefore twofold: posed rather than spontaneous, and peak rather than continuous." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-117" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Not assessable, because no validation scheme is described. The paper states no train-test split proportion, no cross-validation arrangement, no held-out set size and no partitioning unit anywhere. The one hint is that CK+ is used 'to test the WQPSO-FMRCNN model on unseen data' after KDEF, which would be cross-corpus evaluation - the design this review regards most highly, since it tests transfer across acquisition conditions and populations. It is not reported as a separate result, so what would have been the study's strongest methodological feature goes unquantified. Two further points bound the figures. CK+ contributes 327 peak frames from 118 individuals, roughly 2.8 images per person, and whether images of the same individual span any partition is unstated. And KDEF is geometrically standardised with eyes and lips at fixed coordinates, so a classifier operating on it faces none of the pose, scale or framing variation that any real deployment would present. A 99.8% accuracy on peak-frame posed expressions from geometrically aligned adult faces is close to the ceiling that this benchmark has long supported, and is not evidence about the harder problem the paper describes." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-117" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "There are no autistic participants. The Extended Cohn-Kanade corpus supplies 327 sequences from 118 adult volunteers, of which only the peak frame of each sequence is used, giving roughly 2.8 images per person; the Karolinska Directed Emotional Faces corpus supplies posed adult expressions photographed under fixed conditions, with its sample size not stated in this paper. Both are general-population affective-computing resources with no autism component, no autism labels and no clinical ascertainment of any kind. The paper's results section mentions once, in passing, 'the Autism Spectrum Disorder Facial Expression (ASD-FE) dataset and the Extended Cohn-Kanade (CK+) dataset adapted for ASD research', but no such dataset is described, cited, sized or characterised anywhere in the methods and no adaptation procedure is specified, while the experiments reported in the results and figures are conducted on brightness variants of KDEF and on CK+ peak frames. The sample is therefore adult, non-autistic, and posed - three respects in which it differs from the population the study's stated purpose concerns, which is autistic children experiencing spontaneous distress." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-117" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Partial. Reported: both corpora by name, CK+'s 327 sequences from 118 individuals, the peak-frame selection rule, the full preprocessing chain with both working resolutions, the quaternion algebra underpinning the optimiser given as explicit Hamilton relations, the three baseline comparators, and t-values and p-values for the comparisons. Not reported: KDEF's sample size, class distributions for either corpus, any train-test split or cross-validation scheme, the swarm optimiser's own population size and iteration count, the network's hyperparameters, how many runs contributed to the reported means, over what units the t-tests were computed, code, funding and competing interests. The mathematical apparatus is documented and the experimental protocol is not." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-117" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The stated aim is to improve recognition of altered facial expressions in autistic people, on the argument that conventional systems misread the nuanced cues that autistic faces produce - a real and under-addressed problem, and the strongest idea in the paper. The executed work is six-way emotion classification on KDEF and CK+, reporting 99.8% accuracy, 99.8% precision, 100% recall and 94% specificity, with significance tests against CNN, linear SVM and k-nearest-neighbour baselines at p < 0.01. The gap between the two is the study's defining feature. The paper's own introduction supplies the reason the executed task cannot address the stated aim, observing that 'research indicates a lack of studies utilizing static or dynamic facial stimuli displaying real, spontaneous emotions' and that 'staged emotions are easier to detect than spontaneous ones' - after which the evaluation uses only staged emotions from instructed adult volunteers. A separate study charted in this review tests the transfer question directly and finds that affect models trained on neurotypical faces perform poorly on autistic children and improve substantially only after fine-tuning on autistic data, which is the evidence this study would have needed and did not seek." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-117" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Grayscale cropped faces at 120x110 for Gabor filtering and 100x100 for convolutional processing, after normalisation, histogram equalisation, face detection and realignment. KDEF images are additionally pre-standardised by the corpus creators so that eyes and lips occupy fixed coordinates, which removes pose and scale variation entirely - a property that raises accuracy and reduces the relevance of the result to any uncontrolled setting." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-117" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "There is no limitations section. The most consequential omission is the mismatch between the paper's framing and its content: every framing element - title, abstract, keywords, introduction, problem statement and conclusion - is written in terms of autistic people, while the data are posed expressions from non-autistic adults and no autism label, participant or classification target exists anywhere. The paper also identifies, in its own introduction, the reason its evaluation cannot support its aim - that staged emotions are easier to detect than spontaneous ones and that spontaneous stimuli are what the field lacks - without connecting that observation to its own design. Further unstated issues: no validation scheme, split proportion or partitioning unit is given anywhere; the reported metric combination (100% recall with 94% specificity in a six-class problem) is unusual and is presented without confusion matrices, class-wise results or a definition of multi-class specificity; the number of emotion classes is stated as six in the abstract, seven in the KDEF description and five in a CK+ figure caption; and the architecture narrative repeatedly describes the optimiser as encoding 'physiological signal characteristics' although no physiological signal is collected or used." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-117" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Traitement du Signal 41(6), IIETA, open access under CC BY, doi 10.18280/ts.410628; received 12 April 2024, revised 7 August, accepted 20 August, available online 31 December 2024. A signal-processing venue. The review process accepted a paper whose title and abstract promise autism facial expression recognition while its experiments use two general-population posed-expression corpora; whose class count differs across three locations in the text; whose architecture narrative refers repeatedly to physiological signals that are never collected; and which states no validation scheme of any kind." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-117" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Prototypical posed emotion in adult volunteers - anger, fear, joy, sadness, surprise and disgust - captured at peak intensity. The construct the paper claims to address is different and considerably harder: the atypical, low-intensity, idiosyncratic facial signalling that autistic people may produce and that conventional recognition systems misread. The paper states that problem clearly and does not test it. For this review the distinction matters because the two constructs have opposite difficulty profiles: posed peak-frame expression is the benchmark case on which affect recognition has long achieved very high accuracy, whereas spontaneous atypical expression in autistic children is where every reported system in this corpus degrades. A 99.8% figure on the first tells a reader nothing about the second." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-117" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:study_design "Retrospective algorithm-development study on two public posed-expression corpora, comparing a proposed hybrid optimiser-network architecture against three baselines" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: ; comparison: Not applicable - the task is multi-class emotion recognition rather than a group contrast" ] ] ;
