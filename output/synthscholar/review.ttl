    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "Univariate feature selection and PCA are both performed inside each cross-validation fold, leave-one-out over 70 children, a single classifier with no best-of-many selection, and demographic and IQ inputs tested and reported as unhelpful." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "All 70 children contribute to the reported confusion counts (30/35 and 23/35), transcription reliability criteria are specified, and frame-level exclusions (overlapping speech, proctor speech, voiceless frames) are defined explicitly." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "Clinical Best Estimate informed by ADOS-2 under DSM-5 criteria applied both to confirm ASD and to rule it out in controls, with ADOS-2 Calibrated Severity Scores and SCQ reported for both groups - the most complete diagnostic ascertainment in the corpus." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "Groups matched and statistically verified on full-scale, verbal and non-verbal IQ and on sex ratio, with age difference tested and non-significant; both groups drawn from the same research centre with the same ascertainment process applied to cases and controls alike." ] ;
            slr:overall_judgment "low" ;
            slr:tool_used "QUADAS-2" ] .

<urn:slr:article:8da61cddafb9> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Autism spectrum condition (ASC) is primarily diagnosed by behavioural symptoms including social, sensory and motor aspects. Although stereotyped, repetitive motor movements are considered during diagnosis, quantitative measures that identify kinematic characteristics in the movement patterns of autistic individuals are poorly studied, preventing advances in understanding the aetiology of motor impairment, or whether a wider range of motor characteristics could be used for diagnosis. The aim of this study was to investigate whether datadriven machine learning based methods could be used to address some fundamental problems with regard to identifying discriminative test conditions and kinematic parameters to classify between ASC and neurotypical controls. Data was based on a previous task where 16 ASC participants and 14 age, IQ matched controls observed then imitated a series of hand movements. 40 kinematic parameters extracted from eight imitation conditions were analysed using machine learning based methods. Two optimal imitation conditions and nine most significant kinematic parameters were identified and compared with some standard attribute evaluators. To our knowledge, this is the first attempt to apply machine learning to kinematic movement parameters measured during imitation of hand movements to investigate the identification of ASC. Although based on a small sample, the work demonstrates the feasibility of applying machine learning methods to analyse high-dimensional data and suggest the potential of machine learning for identifying kinematic biomarkers that could contribute to the diagnostic classification of autism." ;
    dcterms:bibliographicCitation "Li B; Sharma A; Meng J; Purushwalkam S; Gowen E (2017). Applying machine learning to identify autistic adults using imitation: An exploratory study. *PLOS ONE, 12(8), Article e0182652*." ;
    dcterms:creator "Gowen E",
        "Li B",
        "Meng J",
        "Purushwalkam S",
        "Sharma A" ;
    dcterms:title "Applying machine learning to identify autistic adults using imitation: An exploratory study" ;
    bibo:pmid "local_780141fc" ;
    fabio:hasPublicationYear 2017 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are participants and recruitment adequately described?" ;
                            slr:justification "Ages, IQs, exclusions and matching statistics are reported, but recruitment route, sex counts and diagnostic route are not." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are comparison groups matched on the variables that matter?" ;
                            slr:justification "Age and IQ matched by design and confirmed by t-tests (p = 0.49 and 0.76); sex-matching claimed though uncounted." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the sample appropriate and adequate for the stated target?" ;
                            slr:justification "n=30, all high-IQ (mean ~119) verbally able adults; the authors name small sample size as the study's limitation." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "some concerns" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are data exclusions reported transparently?" ;
                            slr:justification "Both participant-level exclusions and per-group trial-level error rates are disclosed, including the ASC/control asymmetry." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the behavioral data acquisition described reproducibly?" ;
                            slr:justification "Sensor, sampling rate, filter, movement-segmentation criterion, condition parameters (beats per minute, amplitudes, trajectories), block structure and trial counts all specified, with the full parameter table published." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the reference standard appropriate and independently applied?" ;
                            slr:justification "No diagnostic instrument or procedure is reported for the ASC group in this paper." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are predictors defined without knowledge of outcome?" ;
                            slr:justification "Kinematic parameters are computed automatically from motion-tracker traces." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "some concerns" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is feature-selection stability assessed?" ;
                            slr:justification "Occurrence of selected features across iterations is plotted and compared between methods, with SVM-weight features noted as more stable." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is there external or independent validation?" ;
                            slr:justification "None; generalisation across ASC heterogeneity is explicitly flagged as untested." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the method benchmarked against alternatives?" ;
                            slr:justification "Compared against nine standard Weka attribute evaluators across four classifiers, with averages and standard deviations." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is feature selection nested within the validation loop?" ;
                            slr:justification "A second-layer cross-validation confines feature and parameter selection to an inner training/development split, stated explicitly." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the sample size adequate for the feature dimensionality?" ;
                            slr:justification "40 features against 30 samples, reduced to 9 by selection; overfitting is anticipated and discussed but not eliminated." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "low" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is code or an implementation available?" ;
                            slr:justification "No code release, though LIBSVM and Weka are named and the analysis is reconstructible from the released data." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are ethics, consent and competing interests reported?" ;
                            slr:justification "48-hour information period, opportunity to ask questions, written consent, dual university and NHS ethics approval covering the study, the consent procedure and the use of data, plus funding and a no-competing-interests declaration." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are negative or failed analyses reported?" ;
                            slr:justification "The statistical histogram analysis is reported as having failed to separate the groups, rather than being omitted." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are sample bias and generalisability discussed?" ;
                            slr:justification "Small sample, ASC heterogeneity and the need for other motor-deficit comparison groups are all discussed candidly." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the dataset accessible or its access conditions stated?" ;
                            slr:justification "Released as S1_File.xlsx with an explicit data availability statement under CC-BY, with an invitation to other researchers - rare in this corpus." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "low" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Hardware: Polhemus Liberty electromagnetic motion sensor attached to the index finger of the dominant hand, sampling 3D position at 120 Hz; video presentation of stimulus clips. Software: MATLAB for filtering (120 Hz Butterworth), movement segmentation (10% of peak velocity over six consecutive samples) and parameter extraction; LIBSVM for SVM training with grid search over C and gamma; Weka for the standard-attribute-evaluator comparison." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-007" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "'autistic adults', 'autistic individuals', 'people with ASC', 'individuals with ASC', 'the ASC group', 'the autistic group', 'neurotypical controls', 'neurotypical group', 'non-autistic controls', with 'healthy controls' appearing once. Notably this paper uses identity-first language ('autistic adults', 'autistic individuals') and 'neurotypical' consistently, and uses 'autism spectrum condition' rather than 'disorder' - the most neurodiversity-aligned terminology of any study in the corpus so far, and a deliberate contrast with the person-first, 'healthy control' framing typical elsewhere." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-007" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Accuracy, sensitivity and specificity, reported per classifier with averages and standard deviations across methods; the true positive and true negative definitions and class sizes (P=14, N=16) are stated explicitly. Headline: 86.7% accuracy, 85.7% sensitivity, 87.5% specificity (linear SVM, nine features). No AUC, F1 or confidence intervals." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-007" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "ASC n=14 analysed (16 recruited), mean age 32 +/- 7.69 years, mean WASI IQ 118.5 +/- 12.02. Controls n=16, mean age 29.31 +/- 8.38, mean IQ 119.8 +/- 11. Age and IQ did not differ significantly (age t(28) = 0.7, p = 0.49; IQ t(28) = -0.31, p = 0.76) - so unusually for this corpus the groups are matched on IQ as well as age, and the matching is statistically verified rather than merely asserted. Sex matching is claimed but no male/female counts are given for either group. Adults only, so no early-diagnosis relevance. Both groups are high-IQ (mean ~119), which bounds generalisability considerably." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-007" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Single modality; no fusion across behavioral modalities. Within the modality there is a form of condition-level fusion: features from the two best conditions (No-Target Fast and No-Target Elevated) are combined into a joint 40-feature vector, which raised Naive Bayes accuracy from 70.0% and 66.7% individually to 83.3% jointly - an explicit demonstration that combining task conditions helps. IQ and age are used as matching variables, not as model inputs." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-007" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Expand to more complex, full-body motor functions; train on larger groups to improve generalisation across ASC heterogeneity; compare against developmental coordination disorder and ADHD to test whether motor profiles are shared or distinct; investigate motor subgroups within autism and their implications for daily living and therapy; and design future imitation experiments around actions dissimilar to the observer's existing repertoire, since that is what maximised group differences here - a concrete, actionable design recommendation rather than a generic call for more data." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-007" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Laboratory setting at the University of Manchester. Existing data - the study is an explicitly secondary machine-learning re-analysis of an imitation experiment previously analysed with mean-based statistics on only five kinematic parameters. Its contribution is analytic rather than new collection, though it does newly release the dataset." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-007" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Robustness is handled better than anywhere else in the corpus at this sample size. A nested leave-one-out design places feature selection and hyperparameter tuning inside an inner training/development split, with the explicit statement that all selections are based on training-data performance and the test sample is treated as unknown. Feature-selection stability across iterations is examined and reported (SVM-weight features being more stable than leave-one-out features). The method is benchmarked against nine standard alternatives. What is absent: any external or independent dataset, any held-out site, any class-imbalance handling (14 vs 16 is near-balanced), and any deployment or real-time analysis. Generalisation across ASC heterogeneity is explicitly flagged as untested." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-007" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "PLOS ONE - a broad open-access multidisciplinary journal, neither autism-specific nor computational." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-007" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Supervised learning, with unsupervised PCA used only for feature selection. Algorithms: Naive Bayes, SVM with linear and RBF kernels, decision tree C4.5 and random forest. The choice of Naive Bayes first is explicitly motivated by anticipated SVM overfitting given 40 features and 30 samples, and the paper reports the informative finding that Naive Bayes performed comparably to SVM even on a quarter of the features, speculating that the independence assumption may genuinely hold for these kinematic parameters." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-007" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Reported by the authors: small sample size is named as the study's limitation; ASC heterogeneity means generalisation to a wider population 'remains to be tested'; and comparison against other motor-deficit groups (developmental coordination disorder, ADHD) is needed to know whether the profile is autism-specific. Identifiable in review: no diagnostic instrument is reported for the ASC group at all; both groups have mean IQ near 119, so the sample represents only high-IQ verbally able adults; sex counts are never given despite sex-matching being claimed; 6% of ASC trials and 2% of control trials were excluded for recording or imitation errors, an asymmetry that is disclosed but not analysed; and the reported 86.7% is the best cell of a grid spanning three feature-selection methods, four-plus classifiers and eight conditions, so some selection optimism survives even the nested validation." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-007" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Not reported in this paper. The ASC participants come from a previously published experiment and no diagnostic instrument, criteria, clinician or confirmation procedure is described - the reader is referred to the source publication. Given that diagnostic status is the classification target, this is the study's most significant reporting gap." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-007" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Full-scale IQ measured with the Wechsler Abbreviated Scale of Intelligence and reported for both groups (118.5 vs 119.8) and used as a matching variable - one of the few corpus studies to match and verify on IQ. No language or adaptive-functioning measures, no autism trait or severity scores (no AQ, ADOS or equivalent), and no comorbidity information." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-007" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Goal: exploratory feasibility plus discovery of the most discriminative test conditions and kinematic parameters - explicitly framed as addressing which conditions and features to use, not only whether classification works. Main findings: best accuracy 86.7% (sensitivity 85.7%, specificity 87.5%) with linear SVM on nine features; the two No-Target (goal-less) conditions were the discriminative ones; all nine selected features were standard deviations rather than means; the combined feature-selection method (77.3% average across models) outperformed nine standard Weka attribute evaluators (70.5% average); and conventional statistical histogram comparison failed to separate the groups at all." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-007" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No formal keyword list in the extracted text. The paper's vocabulary: 'kinematic biomarkers', 'motor bio-signatures', 'diagnostic classification', 'voluntary imitation', 'goal-less imitation', 'data-driven', 'discriminative test conditions', 'exploratory study'. The consistent use of 'autism spectrum condition', 'autistic adults' and 'neurotypical' is itself a distinctive terminological signature." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-007" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2017. The paper surveys the emergence of machine learning in autism research across neural markers, cognitive scores, diagnostic-instrument item reduction and pregnancy risk factors, and notes that 'to date, there have been few studies that have applied machine learning to autistic motor data', naming Crippa et al. (2015) as the only prior motor example. It positions itself as the first to apply machine learning to imitation kinematics and, unusually, contrasts its own design against that predecessor on specific methodological grounds - less constrained task, exploration of which test conditions discriminate, and adults rather than children where group differences should be smaller." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-007" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Interpretability is the paper's core contribution rather than an afterthought. Four selection methods are compared (SVM weights, leave-one-parameter-out, PCA first-component loadings, and their combination) and benchmarked against nine standard Weka attribute evaluators, with agreement between methods reported (features 16, 29 and 37 recur across several). The nine selected features are all standard deviations from the two goal-less conditions, and their directions are interpreted substantively: higher variability in No-Target Fast, lower variability in No-Target Elevated, read as the autistic group failing to build a new sensorimotor plan for an unusual trajectory and instead retaining their habitual movement style - an interpretation supported by citation to the authors' own follow-up work." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-007" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A voluntary imitation task: participants observed a video clip of a demonstrator's hand performing a two-movement sequence and then copied it, cued by an exclamation mark after a fixation cross and a still hand image. Eight conditions crossed target presence (pointing to visible targets vs no apparent targets) with speed (48 vs 58 beats per minute) and trajectory (15 cm flat, 10 cm short, or 15 cm curved/elevated). Four blocks (two Target, two No-Target) with speed and trajectory randomised within block; 8 analysed trials per condition, plus 32 filler trials specifically included to stop participants' behaviour becoming repetitive and stereotyped." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-007" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Motor behavior: 3D hand kinematics during imitation - velocity, acceleration and deceleration profiles and their timings, jerk, horizontal and vertical amplitudes, and movement duration. Single-point finger tracking rather than full-body pose." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-007" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional, single session; no longitudinal component. The data are numeric hand-position kinematics, not identifiable media, so sensitivity is low - and the released dataset is inherently de-identified. Consent and ethics are reported more completely than anywhere else in the corpus so far: written information provided at least 48 hours in advance, an explicit opportunity to ask questions, written consent, and approval of the study, the consent procedure and the use of data by both the University of Manchester and NHS research ethics committees." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-007" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two groups: autistic adults (16 recruited, 14 analysed after two exclusions for data capture failure) and neurotypical adult controls (n=16). Both group sizes and the exclusion are reported explicitly. No other-diagnosis comparison group, though the discussion identifies developmental coordination disorder and ADHD as the comparisons needed next." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-007" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The best reproducibility profile in the corpus so far. The dataset is released as Supporting Information (S1_File.xlsx) under CC-BY with an explicit data availability statement and an invitation to other researchers; the full 20-parameter definition table is published; the sampling rate, filter, segmentation threshold and trial structure are specified; the SVM library and grid-search procedure are named; and the entire pipeline is benchmarked in Weka, a public tool, against nine named standard evaluators. No code is released and random seeds are not reported, but the analysis is reconstructible from the released data." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-007" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Handcrafted kinematic summary features: 20 scalar parameters per trial, aggregated per participant per condition into means and standard deviations across 8 trials, giving 40 features per condition. Critically, the discriminative signal turned out to lie entirely in the standard deviations rather than the means - i.e. in trial-to-trial variability rather than in average movement form. No raw time series, images or learned embeddings." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-007" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "Single session split into four blocks (two Target, two No-Target); 64 analysed trials per participant (8 per condition across 8 conditions) plus 32 additional trials included to prevent behaviour beco" ;
                    slr:study_design "Cross-sectional case-control classification study; secondary machine-learning analysis of a previously published imitation experiment" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum condition (verbally able adults)" ;
                    slr:sample_size_text "ASD/index: 16 recruited; 2 excluded for data capture issues, leaving 14 analysed; comparison: 16" ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "Best result 86.7% accuracy (85.7% sensitivity, 87.5% specificity) with linear SVM on the nine combined-selection features. Naive Bayes 80.0%, RBF-SVM 83.3%, random forest 70.0%, decision tree 66.7%; average across the five models 77.3%. Condition screening by Naive Bayes gave NTE 64.5% and NTF 56.7% average accuracy, rising to 83.3% when the standard deviations of both conditions were combined. Th",
                        "Kinematic variability during goal-less imitation discriminates autistic from neurotypical adults at up to 86.7% accuracy. The two No-Target conditions (fast and elevated) were far more discriminative than any Target condition, replicating the authors' earlier mean-based finding that imitation differences are specific to goal-less movement. All nine selected features were standard deviations rather" ;
                    slr:outcome "Accuracy, sensitivity and specificity, with per-classifier breakdowns and averages, plus standard deviations across the comparison methods" ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "Best result 86.7% accuracy (85.7% sensitivity, 87.5% specificity) with linear SVM on the nine combined-selection features. Naive Bayes 80.0%, RBF-SVM 83.3%, random forest 70.0%, decision tree 66.7%; average across the five models 77.3%. Condition screening by Naive Bayes gave NTE 64.5% and NTF 56.7% average accuracy, rising to 83.3% when the standard deviations of both conditions were combined. Th; Kinematic variability during goal-less imitation discriminates autistic from neurotypical adults at up to 86.7% accuracy. The two No-Target conditions (fast and elevated) were far more discriminative than any Target condition, replicating the authors' earlier mean-based finding that imitation differences are specific to goal-less movement. All nine selected features were standard deviations rather" ] ] ;
