    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "A single fixed partition of 2,836 images into 2,536/200/100, with no cross-validation, no repeated splits and no confidence intervals; a 100-image test set in which one image is a full percentage point; an ambiguous ordering of augmentation and splitting; an unknown and unrecoverable image-to-child mapping making participant-level integrity impossible to establish; 100% training accuracy; and a confusion matrix summing to 280 images that matches neither stated partition." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "There is no participant selection. Images were scraped from the internet with autistic images taken from autism-focused websites and non-autistic images gathered randomly, so the two classes are drawn from different populations by different processes. The number of distinct children is unknown, no demographic information exists, and no inclusion or exclusion criterion of any kind is stated or possible." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "The label is the source from which an image was retrieved. No diagnosis, criterion, instrument, clinician or verification underlies either class, and both false-positive and false-negative labelling are unbounded - an autism-website photograph may depict a non-autistic person and a randomly collected photograph may depict an autistic child." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Three architectures were compared with the best reported; augmentation appears to precede partitioning; two mutually inconsistent input sizes are given; and the reported confusion matrix corresponds to no stated partition size. No threshold or operating point is prespecified and no analysis establishes what the classifier responds to." ] ;
            slr:overall_judgment "high" ;
            slr:tool_used "QUADAS-2" ] .

<urn:slr:article:f0fbf02fd04e> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Autism Spectrum Disorder (ASD) is a neurodevelopmental disorder that involves difﬁculties in social communication. Previous research has demonstrated that these difﬁculties are apparent in the way ASD children speak, indicating that it may be possible to estimate ASD severity using quantitative features of speech. Here, we extracted a variety of prosodic, acoustic, and conversational features from speech recordings of Hebrew speaking children who completed an Autism Diagnostic Observation Schedule (ADOS) assessment. Sixty features were extracted from the recordings of 72 children and 21 of the features were signiﬁcantly correlated with the children’s ADOS scores. Positive correlations were found with pitch variability and Zero Crossing Rate (ZCR), while negative correlations were found with the speed and number of vocal responses to the clinician, and the overall number of vocalizations. Using these features, we built several Deep Neural Network (DNN) algorithms to estimate ADOS scores and compared their performance with Linear Regression and Support Vector Regression (SVR) models. We found that a Convolutional Neural Network (CNN) yielded the best results. This algorithm predicted ADOS scores with a mean RMSE of 4.65 and a mean correlation of 0.72 with the true ADOS scores when trained and tested on different subsamples of the available data. Automated algorithms with the ability to predict ASD severity in a reliable and sensitive manner have the potential of revolutionizing early ASD identiﬁcation, quantiﬁcation of symptom severity, and assessment of treatment efﬁcacy." ;
    dcterms:bibliographicCitation "Eni M; Dinstein I; Ilan M; Menashe I; Meiri G; Zigel Y (2020). Estimating Autism Severity in Young Children From Speech Signals Using a Deep Neural Network. *IEEE Access, 8, 139489-139500*." ;
    dcterms:creator "Dinstein I",
        "Eni M",
        "Ilan M",
        "Meiri G",
        "Menashe I",
        "Zigel Y" ;
    dcterms:title "Estimating Autism Severity in Young Children From Speech Signals Using a Deep Neural Network" ;
    bibo:pmid "local_4fecbf6d" ;
    fabio:hasPublicationYear 2020 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is age treated as a potential confound?" ;
                            slr:justification "All 60 features correlated against age, showing little overlap with the severity-predictive set; train/test sets matched on age." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are participants and recruitment adequately described?" ;
                            slr:justification "Diagnostic composition, module distribution and session durations are given; ages and sexes were tabulated but the tables did not survive extraction." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the comparison structure clinically realistic?" ;
                            slr:justification "A referred cohort including 10 children with other diagnoses, modelled on one severity continuum rather than clinical-versus-community." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the sample appropriate and adequate for the stated target?" ;
                            slr:justification "72 children is respectable for clinical ADOS audio, but only 6 typically developing children thinly supports the low-severity end of the regression." ;
                            slr:rating "Partly" ] ;
                    slr:overall_concern "low" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the pipeline fully automated?" ;
                            slr:justification "Speaker intervals were manually labelled with in-house GUI software; automatic diarization is named as required future work." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the reference standard appropriate and independently applied?" ;
                            slr:justification "DSM-5 clinical assessment plus ADOS-2 for every child, with the graded score as target." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the behavioral data acquisition described reproducibly?" ;
                            slr:justification "Microphone, distance, interface, sampling rates, segmentation equations and every threshold are specified." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are predictors defined without knowledge of outcome?" ;
                            slr:justification "Feature extraction is automatic; the linear model's feature selection is nested within training-set cross-validation." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "some concerns" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is stability across splits reported and interpreted?" ;
                            slr:justification "Across-split standard deviations reported per model and used to argue that single-split results do not demonstrate robustness." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is error characterised beyond a summary statistic?" ;
                            slr:justification "No calibration curve or breakdown of error by ADOS range, despite RMSE 4.65 on a 0-30 scale being clinically substantial." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are baselines comparable and fairly configured?" ;
                            slr:justification "Four SVR kernels evaluated, linear regression given nested feature selection, and all six models run on all 50 splits." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is model selection separated from performance estimation?" ;
                            slr:justification "Architecture and hyperparameter tuning appears to precede rather than nest within the 50-split evaluation." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is performance estimated over repeated splits?" ;
                            slr:justification "50 balanced splits, with distribution-matching on mean, SD, kurtosis and skewness, and results reported as distributions." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the validation split at the participant level?" ;
                            slr:justification "51 training and 21 testing children, with all 100 sub-samples of a child staying on one side." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "low" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are negative and contrary results reported?" ;
                            slr:justification "FC-DNN model 2's failure is reported and analysed, and the response-latency finding is flagged as contradicting prior work and needing replication." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are all features fully specified?" ;
                            slr:justification "All 60 enumerated individually with their computation and the tools used." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the dataset accessible or its access conditions stated?" ;
                            slr:justification "No release or availability statement." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is code available?" ;
                            slr:justification "None, though architectures, thresholds and search grids are specified in enough detail to reimplement." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are ethics and consent reported?" ;
                            slr:justification "No approval number, consent procedure or anonymization statement for full audio of clinical sessions with children and parents, though funding and acknowledgements are detailed." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "some concerns" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The ADOS-2 assessment itself, with no additional or purpose-built task. This is the design's central choice and its main practical strength: the data are generated by a procedure clinics already perform, so deployment requires only recording rather than a new protocol, and the model's target and its input come from the same session. The cost is that the input is contaminated with clinician, parent and environmental sound, which is why manual speaker labelling was necessary; and that module assignment varies by child, so the speech elicited is not identical across participants." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-042" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "One clinically referred cohort of 72 children treated as a severity continuum rather than as contrasting groups: 56 with an ASD diagnosis, 10 referred with suspected autism who received other diagnoses (language or developmental delays), and 6 typically developing children. Including the 10 diagnostically ambiguous referrals is unusual and important - most of the corpus either excludes such children or treats them as noise, whereas here they are the cases that make the prediction problem realistic. All 72 completed the same DSM-5 clinical assessment and ADOS-2." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-042" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "ADOS total, SA and RRB scores are the severity characterisation and are used analytically throughout, including a separate correlation analysis per subscale. No IQ, language, adaptive or cognitive measures are reported, which matters because ADOS module assignment already encodes language capacity and so the cohort spans a language range that is not otherwise quantified. Comorbid language and developmental delays are present in 10 children and identified as such but not scored." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-042" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Strong. Every child completed a full clinical assessment against DSM-5 criteria plus an ADOS-2 with the module matched to age and language capacity, at a national autism research centre. Crucially the reference standard is not a binary label but the ADOS total score itself, decomposed into Social Affect (0-22) and Restricted and Repetitive Behavior (0-8), so the model is regressed against a graded, instrument-derived measure rather than a dichotomised clinical impression. The 10 children who were referred but received other diagnoses demonstrate that the assessment discriminated rather than confirmed." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-042" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The National Autism Research Center of Israel in Beersheba, a collaboration between Ben-Gurion University of the Negev and Soroka University Medical Center. Recording used a fixed setup in a dedicated ADOS room - an AKG CHM99 microphone 1-2 m from the child feeding a TASCAM US-16x08 interface at 44.1 kHz, downsampled to 16 kHz. Funded by the Israel Science Foundation (grant 961/14) and the BGU Research Authority, with the centre itself funded by the Israeli Ministry of Science and Technology." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-042" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Incorporate automatic speaker diarization to remove the manual annotation step and enable a fully automated system; extend from clinic recordings to long home recordings of the kind LENA collects; adopt a longitudinal design testing which speech features are informative at which developmental periods; and reassess the anomalous finding that more severely affected children responded faster rather than slower." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-042" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Among the best in the corpus for method reporting. All 60 features are enumerated individually with their computation; the segmentation algorithm is given with its equations and every threshold (40 ms frames at 10 ms rate, baseline as modal energy within +/- 20 s, onset at 90% above baseline held 50 ms, offset at 10% above baseline held 50 ms, 110 ms and 3 s duration bounds, under 1.5% excluded); the PRAAT voicing threshold is stated as 0.45; all six model architectures are specified layer by layer with epochs, batch sizes and dropout; the hyperparameter search grid is given (batch size from {4,8,16} or {32,64}, learning rate from {1e-5, 5e-5, 1e-4, 5e-4}); and the balanced-split acceptance criteria are stated numerically. Missing: code and data release, ethics documentation, and the selected hyperparameter values are relegated to a table that did not survive extraction." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-042" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional - a single ADOS session per child, averaging 41.6 +/- 12.4 minutes. Longitudinal follow-up is named as necessary future work precisely because the intended application (tracking severity change over time and after treatment) requires it. Data are full audio of clinical sessions including parent and clinician speech - among the most sensitive material in the corpus - yet no ethics approval, consent procedure or anonymization statement appears in the extracted text, while funding and acknowledgements are reported in detail." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-042" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "IEEE Access, in a special section on emerging deep learning theories and methods for biomedical engineering - an open-access engineering venue (CC BY 4.0), with clinical co-authors from Soroka University Medical Center and the National Autism Research Center of Israel giving the work genuine clinical grounding." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-042" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Group sizes and diagnostic composition are given (56 ASD, 10 other diagnoses, 6 TD) and ADOS module distribution is reported (toddler module 10, module 1 19, module 2 31, module 3 12), indicating a young cohort spanning a wide language-ability range. Ages and sexes were tabulated in Tables 1 and 4 but those tables did not survive text extraction, so the numbers cannot be reported here. What can be established is that age was handled analytically rather than by matching: age was correlated against all 60 features and found to relate mainly to vocalisation rate, duration and count, with little overlap with the features predicting severity, and train and test sets were matched on age and behavioural characteristics. All participants are Hebrew-speaking children assessed at a single Israeli centre; no ethnicity or socioeconomic reporting." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-042" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Goal: estimate continuous autism severity (ADOS total) from speech recorded during the ADOS itself, and compare regression and deep architectures for the task. Main findings: 21 of 60 features correlated significantly with ADOS total; higher and more variable pitch and higher ZCR with greater severity, fewer vocalisations and turns with greater severity, and shorter rather than longer response latency; RRB scores tracked acoustic and prosodic features while SA scores tracked conversational features; a CNN on a 100 x 48 sub-sample matrix achieved mean R = 0.72 and RMSE 4.65 across 50 balanced splits, beating SVR (0.51) and linear regression (0.36); and matrix-input models were far more stable across splits than vector-input ones." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-042" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Acknowledged: that speaker labelling was manual and that automatic diarization is needed for a fully automated system; that recordings are short clinic sessions rather than naturalistic home recordings; that the shorter-response-latency finding contradicts prior English-language work and needs replication; that feature utility may change with age and requires longitudinal testing; and, implicitly but importantly, that single-split results overstate robustness. Identifiable in review but not stated: RMSE 4.65 on a 0-30 scale is a large absolute error against which the phrase 'remarkably accurate prediction' sits uneasily; architecture and hyperparameters were selected by trying combinations, apparently outside the 50-split evaluation, so the reported means carry model-selection optimism; only 6 typically developing children means the low end of the severity range is thinly sampled, which inflates correlation through range restriction at one end and thin support at the other; and no ethics approval is reported for full clinical session audio." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-042" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "AKG CHM99 microphone at 1-2 m; TASCAM US-16x08 sound card; 44.1 kHz downsampled to 16 kHz; in-house GUI software for manual speaker interval labelling; PRAAT for pitch and formant analysis; custom code for energy, ZCR, spectral slope, jitter and conversational features; deep models with RMSProp and MSE loss. No commercial analysis system - the paper argues explicitly against LENA on the grounds that it is not open source, so 'it is not possible to further develop the LENA algorithms nor assess their utility in estimating ASD severity'." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-042" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Index terms: audio signals, autism, autism diagnostic observation schedule, autism spectrum disorder, convolutional neural network, deep neural network, early detection, outcome measure, pitch, speech, symptom severity, treatment efficacy, zero crossing rate. The presence of 'outcome measure', 'symptom severity' and 'treatment efficacy' alongside the signal-processing terms is diagnostic of the paper's position - it is proposing a measurement instrument for monitoring, not a screening test." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-042" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No post hoc model explanation, but strong interpretability at the feature level and, unusually, at the symptom-domain level. Every feature's Pearson correlation against ADOS total, SA, RRB and age is reported with significance marking, sequential forward selection names the 15 features that minimise linear-model RMSE, and the resulting interpretation is specific: acoustic and prosodic features (pitch, formants, jitter, energy, ZCR) track restricted and repetitive behaviour, while conversational features (vocalisation rate, turn-taking, vocalisation count) track social affect. The authors correctly note why this matters - symptom heterogeneity means a single global severity estimate is less clinically useful than measures tied to specific domains. The age analysis serves a second interpretive purpose, showing that the severity-predictive features are largely distinct from the age-predictive ones." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-042" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "RMSE and Pearson correlation against clinician-assigned ADOS total, reported as mean +/- standard deviation over 50 splits and shown as histograms, plus scatter plots for one representative split. Reporting the across-split standard deviation and interpreting it is the distinguishing feature: it reveals that models with respectable means (SVR at R = 0.51, FC-DNN 2 at 0.31) were also wildly unstable (SD 0.17 and 0.25), while the two matrix-input models were stable at SD 0.09. Because the task is regression, no sensitivity, specificity or AUC applies; but no calibration analysis or error-versus-severity breakdown is given, so whether error concentrates at particular ADOS ranges is unknown, and with only 6 typically developing children the low end is thinly supported." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-042" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Sixty handcrafted features across seven families, fully enumerated, computed over automatically detected vocal segments within manually labelled speaker intervals. Three input arrangements are compared: one 60-feature vector per child; 100 independent 48-feature vectors per child, each from 10 sequential vocal segments; and those same 100 vectors stacked into a 100 x 48 matrix per child. The sub-sampling is a deliberate data-augmentation strategy for a 72-child dataset, raising training samples from 51 to 5100 in model 2 - and the finding that this hurt while stacking the same samples into a matrix helped is one of the more useful negative-plus-positive results in the corpus." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-042" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2020. The framing is unusual in this corpus for arguing about tooling as much as about clinical need. It identifies LENA as the dominant platform for automated speech analysis in autism and objects on methodological grounds - LENA 'is not an open-source software and it is, therefore, not possible to further develop the LENA algorithms nor assess their utility in estimating ASD severity' - making open, inspectable pipelines part of the paper's motivation. It also notes that only a few studies had attempted severity estimation rather than binary classification, citing one that explained about 40% of the variance in Social Affect scores from 33 English-speaking children, and positions itself as the first application of these features and deep learning to Hebrew, arguing that the results 'highlight the utility of speech analyses for estimating ASD severity at very young ages, regardless of the child's spoken language or their cultural environment'." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-042" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Six models spanning linear regression, kernel regression and three deep architectures, all on identical data, which makes the comparison genuinely informative. The decisive variable turns out to be input structure rather than model family: the same 100 x 48 matrix input produces the two best models (FC-DNN 3 and CNN) while the same sub-sampled features presented as independent 48-vectors (FC-DNN 2) produce the worst model of all six. The authors draw the right conclusion - that architectures exploiting multiple simultaneous samples of a child's speech have a large advantage, and that the non-linear models' margin over linear regression and SVR shows 'the optimal ADOS prediction model is not likely to be linear'." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-042" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Child speech during clinical interaction, analysed along three distinct behavioural dimensions: prosody and voice quality (pitch, formants, spectral slope, jitter), acoustic energy dynamics (normalised energy and its derivatives, zero crossing rate), and conversational behaviour (vocalisation rate, segment durations, turn-taking latency and rate, total vocalisation count). The turn-taking features are what distinguish this from purely acoustic work - they measure the child's behaviour in relation to the clinician's, requiring the whole session and both speakers, and they turn out to be the features that track social affect specifically." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-042" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "'children with ASD', 'ASD children', 'typically developing (TD) children', 'children with ASD who are deaf'. Mixed person-first and 'ASD children'; consistently 'typically developing' rather than 'normal' or 'healthy'. The framing is clinical and quantitative - autism as a severity dimension to be measured rather than a category to be detected - and the stated purpose includes tracking improvement and deterioration, which positions the work as an outcome measure rather than a gatekeeping test." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-042" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The strongest validation design among the corpus's speech studies. Splitting is at the participant level (51 train, 21 test), so the 100 sub-samples per child never cross the boundary - the leakage failure mode that undermines most segment-level work here is avoided by construction. The split is then repeated 50 times under explicit distribution-matching constraints (mean, SD and kurtosis of ADOS within +/-10% of the whole sample, skewness within +/-0.3), with rejection sampling until satisfied, and every model is run on all 50. Feature selection for the linear model is nested inside 5-fold cross-validation on training data only. What is missing: the architecture and hyperparameter search appears to sit outside the 50-split loop rather than nested within it, so the reported means retain some selection optimism; there is no external site, no independent cohort and no second language; and no test-retest or longitudinal reliability, which the intended use as a treatment outcome measure would require." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-042" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No cross-sensor fusion - audio only. But there is a meaningful within-modality fusion result with a clear cost: the conversational features cannot be computed on short sub-groups of segments because they require the entire recording, so FC-DNN models 2 and 3 and the CNN use only the 48 acoustic and prosodic features. The best models therefore discard exactly the feature family that correlates most strongly with social affect symptoms, and still outperform the 60-feature vector model - which suggests the gain from many sub-samples outweighs the loss of conversational information, and implies an architecture that could use both would do better still." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-042" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "One ADOS session per child, averaging 41.6 +/- 12.4 minutes" ;
                    slr:study_design "Cross-sectional regression study on a consecutively assessed clinical cohort, with repeated distribution-balanced participant-level train/test splitting" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Young children referred for autism assessment" ;
                    slr:sample_size_text "ASD/index: 56 with an ASD diagnosis, out of 72 children total; comparison: 6 typically developing, plus 10 children with other diagnoses (language or developmental delay) who were referred with suspected autism" ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "Across 50 balanced splits: CNN best with mean R = 0.718 +/- 0.093 and RMSE 4.648 +/- 0.592; FC-DNN model 3 close behind at R = 0.696 +/- 0.091 and RMSE 4.952 +/- 0.651; then SVR (R = 0.510 +/- 0.166, RMSE 5.853), FC-DNN model 1 (R = 0.501 +/- 0.134, RMSE 6.148), linear regression (R = 0.355 +/- 0.193, RMSE 7.364) and FC-DNN model 2 worst (R = 0.312 +/- 0.253, RMSE 6.393). On the single representat",
                        "Speech recorded during routine ADOS assessments carries enough information to estimate autism symptom severity as a continuous score. Twenty-one of 60 prosodic, acoustic and conversational features correlated significantly with ADOS total, with higher and more variable pitch and higher zero crossing rates in more severely affected children and fewer vocalisations and conversational turns. A CNN ov" ;
                    slr:outcome "RMSE between predicted and clinician-assigned ADOS total, and Pearson correlation between them, reported as mean +/- SD across the 50 splits and additionally for one representative split with scatter plots. Standard deviation across splits is treated as a reported outcome in its own right - a measur" ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "Across 50 balanced splits: CNN best with mean R = 0.718 +/- 0.093 and RMSE 4.648 +/- 0.592; FC-DNN model 3 close behind at R = 0.696 +/- 0.091 and RMSE 4.952 +/- 0.651; then SVR (R = 0.510 +/- 0.166, RMSE 5.853), FC-DNN model 1 (R = 0.501 +/- 0.134, RMSE 6.148), linear regression (R = 0.355 +/- 0.193, RMSE 7.364) and FC-DNN model 2 worst (R = 0.312 +/- 0.253, RMSE 6.393). On the single representat; Speech recorded during routine ADOS assessments carries enough information to estimate autism symptom severity as a continuous score. Twenty-one of 60 prosodic, acoustic and conversational features correlated significantly with ADOS total, with higher and more variable pitch and higher zero crossing rates in more severely affected children and fewer vocalisations and conversational turns. A CNN ov" ] ] ;
