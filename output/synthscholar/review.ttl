    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "DSM-5 confirmation is claimed but qualified by the authors' own statement of 'limited access to reliable information in the school site'; the operative assessment is four parent-report questionnaires with no observational or clinician-administered diagnostic instrument." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "Cross-validation is subject-independent and stratified and normalisation is correctly fitted on training data, but no hyperparameter selection procedure is described for four compared architectures, so selection optimism cannot be excluded." ],
                [ a slr:RoBDomainJudgment ;
