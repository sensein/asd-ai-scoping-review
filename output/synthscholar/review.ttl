    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Participants appropriate to the question" ;
                            slr:justification "Three clinically defined groups including a second neurodevelopmental condition, recruited from early intervention centres with formal DSM-5 diagnoses; groups matched on age with the test reported." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Confounders addressed" ;
                            slr:justification "Clinical groups are approximately 92% male against 50% in TD (p<0.01) and differ significantly in PPVT-III vocabulary and basic attention; none is adjusted for or entered as a covariate." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Data source and eligibility described" ;
                            slr:justification "Inclusion criteria stated prospectively (intervention-centre attendance, formal clinician diagnosis); recruitment region named; group characteristics tabulated with statistical comparisons." ;
                            slr:rating "Low" ] ;
                    slr:overall_concern "unclear" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Predictors independent of the outcome" ;
                            slr:justification "No clinical instrument score, diagnostic measure or demographic variable enters the feature set - the property that separates this study from the corpus's leakage cases." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Dimensionality appropriate to sample" ;
                            slr:justification "Up to 158 variables for 93 children; three of the four feature sets have more variables than participants, with no regularisation or interval reporting described." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Predictors defined and measured appropriately" ;
                            slr:justification "Standard eye-tracking metrics over pre-defined areas of interest from a validated paired-preference paradigm, acquired with a calibrated screen-based tracker." ;
                            slr:rating "Low" ] ;
                    slr:overall_concern "low" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Outcome limitations acknowledged" ;
                            slr:justification "The authors state that their diagnostic tools could have been supplemented and that early-age diagnoses are provisional and may evolve." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Outcome definition and ascertainment" ;
                            slr:justification "Formal ASD or DLD diagnosis by a licensed, experienced clinical team following DSM-5 guidelines, made independently of the study." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Outcome determined independently of predictors" ;
                            slr:justification "Diagnoses predate enrolment and are unrelated to the gaze record." ;
                            slr:rating "Low" ] ;
                    slr:overall_concern "low" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Performance measures adequate" ;
                            slr:justification "F1 only, with pre-specified interpretive bands - a genuine discipline - but no accuracy, sensitivity, specificity, AUC, confidence interval, fold variance or majority-class baseline." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Limitations and overinterpretation" ;
                            slr:justification "Limitations paragraph names scope, sample size, instrument availability and diagnostic provisionality; the conclusion states that the approach is more effective as a screening tool than for differential diagnosis." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Validation design guards against optimism" ;
                            slr:justification "Stratified participant-level 5-fold cross-validation, correct in structure, but headline figures are the maximum over four feature sets, several algorithms and four group comparisons with no correction or external cohort." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Differential comparison included" ;
                            slr:justification "Every group pairing is run, including ASD versus DLD, which is the comparison almost the entire corpus omits." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Analysis unit matches the clinical claim" ;
                            slr:justification "One row per child; folds partition children." ;
                            slr:rating "Low" ] ;
                    slr:overall_concern "unclear" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "explainable machine learning; autism spectrum disorder; developmental language disorder; eye-tracking; differential diagnosis; computer-aided diagnosis. Six terms naming method, both conditions, modality and - uniquely in this corpus - differential diagnosis, which is what the study actually attempts." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-155" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Social attention during simultaneous presentation of social and non-social stimuli: preferential looking to faces versus objects, indexed by fixation duration, fixation count, visit duration and latency to first fixation, across areas of interest from whole-stimulus categories down to eyes and mouth and across three emotional expressions. The substantive behavioural finding is about objects rather than faces - mean duration of visits to objects discriminates, which the authors interpret as difficulty disengaging attention from objects rather than as reduced interest in faces." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-155" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The stated aim is to apply explainable machine learning to eye-tracking data from a social attention task in children with ASD, DLD and typical development, to assess classification accuracy across all group combinations and to identify which variables best differentiate the groups. Headline findings: F1 0.912 for DLD versus TD, 0.88 for pooled ASD+DLD versus TD, 0.86 for ASD versus TD, and 0.63 for ASD versus DLD; broad social versus non-social areas of interest carried the signal while finer decompositions by facial region and emotion did not improve accuracy; naive Bayes and logistic model trees performed best; and mean duration of visits to objects emerged as a candidate disorder-specific marker." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-155" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Early childhood intervention centres in the province of Cordoba supplied both clinical groups; testing used a screen-based eye tracker below a 15-inch laptop, with nine-point calibration. The clinical recruitment route is stated, though the room, examiner and whether TD children were tested under identical conditions are not described." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-155" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Clinically ascertained and honestly qualified. Diagnosis of ASD or DLD was made by a licensed, experienced team of clinicians following DSM-5 and international diagnostic manual guidelines, independently of this study and as a precondition of enrolment at an early intervention centre. Typically developing children are defined by the absence of such enrolment. The authors then add two caveats that few in this corpus offer: that their diagnostic tools could have been supplemented with further assessments but were the only ones available at the time, and that diagnoses at early ages are provisional and may evolve over time, so the findings should be interpreted with caution." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-155" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2025, published 24 June, 127 days from submission to acceptance. Framing is deliberately restrained and, unusually, becomes more restrained as the paper proceeds: the abstract reports the ASD-versus-DLD F1 of 0.63 alongside the higher figures rather than burying it, and the conclusion states that the approach is more effective as a screening tool than for differential diagnosis. The clinical claim is limited to a preliminary step toward computer-aided diagnosis. Its contribution to the review is not a performance number but a controlled contrast: by running the same pipeline against a typically developing group and against a second clinical group, it converts the corpus's ubiquitous ASD-versus-TD figure into an interpretable quantity." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-155" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "ASD, autism spectrum disorder, developmental language disorder, neurodevelopmental disorders, typical development, children with ASD, clinical groups. The register is clinical and precise, using DSM-5 language (persistent deficits in social interaction and communication, repetitive and restrictive patterns) without editorialising. Groups are named by diagnosis rather than by normality - the comparison group is typically developing, never normal. There is no autistic-community engagement, but nothing in the language pathologises beyond the diagnostic criteria themselves." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-155" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The validation is participant-level and structurally correct: stratified 5-fold cross-validation over 93 children, one row per child, no within-participant duplication, and no clinical instrument score anywhere in the feature set. Three caveats qualify the numbers rather than invalidate them. First, dimensionality - the full dataset carries 158 variables for 93 children, and even the smallest carries 24, so the models operate in a regime where cross-validated estimates over five folds are noisy; no interval or fold variance is reported. Second, selection - the headline figures are the best over four feature sets crossed with several algorithms and four group comparisons, with no correction and no held-out cohort, so they are optimistic by an unquantified margin. Third, confounding - the clinical groups are approximately 92% male against 50% in the TD group (chi-squared 20.15, p<0.01) and differ significantly in receptive vocabulary and basic attention, all of which are plausible correlates of gaze behaviour in a paired-preference task; none is adjusted for, so part of the 0.86 and 0.912 against TD may reflect sex and language ability rather than diagnosis. The result that survives all of this is the one the authors themselves foreground: ASD versus DLD reaches only F1 0.63, at nearly balanced class sizes, and they conclude that the approach is more effective as a screening tool than for differential diagnosis. That conclusion is the correct reading of their own data and is the most valuable single sentence in this part of the corpus, because the two comparisons are internally controlled - same task, same equipment, same pipeline, same analyst - so the gap between 0.86 against typical development and 0.63 against another neurodevelopmental condition isolates how much of the apparent signal is autism-specific rather than clinical-population-general." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-155" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Tobii X2-30 remote eye tracker at 30 Hz on a 15-inch laptop screen with Tobii Studio and nine-point calibration using an animated target. The stated spatial accuracy of 36 degrees is a typographic error for 0.36 degrees - as printed the figure would exceed the visual angle of the entire display. The modelling software is not named, and no hyperparameters, tuning procedure or seed is reported for any algorithm, which is the main reporting gap in an otherwise well-specified study." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-155" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional, single session. Ethics reporting is complete and specific: approval by the Research Ethics Committee of Cordoba dated 02/08/2019 with reference number 4393, conducted per the Declaration of Helsinki and local legislation, with families informed of the study's purpose and procedures and written informed consent obtained from legal guardians. The discussion adds an ethically relevant scientific caveat - that early diagnoses are provisional - which bears directly on how the labels should be read." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-155" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Four nested tabular feature sets per child: full (158 variables), secondary (72), prior (60) and basic (24), differing in how finely stimuli and areas of interest are decomposed. All variables derive from the eye-tracking record; no clinical instrument score, demographic variable or diagnostic measure enters the feature set - a point worth stating explicitly, because it is exactly what separates this study from the corpus's leakage cases. With 93 children and up to 158 variables, three of the four datasets have more variables than participants." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-155" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "F1-score only, with precision and recall given by equation. The interpretive bands are stated in advance (0.0-0.5 poor, 0.5-0.7 moderate, 0.8-0.9 good, 0.9-1.0 excellent) and the results are then reported against them, so the descriptions excellent, good and moderate are pre-committed rather than chosen after the fact - a small but genuine discipline. Missing: accuracy, sensitivity and specificity separately, AUC, calibration, confidence intervals, across-fold variance, and any statement of the majority-class baseline. The last matters most for the ASD-versus-DLD comparison, where the classes are nearly balanced (24 versus 25) and F1 0.63 sits only modestly above chance, and for ASD-versus-TD, where the baseline is around 0.65 and the reported 0.86 represents a real but smaller gain than the number suggests in isolation." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-155" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Interpretability is the study's purpose rather than an appendix to it. The four-way feature-set comparison yields a negative result that is reported plainly - fine-grained variables about specific facial areas and emotions do not improve on broad social versus non-social groupings - and the surviving discriminative variable, mean duration of visits to objects, is interpreted theoretically as difficulty disengaging attention from objects, connected to an existing attentional account (Landry and Bryson). This is a claim about behaviour that another laboratory could test, generated by a model whose structure a clinician can inspect, which is the intended use of explainable methods and is rare in this corpus." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-155" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Frontiers in Neuroscience 19:1558621 - an open-access neuroscience journal, with a 127-day review. The venue's disciplinary fit shows in the reporting: matched group characteristics with ANOVA and chi-squared tests, a standardised language measure, a pre-specified interpretive scale for F1, an ethics reference number, and a limitations paragraph that includes the provisionality of early diagnoses." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-155" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Moderate to good on acquisition, thin on modelling. Reproducible: the eye tracker, sampling rate, screen size, calibration procedure, paradigm, stimulus composition and emotion set; the four feature sets by variable count and content; the stratified 5-fold scheme; the F1 interpretive bands, fixed before the results; and an offer of raw data on request. Not reproducible: the modelling workbench, the algorithm settings, whether any tuning occurred and whether it was nested, the seed, per-fold results, and the full variable lists for the 158-, 72-, 60- and 24-variable datasets." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-155" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Among the most complete in the corpus, and reported with statistical tests. Age: TD 53.23 (SD 10.04), ASD 53.50 (10.35), DLD 54.0 (12.14) months, F(2,90)=0.041, p=0.959 - the groups are closely matched on age, which is uncommon here and is demonstrated rather than asserted. Sex: TD 22 boys/22 girls, ASD 22/2, DLD 23/2, chi-squared 20.15, p<0.01 - a large and explicitly tested imbalance which the authors attribute to the higher prevalence of both conditions in males. Basic attention: 87.09 / 73.50 / 73.08, F=13.23, p<0.01. PPVT-III receptive vocabulary standard score: 108.75 / 98.65 / 86.57, F=19.56, p<0.01. Nothing on ethnicity, socioeconomic status or language background. The sex and vocabulary differences matter for the classification results and are not carried into the modelling as covariates." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-155" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The eye-tracking paired preferences paradigm: social and non-social images presented side by side, with faces displaying happiness, anger and neutral expressions paired against objects, following established designs (Sasson and Touchstone; Vacas et al.). This is a purpose-built social-attention task drawn from the developmental literature rather than a repurposed video or free-viewing sequence, and the choice is justified by reference to the metrics - fixation duration, fixation count, latency to first fixation - shown to be sensitive to gaze differences across neurodevelopmental conditions." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-155" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Add further explainable algorithms such as gradient boosting trees and explainable boosting machines, and integrate multimodal data combining eye tracking with behavioural, cognitive or neurophysiological measures to improve robustness and clinical applicability. Both are proportionate to the study's own findings." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-155" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Ninety-three children aged 32-74 months in three clinically defined groups: 24 with ASD, 25 with developmental language disorder, and 44 typically developing. Both clinical groups were recruited from early childhood intervention centres in Cordoba province and required a formal diagnosis made by a licensed, experienced clinical team. The analysis unit is the child throughout, and each child contributes exactly one row to each of four feature sets. The inclusion of a second clinical group is what distinguishes this study from almost the entire charted corpus: it makes the ASD-versus-DLD comparison possible, and that comparison is where the study's most informative result lies." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-155" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No autism severity instrument is reported. Instead the study characterises its groups on two dimensions relevant to the task: a basic attention score and PPVT-III receptive vocabulary, both with significant group differences. The absence of a severity measure is a real gap for interpreting the ASD group's heterogeneity, but the inclusion of a standardised language measure is directly to the point, since DLD is the comparison condition." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-155" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Interpretable classical classifiers selected for explainability rather than capacity, with naive Bayes and logistic model trees performing best. No deep learning. The algorithm choice follows from the stated aim - to identify which eye-tracking variables discriminate, in a form clinicians can inspect - rather than from a search for maximum accuracy, and this is one of the few studies in the corpus where the modelling choice is subordinated to the scientific question." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-155" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No multimodal fusion - eye tracking alone. What the study does instead is a granularity comparison within one modality: four nested feature sets ranging from 24 broad variables to 158 fine-grained ones. The result is a clean negative finding that broad social/non-social area-of-interest variables carry the discriminative information while adding specific facial features and emotion categories does not improve accuracy. Multimodal extension with behavioural, cognitive or neurophysiological measures is named as the next step." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-155" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A short but genuinely self-critical paragraph naming four things: the limited scope of the experiment, the sample size, the diagnostic tools (which could have been supplemented but were the only ones available at the time), and the provisional nature of early-age diagnoses, with an explicit instruction that findings should be interpreted with caution and a call for replication with current behavioural assessments. Not mentioned: that the full variable set has 158 variables for 93 children; that the reported figures are the maximum over four feature sets, several algorithms and four comparisons with no correction; that the sex imbalance between clinical and TD groups (approximately 92% male versus 50%) offers an alternative route to the ASD-vs-TD and DLD-vs-TD separations; and that the significant PPVT-III differences are similarly available." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-155" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "Internal across algorithms, across the four feature sets, and across every group combination: ASD vs TD, DLD vs TD, ASD vs DLD, and pooled ASD+DLD vs TD. No external benchmark." ;
                    slr:study_design "Cross-sectional primary study with three clinically defined groups, followed by supervised classification across every pairwise and pooled group combination, using four nested feat…" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: 24 children with ASD (mean age 53.50 months, SD 10.35); comparison: Two comparison groups: 25 children with developmental language disorder (mean age 54.0, SD 12.14) and 44 typically developing children (mean age 53.23, SD 10.04). The presence of a second clinical group rather than only a typically developing control is the study's defining design feature." ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "F1 0.912 for DLD versus TD; 0.88 for pooled ASD+DLD versus TD; 0.86 for ASD versus TD; and 0.63 for ASD versus DLD. The most informative variables were those grouping stimuli broadly into social and non-social categories; adding finer-grained variables about specific facial features or emotions did not improve classification. Mean duration of visits to objects emerged as a candidate disorder-speci" ;
                    slr:outcome "F1-score, with precision and recall defined by equation and an explicitly stated interpretive band (0.0-0.5 poor, 0.5-0.7 moderate, 0.8-0.9 good, 0.9-1.0 excellent) fixed in advance of the results." ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "F1 0.912 for DLD versus TD; 0.88 for pooled ASD+DLD versus TD; 0.86 for ASD versus TD; and 0.63 for ASD versus DLD. The most informative variables were those grouping stimuli broadly into social and non-social categories; adding finer-grained variables about specific facial features or emotions did not improve classification. Mean duration of visits to objects emerged as a candidate disorder-speci" ] ] ;
