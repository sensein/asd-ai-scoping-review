    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "Clip and video counts per group are reported and folds are tabulated, but no splicing reliability check is described, clip durations are unreported, and the criterion governing how many clips were drawn per child is not stated despite counts differing roughly twofold between groups." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Diagnoses are unverified parent report with no instrument, clinician contact or record check, as the authors concede; comparison-group status likewise rests on parental assertion." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Median age differs by 4.5 years (5 versus 9.5) with no matching, adjustment or acknowledgement anywhere in the paper, and sex composition differs by 56 percentage points (95% versus 39% male) - both variables directly determining child vocal acoustics; the sample is self-selected among app users willing to share video and disclose a diagnosis." ],
                [ a slr:RoBDomainJudgment ;
