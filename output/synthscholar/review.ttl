        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "the ASD diagnoses were made by licensed pediatric psychiatrists based on the DSM-V and CARS (for those 2 years or older), but not confirmed by the ADOS/ADI-R due to limited access to these diagnostic tools in China... we did not assess the CARS in TD Children." ] ;
            oa:hasTarget <https://doi.org/10.3389/fpsyt.2022.899521> ;
