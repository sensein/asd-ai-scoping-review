        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "Dataset 2 consists of 100 original clinical samples augmented fourfold to a total of 400 samples... The dataset was divided into training (80%), validation (10%), and testing (10%) sets using stratified sampling" ] ;
