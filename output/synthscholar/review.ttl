            slr:screening_stage "full_text" ],
        [ a prov:Activity,
                slr:ScreeningDecisionRecord ;
            dcterms:title "Toward the Autism Motor Signature: Gesture patterns during smart tablet gameplay identify children with autism" ;
            bibo:pmid "local_e404a2a3" ;
