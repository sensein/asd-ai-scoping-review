<urn:slr:article:6a3b6c2a276b> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Autism Spectrum Disorder (ASD) is a mental disorder characterized by difficulties with socializing, repetitive behaviors, speech and non-verbal communication. It is diagnosed within the first three years of life. The earlier the diagnoses, the sooner the intervention can start. Previous studies showed that early interventions for ASD children result in higher success rate. Thus, early diagnosis is an important research goal. Clinical instruments currently used for measuring ASD signs and symptoms are time consuming and highly influenced by subjective observations. These limitations delayed diagnosis and further intervention. Therefore, scientists found that atypical gaze movement is among the earliest biomarkers for ASD. Accordingly, in our research, we are aiming to speed up diagnoses by combining gaze-based screening with intelligent methods such as machine learning which would act as a transformative step for identifying ASD at early stages. In this research we used Support Vector Machine (SVM) algorithm to examine the performance in terms of four different measures which are accuracy, sensitivity, specificity and Area under the curve (AUC). Results revealed that SVM accomplished high classification performance when applied on our collected eye movement data set." ;
    dcterms:bibliographicCitation "Dris AB; Alsalman A; Al-Wabil A; Aldosari M (2019). Intelligent Gaze-Based Screening System for Autism. *2019 2nd International Conference on Computer Applications & Information Security (ICCAIS)*." ;
    dcterms:creator "Al-Wabil A",
        "Aldosari M",
        "Alsalman A",
        "Dris AB" ;
    dcterms:title "Intelligent Gaze-Based Screening System for Autism" ;
    bibo:pmid "local_6230fe22" ;
    fabio:hasPublicationYear 2019 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the sample appropriate and adequate for the stated target?" ;
                            slr:justification "Unknown; the study targets screening before age 2 but reports no participant ages." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are participants and recruitment adequately described?" ;
                            slr:justification "No counts, ages, genders, recruitment route or inclusion criteria for either group." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are comparison groups matched?" ;
                            slr:justification "Not addressed at all." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the behavioral data acquisition described reproducibly?" ;
                            slr:justification "Only the eye-tracker model is given; no stimuli, durations, calibration, viewing conditions or ROI definitions." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the reference standard appropriate and independently applied?" ;
                            slr:justification "No diagnostic information of any kind." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the measurement protocol specified?" ;
                            slr:justification "Number of stimuli, presentation durations and session structure are all absent." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are predictors defined without knowledge of outcome?" ;
                            slr:justification "Fixation durations are automatically computed, but ROI definition is undescribed and could be outcome-informed." ;
                            slr:rating "Unclear" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the sample size adequate and stated?" ;
                            slr:justification "No sample size is reported anywhere, so precision is unknowable." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the validation scheme participant-independent?" ;
                            slr:justification "Leave-one-out at the participant level is described with a cited rationale." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are model configuration and hyperparameters reported?" ;
                            slr:justification "No kernel, no regularisation, no tuning procedure, no software." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is significance or uncertainty quantified?" ;
                            slr:justification "No confidence intervals, permutation tests or confusion matrix." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is there external or independent validation?" ;
                            slr:justification "None; larger-dataset replication is named as future work." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are claims proportionate to the evidence?" ;
                            slr:justification "A high AUC is claimed to show the model 'works well regardless of the class distribution (i.e. when data are new/unknown)', conflating class-distribution invariance with generalisation." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are limitations discussed?" ;
                            slr:justification "No limitations section; only two generic future-work sentences." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the dataset accessible or its access conditions stated?" ;
                            slr:justification "No data availability statement." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is code or an implementation available?" ;
                            slr:justification "None, and no analysis software is even named." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are ethics, consent and privacy handling reported?" ;
                            slr:justification "No ethics approval or consent statement, despite a clinical workflow that collects patient medical history from children." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "high" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Effectively nil. No data availability statement, no code, no software or versions, no SVM kernel or hyperparameters, no ROI definitions, no feature-vector dimensionality, no stimulus materials, no sample sizes, and no random seeds. Neither the experiment nor the analysis could be reproduced from the paper. The only reproducibility-supporting detail is the eye tracker model and a pointer to the prior study whose stimuli and data-collection recommendations were adapted." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-024" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Handcrafted low-dimensional features: mean fixation duration per region of interest, assembled into one feature vector per participant. The paper describes this as incorporating both temporal and spatial information, since duration is temporal and ROI identity is spatial. No raw scanpaths, images or learned embeddings." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-024" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional; no session duration, number of sessions or follow-up is reported. Gaze fixation durations are low-sensitivity data, but the described workflow has a therapist collect patient information and medical history at the pre-analysis stage, which is identifiable clinical data. No ethics approval, no parental consent statement, and no anonymization or data-protection provision appears anywhere - a serious omission for a system designed for clinical deployment with children." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-024" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Replicate with larger datasets to validate the machine-learning performance, and apply and compare other classification techniques against SVM. Both are generic; no specific validation design, population extension or deployment study is proposed." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-024" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Stated only at the highest level: Arabic visual stimuli 'that closely align with the existing English language visual stimuli' of a cited prior study, with data collection following recommendations from the same source. The results section states videos were used as stimuli. No stimulus inventory, count, duration, presentation order, calibration procedure or region-of-interest definition is given, so the elicitation protocol cannot be reconstructed or repeated." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-024" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "'ASD children', 'individuals with ASD', 'ASD patients', 'non-ASD patients', 'patients', 'Autistic or non-Autistic', 'typically developing children', 'individuals with disabilities'. Strongly medicalised: autism is described as 'a mental disorder', 'among the most upsetting disorders of childhood' and 'a harming developmental disorder', and participants are consistently 'patients'. This is the most pathologising terminology encountered in the corpus." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-024" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Not reported. No diagnostic instrument, criteria, clinician or confirmation procedure is described for the ASD group, and typically developing status is asserted without any screening. Since diagnostic label is the classification target and the paper proposes a clinical screening tool, the complete absence of reference-standard information is disqualifying for any diagnostic-accuracy claim." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-024" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2019. The literature review is the paper's strongest section and characterises the field carefully: screening has 'evolved recently from subjective clinical assessments to objective metrics acquired from sensing devices such as gaze-tracking, motion sensors, and speech analytics'; machine learning in autism has 'largely focused on how to select the most effective features from a large feature set on the clinical diagnostic tools to shorten the diagnosis time'; and, most pointedly, 'all presented studies adopted machine learning differently yet there is no automatic prediction model integrated within a screening tool to be used in clinics'. It also documents a geographic gap - a shortage of Arabic-language autism research and uncertain prevalence estimates of 1.4, 29 and 59 per 10,000 children in Oman, the UAE and Saudi Arabia - which is a dimension of coverage bias not raised elsewhere in this corpus." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-024" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Author keywords: Autism Spectrum Disorder, Intelligent, Machine Learning, early diagnoses, speed up screening, early intervention. Task vocabulary: 'intelligent screening', 'gaze-based screening', 'early biomarkers', 'automated data-driven prediction model', 'computer-aid diagnostic tool', 'transformative step'. The 'intelligent system' framing and the emphasis on speeding up screening throughput are distinctive." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-024" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The 2nd International Conference on Computer Applications and Information Security (ICCAIS) 2019 - a general computing and information-security venue, neither an autism, clinical, nor machine-learning-specialist venue." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-024" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two groups are referred to - ASD and typically developing (non-ASD) children - but no participant counts are reported for either group anywhere in the paper. The sample is described only as 'our collected eye movement data set'. This is the only study charted so far that reports classification performance without stating any sample size." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-024" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Single modality, no fusion. Per-ROI mean fixation durations are concatenated into a single feature vector per participant, described as capturing the time distribution of visual attention across regions - a within-modality spatial aggregation rather than multimodal fusion. No integration with clinical scores, demographics or the medical-history data the workflow collects." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-024" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Accuracy (88.6%), specificity (92.31%), sensitivity (86.63%) and AUC (0.96) - a reasonably complete metric set on its face, and the authors explicitly motivate reporting all four. But with no sample size reported, none of the figures carries an interpretable precision, and the two-decimal specificity (92.31%, consistent with 12 of 13) hints at a very small test set. No confusion matrix, confidence intervals or significance testing." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-024" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Leave-one-out cross-validation at the participant level is described and is an appropriate choice, with the rationale cited. Beyond that, nothing: no external or independent validation, no held-out site, no repetition, no permutation or significance testing, no class-imbalance handling or reporting, no calibration, no bias analysis, and no deployment or real-time evaluation despite clinical deployment in Saudi autism centres being the explicit goal. Generalisability is addressed only by the future-work statement that larger datasets are needed." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-024" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Hardware: Tobii X120 remote eye tracker. That is the only technical specification given - no monitor, viewing distance, sampling rate, calibration procedure, or analysis software, library or platform is named. The literature review names WEKA and MATLAB as tools used by other researchers, but the paper never states what it used itself." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-024" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Reported by the authors: only that the model should be replicated with larger datasets to validate performance, and that other classification techniques should be compared. No limitations section exists. Identifiable in review: no sample size is reported, so the precision of the four performance figures is unknowable; no ages, genders or diagnostic procedure, so demographic and ascertainment bias cannot be assessed; no stimulus, ROI or feature specification, so the measurement cannot be evaluated; methods sections are written partly in the future tense, suggesting the system was planned rather than fully executed at time of writing; the claim that a high AUC means the model 'works well regardless of the class distribution (i.e. when data are new/unknown)' conflates class-distribution invariance with generalisation to new data; and the study is framed around screening before age 2 while never reporting the age of any participant." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-024" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Intended clinical setting - autism centres or hospitals in Saudi Arabia, with a therapist-operated workflow. Newly collected data, though nothing about the collection setting, session structure or conditions is described." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-024" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Nothing is reported. No sample sizes, no ages, no age range, no standard deviations, no gender distribution and no matching information for either group. The paper's motivation depends on early screening before age 2, but the age of the children actually tested is never stated, so it cannot be established whether the system was evaluated in the population it targets." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-024" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Gaze: fixation durations within predefined regions of interest during viewing of visual stimuli. Aggregate dwell time only - no scanpath, saccade, pupillometric or temporal-sequence information." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-024" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None reported. No cognitive, linguistic, adaptive or severity measures for either group. The workflow specifies that a therapist collects patient information and medical history in the pre-analysis phase, so such data are presumably gathered, but none is reported or used." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-024" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Supervised learning. Algorithm: support vector machine only, selected because it is used in the cited literature and is a capable binary classifier. No paradigm comparison, no alternative algorithms, and no kernel specification." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-024" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Goal: early screening via an Arabic automated gaze-based system integrating eye tracking with machine learning, to speed up diagnosis and reduce dependence on subjective clinical observation. Main findings as reported: accuracy 88.6%, specificity 92.31%, sensitivity 86.63%, AUC 0.96. The authors claim the AUC is the best among comparable models and argue this means it 'works well regardless of the class distribution', which is an overstatement of what AUC guarantees." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-024" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. No feature importance, ROI ranking or ablation is reported. The results assert that 'using ROIs as features for analysis prove clearly the levels of discrimination between ASD and non-ASD patients' but identify no specific region, direction or effect, so nothing interpretable about autistic visual attention emerges from the study itself." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-024" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "Not reported - no session length, number of stimuli, or per-stimulus viewing duration is given for the authors' own data collection" ;
                    slr:study_design "Proof-of-concept cross-sectional classification study; largely a system-design paper with a results section reporting classification metrics" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: Not reported; comparison: Not reported" ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "Accuracy 88.6%, specificity 92.31%, sensitivity 86.63%, AUC 0.96",
                        "The paper reports an SVM over region-of-interest fixation-duration features achieving 88.6% accuracy, 92.31% specificity, 86.63% sensitivity and an AUC of 0.96 for distinguishing ASD from typically developing children, and presents this as proof of concept for remote eye tracking as an objective screening tool. The substantive contribution is framed as system design - an Arabic-language automated " ;
                    slr:outcome "Accuracy, sensitivity, specificity and area under the ROC curve" ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "Accuracy 88.6%, specificity 92.31%, sensitivity 86.63%, AUC 0.96; The paper reports an SVM over region-of-interest fixation-duration features achieving 88.6% accuracy, 92.31% specificity, 86.63% sensitivity and an AUC of 0.96 for distinguishing ASD from typically developing children, and presents this as proof of concept for remote eye tracking as an objective screening tool. The substantive contribution is framed as system design - an Arabic-language automated " ] ] ;
