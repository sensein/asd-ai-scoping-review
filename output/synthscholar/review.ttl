<urn:slr:article:ff89c89464cc> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Autism spectrum disorder (ASD) refers to a collection of conditions characterized by challenges in areas such as social interactions, communication, and repetitive behavior. Children with autism spectrum disorders often experience difficulties in processing and responding to social cues, which can lead to deficits in social skills and nonverbal communication. Children with ASD have been observed to have problems in maintaining eye contact. The main aim of this study is to use the eye tracking scan path images as a biological indicator to identify children with autism. The dataset used in this study has 547 visualized scanpath images collected from 59 children. The aim of this study is to utilize these scanpath images and formulate an autism diagnosis technique with the help of machine learning algorithms. The proposed model extracts the trainable features from the images and it is fed to a logistic regression classifier and a multi-layer perceptron classifier (MLP). A comparative study between the performance of the proposed model and a custom convolutional neural network is also presented." ;
    dcterms:bibliographicCitation "Kannan RM; Sasikala R (2023). Predicting autism in children at an early stage using eye tracking. *2023 2nd International Conference on Vision Towards Emerging Trends in Communication and Networking Technolo*." ;
    dcterms:creator "Kannan RM",
        "Sasikala R" ;
    dcterms:title "Predicting autism in children at an early stage using eye tracking" ;
    bibo:pmid "local_6b9484ce" ;
    fabio:hasPublicationYear 2023 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Comparison group adequacy" ;
                            slr:justification "Typically developing children from the source dataset, termed 'normal' throughout. No clinical comparison group, no screening information, and no counts." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Handling of missing data and attrition" ;
                            slr:justification "No attrition, quality or completeness accounting appears. Preprocessing is limited to format and colour conversion and resizing; nothing addresses tracking quality, data loss or how images were rendered, all of which are properties of the source dataset that go unreported." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Participant selection and spectrum representativeness" ;
                            slr:justification "Fifty-nine children inherited from a public dataset, described only as two folders. No age, sex, IQ, language level, severity, comorbidity or group size is reported. Representativeness cannot be assessed even in principle from this paper." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Confounder control" ;
                            slr:justification "No covariates are known and none is controlled. Because the input is a rendered image rather than a gaze time series, incidental graphical properties - plotted extent, ink density, line crossings - are available to the model and are indistinguishable from behavioural signal without an interpretability analysis, which is not performed." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Reference standard quality" ;
                            slr:justification "None described. Labels are folder names; no diagnostic instrument, criteria, clinician or process is stated for the 59 children, and the source study's procedure is not summarised." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Index test definition and prespecification" ;
                            slr:justification "Three models compared on one small test set with the best reported, and greyscale conversion adopted partly because accuracy improved. No prespecified operating point." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Measurement standardisation" ;
                            slr:justification "Not assessable and not addressed. The eliciting task, stimuli, eye tracker and scanpath rendering scheme are all unreported, so the measurement chain that produced the images cannot be evaluated at all - a striking gap in a study whose stated contribution is to use eye tracking as a biomarker." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Outcome measurement blinding" ;
                            slr:justification "Feature extraction and classification are fully automated from image files; no human rating enters the pipeline." ;
                            slr:rating "Low" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Performance estimation and chance level" ;
                            slr:justification "A single fixed split with 57 test images, no cross-validation, no repeated splits and no confidence intervals - so the 81.0% versus 78.9% comparison rests on about one image. No majority-class baseline against an implied 59.6% floor, and AUC values are plotted but never quoted. Per-class metrics and confusion matrices are reported, which is a genuine strength and is what exposes the CNN's 0.48 autism-class recall." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Data splitting and leakage control" ;
                            slr:justification "Image-level splitting of 547 images from 59 children with no indication that a child's images were kept together, so each test image has roughly eight siblings in training or validation. No participant-level result is reported." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Preprocessing and feature selection nesting" ;
                            slr:justification "No feature selection occurs and the InceptionV3 extraction layer is chosen a priori on a stated principle. But the greyscale conversion for the custom CNN was adopted after observing improved accuracy on this dataset, so at least one preprocessing choice saw the evaluation data." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Sample size adequacy for the modelling" ;
                            slr:justification "382 training images from roughly 59 children for a from-scratch CNN and a transfer-learning pipeline. The authors correctly identify this as the binding constraint on their results." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Reporting of results and uncertainty" ;
                            slr:justification "Per-class precision, recall and F1 with confusion matrices and ROC curves - better than accuracy alone, and the authors explicitly justify going beyond accuracy because it ignores class imbalance. But no confidence intervals on a 57-image test set, no numeric AUC, and no chance baseline." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Ethics, consent and conflicts" ;
                            slr:justification "No ethics statement, no reference to the source study's approvals, no funding statement and no competing-interests declaration. Defensible in substance for a secondary analysis of published de-identified images, but all four are absent as reporting elements." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Completeness of methods reporting" ;
                            slr:justification "The modelling side is well specified - split counts, all preprocessing steps with dimensions and formulas, a layer-by-layer CNN table, the InceptionV3 extraction point, MLP hidden sizes, optimiser, learning rate, loss, batch size, epochs, platform and framework. The data side is entirely absent - no participants, no task, no equipment, no rendering scheme - and the image-to-child mapping, the one fact needed to assess the evaluation, is not stated. The greyscale formula contains a transcription error (0.144 for blue rather than 0.114)." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Data, code and protocol availability" ;
                            slr:justification "The input dataset is public and cited, so the data are available even though this study releases nothing. No code, no split specification, no seed, no preregistration." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Acknowledgement of limitations" ;
                            slr:justification "One limitation stated, correctly identified as the binding one, with no inflation of the results - the paper calls its own accuracy 'not high' and reports the CNN's poor autism-class performance openly. But nothing is said about the image-level split, the single small test set, the absent participant information or the unexamined question of what the models respond to." ;
                            slr:rating "Unclear" ] ;
                    slr:overall_concern "high" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. A single modality rendered as a single image type, with no fusion, no auxiliary features and no metadata. The three reported models are alternatives compared against each other rather than channels combined. What the comparison does establish, usefully, is a difference in error profile rather than merely in accuracy: the end-to-end CNN is heavily skewed towards the majority class (recall 0.88 versus 0.48) while the ImageNet-pretrained feature extractor plus a simple classifier is balanced (0.85 versus 0.74 for the MLP). That is a real observation about small-sample deep learning - a network trained from scratch on 382 images collapses towards the majority class, while generic pretrained features generalise better - and it is the study's most transferable finding, though the paper frames it in terms of accuracy rather than of what it reveals about training regime." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-107" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "'Children with autism spectrum disorder' and 'ASD child' are used alongside 'normal child' and 'TD child', with the autism/normal contrast appearing repeatedly - 'the gaze patterns of a normal child and a child affected with autism', 'differentiate between a TD child and an ASD child'. The framing is medical-model and at times stronger than the evidence warrants: autism is 'a medical condition which is a result of abnormal brain development', characterised by 'abnormal behaviours' and 'fixation abnormality'. Autistic children are described as people who 'refrain from expressing their feeling in the form of facial expressions' and who 'indulge in various repetitive behaviours'. The intent is plainly not hostile - the paper's motivation is that the existing diagnostic process 'consumes a lot of time and energy of both the children and parents' - but the vocabulary of abnormality is used without qualification and the 'normal' contrast term is the one this review has flagged elsewhere as carrying an implication that 'typically developing' does not. There is no neurodiversity framing and no autistic-community involvement." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-107" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Absent. No diagnostic instrument, criterion, clinician or process is reported for the 59 children, and the labels are taken directly from the folder structure of the downloaded dataset. The introduction does contain a description of how autism is diagnosed in general practice - initial concern about developmental milestones, paediatrician assessment, referral to a psychologist, child neurologist, speech and language pathologist or developmental paediatrician, then behavioural observation, child and parent interviews, questionnaires and the CARS rating scale - and it correctly observes that 'there are no standard definitive tests like blood test to identify the condition'. But none of this is connected to the actual data. The target being predicted is therefore whichever folder an image sits in, and the study inherits without examination whatever ascertainment the source dataset applied. For a review comparing studies partly on the strength of their reference standards, this is the floor." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-107" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Fifty-nine children contributing 547 scanpath images - the fourth independent reuse of this dataset encountered in this review. The study reports nothing further about who those children were: no counts per group, no ages, no sex, no diagnostic information. The dataset is described purely as two folders, 'TCImages' for typically developing children and 'TSImages' for children diagnosed with autism. The modelled unit is the image, and the split is 382 training, 108 validation and 57 test images with no indication that a child's images were kept together. Because 547 images come from 59 children, each child contributes roughly nine images, so under a random image-level split every test image is accompanied by around eight images from the same child in training or validation. The test-set confusion matrix implies 34 typically developing and 23 autism images among the 57 held out, which is the only class-composition information recoverable anywhere in the paper." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-107" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None whatsoever. Not a single demographic or clinical characteristic of the 59 children is reported - no age, no sex, no IQ, no language level, no severity, no comorbidity, no socioeconomic status, no race or ethnicity, and not even the number of children or images in each group. The paper's participant description consists entirely of two folder names. This is the most complete absence of participant information among the included studies, and it follows from the study's nature as a pure dataset-reuse exercise: the authors downloaded images and classified them. The consequence is that nothing can be said about who the model works for, whether the groups were matched on anything, or whether the classification could be driven by an age or sex imbalance between folders - questions that a reader must go to the original dataset publication to answer, and which this paper does not flag as open." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-107" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A rendered scanpath image, resized either to 100x100 greyscale (custom CNN) or 299x299 RGB with pixel values normalised to [-1, 1] (InceptionV3). The greyscale conversion for the CNN is described candidly as an empirical choice: RGB training was slow and 'converting the images to grayscale proved to significantly reduce the training time and an improvement in classification accuracy was also noticed'. That is honest reporting of a decision made partly on observed accuracy, and it is worth noting that if the source rendering used colour to encode anything - fixation order, duration, or which eye - greyscale conversion would discard it, and the paper cannot say whether it did, because the rendering scheme is never described. The deeper representational point is that all temporal information in the original gaze data survives only as visual geometry: sequence order, fixation duration and saccade velocity are recoverable from a drawing only to the extent the renderer encoded them, and the model receives no time series at all." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-107" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Better than the corpus norm for a paper of this scale. Accuracy, precision, recall and F1 are reported per class rather than only in aggregate, confusion matrices are given for the CNN, and ROC curves are plotted for both transfer-learning classifiers. The per-class reporting is what makes the study useful, because it reveals that the custom CNN's 71.9% accuracy conceals autism-class recall of 0.48 - fewer than half the autism images detected, which is below the 59.6% majority-class baseline implied by the confusion matrix. The authors explicitly justify reporting beyond accuracy on the grounds that it 'does not give much importance to the class imbalance in a dataset if at all it exists', which is the right reasoning. Gaps: AUC values are plotted but never quoted numerically; no confidence intervals accompany any figure, although a 57-image test set makes one image worth 1.8 percentage points and therefore makes the 81.0% versus 78.9% comparison uninterpretable; no majority-class baseline is stated; and no participant-level metric is possible given the splitting scheme." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-107" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Visual scanning behaviour, encoded as a picture. A scanpath is defined correctly in the paper as a spatiotemporal representation of consecutive fixations and saccades that may overlap, and the input to every model is a rendered image of that trajectory. The behavioural claim motivating the work is the standard eye-tracking account of autism - that autistic children look away from eyes and mouths and towards background, with the widely cited 2008 observation about a 15-month-old attending more to the mouth than the eyes given as the example. But the study cannot test that claim, because it never reports what the children were looking at and never inspects what the models attend to. What is actually modelled is the appearance of a line drawing, and the properties of that drawing that a convolutional network could exploit include several that are only indirectly behavioural: the total extent of the plotted region, the density of overplotting, the number of line crossings, the aspect ratio of the traversed area. Some of these are informative about looking behaviour; others would follow from a child simply producing more or fewer gaze samples. The representation makes them indistinguishable, and no analysis in the paper separates them." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-107" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The single stated limitation is correct and is stated without defensiveness: accuracy is not high, and this is attributed to the dataset containing only 547 images. The authors do not inflate their results - they describe them as promising for future research rather than as a demonstration of feasibility, and they report the custom CNN's poor autism-class performance rather than burying it. What is unaddressed is nonetheless substantial. The split is by image and not by child, so with roughly nine images per child each test image has around eight siblings in training - the mechanism that has produced very high accuracies in other reuses of this same dataset, and one this paper neither invokes nor guards against. A single fixed split of 57 test images cannot support the three-way accuracy comparison the paper draws, since a difference of 81.0% against 78.9% is a single image. No majority-class baseline is computed, though the confusion matrix implies 59.6%, so the custom CNN's 71.9% is roughly twelve points above trivial and its autism-class recall of 0.48 is below it. The greyscale conversion was adopted partly because it improved accuracy, a decision made against the same small dataset. Nothing is reported about the 59 children. And no analysis addresses what visual property of a drawn trajectory the models respond to." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-107" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Published 2023 by the Department of Computer Science at Vellore Institute of Technology, India, with no reported funding. The framing is the standard workload-and-subjectivity argument: there is no definitive biological test for autism, diagnosis depends on a chain of specialist referrals and subjective instruments, and 'the process of diagnosis itself consumes a lot of time and energy of both the children and parents', so computer-aided methods offering a reliable 'second opinion' are attractive. The paper positions itself within an eye-tracking-for-diagnosis literature that it surveys across several conditions - Parkinson disease, dementia, dyslexia, schizophrenia - before turning to autism, which is a useful reminder that the same modality and often the same architectures are being applied across diagnoses, and that a scanpath classifier reported at 95% for dyslexia and 78.85% for schizophrenia in the cited work is not obviously measuring anything condition-specific. For this review the study's value is not its result but its position: it is the fourth independent reuse of the 547-image dataset encountered here, it applies a different modelling family from the others, and its comparatively modest 81% - obtained under the same image-level splitting that has yielded 97-99% elsewhere - is a useful data point on how much of those higher figures is attributable to method rather than to signal." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-107" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional by inheritance; the study performs no temporal analysis and could not. No ethics statement of any kind appears, which for a secondary analysis of published de-identified images is defensible in substance but is still a reporting omission - the source dataset's approvals are not referenced. No funding statement and no competing-interests declaration appear either. The paper is a four-to-six page conference contribution and these omissions are typical of that format, but they are omissions nonetheless." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-107" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two directions, both aimed at the sample-size constraint the authors identify: use data augmentation, specifically generative adversarial networks, to synthesise additional scanpath images, and expand the dataset itself. The first should be flagged as a hazard rather than a solution in this specific setting - generating synthetic scanpath images from a 547-image corpus and then evaluating on an image-level split would compound rather than mitigate the dependence between training and test data, and would do so invisibly. Expanding the dataset is the sound recommendation. Not proposed: splitting by participant, reporting participant-level accuracy, characterising the children, or examining what the models learn." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-107" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. No class activation mapping, saliency analysis, feature visualisation, error analysis or inspection of misclassified images is reported for any of the three models. The methods section instead provides several paragraphs of general exposition on how convolutional layers, pooling variants and InceptionV3's factorisation techniques work - accurate but generic. The absence is more consequential here than in studies that model interpretable features, because the input is a picture of a behaviour rather than the behaviour itself, so there is a genuine open question about whether the models respond to where the gaze went or to incidental graphical properties such as ink density, plotted extent or line crossing count. A single class activation map over a handful of correctly and incorrectly classified scanpaths would have addressed it directly and would have been the most informative addition the paper could have made." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-107" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two contrasting approaches. The proposed pipeline uses ImageNet-pretrained InceptionV3 as a fixed feature extractor, taking the 2048-dimensional output of the last convolutional layer before global average pooling on the stated principle that layers close to the classifier head carry the most distinctive representations, and feeds these to either logistic regression or a two-hidden-layer MLP (200 and 100 neurons). The baseline is a custom five-level CNN trained from scratch (16, 32, 64 and 128 3x3 filters, ReLU, 2x2 max pooling at each level, flatten to 2048, dense 256, dense 128, sigmoid output) with Adam at learning rate 0.001, binary cross-entropy, batch size 64 and 15 epochs. The choice is appropriate to the data volume and the result vindicates it: with 382 training images, transfer learning outperforms training from scratch by 9 percentage points and, more importantly, produces a balanced rather than a majority-collapsed classifier. The paper describes InceptionV3 as 'fine-tuned' in one place while describing features as extracted from a fixed layer in another, an ambiguity about whether any weights were updated that is not resolved." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-107" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Not reported. The paper never states what the children were looking at when the gaze data were recorded, how long the recording lasted, what the display or eye tracker were, or how the scanpaths were rendered into images. It describes only the general definitions of fixation, blink and saccade from the source experiment, and states that the source study 'provides these visualised scanpath images which is used in the work as a biomarker'. So the study models a representation of a behaviour elicited by an unknown task. Two consequences follow for interpretation. Nothing can be said about whether the discriminative signal is social - the whole rationale offered in the introduction concerns looking at eyes and mouths, but if the stimuli were not faces that rationale does not apply. And the rendering choices that turned gaze coordinates into pictures - line width, colour, marker size, axis scaling, whether fixation duration is encoded as circle radius - are properties of the source dataset that determine what a convolutional network can extract, and none is described." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-107" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Adequate for the modelling, absent for the data. Reproducible: the source dataset is cited and public; the split counts are given exactly (382/108/57); the preprocessing is fully specified including the RGBA-to-RGB conversion, the 100x100 resize, the greyscale luminance formula, the 299x299 resize for InceptionV3 and the [-1, 1] normalisation; the custom CNN is tabulated layer by layer with kernel counts, sizes and output dimensions at each of five levels; the extraction point in InceptionV3 is named; and the MLP hidden layer sizes, optimiser, learning rate, loss, batch size and epoch count are all given. Not reproducible: the specific train/validation/test split, the random seed, and the mapping from images to children - which is the one piece of information needed to determine whether the evaluation is participant-disjoint. There is also a transcription error in the greyscale formula, where the blue coefficient is given as 0.144 rather than the standard 0.114." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-107" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The stated aim is to use eye-tracking scanpath images 'as a biological indicator to identify children with autism' and to compare a transfer-learning-plus-classical-classifier pipeline against an end-to-end custom CNN. Findings: the custom CNN reached 71.9% accuracy, InceptionV3 features with logistic regression 78.9%, and InceptionV3 features with an MLP 81.0%. The per-class analysis is the substantive result and the authors present it properly rather than resting on accuracy. The custom CNN's confusion matrix shows 30 of 34 typically developing images correct against only 11 of 23 autism images - class-wise recall of 0.88 versus 0.48, F1 of 0.79 versus 0.58 - so a model reported at 71.9% accuracy is in fact detecting fewer than half the autism cases, and the authors say so: its 'ability to classify the people affected by ASD was not upto the mark'. The transfer-learning models are markedly more balanced, with class-wise F1 of 0.82/0.75 for logistic regression and 0.84/0.76 for the MLP, and the authors conclude on that basis rather than on the accuracy difference alone. The conclusion attributes the modest overall performance to the small dataset and proposes augmentation and dataset expansion." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-107" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Keywords: autism spectrum disorder, scan path, eye tracking, deep learning, transfer learning. Four of five name the method or modality and none names an application - neither screening, diagnosis nor classification appears, although the body text uses 'autism diagnosis technique' and 'second opinion'. Terms carried through the text: visualised scanpath images, biomarker, gaze disparities, fixation abnormality, hybrid classifier model, InceptionV3, feature extraction." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-107" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A single fixed 70/20/10 split of 547 images into 382 training, 108 validation and 57 test, with the image as the unit. Fifty-nine children produced those 547 images, so roughly nine images per child, and nothing in the paper indicates that a child's images were kept together - so on a random split each test image is accompanied by around eight siblings from the same child. This is the same design flaw that recurs across reuses of this dataset, and it is the reason the review treats the family of studies built on it as a triangulation problem rather than as independent evidence. What makes this particular paper informative is that the leakage does not produce a high number: 81.0% at best, against figures near 97-99% reported by other groups on the identical images. The most plausible reading is that generic ImageNet features plus a shallow classifier extract less individual-identity information from a rendered trajectory than an end-to-end network fine-tuned on the same data - so the gap between this study and the higher-scoring reuses is itself evidence about how much of those higher scores is identity rather than diagnosis. Read alongside the source authors' own participant-level correction to around 71% and another group's one-image-per-child leave-one-out result of 72.88%, this study's 81% sits closer to the honest end of the range than to the inflated one, despite sharing the flawed split. Other weaknesses compound the picture: a 57-image test set with no confidence intervals, so the three-way model comparison rests on differences of one or two images; no cross-validation or repeated splits; no chance baseline against an implied 59.6% floor; and one architectural choice (greyscale conversion) made with reference to observed accuracy on the same data." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-107" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2023 2nd International Conference on Vision Towards Emerging Trends in Communication and Networking Technologies (ViTECoN), IEEE - a general communications and networking engineering conference, not a clinical, biomedical or machine-learning venue. That placement explains the paper's balance: substantial textbook exposition of convolutional networks and InceptionV3 architecture aimed at a non-specialist engineering audience, minimal clinical context, and no participant characterisation at all. It also explains the absence of ethics, funding and competing-interests statements, which such venues do not typically require. The paper is short and does not overreach; the reporting gaps are those of the format as much as of the authors." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-107" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "There is no study setting: all work was performed on Google Colab using a downloaded public dataset, at Vellore Institute of Technology in India, on images collected elsewhere. No children were recruited, tested, observed or consented for this work. This matters for how the study should be weighted in the review: it contributes no new evidence about autistic children and no new data, and its value lies entirely in being an additional independent modelling attempt on a dataset that several other included studies also use - which makes it a comparison point rather than a primary source." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-107" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. No cognitive, language, adaptive or severity measure appears, and none could, since no participants were assessed by these authors. The absence has a specific analytical cost in this design: the scanpath is a picture of where a child looked during an unreported task, and how much a child looks at all - the number of fixations, the spatial extent covered - varies with attention, developmental level and task compliance. Without any measure of those, a difference in the visual density or spread of the plotted trajectory cannot be separated from a difference in social attention. Since the models are given only the drawing, this is precisely the ambiguity that an interpretability analysis would have addressed, and none is performed." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-107" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Google Colab and TensorFlow; InceptionV3 pretrained on ImageNet. That is the entirety of the apparatus, because no data were collected. The eye tracker, display, stimuli and recording software that produced the underlying gaze data are not named, so a reader cannot evaluate the measurement chain at all - a striking situation for a study whose stated contribution is to use eye tracking as a biomarker. The description of InceptionV3's architectural innovations (factorised convolutions, asymmetric factorisation, auxiliary classifiers, efficient grid size reduction) is detailed and accurate but is standard exposition rather than anything specific to this application." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-107" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:study_design "Secondary computational analysis of a publicly available eye-tracking scanpath image dataset; a methods-comparison study contrasting transfer-learned features plus classical classi…" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: ; comparison: Not stated" ] ] ;
    slr:content_sha256 "8121775a2395ebb440a6eee7c78c13e33a91180f8fbc503b3fcfd01c8e9aa0a2" ;
