    slr:journal "JMIR Human Factors, 8(4), e27706" ;
    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "Image counts per group and per child are reported (547 images, average 9.27 per child), and participants are said to have viable data on an average of 15.19 stimuli, but no account is given of which stimuli or children were excluded and why." ],
                [ a slr:RoBDomainJudgment ;
