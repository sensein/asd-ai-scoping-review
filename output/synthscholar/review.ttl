    slr:journal "PLOS ONE, 19(4), Article e0302238. ht" ;
    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "Autism required clinical diagnosis confirmed with ADOS-2, administered by professionals explicitly stated to be independent of the research laboratory and study - a clear statement of independence that few papers here provide. Against this, no ADOS-2 score is reported so the severity range cannot be characterised, and comparison-group status rests on parent and teacher report of no neurodevelopmental disorder with no instrument administered and no assessment of abilities." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "The two feature sets are prespecified and compared directly rather than selected, no feature selection occurs, and the preprocessing is fixed a priori and fully specified. But no model architecture or training hyperparameters are reported, so the comparison between the two models cannot be checked for differences in capacity or training, and no operating point is prespecified." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Twenty children in a case-control arrangement, with autistic participants from a rehabilitation centre that is also a co-author affiliation and where they were receiving psychomotor therapy, and comparison children from a mainstream school recruited 'without specific assessment of their pre-existing abilities'. Comorbidity was excluded from the autistic group, narrowing it relative to the clinical population. No sex, IQ, developmental or severity data for either group, and the autistic group's age standard deviation is nearly ten times the comparison group's." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Seven hundred and thirty-eight trajectories from 20 children, roughly 37 each, partitioned by trajectory rather than by child, with the validation set quoted as 110 samples out of 738 and no statement that folds respected child boundaries. No participant-level result is reported anywhere. Data-inclusion rules are stated clearly (completed drags only, 20-69 points), but the number of trajectories contributed by each child is not reported and session duration varied between children." ] ;
            slr:overall_judgment "high" ;
            slr:tool_used "QUADAS-2" ] .

<urn:slr:article:07a52bccb09c> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Autism spectrum disorder (ASD) is a neurodevelopmental disorder characterized by social deficits that affects a considerable percentage of the global population. Early detection of ASD allows for early intervention and ensures a better prognosis; however, there is a lack of screening tools that can objectively measure social deficiency and calculate the probability of ASD. Joint attention is a social skill that develops from an early age, and poor joint attention skills are thought to be a characteristic feature of ASD. We have devised a protocol for the collection of video data for joint attention from toddlers and preschool-aged children. Ten-second video clips of instances where the participant is expected to initiate joint attention are used as input data for the convolutional neural network-long short-term memory-attention classification model. The model distinguished children with ASD and those demonstrating with typical developmental patterns with high accuracy and precision. We validated our model using an attention mechanism to ascertain that the classifications were made based on certain social gestures rather than on random chance. To that end, this work could be further developed into an automatic computational system for autism screening in the general population, as well as an assistive diagnostic tool for mental health specialists to objectively measure the severity of social deficits." ;
    dcterms:bibliographicCitation "Chanyoung K; Soyeon K; Yu Rang P; Soon-Beom H; Mindong S; Lim J; Bongkyung J (2022). AI-assisted Initiation to Joint Attention Evaluation for Autism Spectrum Disorder Detection. *2022 IEEE 3rd Intern*." ;
    dcterms:creator "Bongkyung J",
        "Chanyoung K",
        "Lim J",
        "Mindong S",
        "Soon-Beom H",
        "Soyeon K",
        "Yu Rang P" ;
    dcterms:title "AI-assisted Initiation to Joint Attention Evaluation for Autism Spectrum Disorder Detection" ;
    bibo:pmid "local_5b7ea7dc" ;
    fabio:hasPublicationYear 2022 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are comparison groups matched on age and sex?" ;
                            slr:justification "Formally tested: age p = 0.697, sex p = 0.857." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are confounding conditions excluded on mechanistic grounds?" ;
                            slr:justification "ADHD, developmental coordination disorder, medication and sensory impairment all excluded because joint attention depends on attention, motor coordination, vision and hearing." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are participants and recruitment adequately described?" ;
                            slr:justification "Recruitment sources named, all 94 children accounted for, demographics tabulated with p values, and the 6 excluded ASD-suspected children explained." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is a comparison group with other developmental conditions included?" ;
                            slr:justification "ADHD and coordination disorder were excluded rather than recruited as contrast groups, leaving specificity untested." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is cognitive level equated between groups?" ;
                            slr:justification "104 versus 58.8, p < 0.001 - a 45-point gap with no adjustment, matched subsample or stratified analysis." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the reference standard appropriate and independently applied?" ;
                            slr:justification "ADOS-2 by two experienced professionals with module-calibrated severity scores, plus DSM-5 and Korean CARS." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the elicitation protocol described reproducibly?" ;
                            slr:justification "Toy distance, size and count, examiner offset angle, wait times, substitution and stopping rules, seating arrangement and camera settings all specified." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the source of the behavioural signal isolated to the child?" ;
                            slr:justification "The examiner responds contingently to the child's initiation, and the paper does not state whether the examiner is in frame or attribute attention spatially." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the protocol grounded in a validated instrument?" ;
                            slr:justification "Adapted from Mundy's Early Social Communication Scales with toys selected per ADOS-2 and ESCS guidelines." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the clip definition principled?" ;
                            slr:justification "Trimmed from the instant of toy placement to 10 seconds, with corrupted acquisitions discarded on stated criteria." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "low" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is uncertainty quantified?" ;
                            slr:justification "No confidence intervals, no cross-validation, and no test for the claimed superiority over prior models." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is model selection documented?" ;
                            slr:justification "No optimiser, learning rate, batch size, epochs, loss function or selection procedure reported." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are the partitions subject-disjoint?" ;
                            slr:justification "All 94 children allocated across training, validation and two test sets with no overlap." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is more than one test set used?" ;
                            slr:justification "Two independent test sets differing in preprocessing, giving a domain-shift check rather than a repeat." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is robustness to acquisition confounds demonstrated?" ;
                            slr:justification "Trained on segmented video, tested on raw video at essentially identical accuracy (0.918 versus 0.916)." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the unit of analysis the participant?" ;
                            slr:justification "Test metrics computed over 416 and 184 clips from only 36 and 18 children; no per-child accuracy reported." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "some concerns" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are ethics and consent reported?" ;
                            slr:justification "Yonsei University IRB no. 4-2021-0845, Declaration of Helsinki, written parental consent after detailed description." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the principal confound acknowledged?" ;
                            slr:justification "The IQ difference is stated as the study's limitation with a call for IQ-matched replication." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the model's decision basis verified rather than asserted?" ;
                            slr:justification "Every attention plot was checked against its video; peaks coincided with observed triadic gaze in typically developing children, and fewer than 1% of autistic children showed both." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the acknowledged confound addressed analytically?" ;
                            slr:justification "Defended by citation to prior literature rather than by any analysis of the present data, despite IQ being available for every child." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the dataset accessible or its access conditions stated?" ;
                            slr:justification "No availability statement of any kind." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is code available?" ;
                            slr:justification "Not mentioned." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the comparative claim against prior work supported?" ;
                            slr:justification "Superiority over models reporting 0.70-0.80 accuracy is asserted without statistical test across incomparable populations." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "some concerns" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Accuracy, precision, recall, F1 and full confusion matrices for both testing sets, plus training and validation accuracy - a complete panel for a conference paper, and reported for both test sets rather than only the better one. The confusion matrices make the error structure legible: on test set #1, 23 of 198 typically developing clips were called autistic against 12 of 218 autistic clips called typical, so the model errs toward false positives, and precision (0.900) sits below recall (0.945) accordingly. Two things are missing and one is consequential. There are no confidence intervals and no per-child accuracy, and since the metrics are computed over 416 and 184 clips originating from only 36 and 18 children, clips from the same child are not independent and the apparent precision of the estimates is overstated - the paper itself describes averaging probabilities per subject for training and validation but does not do so for testing. And there is no comparison against a trivial baseline; given a 45-point IQ gap, a baseline using developmental level alone would be the informative comparator." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-075" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The most carefully constructed elicitation paradigm in the corpus, and the design reasoning is unusually visible. It adapts Mundy's Early Social Communication Scales, a validated manual for eliciting and scoring joint-attention behaviours, together with behaviour-extraction techniques from applied behaviour analysis. Three geometric decisions are justified explicitly. The toy sits 70 cm away on the midline, out of reach, because a nearer toy means the child 'would simply pick up the toy and play with it without making any effort to interact with the examiner' - so the design forces the social bid rather than merely permitting it. The examiner is offset such that seeing their face requires an approximately 45-degree head turn or a substantial gaze shift, which makes the target behaviour large enough to register in 2D video from a front-facing camera. And the examiner provides no verbal instruction and simply waits, so any initiation is spontaneous rather than prompted. The toys are standardised in size (3x5x3 cm) and drawn from ADOS-2 and ESCS guidelines, with pseudo-randomised order and a substitution rule if the child shows no interest. Ten seconds from toy placement defines the analysis window. The whole session takes about 10 minutes. The one unexamined element is that the examiner responds contingently - turning to the toy once the child initiates - so the examiner's behaviour is a function of the child's, and the paper does not state whether the examiner is in frame or whether the model could be reading their response rather than the child's initiation." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-075" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2022. The framing combines the usual prevalence and early-intervention arguments (1 in 59, billions in socio-economic burden, improved outcomes from early detection) with a workforce argument that is more specific and more relevant to the deployment claim: early detection 'does not appear to be feasible, especially in regions where there is a scarcity of mental health specialists'. What distinguishes this paper's positioning is its critique of the immediately preceding work rather than of clinical practice in general. It observes that the Cognoa system, which obtained FDA marketing authorisation, 'may be considered not fully automated as it uses as input for the machine learning model not the actual videos, but human ratings corresponding to the quality of behavior conveyed in each video' - a precise and correct distinction between automating inference and automating measurement that no other paper in this corpus draws. And it criticises Zunino's grasping-kinematics classifier on the ground that 'the targeted gesture is not generally considered an indication of ASD behavior by most mental health specialists', which is a criterion of clinical construct validity rather than of accuracy. Those two criticisms jointly define the paper's design: raw video in, and a behaviour clinicians already accept as diagnostic as the target. The conclusion's comparative claim - higher accuracy and F1 than prior models reporting 0.70-0.80 - is asserted without statistical test and across studies with different populations and IQ distributions, which sits oddly against the care of the critique that opens the paper." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-075" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Correct in its most important respect and incomplete in a secondary one. The partition is subject-disjoint: 40 children in training and validation (16+16 and 4+4), 36 in test set #1, 18 in test set #2, accounting for all 94 participants with no child in more than one partition. This forecloses the identity-leakage route that inflates several other studies here, and it is the reason 0.916 can be compared to Kojovic's 80.9% and Han's 95.56% rather than to segment-level figures. Two independent test sets rather than one is a further strength, and making them differ in preprocessing turns the second into a domain-shift check rather than a redundant repetition. What is incomplete: the reported test metrics are clip-level, computed over 416 and 184 clips rather than over 36 and 18 children, so within-child correlation inflates the apparent precision even though it does not bias the point estimate; the paper describes per-subject probability averaging for training and validation but not for testing, and no per-child accuracy appears. There is also no cross-validation - a single fixed split with 32 training children - so the estimate carries no measure of split-to-split variability, and no external cohort or site. Finally, whatever architecture and hyperparameter selection occurred is undocumented, so it cannot be established that the validation set was used only once." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-075" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Acquisition is a single consumer camera - a Sony DSC-RX100 IV at 1920x1080 and 30 fps, front-facing - with no depth sensor, marker, wearable or eye tracker, which is the practical argument for the approach: the same behaviour is measured elsewhere with eye-tracking hardware or motion capture. Physical setup is specified to the centimetre (70 cm toy distance, 3x5x3 cm toys, 45-degree examiner offset, height-adjustable chair with the child's right elbow and wrist on the table). Modelling uses ImageNet-pretrained VGG-16 with the last convolutional layer retained for its spatial structure, a two-layer 512-dimensional LSTM, a soft attention module, and a classifier head of 512-unit FC, ReLU, dropout 0.5 and a 512-to-2 FC layer. Semantic segmentation isolates the foreground human, though the segmentation method itself is not named." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-075" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Good on protocol and architecture, thin on training procedure. Fully specified: the elicitation protocol with all distances, timings, toy specifications and examiner rules; camera model, resolution and frame rate; clip trimming rule (from toy placement, 10 seconds, 300 frames); the discard criterion for corrupted acquisitions; final clip counts by group (484 and 434 of 918); the exact composition of all four partitions by group and by clip count; the full network specification layer by layer; the attention formulation; and the difference in preprocessing between test sets. Not reported: optimiser, learning rate, batch size, epochs, loss function, any regularisation beyond the single dropout layer, the semantic segmentation method, random seeds, or any statement of how architecture or hyperparameters were selected. No code or data release. For a conference paper the protocol reporting is exemplary and the training reporting is incomplete." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-075" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "'children with ASD', 'ASD children', 'ASD and TD children', 'individuals with ASD', against 'typically developing (TD) children', 'TD individuals'. Person-first in the fuller constructions, acronym-as-modifier elsewhere. Autism is framed conventionally as 'impairment in social interaction and communication, and restricted, repetitive patterns of interests and behaviors', and the socio-economic framing is burden-oriented, citing 'the socio-economic burden that stems from caring for ASD' in billions of dollars and, in the conclusion, a hope to 'reduce the burden on the parents'. The word 'patients' appears once for the children. The framing of joint attention itself is comparatively constructive, describing it as 'a high-level social skill and a valid indicator of social brain development' rather than as a deficit to be catalogued." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-075" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A single, precisely defined social behaviour: initiation of joint attention, operationalised as the triadic gaze - 'a triadic gaze where the child shifts their gaze from the object at hand to the person they wish to interact with and back to the object, or from the person to the object and back to the person', sometimes accompanied by a point. This is the narrowest behavioural target in the corpus and the choice is deliberate and defended: joint attention is described as 'a high-level social skill and a valid indicator of social brain development', develops early in typical children, and is measured by a validated manual (ESCS). The contrast with the rest of this literature is instructive - where most studies extract many features from an unconstrained behaviour stream and let a model find what discriminates, this study constructs a paradigm to elicit one behaviour that clinicians already regard as diagnostic, then asks whether a model can see it. That inverts the usual relationship between the computational method and the clinical construct." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-075" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two directions, both well chosen. Replicate with IQ-matched cohorts - which follows directly from the acknowledged confound and is the single analysis that would establish whether the result is about autism or about developmental level. And extend from binary classification to continuous prediction of social-function deficit severity, to serve 'as an objective assessment tool that can be used in conjunction with currently available symptom severity measurement questionnaires and clinical scales'. The second is well supported by data already in hand, since ADOS-2 calibrated severity scores, CARS totals and human-rated IJA scores were all collected and none was related to model output; the severity-regression analysis is available in this dataset and simply was not run." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-075" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Keywords: AI-assisted diagnosis, autism spectrum disorder, behavioral biomarker, early detection model, joint attention. 'Behavioral biomarker' is the term doing the conceptual work - the paper's claim is that joint attention functions as a biomarker in the absence of any biological one, stated directly as 'there is no definitive biomarker for ASD'. 'AI-assisted diagnosis' rather than 'screening' in the keyword list sits slightly ahead of what the study demonstrates, though the body of the paper is more careful, describing the intended use as screening plus an assistive tool for specialists." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-075" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "One limitation is stated and it is the right one: 'there is a statistically significant difference in IQ between the ASD and TD children. IQ is known to affect one's ability to perform behavioral tasks and joint attention', followed by the conclusion that 'a replication study using a sample of IQ-matched ASD and TD cohorts is therefore required'. The framing is honest, though the accompanying defence - that 'even when IQ is considered, joint attention still proved to be an important trait to differentiate ASD from TD children' - rests on a citation to prior literature rather than on any analysis of the present data, and no covariate adjustment or matched subsample is attempted despite IQ being measured for every child. Unaddressed: that test metrics are computed over clips rather than children, so effective sample sizes are 36 and 18 rather than 416 and 184; that the training set comprises only 32 children; that the target behaviour is separately scored by a human rater in this very study with near-complete group separation, so the model automates an existing measurement rather than revealing a new one; that ADHD and developmental coordination disorder were excluded rather than used as contrast groups, leaving specificity untested; that the examiner responds contingently to the child; and that the closing comparison against prior models reporting 0.70-0.80 accuracy is made without any statistical test and across incomparable populations." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-075" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Raw video reduced only by clip trimming and, for three of four partitions, foreground segmentation. There is no hand-engineered representation at all: no head pose, no gaze vector, no skeleton, no facial landmarks. This is a meaningful methodological position given that the target behaviour is a gaze shift, which the pose-estimation literature would extract explicitly. The tradeoff is visible in the results - the model works, but nothing about the representation is inspectable, and interpretability has to be recovered afterwards through the attention weights. The temporal unit is fixed at 10 seconds from toy placement, which encodes an assumption that a genuine initiation will occur within that window; the paradigm's 30-second wait before each trial makes that assumption defensible but it is not tested." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-075" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two groups, both explicitly sized and accounted for: 50 typically developing children (27 male) and 44 autistic children (22 male), from an initial 50 ASD-suspected recruits of whom 6 were excluded for ADOS-2 calibrated severity scores below 3. Recruitment sources are named - the Child and Adolescent Psychiatry Division of Seoul National University Hospital for the clinical group and preschools for the comparison group. All 94 children are allocated across the three partitions without overlap: 40 to training and validation, 36 to test set #1, 18 to test set #2. No other-diagnosis comparison group, which matters here because ADHD and developmental coordination disorder were deliberately excluded rather than recruited as contrast groups - so the model is never asked to make the discrimination that would distinguish autism-specific joint-attention impairment from impairment secondary to attention or motor difficulty." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-075" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "IQ was measured for every child using an age-appropriate instrument - Korean WPPSI-IV for older children, Korean Bayley Scales-II for younger - and combined into a best-estimate figure, which is the right approach for a sample spanning 24 to 72 months. The result is the study's central confound rather than a control. Comorbidity was handled by exclusion and the exclusions are mechanistically reasoned: because joint attention depends on 'perception, attention, and motor coordination', children were required to have normal or corrected vision and normal hearing and were excluded for pharmacological treatment, developmental coordination disorder, ADHD, and any other neurological or psychiatric condition. This is a more thoughtfully constructed exclusion set than most in the corpus, since each element removes a plausible non-autism cause of failing the specific target behaviour. No adaptive functioning or language measure is reported." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-075" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "CNN-LSTM with soft attention over raw video - a standard action-recognition architecture, applied without modification and without comparison to alternatives. Only one model is reported: no baseline, no ablation over architecture, no simpler comparator such as a frame-averaged CNN or a hand-engineered gaze-shift detector, and no chance or trivial baseline. The architectural choices are nonetheless well reasoned for the task. The last convolutional layer of VGG-16 is retained specifically because it 'preserves the spatial information' as a 7x7 grid of 512-dimensional vectors rather than a globally pooled summary, which matters when the discriminative event is a head turn at a particular image location. The LSTM supplies temporal structure, necessary because the target behaviour is a sequence - object, then person, then object - not a static configuration. And the attention module is included not for performance but for inspectability, which is how it is actually used." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-075" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "IEEE 3rd International Conference on Human-Machine Systems (ICHMS) 2022, DOI 10.1109/ICHMS56717.2022.9980778 - an engineering conference, four pages. The author list is genuinely clinical-computational: the Department of Biomedical Systems Informatics at Yonsei University College of Medicine, the Division of Child and Adolescent Psychiatry at Seoul National University College of Medicine, the Department of Child Development and Family Studies at Seoul National University, and one industry author. That composition explains the paper's characteristic shape - protocol design and diagnostic characterisation at journal standard, training details at conference standard. Funded by the Korean government's IITP programme (2022-0-00234)." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-075" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Single modality - 2D RGB video only, with no audio, depth, gaze tracking or motion capture. No fusion is attempted or claimed. Within the modality the paper does run a preprocessing comparison that functions like an ablation: training, validation and test set #2 used semantically segmented video with the foreground human isolated so that 'most of the background noise (color of wallpaper, color of child's clothes, etc.) was reduced', while test set #1 was left raw. Accuracy was 0.918 on the segmented test set and 0.916 on the raw one, with autistic-class accuracy 94.5% versus 92.1%. Because the model was trained only on segmented video, its near-equivalent performance on raw video is a domain-shift result rather than a like-for-like comparison, and it constitutes direct evidence that the classifier is not depending on room or clothing cues - the confound that the skeletonisation approach elsewhere in this corpus removes by construction. The authors read the small drop as expected background distraction, which is a reasonable interpretation." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-075" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The strongest video-model interpretability analysis in the corpus, and the reason this short paper matters. Rather than presenting an attention heatmap and asserting that it looks sensible, the authors used the soft attention weights as a testable hypothesis about mechanism: they plotted the alpha values across all 300 frames for every clip and then checked each plot against the corresponding video to see whether a rise coincided with a specific social gesture. The finding is stated with appropriate precision - for typically developing children a distinct rise to at least twice baseline was 'invariably noted' somewhere in the sequence, though its onset and duration varied between children, while for autistic children attention weights 'did not change significantly throughout the duration of the video clip'. Crucially both directions are checked: every attention peak in a typically developing child coincided with an observed IJA behaviour, and across the whole dataset fewer than 1% of autistic children showed both an IJA behaviour and a corresponding peak. That establishes correspondence rather than mere plausibility, and it means the model's decision can be traced to the occurrence or non-occurrence of the clinically defined behaviour the protocol was designed to elicit - which is exactly the claim most deep-learning studies in this corpus make without evidence. The illustrative figure showing frames 80, 140, 180 and 240 for one child from each group makes the mechanism concrete. What is not done: attention is temporal only, with no spatial attribution showing which part of the frame is used, so it cannot be verified that the model is watching the child rather than the contingently responding examiner." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-075" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional, single session, no follow-up. Ethics are reported in full for a conference paper: approval by the Yonsei University IRB under number 4-2021-0845, conduct in accordance with the Declaration of Helsinki, and written informed consent from parents 'after receiving a detailed description of the study'. The data are identifiable video of young children, and although semantic segmentation removes background it retains faces; two children appear in published figures identified by participant codes. No data availability statement, no code release and no description of how the video corpus is stored or protected." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-075" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Seoul, South Korea. The clinical group came from the Child and Adolescent Psychiatry Division of Seoul National University Hospital and the comparison group from preschools - a recruitment asymmetry of the kind that elsewhere in this corpus introduces setting confounds, but mitigated here because the paradigm itself is identical for both groups and highly constrained: same quiet room arrangement, same height-adjustable chair, same 70 cm toy placement, same 45-degree examiner offset, same ten toys, same 30-second waits. The paper also states that videos 'were acquired at different locations with various background noises' and treats the model's robustness across them as evidence for generalisability - which the train-on-segmented, test-on-raw result supports more directly than the assertion alone would." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-075" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Fully reported and formally tested, which is uncommon in this corpus. Autistic group: 44 children, 22 male (50.0%), 46.9 +/- 13.0 months, median 49.0, range 24-68. Comparison group: 50 children, 27 male (54.0%), 47.9 +/- 12.5 months, median 48.5, range 25-72. Age p = 0.697 by t-test; sex p = 0.857 by chi-squared; both groups therefore genuinely matched on the two standard demographic variables and shown to be so. The decisive difference is cognitive: best-estimate IQ 104 +/- 17.4 in the comparison group against 58.8 +/- 18.6 in the autistic group, p < 0.001 - a 45-point gap placing the autistic group's mean firmly within the intellectual disability range. IQ was measured with the Korean WPPSI-IV or the Korean Bayley Scales depending on the child. The gap is acknowledged as the study's chief limitation but is not addressed analytically: no covariate adjustment, no IQ-matched subsample, no stratified analysis. Since joint attention emerges developmentally and is sensitive to cognitive level, and since the autistic group averages roughly a 45-point deficit, a substantial part of the classification could reflect developmental level rather than autism specifically." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-075" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Goal: build a screening tool whose input is raw video and whose target behaviour is one that clinicians already regard as diagnostically meaningful, addressing two named shortcomings in prior work - that the Cognoa-derived system feeds human ratings rather than video into the model, and that Zunino's grasping-kinematics approach targets a gesture 'not generally considered an indication of ASD behavior by most mental health specialists'. Main findings: 0.916 accuracy, 0.900 precision, 0.945 recall and 0.922 F1 on a subject-disjoint raw-video test set of 36 children; 0.918 accuracy on a second, background-reduced test set of 18 children; and an attention analysis showing that typically developing children produce a distinct attention peak coinciding with an observed triadic gaze shift while autistic children produce flat attention profiles, with fewer than 1% of autistic children showing both." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-075" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Strong for a four-page conference paper. Diagnosis was made under DSM-5 criteria. The ADOS-2 was administered by two experienced professionals to all children referred for suspected autism, and because different modules were used according to age and language level, raw scores were converted to calibrated severity scores - total, social affect and restricted/repetitive - which is the correct procedure for comparing across modules and is done in only a minority of studies here. The paper states the CSS interpretation bands explicitly (1-3 non-spectrum, 4-5 ASD, 6-10 Autism) and applies them: 6 of the 50 initially recruited ASD-suspected children scored below 3 and were excluded, leaving a group with a mean CSS of 6.00, in the 'Autism' band. The Korean CARS was also administered with its 25.5 high-risk cut-off, and comparison children averaged 15.5 against 30.9 for the autistic group. The ascertainment therefore combines DSM-5 criteria, a module-calibrated observational instrument, a rating scale, and an explicit exclusion rule applied to borderline cases." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-075" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "One session of approximately 10 minutes per child, yielding roughly 9 usable 10-second clips per participant" ;
                    slr:study_design "Cross-sectional case-control classification with subject-disjoint training, validation and two separate testing sets, one of which is deliberately left unprocessed to test robustne…" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Toddlers and preschoolers with autism, mostly with co-occurring intellectual disability" ;
                    slr:sample_size_text "ASD/index: 44 retained from 50 recruited; comparison: 50" ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "A CNN-LSTM-attention model reading 10-second video clips of a structured joint-attention probe separated autistic from typically developing children at 0.916 accuracy and 0.922 F1 on a subject-disjoint test set. The result held at 0.918 when the model was applied to raw, unsegmented video despite having been trained on background-removed clips, indicating that it is not relying on room or clothing",
                        "Training accuracy 98.9%, validation 97.0%. Test set #1 (raw video, 36 children, 416 clips): accuracy 0.916, precision 0.900, recall 0.945, F1 0.922, with 175 of 198 typically developing clips (88.4%) and 206 of 218 autistic clips (92.1%) correctly classified. Test set #2 (background-reduced, 18 children, 184 clips): accuracy 0.918, precision 0.880, recall 0.953, F1 0.915, with 88 of 99 (88.9%) and" ;
                    slr:outcome "Accuracy on training and validation; accuracy, precision, recall, F1 and full confusion matrices on both testing sets" ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "Training accuracy 98.9%, validation 97.0%. Test set #1 (raw video, 36 children, 416 clips): accuracy 0.916, precision 0.900, recall 0.945, F1 0.922, with 175 of 198 typically developing clips (88.4%) and 206 of 218 autistic clips (92.1%) correctly classified. Test set #2 (background-reduced, 18 children, 184 clips): accuracy 0.918, precision 0.880, recall 0.953, F1 0.915, with 88 of 99 (88.9%) and; A CNN-LSTM-attention model reading 10-second video clips of a structured joint-attention probe separated autistic from typically developing children at 0.916 accuracy and 0.922 F1 on a subject-disjoint test set. The result held at 0.918 when the model was applied to raw, unsegmented video despite having been trained on background-removed clips, indicating that it is not relying on room or clothing" ] ] ;
