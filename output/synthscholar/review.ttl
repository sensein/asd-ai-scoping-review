            slr:assessed_on "full_text" ;
            slr:decision "include" ;
            slr:decision_rationale "Full text confirms a primary computational study: 126 five-year-olds comprising approximately 99% of that age cohort in Sazacho, Nagasaki Prefecture, assessed during routine preschool medical examinations; a 48 cm pressure sensor recording centre-of-pressure distribution synchronised at 20 Hz with a webcam from which OpenPose estimated ten joint angles; 16 explanatory variables spanning centre-of-pressure sway, overall balance and correlations between joint angles and centre-of-pressure movement; a linear-kernel support vector machine evaluated by leave-one-out cross-validation across three variable sets; and SHAP feature attribution plus correlation of predicted probability with SRS-2 total score. Eligible on all criteria, with the important qualification that the target is a Social Responsiveness Scale screening cut-off rather than a clinical diagnosis - so this is autistic-trait screening in a general population rather than case-control diagnosis, which is why it is charted separately from the diagnostic studies." ;
            slr:full_text_source "user_supplied_pdf" ;
            slr:screening_stage "full_text" ],
        [ a prov:Activity,
                slr:ScreeningDecisionRecord ;
