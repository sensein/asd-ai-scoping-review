            slr:overall_judgment "high" ;
            slr:tool_used "QUADAS-2" ] .

<urn:slr:article:fb313da99be3> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "In the present work, we have undertaken a proof-of-concept study to determine whether a simple upper-limb movement could be useful to accurately classify low-functioning children with autism spectrum disorder (ASD) aged 2–4. To answer this question, we developed a supervised machine-learning method to correctly discriminate 15 preschool children with ASD from 15 typically developing children by means of kinematic analysis of a simple reach-to-drop task. Our method reached a maximum classiﬁcation accuracy of 96.7 % with seven features related to the goal-oriented part of the movement. These preliminary ﬁndings offer insight into a possible motor signature of ASD that may be potentially useful in identifying a well-deﬁned subset of patients, reducing the clinical heterogeneity within the broad behavioral phenotype." ;
    dcterms:bibliographicCitation "Crippa A; Salvatore C; Perego P; Forti S; Nobile M; Molteni M; Castiglioni I (2015). Use of Machine Learning to Identify Children with Autism and Their Motor Abnormalities. *Journal of Autism and Develo*." ;
    dcterms:creator "Castiglioni I",
        "Crippa A",
        "Forti S",
        "Molteni M",
        "Nobile M",
        "Perego P",
        "Salvatore C" ;
    dcterms:title "Use of Machine Learning to Identify Children with Autism and Their Motor Abnormalities" ;
    bibo:pmid "local_0dbc5018" ;
    fabio:hasPublicationYear 2015 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are comparison groups matched on the variables that matter?" ;
                            slr:justification "Mental-age matched and gender-balanced, but chronological age and IQ differ significantly between groups." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the sample appropriate and adequate for the stated target?" ;
                            slr:justification "n=30 total for a diagnostic classification claim; explicitly acknowledged by the authors as the main limitation." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are participants and recruitment adequately described?" ;
                            slr:justification "Recruitment route, inclusion characteristics, demographics, IQ and mental age all reported in Table 1." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the behavioral data acquisition described reproducibly?" ;
                            slr:justification "Camera count, sampling rate, spatial accuracy, marker placement, filter settings and trial structure all specified." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the task appropriate for the population?" ;
                            slr:justification "Deliberately simple and non-verbal so that low-functioning 2-4 year-olds could comply; all participants completed it." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are predictors defined without knowledge of outcome?" ;
                            slr:justification "Kinematic features are computed automatically from marker trajectories." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the reference standard appropriate and independently applied?" ;
                            slr:justification "Independent two-clinician DSM-IV-TR diagnosis, but ADOS only for 7 of 15." ;
                            slr:rating "Partly" ] ;
                    slr:overall_concern "low" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the validation scheme free of leakage and selection optimism?" ;
                            slr:justification "Reported accuracy is the maximum across 17 feature-subset sizes on the same 30 subjects; FDR ranking not shown to be recomputed within folds." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the sample size adequate for the number of candidate features?" ;
                            slr:justification "17 candidate features against 30 participants." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are confounders handled in the predictive model?" ;
                            slr:justification "IQ and chronological age are covariates in the ANCOVA only, not controlled in the SVM." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is there external or independent validation?" ;
                            slr:justification "None; the authors state this is needed." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are ethics, consent and privacy handling reported?" ;
                            slr:justification "Written informed consent from legal guardians and ethics-board approval under the Declaration of Helsinki; funding sources declared with a no-role statement." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the dataset accessible or its access conditions stated?" ;
                            slr:justification "No data availability statement." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is code or an implementation available?" ;
                            slr:justification "MATLAB toolbox named and the pipeline cited to prior work, but no code released." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are sample bias, imbalance and generalisability discussed?" ;
                            slr:justification "An unusually candid limitations section: sample size, sample specificity, missing females and high-functioning cases, absent comparison conditions, base-rate caveat." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "some concerns" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Hardware: SMART D optoelectronic system (BTS Bioengineering) with eight infrared cameras at 60 Hz, sub-0.2 mm accuracy; 1-cm passive markers on wrists, hand dorsum, ball and box. Software: MATLAB R2013b with the biolearning toolbox, fifth-order Butterworth 8-Hz low-pass filter, self-written segmentation and parameter-estimation code." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-002" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A structured reach-grasp-drop task: grasp a 6-cm ball from a support and drop it into a 7-cm hole in a transparent box, 10 trials per child (5 per hand, counterbalanced), demonstrated non-verbally by the experimenter with individually varying practice trials." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-002" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Clinical/laboratory setting at an Italian research hospital. Newly collected data (ASD group recruited over 18 months; controls via pediatricians and kindergartens); no existing dataset used." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-002" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Single modality; no fusion across behavioral modalities. IQ and chronological age are used as ANCOVA covariates in the group comparison but are not combined with kinematics in the classifier." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-002" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "ASD n=15, 3F/12M, chronological age 3;5 +/- 7.7 (2.8-4.6 yrs), IQ 75 +/- 13.4; TD n=15, 2F/13M, chronological age 2;6 +/- 5.2 (1.7-2.9 yrs), IQ 105 +/- 12.7. Matched on mental age (2;6 vs 2;7, n.s.) and gender-balanced, but NOT chronological-age matched (p<0.001) and IQ differed (p<0.001)." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-002" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Motor behavior: 3D upper-limb kinematics (velocity, acceleration, deceleration profiles, movement units, movement duration and wrist orientation) during a goal-directed reach-grasp-drop action." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-002" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Replicate in a larger sample with a truly held-out dataset; extend to females, high-functioning children and adults; also train against chronological-age-matched controls; collect full ADOS to correlate kinematics with clinical severity; add other neurodevelopmental conditions to test ASD specificity; guide follow-up neuroimaging or genetic work on the identified phenotype." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-002" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Fisher discriminant ratio scores rank the features, and the full 17-feature ordering across the 30 LOO rounds is reported. Most informative: total duration, delta wrist angle and number of movement units of the transport sub-movement - interpreted as slower, more fragmented goal-directed movement with atypical hand inclination." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-002" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Supervised learning. Algorithm: linear-kernel support vector machine, with Fisher discriminant ratio feature ranking as the selection step." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-002" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2015. The paper characterises prior pattern-classification work in ASD as dominated by neuroimaging (structural MRI, DTI) with only isolated behavioral examples (automated vocal analysis), and positions kinematics as a cheaper, less intrusive alternative - an explicit statement of the field's shift from neuroimaging toward behavioral signals." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-002" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Author keywords: Autism spectrum disorder; Kinematics; Classification; Machine learning; Support vector machines. Task vocabulary: 'computer-aided diagnosis', 'pattern classification', 'predict group membership', 'motor signature of autism', 'proof-of-concept'." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-002" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two groups: ASD (n=15, low-functioning preschool) and typically developing controls (n=15). Both explicitly reported with demographics in Table 1. No other-diagnosis comparison group." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-002" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Handcrafted kinematic summary features - 17 scalar measures derived from segmented sub-movements (durations, movement units, peak velocity/acceleration/deceleration and their timings, wrist-angle change), not raw time series." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-002" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Goal: proof-of-concept binary classification (computer-aided diagnosis) of low-functioning preschool ASD from a simple upper-limb movement. Main findings: maximum accuracy 96.7% (specificity 93.8%, sensitivity 100%) with seven features; overall mean accuracy 84.9%; all discriminative features belong to the goal-directed transport sub-movement, suggesting a motor signature tied to movement-sequence planning." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-002" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional - a single ~15-minute session per child. Data are marker-based 3D kinematics rather than video or audio, so less directly identifying; informed written consent from legal guardians and institutional ethics-board approval under the Declaration of Helsinki are reported, but no anonymization or data-protection procedure is described." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-002" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Journal of Autism and Developmental Disorders - an autism-specific clinical journal, not a computational venue." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-002" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Leave-one-out cross-validation over 30 subjects, described as returning an almost unbiased error estimate. No external or independent test set (the authors explicitly name this as the main limitation), no held-out site, no class-imbalance handling (groups are balanced 15/15), no statistical test on classification performance, and no real-time or deployment claim - though practical feasibility is argued from the 15-minute session and 30-minute analysis time." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-002" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Yes - IQ and mental age assessed with the Griffiths Mental Development Scales for all participants; ADOS Social/Communication and Stereotyped Behavior and Restricted Interests subscores reported for the 7 children who received ADOS. Comorbidities: participants were drug-naive with normal/corrected vision; other neurodevelopmental conditions were excluded from the design and flagged as future work." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-002" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "'children with autism (ASD)', 'children with ASD', 'low-functioning autistic children', 'patients', 'typically developing (TD) children', 'healthy controls', 'clinical group'. Predominantly person-first with occasional 'autistic children' and clinical framing ('patients')." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-002" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Accuracy, specificity, sensitivity. Headline: 96.7% / 93.8% / 100% at seven features; mean across feature-subset sizes 84.9% / 89.1% / 82.2%. No AUC, F1 or confidence intervals." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-002" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Reported by the authors: very small sample; classifier highly specific to the training sample (preschool, low-functioning); need for females, high-functioning children and adults; no ADOS on the full sample; no other neurodevelopmental comparison groups; predictive value constrained by population base rate. Identifiable in review: strong male skew (25/30 male); chronological-age and IQ imbalance between groups confounded with diagnosis; single-site recruitment; maximum-over-feature-subsets accuracy reporting; feature selection not demonstrably nested within the LOO loop." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-002" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No data availability statement and no code release; the SVM pipeline is cited to prior work (Salvatore et al. 2013) and the feature set and validation scheme are described in enough detail to re-implement in principle, but no hyperparameters beyond 'linear kernel', no seeds and no released data. Not reproducible as reported." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-002" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "DSM-IV-TR diagnosis by a child neuropsychiatrist specialised in autism, independently confirmed by a child psychologist via direct observation and parent discussion. ADOS was administered to only 7 of the 15 ASD children, so the gold-standard instrument does not cover the whole clinical sample." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-002" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "Single session; 10 trials per participant (5 left hand, 5 right hand); testing session ~15 minutes, ~30 minutes analysis per subject; ASD group recruited over an 18-month period" ;
                    slr:study_design "Cross-sectional case-control classification study (proof-of-concept)" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder (low-functioning, preschool)" ;
                    slr:sample_size_text "ASD/index: 15; comparison: 15" ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "Kinematic analysis of a simple reach-grasp-drop task discriminated low-functioning preschool children with ASD from mental-age-matched TD peers with up to 96.7% accuracy using only seven features, all belonging to the goal-directed transport sub-movement. The authors interpret slower, more fragmented goal-oriented movement with atypical wrist inclination as a possible motor signature of autism ref",
                        "Maximum accuracy 96.7% (specificity 93.8%, sensitivity 100%) with seven selected features; overall mean across feature-subset sizes 84.9% accuracy (mean specificity 89.1%, mean sensitivity 82.2%)" ;
                    slr:outcome "Accuracy, specificity, sensitivity (with the maximum and the mean across feature-subset sizes reported)" ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "Maximum accuracy 96.7% (specificity 93.8%, sensitivity 100%) with seven selected features; overall mean across feature-subset sizes 84.9% accuracy (mean specificity 89.1%, mean sensitivity 82.2%); Kinematic analysis of a simple reach-grasp-drop task discriminated low-functioning preschool children with ASD from mental-age-matched TD peers with up to 96.7% accuracy using only seven features, all belonging to the goal-directed transport sub-movement. The authors interpret slower, more fragmented goal-oriented movement with atypical wrist inclination as a possible motor signature of autism ref" ] ] ;
