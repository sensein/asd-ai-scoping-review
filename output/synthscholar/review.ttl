    slr:journal "Pattern Recognition, 173, Article 112906" ;
    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "None exists. Labels are folder membership in a public collection; no diagnostic instrument, clinician judgement or record is cited for any image." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Whole face images from uncontrolled internet photographs with pose, illumination, resolution and compression free to vary with collection route. A quality filter requiring a visible frontal face with eyes, nose and mouth is applied - genuine quality control for this branch - but introduces a selection whose class balance is unreported." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Image-level stratified splitting with exact partition sizes reported and a single split acknowledged with its reason - but the number of distinct children is unreported so subject overlap cannot be excluded, and the autism model's reported metrics are mutually incompatible on its own stated test set with no reconciliation offered." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "A public Kaggle image assembly whose autistic class was harvested from autism-associated online sources, with the number of distinct children unreported and no demographic information for either class - the last acknowledged by the authors as limiting generalisation." ] ;
            slr:overall_judgment "high" ;
            slr:tool_used "QUADAS-2" ] .

<https://doi.org/10.1136/bmjopen-2018-026226> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Introduction Recent evidence suggests an underlying movement disruption may be a core component of autism spectrum disorder (ASD) and a new, accessible early biomarker. Mobile smart technologies such as iPads contain inertial movement and touch screen sensors capable of recording subsecond movement patterns during gameplay. A previous pilot study employed machine learning analysis of motor patterns recorded from children 3–5 years old. It identified those with ASD from agematched and gender-matched controls with 93% accuracy, presenting an attractive assessment method suitable for use in the home, clinic or classroom. Methods and analysis This is a phase III prospective, diagnostic classification study designed according to the Standards for Reporting Diagnostic Accuracy Studies guidelines. Three cohorts are investigated: children typically developing (TD); children with a clinical diagnosis of ASD and children with a diagnosis of another neurodevelopmental disorder (OND) that is not ASD. The study will be completed in Glasgow, UK and Gothenburg, Sweden. The recruitment target is 760 children (280 TD, 280 ASD and 200 OND). Children play two games on the iPad then a third party data acquisition and analysis algorithm (Play.Care, Harimata) will classify the data as positively or negatively associated with ASD. The results are blind until data collection is complete, when the algorithm’s classification will be compared against medical diagnosis. Furthermore, parents of participants in the ASD and OND groups will complete three questionnaires: Strengths and Difficulties Questionnaire; Early Symptomatic Syndromes Eliciting Neurodevelopmental Clinical Examinations Questionnaire and the Adaptive Behavioural Assessment System-3 or Vineland Adaptive Behavior Scales-II. The primary outcome measure is sensitivity and specificity of Play.Care to differentiate ASD children from TD children. Secondary outcomes measures include the accuracy of Play.Care to differentiate ASD children from OND children. Ethics and dissemination This study was approved by the West of Scotland Research Ethics Service Committee 3 and the University of Strathclyde Ethics Committee. Results will be disseminated in peer-reviewed publications and at international scientific conferences. Trial registration number NCT03438994; Pre-results." ;
    dcterms:bibliographicCitation "Millar L; McConnachie A; Minnis H; Wilson P; Thompson L; Anzulewicz A; Sobota K; Rowe P; Gillberg C; Delafield-Butt J (2019). Phase 3 diagnostic evaluation of a smart. **. https://doi.org/10.1136/bmjopen-2018-026226" ;
    dcterms:creator "Anzulewicz A",
        "Delafield-Butt J",
        "Gillberg C",
        "McConnachie A",
        "Millar L",
        "Minnis H",
        "Rowe P",
        "Sobota K",
        "Thompson L",
        "Wilson P" ;
    dcterms:title "Phase 3 diagnostic evaluation of a smart" ;
    bibo:doi "10.1136/bmjopen-2018-026226" ;
    bibo:pmid "local_7b468950" ;
    fabio:hasPublicationYear 2019 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Comparison group adequacy" ;
                            slr:justification "Two comparison cohorts, including 200 children with other neurodevelopmental disorders spanning intellectual disability, ADHD, developmental coordination disorder, Down's syndrome and cerebral palsy, with subclinical or secondary autism expressions excluded to keep the contrast interpretable. The only powered differential-diagnosis design in the corpus." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Participant selection and spectrum representativeness" ;
                            slr:justification "Planned 760 children across two countries and multiple recruitment streams, with a tabulated allocation by site and cohort and full eligibility criteria - designed explicitly to overcome the pilot's single-country specialist-centre sampling." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Handling of missing data and attrition" ;
                            slr:justification "Not assessable from a protocol; no attrition or missing-data handling procedure is described in the retrieved text." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Confounder control" ;
                            slr:justification "A narrow age window, matched design inherited from the pilot, and adaptive-functioning and symptom questionnaires collected for both clinical cohorts so that severity and adaptive level can be examined alongside category." ;
                            slr:rating "Low" ] ;
                    slr:overall_concern "low" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Reference standard quality" ;
                            slr:justification "Independent clinical diagnosis on DSM-5 or ICD-10 criteria, supplemented by SDQ, ESSENCE and an adaptive behaviour scale for both clinical cohorts." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Outcome measurement blinding" ;
                            slr:justification "The index test is applied blind and results are embargoed until data collection is complete, with the classification compared against medical diagnosis only afterwards." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Index test definition and prespecification" ;
                            slr:justification "The algorithm is fixed in advance as a locked commercial product, its provenance in a published pilot is stated, and the outcome measures are prespecified. Its internals are not disclosed, so what it measures will remain unknown even on a positive result." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Measurement standardisation" ;
                            slr:justification "Two fixed games of five minutes each on a consumer tablet with built-in sensors, requiring no professional training, no verbal instruction and no subjective coding - so the measurement chain is fully instrumented and identical for every child." ;
                            slr:rating "Low" ] ;
                    slr:overall_concern "low" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Preprocessing and feature selection nesting" ;
                            slr:justification "Not applicable; the pipeline is locked before the evaluation data exist." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Data splitting and leakage control" ;
                            slr:justification "The algorithm is trained on an entirely separate prior cohort and applied prospectively to new blinded data collected by different investigators - prospective external validation, which no other study in this corpus performs." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Sample size adequacy for the modelling" ;
                            slr:justification "Seven hundred and sixty children with an explicit power justification for the primary outcome - the only formal sample size calculation in the corpus." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Performance estimation and chance level" ;
                            slr:justification "Sensitivity and specificity prespecified as primary outcomes, benchmarked against ADOS-2 and ADI-R, with power calculations stated in both directions - including 91% power to detect sensitivity or specificity below 80% if the instrument underperforms." ;
                            slr:rating "Low" ] ;
                    slr:overall_concern "low" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Acknowledgement of limitations" ;
                            slr:justification "The pilot's selection bias, site-specific effects and same-dataset training and testing are all named as the reasons the trial is being conducted, including the observation that repeated cross-validation 'only trained and tested patterns on that particular dataset'." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Ethics, consent and conflicts" ;
                            slr:justification "Two named ethics committees; funding source with grant number; and a competing-interest statement that separates academic investigators holding no financial interest from company board members with vesting options, within a stated trial steering and management committee structure, with the analysis blinded to the developers." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Reporting of results and uncertainty" ;
                            slr:justification "No results are reported; the trial is registered as pre-results and the classifications remain blind until data collection is complete. This is the intended state for a protocol." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Completeness of methods reporting" ;
                            slr:justification "Design, registration number and status, site-by-cohort allocation table, eligibility criteria table, age window, recruitment streams, games and durations, sensor modalities, algorithm provenance, questionnaire battery, outcomes, power calculations, ethics approvals, funding with grant number, itemised competing interests and author contributions." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Data, code and protocol availability" ;
                            slr:justification "The protocol itself is published in advance of results and the trial is registered as NCT03438994 - the strongest form of preregistration available, and the only instance in this corpus. The algorithm is a commercial product and is not released." ;
                            slr:rating "Low" ] ;
                    slr:overall_concern "low" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Not reportable, since no participants had been analysed. The design nonetheless specifies more clinical characterisation than almost any completed study in this corpus: parents of children in both clinical cohorts complete the Strengths and Difficulties Questionnaire, the ESSENCE Questionnaire, and either the Adaptive Behavior Assessment System-3 or the Vineland Adaptive Behavior Scales-II, so behavioural difficulties, neurodevelopmental symptom breadth and adaptive functioning will all be available alongside the diagnostic label. The pilot study on which the trial builds used age- and gender-matched controls, and the age window is tightly bounded at 30 months to 5 years 11 months." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-028" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The methodological benchmark for this review, and the only design in the corpus that closes every failure mode the synthesis documents elsewhere. The algorithm is locked before the evaluation data exist, so no tuning to the labels is possible. The data are collected prospectively and 'independently of the Play.Care software engineers and commercial concerns', so the developers cannot influence the evaluation. Results are embargoed - 'the results are blind until data collection is complete' - so no interim selection can occur. Recruitment spans two countries and multiple streams, addressing the site-specific effects the protocol identifies in its own pilot. Sensitivity and specificity are prespecified as primary outcomes rather than accuracy. A non-autistic clinical comparison group of 200 children is recruited specifically to test differential diagnosis, prespecified as a secondary outcome. The trial is registered on ClinicalTrials.gov before results exist and the protocol is published in advance. And the sample size is justified with power calculations framed around detecting underperformance rather than demonstrating success. Most significantly for this review, the protocol states explicitly why the pilot's evaluation was insufficient despite using repeated cross-validation: it 'only trained and tested patterns on that particular dataset'. That sentence identifies the exact inferential gap that most studies in this corpus leave open - cross-validation within a dataset establishes internal consistency, not generalisation - and the trial exists to close it. The one residual limitation is that recruitment through specialist services and existing diagnoses means predictive value at population prevalence will not be directly estimable even on completion." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-028" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "An Apple iPad and two children's games. The sensing is entirely built in - capacitive touch screen for contact kinematics, triaxial accelerometer and gyroscope for device movement - so nothing is purchased, worn, calibrated or maintained beyond a consumer tablet. Set against the eye trackers, depth cameras, thermal cameras, EEG amplifiers, force plates and MRI scanners charted elsewhere in this review, this is the lowest equipment barrier of any instrumented approach here, and it is the reason the protocol can propose deployment 'in the home, clinic or classroom'." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-028" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A commercial third-party classifier, Play.Care, described as an adaptation of the algorithm developed and published from the pilot study. Its internals are not restated in the protocol, and for the trial's purposes this is by design: the point of a phase III evaluation is that the instrument is locked and applied unchanged to new data, so the algorithm's specification belongs to the development phase rather than to the evaluation. The trade-off is that the trial can establish whether the instrument works without establishing what it measures - a limitation the protocol does not name." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-028" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "BMJ Open 2019;9:e026226, Protocol section, open access under CC BY-NC; received 6 September 2018, revised 26 March 2019, accepted 1 May 2019, first published 16 July 2019. A general medical journal with a dedicated protocol section, and the venue's requirements are visible throughout: STARD-based design, trial registration with status, a Strengths and Limitations box, tabulated participant allocation and eligibility criteria, explicit power calculations, named ethics committees, an itemised competing-interest statement distinguishing academic from commercial authors, and author contributions specifying individual roles. Publishing a diagnostic protocol before results exist is the practice that makes selective reporting detectable, and this is the only instance of it in the corpus." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-028" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A planned sample of 760 children aged 30 months to 5 years 11 months across two countries, allocated in a published table: Glasgow 100 autistic, 140 other neurodevelopmental disorder and 180 typically developing; Gothenburg 180 autistic, 60 other neurodevelopmental disorder and 100 typically developing. The composition is the most important feature of the design for this review. Two hundred children with a diagnosed neurodevelopmental condition that is not autism - intellectual disability, non-verbal disability, communication disability, ADHD, developmental coordination disorder, Down's syndrome and cerebral palsy - are recruited specifically to test whether the instrument distinguishes autism from other developmental difference rather than only from typical development. Children with subclinical or secondary expressions of autism are excluded from that cohort to keep the contrast interpretable. No participant data are reported, since the protocol was published before data collection closed and the results are embargoed." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-028" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Clinical diagnosis of autism made independently of the study on DSM-5 criteria or the equivalent ICD-10 framework, against which the algorithm's blinded classification will be compared once data collection closes. Two features distinguish this from every other reference standard in the review. The comparison is prospective and blinded - the classifier is locked and applied to data 'obtained independently of the Play.Care software engineers and commercial concerns', with results embargoed until collection is complete - so the index test cannot be tuned to the labels. And the standard is supplemented rather than replaced by questionnaire data: SDQ, ESSENCE and an adaptive behaviour scale are collected for both clinical cohorts, so a positive or negative classification can be examined against symptom breadth and adaptive functioning rather than only against a binary label." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-028" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Published July 2019 by a collaboration between the University of Strathclyde, the University of Glasgow, the University of Aberdeen, the Gillberg Neuropsychiatry Centre at Gothenburg, and Harimata sp. z o.o., funded through a Horizon 2020 SME Instrument subcontract. For this review the article is the methodological benchmark against which the rest of the corpus can be read, and it earns that position on six counts. The algorithm is locked before the evaluation data exist and applied by investigators separate from its developers, with results embargoed until collection closes - so none of the tuning, selection or leakage mechanisms documented across the other 130-odd included studies can operate. Sensitivity and specificity are prespecified as primary outcomes rather than accuracy. A 200-child cohort with other neurodevelopmental disorders is recruited to test differential diagnosis as a prespecified secondary outcome, making this the only powered study in the corpus to address the question the free-play and robot studies name as the hardest and that the ADOS-versus-schizophrenia study shows the field's gold-standard instrument failing. The sample size is justified with power calculations framed around detecting underperformance, with the protocol stating that 'if the Play.Care assessment is underperforming, which is the major concern of healthcare services, this study has a high probability of detecting it'. The commercial interest is managed structurally, with academic investigators holding no equity, company board members with vesting options identified individually, and the analysis blinded to the developers. And the protocol is registered and published before any result exists. Beyond the design, one passage deserves to be carried into the synthesis verbatim, because it states the inferential problem that most of this corpus leaves unexamined: the pilot 'employed the same dataset to train and test the machine learning algorithm. It did so with 10 repetitions of a 10-fold cross-validation procedure that is not prone to overfitting. Nevertheless, it only trained and tested patterns on that particular dataset.' Repeated cross-validation establishes consistency within a dataset and not generalisation beyond it - and the entire trial exists because its authors took that distinction seriously about a 93% figure of their own. What the article cannot supply is a result: it is registered as NCT03438994 with status 'Pre-results', and no participant data are reported." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-028" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Not addressed for the algorithm, which is applied as a commercial black box. The construct-level interpretability is nonetheless strong: the target is motor pattern rather than an aggregate behavioural impression, grounded in a specific and falsifiable hypothesis about movement disruption, so a positive result would be interpretable at the level of the construct even if not at the level of the model." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-028" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The aim is to test, under phase III conditions, whether a tablet-based serious game can identify autism in preschoolers - specifically whether the 93% accuracy obtained in an 82-child Polish pilot survives prospective, blinded, multi-site evaluation against clinical diagnosis. The primary outcome is sensitivity and specificity for distinguishing autistic from typically developing children; the secondary outcome is accuracy in distinguishing autistic children from those with other neurodevelopmental disorders. No results are reported: the trial is registered as NCT03438994 with status 'Pre-results' and 'the results are blind until data collection is complete'. The protocol's substantive contribution to this review is therefore methodological, and it is considerable - it is the only study in the corpus that locks its algorithm before seeing the evaluation data, separates the analysts from the developers, prespecifies sensitivity and specificity as primary outcomes, powers the study to detect underperformance, recruits a non-autistic clinical comparison group, registers prospectively and publishes the protocol in advance." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-028" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Clinical and health-economic, and unusually precise about the problem being solved. Autism is 'a childhood neurodevelopmental disorder', with UK prevalence and an aggregate annual healthcare and support cost of £28 billion cited. The diagnostic argument is specific rather than dismissive: 'Diagnosis currently relies on specialist medical expertise with diagnostic instrumentation dependent on subjectively rated scores during child observations, parent interviews and testing' - an accurate description that identifies subjectivity of scoring as the issue rather than impugning clinical judgement, and the protocol's stated ambition is to be 'an attractive and useful addition to the assessment and diagnostic toolbox', explicitly alongside ADOS-2 and ADI-R rather than in place of them. Early identification is framed in terms of what it enables for families - 'opportunity to adjust' and access to healthcare intervention and children's services - rather than in terms of treatment or cure. No autistic person or organisation is reported as involved in the design." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-028" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two sites, Glasgow and Gothenburg, with recruitment through NHS Greater Glasgow and Clyde Specialist Children's Services, other specialist children's centres, nurseries and schools, and via two streams for the clinical cohorts - children receiving a positive diagnosis following an NHS clinic assessment, and children already diagnosed. Multi-site international recruitment is itself a design feature aimed at the pilot's acknowledged weakness, that a sample drawn from 'a small number of specialist day-care centres in Poland' is 'prone to selection bias and site-specific effects'. The assessment is intended for use 'in the home, clinic or classroom', so the deployment envelope is broad and the trial's setting is the referral pathway rather than a research laboratory. The residual limitation, not stated, is that recruitment through specialist services and existing diagnoses means predictive value at population prevalence will still not be directly estimable." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-028" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The most complete protocol reporting in the corpus. Specified: the design and its STARD basis; the trial registration number and its pre-results status; both sites with participant allocation broken down by cohort and site in a table; inclusion and exclusion criteria for all three groups in a second table, including the exclusion of subclinical or secondary autism expressions from the comparison-disorder group; the age window; both recruitment streams; the games, their source and their duration; the sensor modalities; the third-party algorithm with its provenance in a published pilot; the questionnaire battery for the clinical cohorts; primary and secondary outcomes; the sample size justification with explicit power figures; both ethics approvals; the funding source with grant number; an itemised competing-interest statement distinguishing academic from commercial authors; and author contributions naming who performed the sample size calculations and who conducted technical development. What cannot be reported is any result." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-028" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No formal keyword list appears in the retrieved text. Terms carried through the protocol: serious game, smart tablet, inertial sensors, movement disruption, motor pattern, biomarker, diagnostic classification, phase III, STARD, sensitivity, specificity, other neurodevelopmental disorder." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-028" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Completion of recruitment and comparison of the blinded classifications against medical diagnosis, with dissemination through peer-reviewed publication and conferences. For the review, the protocol's value is that it specifies in advance what a credible answer would look like, which makes any eventual result interpretable in a way that retrospective studies cannot be." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-028" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two commercially available children's cartoon games from the Duckie Deck series, engineered with bespoke code to capture touch-screen and inertial sensor data, played for five minutes each. This is the most deployable paradigm in the review and the protocol states its properties exactly: the method 'required no professional training to deploy, no verbal instructions were required to engage the child, and only limited supervision was necessary. The result of the assessment was purely statistical; no subjective coding was required.' Four consequences follow that no other included paradigm achieves together. There is no examiner, so examiner variability is eliminated rather than merely controlled. There is no verbal demand, so the assessment reaches pre-verbal and minimally verbal children whom the language-based measures in this review cannot assess. There is no human rating anywhere in the chain, so inter-rater reliability is not a consideration. And the apparatus is a consumer tablet running a children's game, so ten minutes in a nursery or a living room produces the data. Against this, what the child is doing is playing a game rather than interacting socially, so the construct measured is motor control rather than reciprocity - which the protocol presents as a deliberate choice." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-028" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two synchronous sensor streams from a single consumer device - touch-screen contact patterns and triaxial accelerometer plus gyroscope - capturing both what the child does to the screen and how the device moves while they do it. The fusion is inherent to the platform rather than engineered, which is part of the design's practical appeal: no synchronisation, no calibration and no additional hardware is required to obtain two complementary views of the same motor behaviour." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-028" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Planned and comprehensive. The Strengths and Difficulties Questionnaire, the ESSENCE Questionnaire and the Adaptive Behavior Assessment System-3 or Vineland Adaptive Behavior Scales-II are all administered to parents of children in the autistic and other-neurodevelopmental-disorder cohorts. That combination gives a behavioural-difficulty measure, a neurodevelopmental symptom-breadth measure and an adaptive-functioning measure alongside the diagnostic label, which is the apparatus needed to ask whether the instrument's output tracks severity or only category - the analysis this review has repeatedly found missing in completed studies whose data would have supported it." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-028" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Sub-second touch-screen and inertial time series from two five-minute gameplay sessions per child. The feature set derived from these is not enumerated, being internal to the commercial product." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-028" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The protocol's account of its predecessor's limitations is the most methodologically literate passage in this corpus, and it names both failure modes that this review has documented repeatedly. On selection: the pilot's 82 children came from 'a small number of specialist day-care centres in Poland. Such limited subject recruitment is prone to selection bias and site-specific effects and precludes assessment of predictive value in population-based settings.' On evaluation: 'the pilot study employed the same dataset to train and test the machine learning algorithm. It did so with 10 repetitions of a 10-fold cross-validation procedure that is not prone to overfitting. Nevertheless, it only trained and tested patterns on that particular dataset.' That second sentence is important - it concedes that repeated cross-validation, which most studies in this review treat as sufficient, does not establish generalisation beyond the dataset it is computed on. Both concerns are then addressed structurally rather than rhetorically. Two design points remain unstated: recruitment through specialist services means population-prevalence predictive value will still not be directly estimable, and the algorithm remains a commercial black box, so a positive result would show that the instrument works without showing what it measures." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-028" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Prospective and cross-sectional at the level of the index test, with each child assessed once, and prospective in the trial sense that the algorithm is fixed before any evaluation data are collected. Ethics approval was obtained from the West of Scotland Research Ethics Service Committee 3 and the University of Strathclyde Ethics Committee. The competing-interest handling is the most thorough in this review and is worth recording in full: the academic authors sit on the trial steering and management committees and declare no financial interest in the product or in the funding company, while two coauthors are board members of Harimata sp. z o.o., which intends to commercialise the technology, and hold options vesting in it. The funding is a subcontract from that company under a Horizon 2020 SME Instrument grant. A commercially sponsored diagnostic evaluation in which the analysis is blinded to the developers, the academic investigators hold no equity, and the governance structure is stated, is exactly what this review has found missing elsewhere - most notably in the commercially funded cry-analysis study, whose disclosure is comparably complete but whose design provides none of these separations." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-028" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Sensitivity and specificity as prespecified primary outcomes for the autism-versus-typical comparison, and accuracy for the autism-versus-other-neurodevelopmental-disorder comparison as a secondary outcome. Choosing sensitivity and specificity rather than accuracy as the primary measures is correct for a diagnostic instrument and is done by almost no other study in this corpus, most of which report accuracy alone on balanced designs. The sample size justification is expressed in the same terms and is worth quoting for the synthesis: if sensitivity or specificity is as high as 90%, the study has 80% power to show it exceeds 83.0% and 90% power to show it exceeds 81.9%; and 'if the sensitivity (or specificity) is only 70%, there will be 91% power to show that it is below 80%. That is, if the Play.Care assessment is underperforming, which is the major concern of healthcare services, this study has a high probability of detecting it.' Powering a study to detect its own instrument's failure, and stating that this is the point, is unique in this review." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-028" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Motor pattern during gameplay, chosen deliberately in preference to social and emotional variables - the protocol lists as a strength that 'a computational analysis of motor pattern variables, rather than social and emotional variables, is employed', grounded in the hypothesis that 'an underlying movement disruption may be a core component of autism spectrum disorder and a new, accessible early biomarker'. The measurement is sub-second: touch-screen contact kinematics and triaxial inertial signals sampled while a child plays. Three properties make this construct choice significant for the synthesis. Motor control is measurable without any social demand, so it does not require the child to engage with a person, which is both an advantage in accessibility and a limitation in construct coverage. It is measurable without language, reaching the pre-verbal and minimally verbal children that the transcript- and conversation-based measures in this review cannot assess. And it is measurable without human rating, so the entire chain from behaviour to classification is instrumented - the protocol notes that in the pilot 'the result of the assessment was purely statistical; no subjective coding was required'. The motor hypothesis aligns with the one-legged-standing and skeleton-movement studies charted elsewhere here, which target postural and gait control on similar reasoning." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-028" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:study_design "Prospective, multi-site, phase III diagnostic classification study designed according to the Standards for Reporting Diagnostic Accuracy Studies; protocol publication with results …" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: ; comparison: 280 typically developing (180 Glasgow, 100 Gothenburg) and 200 with another neurodevelopmental disorder (140 Glasgow, 60 Gothenburg)" ] ] ;
