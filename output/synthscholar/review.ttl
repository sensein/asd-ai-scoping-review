    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "There is no reference standard. Autism status is inferred from attendance at a Special Elementary School and typical development from attendance at a State Elementary School; no instrument, criterion or assessor is reported for either group." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "The CNN architecture is never specified - no layers, optimiser, learning rate, batch size, epoch count or seed - despite custom layer design being claimed as a contribution. Noise removal and contrast enhancement are applied by unstated methods, and the number of augmentations generated was not recorded." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Two groups recruited from two different schools, so autism status is perfectly confounded with institution. Group membership follows school placement rather than any diagnostic procedure, and the comparison children were not screened. Age is reported inconsistently (3-14 in the narrative, 5-15 in Table I) and sex is not reported at all. Exclusions were prespecified and clearly stated, which is a strength, but they remove intellectual disability, cerebral palsy and Down syndrome from the autistic group." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "All 70 children contribute exactly 15 photographs each, and the 70/20/10 division is at the image level, so every participant appears in training, validation and test. Five near-duplicate shots of one expression are distributed across the split. The metrics themselves reconcile exactly with the confusion matrix, but they describe a partition that cannot separate people." ] ;
            slr:overall_judgment "high" ;
            slr:tool_used "QUADAS-2" ] .

<urn:slr:article:55050e1dc1bd> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "The present study contributes to the research problem of applying social robots in autism diagnosis. There is a common belief that existing diagnostic methods for autistic spectrum disorder are not effective. Advances in Human–Robot Interactions (HRI) provide potential new diagnostic methods based on interactive robots. We investigated deﬁcits in turn-taking in preschool children by observing their interactions with the NAO robot during two games: (Dance with me vs. Touch me). We compared children’s interaction proﬁles with the robot (ﬁve autistic vs. ﬁve typically developing young children). Then, to investigate turn-taking deﬁcits, we adopted a rating procedure to indicate differences between both groups of children based on an observational scale. A statistical analysis based on ratings of the children’s interactions with the NAO robot indicated that autistic children presented a deﬁcient level of turn-taking behaviors. Our study provides evidence for the potential of designing and implementing an interactive dyadic game between a child and a social robot that can be used to detect turn-taking deﬁcits based on objective measures. We also discuss our results in the context of existing studies and propose guidelines for a robotic-enabled autism diagnosis system." ;
    dcterms:bibliographicCitation "Arent K; Brown DJ; Kruk-Lasocka J; Niemiec TL; Pasieczna AH; Standen PJ; Szczepanowski R (2022). The Use of Social Robots in the Diagnosis of Autism in Preschool Children. *Applied Sciences, 12(*." ;
    dcterms:creator "Arent K",
        "Brown DJ",
        "Kruk-Lasocka J",
        "Niemiec TL",
        "Pasieczna AH",
        "Standen PJ",
        "Szczepanowski R" ;
    dcterms:title "The Use of Social Robots in the Diagnosis of Autism in Preschool Children" ;
    bibo:pmid "local_76de1c03" ;
    fabio:hasPublicationYear 2022 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Participant selection and spectrum representativeness" ;
                            slr:justification "Five autistic children from kindergarten records, with no severity, cognitive or language characterisation and no statement of how they were selected from among eligible children." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Handling of missing data and attrition" ;
                            slr:justification "All ten children completed both games; no attrition, excluded sessions or unusable recordings are reported." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Comparison group adequacy" ;
                            slr:justification "Typically developing children from the same kindergartens, exactly matched on sex and drawn from the same 12-month age band, assessed under an identical protocol in the same setting." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Confounder control" ;
                            slr:justification "Age and sex controlled by design. No cognitive or language measure, so general developmental level cannot be separated from autism as an explanation for reduced turn-taking in a game the child must first understand." ;
                            slr:rating "Unclear" ] ;
                    slr:overall_concern "unclear" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Outcome measurement blinding" ;
                            slr:justification "Every measurement is a human rating and rater blinding to diagnosis is nowhere addressed, in a study where diagnoses were held in the kindergarten records from which participants were recruited." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Measurement standardisation" ;
                            slr:justification "Robot-delivered elicitation gives identical stimulus behaviour to every child - a degree of standardisation no human examiner can achieve - with a fixed session structure, fixed game durations and a common setting." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Index test definition and prespecification" ;
                            slr:justification "The construct is named in advance, two scenarios are designed to dissociate its possible causes, and the full rating scale with position-by-position definitions is published in an appendix." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Reference standard quality" ;
                            slr:justification "Multidisciplinary team diagnosis by a psychiatrist, psychologist and pedagogue - genuine clinical ascertainment, though instruments and dates are unstated and the diagnoses were taken from records rather than confirmed for the study." ;
                            slr:rating "Low" ] ;
                    slr:overall_concern "unclear" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Data splitting and leakage control" ;
                            slr:justification "Not applicable - no model is fitted, no individual receives a predicted class, and no partitioning question arises." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Sample size adequacy for the modelling" ;
                            slr:justification "Five children per group permits detection only of large effects and supports no individual-level inference. The limitation is not named as such in the paper." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Preprocessing and feature selection nesting" ;
                            slr:justification "Not applicable. The measurement scale was specified in advance and published, with no data-driven selection of any kind." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Performance estimation and chance level" ;
                            slr:justification "No diagnostic accuracy is computed or claimed, which is appropriate. But no confidence intervals or effect sizes accompany the group comparisons, which on five per group would have been more informative than significance alone." ;
                            slr:rating "Unclear" ] ;
                    slr:overall_concern "unclear" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Reporting of results and uncertainty" ;
                            slr:justification "Inter-rater reliability and internal consistency reported with a p-value, and non-parametric test statistics given for each comparison. No effect sizes or confidence intervals." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Acknowledgement of limitations" ;
                            slr:justification "A dedicated limitations section scoping the tool as supplementary to standard instruments, calling for further development with target users including children, and setting out the intended supporting role explicitly. Sample size, rater blinding and the absence of a developmental covariate are not named." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Ethics, consent and conflicts" ;
                            slr:justification "University research ethics committee approval, guardians informed of aims and procedures, and separate signed consent for participation and for filming. Funding and competing interests are not stated." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Completeness of methods reporting" ;
                            slr:justification "Participants, ages with mean and SD, sex by group, the diagnosing team's composition, setting, session structure with durations, robot operation mode, rater number and background, both reliability statistics, the statistical tests, and the complete observational scale in an appendix." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Data, code and protocol availability" ;
                            slr:justification "The observational instrument is published in full as an appendix - the most useful possible disclosure for this design - but no data availability statement is given and no code exists." ;
                            slr:rating "Unclear" ] ;
                    slr:overall_concern "low" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Strong for an observational study. Reported: participant numbers, ages with mean and standard deviation, sex composition by group, the diagnostic source and the disciplinary composition of the diagnosing team, the kindergarten setting and the maximum of three children per visit, the two-session structure with familiarisation and both games and their durations, the robot and its remote operation, the number and professional background of the raters, both reliability statistics with their p-value, the statistical tests used, and - most usefully - the complete observational scale with its rating definitions published in an appendix. Publishing the instrument is what makes the paradigm reusable and is the single most valuable disclosure a study of this design can make. Not reported: rater blinding, the diagnostic instruments behind the kindergarten records, funding and competing interests." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-094" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The aim is to test whether a dyadic game with a social robot can elicit and reveal turn-taking deficits, as a step toward a robot-enabled diagnostic aid. Five autistic and five typically developing preschoolers each played 'Touch me' and 'Dance with me' with a NAO robot for about five minutes per game, and six raters from special education scored their behaviour from video on a purpose-built scale. Autistic children produced significantly fewer turn-taking behaviours in both scenarios, and group differences also appeared on interest in the robot and on additional movements. Inter-rater reliability was satisfactory (Kendall's W = 0.65, p < 0.001) with subscale alpha 0.77. The study's contribution is the paradigm and its validation rather than a detection result: no model is fitted, no child is assigned a predicted class, and no accuracy is computed or claimed. The authors state the intended use precisely - 'If a specialist has a sense of how a typical child plays with NAO, then they will be able to see possible deficits in the turn-taking of a child with autism by observing him/her' - which is a claim about calibrating human observation, not about automating it." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-094" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Rater-assigned counts of movement activities and 0-5 severity scores per defined position, aggregated into turn-taking indicators for each game. Every value is traceable to a named behaviour with a published definition, so the representation is fully auditable - the opposite end of the interpretability spectrum from the 100,352 DeepFace features or 1,639 landmark values used elsewhere in this review, and a reminder that the constructs those studies attempt to learn were originally defined by exactly this kind of manual specification." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-094" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two purpose-designed five-minute dyadic games preceded by a five-minute familiarisation session, and the paradigm is the study's principal output. Its design merits recording in detail. 'Touch me' uses a stationary robot issuing voice commands; 'Dance with me' uses a moving robot inviting imitation. The two are constructed to dissociate routes to the same observable behaviour, and the authors state the logic explicitly: in 'Dance with me' a child touching the robot 'cannot be classified as a response to the robot's voice command. If at all, this is a phase of some kind of imitation process', while 'the Touch me scenario precludes the emergence of spontaneous child reactions because the NAO robot in this case was not moving'. Designing two conditions so that a single behaviour can be attributed to command-response in one and imitation in the other is a level of construct care that almost nothing else in this review matches - most included studies collect a behavioural stream and ask what separates the groups, whereas this one asks what a given behaviour would mean and builds the paradigm to answer it. Four further properties make the paradigm well suited to the review's concerns: it is short, it requires no verbal response, it is delivered identically to every child by a machine rather than a person - removing examiner variability, which the authors note gives 'predictable and reliable situations' - and it is portable to a kindergarten." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-094" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Improve and further develop the game scenarios in close cooperation with target users, explicitly including children alongside psychiatrists, psychologists and therapists; identify scenarios attractive to children; and extend toward a human-robot-interaction-enabled system that supports differentiation of autism symptoms beyond turn-taking. The inclusion of children themselves among the users to be consulted is the only participatory-design commitment in this corpus. The obvious additional steps, not proposed, are blinded rating, a larger sample, a developmental-level covariate, and test-retest assessment." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-094" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Complete, because nothing is opaque. Every measurement is a named behaviour scored against a definition published in an appendix, so any result can be traced to an observable event and independently re-scored - which is precisely what the six-rater reliability analysis does. The conclusion states the intended use in human terms: 'If a specialist has a sense of how a typical child plays with NAO, then they will be able to see possible deficits in the turn-taking of a child with autism by observing him/her.' That formulation is worth recording for the review because it describes an alternative to automation that most of this corpus does not consider - a standardised elicitation device that improves a clinician's calibration, rather than a model that replaces the clinician's judgement." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-094" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Keywords: autism spectrum disorder; diagnostics; humanoid robot NAO; turn-taking. Compact and accurate, naming the population, the purpose, the apparatus and - unusually - the specific behavioural construct. Very few keyword sets in this corpus identify the construct being measured rather than the method being used." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-094" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Not applicable in the machine-learning sense, since no model is fitted and no individual receives a predicted class - and the corresponding measurement-validation work is done properly. Six independent raters scored the same video material against definitions published in an appendix, inter-rater reliability was assessed with Kendall's W and reported at 0.65 (p < 0.001), and the Additional movements subscale returned an internal-consistency alpha of 0.77. Non-parametric tests appropriate to small ordinal samples were used throughout. The binding limitation is statistical power: with five children per group, only large effects are detectable, no confidence interval or effect size is reported, and nothing in the design supports individual-level inference - which is consistent with the study's own claims, since it asserts a group difference and a paradigm, not a classifier. Two internal-validity issues are unaddressed. Rater blinding to diagnosis is nowhere discussed, and since diagnoses were held in kindergarten records and every measurement is a human judgement, this is the study's main risk of bias. And no cognitive or language measure was obtained, so reduced turn-taking in a game requiring the child to understand the game cannot be separated from general developmental level. Set against the modelling studies in this review, however, the study has one structural advantage that no amount of downstream methodology can substitute for: its measurement instrument is published, its reliability is quantified, and its construct is named in advance." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-094" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A NAO humanoid robot operated remotely by an experimenter through its standard graphical interface, plus video recording. NAO's onboard sensing is not used for measurement at any point, so the robot is a standardised stimulus rather than an instrument - which is the study's defining methodological characteristic and the reason it contains no automated measurement. The equipment cost is nonetheless the highest of the elicitation devices in this review after MRI and thermal imaging: a NAO is a research-grade humanoid platform costing several thousand euros, against the webcam-and-toys protocols charted elsewhere. What it buys is exact reproducibility of the social partner's behaviour, which no human examiner can provide, and the authors identify this as the point." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-094" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Multidisciplinary clinical diagnosis by a team comprising a psychiatrist, a psychologist and a pedagogue, recorded in kindergarten files. This is real clinical ascertainment and places the study well above the folder-membership, hashtag and questionnaire-threshold labels charted elsewhere in this review - the diagnoses were made by qualified clinicians working together, which is closer to best practice than a single-instrument threshold. Two limitations attach. The instruments, criteria and dates behind those records are not stated, so the standard cannot be characterised further. And the diagnoses were obtained from records rather than confirmed for the study, which means they were known in advance to whoever recruited and, potentially, to the raters - and rater blinding is nowhere addressed, in a study where every measurement is a human judgement." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-094" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Age and sex are reported and controlled by design - a 12-month band and exact four-to-one sex matching in each group - which is proportionate handling for a ten-child study and better than several much larger studies in this review manage. What is absent is cognitive and language level, and the omission matters for the construct: turn-taking in a five-minute game depends on understanding the game, and without any developmental measure a general cognitive explanation for reduced turn-taking cannot be separated from an autism-specific one in six-year-olds. No socioeconomic, ancestry or comorbidity information is reported, and the sample is drawn from kindergartens in one Polish city." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-094" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional, single session per child, with no follow-up or test-retest - the last being a real gap for a five-minute protocol proposed as a diagnostic aid, since the stability of a six-year-old's engagement with a novel robot across occasions is unknown and is exactly what a supplementary assessment tool would need. Ethics reporting is complete and specific: approval from the local research ethics committee at the University of Lower Silesia; legal guardians acquainted with the research aims and procedures; and signed consent forms covering both participation and, separately, the filming of the study. Separate consent for video recording is reported by very few studies in this review. Funding and competing interests are not stated in the retrieved text." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-094" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Turn-taking, treated as a specific and theoretically motivated construct rather than as a generic behavioural signal - and this is the study's main contribution to the review. Most included studies collect a rich behavioural stream and ask a model what separates the groups; this one names a single element of reciprocal social interaction, designs two contrasting scenarios to elicit it, defines the observable positions that constitute it in a published appendix, and tests whether the groups differ. Two secondary constructs are also measured on 0-5 severity scales: interest in the robot, and additional movements, the latter capturing motor behaviour that the authors treat as stereotypy-adjacent. The finding that autistic children produced significantly fewer turn-taking behaviours in both scenarios is consistent with the free-play study charted elsewhere in this review, which found the social-communication dimension separable in a brief structured sample while the restricted-repetitive dimension was not - here the additional-movements subscale did differ, which is worth noting since it suggests that a robot-mediated task may elicit motor behaviours that a 90-second free-play sample does not." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-094" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Published August 2022 by a Polish-British collaboration spanning robotics, cognitive psychology, education and rehabilitation medicine. The framing is a well-informed critique of existing assessment: parent- and caregiver-report screening instruments have limited reliability, ADOS is the exception because it is 'enriched with interactive protocols', and diagnostic effectiveness is compromised by the difficulty of differentiating autism from sensory integration disorder, dysphasia and ADHD - so assessment often depends on long-term observation and 'often leading to ambiguous diagnostic outcomes'. For this review the study is valuable in four respects, none of which is a performance figure. It is the corpus's clearest example of construct-first design: rather than collecting a behavioural stream and asking what separates the groups, it names turn-taking as the target, builds two contrasting game scenarios to dissociate command-response from imitation, publishes the observational scale that defines the measurement, and quantifies its reliability across six raters. It brings the assessment to the child - both groups were seen in their own kindergartens under an identical protocol - so the recruitment and setting asymmetry that this synthesis has documented across the photograph, audio and thermal branches does not arise. Its translational claim is the best-calibrated in the corpus: the robot is 'a supplementary tool, thanks to which specialists can acquire additional diagnostic intuition to be used with standard tools', and the mechanism is described as a specialist learning what typical play with NAO looks like and thereby seeing deficits by observation - a proposal to calibrate human judgement rather than to replace it, which no other study here entertains. And its future-work section names children themselves among the target users whose cooperation is required to improve the games, the only participatory-design commitment in this review. What it cannot supply is evidence about detection: five children per group, no model, no individual-level prediction, no accuracy, no rater blinding, and no developmental-level covariate. Its role in the synthesis is therefore as the upstream complement to the modelling studies - a demonstration that a robot-delivered paradigm elicits a measurable group difference on a defined construct, which is the prerequisite that most of the automated work in this corpus assumes rather than establishes." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-094" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. A single video-recorded interaction stream, coded by human raters. The robot's own sensors - microphones, cameras, sonar, tactile sensors - are all present in the NAO platform and none is used for measurement, which is the study's clearest missed opportunity and the direction its own future-work section points toward. A robot that both elicits and records the interaction would supply exactly the standardised multimodal stream that several other studies in this review construct with far more improvised equipment." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-094" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The kindergartens the children attended, with a maximum of three children assessed per visit. Both groups were assessed in the same settings under the same protocol, which removes the clinic-versus-school recruitment asymmetry that this review has documented as a confound across the photograph, audio and thermal branches. Bringing a portable robot to a child's own nursery is also the deployment scenario the work envisages, so the data were collected under the conditions in which the method would be used - a property shared with only a few studies in this corpus, notably the population-based one-legged-standing study and the routine-examination work." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-094" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Ten children aged 5.5 to 6.5 years (mean 6.08, SD 0.4), recruited through the kindergartens they attended in Poland: five diagnosed with autism and five typically developing, each group comprising four boys and one girl. The sample is the smallest in the review, and its composition is nonetheless carefully constructed - exact sex matching, a 12-month age band, and both groups drawn from the same kindergartens, so the recruitment asymmetry that affects nearly every case-control study charted here does not arise. Diagnoses were taken from kindergarten records and had been delivered by a multidisciplinary team of a psychiatrist, a psychologist and a pedagogue, which is genuine clinical ascertainment even though the instruments and criteria are not stated. No cognitive, language, socioeconomic or comorbidity information is reported. With five children per group, the study can support group-level inference about large effects and cannot support any statement about individual-level discrimination, which is consistent with what it claims." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-094" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. No computational or machine-learning model is fitted at any point, and no automated measurement is performed. The analysis is non-parametric group comparison - Mann-Whitney, Kruskal-Wallis and chi-squared - which is the appropriate choice for ordinal ratings from five children per group and is used correctly. For a review of computation-based approaches this study occupies the position immediately upstream of the modelling work: it establishes that a robot-delivered paradigm elicits a measurable group difference on a defined construct, which is the prerequisite for any subsequent automation, and it does not attempt the automation itself." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-094" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None of the diagnostic kind, and none claimed. The metrics reported are measurement-quality and inferential statistics: Kendall's W = 0.65 (p < 0.001) for inter-rater reliability across the whole scale, Cronbach's alpha = 0.77 for the Additional movements subscale, and Mann-Whitney, Kruskal-Wallis and chi-squared statistics with p-values for the group comparisons. Reporting inter-rater reliability at all is something most observational work in this corpus omits, and it is the appropriate primary metric for a study whose measurements are human judgements. What is absent is any confidence interval or effect size on the group comparisons, which on five per group would have been informative about how large the difference actually is rather than only whether it reached significance." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-094" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No independent severity instrument was administered, but the study's own observational scale carries graded 0-5 severity ratings for interest in the robot and for additional movements at each defined position, so a within-study severity dimension exists. The authors use the group differences on these subscales to argue that the findings 'support the initial ASD diagnoses by showing that autistic symptoms are present in children diagnosed with ASD' - which is a convergent-validity argument for the measurement rather than a severity analysis, and is a reasonable use of the data. No relationship between turn-taking indicators and any severity score is examined." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-094" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Clinical and diagnostic in register, with an unusually clear-eyed account of why existing assessment is difficult. The introduction reviews the screening instruments - M-CHAT, ADEC, CARS-2, ASRS - and observes that because they rest on information from parents and caregivers 'their reliability is limited', with ADOS singled out as the exception 'enriched with interactive protocols'. It then names the differential-diagnosis problem directly: effectiveness 'is compromised by difficulties in differentiating autism from other developmental disorders (for instance, sensory integration disorder, dysphasia, minimal brain dysfunction, e.g., ADHD)', concluding that diagnosis 'often employs a range of clinical tools complemented with long-term observation of the autistic child, often leading to ambiguous diagnostic outcomes'. That is an accurate and specific account of the clinical problem, and the identification of differential diagnosis as the hard case matches the finding of the ADOS-versus-schizophrenia study charted elsewhere in this review. The paper also notes that most robotics work in autism concerns therapy rather than assessment, and positions itself in the smaller assessment literature. 'Autistic children' and 'children with autism' are used interchangeably; no neurodiversity framing appears, but the future-work section names children themselves among the target users whose cooperation is needed to improve the games, which is a participatory commitment absent from the rest of this corpus." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-094" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Applied Sciences 12(17):8399, MDPI, open access under CC BY; received 10 June 2022, accepted 17 August, published 23 August 2022. An applied-sciences venue with a robotics editorial team. The paper's clinical apparatus - multidisciplinary diagnosis, ethics approval, separate filming consent, inter-rater reliability, a published observational scale - is more complete than that of many papers in clinical venues charted in this review, which suggests the standard came from the authors rather than from the venue: the author list spans robotics, cognitive and applied psychology, psychology, and rehabilitation medicine across four Polish and two British institutions, with all seven authors noted as contributing equally." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-094" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A dedicated limitations section is provided and its principal content is a scoping statement rather than a list of defects: NAO with the proposed software 'can be treated as a supplementary tool, thanks to which specialists can acquire additional diagnostic intuition to be used with standard tools'. The authors add that the games need further development through close cooperation with target users 'including children, psychiatrists/psychologists and therapists', and that the aim is a set of scenarios attractive to children. What is not addressed: the sample of five per group is not named as a constraint, though it permits only large effects to be detected and no individual-level inference at all; rater blinding to diagnosis is nowhere discussed, and is the study's main internal-validity risk since all measurement is human judgement and the diagnoses were on file; the instruments behind those diagnoses are unstated; no cognitive or language measure was obtained, so general developmental level cannot be separated from autism as an explanation for reduced turn-taking; and no test-retest data exist." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-094" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:study_design "Small controlled observational comparison study within a robot-mediated interaction paradigm, with human-rated behavioural coding and non-parametric group comparison" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: ; comparison: 5 typically developing children (four boys, one girl)" ] ] ;
