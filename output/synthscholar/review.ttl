            oa:hasTarget <urn:slr:article:c846224c5959> ;
            slr:claim_label "A genuinely held-out evaluation set was collected and no result from it is reported anywhere in the paper." ;
            slr:relevance_score "0.89"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "While more advanced AI models based on deep learning could be used, the sample size is insufficient for reliably training deep learning models from scratch. Moreover, to our knowledge, there is no publicly available pre-trained deep learning model that is directly applicable for our problem." ] ;
            oa:hasTarget <urn:slr:article:7adb257effec> ;
            slr:claim_label "The choice of a simple linear model is argued from sample size and from the unavailability of transferable pre-trained models, rather than defaulted to or justified post hoc by accuracy." ;
