    slr:journal "Autism Research, 9(8), 846-8" ;
    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "Three non-completers (one ASD, two typical) are explicitly reported and accounted for; index and reference assessments are contemporaneous." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "10-fold cross-validation with covariate robustness checks and honest reporting of fold variance and overfitting, but no statement that LSI was refitted within folds and the operating threshold is described as optimal, implying selection on the evaluation data." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Mixed clinic/advertisement recruitment with a 27:132 group-size imbalance and gender distributions inverted between groups (85% male ASD vs 66% female typical), with the ASD group also 7-12 years older on average, in a study whose measure is language production." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "DSM-IV diagnosis at an academic developmental neuropsychiatry program with ADOS administered and other DSM-IV diagnoses excluded via SCL-90 - among the better-specified reference standards in the corpus." ] ;
            slr:overall_judgment "some" ;
            slr:tool_used "QUADAS-2" ] .

<https://doi.org/10.1007/s10803-018-3690-y> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Eye tracking (ET) holds potential for the early detection of autism spectrum disorder (ASD). To overcome the difficulties of working with young children, developing a short and informative paradigm is crucial for ET. We investigated the fixation times of 37 ASD and 37 typically developing (TD) children ages 4–6 watching a 10-second video of a female speaking. ASD children showed significant reductions in fixation time at six areas of interest. Furthermore, discriminant analysis revealed fixation times at the mouth and body could significantly discriminate ASD from TD with a classification accuracy of 85.1%, sensitivity of 86.5%, and specificity of 83.8%. Our study suggests that a short video clip may provide enough information to distinguish ASD from TD children." ;
    dcterms:bibliographicCitation "Wan G; Kong X; Sun B; Yu S; Tu Y; Park J; Lang C; Koh M; Wei Z; Feng Z; Lin Y; Kong J (2018). Applying Eye Tracking to Identify Autism Spectrum Disorder in Children. *Journal of Autism and Dev*. https://doi.org/10.1007/s10803-018-3690-y" ;
    dcterms:creator "Feng Z",
        "Koh M",
        "Kong J",
        "Kong X",
        "Lang C",
        "Lin Y",
        "Park J",
        "Sun B",
        "Tu Y",
        "Wan G",
        "Wei Z",
        "Yu S" ;
    dcterms:title "Applying Eye Tracking to Identify Autism Spectrum Disorder in Children" ;
    bibo:doi "10.1007/s10803-018-3690-y" ;
    bibo:pmid "local_40cd7d53" ;
    fabio:hasPublicationYear 2018 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is control status adequately established?" ;
                            slr:justification "Screened by a licensed physician to exclude psychiatric or neurological history including ASD." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are comparison groups matched on the variables that matter?" ;
                            slr:justification "Age matched and confirmed (p=0.17); gender difference non-significant (p=0.14) but 89% vs 73% male in practice." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the sample appropriate and adequate for the stated target?" ;
                            slr:justification "74 children in a tight 4-6 year band suits the screening question, but the authors name sample size as a limitation and note the age-specificity is untested." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are participants and recruitment adequately described?" ;
                            slr:justification "Recruitment sites, inclusion criteria, demographics, CARS and GDS subscores all tabulated." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "some concerns" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the behavioral data acquisition described reproducibly?" ;
                            slr:justification "Eye tracker model, sampling rate, spatial resolution, screen resolution, viewing distance, room conditions, calibration and correction procedures, stimulus content and duration, and full AOI definitions are all given." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the reference standard appropriate and independently applied?" ;
                            slr:justification "DSM-5 and CARS without ADOS or ADI-R, acknowledged by the authors as the study's first limitation." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are confounds in the measurement controlled?" ;
                            slr:justification "Within-face ratios were introduced specifically to adjust for the ASD group's globally lower fixation time, and the result is reported even though it undercuts a simpler narrative." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are predictors defined without knowledge of outcome?" ;
                            slr:justification "AOIs are predefined anatomically and fixation times computed automatically by BeGaze." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "some concerns" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is there external or independent validation?" ;
                            slr:justification "None; larger-sample validation named as future work." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the validation scheme appropriate?" ;
                            slr:justification "Five-fold cross-validation with permutation testing against chance, but nesting of AOI selection is unstated." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the feature-to-sample ratio reasonable?" ;
                            slr:justification "Ten AOIs plus three ratios against 74 children - among the healthiest ratios in the corpus." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is feature importance tested statistically?" ;
                            slr:justification "SVM weights assessed by 1000-iteration permutation tests rather than reported as a bare ranking." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are multiple comparisons corrected?" ;
                            slr:justification "Bonferroni correction applied across the ten AOI comparisons and across the five GDS correlations, with non-surviving correlations flagged as such." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "some concerns" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the dataset accessible or its access conditions stated?" ;
                            slr:justification "No data availability statement." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are results reported consistently?" ;
                            slr:justification "Two different sets of accuracy, sensitivity and specificity figures are given for the same analysis (85.1/86.5/83.8 versus 82.8/79.3/86.2) and never reconciled." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are ethics, consent and competing interests reported?" ;
                            slr:justification "Named ethics committee, Helsinki Declaration compliance, parental informed consent for all participants, funding sources and an author conflict-of-interest disclosure." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is code or an implementation available?" ;
                            slr:justification "None; SVM kernel and regularisation settings unreported." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are limitations discussed candidly?" ;
                            slr:justification "An explicit five-point limitations list covering diagnostic instruments, missing functional measures, sample size, age-specificity and paradigm comparison." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "some concerns" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Passive viewing, deliberately minimal: five-point calibration, then eye-position correction on a dynamic pink rabbit, then a single 10-second muted video of a young Asian female mouthing the English alphabet. The brevity is the explicit design contribution - the authors argue that with young children the paradigm must be short as well as informative, since keeping such subjects focused on a monitor for long periods is difficult. The stimulus is muted, so the speaking face provides visual mouth motion without audio." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-013" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Hardware: SMI RED250 portable eye tracker sampling at 250 Hz with 0.03 degree spatial resolution; 22-inch widescreen LCD at 1024x768; fixed 65 cm eye-to-monitor distance; dark soundproof room. Software: BeGaze for gaze data analysis; SPSS 22.0 for statistics, group comparisons and the SVM discriminant analysis." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-013" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Interpretability is handled better than in most of the corpus. SVM discriminative weights per AOI are tested by 1000-iteration permutation against the null that weights are arbitrary, so feature importance carries a p-value rather than a rank. Only mouth (p=0.008) and body (p=0.03) survive. The most informative result is a negative one: although fixation was globally reduced in ASD across seven AOIs, none of the eyes-to-face, mouth-to-face or nose-to-face ratios differed, so the group difference is in total looking rather than in the within-face distribution of attention - a finding that complicates the common eye-avoidance interpretation and which the authors report rather than suppress." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-013" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two groups of 37: children with ASD recruited from a hospital child mental health outpatient ward, and typically developing children recruited from a local kindergarten. Both groups fully characterised in a demographic table. No other-diagnosis comparison group." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-013" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Journal of Autism and Developmental Disorders - an autism-specific clinical journal, not a computational venue." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-013" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "DSM-5 diagnosis by experienced physicians plus a CARS score above 30 as an explicit inclusion criterion. The authors state directly that ADI-R and ADOS were unavailable in China and list the absence of confirmation with validated diagnostic instruments as their first limitation - an unusually forthright acknowledgement. Controls were screened by a licensed physician to exclude any psychiatric or neurological history including ASD, which is a stronger control-status procedure than most corpus studies." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-013" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The Gesell Developmental Scale (Chinese version) was administered to the ASD group, with adaptation, large motion, fine motion, language and personal-social subscores all reported - one of the fuller functional characterisations in the corpus. However the authors themselves list the absence of IQ and adaptive behaviour measures as their second limitation, and no GDS or other functional data were collected for the control group. Comorbidities are not described for the ASD group." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-013" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "'children with ASD', 'individuals with ASD', 'ASD children', 'the ASD group', 'typically developing (TD) children', 'TD group', 'individuals with autism', 'patients' (once, when discussing evaluation bias). Predominantly person-first with 'ASD children' used interchangeably; the comparison group is consistently 'typically developing' rather than 'normal', which is the more neutral convention." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-013" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Goal: early screening, with the specific design question of whether a very short paradigm suffices, plus replication of an infant speaking-face finding in an older age group. Main findings: fixation times significantly lower in ASD at seven of ten AOIs after Bonferroni correction; no differences in any within-face ratio; only mouth (p=0.008) and body (p=0.03) fixation carried significant discriminative weight; SVM accuracy 85.1%, sensitivity 86.5%, specificity 83.8%, above chance by permutation (p<0.001); fixation time correlated with the GDS large-motion subscore (p<0.01 corrected)." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-013" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Reported by the authors in an explicit five-point limitations list: ADOS/ADI-R unavailable so diagnoses rest on DSM-5 and CARS alone; no IQ or adaptive-behaviour measure of functional level; relatively small sample requiring larger-sample validation; unknown whether findings are specific to the 4-6 age group; and no direct comparison against or combination with other eye-tracking paradigms. Identifiable in review: gender is imbalanced in practice (89% vs 73% male) despite a non-significant chi-square on n=74; the control group has no GDS or functional data so the correlational analysis cannot be contrasted across groups; single-site recruitment with an ethnically homogeneous sample viewing an Asian female face, leaving cross-cultural transfer untested; whether AOI selection was nested inside the five-fold cross-validation is unstated; and the paper reports two mutually inconsistent sets of accuracy figures for the same analysis." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-013" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Single modality; no fusion. Within the modality, ten regional fixation times plus three derived ratios are supplied jointly to the SVM, which is feature-level combination across regions. Gaze data are separately correlated with Gesell developmental subscores using age and gender as covariates - an integration with clinical measures for interpretation rather than for prediction." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-013" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Clinic setting for testing (a dark, soundproof room with fixed viewing geometry) with clinical recruitment from a hospital outpatient ward and control recruitment from a kindergarten in the same city. Newly collected data; no existing dataset used." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-013" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2018 (published online August 2018, in the 2019 volume). The paper documents the field's trajectory in some detail: eye tracking as 'one emerging objective tool increasingly being applied in ASD clinics and research', machine learning recently applied to behaviour, brain activity and eye tracking with 'encouraging results', and ASD biomarker research having 'grown exponentially' with integration into future risk assessment 'almost certain'. It also situates itself against three specific predecessors (Shic et al. on infants, Liu et al. on face-scanning machine learning, Fujioka et al. on adults), comparing accuracies directly - one of the more explicitly cumulative papers in the corpus." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-013" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Larger-sample validation; extension to other populations, particularly young infants, where early detection would matter most; determination of whether the effect is age-group specific; direct head-to-head comparison of this short paradigm against established longer paradigms; and combination of the short paradigm with other paradigms. The authors also state a general principle rather than a research step - that current ASD biomarkers including eye tracking are supplementary and not replacements for clinical assessment." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-013" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Supervised learning with a single algorithm: support vector machine, described as discriminant analysis. No comparison against alternative classifiers, which is unusual for this corpus and arguably a strength - it removes the best-of-many selection optimism that inflates other studies here." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-013" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "ASD n=37, 33 boys / 4 girls, age 4.6 +/- 0.7 years, CARS 34.4 +/- 7.8. TD n=37, 27 boys / 10 girls, age 4.8 +/- 0.4 years. Age matched by design with no significant difference (p = 0.17), and gender difference non-significant by chi-square (p = 0.14) - though the actual distributions are 89% versus 73% male, so the matching is statistically defensible rather than close. Narrow 4-6 year age band by inclusion criterion, directly relevant to early screening but, as the authors note, leaving open whether the finding generalises to younger children." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-013" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No data availability statement and no code release. Method reporting is nonetheless strong: eye-tracker model, sampling rate, spatial resolution, screen resolution, viewing distance, calibration procedure, stimulus content and duration, the full AOI definitions and the ratio definitions are all specified, as are the cross-validation folds and the permutation counts. The analysis is re-implementable in principle on comparable data; the specific SVM kernel and regularisation settings are not given." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-013" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Five-fold cross-validation, with two separate permutation procedures - one testing whether classification accuracy exceeds chance (1000 label permutations) and one testing whether each AOI's discriminative weight is non-arbitrary (1000 permutations). Multiple comparisons across the ten AOI group tests are Bonferroni-corrected, and the correlational analysis with GDS subscores is likewise corrected, with the authors explicitly flagging which correlations did not survive correction. What is absent: external or independent validation, held-out site, any statement of whether AOI selection is nested within the folds, class-imbalance handling (not needed at 37/37), and any deployment or real-time analysis - though the authors explicitly position eye tracking as supplementary to clinical assessment rather than a replacement." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-013" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional; a single 10-second measurement per child with no follow-up. The data are fixation durations on predefined regions - among the least identifiable data types in the corpus. Ethics approval from the hospital research committee is reported with explicit reference to the 1964 Helsinki Declaration and its amendments, informed consent was obtained from parents of all participants, and a conflict-of-interest disclosure is given for one author. Ethics and consent reporting is essentially complete." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-013" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Author keywords: Autism; Eye tracking; Fixation time; Machine learning; Face. Task vocabulary: 'early detection', 'screening', 'biomarkers', 'areas-of-interest', 'discriminant analysis', 'proof of concept'. The paper's framing of biomarkers as 'supplementary' rather than diagnostic is a distinctive and unusually cautious note." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-013" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Handcrafted region-aggregated features: total fixation time per area of interest over the 10-second clip, plus three normalising ratios. Extremely low-dimensional - ten AOIs and three ratios against 74 children - which is a far healthier feature-to-sample ratio than most studies in this corpus and materially reduces overfitting risk." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-013" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Gaze: fixation duration on predefined facial and body regions during passive viewing of a speaking face. Aggregate dwell time per region rather than scanpath, saccade dynamics or pupillometry." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-013" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Accuracy, sensitivity and specificity, with a permutation-derived p-value establishing that accuracy exceeds chance. Headline: 85.1% / 86.5% / 83.8% (p<0.001). No AUC, F1 or confidence intervals. A contradictory second set of figures (82.8% / 79.3% / 86.2%) appears in the Discussion for what is described as the same analysis, and is never reconciled." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-013" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "Single session; a single 10-second muted video clip after five-point calibration and a fixation correction task" ;
                    slr:study_design "Cross-sectional case-control classification study, described by the authors as preliminary and proof of concept, with a replication aim (extending an infant finding to 4-6 year-old…" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: 37; comparison: 37" ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "85.1% accuracy, 86.5% sensitivity, 83.8% specificity, significantly above chance by permutation test (p < 0.001). Note an internal inconsistency: the Discussion also reports the same result as 'accuracy of 82.8%, sensitivity of 79.3%, and specificity of 86.2%' in one passage, contradicting the abstract, results and conclusion figures",
                        "A 10-second muted video of a speaking face was sufficient to discriminate 4-6 year-old children with ASD from matched typically developing children at 85.1% accuracy. Children with ASD showed globally reduced fixation across seven of ten areas of interest, but crucially the within-face ratios did not differ, so the effect is reduced overall looking rather than a shift away from the eyes specifical" ;
                    slr:outcome "Accuracy, sensitivity and specificity, with a permutation-based p-value for the accuracy" ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "85.1% accuracy, 86.5% sensitivity, 83.8% specificity, significantly above chance by permutation test (p < 0.001). Note an internal inconsistency: the Discussion also reports the same result as 'accuracy of 82.8%, sensitivity of 79.3%, and specificity of 86.2%' in one passage, contradicting the abstract, results and conclusion figures; A 10-second muted video of a speaking face was sufficient to discriminate 4-6 year-old children with ASD from matched typically developing children at 85.1% accuracy. Children with ASD showed globally reduced fixation across seven of ten areas of interest, but crucially the within-face ratios did not differ, so the effect is reduced overall looking rather than a shift away from the eyes specifical" ] ] ;
    slr:content_sha256 "ff1aec63e1295420af6c8b1996f43caebaa69b67c284c832041bc6bb33ead769" ;
