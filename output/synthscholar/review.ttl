                    slr:domain_name "Reference standard" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Case status rests on a clinical diagnosis 'verified by the charity organisation' with no instrument, criteria or clinician named, even though control status is established rigorously with the Autism Quotient and an explicit threshold." ],
