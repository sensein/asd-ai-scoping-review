        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "The dataset of children with autism was collected from Special Elementary School in Banda Aceh, Indonesia, and the normal data was gathered from State Elementary School in Banda Aceh. The study subjects included 35 children with autism and 35 typically developing children aged 3 to 14 years." ] ;
            oa:hasTarget <urn:slr:article:49963b028b7f> ;
