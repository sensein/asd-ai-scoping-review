    slr:journal "Neural Computing and Applications, 37(33), 27631-27654" ;
    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "All 40 participants contribute exactly 100 images each, so the analysis unit and the participant are systematically confounded across every subset. The stimulus duration is stated as ten seconds in the methods and two minutes in the workflow. Specificity, FDR and FOR are defined but never reported, and no per-fold results exist for the cross-validation described." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "The index test operates on eye-image crops and scanpath sequences whose partition places every participant in training, validation and test simultaneously. Augmentation precedes partitioning; convolutional architecture and epoch count are unspecified; and the asserted cross-validation is never quantified." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Forty children from a single special school, all already diagnosed, with no typically developing comparison group despite a TD comparison being claimed in the abstract. Sex is not reported; age is given only as an eligibility band. The four severity groups of exactly ten each cannot have arisen from the stated CARS bands, two of which are impossible or inconsistent with the CARS >=30 eligibility threshold." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "Diagnosis itself is reasonably ascertained - DSM-5 criteria plus CARS by experienced physicians, with an honest statement that ADI-R and ADOS are not widely available in India. But the classification target is not diagnosis, it is the four-level severity band, and the band definitions in Table 3 are internally impossible, so the outcome variable that the model predicts is not reliably defined." ] ;
            slr:overall_judgment "high" ;
            slr:tool_used "QUADAS-2" ] .

<urn:slr:article:49963b028b7f> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "The diagnosis of autism spectrum disorder (ASD) using facial recognition technology faces challenges related to limited dataset variation and model classification effectiveness. The dataset is often less representative in capturing facial characteristics, lighting conditions, and social context, which impacts detection accuracy. This study aims to develop a new dataset with a broader variation in facial characteristics and refine the model classification based on Convolutional Neural Network (CNN) for optimal ASD detection. The developed dataset consists of 1,050 images with dimensions of 224x224 pixels, evenly distributed between the categories \"ASD\" and \"Normal.\" Evaluation using a nuisance matrix shows strong model performance, achieving 90% accuracy, 92% precision, 88% recall, and 90% F1 score. These findings suggest that a more representative dataset and image size optimization can improve the effectiveness of ASD detection. This study significantly supports a more reliable ASD diagnosis through machine learning technology. With promising results, this study paves the way for further application of facial recognition technology in clinical contexts and the potential development of automated detection systems that can be used in daily diagnostic practice." ;
    dcterms:bibliographicCitation "Zainal Z; Melinda M; Away Y; Mawarpury M (2025). Facial Images Dataset for Early Screening of Autism Children Using Convolutional Neural Network. *2025 10th International Conference on Computer and Communi*." ;
    dcterms:creator "Away Y",
        "Mawarpury M",
        "Melinda M",
        "Zainal Z" ;
    dcterms:title "Facial Images Dataset for Early Screening of Autism Children Using Convolutional Neural Network" ;
    bibo:pmid "local_945300a5" ;
    fabio:hasPublicationYear 2025 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Participants appropriate to the question" ;
                            slr:justification "Groups drawn from two different schools, confounding autism status with institution; comparison children unscreened; sex unreported and age inconsistent between narrative and table." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Sample size justified" ;
                            slr:justification "No justification; 70 children yield 1,050 images, and the image count is treated as the sample size throughout." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Data source and eligibility described" ;
                            slr:justification "Recruitment sites, prespecified exclusion criteria (acute illness in both groups; intellectual disability, cerebral palsy and Down syndrome in the autistic group) and the timing relative to therapy sessions are all stated." ;
                            slr:rating "Low" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Predictors defined and measured appropriately" ;
                            slr:justification "Acquisition is exceptionally well controlled - fixed distance, fixed camera settings, controlled lighting, temperature and humidity, restricted session hours, standardised expression protocol." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Predictors assessed blind to outcome" ;
                            slr:justification "Photography was necessarily unblinded and was conducted at different institutions for the two groups; the paper does not state whether the setup or operator was identical at both sites." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Preprocessing applied without leakage" ;
                            slr:justification "Augmentation is configured on the training generator only, and the augmentation parameters are published verbatim." ;
                            slr:rating "Low" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Outcome determined independently of predictors" ;
                            slr:justification "The label derives from school placement, which is independent of the pixel data." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Outcome definition and ascertainment" ;
                            slr:justification "Outcome is school attendance used as a proxy for diagnosis; no instrument, criterion or assessor is reported for either group." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Analysis unit matches the clinical claim" ;
                            slr:justification "Claims concern screening children; every metric is computed over images, at a fixed 15 per child." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Performance measures adequate" ;
                            slr:justification "Accuracy, precision, recall, F1 and a confusion matrix that reconciles exactly with the reported figures - internally consistent, which is uncommon here. But specificity is defined and never reported, no confidence interval accompanies a 102-image estimate, and the 50% chance level is unstated." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Validation design guards against optimism" ;
                            slr:justification "Single unseeded image-level 70/20/10 split with no cross-validation and no repetition; participant separation is impossible by construction although 70 children would have permitted it easily." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Designed factor left unanalysed" ;
                            slr:justification "Three expressions were deliberately elicited and then pooled, with the paper stating that individual expressions were not assessed - discarding the study's only behavioural variable and the analysis that would separate expression production from facial morphology." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Limitations and overinterpretation" ;
                            slr:justification "No limitations section; the conclusion attributes the result to the 1:1 aspect ratio and 224x224 image size and projects use in daily diagnostic practice; unrelated stunting terminology survives in the workflow description." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Posed expression photography: each child produced flat, smiling and sad expressions on instruction, five photographs each. The paper states outright that the process focuses solely on the final classification between Normal and Autism without independently assessing the individual expressions. That is a striking design decision - the expression manipulation is the only behavioural content in the study, it was deliberately elicited, and it is then discarded as a variable. A per-expression analysis would have distinguished a model reading facial morphology from one reading expression production, which is precisely the question the design was built to answer." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-147" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. Group membership is determined by school: the autism group is the set of children attending a Special Elementary School, the comparison group the set attending a State Elementary School. No diagnostic instrument, criterion, assessor, date or record is reported for a single child, and the typically developing children were not screened with any instrument. The study's exclusion of intellectual disability, cerebral palsy and Down syndrome implies some clinical information was available, but its source is never described. School placement is a proxy for diagnosis that also carries administrative, geographic and socioeconomic structure into the label." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-147" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Posed facial expression - flat, smiling and sad - and, implicitly, static facial appearance. Because expressions are pooled before classification, the study cannot say whether the model distinguishes groups by how the children produce expressions or by how their faces look, and the paper does not raise the distinction." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-147" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The most sharply divided reproducibility profile in the corpus. The data side is exemplary: room dimensions, temperature, humidity, lighting, session hours, camera body, ISO, aperture, exposure, capture and output resolution, subject distance, curtain arrangement, expression protocol, per-child photograph counts and the verbatim augmentation configuration are all published, so another laboratory could recreate the acquisition closely. The model side is empty: no architecture, no layer specification, no optimiser, no learning rate, no batch size, no epoch count, no seed, no code, and no deposit for the dataset that the paper exists to introduce. The internal contradictions between narrative and Table I further undercut the acquisition detail, and the survival of stunted child in the workflow description indicates text carried over from an unrelated manuscript." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-147" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "ASD; Normal; CNN; Confusion Matrix; Dataset. Five terms, two of which name an evaluation artefact and a data structure rather than a subject; Normal appears as a keyword in its own right." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-147" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None stated. There is no limitations section. The image-level split across 15 photographs per child, the school-based group assignment standing in for diagnosis, the confounding of group with institution, the absence of any per-expression analysis, and the 102-image test set all pass without comment. The one candid admission is incidental: the study does not record the total number of augmentations applied in the code." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-147" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Accuracy, precision, recall, F1 and a confusion matrix, with sensitivity and specificity defined by formula but specificity never reported numerically. The reported figures reconcile exactly with the confusion-matrix cells - 92 of 102 correct gives 0.902; 47 of 51 predicted-positive gives 0.922; 47 of 53 actual-positive gives 0.887 - which is a level of internal consistency several other studies in this corpus fail to achieve. What is absent is any interval: with 102 test images the 95% confidence interval around 0.90 runs from roughly 0.83 to 0.95, so the comparison against the quoted literature figures of 87%, 88%, 89.2%, 90% and 92% is not discriminating. The abstract also describes the evaluation as using a nuisance matrix." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-147" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "ASD, autism spectrum disorder, children with autism, autistic children, autistic condition, typically developing children, normal children, Normal class. The Normal/Autism class labelling runs throughout including in the figures and conclusion. One artefact of manuscript reuse is worth recording: the description of the testing workflow states that the output classifies the child as either a stunted child (label 1) or a normal child (label 0) - terminology from childhood stunting research that has no place in an autism study and that survived into the published text." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-147" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2025 10th International Conference on Computer and Communication Engineering (ICCCE), IEEE, pages 351-355. A short engineering conference paper. The venue explains but does not excuse the asymmetry between a fully specified acquisition protocol and a completely unspecified model, and the survival of unrelated stunting terminology in the workflow description." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-147" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A single sentence proposing augmentation technologies to generate larger and more diverse datasets, plus unspecified additional techniques. Given that the study's own contribution is a dataset built to address representativeness, proposing synthetic augmentation as the route to further diversity moves away from the recruitment-based solution the paper has just demonstrated." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-147" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Canon EOS M-100 on a tripod, 256 GB storage, ISO 800, f/5.6, 1/25 s, 6000x4000 capture cropped to 1:1 and resized to 224x224. Room instrumentation includes a 17-inch LCD screen and speakers, listed for video viewing although no video task is described. Analysis software is not named; only the Keras ImageDataGenerator augmentation block is printed. Several environmental parameters conflict between the narrative and Table I: lighting 30 W versus 22 W, humidity 40-45% versus 50-60%, acclimation 10-15 minutes versus 3 minutes." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-147" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No multimodal fusion - a single photographic modality. The introduction reviews thermal-imaging work at length (ResNet-50 on facial skin temperature across emotional states) and a thermal branch would have been a natural pairing with this acquisition setup, given that the protocol already controls room temperature and includes a body-temperature acclimation period. Only RGB photographs are collected." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-147" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The stated goal is to address the limited variation and representativeness of existing autism facial-image datasets by building a new dataset with broader variation in facial characteristics, lighting and social context, and to refine a CNN classifier on it. Headline findings: accuracy 0.90, precision 0.92, recall 0.88, F1 0.90 on 102 test images, with 47 and 45 correct classifications against 4 false positives and 6 false negatives. The conclusion attributes the result principally to the choice of a 1:1 aspect ratio and 224x224 image size, which is a claim about preprocessing conventions rather than about autism." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-147" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. No saliency, attribution or ablation, and no per-expression error breakdown despite expression being a designed factor. In a study whose premise is that specific facial characteristics reflect social and emotional traits relevant to autism, no facial characteristic is identified anywhere." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-147" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Reported in more detail than any other study in this corpus. A 7x7 m room with a 2x2 m capture area, black curtains over the windows, air conditioning at 25-27 degrees C, controlled humidity, fixed room lighting, sessions restricted to 09:00-12:00 to limit lighting and temperature variation, a fixed one-metre subject-to-camera distance, a tripod-mounted camera, and a stated acclimation period before capture. The two groups were photographed at different institutions, however - a special school and a state school - and the paper does not report whether the studio setup was physically identical at both sites or whether the same operator ran both. Given how completely the acquisition is otherwise specified, this is the one variable that matters most and is left open." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-147" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A convolutional neural network with a sigmoid output, trained end to end. The architecture is never described. The introduction promises the design of custom layers to optimise detection of ASD-specific visual characteristics, and no custom layer, or indeed any layer, is ever specified. Prior architectures (VGG-19, ShuffleNet, MobileNet, ResNet-18/34/50, AlexNet, VGG16) are discussed only as literature figures." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-147" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional, single session. Ethics reporting is solid: an ethics code number is given (036/EA/FK/2025, Faculty of Medicine), parents signed a consent form before collection, and children were accompanied by their teachers throughout - a safeguarding measure that no other study in this corpus mentions. What is missing is consent for publication of images, since sample photographs of identifiable children appear in Figures 3 and 6, and any statement about the dataset's future distribution, even though building a shareable dataset is presented as the study's primary contribution." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-147" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Thin, and internally inconsistent where present. Age is given as 3 to 14 years in the acquisition narrative and 5 to 15 years in Table I and again in the results; no mean, SD or per-group distribution is provided. Sex is not reported at all. No socioeconomic, ethnic, linguistic or verbal-ability information. The exclusion criteria are unusually explicit for this corpus - children with colds, diarrhoea, lung infections, epilepsy or flu were excluded from both groups, and autistic participants with intellectual disability, cerebral palsy or Down syndrome were excluded - which controls the sample tightly but also removes the co-occurring conditions most likely to be present in a real screening population and narrows the autistic group to those without intellectual disability." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-147" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A single 70/20/10 division at the image level - 369, 105 and 51 images per class - applied to 1,050 photographs from 70 children at exactly 15 photographs each. Participant separation is therefore impossible: five near-identical shots of the same child pulling the same expression, taken minutes apart under fixed lighting at a fixed one-metre distance with the same camera settings, are distributed across training, validation and test. This is the same frame-level leakage documented across the video, EEG-epoch, thermal, cry and facial-image branches of this review, and it is the study's decisive methodological failure - the more so because the acquisition protocol is so tightly controlled that the only systematic variation left between images of different children is the children themselves. Three further points. The split is unrepeated and unseeded, with no cross-validation and no interval on any figure. Training and validation accuracy are reported as reaching nearly 100% within the first few epochs with loss near zero, described as optimal and stable performance without signs of overfitting, while held-out accuracy is 90% - a gap the paper reads as success rather than as evidence about the split. And group membership is perfectly confounded with institution, since all autistic children were photographed at a special school and all comparison children at a state school, so any residual site difference in setup, operator or child preparation is available to the classifier. What would have rescued the design is available and unused: with 70 children, a participant-level split holding out, say, 7 autistic and 7 typically developing children entirely would have cost nothing and produced an interpretable, if less impressive, number." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-147" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. No IQ, developmental, adaptive or language measure, and no autism severity instrument. Intellectual disability appears only as an exclusion criterion." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-147" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2025 IEEE conference proceedings. Framing is optimistic but hedged more than most: the study is said to pave the way for further application of facial recognition technology in clinical contexts and the potential development of automated detection systems that can be used in daily diagnostic practice. The novelty claim is placed on the dataset rather than on the accuracy - the paper's stated purpose is to remedy the poor representativeness of existing autism face datasets, and it does so by actually recruiting and photographing 70 children under a controlled protocol rather than by downloading images. That is a real contribution to a branch of this literature that has otherwise recycled the same web-scraped corpus twelve times over." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-147" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "224x224 RGB face crops at 1:1 aspect ratio, rescaled to [0,1], with training-time augmentation by rotation to 20 degrees, width and height shifts to 0.2, shear 0.2, zoom 0.2 and horizontal flip. Noise removal and contrast enhancement are mentioned without method. The conclusion treats the 1:1 ratio and 224x224 size as the study's principal finding, which places a preprocessing convention where an empirical result should be." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-147" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Seventy children in two recruited groups: 35 with autism from a Special Elementary School in Banda Aceh and 35 typically developing children from a State Elementary School in the same city. Each contributed 15 photographs (three expressions x five shots), giving 1,050 images split evenly 525/525. The analysis unit throughout is the image, not the child: the 70/20/10 division yields 369/105/51 images per class, and the reported metrics rest on 102 test images drawn from the same 70 children who supplied the training images. This is genuine primary data collection with a real, separately recruited comparison group - which distinguishes it sharply from the twelve Kaggle-corpus reuses charted in this review - but the group difference is confounded with school of origin, since every autistic child comes from one institution and every comparison child from another." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-147" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "None re-run. Prior figures are quoted from the literature: VGG-19 and ShuffleNet at 88%, MobileNet at 87% test accuracy, ResNet-50 at 90% and 89.2% on thermal images, ResNet-18 at 81.4%, VGG16 at 87% " ;
                    slr:study_design "Prospective two-site primary data collection (posed facial photography) followed by supervised binary image classification with a single 70/20/10 image-level split." ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: 35 children with autism, 525 images; comparison: 35 typically developing children, 525 images" ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "Accuracy 0.90, precision 0.92, recall 0.88, F1 0.90 on 102 test images. The confusion matrix gives 47 and 45 correct with 4 false positives and 6 false negatives, which reconciles exactly with the reported metrics (92/102 = 0.902; 47/51 = 0.922; 47/53 = 0.887)." ;
                    slr:outcome "Accuracy, precision, recall, F1 and a confusion matrix; sensitivity and specificity are defined by formula but specificity is never reported as a number." ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "Accuracy 0.90, precision 0.92, recall 0.88, F1 0.90 on 102 test images. The confusion matrix gives 47 and 45 correct with 4 false positives and 6 false negatives, which reconciles exactly with the reported metrics (92/102 = 0.902; 47/51 = 0.922; 47/53 = 0.887)." ] ] ;
