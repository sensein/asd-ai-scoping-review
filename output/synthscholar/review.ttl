    slr:journal "Proceedings of the 2017 Inte" ;
    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "Child-independent train/validation/test partitioning with all parameters tuned on validation and the test partition reserved for unseen children, plus significance testing - the correct structure, though the per-feature-set choice of best discriminator layer appears informed by test rather than validation performance." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Secondary use of a convenience clinical corpus with 11 autism-disorder children against 68 controls, restricted to monolingual verbally able children, and with no age or sex data reported at all - matching is asserted but unverifiable." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "Utterance counts per partition are reported and total to 6380, but no child-level flow, no per-group utterance counts in training, and no account of segmentation decisions or excluded audio." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "DSM-IV clinical diagnosis in two university psychiatry departments with no standardised instrument, no inter-rater reliability and control status by teacher questionnaire - thin ground truth for a four-way distinction that includes the clinically subtle AD-versus-PDD-NOS boundary." ] ;
            slr:overall_judgment "some" ;
            slr:tool_used "QUADAS-2" ] .

<https://doi.org/10.1145/3660853.3660888> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Autism spectrum disorder (ASD) is a complex neurological developmental disease that appears in a variety of ways[8]. Most autistic children are not diagnosed until they are at least three years old [6] [13]. Abnormal facial traits caused by development abnormalities are strongly linked to underlying neurological issues [2]. Newborns with ASD have facial development that differs significantly from that of typically developing children [3]. Early detection is crucial to help the parents and families in denial and superstition. Differentiating facial features from normally developing children is a clear way to identify children diagnosed with ASD. In this work, we proposed a facial feature-based ASD detection method. This study uses different deep-learning models to recognize autistic children using only a facial image dataset. This work used five pre-trained CNN models as feature extractors: MobileNet, Xception, VGG16, VGG19, EfficientNet, and a binary classifier to detect autism in children effectively. To train these feature extraction models, we utilized a publicly available Kaggle dataset containing 2940 images of autistic and non-autistic children. The proposed method could detect ASD and non-ASD from the facial images of children. Using CNN models as feature extractors and Logistic regression as a binary classifier, we achieved an accuracy rate approaching 88.33% on test data." ;
    dcterms:bibliographicCitation "Anjum J; Hia NA; Waziha A; Kalpoma KA (2025). Deep Learning-Based Feature Extraction from Children's Facial Images for Autism Spectrum Disorder Detection. *Proceedings of the Cognitive Models and Artif*. https://doi.org/10.1145/3660853.3660888" ;
    dcterms:creator "Anjum J",
        "Hia NA",
        "Kalpoma KA",
        "Waziha A" ;
    dcterms:title "Deep Learning-Based Feature Extraction from Children's Facial Images for Autism Spectrum Disorder Detection" ;
    bibo:doi "10.1145/3660853.3660888" ;
    bibo:pmid "local_d97673f4" ;
    fabio:hasPublicationYear 2025 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Participant selection and spectrum representativeness" ;
                            slr:justification "A public image assembly with no ascertainment, no spectrum description and an unreported number of distinct children behind 2,940 images." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Comparison group adequacy" ;
                            slr:justification "Images of children from non-autism-related sources within the same corpus, with no demographic characterisation and no screening." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Confounder control" ;
                            slr:justification "No age, sex or ancestry data, in a study whose motivating morphometric quantities - upper-face breadth, eye spacing, nose length, mid-face proportion - all vary with each of them. Greyscale and CLAHE preprocessing attenuates colour and illumination but not morphology." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Handling of missing data and attrition" ;
                            slr:justification "Preprocessing configurations and augmentation parameters are specified, but no class distribution, image-quality exclusions or detection failures are reported." ;
                            slr:rating "Unclear" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Outcome measurement blinding" ;
                            slr:justification "Classification is fully automated with no human rater at inference." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Index test definition and prespecification" ;
                            slr:justification "Five extractors, three preprocessing pipelines and the classifier are all specified in advance with augmentation parameters given numerically - but no per-configuration results are reported, so which combination produced the headline is not identified." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Reference standard quality" ;
                            slr:justification "No diagnostic instrument or clinician judgement for any image; the label is folder membership." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Measurement standardisation" ;
                            slr:justification "Uncontrolled internet photographs with unknown and potentially class-correlated acquisition conditions; the greyscale-plus-CLAHE configuration removes colour and normalises local contrast, which addresses two appearance confounds directly." ;
                            slr:rating "Unclear" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Data splitting and leakage control" ;
                            slr:justification "No split, cross-validation scheme or partitioning unit stated anywhere; the number of distinct children is unreported; and augmentation ordering relative to splitting is unspecified." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Preprocessing and feature selection nesting" ;
                            slr:justification "The extractors are frozen pretrained networks, so nothing is fitted to these data except the logistic-regression coefficients - the lowest-capacity configuration among the eight studies on this corpus." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Sample size adequacy for the modelling" ;
                            slr:justification "Frozen extractors with a linear head are well matched to 2,940 images; the effective sample nonetheless depends on the unreported number of distinct children." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Performance estimation and chance level" ;
                            slr:justification "Accuracy alone with a confusion-matrix figure; no sensitivity, specificity, F1, AUC, confidence interval or chance baseline, and no per-extractor or per-configuration breakdown." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Acknowledgement of limitations" ;
                            slr:justification "No limitations section. The provenance confound, absent reference standard, missing demographics and undescribed validation are all unmentioned, though the conclusion's tone is modest and proposes collaboration rather than deployment." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Reporting of results and uncertainty" ;
                            slr:justification "One accuracy figure and a confusion matrix, with no other metric, no interval and no breakdown across the five extractors or three preprocessing pipelines the study set up to compare." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Completeness of methods reporting" ;
                            slr:justification "Corpus source and size, five extractors, classifier, three preprocessing configurations with sample images, augmentation parameters with explanations, software version and hardware are all reported. Class distribution, split, partitioning unit, per-configuration results and hyperparameters are not." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Ethics, consent and conflicts" ;
                            slr:justification "No ethics or consent statement anywhere, for training data consisting of identifiable photographs of children collected from the internet. Funding and competing interests are also absent." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Data, code and protocol availability" ;
                            slr:justification "The Kaggle corpus is public and cited; the software is versioned and the hardware named; no code is released." ;
                            slr:rating "Unclear" ] ;
                    slr:overall_concern "high" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Physiognomic and, in one passage, dismissive of families. The premise is stated as fact: 'abnormal facial traits caused by impairment of embryonic development are significantly related to underlying neurological issues', with autistic infants said to show 'wider eyes, a larger mouth, a shorter middle face, a broader top face, and a pronounced philtrum', and the University of Missouri work cited for 'an atypically broad upper face, which includes wide-set eyes' and 'a shorter nose and cheekbones in the middle of their faces'. The abstract states that 'differentiating facial features from normally developing children is a clear way to identify children diagnosed with ASD' - a considerably stronger claim than the cited morphometric literature supports. 'Normal children' is used in the conclusion as the contrast term. The most unfortunate formulation is in the abstract: 'early detection is crucial to help the parents and families in denial and superstition', which attributes diagnostic delay to parental denial and superstition rather than to the access barriers the same paper elsewhere identifies. Against this, the conclusion's framing of the problem is sympathetic and accurate - 'families often encounter difficulties in recognizing and understanding the symptoms of ASD, resulting in delays in seeking diagnosis and treatment' - and the accessibility argument that follows is the paper's best reasoning. No autistic person is reported as involved." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-138" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Five ImageNet-pretrained networks used as frozen feature extractors with logistic regression as the binary classifier - a deliberate capacity restriction and the study's most defensible modelling decision. A linear classifier on frozen embeddings estimates only as many parameters as there are embedding dimensions, against the millions fitted by the end-to-end networks used on this same corpus elsewhere in the review, so it has far less scope to memorise individual images. Comparing five extractors also gives the architectural breadth that single-model papers lack. The corresponding limitation is that frozen ImageNet embeddings encode general visual appearance rather than anything face-specific or autism-specific, so the representation carries every source-dependent property of the photograph." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-138" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cognitive Models and Artificial Intelligence Conference (AICCONF '24), Istanbul, 25-26 May 2024, ACM, doi 10.1145/3660853.3660888; five pages. A short conference paper from an artificial-intelligence venue, and the profile follows: the preprocessing and augmentation are documented carefully, the software and hardware are versioned, and the five-extractor comparison is set up systematically, while no validation scheme, no class distribution, no per-configuration results, no ethics statement and no limitations section appear." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-138" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Preprocessed face crops in one of three configurations - resize plus normalisation; resize plus normalisation plus CLAHE; resize plus normalisation plus greyscale plus CLAHE - encoded as pretrained CNN embeddings, with augmentation by zoom (1.0 to 1.2) and brightness (0.7 to 1.3). The augmentation parameters are explained rather than merely listed, which is good reporting; the concern is that zoom and brightness variants of one photograph are near-duplicates, so if augmentation preceded splitting the evaluation is compromised, and the paper does not say which order was used." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-138" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Accuracy of 88.33% with a confusion matrix presented as a figure. No precision, recall, specificity, F1, AUC or confidence interval is reported in the retrieved text, and no chance baseline is stated - although a confusion matrix at least permits per-class errors to be read off, which several studies on this corpus do not provide. Notably, no accuracy figures are broken out for the five extractors or the three preprocessing configurations individually, so the comparisons the study set up are not reported in a form that supports conclusions about them." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-138" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. A single image modality throughout." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-138" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No limitations section exists. What should have been stated: the corpus's autistic class is harvested from autism-related online sources, so the label encodes provenance and no diagnostic ascertainment exists for any image; no validation scheme, split proportion or partitioning unit is described anywhere and the number of distinct children is unreported, leaving the standard leakage route for this corpus open and unexaminable; augmentation by zoom and brightness is applied without stating whether it was confined to training, and brightness or zoom variants of a single photograph appearing on both sides of a split are near-duplicates rather than independent observations; no demographic information exists for either class in a study classifying faces, while the study's own motivating morphometric quantities all vary with age, sex and ancestry; only accuracy is reported, with no sensitivity, specificity, interval or chance baseline; and the physiognomic premise is neither measured nor tested against model behaviour." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-138" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. The children were photographed in unknown circumstances for purposes unrelated to any study. This matters for the study's own premise, since the morphometric literature it invokes - intercanthal distance, mid-face height, philtrum length - depends on controlled pose, distance and camera geometry, none of which is available in web-sourced photographs. Even if the morphometric claims were correct, the data could not test them." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-138" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional secondary analysis with no longitudinal element. No ethics or consent statement appears anywhere in the paper, in work whose training data are identifiable photographs of children collected from the internet without their families' knowledge. Funding and competing interests are not stated in the retrieved text." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-138" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. The autism label reflects folder membership in a public collection whose positive class was harvested from autism-associated online content; no child is known to have received a diagnostic assessment, no instrument or clinician judgement is cited, and the paper does not identify the absence as a limitation. This is the eighth study in the review on this corpus family and the position is unchanged across all of them: whatever the models separate, they separate two collections of internet images." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-138" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No validation scheme is described anywhere. The retrieved text states no train-test split proportion, no cross-validation arrangement, no held-out set size and no partitioning unit, while reporting accuracy 'on test data' and presenting a confusion matrix - so a test partition existed and its construction is unstated. The number of distinct children behind 2,940 images is likewise unreported, so whether images of the same child appear on both sides of the boundary cannot be determined; this is the standard failure of the corpus family and is documented in this review for seven other studies on the same images. Augmentation compounds the concern: zoom and brightness variants of a single photograph are near-duplicates rather than independent observations, and the paper does not state whether augmentation preceded or followed splitting - a distinction that another study in this review makes decisive, reporting that its dataset's originators moved from roughly 60% to 92% accuracy by applying seven augmentation techniques to a 100-sample corpus. Two features nonetheless make this study's figure among the more plausible in its branch. Its 88.33% is the second-lowest of the eight Kaggle-corpus studies charted here, which span 81.0% to 99.8%. And its architecture is the one least able to memorise, since frozen pretrained extractors with a logistic-regression head fit only a linear function of fixed embeddings, whereas the higher-scoring studies on the same images fine-tune millions of parameters end to end. Neither observation can be confirmed without the split description, and none of it touches the provenance confound: a model that has learned to recognise images sourced from autism-related web content will perform identically on perfectly subject-disjoint partitions." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-138" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Reported: the corpus with its size and source, all five feature extractors by name, the logistic-regression classifier, the three preprocessing configurations with illustrative sample images, the augmentation parameters with explicit numeric ranges and an explanation of what each does, the software with version, and the hardware. Not reported: class distribution, the number of distinct children, any train-test split or validation arrangement, whether augmentation was applied only to the training partition, hyperparameters, any metric beyond accuracy and a confusion-matrix figure, ethics arrangements, funding and code. The preprocessing description is the most thorough element and is genuinely reusable." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-138" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. No attribution, saliency or coefficient analysis appears. This is a particular loss here because the architecture makes interpretation cheap: with frozen extractors and a linear classifier, inspecting the logistic-regression coefficients would identify which embedding dimensions carry the discriminative signal, and comparing those across the three preprocessing configurations would show whether the signal survives the removal of colour and the normalisation of contrast. That analysis would have spoken directly to the question of whether the model reads facial phenotype or photographic character, and it was one line of code away." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-138" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Published 2024 by a group at Ahsanullah University of Science and Technology in Dhaka. The framing is physiognomic - autistic children are said to show wider eyes, a larger mouth, a shorter mid-face, a broader upper face and a pronounced philtrum, with the abstract asserting that 'differentiating facial features from normally developing children is a clear way to identify children diagnosed with ASD' - and the abstract also attributes diagnostic delay to families 'in denial and superstition', which is the least sympathetic characterisation of parents in this review. For the synthesis the study is the eighth built on the Kaggle facial-image corpus and contributes three observations. Its reported 88.33% is the second-lowest of those eight, which span 81.0% to 99.8%, and its architecture is the one least able to memorise - five frozen ImageNet extractors feeding a logistic-regression head, fitting only a linear function of fixed embeddings against the millions of end-to-end parameters used by the higher-scoring studies on the same images. That pattern is consistent with the review's broader finding that figures in this branch track model capacity and evaluation protocol rather than any signal in the data. Its preprocessing comparison is the most thoughtful in the branch, contrasting three configurations of which one strips colour and normalises local contrast - removing exactly the appearance cues most likely to differ between two image sources - though the per-configuration results are not broken out, so the comparison's answer is not reported. And its accessibility argument is the clearest statement of why this branch exists: 'since capturing a facial image is simpler compared to other detection methods, we anticipate a significant reduction in the difficulty of ASD detection', with the whole pipeline running on a laptop GPU and a public dataset. Against all of this stand the branch's standing problems, none addressed here: no diagnostic ascertainment for any image, no validation scheme or partitioning unit described anywhere, the number of distinct children unreported, augmentation applied without stating whether it preceded splitting, no demographic data in a study whose premise is morphometric, only accuracy reported, and no ethics or consent statement for identifiable photographs of children taken from the internet." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-138" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. No severity, cognitive, adaptive or language measure exists for any image." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-138" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No acquisition equipment. Analysis ran in Jupyter Notebook on TensorFlow 2.10.0 with an NVIDIA GeForce GTX 1650 Ti Max-Q - a laptop GPU. Reporting the hardware is a small but genuine transparency, and it substantiates the accessibility argument the conclusion makes: this pipeline requires a consumer laptop and a public dataset, which is why the branch is so heavily populated." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-138" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No study setting. The corpus is a public Kaggle assembly of children's photographs harvested from the internet, with the two classes drawn from different kinds of online source - the construction principle documented across this review's facial-image branch, in which collection route is the one respect in which the two image populations are known to differ." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-138" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Collaboration with others in the field, per the conclusion. The steps the study most needs are participant-level splitting with the number of distinct children reported, a stated validation scheme, per-class metrics, and - given the frozen-extractor architecture - a coefficient analysis showing which embedding dimensions carry the signal, which would at least locate the discriminative information." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-138" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "There are no participants. The units are 2,940 facial images from the Kaggle autistic-children corpus - the eighth study in this review built on this dataset family - with the number of distinct children never stated and no age, sex, ancestry, cognitive, language or clinical information available for either class. The corpus's construction is the determining fact: its autistic images were harvested from autism-related online sources and its comparison images from elsewhere, so the label records where an image was found rather than any assessment of the child in it. This study does not restate that provenance, but it inherits it." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-138" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Nominally craniofacial morphology and operationally whatever separates two internet image folders. The motivating claims are unusually specific - wider eyes, larger mouth, shorter mid-face, broader upper face, pronounced philtrum, shorter nose - and none is measured: no landmarks are detected, no distances or ratios computed, and the models receive whole preprocessed face crops. The three preprocessing configurations do bear on this indirectly and constitute the study's most interesting technical choice: greyscale conversion removes colour and therefore skin tone, and CLAHE normalises local contrast, so the greyscale-plus-CLAHE configuration strips two of the appearance cues most likely to differ between image sources. Comparing configurations that differ in exactly which appearance information is retained is the right instinct for this problem, and a systematic report of accuracy across the three would have been informative about how much of the signal survives when colour and illumination are removed. That comparison is set up and its results are not broken out in the retrieved text." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-138" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The aim is autism detection from facial images alone, using pretrained convolutional networks as feature extractors with a simple downstream classifier. Five extractors - MobileNet, Xception, VGG16, VGG19 and EfficientNet - were compared across three preprocessing configurations, with augmentation applied, and the best combination reached 88.33% accuracy on test data, supported by a confusion matrix. The figure is the second-lowest among the eight Kaggle-corpus studies charted in this review, which range from 81.0% to 99.8%, and the architecture is the one least able to memorise: frozen pretrained extractors with a logistic-regression head have far fewer fitted parameters than the end-to-end fine-tuned networks used elsewhere on the same images. Whether the lower figure reflects that restraint or simply a different split cannot be determined, because no validation scheme is described." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-138" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Entirely absent. No age, sex, ancestry, socioeconomic, cognitive or comorbidity information exists for either image class, and none could, given how the corpus was assembled. The omission is consequential because the study's own motivating claims are morphometric - upper-face breadth, eye spacing, nose length, mid-face proportions, philtrum prominence - and every one of these varies systematically with age, sex and ancestry. A model reading whole face crops from two internet-sourced folders has access to all three, and nothing reported allows any of them to be excluded as the operative signal." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-138" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Keywords: Autism Spectrum Disorder, Kaggle Facial Image Dataset, Pre-trained CNN Model, Feature Extraction, Logistic Regression. Naming the dataset explicitly in the keyword list is a small transparency worth noting - it makes the corpus's reuse traceable, which is how this review has been able to identify eight studies built on the same images." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-138" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:study_design "Retrospective algorithm-development study comparing five frozen pretrained feature extractors and three preprocessing pipelines on a public facial-image corpus" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: ; comparison: As above" ] ] ;
    slr:content_sha256 "cf1318c83e069b40fc4d795aeeadb08758fa3c4f36d27d5fbdeca9a55f6aca18" ;
