        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "we repeated these analyses on a sub-sample of 28 subjects with ASD closely matched for IQ with 28 TD controls. In these 28 matched pairs (mean IQ = 113.4; p-value = 0.98), a similar pattern of results was obtained for FMC with respect to both overall accuracy (77.6%) and discriminant ability (ROC AUC = 88.27%)." ] ;
            oa:hasTarget <https://doi.org/10.3389/fpsyg.2021.665096> ;
            slr:claim_label "An IQ-matched subsample replication reproduced and exceeded the main result, showing the group IQ difference was not driving classification." ;
            slr:relevance_score "0.95"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "Our approach achieves state-of-the-art performance on ABIDE-I, with up to 96.4% classification accuracy and an area under the ROC curve (AUC) of 0.92" ] ;
            oa:hasTarget <https://doi.org/10.3390/diagnostics15172232> ;
            slr:claim_label "Irreconcilable with the abstract's 99.40% accuracy and 99.99% ROC-AUC, in the same paper, with no reconciliation offered anywhere." ;
