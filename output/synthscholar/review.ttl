    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Self-selected users of an autism screening application, aggregated on Kaggle, with no class distribution and no demographic composition reported despite age, gender and ethnicity being among the enumerated fields." ],
                [ a slr:RoBDomainJudgment ;
