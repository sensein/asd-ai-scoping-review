    slr:journal "Jo" ;
    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "The index test is not prespecified: both the segment window length (10 candidates) and the ASD-like proportion threshold were selected to maximise accuracy on the same 39 children whose accuracy is then reported, and the feature subset was selected by forward selection outside the cross-validation loop. QUADAS-2 asks whether the threshold was prespecified; here it was explicitly not. Interpretation of the index test was automated and so blind to the reference standard in the ordinary sense, but the tuning procedure had access to the labels of every child." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "Diagnosis followed DSM-IV criteria applied by a licensed psychiatrist of at least five years' experience, re-evaluated by a senior psychiatrist, with adjudication by two further senior psychiatrists on disagreement. Multi-clinician consensus is a reasonable standard and is more than several studies in this corpus provide, but no standardised instrument was used - the authors state they had limited access to ADOS and ADI-R - no inter-rater reliability is quantified, DSM-IV rather than DSM-5 was applied in work published in 2022, and TD status rests on community recruitment plus self/parent report with no autism screening instrument administered, so undetected autistic traits in the control group cannot be ruled out." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Case-control sampling with autistic children drawn from a specialist mental health centre and typically developing children from the surrounding community - a design QUADAS-2 flags explicitly as high risk for diagnostic accuracy. Eligibility further narrows the autistic group to children aged 6-13 with non-verbal IQ >= 70, adequate conversational ability, no ADHD or schizophrenia and no current medication, excluding by construction the more severely affected and the comorbid, who are the children a screening tool would most need to handle. Enrolment was consecutive or convenience - not stated. Four of 43 (9.3%) were dropped for tracking failure with no comparison of their characteristics. The groups differ significantly in IQ (100.8 versus 116.1, p = .019), which is not adjusted for." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "The interval between clinical diagnosis and eye-tracking is not reported. All 39 analysed participants received both the index test and the reference standard and all were included in the analysis, but the four excluded for technical failure are not characterised. The decisive problem is the unit of analysis: segments rather than children were randomly assigned to cross-validation folds, so the same participant contributes to both training and test data, and the participant-level result is computed from those same labels rather than from an independent set of children." ] ;
            slr:overall_judgment "high" ;
            slr:tool_used "QUADAS-2" ] .

<https://doi.org/10.1145/3539226> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "25 Stratification of Children with Autism Spectrum Disorder Through Fusion of Temporal Information in Eye-gaze Scan-Paths ADHAM ATYABI, University of Colorado Colorado Springs FREDERICK SHIC, University of Washington and Seattle Children’s Research Institute JIAJUN JIANG, Old Dominion University CLAIRE E. FOSTER, Binghamton University (SUNY), Binghamton ERIN BARNEY, Seattle Children’s Research Institute MINAH KIM, University of Virginia BEIBIN LI, University of Washington PAMELA VENTOLA, Yale University CHUNG HAO CHEN, Old Dominion University" ;
    dcterms:bibliographicCitation "Atyabi A; Shic F; Jiang J; Foster CE; Barney E; Kim M; Li B; Ventola P; Chen CH (2023). Stratification of Children with Autism Spectrum Disorder Through Fusion of Temporal Information in Eye-gaze Scan-Paths. **. https://doi.org/10.1145/3539226" ;
    dcterms:creator "Atyabi A",
        "Barney E",
        "Chen CH",
        "Foster CE",
        "Jiang J",
        "Kim M",
        "Li B",
        "Shic F",
        "Ventola P" ;
    dcterms:title "Stratification of Children with Autism Spectrum Disorder Through Fusion of Temporal Information in Eye-gaze Scan-Paths" ;
    bibo:doi "10.1145/3539226" ;
    bibo:pmid "local_5c43dffa" ;
    fabio:hasPublicationYear 2023 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Confounder control" ;
                            slr:justification "None attempted for the diagnosis analysis, and the study itself supplies the evidence that this matters: scan-path images classify sex within the autistic group at 78.0% and age band at 80.5%, both above the 74.4% achieved for diagnosis, while the groups are 81.5% versus 46.9% male and 31.5% versus 15.6% aged 10 or over. The connection is never drawn." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Handling of missing data and attrition" ;
                            slr:justification "Thirteen participants excluded for invalid data with no characterisation; no tracking-ratio, data-loss or trial-rejection criteria reported; and no eye-tracker or acquisition parameters given at all, so data quality cannot be assessed. Exposure to individual video clips ranged from 1 to 92 viewings, so the effective stimulus set differs between participants." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Comparison group adequacy" ;
                            slr:justification "Thirty-two typically developing children with no screening information and no clinical comparison group, and with a materially different age and sex profile from the autistic group." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Participant selection and spectrum representativeness" ;
                            slr:justification "Fifty-four (or 55) autistic children with no diagnostic characterisation, no IQ, no severity measure and no stated recruitment route. Thirteen of 99 enrolled excluded for invalid data without description. Age spans infancy to adulthood in five bands, so the sample is developmentally heterogeneous in a way no analysis of the diagnosis result accounts for." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Measurement standardisation" ;
                            slr:justification "The stimulus battery itself is exceptionally well designed and standardised in construct, with explicit controls and foils. But no eye tracker, sampling rate, display, viewing distance or calibration is reported - and gaze velocity, the paper's headline representational addition, is a quantity whose value depends directly on the unreported sampling rate. Participants also viewed different subsets of clips." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Index test definition and prespecification" ;
                            slr:justification "Dropout and epoch settings swept with the best reported; augmentation applied at three levels with the highest-augmentation result presented as the finding; multiple representations and stimulus subsets evaluated on the same data with no development set." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Reference standard quality" ;
                            slr:justification "Not described. No instrument, criteria, clinician or procedure for either group anywhere in the retrieved text." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Outcome measurement blinding" ;
                            slr:justification "Rendering and classification are fully automated from gaze coordinates; no human rating enters the pipeline." ;
                            slr:rating "Low" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Performance estimation and chance level" ;
                            slr:justification "Training accuracy is reported alongside test accuracy and AUC in every table, which makes the 20-30 point overfitting gap visible and is a real transparency virtue; temporal experiments are repeated three times and averaged. But no sensitivity, specificity, precision, recall, F1 or confusion matrix appears anywhere, no confidence intervals are given, and no chance baseline is computed." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Data splitting and leakage control" ;
                            slr:justification "Image-level splitting with roughly sixteen images per child and no subject-disjoint evaluation reported anywhere. Augmented counts quoted for whole datasets rather than training partitions, implying rotated duplicates straddling the split - corroborated by test accuracy rising monotonically with augmentation level to 98.8%." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Preprocessing and feature selection nesting" ;
                            slr:justification "Augmentation appears to precede splitting. The per-clip ablation that ranks stimulus contributions is computed on the same data used for the headline result." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Sample size adequacy for the modelling" ;
                            slr:justification "Eighty-six children, and far fewer in the subgroup analyses - the sex-by-age experiment rests on 4 female and 19 male autistic children aged 5-9, expanded to thousands of images by augmentation. Training accuracy of 100% at every setting indicates complete memorisation." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Data, code and protocol availability" ;
                            slr:justification "No code, no data, no preregistration, and no statement on availability of either." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Acknowledgement of limitations" ;
                            slr:justification "No limitations section. The two constraints acknowledged - too few female autistic participants, and class imbalance depressing AUC - are framed as problems augmentation solves. Nothing about image-level splitting, the augmentation-accuracy relationship, the universal 100% training accuracy, the missing reference standard, or the demographic confound that the paper's own experiments quantify." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Completeness of methods reporting" ;
                            slr:justification "The stimulus constructs, the full 43-clip list with view counts, the rendering and downsampling, the temporal windowing, the velocity formula and colour mapping, the swept hyperparameters, the split ratios and every experimental image count are all specified. Absent: the eye tracker and all acquisition parameters, the diagnostic procedure, the network architectures beyond a figure, the augmentation parameters, and the image-to-participant mapping - the last being the one fact needed to assess every result in the paper." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Ethics, consent and conflicts" ;
                            slr:justification "No ethics approval statement, no consent statement and no competing-interests declaration in the retrieved text, for a study involving children including infants. Funding from NIH and the Simons Foundation is stated." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Reporting of results and uncertainty" ;
                            slr:justification "Fourteen tables with training accuracy, test accuracy and AUC for every configuration, and three-repeat averaging in the temporal experiments - thorough by the standards of this corpus, and the inclusion of training accuracy is genuinely useful. But no class-conditional metric of any kind, no confidence intervals, no chance baseline, and an unresolved 55-versus-54 discrepancy in the sample size." ;
                            slr:rating "Unclear" ] ;
                    slr:overall_concern "high" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "There is no limitations section, and the two constraints acknowledged in passing - too few female autistic participants for sex analysis outside the 5-9 band, and class imbalance depressing AUC - are both treated as problems that augmentation solves rather than as bounds on inference. The unaddressed issues are severe and partly self-documented. The splitting unit is the scan-path image, and with roughly sixteen images per child each test image has about eleven siblings from the same participant in training; no subject-disjoint result appears anywhere in the paper. Augmentation compounds this: image counts after augmentation are quoted for the whole dataset rather than for the training partition, and the sex-by-age experiment shows test accuracy rising monotonically with augmentation level - 85.07% at 961/957 images, 85.81% at 1,276/1,259, and 98.84% at 3,121/2,905 - which is the characteristic signature of rotated duplicates falling on both sides of the split, since a genuine signal does not strengthen with synthetic replication. The 98.8% is nonetheless presented as evidence of 'substantial difference' between male and female autistic children. Training accuracy is 100% or within a fraction of it in essentially every table while test accuracy ranges from 67% to 81%, a twenty-to-thirty point gap noted once as 'a gap in performance' and never analysed. And the study's own results contain the material for its strongest self-critique: it shows that scan-path images encode age at 80.5% and sex at 78.0% within the autistic group, both higher than the 74.4% achieved for diagnosis, in a sample where the autistic group is 81.5% male against 46.9% and twice as likely to be aged 10 or over. Those two facts are reported four pages apart and never brought together. Beyond this: no reference standard, no IQ or severity measure despite an abstract that invokes intellectual impairment, no ethics or consent statement, no eye-tracker description, no sensitivity or specificity, no confidence intervals, and an unresolved discrepancy between 55 and 54 autistic participants." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-109" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The best-designed stimulus battery in this corpus, and described with a care that the rest of the methods does not match. Four tasks were chosen on three explicit criteria - strong construct performance, demonstrated between-group discrimination, and relation to autism symptoms in prior work with school-aged children. Activity Monitoring shows two actresses using child-directed speech and directing gaze to each other or to the activity between them, with clusters of colourful but irrelevant toys as deliberate distractors. Dyadic Bid is the most carefully constructed: an actor periodically addresses the camera while the two non-speaking actors either look silently at the viewer - included both as a control, to ensure the participant is not merely following a face that looks at them, and as a competing-face distractor - or look down with subtle hand movements, included as a foil controlling for the salience of the speaker's mouth movements. Social Referencing films escalating stressful episodes with distinct escalation, critical-event and resolution phases, such as a balloon inflated until it bursts. Theory of Mind implements a naturalistic false-belief scenario in which an antagonist repeatedly relocates objects unbeknown to a protagonist. Building explicit controls and foils into the stimuli rather than relying on post-hoc statistical adjustment is the kind of design reasoning that most studies here omit entirely. Against this, exposure to individual clips was extremely uneven - Table 6 shows clips viewed 92, 90, 62, 61 or 60 times alongside eighteen clips viewed exactly once - so the effective stimulus set is much smaller than the 43 clips listed, and participants did not all see the same material." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-109" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Social attention, decomposed into four constructs with distinct developmental and clinical significance rather than treated as a single quantity. Activity monitoring - attending to what others are doing together - is targeted with deliberate irrelevant distractors present. Dyadic bid sensitivity - responsiveness to another person's overture for engagement - is targeted with two built-in controls that distinguish genuine responsiveness from mere gaze-following and from mouth-movement salience. Social referencing - seeking clarifying information from others' faces in uncertain situations - is targeted with escalating stressful episodes containing a discrete critical event. Theory of mind - spontaneous processing of another's beliefs - is targeted with a naturalistic false-belief scenario. The measured behaviour is where and when the child looks within these scenes, rendered as a trajectory image. Two further behavioural findings emerge from the analysis rather than the design. Discrimination is strongest in the first three seconds of a clip and declines steadily thereafter, suggesting that the initial orienting response carries more diagnostic information than sustained viewing. And gaze velocity, added as colour, improves discrimination substantially over position alone in the same time window (71.74% to 80.25%), indicating that how fast the eyes move between points carries information the trajectory shape does not." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-109" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "ACM Transactions on Knowledge Discovery from Data 17(2), Article 25, published 20 February 2023; received 15 July 2021, accepted 8 May 2022, online 3 June 2022 - a ten-month review at a data-mining journal. The venue explains the paper's shape: twenty pages with fourteen results tables systematically varying representation, temporal window, stimulus subset and augmentation level, alongside almost no clinical reporting - no diagnostic procedure, no demographics beyond age band and sex, no ethics statement, no sensitivity or specificity. Open access support is provided by six institutions. The article had accumulated 18 citations and 2,645 downloads at retrieval." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-109" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The stated objective is to test whether scan-path images - spatial representations of gaze - can stratify autism from typical development, and then whether they also capture the age and sex variation that makes autism biomarkers hard to generalise. The two contributions claimed are incorporating temporal information into scan-path images and infusing gaze velocity into them. Findings, in the paper's own summary order: spatial scan-paths separate autism from typical development at 74.4% test accuracy (AUC 0.68-0.72); scan-paths separate 2-4 year old from 10-17 year old autistic children at 80.5% (AUC 0.868); scan-paths separate male from female autistic children at 78.0% (AUC 0.850); and within the 5-9 year autistic subgroup they separate male from female at 98.8%. Temporal windowing shows the first three seconds of viewing discriminate best (76.3%) with a monotone decline to 70.2% by 12-15 seconds. Velocity-based colour coding raises the 3-6 second window from 71.74% to 80.25% (AUC 0.839), the paper's headline representational result. Per-clip ablation ranks the contribution of individual videos, with Theory of Mind and Dyadic Bid clips mattering most. The authors read the age and sex results as evidence that scan-paths capture heterogeneity; they can equally be read as evidence that the diagnostic result is confounded, since the two groups differ substantially on both variables." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-109" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A 100 x 100 image per participant per video clip, produced by drawing the gaze trajectory on a 1680 x 1050 black background and downsampling. The downsampling is aggressive - each output pixel spans roughly 17 x 11 input pixels - so fine spatial structure such as whether gaze fell on an eye or a cheek is not preserved, and what survives is the coarse geometry of the trajectory: its extent, its density, how many times it crosses itself. Three enrichments are then tested. Temporal restriction to 3-second or 1-second windows, which encodes time by segmentation rather than within the image. Velocity colour coding, which maps average speed between consecutive points - Euclidean distance over time interval - onto a colour scale with stated thresholds. And rotation-based augmentation, which generates additional images and is applied at three levels in one experiment. Two properties of this representation matter for interpretation. Because the image is a drawing, incidental graphical characteristics such as total ink and plotted extent are available to the network alongside behavioural ones, and no analysis distinguishes them. And because velocity depends on sampling rate, which is never stated, the velocity encoding cannot be reproduced or compared across studies." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-109" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "'Children with Autism Spectrum Disorder (ASD)' and 'Typically Developing (TD)' throughout, person-first and consistent, in the register of a computational health-informatics paper. Clinical description is deficit-framed but restrained: autism is 'a neurodevelopmental disorder associated with social communication deficits and repetitive behaviors', with 'deficit in social attention' and 'atypicality in social attention' as the operative constructs. One passage uses 'ASD patients' when summarising prior work. The framing of purpose is unusual for this corpus in being oriented towards heterogeneity rather than detection: the stated motivation is that 'the observed heterogeneity in autism' compounds the subjectivity of clinical assessment, and that 'ASD heterogeneity and proven difficulty to identify generalizable markers of ASD have led to the presumption of the presence of multiple etiologies rather than a single disorder'. That is a defensible scientific position and it drives the study's most interesting experiments. There is no neurodiversity framing and no autistic-community involvement. One factual error should be noted: the paper states that 'ASD prevalence is found to have a gender bias with one in four individuals with ASD diagnosis being male', which inverts the well-established ratio." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-109" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Training accuracy, test accuracy and AUC for every configuration across fourteen tables - and the decision to report training accuracy is worth crediting, because it makes visible what most papers in this corpus conceal: the models reach 100% training accuracy in essentially every experiment while testing between 67% and 81%. A reader can therefore see the overfitting directly rather than having to infer it. AUC is also reported throughout, which is better than accuracy alone, and the paper reasons about the gap between accuracy and AUC, correctly attributing the low AUC to class imbalance in the training data. Against this, no sensitivity, specificity, precision, recall, F1 or confusion matrix appears anywhere, so nothing is known about the error profile or about which class the models fail on. No confidence intervals are given; the temporal experiments are repeated three times and averaged, which gives some sense of stability, but the diagnosis and stratification headlines rest on single splits. And no chance baseline is stated, although after augmentation the classes are near-balanced." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-109" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A dense neural network and a convolutional neural network, compared throughout at two dropout rates (0.2, 0.5) and two epoch counts (50, 100), with both reported and the better bolded in each table. No classical baseline, no majority classifier, and no architecture search beyond dropout and epochs; the networks are shown only as a schematic figure. The modelling is deliberately simple and the paper's intellectual investment sits in the input representation rather than the classifier, which is a reasonable division for a study whose claimed contributions are representational. The consistent pattern across every table is diagnostic of the setup rather than of the models: training accuracy reaches 100% or 99.9% almost everywhere while test accuracy sits between 67% and 81%, so both architectures memorise the training images completely at every setting tried, and dropout at either level does not prevent it." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-109" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The weakest element, and the paper contains the evidence for its own strongest critique. The splitting unit is the scan-path image at 7:3 or 75:25, and no participant-level or subject-disjoint evaluation is reported anywhere in twenty pages. With 86 participants generating 1,414 clip viewings, each child contributes roughly sixteen images, so a random image-level split places about eleven of a test child's own scan-paths in training - and scan-paths from one child viewing different clips share that child's habitual gaze extent, saccade amplitude and scanning style. Rotation-based augmentation makes this worse rather than better, because augmented counts are quoted for the whole dataset rather than for training partitions, implying that rotated copies of a single scan-path can appear on both sides of the split. The sex-by-age experiment then supplies near-direct evidence of this: test accuracy rises monotonically with augmentation level, from 85.07% at 961/957 images through 85.81% at 1,276/1,259 to 98.84% at 3,121/2,905. A real signal does not strengthen when synthetic copies are added; a duplicate-leakage artefact does exactly this. The 98.8% is nevertheless reported as the paper's most striking stratification result. Training accuracy of 100% in almost every table confirms complete memorisation at every setting. Layered on top of the leakage is a confound the paper documents without recognising: it establishes that scan-path images predict age band at 80.5% and sex at 78.0% within the autistic group - both above the 74.4% achieved for diagnosis - while its diagnostic groups differ by 35 percentage points in sex composition and by a factor of two in the proportion aged 10 or over. Taken together these mean the headline diagnosis figure cannot be attributed to autism-related looking patterns rather than to age and sex. The corrective design is straightforward and would be genuinely valuable given the quality of the stimulus battery: split by participant, augment only within training folds, and evaluate diagnosis within age-and-sex-matched strata using the paper's own demographic classifiers as a check." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-109" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No cross-sensor fusion, but the paper is one of the more informative in this corpus about fusing information types within a single modality, and it reports the ablation cleanly. Three representations are compared on the same data. Spatial scan-paths encode position only and give 74.4% for diagnosis. Spatio-temporal scan-paths encode position within bounded time windows, which allows the temporal locus of discrimination to be identified (76.3% in the first three seconds, declining to 70.2% by 12-15 seconds) but does not by itself improve peak performance. Velocity-infused spatio-temporal scan-paths encode position, time window and speed simultaneously by using velocity as the colour channel, and raise the 3-6 second window from 71.74% to 80.25% with AUC improving from 0.790 to 0.839 - a gain of 8.5 accuracy points from adding a derivative of the same underlying signal. That is a well-controlled demonstration that a rendered-image representation can be enriched with dynamics rather than discarding them, and it addresses head-on the central weakness of scan-path-image approaches, which is that drawing a trajectory throws away time. The caveat is that all three representations were evaluated under the same image-level splitting and the same whole-dataset augmentation, so the ordering is more trustworthy than the absolute values." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-109" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Ninety-nine children were enrolled and 86 had valid eye-gaze data - 54 autistic and 32 typically developing according to Table 1 and the participant text, though the abstract states 55 autistic, an unresolved inconsistency. The 13 excluded participants are not characterised. Participants span the full paediatric age range and are grouped into five bands, with the autistic group distributed 3/11/23/13/4 across 0-1, 2-4, 5-9, 10-17 and 18+ years and the comparison group 5/6/16/5/0. Sex composition differs sharply: 44 male and 10 female among autistic participants (81.5% male) against 15 male and 17 female among comparison participants (46.9% male). The paper states plainly that 'each subject has a different number of recorded ET videos and the data is unbalanced with respect to diagnosis, age, and gender'. The modelled unit is not the child but the scan-path image, one per participant per video clip: 1,012 autistic and 380 typically developing images before augmentation, from 1,414 total clip viewings across 86 children - roughly sixteen images per child, unevenly distributed since Table 6 shows individual clips viewed anywhere from once to 92 times." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-109" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Sharply uneven. The stimulus design, the per-clip view counts, the rendering resolution and downsampling, the temporal windowing scheme, the velocity formula and colour mapping, the dropout and epoch settings, the split ratios and the image counts for every one of fourteen experimental tables are all specified precisely - so the analysis pipeline is largely reconstructible. Almost everything about the data is not: no eye tracker or acquisition parameters, no diagnostic procedure, no demographics beyond age band and sex, no ethics or consent statement, no mapping from images to participants, no augmentation parameters, no seeds or split specifications, and no code or data. The mapping from images to participants is the single most consequential omission, because without it a reader cannot verify whether any evaluation in the paper is subject-disjoint - and nothing in the text suggests any of them is." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-109" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional with no follow-up and no test-retest assessment. The study is nonetheless the most thorough in this corpus on within-trial temporal structure: gaze is analysed in successive non-overlapping 3-second windows across the first 15 seconds, and separately in 1-second sub-windows, revealing that discrimination is highest in the first three seconds (76.3%) and declines steadily thereafter (71.7%, 69.3%, 71.0%, 70.2%). That is a substantive finding about when social attention differentiates, and it has a practical implication the paper does not draw out - that a shorter protocol may lose little. No ethics approval, consent statement, or competing-interests declaration appears in the retrieved text, which for a study of children including infants is a significant reporting omission whatever the underlying governance. Funding from an NIH K01 award and a Simons Foundation grant is stated." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-109" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Not reported. The paper describes no eye tracker, sampling rate, display, viewing distance, calibration procedure or recording software - a striking gap in a study whose entire input is eye-tracking data and which computes gaze velocity, a quantity whose meaning depends directly on sampling rate. What is specified is the downstream rendering: scan-paths are drawn on a black background at 1680 x 1050, resized to 100 x 100 and converted to greyscale, with velocity encoded as colour in the final experiments through a stated threshold mapping. Modelling used DNN and CNN architectures shown only as a figure." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-109" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "CCS concepts: supervised learning by classification, neural networks, health informatics. Additional keywords: Autism Spectrum Disorder, eye tracking, eye-gaze scan-path, Convolution Neural Network. All are method or modality labels; no application term such as screening or diagnosis appears, consistent with a paper whose stated contribution is representational. The organising term throughout the body is 'stratification' rather than classification or detection - used both for separating autism from typical development and for separating subgroups within autism - which reflects the paper's heterogeneity framing. Other recurring terms: spatio-temporal scan-paths, velocity fusion, ASD heterogeneity, biomarker discovery, social attention." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-109" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No future-work section. The conclusion restates the finding that velocity-infused spatio-temporal scan-paths capture patterns associated with age, sex and their interaction, framed as progress on the heterogeneity problem. The steps the study's own results most clearly call for are absent from the paper: subject-disjoint evaluation, augmentation applied only within training folds, and - most importantly - a diagnosis classifier stratified or matched on age and sex, since the paper has itself established that both are strongly encoded in the representation and both differ substantially between its diagnostic groups." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-109" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Described only as a naturalistic study with a battery of eye-tracking video stimuli; no site, room, equipment or procedure is given in the retrieved text. The authorship spans seven United States institutions including the Yale Child Study Center and Seattle Children's Research Institute, and the paper notes that its paradigm 'share similarities with recent studies of autism biomarker Consortium for Clinical Trials (ABC-CT)', which locates the work within a serious clinical-research programme even though the report itself supplies no setting detail. The recruitment geometry cannot be assessed because recruitment is not described." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-109" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Not described. The retrieved text contains no diagnostic instrument, criteria, clinician, procedure, date or setting for either group; participants are simply designated ASD or TD. This is a notable omission for a study from a group closely associated with the Autism Biomarkers Consortium for Clinical Trials, whose tasks the paper says its battery resembles, and it sits awkwardly with an introduction that criticises clinical assessment for being subjective and providing 'minimal information about the underlying mechanism of the disorder'. Whatever the actual ascertainment - and given the authorship it was very likely rigorous - the paper as published does not state it, so the target being predicted is undefined from the report alone." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-109" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No model interpretability whatsoever - no saliency, class activation, filter visualisation or error analysis is applied to either network, so the study cannot say what feature of a scan-path image produces a prediction. Its interpretive work is entirely at the input level and is systematic: individual video clips are removed one at a time and the models retrained, ranking each clip's contribution and showing that Theory of Mind and Dyadic Bid clips matter most while one Social Referencing clip matters least; scan-paths are restricted to successive temporal windows to locate when in a trial the discriminative information lies; and velocity encoding is added and removed to test whether dynamics contribute beyond position. These ablations yield findings a clinician could act on - that the first three seconds carry the most signal, that certain stimulus types are more informative than others - and are more useful than a saliency map would have been for stimulus design. But they say nothing about whether the network is responding to where the child looked or to how much of the canvas the drawing covers, which is the question a scan-path-image method most needs to answer." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-109" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Published 2023 by a seven-institution United States consortium including the Yale Child Study Center, Seattle Children's Research Institute and the University of Washington, funded by an NIH K01 award and a Simons Foundation grant, with a first author who also leads the AAC-telemetry study charted elsewhere in this review and a senior author (Shic) whose eye-tracking work recurs throughout this literature. The framing is heterogeneity rather than detection, and it is argued rather than asserted: clinical assessment is subjective and expert-dependent, autism heterogeneity has 'led to the presumption of the presence of multiple etiologies rather than a single disorder', and the quest for personalised medicine is obstructed by it - so a method that can parse subgroups is more valuable than one that only separates cases from controls. The literature review is the most thorough of any study in this corpus on the specific question of scan-path classification, surveying Carette's LSTM work (83% on 32 children), Li's oculomotor behaviour framework (80% on 49 children), Elbattah's autoencoder clustering, the Saliency4ASD grand challenge submissions of Tao and Shyu (74.22% validation falling to 55.66% on test, attributed to overfitting) and Wu (65.41% and 55.13%), and Pusiol's Fragile X work - and it criticises several of them on exactly the right grounds, noting where validation-to-test performance collapsed and where the stratification comparisons needed to support a heterogeneity claim were not reported. The paper's own most valuable contribution to this review is an unintended one: by demonstrating that scan-path images classify age at 80.5% and sex at 78.0% within a single diagnostic group, it quantifies how much demographic information this widely used representation carries, and therefore how much caution the many scan-path autism classifiers in this corpus require." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-109" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Age band and sex are reported per group in two tables and nothing else is. No IQ, language level, severity, comorbidity, medication, socioeconomic status, race or ethnicity appears anywhere, and no exact ages, means or statistical comparisons are given. The two variables that are reported are the two that matter most here, and both are badly imbalanced. Sex: 81.5% male in the autistic group against 46.9% in the comparison group, a difference of nearly 35 percentage points. Age: 31.5% of autistic participants are aged 10 or over against 15.6% of comparison participants, and all four participants aged 18 or over are autistic while all remaining comparison participants are under 18. Ordinarily these would be recorded as uncontrolled confounds of unknown magnitude. What makes this study distinctive is that it measures their magnitude itself: its own experiments show that scan-path images predict sex within the autistic group at 78.0% accuracy with AUC 0.850, and age band within the autistic group at 80.5% with AUC 0.868. Both figures exceed the 74.4% achieved for diagnosis. So the study demonstrates that its input representation carries demographic information at least as strongly as diagnostic information, in a sample where the demographics differ substantially between diagnostic groups - and the two results are presented in consecutive sections without the connection being drawn." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-109" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. No cognitive, language, adaptive or severity measure is reported for any participant. The absence is more consequential here than in most studies because the paper's opening claim is explicitly about clinical gradation: 'in children with ASD, these patterns change with intellectual and social impairments, suggesting that patterns of social attention provide indices of clinically meaningful variation in ASD'. That is a claim about the relationship between looking patterns and intellectual and symptom severity, and the study collects no data with which to examine it. What it substitutes is demographic stratification - age and sex - which are sources of variation in autism but are not the clinically meaningful ones the abstract invokes. The result is a study framed around parsing heterogeneity that measures none of the clinical variables by which heterogeneity is defined, and which therefore cannot distinguish a scan-path difference that indexes symptom severity from one that indexes being a twelve-year-old rather than a three-year-old." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-109" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:study_design "Cross-sectional classification study with an explicit stratification agenda: rather than only separating autism from typical development, the paper systematically tests whether sca…" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: ; comparison: 32" ] ] ;
    slr:content_sha256 "13681a18ff227c55c3d2903bb2716e56154746d00b9865f3880e76c93bb8c3ac" ;
