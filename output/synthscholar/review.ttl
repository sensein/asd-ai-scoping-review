            slr:overall_judgment "some" ;
            slr:tool_used "QUADAS-2" ] .

<https://doi.org/10.3389/fpsyt.2026.1751654> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Introduction: Early Autism spectrum disorder (ASD) diagnosis is critical for intervention, yet current methods rely on subjective clinical observations. This study develops objective tools to classify ASD severity using 3D motor movement analysis, addressing motor abnormalities as core diagnostic features. Methods: A Random Forest (RF) model classiﬁed three severity levels using 463 motor features from 25 Kinect V2 joint points. Data from 109 children (50 typical, 50 moderate ASD, 9 severe ASD) were validated via 5-fold cross-validation and two held-out test sets (20% each). Shapley Additive Explanations (SHAP) analysis identiﬁed critical motor biomarkers. Results: The model achieved 84.6±10.9% accuracy (5-fold cross-validation) and 86.4% accuracy (internal and held-out test sets). For severe ASD, the model achieved 100% classiﬁcation accuracy on synthetic test data (4/4 cases; 95% CI: 39.8%-100.0%). However, this result represents a methodological proof-of- concept rather than clinical validation, as severe ASD features were synthetically generated from moderate ASD data and the model has not been validated on real Kinect-derived severe ASD motor data. SHAP analysis identiﬁed wrist movements, knee trajectories, and elbow-to-foot distances as key motor biomarkers for severity classiﬁcation. Discussion: This Kinect-based approach with RF and SHAP offers effective, interpretable ASD severity assessment for typical and moderate ASD classes, with promising methodological foundations for severe ASD pending validation on real data." ;
    dcterms:bibliographicCitation "Fırat Y (2026). SHAP-based explainable AI framework for autism severity classification using 3D motor biomarkers. *Frontiers in Psychiatry, 17, Article 1751654*. https://doi.org/10.3389/fpsyt.2026.1751654" ;
    dcterms:creator "Fırat Y" ;
    dcterms:title "SHAP-based explainable AI framework for autism severity classification using 3D motor biomarkers" ;
    bibo:doi "10.3389/fpsyt.2026.1751654" ;
    bibo:pmid "local_231757c7" ;
    fabio:hasPublicationYear 2026 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Data source and eligibility described" ;
                            slr:justification "Both repository locations given with documentation noted, the original collection cited, and the reason for the missing severe-ASD Kinect data explained." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Participants appropriate to the question" ;
                            slr:justification "The severe-ASD group, central to a severity-classification study, has no Kinect measurements; no demographic information is reported for any of the 109 children." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Sample size justified" ;
                            slr:justification "No justification; 9 severe-ASD children yield 4 synthetic test cases, and the author states a minimum future target of 20-50 real cases." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Predictors defined and measured appropriately" ;
                            slr:justification "Severe-class predictors were synthesised from moderate-class vectors with added Gaussian noise and are not measurements of anyone." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Augmentation restraint" ;
                            slr:justification "Seven geometric augmentations available in the source repository were deliberately not used; only original recordings were analysed." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Predictors independent of the outcome" ;
                            slr:justification "For the severe class the predictors were generated from the class they are used to distinguish, making the separation definitional." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Outcome definition and ascertainment" ;
                            slr:justification "Severity grouping inherited from the source collection with no named instrument, and the severe stratum lacking corresponding measurements." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Outcome limitations acknowledged" ;
                            slr:justification "The author states in the abstract that the severe-class result is a proof-of-concept rather than clinical validation and explains exactly why." ;
                            slr:rating "Low" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Limitations and overinterpretation" ;
                            slr:justification "The most thorough self-critique in the charted corpus: the headline 100% is dismantled in the abstract, the wide interval is reported, the effect of one misclassification is computed, and a minimum sample for real validation is specified." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Performance measures adequate" ;
                            slr:justification "Fold standard deviation and an exact 95% confidence interval on the 4-of-4 severe result are reported and interpreted; the three-class majority baseline of about 45.9% is never stated and per-class sensitivity and specificity are not given for the real classes." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Analysis unit matches the clinical claim" ;
                            slr:justification "One vector per child; folds and held-out sets partition children." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Validation design guards against optimism" ;
                            slr:justification "Child-level cross-validation plus two held-out sets, with the explicit statement that both are reserved subsets from the same distribution rather than independent external validation - but 463 features for roughly 87 training cases." ;
                            slr:rating "Unclear" ] ;
                    slr:overall_concern "unclear" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The stated goal is objective classification of three ASD severity levels from 3D motor features, identification of the contributing motor biomarkers through SHAP, and evaluation across multiple validation strategies. Headline findings: 84.6 +/- 10.9% accuracy under 5-fold cross-validation and 86.4% on the held-out sets; 100% on the severe class (4 of 4) with a 95% confidence interval of 39.8% to 100.0%; and wrist movements, knee trajectories and elbow-to-foot distances as the leading biomarkers. The abstract itself states that the severe-class result is a methodological proof-of-concept rather than clinical validation because the severe features were synthetically generated." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-168" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "One 463-dimensional feature vector per child, pre-calculated by the dataset creators, z-score normalised, with timestamps omitted. Two aspects deserve note. The dimensionality is high relative to the sample - 463 features for 109 children, of whom roughly 87 are available for training - so the model operates in a regime where a random forest's variable selection is doing most of the work. And the repository's seven geometric augmentations (rotation, mirroring, scaling) were available and deliberately not used, a restraint that several studies in this corpus do not exercise." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-168" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "SHAP applied per class with importance, summary and waterfall plots, yielding anatomically interpretable biomarkers (wrist, knee, elbow-to-foot) that the author relates to established motor findings in autism. The interpretation is properly bounded for the two real classes - the author states that for typical and moderate ASD the approach relies on biomarkers that are anatomically interpretable and reflect systematic motor patterns consistent with the literature - and implicitly withheld for the severe class, whose SHAP profile describes a distribution the author constructed. The reported axis gradient across severity is the clearest illustration: its severe endpoint (X-axis features 100%) is a property of the synthesis procedure rather than of any child." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-168" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No modality fusion - 3D skeletal motion alone. The study's most interesting observation is instead about modality availability: the severe-ASD group could not be captured with the same sensor as the other two, so the modality itself is unavailable for the group whose severity the study most wants to classify. That is a genuine finding about the deployability of depth-sensor assessment and it applies well beyond this paper." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-168" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Collect real Kinect-derived severe-ASD data with a stated minimum sample of 20 to 50; test generalisation across age groups, genders and cultural backgrounds on larger datasets from multiple institutions; and run longitudinal studies of how motor biomarkers track severity change, framed as a way to evaluate intervention effectiveness. Each addresses a specific stated limitation." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-168" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Gait and full-body movement recorded with 25 Kinect V2 joint points at X, Y and Z coordinates, from which the dataset creators pre-calculated 463 features: inter-joint Euclidean distances, range-of-motion metrics, gait parameters (speed, step length, cycle time) and temporal characteristics. The severe-ASD group was recorded on a Samsung Note 9 in clinical settings, and the paper explains why extracting the same 463 features from that video was technically impossible - missing 3D coordinates, depth information and time-series data." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-168" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Motor function measured directly in three dimensions: inter-joint distances, range of motion, gait speed, step length and cycle time, and temporal characteristics, over 25 skeletal joints. The behavioural claims arising from SHAP are anatomically specific - wrist movements, knee trajectories and elbow-to-foot distances - and are related to motor impairments reported in the prior ASD literature rather than presented as novel discoveries. A structural pattern is also reported: Y-axis features decline (30% to 10% to 0%) and X-axis features increase (70% to 90% to 100%) with increasing severity, though the severe end of that gradient is synthetic." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-168" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Random forest, chosen for performance, flexibility and compatibility with SHAP-based interpretation. No architecture competition, no metaheuristic and no deep learning - the modelling is subordinated to the interpretability aim." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-168" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "autism spectrum disorder; motor biomarkers; random forest; SHAP analysis; violence level classification. The last term belongs to a different paper and survives in the published keyword list." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-168" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The severity grouping is the outcome rather than a covariate, and no validated severity instrument is named. Given that the study's subject is severity classification, the absence of a stated instrument behind the labels is its largest unaddressed gap - the synthetic-data problem is discussed at length, the label-provenance problem is not." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-168" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Inherited from the original collection and not independently established. The three-level grouping (typical, moderate, severe) is used as the classification target and the instrument behind the moderate/severe distinction is not named in the extracted text. What the paper does establish clearly is the provenance chain: ethics approval was obtained by the original collectors from their institutional review board before collection, guardian consent was given, and this study is a secondary analysis of de-identified public data." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-168" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Microsoft Kinect V2 capturing 25 joints in three dimensions in real time for the typical and moderate groups; a Samsung Note 9 phone camera for the nine severe-ASD children. The analysis software, versions and seed are not reported." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-168" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The evaluation is competently constructed at the child level - 5-fold cross-validation with a fold standard deviation reported, plus two 20% held-out sets one of which is reserved solely for final validation, and an explicit statement that neither constitutes independent external validation because both are reserved subsets from the same data distribution with the same sensor, protocol and feature pipeline. Against most of this corpus that is exemplary. The decisive issue is the severe class, and the paper states it before any reader could raise it: because no Kinect recordings exist for the nine severe-ASD children, the severe class's feature vectors were created by averaging moderate ASD vectors and adding Gaussian noise. A classifier separating that construction from real moderate data is separating a smoothed, noise-perturbed version of one distribution from the distribution itself, which is a task with a known answer and no clinical content - and the author says so, writing that the 100% result reflects the ability to distinguish real moderate ASD motor data from an artificially constructed distribution, not true clinical severity levels. The 4-of-4 result carries a 95% confidence interval from 39.8% to 100.0%, which the author computes, reports and interprets. Two further qualifications apply to the real two-class portion: 463 features for 109 children is a high-dimensional regime with roughly 87 training cases, and the three-class majority baseline of about 45.9% is never stated against which 84.6% should be read. The study is nonetheless the corpus's clearest demonstration that a near-perfect number can be reported and simultaneously explained away by the person reporting it." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-168" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Accuracy with a fold-wise standard deviation (84.6 +/- 10.9%), held-out accuracy (86.4%), per-class results and, for the severe class, an exact binomial confidence interval (39.8%-100.0%) on a 4-of-4 result. Computing and reporting that interval is the single most useful reporting decision in this part of the corpus: it converts an apparently perfect result into a statement that the true accuracy could be anywhere above 40%, and the author draws exactly that inference. The fold standard deviation of 10.9 points is likewise reported rather than smoothed. What is missing: the three-class majority baseline (approximately 45.9%) is never stated, and no per-class sensitivity or specificity is given for the two real classes." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-168" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2026, published 23 March. The framing is the most restrained in the charted corpus relative to the numbers reported. The abstract states 100% accuracy for the severe class and, in the same sentence, that this represents a methodological proof-of-concept rather than clinical validation because the features were synthetically generated; the discussion adds that a single misclassification would reduce recall to 75%; the conclusion describes the work as proof-of-concept demonstrating methodological feasibility pending validation on independent datasets; and future work is specified with a minimum sample target. Its contribution to this review is therefore not its accuracy but its demonstration that an author can report a perfect score and simultaneously explain, in the abstract, why it means nothing - the exact move that the corpus's fifteen facial-image studies and seven checklist studies do not make." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-168" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "High for a secondary analysis. Both repository URLs are given with the note that they contain the same data with full documentation and metadata; the six preprocessing stages are enumerated with exact dataframe dimensions (109 x 466) and class encodings; the decision to use only original rather than the repository's seven geometric augmentations is stated explicitly; the synthetic-generation rule is described precisely enough to reproduce; and both a fold standard deviation and a 95% confidence interval are reported. Missing: model hyperparameters, software and versions, seed and code." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-168" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Not reported in the extracted text - no age, sex, ethnicity or socioeconomic information for any of the 109 children. The author names this as a gap prospectively rather than leaving it implicit, listing age groups, genders and cultural backgrounds among the dimensions on which generalisation must be tested in future work." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-168" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The most thorough and self-critical limitations discussion in the charted corpus, and the only one in which the paper's own headline result is dismantled by its author. The severe-class analysis is described as the most critical limitation of the study; the reason no real data exist is explained; the synthetic-generation method is named; and the consequence is stated in full - that the reported 100% reflects the model's ability to distinguish between real moderate ASD motor data and an artificially constructed distribution, not between true clinical severity levels. The author further notes that the extremely wide confidence interval indicates high statistical uncertainty and that a single misclassification would reduce recall to 75%, sets a minimum target of 20 to 50 real severe-ASD cases for future work, and states that the two test sets are reserved subsets from the same data distribution rather than independent external validation. The one limitation not raised is the provenance of the severity labels themselves." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-168" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "One hundred and nine children from a public Kinect V2 dataset: 50 typically developing, 50 moderate ASD and 9 severe ASD. The composition is uneven in a way that determines everything else about the study - the nine severe-ASD children have no Kinect recordings at all, only 2D phone video, because the original collectors could not set up Kinect V2 in controlled laboratory settings for children with severe autism. The severe class in the analysis therefore contains no real motor measurements from any child; its feature vectors were synthesised by averaging moderate ASD vectors and adding Gaussian noise. The analysis unit is the child, one 463-dimensional vector each, and the paper reports this structure openly rather than presenting three comparable groups." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-168" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The original recordings were made in a controlled laboratory environment for the typical and moderate groups and in clinical settings for the severe group. The reason for that difference is reported and is substantive: Kinect V2 could not be deployed in controlled conditions for children with severe autism, so only phone video was obtained. That is a real, generalisable observation about who this class of technology can and cannot measure, and it is stated plainly rather than worked around silently." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-168" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional secondary analysis. Ethics is documented at both levels - institutional review board approval obtained by the original collectors before data collection, guardian written informed consent, and a secondary analysis of publicly available de-identified data in accordance with local legislation and institutional requirements. Both repository locations are given. This is complete provenance reporting for a secondary analysis and is among the best in the corpus." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-168" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "ASD, autism spectrum disorder, children with ASD, typical development, moderate ASD, severe ASD. The register is clinical and neutral; motor differences are described as impairments in line with the cited literature, and severity terms are applied to groups rather than to children as labels. One artefact intrudes: the keyword list ends with violence level classification, evidently carried over from an unrelated manuscript." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-168" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Frontiers in Psychiatry 17:1751654, 107 days with a revision round. A psychiatry venue, and the fit shows in the reporting - confidence intervals on a small-sample result, an explicit statement that held-out sets are not external validation, full provenance for a secondary analysis, and a limitations discussion that identifies the study's own most striking result as uninterpretable. The revision round appears to have strengthened rather than softened these statements, since the synthetic-data caveat appears in the abstract itself." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-168" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "A literature table of prior motor-based ASD studies (IMU, VR, Kinect, motion tracking, gait) with sample sizes and accuracies from 70% to 95.4%, against which the present study is listed at 86.4% on 1" ;
                    slr:study_design "Retrospective secondary analysis of a public 3D motion-capture dataset; three-class severity classification with a random forest, evaluated by 5-fold cross-validation plus internal…" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: 50 moderate ASD with real Kinect recordings, plus 9 severe ASD for whom only 2D video (Samsung Note 9) exists and no Kinect data were collected.; comparison: 50 typically developing children with real Kinect recordings." ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "84.6 +/- 10.9% accuracy under 5-fold cross-validation and 86.4% on the internal and held-out test sets. For the severe ASD class, 100% classification accuracy on synthetic test data (4/4 cases, 95% CI 39.8%-100.0%). SHAP identified wrist movements, knee trajectories and elbow-to-foot distances as the leading motor biomarkers, with a reported gradient in axis composition across severity (Y-axis fea" ;
                    slr:outcome "Accuracy with standard deviation across folds (84.6 +/- 10.9%), held-out accuracy (86.4%), per-class results, a 95% confidence interval for the severe-class result, and SHAP feature importance, summary and waterfall plots per class." ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "84.6 +/- 10.9% accuracy under 5-fold cross-validation and 86.4% on the internal and held-out test sets. For the severe ASD class, 100% classification accuracy on synthetic test data (4/4 cases, 95% CI 39.8%-100.0%). SHAP identified wrist movements, knee trajectories and elbow-to-foot distances as the leading motor biomarkers, with a reported gradient in axis composition across severity (Y-axis fea" ] ] ;
