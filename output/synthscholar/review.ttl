    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Six hundred and forty game sessions from 12 children are partitioned by session, with no participant grouping described in either the 20/80 split or the 5-fold cross-validation, so roughly 53 sessions per child are distributed across training and test." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "A purpose-built executive-function game battery with session-level telemetry, full grid search published for all seven models, and code and data deposited. No label-informed feature selection is described." ],
