        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "to mitigate the possible bias introduced by parents being lenient with their own children, we should reproduce this study in a clinical setting in which the person displaying the prompts to the child is neither a parent nor informed of the child's diagnosis." ] ;
            oa:hasTarget <urn:slr:article:902ddbc85707> ;
