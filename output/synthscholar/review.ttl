                    slr:judgment "unclear" ;
                    slr:supporting_quote "All 80 children are accounted for, but the number of EEG epochs surviving artifact rejection is not reported by group, and the authors note that recording conditions varied across days without stating whether sessions were interleaved between groups." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Groups recruited from special education schools versus regular kindergartens with no cognitive, language or developmental measure taken, so educational placement and developmental level are confounded with diagnosis; sex is exactly matched and age is stated to be matched but without a reported test statistic." ],
