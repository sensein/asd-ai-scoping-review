    slr:journal "JA" ;
    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Case-control sampling with autistic children drawn exclusively from a national referral centre for high-risk children and comparison children from day care centres, and the paper states explicitly that conservative criteria were applied on both sides 'to select individuals belonging to clinically distinct groups to ensure development of an accurate and precise ASD vs TD classification model'. Best-estimate IQ differs by 44-50 points at p < .001, the autism sample is 62% preverbal or single-word, and there is no clinical comparison group. Age (p = .99) and sex (p > .99) are matched essentially perfectly and enrolment is prospective and consecutive within an eleven-month window, which prevents a worse rating on process - but the spectrum is deliberately truncated at both ends." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "Prospective enrolment with dates given, 110 screened and 95 (86.4%) analysed with the flow diagram supplied in supplementary material, and reference standard and index test performed within the same study episode. Cross-validation is group-wise by individual, stated explicitly, so each child's up-to-fifteen clips remain within a single fold. Compliance across repeated trials was monitored and analysed rather than assumed. The unreported item is the class distribution across the three severity bands." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "The index test is prespecified: three task-specific models with input dimensions fixed by task duration, a fixed classification threshold of 0.5 rather than a tuned one, no feature selection, and no post-hoc model or feature search reported. Interpretation is fully automated and blind to the reference standard. The interpretability analysis provides evidence that the models respond to the intended behavioural constructs rather than to arbitrary correlates." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "A staged pathway with universal K-CARS-2 screening, referral of screen-positive or concern-flagged children to a child psychiatrist, and K-ADOS-2 administration with calibrated severity scores reported for the autism group; comparison status requires a below-cutoff K-CARS-2 plus no parent-reported developmental or psychiatric history. Cognitive functioning was assessed in every participant with an age-appropriate standardised battery. The one qualification, insufficient to raise the rating for the detection analysis, is that the severity prediction target derives from the caregiver-completed K-CARS-2 rather than from the clinician-administered K-ADOS-2 the study already holds." ] ;
            slr:overall_judgment "unclear" ;
            slr:tool_used "QUADAS-2" ] .

<urn:slr:article:71fd566a4ffb> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Early detection of autism spectrum disorder (ASD) is crucial for timely intervention, yet diagnosis typically occurs after age three. This study aimed to develop a machine learning model to predict ASD diagnosis using infants’ electronic health records obtained through a national screening program and evaluate its accuracy. A retrospective cohort study analyzed health records of 780,610 children, including 1163 with ASD diagnoses. Data encompassed birth parameters, growth metrics, developmental milestones, and familial and post-natal variables from routine wellness visits within the first two years. Using a gradient boosting model with 3-fold cross-validation, 100 parameters predicted ASD diagnosis with an average area under the ROC curve of 0.86 (SD < 0.002). Feature importance was quantified using the Shapley Additive explanation tool. The model identified a highrisk group with a 4.3-fold higher ASD incidence (0.006) compared to the cohort (0.001). Key predictors included failing six milestones in language, social, and fine motor domains during the second year, male gender, parental developmental concerns, non-nursing, older maternal age, lower gestational age, and atypical growth percentiles. Machine learning algorithms capitalizing on preventative care electronic health records can facilitate ASD screening considering complex relations between familial and birth factors, post-natal growth, developmental parameters, and parent concern." ;
    dcterms:bibliographicCitation "Ben-Sasson A; Guedalia J; Nativ L; Ilan K; Shaham M; Gabis LV (2024). A Prediction Model of Autism Spectrum Diagnosis from Well-Baby Electronic Data Using Machine Learning. *Children, 11(4), 429*." ;
    dcterms:creator "Ben-Sasson A",
        "Gabis LV",
        "Guedalia J",
        "Ilan K",
        "Nativ L",
        "Shaham M" ;
    dcterms:title "A Prediction Model of Autism Spectrum Diagnosis from Well-Baby Electronic Data Using Machine Learning" ;
    bibo:pmid "local_15ed96cb" ;
    fabio:hasPublicationYear 2024 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Participant selection and spectrum representativeness" ;
                            slr:justification "A whole national birth cohort with no recruitment or selection by the researchers, covering 75% of the population through a universal free surveillance programme. Autism-associated aetiologies such as Fragile X and tuberous sclerosis were deliberately retained rather than excluded, on stated reasoning. The spectrum represented is whatever the population contains." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Comparison group adequacy" ;
                            slr:justification "The comparison group is every other child in the cohort - 774,778 children - with exclusions limited to autism and other pervasive developmental or medical conditions plus Down syndrome. This is a population comparison rather than a recruited control group, the only one in the review." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Handling of missing data and attrition" ;
                            slr:justification "The central data problem - variable checkup timing and multiple entries per milestone - is addressed by an explicitly reasoned binarisation rule adopted to avoid embedding developmental assumptions about never-tested and late-tested records, with the cost of that choice stated in the same passage. Variable follow-up by birth year is addressed by a sensitivity model excluding 2019 births." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Confounder control" ;
                            slr:justification "Because the design is a population cohort, group differences are findings rather than sampling artefacts. Sex is handled correctly through a boys-only sensitivity model, given that it is both a strong predictor and a strong group difference. Maternal country of birth is reported as associated with diagnosis rate without discussion of whether it entered the model or of the equity implications of a risk score encoding migration background." ;
                            slr:rating "Unclear" ] ;
                    slr:overall_concern "low" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Outcome measurement blinding" ;
                            slr:justification "Diagnoses were recorded in routine care years before and independently of the study; model outputs played no part in clinical decisions." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Measurement standardisation" ;
                            slr:justification "The surveillance protocol is nationally standardised with defined milestones at defined age bins, delivered by trained nurses under Ministry guidelines - considerable standardisation for routine data. But measurement is human observation recorded administratively across 503 clinics with no inter-rater reliability data, and the authors note that variation in provider recording practice warrants investigation." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Reference standard quality" ;
                            slr:justification "Routine clinical diagnosis with no research instrument, 43.4% ascertained from provider free-text notes, and an acknowledged tenfold undercount - the authors state that the true autism group is at least ten times larger than the labelled one, so most autistic children are in the comparison group." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Index test definition and prespecification" ;
                            slr:justification "Features reduced a priori on clinical grounds, milestone binarisation rule stated with rationale, Youden threshold as an objective cutoff, no hyperparameter search reported, four methods compared rather than the best selected." ;
                            slr:rating "Low" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Sample size adequacy for the modelling" ;
                            slr:justification "775,941 children with 1,163 cases and 59 features. Fold-to-fold variation in AUC is 0.009, and the SHAP top-20 overlaps across folds for 15 of 24 unique features - stability that follows directly from the sample size." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Preprocessing and feature selection nesting" ;
                            slr:justification "The reduction from 100 to 59 features was made before modelling on clinical-relevance grounds and independently of performance, so selection bias does not arise. Milestone binarisation is a fixed rule applied uniformly." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Data splitting and leakage control" ;
                            slr:justification "Cross-validation partitions children in a population cohort, so no within-participant leakage is possible; and temporal leakage from diagnosis to predictors is prevented by capping predictors at 24 months and restricting outcomes to diagnoses after 24 months, a control adopted explicitly for that purpose." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Performance estimation and chance level" ;
                            slr:justification "Accuracy is correctly not reported at 0.15% incidence. AUC with fold standard deviation, sensitivity, specificity, full confusion counts for four methods, training alongside test AUC with overfitting acknowledged, enrichment relative to cohort base rate, and multi-threshold performance in supplementary material. The one gap is that positive predictive value is left uncomputed although derivable at 0.60%." ;
                            slr:rating "Low" ] ;
                    slr:overall_concern "low" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Data, code and protocol availability" ;
                            slr:justification "Data cannot be released publicly for privacy and ethical reasons, but a formal request route through the Ministry platform is given with a URL. Extensive supplementary material substitutes in part. No code and no preregistration." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Acknowledgement of limitations" ;
                            slr:justification "The most substantive limitations section in the review, quantifying its own outcome undercount at a factor of ten, stating the cost of its representational choices alongside their rationale, naming specific missing predictors and missing milestones, and flagging provider recording variation for further research. The unacknowledged item is the positive predictive value, which the paper's own numbers make computable at 0.60%." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Completeness of methods reporting" ;
                            slr:justification "Cohort definition, two-route case ascertainment with counts and verification steps, exclusion logic with reasoning, surveillance protocol with milestone counts by domain and age bin, binarisation rule with rationale and cost, feature reduction basis, modelling method, cross-validation, threshold definition, four-method comparison with confusion counts, and SHAP fold stability. Five supplementary items carry the full feature list, per-fold training performance, multi-threshold results and two sensitivity models. Software and versions are the one omission." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Reporting of results and uncertainty" ;
                            slr:justification "Fold standard deviations on every headline metric, training and test performance side by side with overfitting stated, confusion counts for all comparators, confidence interval on the external validity odds ratio, and a p-value threshold adjusted for sample size with effect sizes throughout the group comparisons. PPV is the sole quantity left uncomputed." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Ethics, consent and conflicts" ;
                            slr:justification "Ministry of Health Helsinki committee approval with number and date, Declaration of Helsinki conformity, consent waived on anonymisation grounds by the committee, extraction and anonymisation by dedicated Ministry personnel, access only through a secure platform, funding stated with grant number, and no competing interests declared." ;
                            slr:rating "Low" ] ;
                    slr:overall_concern "low" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Gradient boosted decision trees as the primary model, with the mechanism explained in the text - successive trees fitted to the errors of their predecessors, combined stage-wise rather than in parallel - and three comparators: logistic regression, random forest and naive Bayes. Risk stratification used the Youden threshold, defined as the cutoff optimising the balance of sensitivity and specificity. The modelling is deliberately conventional and the paper makes no architectural claim; the contribution is the data and the design. The comparison across methods is the most useful modelling result in the study and cuts against the assumption running through this corpus: logistic regression matched gradient boosting exactly at AUC 0.86 while achieving marginally higher sensitivity (0.77 versus 0.75), with random forest at 0.84 and naive Bayes at 0.83, so the entire spread across four methods is 0.03 AUC. On a genuine population dataset with 59 clinically chosen features, the choice of algorithm is close to irrelevant - which suggests that the very large algorithm-driven performance differences reported elsewhere in this review are more likely properties of small samples and leaky validation than of modelling power." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-111" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Children 11(4), article 429, MDPI, open access under CC BY; received 12 March 2024, revised 28 March, accepted 29 March, published 3 April 2024. The venue is a paediatrics journal rather than a computational one, and the reporting reflects that: the cohort definition, case ascertainment, exclusion logic and group comparisons are described to epidemiological standards with effect sizes and a p-value threshold adjusted for sample size, while the modelling is reported adequately but without software versions or hyperparameters. Five supplementary tables and figures carry the full feature list, per-fold training performance, multi-threshold performance and two sensitivity models. The three-week review period is short, though the study's design and reporting do not show the marks of it." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-111" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A tabular feature vector per child, built from 100 candidate variables reduced to 59 on clinical-relevance grounds before any modelling - a reduction made a priori rather than by data-driven selection, which the paper states explicitly and which removes a source of optimism that data-driven feature selection would introduce. The central representational decision concerns milestones, and it is reasoned carefully. Records vary in the timing of checkups and contain multiple entries per milestone per child, so each milestone was reduced to a binary of 'ever passed' versus 'only failed', chosen specifically 'to avoid attributing a-priori developmental assumptions' to never-tested and late-tested records. The cost is stated in the same paragraph: children who passed after several attempts cannot be distinguished from those who passed immediately, so the pattern of delay - arguably the most diagnostically informative aspect of milestone data - is discarded. Stating a representational trade-off, its motivation and its cost in three sentences is better practice than anything comparable in this corpus. Longitudinal structure within a child is otherwise collapsed, and modelling performance patterns over time is named as the first priority for future work." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-111" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The aim is to build and evaluate a machine learning model predicting later autism diagnosis from routinely collected well-baby records, so that providers can be alerted during ordinary checkups to administer an autism-specific screening tool - the Israeli protocol containing none. Findings: average test AUC 0.86 (SD 0.009) with sensitivity 0.75 and specificity 0.81, against a training AUC of 0.88 that the authors flag as indicating slight overfitting. At the Youden threshold, 18.6% of the cohort (144,632 children) were classified high risk, capturing 874 of 1,163 cases - an autism incidence of 0.006 in that group against 0.001 in the cohort, a 4.3-fold enrichment. The seven most important milestone predictors, all confirmed by independent Fisher's exact tests at p < 0.001, are strikingly ordinary clinical observations: vocabulary over ten words, building a tower from cubes, giving a kiss, eating independently with a spoon, knowing at least one body part, composing two-word sentences and saying 2-3 words. Four are language milestones, two personal-social, one fine motor, and all fall between 12 and 24 months. Other key predictors are male sex, parental developmental concern, non-nursing, older maternal age, lower gestational age and atypical growth percentiles. The most instructive result is the method comparison: logistic regression achieved exactly the same AUC of 0.86 with marginally better sensitivity (0.77 versus 0.75), random forest 0.84 and naive Bayes 0.83 - so gradient boosting gained nothing over a linear model on 59 features, which bears directly on the assumption running through this corpus that model sophistication is where performance comes from." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-111" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No autism severity measure exists in the records, and no cognitive, language or adaptive standardised score is available - the well-baby protocol records milestone attainment as pass or fail rather than scaled scores. What the study does have, and uses well, is a proxy for general developmental concern that sits outside the model: referral for extensive developmental assessment due to developmental delay. Because this variable was deliberately excluded from the feature set, it functions as an independent check, and children flagged high risk proved 3.29 times more likely to have been referred (95% CI 3.18-3.39). That is a genuinely informative use of an available clinical variable and it partially answers the question of what the false positives are: many are children whom clinicians independently identified as developmentally concerning. The absence of severity data nonetheless means nothing can be said about which autistic children the model detects - whether the 75% captured differ in presentation from the 25% missed, and whether the model is better at flagging children with co-occurring language or motor delay than those with a more isolated social presentation. Given that four of the seven top milestone predictors are language milestones, the second possibility is live and untested." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-111" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "There is no experimental paradigm; the behavioural data are generated by routine clinical practice. The surveillance protocol nonetheless functions as a structured behavioural assessment: 60 age-related milestones across gross motor, fine motor, language and personal-social domains, based in part on the Denver Developmental Screening Test, with 38 assessed up to 24 months and between four and nine checked at each of nine age bins from six weeks to six years, results recorded per milestone, plus systematic elicitation of parental concerns about development and hearing at each visit. Two features distinguish this from the elicitation paradigms elsewhere in the review. It is universal and repeated - every child in the population is assessed roughly eleven times by a trained nurse over six years, at zero marginal cost to the research - which is a scale of behavioural observation no research protocol can approach. And it is unoptimised for the task: the milestones were chosen for general developmental surveillance, not for autism detection, so the model works with whatever the protocol happens to record. The authors identify this as a limitation and name specific candidate red flags that fall outside it - head lag at three months, raising hands to be picked up at six months, nodding at twelve months - which is a concrete and testable proposal for improving the instrument rather than the algorithm." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-111" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Routine clinical diagnosis recorded in the health record after age two, ascertained by ICD-9 code for 56.6% of cases and by verified keyword search of provider free-text notes for the remaining 43.4%. There is no research instrument - no ADOS, ADI-R or equivalent - and the well-baby protocol contains no autism-specific screening tool, which the paper states explicitly and which is part of its motivation. Three features of the ascertainment are handled better than the norm in this corpus. The temporal separation is enforced by design: predictors are capped at 24 months and outcomes restricted to diagnoses recorded after 24 months, adopted specifically 'to develop a model that minimizes data leakage from diagnosis to predictors' - a form of leakage control that most studies here do not have to think about and that this one does. Acronym collisions were checked and excluded, and free-text mentions were manually verified to concern the child rather than a relative. And the resulting label noise is quantified rather than glossed: the authors state that 'based on the national incidence of ASD, the true positive ASD group is at least 10 times higher in the examined population', so most autistic children in the cohort sit in the comparison group. That is an unusually candid acknowledgement, and it has an implication the paper does not draw out - that a large share of the flagged false positives may be correctly identified children whose diagnosis was simply never recorded, so both specificity and positive predictive value are understated. The 43.4% of diagnoses ascertained from free text also introduces provider-dependent recording variation, which the authors flag as warranting research into inter-rater differences." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-111" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Among the best-reported studies in the review, constrained only by data-access restrictions. Fully specified: the cohort definition with birth-year window and minimum follow-up requirement; the two-stage case-ascertainment procedure with counts by route and the acronym-collision and family-member checks; the comparison-group definition with its exclusion logic and the explicit reasoning for excluding Down syndrome but retaining other autism-associated aetiologies; the surveillance protocol with milestone counts by domain and age bin and its Denver Developmental Screening Test basis; the milestone binarisation rule with its stated rationale and its stated cost; the reduction from 100 to 59 features on clinical-relevance grounds; the modelling method, cross-validation scheme and Youden-threshold definition; full confusion counts for four comparator methods; and the SHAP fold-stability analysis. Five supplementary tables and figures carry the complete 100-feature list, training performance by fold, performance at multiple thresholds, and boys-only and no-2019 sensitivity models. The data cannot be released publicly for privacy reasons but a formal request route with a URL is provided. Code is not available and no software is named." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-111" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Keywords: autism spectrum disorders; development; screening; machine learning; electronic health records. The set is balanced between clinical and computational terms, and 'screening' rather than 'diagnosis' correctly names the intended application. Terms running through the text: well-baby checkups, developmental surveillance, milestones, red flags, risk stratification, Youden threshold, SHAP, feature importance, preventative care, developmental trajectories, cumulative risk." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-111" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The limitations section is the most substantive in the review and several of its admissions are ones other papers in this corpus would have suppressed. Milestone binarisation cannot distinguish children who passed after repeated attempts from those who passed first time, so a real signal about the pattern of delay is discarded. The feature set is bounded by what the national protocol happens to record, and specific plausible red flags outside it are named. Paternal age and family history of autism, both established risk factors, are not routinely collected, and the authors note that the observed advanced-maternal-age effect may be a proxy for paternal age - an interpretive caution rather than a claim. Most strikingly, they state that 'based on the national incidence of ASD, the true positive ASD group is at least 10 times higher in the examined population', meaning the great majority of autistic children in the cohort are labelled as comparison cases, and they describe this as adding 'a lot of noise to the outcome label' requiring replication with a later stable outcome. And 43.4% of diagnoses came from free-text notes rather than ICD-9 codes, with provider recording practice varying. What is not stated is the positive predictive value, although all the numbers to compute it are given: 874 autism cases among 144,632 flagged children is 0.60%, or 165 children flagged per recorded case. The paper acknowledges 'a cost of high false positive rates' and mounts a partial defence through the developmental-referral analysis, but never puts the figure on the page. It also does not draw out the interaction between its two candid admissions - if the true autism count is ten times higher, then many of those 143,758 apparent false positives are correctly flagged children whose diagnosis was never recorded, so the true PPV is materially better than 0.60% and the true specificity better than 0.81, by an amount the data cannot determine. Finally, maternal country of birth is reported as associated with diagnosis rate without discussion of whether it entered the model or of the equity implications." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-111" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None in the instrumental sense - the study uses no sensor, device or measurement apparatus of its own. Data were extracted and anonymised by the TIMNA project, the Israel Ministry of Health's Big Data Platform, and accessed by researchers through a dedicated secured Ministry platform, with a public URL given for the access route. Analysis used gradient boosting with logistic regression, random forest and naive Bayes comparators and SHAP for attribution; no software package or version is named, which is the one specification gap in an otherwise thoroughly reported methods section. The absence of equipment is the point: the entire input is data that a nurse enters during an ordinary visit, which is why this is the only study in the review whose measurement cost at deployment is zero." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-111" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The strongest validation design in the review, and strong in ways that are structural rather than procedural. Four features stand out. The split unit is the child and the cohort is a whole population, so there is no possibility of within-participant leakage and no case-control sampling to inflate separation. Temporal leakage is controlled by design rather than by hope: predictors are capped at 24 months and outcomes restricted to diagnoses recorded after 24 months, adopted explicitly to prevent information flowing from diagnosis back to predictors - the only study here that faces this problem and the only one that solves it. Feature reduction from 100 to 59 was made a priori on clinical-relevance grounds, so no selection bias enters. And training AUC is reported alongside test AUC with the overfitting acknowledged in the text, rather than concealed. Three-fold cross-validation is modest but adequate at this sample size, and results are stable across folds (SD 0.009). Two internal checks add further confidence: a boys-only model tests whether performance depends on sex, given that sex is both a strong predictor and a strong group difference; and referral for developmental assessment, deliberately excluded from the feature set, serves as an external validity indicator, with high-risk children 3.29 times more likely to have been referred (95% CI 3.18-3.39). The residual limitations are epidemiological rather than methodological: no external cohort or health system has been tested, and the outcome label is substantially incomplete, with the authors estimating the true autism count at ten times the labelled figure - which biases sensitivity and specificity in directions the data cannot resolve." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-111" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Five directions, all specific and all following from a stated limitation. Model each child's milestone performance pattern over time rather than collapsing to binary attainment, which would restore the delay-trajectory information the current representation discards. Add early signs not currently in the national protocol, with three concrete candidates named. Incorporate paternal age and family history of autism, both known risk factors absent from routine collection. Replicate with a later and more stable outcome label to reduce the label noise the authors quantify. And conduct direct cross-cultural validation before transferring the approach, covering not only sign expression but 'parental recognition, interpretation, and reporting levels' - an acknowledgement that a model built on parent-reported concern and clinician recording is embedded in a particular culture of help-seeking and documentation. The list is notable for containing no proposal to improve the algorithm." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-111" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A national population cohort rather than a recruited sample - 780,610 Israeli children born between 2014 and 2019 with at least two years of computerised well-baby records, of whom 775,941 entered the analysis: 1,163 with an autism diagnosis recorded after age two and 774,778 without autism or another pervasive developmental or medical condition. This is by four orders of magnitude the largest sample in the review and the only one drawn from an unselected population. Case ascertainment used two routes and both counts are given: 722 children (56.6%) identified by ICD-9 code and 553 (43.4%) by keyword search of provider free-text notes with manual verification that the reference concerned the child rather than a family member. A further 112 children with autism diagnosed before age two were excluded to preserve the temporal separation between predictors and outcome. Conditions sharing the ASD acronym, notably atrial septal defect, were screened out. Down syndrome was excluded from the comparison group but Fragile X, tuberous sclerosis and other autism-associated aetiologies were deliberately retained, on the reasoning that autism has multiple aetiologies and excluding them would narrow the target condition artificially. The resulting incidence of 0.0015 is roughly a tenth of Israel's reported national rate, and the authors state this openly as a limitation." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-111" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Genuine multi-source fusion, and the only study in the review to combine behavioural observation with biological, familial and perinatal data in one model. Five families are integrated: developmental milestone attainment across four domains; birth parameters including gestational age, birth weight and delivery mode; post-natal growth percentiles; familial variables including maternal age, country of birth and nursing status; and parent-reported developmental concern. The rationale for fusion is stated as a scientific argument rather than an accuracy claim: 'prematurity, like other factors, interacts with additional ASD risk factors, such as cesarean delivery, parental age, and birth complications; therefore, there is a need for an integrative/cumulative approach to risk estimation', and these non-linear interactions are what machine learning on large data is expected to capture. The SHAP analysis confirms that the final model draws on all five families, with seven of the top twenty features being milestones and the remainder spanning sex, parent concern, nursing, maternal age, gestational age and growth. The finding that undercuts the fusion rationale is the method comparison: logistic regression, which cannot represent the interactions the argument invokes, achieves an identical AUC of 0.86 with slightly better sensitivity. So the integration of heterogeneous data sources demonstrably helps, while the non-linear modelling that was supposed to exploit their interactions demonstrably does not." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-111" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "'Children with ASD' and 'typically developing (TD)' children, person-first and consistent. Autism 'manifests through social communication deficits and atypical behaviors' per DSM-5, and the vocabulary of red flags, risk, markers and screening runs throughout - appropriate to a public-health surveillance framing. The register is notably free of the burden and cost rhetoric found elsewhere in this corpus; the motivation offered is access and equity rather than economic saving. Two framing choices are worth recording. The paper repeatedly emphasises heterogeneity as the obstacle to early detection - 'the great heterogeneity in the red flags, onset, and progression of symptoms, and in the divergence of developmental trajectories in ASD' - and treats variation as something a model must accommodate rather than as noise. And it frames the problem partly as one of clinician support rather than clinician replacement, noting that some early signs 'can be easily missed by a healthcare provider during a short checkup visit due to their gradual deviation or subtlety, such as social reciprocity, social smile, and eye contact', and that 'disparities in healthcare screening resources and in provider awareness of individual developmental differences' are themselves barriers. There is no neurodiversity framing and no autistic-community involvement." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-111" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Published 2024 by the University of Haifa's occupational therapy department with Maccabi Healthcare Services, Tel-Aviv University and the Keshet Autism Center, funded by the Gertner Institute of Health Policy and Epidemiology. The framing is health-services and equity oriented rather than technological: autism diagnosis typically occurs after age three despite behavioural markers being observable in the first two years, the barriers are heterogeneity in presentation, subtlety of early signs during short visits, and 'disparities in healthcare screening resources and in provider awareness', and the proposed remedy is to exploit data a universal surveillance system already collects. The paper is unusual in this corpus for treating the health system as the unit of intervention - its contribution is an alerting layer for a national programme that currently contains no autism-specific screening instrument, not a new measurement device. For the review its importance is threefold. It is the only study reporting performance at a genuine population base rate, and its numbers make the prevalence problem concrete in a way no other study does: an AUC of 0.86 with 75% sensitivity yields a high-risk group of 144,632 children containing 874 recorded cases, a positive predictive value of 0.60%. It shows that on real population data with clinically chosen features, logistic regression matches gradient boosting exactly, which reframes the algorithmic arms race visible across the rest of this corpus. And its limitations section models the standard the field should meet, quantifying its own label noise at a factor of ten and stating the cost of its own representational choices in the same breath as their rationale." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-111" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "SHAP attribution applied within each of the three folds, with fold-to-fold stability quantified explicitly - 15 of 24 unique top-20 features appeared in all three folds, 6 in two and 3 in one. Reporting the stability of an importance ranking across resamples, rather than presenting a single ranking as though it were a property of the data, is a discipline almost absent from this corpus and it materially changes how much weight the ranking can bear. The seven milestone predictors surfaced by SHAP were then tested independently with Fisher's exact tests, all significant at p < 0.001, so the attribution is corroborated by conventional statistics rather than standing alone. The resulting features are directly interpretable and directly actionable by the clinician who would use the model: a nurse can check whether a two-year-old has more than ten words or builds a tower from cubes. Summary and distribution plots for a representative fold appear in the paper with the remaining folds in supplementary material. The one interpretive question left open is whether the model's reliance on language milestones means it preferentially detects autistic children with co-occurring language delay - a question the data could address and the paper does not." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-111" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The Israeli national well-baby surveillance programme, Tipat Halav, operating across 503 Ministry of Health clinics and covering 75% of the population, with the remaining quarter followed by two health maintenance organisations under identical national guidelines. Services span immunisation, growth monitoring, developmental surveillance and risk detection for mother and child, delivered by nurses with specific maternal and child health training alongside a developmental paediatrician, across approximately eleven visits from birth to age six. This is the only study in the review whose setting is the deployment setting: there is no recruitment, no research protocol, no laboratory and no case-control geometry, and the model is trained on exactly the data that would be available at the moment of use. The equity implication is drawn out explicitly - because the surveillance system is universal and free, a model built on it inherits multi-cultural representativeness that a recruited cohort could not, which the authors contrast with 'disparities in healthcare screening resources and in provider awareness' as barriers to detection. The counterweight is that the model's transferability depends on a health system that most countries do not have, and the authors say so, calling for cross-cultural validation covering 'the expression of signs, parental recognition, interpretation, and reporting levels'." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-111" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Extensive and, uniquely in this review, describing a whole population rather than a matched sample. Reported with formal comparisons at a p < 0.001 threshold chosen for the large sample size and multiple comparisons: sex (78.3% male in the autism group against 51.4%), birth year distribution, maternal country of birth (with higher diagnosis rates for mothers born in Russia and Ethiopia), preterm birth rate, maternal age, gestational week, birth weight, nursing status, parental concern rates, and number of well-baby visits (13.7 in the autism group against 11.44, t(775,939) = -23.05, p < 0.001, d = 0.7). Because the design is a population cohort rather than a case-control comparison, these differences are findings about the population rather than confounds introduced by sampling - which is the fundamental difference between this study and every other in the review. Two points nonetheless deserve attention. Sex is both a strong predictor and a strong group difference, and the authors handle it correctly by fitting a boys-only model and reporting that performance remained relatively stable, which is the check that distinguishes a model using sex as one legitimate risk factor from a model that is substantially a sex classifier. Maternal country of birth is reported as associated with diagnosis rate but its role in the model is not made explicit, and a risk score that encoded migration background would raise equity concerns the paper does not address. Absent throughout: IQ, language scores, adaptive functioning and any autism severity measure, none of which exists in the records." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-111" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Developmental milestone attainment across four domains, observed and recorded by trained nurses in routine practice, together with parent-reported concern. This is behavioural data of a different kind from the rest of the review - clinician-mediated, coarse, binary and administratively recorded rather than sensor-derived - and it is worth being explicit that the review includes it at the boundary of its modality scope. What the study demonstrates is how far that coarse behavioural signal goes. The seven most important milestone predictors are all things a nurse can observe in a two-minute interaction: whether a two-year-old has more than ten words, builds a tower from cubes, gives a kiss, eats independently with a spoon, knows a body part, composes two-word sentences, says 2-3 words. Four are language, two personal-social, one fine motor, all falling between 12 and 24 months, and all differ between groups at p < 0.001 on independent testing. The domain distribution is itself informative: language dominates, which is consistent with the wider literature on early markers but also raises the untested possibility that the model preferentially detects autistic children with co-occurring language delay. Parent-reported concern is a further behavioural channel and emerges as a key predictor, which is a finding about the informativeness of parental observation rather than about the child. Notably absent from the recorded protocol, and named by the authors as missed opportunities, are the subtler social behaviours that dominate the rest of this corpus - social reciprocity, social smile, eye contact - which the paper observes 'can be easily missed by a healthcare provider during a short checkup visit due to their gradual deviation or subtlety'." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-111" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Metric reporting is fitted to the epidemiological setting rather than borrowed from the classification literature, and this is one of the study's clearest strengths. Accuracy is not reported at all - correctly, since at 0.15% incidence a null model achieves 99.85%. What is reported instead: AUC with standard deviation across folds (0.86, SD 0.009), sensitivity (0.75, SD 0.03), specificity (0.81, SD 0.02), training AUC alongside test AUC with an explicit statement that the model is slightly overfit, full true positive, false positive, true negative and false negative counts for all four modelling methods, and the risk stratification expressed as enrichment - 0.006 incidence in the high-risk group against 0.001 in the cohort, a 4.3-fold increase. Supplementary material gives performance at multiple thresholds as multiples of the Youden threshold, with the trade-off against false positives described. The one omission is positive predictive value, which is not stated although the confusion counts make it computable: 874 of 144,632 flagged children, or 0.60%, meaning 165 flagged per recorded case. That figure is the single most important number in the review for understanding what a well-validated model at a realistic base rate delivers, and it is left for the reader to compute." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-111" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Genuinely longitudinal in structure and, by the standards of this review, exemplary in its handling of time. Predictors are drawn only from measurements taken up to 24 months and the outcome only from diagnoses recorded after 24 months, an ordering imposed deliberately 'to develop a model that minimizes data leakage from diagnosis to predictors'. Mean age at recorded diagnosis was 37.5 months (SD 13.3), so the model predicts on average more than a year ahead of the clinical event. Follow-up varies by birth cohort, and the authors address this both by noting the smaller autism proportion among 2019 births and by fitting a sensitivity model excluding that year. Within-child longitudinal structure is nonetheless collapsed - milestones are binarised to ever-passed versus only-failed - which the authors name as their first limitation and as a target for future work. Governance is complete: Ministry of Health Helsinki committee approval with number and date, consent waived on anonymisation grounds, extraction and anonymisation performed by dedicated Ministry personnel, access only through a secure platform, funding stated, and no competing interests declared." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-111" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:study_design "Retrospective cohort study using routinely collected national electronic health records, with prospective outcome ascertainment - predictors are restricted to measurements taken be…" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: ; comparison: 774,778 children without an autism or other pervasive developmental or medical condition diagnosis" ] ] ;
    slr:content_sha256 "7dcc114cdf4f706fc687d6f5c9082a4dbbdb56641a491aa1004eb5cc59b7851b" ;
