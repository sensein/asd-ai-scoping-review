    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Sample counts per group are given but the number of phonations per child, elicitation procedure, exclusions and data-quality handling are all unreported." ],
                [ a slr:RoBDomainJudgment ;
