                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Groups recruited from different institutional settings (a kindergarten versus an unnamed school site); no cognitive or developmental measure in a 3-6-year-old sample; and an eye-tracking inclusion gate of >70% screen-looking time with no exclusion count reported, which plausibly removes children differentially by group." ] ;
            slr:overall_judgment "some" ;
