                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Every reported accuracy rests on nine test cases, a fact stated nowhere and recoverable only from the confusion matrices and the quantisation of the tables. No split ratio, cross-validation or repetition is reported, and the headline result is attributed to different clients in the abstract, the contributions list and the results section." ] ;
            slr:overall_judgment "high" ;
            slr:tool_used "QUADAS-2" ] .

<https://doi.org/10.1007/s42452-026-08352-3> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Autism Spectrum Disorder (ASD) is a complex neurodevelopmental condition characterized by heterogeneous behavioural manifestations that vary across age groups and severity strata. While questionnaire-based screening instruments enable large-scale ASD identification, reliable severity stratification remains challenging due to the absence of explicit clinician-annotated severity labels and the reliance of many existing approaches on fragmented or multi-stage pipelines. To address this gap, this study proposes a unified BiLSTM–CGBO framework for screening-level ASD identification and ordinal severity stratification under a controlled behavioural labeling paradigm. The proposed architecture integrates a Bidirectional Long ShortTerm Memory (BiLSTM) network, employed as a high-capacity representation learner for modeling non-linear interactions among behavioural attributes, with a Chaotic Grey Ball Optimizer (CGBO) that adaptively modulates learning dynamics to enhance numerical stability and convergence. The framework is evaluated on harmonized ASD screening datasets from the Kaggle and UCI repositories, comprising 2154 participants across four developmental cohorts: toddlers, children, adolescents, and adults. Experimental results demonstrate consistently high classification accuracy and AUROC values across age groups, reflecting the model’s effectiveness in approximating a deterministic behavioural severity-scoring function rather than independent clinical diagnostic performance. Comparative analysis indicates that the proposed framework achieves stable improvements over classical machine learning and deep learning baselines, including SVM, CNN, and standard LSTM, under identical preprocessing and validation protocols. Model interpretability is examined using SHapley Additive Explanations (SHAP), which elucidate how behavioural attributes are utilized within the learned scoring structure without asserting causal or diagnostic attribution. Overall, the proposed BiLSTM–CGBO framework establishes a transparent, reproducible, and computationally efficient methodology for screening-level autism severity modeling, providing a robust foundation for future validation using independently clinician-annotated data and multimodal extensions. Article highlights • A single-stage AI model enables efficient autism severity screening across all agegroups. Page 2 of 31 Rathod et al. Discover Applied Sciences (2026) 8:363" ;
    dcterms:bibliographicCitation "Rathod VN; Goudar RH; Sangani S (2026). An explainable deep learning framework for screening level autism severity using behavioural data. *Discover Applied Sciences, 8(4), Article 363*. https://doi.org/10.1007/s42452-026-08352-3" ;
    dcterms:creator "Goudar RH",
        "Rathod VN",
        "Sangani S" ;
    dcterms:title "An explainable deep learning framework for screening level autism severity using behavioural data" ;
    bibo:doi "10.1007/s42452-026-08352-3" ;
    bibo:pmid "local_af9f4c12" ;
    fabio:hasPublicationYear 2026 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Data source and eligibility described" ;
                            slr:justification "Source repositories named and the harmonisation procedure described in order, with stratified merging by age cohort - but no eligibility criteria, dates or demographic distributions." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Participants appropriate to the question" ;
                            slr:justification "Public screening records with no recruitment or setting described, and no per-cohort or per-class counts anywhere." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Sample size justified" ;
                            slr:justification "No justification, and the 2,154 total is never decomposed by cohort or class." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Predictors defined and measured appropriately" ;
                            slr:justification "A1-A10 items and the composite Q_SCORE are supplied as predictors of a label constructed as their weighted, thresholded sum." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Preprocessing transparently reported" ;
                            slr:justification "Imputation, harmonisation, normalisation, encoding and pruning are described in order, with a quantified sensitivity analysis across three imputation methods." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Predictors assessed blind to outcome" ;
                            slr:justification "Domain weights were calibrated on the full dataset and SHAP-based feature pruning, which requires a fitted model, was performed before cross-validation." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Outcome definition and ascertainment" ;
                            slr:justification "Severity strata are cut points on a weighted sum of the input items; no validated severity instrument was administered to anyone." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Outcome anchored to external judgement" ;
                            slr:justification "Weights calibrated to maximise kappa against expert assessments (kappa 0.72, 95% CI 0.69-0.76), but the subset size, expert qualifications and instrument are unreported." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Outcome determined independently of predictors" ;
                            slr:justification "It is not, and the paper states so explicitly and repeatedly." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Limitations and overinterpretation" ;
                            slr:justification "The estimand's circularity is named in five separate sections, SHAP is bounded against causal reading, external clinician-annotated validation is called necessary, and deployment is conditioned on human oversight." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Validation design guards against optimism" ;
                            slr:justification "Stratified 10-fold cross-validation with early stopping and class weighting, plus threshold and weight perturbation across folds - but the labelling weights themselves were fitted to the full dataset first." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Performance measures adequate" ;
                            slr:justification "Accuracy, precision, recall, F1, per-class AUROC and kappa with an interval; but no class counts, no baseline, and no confidence interval or fold variance on any accuracy despite ten folds." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Analysis unit matches the clinical claim" ;
                            slr:justification "One record per participant; folds stratify records; and no clinical claim is made that the unit could not support." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Internal consistency of ablation" ;
                            slr:justification "The ablation credits the addition of SHAP with an accuracy gain from 0.985 to 0.987, which a post-hoc explanation method cannot produce." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "unclear" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None, and the paper is explicit rather than silent about this. The abstract states that reliable severity stratification remains challenging due to the absence of explicit clinician-annotated severity labels; the methods then construct severity labels from the A1-A10 items themselves; and the scope paragraph states that because the severity labels are deterministically derived from the same behavioural attributes used as model inputs, the subsequent prediction task constitutes a structured function-approximation setting. The one external anchor is the weight calibration, in which domain weights were optimised to maximise agreement with independent expert assessments on a randomly sampled subset, achieving Cohen's kappa 0.72 (95% CI 0.69-0.76) - and the paper immediately qualifies this as supporting the internal consistency of the labeling heuristic while not implying external diagnostic validity. Neither the number of expert-labelled records, the identity or qualification of the experts, nor the instrument they used is reported." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-159" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No participants were recruited. Four public screening datasets from Kaggle and UCI were harmonised into 2,154 records spanning toddlers, children, adolescents and adults, with stratified sampling by age group during merging to preserve cohort proportions. The analysis unit is the record and the cross-validation folds are stratified over records. What is missing is arithmetic: the per-cohort sample sizes, the class counts for the binary screening outcome and the counts for each of the four constructed severity strata are all absent, so the denominator behind every reported accuracy is unknown. The class distribution is characterised only qualitatively, as closely mirroring population-level screening statistics reported in prior paediatric ASD studies." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-159" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2026. The framing is the study's principal contribution to this review. Where the rest of the questionnaire branch presents reconstruction of a checklist threshold as diagnostic accuracy, this paper presents the same task as what it is - approximation of a deterministic behavioural scoring function - and repeats that restriction in the abstract, the contributions, the methods, the results and the conclusion. It describes its own labelling as a heuristic with internal consistency but no external diagnostic validity, bounds its SHAP interpretation against causal claims, calls external validation against clinician-annotated data necessary rather than desirable, and requires human oversight for any deployment. The overreach that remains is modest and confined to the discussion, which speaks of diagnostic precision and of stratifying ASD into four functional levels, and to the clinical-integration proposal for electronic health records and e-learning platforms. It is the only study in the branch whose stated conclusions a reader could act on safely." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-159" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Accuracy, precision, recall, F1 and AUROC per cohort and per ablation variant; per-class AUROC curves across the four severity levels and four age groups; Cohen's kappa with a confidence interval for label-expert agreement; and quantified stability under three separate perturbation analyses. The metric set is broad and the sensitivity reporting is a genuine strength. Two gaps. No confidence interval or across-fold variance accompanies any classification accuracy, despite ten folds having been run and despite intervals being reported for the kappa. And no class counts are given for either the binary or the four-level target, so no baseline exists against which a 99.10% can be positioned - which matters particularly for a four-class ordinal problem whose stratum boundaries the authors chose." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-159" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "External validation against independently clinician-annotated severity datasets - named as necessary rather than desirable - plus multimodal fusion (prosody, eye-gaze dynamics), federated learning validation, and prospective clinical trials to enhance sensitivity and ensure fairness across populations. The first directly addresses the study's own stated boundary; the fairness objective is undercut by the removal of ethnicity and country of residence during preprocessing." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-159" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "SHAP is applied with its scope explicitly bounded, and the bounding is the point: the contributions list describes it as methodologically bounded explainability, applied to analyse feature utilisation and model consistency without asserting independent clinical causality. That is the correct use of the method under a constructed label, and it is unique in this corpus - the six other Q-CHAT-labelled studies charted here all read their SHAP or feature-importance output as clinical corroboration. Two problems remain. SHAP was also used upstream, as a feature-pruning criterion, which requires a fitted model and was performed on the full dataset before cross-validation. And the ablation table lists BiLSTM + CGBO + SHAP at accuracy 0.987 against BiLSTM + CGBO at 0.985, attributing a 0.002 gain to the addition of SHAP - which is not possible, since a post-hoc explanation method computes attributions for an already-trained model and cannot change its predictions." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-159" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No instrumentation. Analytical components: BiLSTM, a chaotic optimiser (expanded inconsistently as Chaotic Grey Ball Optimizer in the abstract and Chaotic Gradient-Based Optimizer in the methods), SHAP, and standard preprocessing. No software, version, seed or hardware is named in the extracted text." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-159" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No task or paradigm - screening checklists completed by caregivers or self-report. The paper offers a substantive argument for its architecture choice that deserves recording: although the A1-A10 items are collected in a static format, their ordering is said to be non-arbitrary, with each question progressively evaluating social reciprocity, which is why a bidirectional sequence model is applied. The argument is stated but not tested - no experiment permutes item order to see whether the claimed sequential structure carries any signal." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-159" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional secondary analysis. Ethical approval and consent to participate are both declared not applicable, with the reasoning stated in full: no direct experimentation with human participants, and all analyses conducted on publicly available, fully anonymised, open-access de-identified datasets from Kaggle and UCI. The declaration is at least reasoned rather than blank. What it does not address is whether the original respondents consented to research reuse - the same gap present across this branch." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-159" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Not captured in the extracted text." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-159" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "ASD, autism spectrum disorder, participants, developmental cohorts, severity strata. The register is technical and notably free of pathologising language for this corpus; severity is described in terms of DSM-5 functional-support levels rather than as degrees of impairment, and the paper avoids the diagnostic vocabulary its results cannot support. No autistic or community perspective appears." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-159" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A bidirectional LSTM as a high-capacity representation learner over static questionnaire attributes, trained with a chaotic optimiser that applies controlled chaotic perturbations to diversify gradient updates, described as an alternative to deterministic optimisers such as Adam or RMSProp. Baselines fitted by the authors under identical preprocessing and validation: SVM, random forest, logistic regression, MLP and unidirectional LSTM. The ablation reports a clean monotone progression from 0.932 to 0.987." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-159" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No study setting. Public datasets harmonised and analysed computationally; no environment, hardware or runtime is described." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-159" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A 15-attribute harmonised row per participant after pruning, with continuous variables min-max normalised and categorical fields label-encoded. The predictor set contains the A1-A10 items and the composite Q_SCORE; the target is a four-level discretisation of a weighted sum of those same A1-A10 items. The label is therefore an arithmetic function of the inputs by construction, and the paper says so." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-159" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Moderate, and unusually strong on the parts that matter most for this branch. The labelling function is specified completely - the weighted index, its normalisation, the four threshold boundaries and the calibration objective - so another group could reconstruct the target variable, which is not true of any comparable study in this review. Three separate sensitivity analyses are reported with quantified deviations: imputation method (mode versus median versus kNN, under 1.0% deviation in macro-F1 and accuracy), severity thresholds perturbed by 5% and domain weights by 10% (macro-F1 within 0.6%, kappa within 0.03). The ablation table isolates each architectural component. Against this: no code, seed, software, versions, layer configuration, learning rate, batch size or epoch count; no per-cohort or per-class sample counts; and the harmonised dataset promised only post-publication." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-159" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The stated goal is a single-stage framework performing joint screening-level ASD identification and four-level ordinal severity stratification, under an explicitly controlled labelling paradigm, with a bidirectional LSTM as representation learner and a chaotic optimiser for training stability. Headline findings: accuracy 99.10% for toddlers, 97.10% children, 98.50% adolescents and 98.10% adults with AUROC above 0.99, a 3-6 point gain over the authors' own baselines (SVM 0.911, logistic regression 0.902, random forest 0.928, MLP 0.944, unidirectional LSTM 0.932). The framing of these results is the study's distinguishing feature: they are presented as evidence of the model's effectiveness in approximating a deterministic behavioural severity-scoring function rather than independent clinical diagnostic performance." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-159" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "This is the study's defining characteristic and the reason it matters to the review. The scope restriction is not confined to a closing limitations paragraph but is stated in the abstract, the contributions list, the labelling section, the training section and the results discussion. Its clearest formulation is in section 3.3: because the severity labels are deterministically derived from the same behavioural attributes used as model inputs, the subsequent prediction task constitutes a structured function-approximation setting; accordingly, high classification performance should be interpreted as evidence of the proposed model's ability to learn stable and interpretable behavioural scoring functions, rather than as proof of clinical diagnostic accuracy. It further states that the labelling kappa supports internal consistency while not implying external diagnostic validity, that SHAP results carry no causal or diagnostic attribution, that performance gains are methodological improvements rather than evidence of clinical diagnostic superiority, and that the datasets are behaviourally constrained. What remains unstated: that the domain weights were calibrated on the full dataset before cross-validation, that SHAP-based feature pruning requires a fitted model and was likewise performed on the full data, that no class counts are reported, and that the ablation credits SHAP with a 0.002 accuracy gain when SHAP is a post-hoc explanation method that cannot alter a model's predictions." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-159" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The evaluation is stratified 10-fold cross-validation at the record level with early stopping and class weighting, supported by three quantified sensitivity analyses - imputation method, severity thresholds perturbed by 5%, domain weights perturbed by 10% - showing macro-F1 stable within 0.6% and kappa within 0.03. That is more robustness checking than any other study in this branch performs. But the estimand is settled before any of it, and the paper states the conclusion itself: the severity labels are deterministically derived from the same behavioural attributes used as model inputs, so the task is function approximation and the accuracy figures are not diagnostic accuracy. Read that way, the results are internally coherent and even informative - a BiLSTM recovers a four-way threshold on a weighted sum of ten items with 97-99% accuracy, and simpler models recover it with 90-94%, which quantifies how much architectural capacity the reconstruction of a piecewise-linear scoring rule requires. Three residual issues qualify even that reading. The domain weights were calibrated on the full dataset by optimising kappa against expert labels before cross-validation, so the labelling function itself was fitted to the data the model is then evaluated on. SHAP-based feature pruning was likewise applied to the whole dataset and necessarily requires a fitted model. And the expert calibration - the only external anchor in the study - reports kappa 0.72 without stating how many records were expert-labelled, by whom, or with what instrument, so the one bridge between the constructed label and clinical severity is itself unspecified. Compared against the branch, the difference is not in the estimand but in the interpretation: local_ed30e24c reported 292 of 292 correct as confirming suitability for reliable clinical screening; local_b9de0d7f offered a numpy-generated teaching-method label at 0.9917 to educators; this study reports 99.10% and states in four separate places that it does not mean what it appears to mean." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-159" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Screening-item behaviours from the A1-A10 instruments, organised into three domains - social communication difficulties, repetitive behaviour and a cognitive assessment component - which supply the weighted terms of the constructed severity index. The correlation analysis relates the composite Q_SCORE to social communication difficulties (r 0.64-0.67) and repetitive behaviour (r 0.45-0.63) and reports moderate inter-item correlations (r 0.10-0.46), read as each item adding unique variance." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-159" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Constructed, not measured. The four ordinal strata are cut points on a weighted sum of A1-A10 normalised to [0,1]: No ASD below 0.30, Mild 0.30-0.55, Moderate 0.55-0.75, Severe at or above 0.75, with the boundaries said to align with DSM-5 functional-support descriptors and percentile interpretations from the Q-CHAT and ADOS-2 literature. No validated severity instrument was administered to anyone. The paper's own framing of this as a controlled behavioural labeling paradigm rather than as severity assessment is accurate and is what distinguishes it from local_b9de0d7f, which generated a six-way teaching-method label from a Q-CHAT total using numpy and then offered the resulting accuracy to educators as a basis for decisions." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-159" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Almost none, and by deliberate removal. Age is retained as a continuous normalised feature and cohort membership is preserved through stratified merging, but ethnicity, country of residence, who completed the test and whether the app had been used before were all excluded during feature pruning as low-variance, irrelevant or metadata noise, on the stated ground of eliminating demographic skew. Sex is not reported anywhere. The consequence is that no subgroup analysis by sex, ethnicity or respondent type is possible, and the fairness across populations named in the future-work section cannot be assessed in the present study - the variables required for it were removed." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-159" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Discover Applied Sciences 8(4):363 (Springer) - an open-access multidisciplinary applied-sciences journal. The venue is not clinical, yet the paper is the most careful in the branch about the boundary between computational and clinical claims, which suggests the discipline of the authors rather than of the reviewers is doing the work here." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-159" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No fusion - a single questionnaire modality. What the study does perform is dataset harmonisation across four age cohorts into a common 15-attribute schema with stratified merging, which is cross-cohort integration rather than multimodal fusion. Multimodal extension with prosody and gaze is named as future work, and the absence of such cues is acknowledged as a constraint of the current data." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-159" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "Internal baselines fitted by the authors under identical preprocessing and validation protocols: SVM (RBF) 0.911, random forest 0.928, logistic regression 0.902, three-layer MLP 0.944, unidirectional " ;
                    slr:study_design "Retrospective secondary analysis of four harmonised public tabular screening datasets; a single-stage BiLSTM with a chaotic optimiser performs joint binary screening and four-level…" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: Not reported as a count. The derived severity label produces four strata whose class distribution is described as closely mirroring population-level screening statistics reported in prior paediatric ASD studies, but no counts are given.; comparison: Not reported." ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "Accuracy 99.10% (toddlers), 97.10% (children), 98.50% (adolescents) and 98.10% (adults), with AUROC exceeding 0.99, described as a 3-6% absolute improvement over the strongest baselines. Ablation: unidirectional LSTM 0.932, BiLSTM without the chaotic optimiser 0.956, BiLSTM with Adam 0.968, BiLSTM with the chaotic optimiser 0.985, and BiLSTM plus optimiser plus SHAP 0.987." ;
                    slr:outcome "Accuracy, precision, recall, F1 and AUROC per cohort and for the ablation variants; Cohen's kappa with a confidence interval for label-expert agreement; macro-F1 and kappa stability under threshold and weight perturbation; per-class AUROC curves for the four severity levels across age groups; a corr" ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "Accuracy 99.10% (toddlers), 97.10% (children), 98.50% (adolescents) and 98.10% (adults), with AUROC exceeding 0.99, described as a 3-6% absolute improvement over the strongest baselines. Ablation: unidirectional LSTM 0.932, BiLSTM without the chaotic optimiser 0.956, BiLSTM with Adam 0.968, BiLSTM with the chaotic optimiser 0.985, and BiLSTM plus optimiser plus SHAP 0.987." ] ] ;
