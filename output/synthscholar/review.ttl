        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "This analysis provided a fingerprinting identification accuracy of 35.4% (17/48) and 29.5% (31/105) for the ASD and TD groups, respectively, both significantly above chance (p < 0.001, permutation test; the chance level was 6.2% (3/48) and 2.9% (3/105)" ] ;
            oa:hasTarget <https://doi.org/10.1186/s13229-022-00517-2> ;
            slr:claim_label "Individuals can be identified from their own gaze patterns at five to ten times chance, quantifying the individual-identity signal that leaks whenever participants span a train/test split." ;
            slr:relevance_score "0.98"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
