    slr:journal "Frontiers in Psychology, 12, Article 635696" ;
    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Cross-validation folds split 1,500 task-level samples at random across 60 children, so each child's data appears in both training and test; the reported 93%, its sensitivity, specificity, ROC and the entire feature-importance ranking come from the single best of ten fold models, against a cross-validated estimate of 88 +/- 3%." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "DSM-5 criteria plus ADOS-2, applied by qualified clinicians explicitly stated to have no affiliation with the research team; comparison children excluded for suspected autism, developmental abnormality or psychiatric/neurological history." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Sex is not reported for either group; IQ is given only as a range with no means or SDs and the ranges differ; and cases were recruited from a rehabilitation centre where they receive ongoing psychomotor therapy while comparisons came from a primary school, confounding group with setting and with prior fine-motor intervention." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "All 60 children completed the analysed items by construction - only the first five items of each subtest were used because every participant performed those correctly - and the excluded demonstration item is identified with its reason." ] ;
            slr:overall_judgment "high" ;
            slr:tool_used "QUADAS-2" ] .

<https://doi.org/10.3389/fpsyg.2021.665096> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "ORIGINAL RESEARCH published: 07 September 2021 doi: 10.3389/fpsyg.2021.665096 Edited by: Federica Biassoni, Catholic University of the Sacred Heart, Italy Reviewed by: Keith Maurice Kendrick, University of Electronic Science and Technology of China, China Marisa Filipe, Universidade Lusófona, Portugal *Correspondence: Meysam Asgari asgari@ohsu.edu Specialty section: This article was submitted to Psychology for Clinical Settings, a section of the journal Frontiers in Psychology Received: 07 February 2021 Accepted: 16 June 2021 Published: 07 September 2021 Citation: Asgari M, Chen L and Fombonne E (2021) Quantifying Voice Characteristics for Detecting Autism. Front. Psychol. 12:665096. doi: 10.3389/fpsyg.2021.665096 Quantifying Voice Characteristics for Detecting Autism Meysam Asgari1*, Liu Chen1 and Eric Fombonne2 1 Institute on Development and Disability, Department of Pediatrics, Oregon Health & Science University, Portland, OR, United States, 2 Departments of Psychiatry and Pediatrics, Oregon Health & Science University, Portland, OR, United States The presence of prosodic anomalies in autistic is recognized by experienced clinicians but their quantitative analysis is a cumbersome task beyond the scope of typical pen and pencil assessment. This paper proposes an automatic approach allowing to tease apart various aspects of prosodic abnormalities and to translate them into ﬁne-grained, automated, and quantiﬁable measurements. Using a harmonic model (HM) of voiced signal, we isolated the harmonic content of speech and computed a set of quantities related to harmonic content. Employing these measures, along with standard speech measures such as loudness, we successfully trained machine learning models for distinguishing individuals with autism from those with typical development (TD). We evaluated our models empirically on a task of detecting autism on a sample of 118 youth (90 diagnosed with autism and 28 controls; mean age: 10.9 years) and demonstrated that these models perform signiﬁcantly better than a chance model. Voice and speech analyses could be incorporated as novel outcome measures for treatment research and used for early detection of autism in preverbal infants or toddlers at risk of autism." ;
    dcterms:bibliographicCitation "Asgari M; Chen L; Fombonne E (2021). Quantifying Voice Characteristics for Detecting Autism. *Frontiers in Psychology, 12, Article 665096*. https://doi.org/10.3389/fpsyg.2021.665096" ;
    dcterms:creator "Asgari M",
        "Chen L",
        "Fombonne E" ;
    dcterms:title "Quantifying Voice Characteristics for Detecting Autism" ;
    bibo:doi "10.3389/fpsyg.2021.665096" ;
    bibo:pmid "local_29a3fc54" ;
    fabio:hasPublicationYear 2021 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are comparison groups matched on the variables that matter?" ;
                            slr:justification "Sex differs by more than 40 percentage points and IQ by 14 points; only IQ is addressed by matched replication." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the sample appropriate and adequate for the stated target?" ;
                            slr:justification "118 youth is the largest speech sample in the corpus, with fluent speakers appropriate to ADOS-2 Module 3." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are voice-relevant confounds controlled by exclusion?" ;
                            slr:justification "Current psychoactive medication, thyroid disorder, head injury, cerebral palsy and several psychiatric conditions all excluded." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are participants and recruitment adequately described?" ;
                            slr:justification "Recruitment route, full exclusion criteria, and group means with p-values for age, sex, race, ethnicity, IQ, ADOS-2, SRS and CCC-2." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the comparison group actively screened?" ;
                            slr:justification "Autism ruled out using ADOS-2 and SRS supplemented by expert clinical review." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the behavioral data acquisition described reproducibly?" ;
                            slr:justification "The four ADOS-2 tasks, their selection criterion, and the full three-level signal analysis chain with all parameters." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the measure retrofittable to existing practice?" ;
                            slr:justification "Speech is extracted from videotaped ADOS-2 sessions already recorded as part of routine assessment." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the measurement method validated for the signal type?" ;
                            slr:justification "The harmonic model was developed to correct octave errors and resolution limits in disordered speech and previously validated on Parkinson's disease and depression." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the reference standard appropriate and independently applied?" ;
                            slr:justification "Best-estimate DSM-5 by a two-clinician team on videos and scored protocols, with ADOS-2, ADI-R and SRS." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are predictors defined without knowledge of outcome?" ;
                            slr:justification "Features are computed automatically, but RFECV selection is label-driven and not stated to be nested within folds." ;
                            slr:rating "Partly" ] ;
                    slr:overall_concern "low" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is uncertainty quantified?" ;
                            slr:justification "95% confidence intervals reported on every AUC, allowing the prosody-versus-articulation difference to be assessed as non-overlapping." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is feature selection nested within validation?" ;
                            slr:justification "RFECV and the choice of best conversational activity were both performed across the reported cross-validation without an outer loop." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are negative results reported?" ;
                            slr:justification "Combining prosody with articulation was worse than prosody alone, and combining conversational activities did not improve on the best single activity." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is class imbalance handled rigorously?" ;
                            slr:justification "Iterative undersampling to 28 per class with five-fold cross-validation at each iteration, repeated to convergence at about 100 iterations." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is a major confound tested rather than only acknowledged?" ;
                            slr:justification "A 28-pair IQ-matched subsample at equal mean IQ reproduced the result at 88.27% AUC." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is a chance or trivial baseline reported?" ;
                            slr:justification "A random-assignment classifier run through the same pipeline and reported at 49.90% AUC with its own confidence interval in every table." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "low" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are severity correlations established across independent informants?" ;
                            slr:justification "Pitch and loudness correlate with both clinician-rated ADOS-2 CSS and parent-rated SRS after IQ adjustment." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the multiplicity limitation stated?" ;
                            slr:justification "The authors state results were not adjusted for multiple comparisons and should be viewed as preliminary." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is a contrary direction of effect reconciled with prior literature?" ;
                            slr:justification "Lower pitch in autism runs against much of the prosody literature and is not discussed, despite a sex composition that would produce it." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is code available?" ;
                            slr:justification "Toolkits and methods named with prior papers cited for computational detail; no code." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the dataset accessible or its access conditions stated?" ;
                            slr:justification "No release statement in the extracted text." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are ethics and consent reported?" ;
                            slr:justification "Informed written consent or assent from participants and parents, with IRB review and approval at OHSU." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "low" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2021. The framing is the most precisely targeted in the corpus. Rather than arguing that clinical assessment is subjective in general, it identifies exactly where prosody falls through the diagnostic net: ADOS-2 Module 3 contains one item rating 'Speech abnormalities associated with autism (Intonation/Volume/Rhythm/Rate)' on a 0-2 scale where an abnormal score 'represents a composite of abnormal features crudely lumped together'; the SRS contains one item on unusual tone of voice; and 'there is no reference to speech or voice quality in any of the 7 diagnostic criteria laid out in' DSM-5. It also identifies a technical rather than clinical obstacle - that existing pitch detection algorithms produce octave errors on quasi-periodic disordered speech and lack the resolution to capture fine perturbation - and addresses it with a model previously validated on other clinical populations. Its account of why prior pitch findings conflict is likewise specific, attributing heterogeneity to variation in voice sampling context, from home recordings to structured caregiver interactions to professional evaluations 'with varying social and cognitive demands', and then testing that account directly by comparing four conversational contexts within one dataset." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-069" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The fusion result is negative and cleanly reported: prosodic features alone gave 82.23% AUC, articulation alone 67.98%, and the two combined 78.52% - worse than prosody alone. The authors attribute this to articulation's poorer specificity dragging down the combination, and respond by using prosody alone for all subsequent analyses. A second combination test concerns sampling context rather than feature type: the best single conversational activity (83.04%) matched or exceeded every combination of two, three or four activities, so concatenating more speech did not help. Both results run against the assumption that more data or more feature families improve performance, and both are acted on rather than merely noted." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-069" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Oregon Health and Science University, with participants recruited by community outreach and referral from OHSU specialised clinics into a neuroimaging study, and speech extracted from videotaped ADOS-2 administrations conducted as part of that study's screening. IRB approval from OHSU." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-069" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Keywords: voice, speech analysis, autism spectrum disorder, harmonic model, prosody, machine learning. 'Harmonic model' is the technical core - the paper's distinctive contribution is a signal-processing method for extracting reliable pitch from quasi-periodic disordered speech, with autism as the application." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-069" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Acknowledged directly: 'These results were not adjusted for multiple comparisons and should be viewed as preliminary. They require replication in larger samples, more balanced with respect to IQ and gender composition'. The study is described as a proof of concept and a pilot analysis. The IQ imbalance is not only acknowledged but addressed by a matched-pair replication. Not acknowledged: the sex imbalance receives no matched-subsample check despite being larger and more directly relevant, since pitch is sex-dependent and is one of the two retained features; the finding of lower pitch in autism runs contrary to a substantial part of the prosody literature and this discrepancy is never noted; all 14 exclusions for recording quality came from the autistic group; and RFECV and the choice of best conversational activity were both performed across the reported cross-validation without an outer loop." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-069" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No dedicated recording equipment - the analysis reuses videotape from ADOS-2 administrations, which is what makes it deployable without protocol change. Analytically it rests on the authors' own time-varying harmonic model, developed to correct two specific failures of standard pitch detection algorithms: octave errors that estimate pitch at half or double its true value, and insufficient time-frequency resolution to capture the fine pitch and amplitude perturbation characteristic of disordered speech. The model is fitted by maximum a posteriori estimation to prevent overfitting from model complexity, and had been previously validated on Parkinson's disease and clinical depression." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-069" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional; one ADOS-2 administration per participant with no follow-up, though the stated application as a treatment outcome measure would require longitudinal demonstration that the measures capture change, which the authors identify explicitly. Data are audio from videotaped clinical assessments. Governance is reported: informed written consent or assent from all participants and their parents, who also had to be fluent in English, and IRB review and approval at OHSU." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-069" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Autistic group: 90 participants, 75 male (80.6%), mean age 10.84 +/- 2.20 (7.8-15.3), WISC-IV full-scale IQ 99.0 +/- 20.0. Comparison group: 28 participants, 12 male (40.0%), mean age 10.96 +/- 1.54 (7.0-15.0), IQ 113.4 +/- 12.3. Age, race and ethnicity show no significant difference. Two variables do: sex (p < 0.001) and IQ (p = 0.005). The IQ difference is addressed by a matched-pair replication; the sex difference is acknowledged but not tested. Given that pitch is sex-dependent and is one of the two features retained, and that the comparison group is 60% female against the autistic group's 19%, the sex imbalance is the more consequential of the two. Race is 86% white in both groups, and Hispanic ethnicity 14-18%, so the sample is demographically narrow but balanced." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-069" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Frontiers in Psychology, 12, article 665096, in the Psychology for Clinical Settings section - a psychology venue, with authorship spanning a paediatrics institute on development and disability and departments of psychiatry and paediatrics, which explains the depth of clinical characterisation relative to the modelling." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-069" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Interpretability is pursued through three complementary routes. Recursive feature elimination reduces the prosodic set to pitch and loudness, both physically meaningful. Those two are then correlated against four clinical measures using partial Spearman coefficients adjusted for WISC IQ, establishing that both track severity as rated by a professional (ADOS-2 CSS) and independently by a parent (SRS) - the authors note this is 'a noticeable result since it was established with separate informants', which is the right emphasis, since agreement across informant types is stronger evidence than a single-source correlation. Finally, the distributions of both features are plotted by group across all four activities and jointly in a two-dimensional visualisation, showing lower pitch with comparable dispersion and higher loudness with much greater variability in autism. The one interpretive gap is that the direction of the pitch effect is not reconciled with the prosody literature." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-069" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "'individuals with autism', 'youth with ASD', 'subjects with ASD', 'those with typical development', 'autistic'. Mixed person-first and identity-first, with 'typical development' throughout. The framing is measurement-focused and non-pathologising toward participants - the criticism is directed at instruments, describing the single ADOS-2 speech item as scoring 'a composite of abnormal features crudely lumped together'." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-069" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Goal: quantify prosodic abnormality automatically and test whether voice alone predicts diagnosis better than chance, and whether ADOS-2 tasks differ in discriminative value. Main findings: prosodic features reached 82.23% AUC against a 49.90% chance baseline; articulation features alone reached only 67.98% and combining the two was worse than prosody alone; friends and marriage conversation was the single best sampling context at 83.04% with no gain from combining tasks; pitch and loudness formed the optimal subset and both correlated with independently rated severity after IQ adjustment; and an IQ-matched 28-pair subsample reproduced the result at 88.27% AUC." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-069" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Very good. Reported: the four ADOS-2 tasks with the criterion for their selection; the full three-level analysis cascade with frame length, frame rate, silence detection, voiced-unvoiced separation, the Markov smoothness constraint and Viterbi decoding; the summarisation statistics and the decision to summarise voiced and unvoiced regions separately; all feature families with their rationale; the classifier, kernel, regularisation and scaling; the cross-validation structure with explicit statement of how test folds were held blind; the undersampling procedure with its convergence criterion; the confidence interval computation; the RFECV method; the IQ-matched subsample construction; and the complete exclusion criteria list. Missing: SVM hyperparameter values, whether RFECV was nested within folds, data or code release, and the number of speech segments or total audio duration per participant." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-069" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A three-level cascade producing a fixed-dimension subject vector from variable-length speech: frame measures at 100 per second, summarised by five distributional statistics separately for voiced and unvoiced regions and augmented with duration statistics, then summarised again per conversational activity, then concatenated across four activities. The separation of voiced from unvoiced regions is a considered choice - 'features extracted from voiced regions tend to differ in nature compared to those from unvoiced regions' - and the per-activity structure is what enables the sampling-context comparison. Recursive elimination then reduces the prosodic set to two interpretable quantities, pitch and loudness." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-069" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The most complete clinical characterisation of any speech study in the corpus. ADOS-2 Social Affect, Restricted and Repetitive Behavior, total and Calibrated Severity Scores; SRS total t-scores; WISC-IV short-form full-scale IQ from Information, Block Design and Vocabulary subtests; and the Children's Communication Checklist-2 yielding both a General Communication Composite and a Social Interaction Difference Index designed so that more negative values indicate autism. All are reported with group means and p-values, and the ADOS-2 CSS, SRS, GCC and SIDI are used analytically as correlates of the selected voice features, with partial Spearman coefficients adjusted for IQ." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-069" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Five-fold cross-validation with training, development and test sets rotated and an explicit statement that model parameters were learned only from training examples and were 'totally blinded from the test examples'. Class imbalance is handled by iterative undersampling to 28 per class, repeated until scores converged at around 100 iterations - a substantially more rigorous treatment than a single balanced draw, since it averages away the randomness of which majority-class participants are selected. Confidence intervals are computed on every AUC. The IQ-matched subsample analysis functions as an internal replication under a controlled confound and returns a higher AUC (88.27%) than the main analysis, which is strong evidence that IQ was not driving the result. What remains: RFECV and the best-activity selection were both performed across the same cross-validation used for reporting, with no outer loop; and no independent cohort or external site was tested." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-069" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Compare voice-only against language-only analysis on the same participants and test whether combining them helps, building on the group's parallel work applying natural language processing to ADOS-2 transcripts from this same sample; develop these measures as treatment outcome measures given 'a recognized dearth of outcome measures available for treatment research in autism', which requires longitudinal demonstration of sensitivity to change; and extend to preverbal toddlers at risk and to young children with minimal or no language, where the authors note identification of atypical voice patterns 'might enhance diagnostic procedures'." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-069" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Prosody during naturalistic conversation about emotions and social relationships, decomposed into pitch, cycle-to-cycle frequency perturbation (jitter), cycle-to-cycle amplitude perturbation (shimmer), harmonics-to-noise ratio and loudness, plus articulation indexed by cepstral coefficients and spectral entropy, and fluency indexed by voiced and unvoiced segment durations and counts. The behavioural target is the modulation of voice rather than its content, and the conversational rather than task-based elicitation means the speech is spontaneous." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-069" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Exemplary. DSM-5 diagnosis confirmed by a research diagnostic team comprising an experienced child psychiatrist and a clinical psychologist using best-estimate procedures after reviewing both videos and scored protocols of standardised assessments. ADOS-2 Module 3 administered by staff trained to research reliability level. ADI-R administered to caregivers of the autistic group by trained interviewers and integrated into the best-estimate procedure. Autism actively ruled out in comparison participants using ADOS-2 and SRS supplemented by expert clinical review. An extensive medical and psychiatric exclusion list applied to both groups, including current psychoactive medication - a control that matters directly for voice measures and that almost no other speech study in the corpus applies." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-069" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "AUC with 95% confidence intervals, sensitivity, specificity and accuracy, reported for three feature configurations and seven activity configurations, every one alongside the chance baseline. Reporting confidence intervals on AUC allows the differences between conditions to be assessed - the prosody interval (81.11-83.35) does not overlap the articulation interval (66.62-69.35), so that comparison is supported, while the intervals for the four individual activities largely overlap, so the ranking among them is weaker than the point estimates suggest. Missing: confusion matrices and per-fold variability." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-069" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A single linear SVM with L1 regularisation, chosen after the non-linear variant underperformed and justified by L1's property of zeroing uninformative coefficients - appropriate for a high-dimensional feature space built by summarising frame measures across statistics, regions and activities. The more important modelling decision is the inclusion of an explicit chance classifier that randomly assigns participants, run through the same pipeline and reported in every results table at 49.90% AUC with its own confidence interval. That baseline is what converts the reported figures from numbers into evidence, and its presence distinguishes this study from most of the corpus." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-069" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Four conversational ADOS-2 Module 3 tasks, chosen on an explicit criterion - they occur in the second half of the administration, 'do not require objects, books or images, and are purely conversational', so speech is elicited without competing manipulative demands. The design's central practical virtue is that no new protocol is required at all: the speech already exists in every videotaped ADOS-2, so the measure is retrofittable to routine assessment. The task-by-task comparison then produces a directly actionable finding - the friends and marriage conversation alone matches or exceeds all four combined, so a shorter sampling context suffices, and the authors note it 'could be selected in circumstances where reducing the false positive rate is required'." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-069" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two groups from a single neuroimaging cohort: 104 autistic participants recruited of whom 90 were analysed, and 28 typically developing. All 14 exclusions for poor recording quality came from the autistic group, a differential attrition of 13.5% against 0% that is reported but not discussed - and one that plausibly removes the participants whose speech was hardest to capture, potentially the most severely affected. No other-diagnosis comparison group. The 90:28 imbalance is addressed analytically by repeated undersampling rather than left uncorrected." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-069" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "One ADOS-2 administration per participant, with speech drawn from four conversational tasks within it" ;
                    slr:study_design "Cross-sectional case-control classification using speech extracted from a standardised diagnostic assessment, with an IQ-matched subsample replication" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "School-age children and adolescents with autism and fluent speech" ;
                    slr:sample_size_text "ASD/index: 104 recruited, 90 analysed after 14 exclusions for poor recording quality; comparison: 28" ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "Prosodic features 82.23% AUC (81.11-83.35), sensitivity 69.67%, specificity 76.83%, accuracy 73.30%. Articulation features alone 67.98% AUC. Combining prosodic and articulation features gave 78.52%, worse than prosody alone. Chance classifier 49.90% (48.17-51.63). By activity, friends and marriage conversation performed best at 83.04% AUC and 74.52% accuracy, then emotions conversation 81.63%, soc",
                        "Prosodic voice measures derived from a time-varying harmonic model distinguished autistic from typically developing youth at 82% AUC against a chance baseline of 50%, using speech already captured during routine ADOS-2 administration. Prosody markedly outperformed articulation measures (68%), and combining the two was worse than prosody alone. Conversational context mattered: the friends and marri" ;
                    slr:outcome "AUC with 95% confidence intervals, sensitivity, specificity and accuracy, reported for each feature group, each conversational activity and each activity combination, all against a chance-classifier baseline" ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "Prosodic features 82.23% AUC (81.11-83.35), sensitivity 69.67%, specificity 76.83%, accuracy 73.30%. Articulation features alone 67.98% AUC. Combining prosodic and articulation features gave 78.52%, worse than prosody alone. Chance classifier 49.90% (48.17-51.63). By activity, friends and marriage conversation performed best at 83.04% AUC and 74.52% accuracy, then emotions conversation 81.63%, soc; Prosodic voice measures derived from a time-varying harmonic model distinguished autistic from typically developing youth at 82% AUC against a chance baseline of 50%, using speech already captured during routine ADOS-2 administration. Prosody markedly outperformed articulation measures (68%), and combining the two was worse than prosody alone. Conversational context mattered: the friends and marri" ] ] ;
