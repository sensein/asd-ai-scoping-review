    slr:journal "Autism Research, 15(7), 1288-1300" ;
    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "Leave-one-subject-out cross-validation justified by citation to the subject-wise validation literature and cross-checked against 10-fold; DeLong tests with confidence intervals for all model comparisons; features computed blind to diagnosis; feature selection reported as producing no significant gain." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "Complete flow from 289 screened to 158 analysed with reasons at every step; age formally matched; the sex and IQ imbalances tested directly by sex-stratified models and by misclassification analysis, neither showing an effect; and the comparison group deliberately includes an ADHD clinical group to test specificity." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "DSM-IV-TR diagnosis by experienced child psychiatrists and clinical psychologists, best-estimate confirmation by a research diagnostic team reviewing videos and scored protocols, ADOS-2 by research-reliable administrators, and active rule-out in both comparison subgroups using ADOS, clinical interview and parent questionnaires." ],
                [ a slr:RoBDomainJudgment ;
