            slr:relevance_score "0.97"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "The groups were matched on chronological age since the study involved a passive viewing paradigm and did not require cognitive or language processing skills." ] ;
            oa:hasTarget <urn:slr:article:533b421d2f0b> ;
            slr:claim_label "The stated justification for not matching on developmental level conflates task response demands with developmental sensitivity of social attention." ;
