    slr:journal "International Journal of Language & Communication Disorders, 57(5), 948-962" ;
    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "Prior multidisciplinary clinical diagnosis under ICD-10, plus fresh ADOS-2 administration by research-reliable clinicians supervised by an ADOS-2 trainer and parent-completed SCQ, neither of which had been administered before the study." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "some" ;
                    slr:supporting_quote "Groups matched on age (p = 0.92) and near-matched on verbal and non-verbal IQ (p = 0.20, p = 0.13), with stringent comparison-group exclusions including family autism history; but sex composition is claimed as matched without counts or a test, the age range spans 7-25 years, and the authors concede the sample was 'carefully selected with clear signs of ASD' and no developmental problems in comparisons." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "All 50 participants contribute to all analyses; transcript statistics, pages narrated and the 15% missing-page rate are reported; no attrition described." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "some" ;
                    slr:supporting_quote "Leave-one-out cross-validation at participant level with all six encoder-by-representation configurations reported, but only the best classifier per configuration is reported across three families and a 27-point grid, selected on the same folds, with no confidence intervals or significance testing." ] ;
            slr:overall_judgment "some" ;
            slr:tool_used "QUADAS-2" ] .

<https://doi.org/10.1186/s12888-024-06129-9> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Background Play is an indispensable and meaningful activity in children’s daily life. Research has shown that autistic children often exhibit differences in play development. The core traits of autism, such as distinct patterns in social interaction and communication, focused interests, and repetitive behaviors, frequently manifest in their play. Therefore, play may serve as an insightful measure of these differences. Unlike previous studies focusing on play behaviors only, we explored other behaviors associated with autism during free play, and constructed a clinical prediction model for effectively screening autistic children. Methods Participants, including 123 autistic children and 123 neurotypical children aged 1–6 years, engaged in a 1.5-min free play with fixed toys, which was videotaped. A novel behavior-coding scheme was used to code these videos for 19 autistic behaviors, including play. The coding details of the 19 behaviors were then converted and expanded to 81 digital behavior indicators, including counts, duration, and proportion. Results The autistic children showed less functional play and imaginative play and reduced social communication and interactions, such as eye contact, facial expressions, and vocalizations, compared to the neurotypical children during free play. Furthermore, 5 behavioral indicators were selected for the prediction model through stepwise logistic regression, including 1 on socially oriented vocalizations and 4 on count and duration of functional play. The receiver operating characteristic (ROC) curve revealed a good prediction performance with an area under the curve (AUC) of 0.826, a sensitivity of 85.4%, and a specificity of 68.3%. Conclusion Our findings highlight differences in play performance and social communication and interactions during free play among autistic children. Based on these findings, we constructed a good clinical prediction model, which might be a potential digital tool used by clinicians to effectively screen autistic children." ;
    dcterms:bibliographicCitation "Liu Q; Ma Z; Jin Y; He R; Su X; Chen J; Yin T; Cheng J; Guo Y; Li X; Liu J (2024). Prediction for children with autism spectrum disorder based on digital behavioral features during free play. *B*. https://doi.org/10.1186/s12888-024-06129-9" ;
    dcterms:creator "Chen J",
        "Cheng J",
        "Guo Y",
        "He R",
        "Jin Y",
        "Li X",
        "Liu J",
        "Liu Q",
        "Ma Z",
        "Su X",
        "Yin T" ;
    dcterms:title "Prediction for children with autism spectrum disorder based on digital behavioral features during free play" ;
    bibo:doi "10.1186/s12888-024-06129-9" ;
    bibo:pmid "local_abad69fd" ;
    fabio:hasPublicationYear 2024 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Handling of missing data and attrition" ;
                            slr:justification "All 246 included children completed the task and contributed complete indicator vectors; the 23 exclusions are stated with their reason and occurred before analysis. No missing data or lost recordings are reported." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Confounder control" ;
                            slr:justification "Age and sex matched and tested; comorbidity, neurological disease and psychotropic medication excluded by criterion. But no cognitive or language measure was obtained, although the strongest predictor is duration of socially directed speech, and age is matched at the mean without being adjusted for in a 1-to-6-year sample where four of five predictors are play-quantity measures and the group age variances differ (SD 9.9 against 13.5)." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Participant selection and spectrum representativeness" ;
                            slr:justification "Twenty-three clinically diagnosed children scoring below CARS-2 30 were excluded, restricting the autistic group to at least moderate severity. The authors state that this may have produced selection bias toward more pronounced characteristics and that model performance may consequently be overestimated - the clearest self-identification of spectrum truncation in this review." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Comparison group adequacy" ;
                            slr:justification "Kindergarten-recruited typically developing children, deliberately matched on age and sex with both tests reported - considerably better than the convenience controls typical of this corpus. But no non-autistic clinical comparison group exists, which the authors identify as the harder and more clinically relevant contrast, and the recruitment route differs systematically by group." ;
                            slr:rating "Unclear" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Reference standard quality" ;
                            slr:justification "DSM-5 best-estimate clinical diagnosis by senior child and adolescent psychiatrists, corroborated by CARS-2 with published psychometrics cited. Genuine clinical ascertainment, among the strongest in the review." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Measurement standardisation" ;
                            slr:justification "Verbatim instruction reproduced in the paper including the examiner's constrained response rule, a fixed toy set with defined categories, a standard rapport-building preamble, and a 90-second duration applied identically to every child." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Outcome measurement blinding" ;
                            slr:justification "Diagnosis was established before and independently of the play task, but coder blinding to group is not stated - and with autistic children recruited from clinical services and controls from a kindergarten, group membership may be inferable from the recordings. This matters more here than in automated studies, since all 81 indicators pass through human judgement." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Index test definition and prespecification" ;
                            slr:justification "The task, toy set and coding scheme were fully prespecified and directional hypotheses stated in advance, including the confirmed prediction that repetitive behaviours would not differ. But the five model predictors were selected from 81 candidates post hoc and the operating cut-off chosen from the ROC curve." ;
                            slr:rating "Unclear" ] ;
                    slr:overall_concern "low" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Performance estimation and chance level" ;
                            slr:justification "AUC with a confidence interval, sensitivity, specificity, predictive values, calibration curve and goodness-of-fit test - the fullest reporting in the behavioural branch. But the cut-off was chosen from the same ROC curve, and predictive values are quoted at the matched 50% prevalence with no recalculation for a screening base rate, which is the figure the paper's own screening proposal depends on." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Data splitting and leakage control" ;
                            slr:justification "The unit of analysis is the child throughout with one vector each, so no within-participant leakage is possible. But there is no held-out set, no cross-validation and no external cohort - the model is fitted and evaluated on the same 246 children." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Sample size adequacy for the modelling" ;
                            slr:justification "One hundred and twenty-three events for five final predictors is comfortable, but 81 candidates entered the selection process, which is where the optimism arises. The authors describe the sample as small for prediction-model development and call for more data." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Preprocessing and feature selection nesting" ;
                            slr:justification "Five predictors selected from 81 candidates by group-difference testing, univariate regression and stepwise regression on the full sample, with performance reported on that same sample. A bootstrap was run but no optimism-corrected AUC is reported, and the stepwise criterion is unstated." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Completeness of methods reporting" ;
                            slr:justification "Recruitment sources and window, full eligibility criteria, diagnostic procedure and threshold with the count excluded by it, matched demographics with tests, verbatim task instruction, toy categories, the coder training programme with experience range, duration and the inter-coder reliability check and its formula, all 19 behaviour definitions in a supplementary guide, and all 81 indicator definitions. Missing: coding and statistical software, stepwise criterion, bootstrap resample count." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Ethics, consent and conflicts" ;
                            slr:justification "Institutional ethics approval, Declaration of Helsinki conformity, and written informed consent from primary caregivers before the study. No funding received. Competing interests declared at the level of individual authors, with six of eleven declaring two patent applications arising from this research; four authors are affiliated with a commercial autism-services company, which is visible in the affiliations but not itself discussed." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Reporting of results and uncertainty" ;
                            slr:justification "AUC with interval, sensitivity, specificity, PPV, NPV, calibration curve, Hosmer-Lemeshow, density plots, and odds ratios with confidence intervals and p-values for every indicator at both stages. The gap is the absent optimism-corrected estimate rather than the presentation." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Acknowledgement of limitations" ;
                            slr:justification "Five limitations enumerated, including task brevity, sex imbalance, the CARS-2 severity restriction with its explicit consequence that performance may be overestimated, small sample for model development, and the absence of a non-autistic clinical comparison group. Selection optimism from choosing five predictors out of 81 is the notable omission." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Data, code and protocol availability" ;
                            slr:justification "Anonymised data from the corresponding author on request, restricted by data protection and the consent text; the full coding guide is supplied as supplementary material, which is the more useful disclosure for replication. No code, no software named, no preregistration - though directional hypotheses were stated in the introduction." ;
                            slr:rating "Unclear" ] ;
                    slr:overall_concern "low" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Six directions, each tied to a named limitation. Lengthen the free play session and create opportunities for child-initiated interaction, so that social communication and repetitive behaviours can actually be observed. Recruit a sex-balanced sample and analyse behavioural features by gender. Include children with subtler or atypical presentations rather than restricting to CARS-2 at or above 30, to make the model applicable where screening is hardest. Collect more data and formally evaluate the reliability and validity of both the coding scheme and the model, including across age groups and language levels. Add non-autistic clinical comparison groups, particularly intellectual developmental disorder, since that is the discrimination that real clinical practice requires. And use the coding scheme as a training substrate for automatic behaviour recognition - the paper is explicit that the count, duration and proportion indexes were designed to suit 'future application scenarios of machine learning automation'. Not proposed, and needed: an optimism-corrected or externally validated performance estimate, and predictive values recomputed at a realistic screening prevalence." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-124" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The aim was to measure functional and imaginative play together with other core autistic traits during a brief free play task, characterise the group differences, and build from them a clinical prediction model capable of screening children aged 1 to 6 - explicitly extending prior work that had examined play behaviours alone. Directional hypotheses were stated in advance, including the prediction that repetitive behaviour frequency would not differ between groups because the session would be too short for it to emerge. The findings: autistic children showed less functional and less imaginative play, and reduced eye contact, facial expression and vocalisation. Restricted and repetitive behaviours did not separate the groups, exactly as predicted - the reported odds ratios for stereotyped language use, repetitive hand and body movements and unusual sensory seeking are numerically enormous with confidence intervals spanning zero to infinity and p-values near 1, the signature of behaviours almost never observed in a 90-second window. Stepwise regression retained five predictors, all in the protective direction: duration of socially oriented vocalisations (OR 0.940), total counts of functional play (OR 0.639), and play time with miniature or representational toys (OR 0.985), cause-and-effect toys (OR 0.973) and construction toys (OR 0.958). The nomogram reached AUC 0.826 (95% CI 0.776-0.877) with sensitivity 85.4% and specificity 68.3% at a cut-off of 0.399. The confirmed negative prediction about repetitive behaviour is worth as much as the positive findings: it demonstrates that the task samples the social-communication and play dimensions of the phenotype and not the restricted-repetitive dimension, which bounds what any model built on it can claim to detect." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-124" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two hundred and forty-six children aged 1 to 6, recruited in Beijing between January and August 2022 in a matched 1:1 design: 123 autistic (105 male, 18 female, mean age 54.0 months, SD 9.9) and 123 typically developing (103 male, 20 female, mean age 51.1 months, SD 13.5). The autistic children came from a hospital and from autism intervention service centres; the comparison children from a local kindergarten. Groups were matched and formally tested on age (t(224.10) = 1.90, p = 0.0591) and sex (chi-square = 0.031, p = 0.860), and separated on severity as expected (median CARS-2 37.0 against 15.0, Z = -13.90, p < 0.001). Two sample-definition decisions shape what the study can show. Children with current or previous psychiatric diagnoses other than autism, major physical or neurological disease, or any prior psychotropic medication were excluded, which produces an uncomplicated autism group at the cost of representativeness. And 23 children who met clinical criteria but scored below 30 on CARS-2 were removed, so the autistic group is restricted to the more clearly affected end of the spectrum - a restriction the authors identify themselves and connect explicitly to performance inflation. The unit of analysis is the child throughout, with one 81-dimensional indicator vector each." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-124" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No sensor fusion - a single camera supplies everything. But the final model combines information across behavioural channels rather than within one: duration of socially oriented vocalisations from the communication channel together with four measures of functional play from the object-manipulation channel, one of them a count and three of them durations resolved by toy type. That cross-channel structure is meaningful. It says that neither the social nor the play dimension alone accounted for the group difference in the stepwise selection, and it aligns with the clinical description of autism better than a single-channel model would. The play predictors also carry an internal ordering worth noting: total counts of functional play has by far the strongest odds ratio (0.639), while the three toy-specific durations sit close to 1 per unit of time (0.985, 0.973, 0.958), so the discriminative work is done mainly by how often a child engages in functional play at all rather than by how long any particular episode lasts." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-124" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Published 2024 by the Peking University Sixth Hospital group - NHC Key Laboratory of Mental Health and the National Clinical Research Center for Mental Disorders - together with authors from ALSOLIFE, a Beijing autism-services company, with no external funding and two patent applications declared by six of the eleven authors. The framing is developmental and clinical rather than technological: play is introduced as a meaningful activity in its own right that supports quality of life, social inclusion and later friendships, and the argument for using it as a measure is that the core traits of autism naturally manifest there. The intended contribution is a time- and cost-efficient screening aid that could 'remove the geographic barriers' to early identification. For this review the study is valuable on four counts. It has the most complete clinical characterisation of any behavioural study charted here - real DSM-5 best-estimate diagnosis by psychiatrists, CARS-2 corroboration with cited psychometrics, deliberate matching on age and sex with tests reported, and comorbidity and medication handled by explicit exclusion. It demonstrates what a brief observation can and cannot access: the social-communication and play dimensions separated the groups while the restricted-repetitive indicators were statistically degenerate in 90 seconds, confirming a hypothesis the authors stated in advance and bounding what every short-observation study in this corpus can claim. It reports honest and modest performance - AUC 0.826, sensitivity 85.4%, specificity 68.3% - with calibration, predictive values and per-predictor confidence intervals, in a literature where accuracy alone above 95% is the norm. And its limitations section contains the clearest statement of spectrum truncation and its effect anywhere in this review: children below CARS-2 30 were excluded, 'consequently, the performance of the clinical prediction model may be overestimated'. Two cautions travel with it. The five predictors were selected from 81 candidates and the operating threshold from the same ROC curve, all on the development sample, so the reported figures are apparent rather than validated, and the bootstrap that was run is not reported as an optimism correction. And the screening claim rests on predictive values computed at the matched 50% prevalence; at any realistic base rate a specificity of 68.3% would make most positive calls false, which is the calculation that determines whether this tool is deployable in the settings its authors envisage." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-124" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The weakest link in an otherwise carefully executed study, and instructive precisely because everything upstream is done well. Eighty-one indicators were reduced by group-difference testing and clinical judgement, then by univariate logistic regression, then by stepwise logistic regression, and the resulting five-predictor model's AUC, sensitivity, specificity and predictive values were computed on the same 246 children that drove every one of those selection steps. The operating threshold of 0.399 was likewise read off that same ROC curve. Selecting five predictors from 81 candidates on 123 events produces substantial optimism, and the standard remedy - bootstrap resampling that repeats the entire selection procedure within each resample to yield an optimism-corrected estimate - was partially performed but not reported that way: the bootstrap is described as validating the model, and the calibration curve and Hosmer-Lemeshow test address probability calibration and fit rather than out-of-sample discrimination, so no corrected AUC appears anywhere. There is no held-out set, no cross-validation and no external cohort. What makes this worth stating carefully is that the study's other validity properties are unusually sound - the split unit is the child throughout with no possibility of within-participant leakage, the diagnosis is a real clinical best-estimate judgement rather than a questionnaire threshold, the groups are matched and tested on age and sex, the comparison prediction about repetitive behaviour was made in advance and confirmed, and the authors themselves identify spectrum truncation as a source of performance inflation. The likely direction of error is therefore known and the likely magnitude is modest by this corpus's standards: an AUC of 0.826 with sensitivity 85.4% and specificity 68.3% is a plausible figure for this task, and the paper's own honesty about the CARS-2 floor points the same way. Two further items belong here. Coder blinding to group is not stated, and with autistic children recruited from hospitals and intervention centres and controls from a kindergarten, the recordings themselves may reveal group membership - which matters more in a human-coded study than in an automated one, because every one of the 81 indicators passes through a coder's judgement. And the predictive values that a screening claim depends on are quoted at the 50% prevalence of a matched design, with no recomputation for the base rate of any population in which the tool would be used." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-124" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Univariate logistic regression for candidate screening followed by stepwise logistic regression for model construction, with the result presented as a nomogram. No machine learning algorithm is used and none is needed - with 246 children, 123 events and 81 candidate predictors, a regularised or stepwise regression is the statistically appropriate choice, and the transparency it buys is substantial: five interpretable coefficients with odds ratios and confidence intervals, displayed in a form a clinician can read off a chart. The model is accompanied by a Hosmer-Lemeshow goodness-of-fit test (chi-square 15.329, p = 0.053), a bootstrap procedure and a calibration curve. This is prediction-model methodology as the clinical literature practises it, and it is markedly better matched to the data than the deep architectures applied to smaller samples elsewhere in this corpus. The methodological gap is not the algorithm but the evaluation: stepwise selection from 81 candidates, on the sample that then supplies the performance estimate, without an optimism-corrected figure." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-124" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A playroom, with the child seated at a table and an instructor beside them, preceded by 5-10 minutes of rapport building with warm-up toys that were then removed. The recruitment settings differ by group: autistic children from a hospital and autism intervention service centres in Beijing, comparison children from a local kindergarten. That asymmetry is the default arrangement across this literature and it carries two consequences the paper does not discuss. Children recruited through intervention services have by definition been identified and are receiving support, so they differ from a screening population in ways beyond diagnosis. And because the recording context is not identical across groups, an unblinded coder could plausibly infer group membership from the video independently of the behaviours being scored - a risk that matters here more than in automated studies, since every indicator originates in a human judgement." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-124" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "BMC Psychiatry 24:799, 2024, open access under CC BY-NC-ND 4.0; received 10 May 2024, accepted 30 September 2024, doi 10.1186/s12888-024-06129-9. A clinical psychiatry venue, and the difference from the engineering venues that dominate this corpus is visible throughout: the paper reports matching statistics and their tests, cites the psychometrics of its diagnostic instrument, describes coder training and inter-rater reliability, reports odds ratios with confidence intervals, tests calibration and goodness of fit, enumerates five limitations including its own selection bias, and supplies the full coding manual as supplementary material. It is comparably weak where clinical journals are typically weak: the statistical software is not named, the code is not available, the stepwise criterion is unstated and no optimism-corrected estimate is reported. The version under review is the blinded submission, with the recruiting hospital and ethics committee anonymised in the text." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-124" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The fullest metric reporting in the review's behavioural branch. AUC 0.826 with a 95% confidence interval of 0.776-0.877; sensitivity 85.4%; specificity 68.3%; positive predictive value 72.9%; negative predictive value 82.4%, all at a stated cut-off of 0.399; Hosmer-Lemeshow goodness of fit; a calibration curve relating predicted to observed probabilities; density plots for the retained indicators; and odds ratios with confidence intervals and p-values at both the univariate and multivariate stages for every indicator. Reporting discrimination, calibration, predictive values and per-predictor uncertainty together is what a prediction-model study should do and what almost no other paper in this corpus does. Three qualifications. The predictive values are computed at the 1:1 prevalence the matched design created; at a realistic screening base rate, a specificity of 68.3% would place the great majority of positive calls on non-autistic children, and this recalculation is exactly what the paper's screening proposal requires and does not perform. The reported AUC is apparent rather than optimism-corrected, despite a bootstrap having been run for that purpose. And the operating cut-off of 0.399 was chosen from the same ROC curve on which the sensitivity and specificity are then quoted, so that pair is a best-of-curve selection rather than a prespecified operating point." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-124" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A 90-second free play episode with a fixed toy set spanning miniature or representational toys, cause-and-effect toys and construction toys, preceded by 5-10 minutes of rapport building. The instruction is reproduced verbatim in the paper and is tightly specified: allow the child to explore and play independently for 90 seconds; do not initiate any conversation or interaction; respond appropriately and neutrally if the child initiates - if the child hands the examiner a toy, smile and say thank you but start no new conversation. This is a well-designed paradigm for its purpose. It is genuinely brief, it places almost no demand on the child, it requires no screen or instrumentation, and the examiner's role is constrained precisely enough to be reproducible. The authors state its cost in the same terms as its benefit: 1.5 minutes of child time and 10-15 minutes of coder time, against a session too short to elicit repetitive behaviours or to give the child an opportunity to initiate social interaction. Both halves of that trade-off are confirmed in the results - the play and communication indicators separate the groups while the restricted-repetitive indicators are degenerate - and the authors' proposed fix, lengthening the session and building in opportunities for initiation, follows directly." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-124" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The broadest behavioural coverage of any single task in this review. Nineteen behaviours were coded and expanded into 81 quantitative indicators of count, duration and proportion, spanning functional play, imaginative or symbolic play, eye contact, facial expression, vocalisations and verbalisations with a socially oriented subclass and a word-use subclass, stereotyped use of language, unusual and repetitive hand, body and limb movements, unusual restricted and stereotyped behaviours, and unusual sensory seeking. Play was further resolved by object category - miniature or representational toys, cause-and-effect toys, construction toys - so that play duration could be attributed to the kind of play the toy affords, and functional and imaginative play alone generated 18 of the 81 indicators. Behaviour form and function were coded alongside occurrence, and the timeline representation records overlap so that simultaneous behaviours can be identified. Two results from this breadth matter for the review. Only two behavioural families entered the final model - socially oriented speech and functional play with objects - so the informative signal is narrower than the coding scheme. And the restricted-repetitive indicators are statistically degenerate, with odds ratios in the millions and confidence intervals from zero to infinity, because these behaviours essentially did not occur in 90 seconds. That is a clean demonstration, made against a pre-registered prediction, that a brief structured play sample accesses the social-communication and play dimensions of the phenotype while leaving the restricted-repetitive dimension unobserved - a boundary that applies to every short-observation study in this corpus and is rarely made visible." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-124" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Notably careful, and the most consistent use of identity-first language in this corpus. The title and abstract say 'autistic children' and 'neurotypical children'; the body alternates between 'autistic children' and 'children with ASD' without the deficit-laden hedging common elsewhere. Differences are described as differences rather than as deficits - autism is 'a neurodevelopmental condition with distinct patterns in social interaction, communication, and repetitive behavior', autistic children 'often show differences in play development', and the core traits are 'distinct patterns in social interaction and communication, focused interests, and repetitive behaviors'. The opening frames play in terms of what it gives children rather than what it diagnoses: play 'can provide satisfaction and joy, promote quality of life, engender social inclusion, and foster better social outcomes and friendships later in life'. The literature review is also candid about disagreement, noting that 'some studies report no significant differences in symbolic and functional play' and treating the inconsistency as a reason for further work rather than something to be argued past. Two elements pull the other way: the coded behaviour set uses 'unusual' and 'abnormal' as category labels ('unusual sensory seeking behaviors', 'unusual and repetitive hand/body/limb movements', 'abnormal eye contact'), and no autistic person or community organisation is reported as involved in designing the coding scheme, choosing which behaviours count as targets, or interpreting the findings." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-124" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Intrinsic and complete, with no post-hoc machinery needed. The model is five logistic coefficients over directly observable quantities, each reported with an odds ratio and confidence interval, and displayed as a nomogram that a clinician can use by hand. Calibration between predicted and observed probability is plotted rather than asserted, density plots show the underlying distributions, and the full univariate-to-multivariate progression is tabulated so that a reader can see which candidates were considered and which survived. The substantive interpretation is coherent and clinically recognisable: reduced frequency of functional object play, reduced play time across all three toy categories, and less socially directed speech. This is one of the few models in the review whose output could be discussed with a family in ordinary language. Two interpretive gaps remain, both concerning what the coefficients might be measuring other than autism. Predicted probability is never related to CARS-2, so whether the model tracks severity or only group membership is untested on data already collected. And no age term appears in the model, although four of five predictors are quantities of object play in a sample spanning 1 to 6 years, where those quantities rise steeply with development and where the two groups' age distributions differ in spread even after matching on the mean." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-124" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "An 81-dimensional vector per child of counts, durations and proportions, derived arithmetically from human coding of a 90-second video with onset and offset times on a timeline. Every element is directly interpretable and directly auditable - a coder's judgement about a named behaviour, aggregated by a stated rule. The final representation is five numbers: one speech duration and four play quantities. The proportion indicators are a thoughtful design element, since normalising socially oriented vocalisations by total vocalisations, or word-use vocalisations by total vocalisations, separates the social direction of speech from the amount of speech - and indeed the proportional versions had the strongest univariate odds ratios in the vocalisation family (0.367 and 0.345). It is notable that stepwise selection nonetheless retained the raw duration measure rather than a proportion, which leaves the model's strongest predictor confounded with how much the child spoke at all, and thus with expressive language level, which was never measured." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-124" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Strong on the human protocol and thin on the computational one. Fully reported: recruitment sources and window, inclusion and exclusion criteria, the diagnostic procedure and CARS-2 threshold with the count excluded by it, group demographics with matching statistics, the verbatim task instruction including the examiner's response rule, the rapport-building preamble, the toy categories with definitions, the coder training programme - three coders with 3 months to 11 years of relevant experience, one month of training under the manual's authors with weekly review meetings, and an inter-coder consistency check in which all three independently coded the same 30 children, reaching 83.7-91.7% with the reliability formula given - the definitions of all 19 behaviours in a supplementary coding guide, all 81 indicators with definitions, and the complete univariate and multivariate regression output with odds ratios, confidence intervals and p-values. This is enough for another group to run the protocol. Not reported: the coding software, the statistical software, the stepwise selection criterion, the number of bootstrap resamples, and the optimism-corrected AUC that the bootstrap should have produced. Data are available from the corresponding author on request only, with the restriction attributed to data protection and the consent text." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-124" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Five limitations are enumerated and they are well chosen - three of them identify problems that most papers in this corpus leave to the reader. The 90-second task does not fully capture social interaction, communication or repetitive behaviours, and should be lengthened with opportunities for child-initiated interaction. The sample is predominantly male, limiting generalisability across gender-specific presentations. Children scoring below 30 on CARS-2 were excluded, 'which may have resulted in selection bias by including only those with more pronounced characteristics of autism. Consequently, the performance of the clinical prediction model may be overestimated' - a statement of spectrum truncation and its effect on performance that is more direct than anything else in this review. The sample is small for prediction-model development and both the coding scheme and the model need further reliability and validity evaluation across age groups, language levels and presentations. And only autistic and typically developing groups were compared, whereas 'in the real clinical setting, it is more challenging to distinguish ASD children from non-ASD children, such as those with IDD, than distinguish ASD children from TD children'. What is missing is the optimism arising from the analysis itself: five predictors were selected from 81 candidates using the same 246 children whose data yield the reported AUC, sensitivity and specificity, and the operating cut-off was chosen from the same ROC curve, so the headline figures are apparent performance and no optimism-corrected estimate is reported although a bootstrap was run. Also unaddressed: predictive values are quoted at the matched 50% prevalence with no recalculation for a screening base rate; no language or cognitive measure exists although the strongest predictor is socially directed speech; age is matched at the mean but not adjusted for, in a 1-to-6-year sample where four of five predictors are play-quantity measures; the recruitment asymmetry between clinical services and a kindergarten is not discussed; and coder blinding to group is not stated." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-124" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Keywords: free play, autism, digital behavioral feature, prediction model, screening. The set is well chosen and unusually balanced - one term for the paradigm, one for the population, one for the data representation, one for the method and one for the intended use - which makes the paper findable from either a clinical or a computational search, unlike the method-only keyword sets typical of the engineering venues in this corpus. The phrase 'digital behavioral feature' is worth flagging as a term of art: the features are digital in the sense of being quantified and machine-readable, but they are produced by human coders, not by any automated recognition system." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-124" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional with a single session, no follow-up and no test-retest. The absence of repeat measurement matters for a proposed screening instrument built on a 90-second sample of a young child's behaviour, since day-to-day variation in a toddler's play is substantial and unquantified here. Ethics reporting is complete: approval by the institute's ethics committee (anonymised in this version for blind review), conformity with the 1964 Declaration of Helsinki, and written informed consent from primary caregivers before the study began. The competing-interest declaration is more informative than most and deserves recording: six of the eleven authors declare two patent applications arising from this research (202310300588.1 and 202310315701.3) while five declare none, and four authors are affiliated with ALSOLIFE, a Beijing autism-services company, alongside the Peking University Sixth Hospital group. The paper states it received no funding of any kind. The patents are declared without their claims being described, which is the relevant detail when the paper proposes the coding scheme and model as a deployable clinical tool." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-124" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Age and sex are reported per group with formal matching tests, severity is reported with a group comparison, and comorbidity and medication are controlled by explicit exclusion criteria - a considerably fuller demographic account than most of this corpus. What is absent is cognitive and language level, and that absence is consequential rather than incidental. The strongest single predictor in the final model is the duration of socially oriented vocalisations and verbalisations, and the candidate pool contained counts and proportions of vocalisations using words; without an expressive language measure, a group difference in language level cannot be separated from a group difference in the social orientation of speech. The age matching also deserves a closer reading than the p-value alone gives it. The means differ by 2.9 months at p = 0.0591, but the standard deviations differ substantially (9.9 against 13.5), so the distributions are not the same shape - and in a sample spanning 1 to 6 years, functional and imaginative play increase steeply with age. Four of the five retained predictors are quantities of object play, and the model does not adjust for age, so part of what the nomogram encodes may be developmental level rather than autism. Socioeconomic status, ancestry and parental education are not reported, and the sample is drawn entirely from Beijing." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-124" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Among the stronger reference standards in this review. Diagnosis was made by senior child and adolescent psychiatrists as a best-estimate clinical judgement against DSM-5 criteria, corroborated by CARS-2 with the instrument's psychometric properties cited from the literature (internal consistency 0.93, meta-analytic alpha 0.90, sensitivity 88%, specificity 86%). The corroboration is real clinical assessment rather than a questionnaire threshold standing in for one, and it is applied by clinicians qualified to make it. Two qualifications matter. First, the CARS-2 floor of 30 was applied as an exclusion: 23 children with a clinical diagnosis but a score below 30 were removed from the study. This converts the reference standard from 'clinically diagnosed autism' into 'clinically diagnosed autism of at least moderate severity', truncating exactly the part of the spectrum on which a screening tool would be hardest and most useful. The authors state the consequence directly - selection bias toward more pronounced characteristics, with the model's performance therefore possibly overestimated - which is the correct inference and one that few papers here draw about their own inclusion rules. Second, whether the video coders knew each child's group is not stated, and because the autistic children were recruited from hospitals and intervention centres while controls came from a kindergarten, group membership may have been inferable from the recordings independently of any behaviour coded." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-124" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "CARS-2 total is the only clinical measure and it does three jobs: it corroborates diagnosis, it gates inclusion at a score of 30, and it characterises the groups (median 37.0, IQR 33.5-41.5 against 15.0, IQR 15.0-15.5; Z = -13.90, p < 0.001). What it is not used for is the analysis that the data would support and that this review has repeatedly found missing: relating CARS-2 to the model's predicted probability. That correlation would test whether the nomogram tracks a continuous severity dimension or only the group boundary, and it is a stronger validity check than any of the internal statistics reported. No cognitive, adaptive or language measure was obtained for either group, and no developmental level was recorded - which, in a study whose predictors are quantities of object play across ages 1 to 6, leaves developmental maturity as an unmeasured competitor to the autism explanation." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-124" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Minimal and deliberately so: a video camera in a playroom and a fixed set of physical toys. No sensor, screen, wearable or eye tracker is involved. That is the design's practical argument - the equipment barrier to using this protocol in a clinic or kindergarten anywhere is a camera and a box of toys, which is lower than for any other included study except the population health-records analysis. The cost is transferred to the analysis: 10-15 minutes of trained-coder time per 90-second video, which is where the scalability constraint now sits, and which is why the authors describe the coding scheme as 'a feeding database with low granularity for automatic behavior recognition through machine learning in the future'. Neither the coding software nor the statistical software is named." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-124" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:study_design "Prospective case-control diagnostic prediction-model development study, with internal bootstrap validation and calibration assessment, reported in nomogram form" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: ; comparison: 123 typically developing children (103 male, 20 female), median CARS 15.0" ] ] ;
