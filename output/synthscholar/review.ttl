            slr:screening_stage "title_abstract" ],
        [ a prov:Activity,
                slr:ScreeningDecisionRecord ;
            dcterms:title "A multimodal discrimination method for the response to name behavior of autistic children based on human pose tracking and head pose estimation" ;
            bibo:pmid "local_c6853fe2" ;
            slr:assessed_on "full_text" ;
            slr:decision "include" ;
            slr:decision_rationale "Borderline, included on the severity-estimation limb of the eligibility criteria and flagged as a boundary case in the charting. The system's output is a judgement of whether a child responded to their name within 3 s of each call, aggregated into the 0-5 score that constitutes an ADOS-2 response-to-name item, with the clinician's score for that item as the reference. That is quantification of a symptom on a standardised diagnostic instrument, which falls inside 'severity-estimation target' as pre-specified for this review, and it is a genuine computational pipeline (iFlytek ASR for name-call timestamps, YOLOv3 person detection trained on the study's own images, HRNet pose estimation, OSNet re-identification for multi-object tracking, OpenFace head pose, then a rule-based decision on shoulder rotation angle, head yaw and frame counts). It is charted with three explicit caveats recorded throughout: the sample of 29 autistic children and 1 typically developing child cannot support any diagnostic discrimination claim; the abstract's phrase 'consistency between our proposed method and clinical diagnosis' refers to agreement with the clinician's response-to-name score, not with the autism diagnosis; and the authors themselves state that 'our experiment is an assessment of the response to name, not an assessment of autism risk'. Retaining it lets the review chart the distinct and under-represented category of automated administration and scoring of individual diagnostic-instrument items." ;
            slr:full_text_source "user_supplied_pdf" ;
            slr:screening_stage "full_text" ],
