                    slr:judgment "high" ;
                    slr:supporting_quote "An 80:20 image-level split with no cross-validation, no separately described validation partition, the number of distinct children unreported, and augmentation ordering relative to splitting unstated." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Whole face images from two sources with different cameras, lighting and photographic conventions, with the paper naming skin texture among the features used. Contrast-adjustment augmentation partially normalises one such property; no source-wise analysis tests whether a source signal remains." ],
                [ a slr:RoBDomainJudgment ;
