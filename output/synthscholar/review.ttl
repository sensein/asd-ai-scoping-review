<urn:slr:article:bac568bd991f> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Autism Spectrum Disorder (ASD) presents as a neurodevelopmental condition impacting social interaction, communication, and behavior, underscoring the imperative of early detection and intervention to enhance outcomes. This paper introduces a novel approach to ASD detection utilizing facial features extracted from the Autistic Children Facial Dataset. Leveraging transfer learning models, including VGG16, ResNet, and Inception, high-level features are extracted from facial images. Additionally, fine-grained details are captured through the utilization of handcrafted image features such as Histogram of Oriented Gradients, Local Binary Patterns, Scale-Invariant Feature Transform, PHASH descriptors. Integration of these features yields three distinct feature vectors, combining image features with VGG16, ResNet, and Inception features. Subsequently, multiple machine learning classifiers, including Random Forest, KNN, Decision Tree, SVM, and Logistic Regression, are employed for ASD classification. Through rigorous experimentation and evaluation, the performance of these classifiers across three datasets is compared to identify the optimal approach for ASD detection. By evaluating multiple classifiers and feature combinations, this work offers insights into the most effective approaches for ASD detection." ;
    dcterms:bibliographicCitation "Sarwani IS; Bhaskari DL; Bhamidipati S (2024). Emotion-based Autism Spectrum Disorder Detection by Leveraging Transfer Learning and Machine Learning Algorithms. *International Journal of Advanced Computer S*." ;
    dcterms:creator "Bhamidipati S",
        "Bhaskari DL",
        "Sarwani IS" ;
    dcterms:title "Emotion-based Autism Spectrum Disorder Detection by Leveraging Transfer Learning and Machine Learning Algorithms" ;
    bibo:pmid "local_948fa8d0" ;
    fabio:hasPublicationYear 2024 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Participant selection and spectrum representativeness" ;
                            slr:justification "No participants and no selection process; 1,468 photographs of unknown provenance in the autistic class, with the number of distinct children unknown and no demographic or clinical information available." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Handling of missing data and attrition" ;
                            slr:justification "No quality assessment of any kind - no resolution, compression, capture-condition or per-class image-property comparison." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Comparison group adequacy" ;
                            slr:justification "The contents of a 'non_autistic' directory, with no screening and no verification, drawn from a different source population than the autistic class." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Confounder control" ;
                            slr:justification "Image provenance is confounded with the label by the dataset's construction, and the handcrafted feature set is composed of descriptors that respond directly to the imaging properties provenance determines. No analysis addresses this." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Reference standard quality" ;
                            slr:justification "The label is the name of the folder an image was filed in." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Index test definition and prespecification" ;
                            slr:justification "Twenty model-condition combinations with the maximum reported, no hyperparameters, no prespecified operating point." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Outcome measurement blinding" ;
                            slr:justification "Feature extraction and classification are automated from image files." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Measurement standardisation" ;
                            slr:justification "None is possible; photographs of unknown origin captured under unknown conditions, with the two classes drawn from different sources." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Data splitting and leakage control" ;
                            slr:justification "No split, cross-validation or holdout is described anywhere, and the image-to-child mapping is unknown so partition integrity could not be established in any case." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Sample size adequacy for the modelling" ;
                            slr:justification "2,936 images of unknown provenance and unknown child count, with 3,315-dimensional feature vectors and no stated evaluation." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Preprocessing and feature selection nesting" ;
                            slr:justification "Not assessable, since no evaluation partition exists relative to which preprocessing could be nested." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Performance estimation and chance level" ;
                            slr:justification "Twenty accuracy figures reported with no stated protocol for computing them, no confidence intervals, no confusion matrices, no AUC and no chance baseline despite a balanced design." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Reporting of results and uncertainty" ;
                            slr:justification "Precision, recall, F1 and accuracy for twenty combinations, but with precision, recall and F1 almost always identical to the percentage point and no confusion counts to verify them, no confidence intervals, no AUC, and no basis for interpreting what the figures estimate." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Ethics, consent and conflicts" ;
                            slr:justification "No ethics approval, no consent, no funding declaration and no competing-interests statement, for a study built on photographs of identifiable children obtained without consent in which one class was assembled because those images appeared in autism contexts." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Data, code and protocol availability" ;
                            slr:justification "No code, no dataset identifier or version, no split specification, no preregistration." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Acknowledgement of limitations" ;
                            slr:justification "No limitations section and no constraint acknowledged anywhere." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Completeness of methods reporting" ;
                            slr:justification "Feature extraction is narrated in step-by-step procedural detail with exact feature counts for all eight families, while the evaluation protocol - the one element that determines whether the results mean anything - is omitted entirely. No dataset identifier, hyperparameters, seed or code." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. Pretrained VGG16, ResNet and Inception networks used as fixed feature extractors with fully connected layers excluded, and five classical classifiers. No hardware, software package, version or hyperparameter is reported. The imaging characteristics of the source photographs - the properties that differ between the two source collections and that HOG, LBP, PHASH and SIFT are designed to capture - are neither reported nor examined." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-116" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The stated aim is to improve autism detection accuracy from facial images by combining transfer-learned deep features with handcrafted image descriptors, and to identify the best classifier and feature combination. Findings: handcrafted features alone gave 78.0-84.5% across five classifiers, with random forest best; adding ResNet features raised the range to 84.4-90.2%, with SVM best; and adding Inception features gave 83.2-94.6%, with SVM best at 94.6%. The reported progression - handcrafted alone, then fused with each backbone - is a systematic ablation and is the paper's substantive content. What it cannot establish is what the improvement means, because no evaluation protocol is stated: the words 'split' and 'validation' appear nowhere, no cross-validation is described, and no train-test partition is specified for any of the eighteen reported accuracies. Whether these are held-out figures, training figures, or something else is not determinable from the paper." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-116" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A 3,315-dimensional concatenation per image: 3,000 activations from one backbone plus 100 HOG, 50 LBP, 50 ORB, 65 PHASH and 50 SIFT features. The handcrafted component is worth characterising because it determines what a source-provenance confound would look like. HOG encodes gradient distributions, which depend on image sharpness; LBP encodes local texture, which depends on resolution and compression; PHASH is a whole-image fingerprint, which encodes global tone and layout; SIFT and ORB encode keypoint structure, which depends on contrast and focus. Every one of these is a property of the photograph rather than of the face, and all differ systematically between images collected from different sources. That this feature set alone achieves 84.5% is therefore the paper's most diagnostic result, and it is reported without comment." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-116" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Absent. The labels are the names of two subdirectories in a downloaded folder, and the methods section describes exactly this: features are extracted 'by traversing through the directory structure', with 'a label column added to denote the class label (autistic or non_autistic)'. No diagnosis, instrument, criterion, clinician or verification underlies either class. The quantity the models predict is therefore which folder an image was filed in, and given that the folders were populated from different parts of the internet, the reported accuracies are best read as measures of how distinguishable the two source collections are as image sets." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-116" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "'Autistic children' and 'non-autistic children', person-first in most constructions but with 'normally developing youngsters' appearing when summarising prior work. The clinical description in the introduction is drawn accurately from DSM criteria and is comparatively careful - reduced sharing of emotions and interests, deficits in social-emotional reciprocity, difficulty adapting behaviour to social contexts, difficulty making friends. The framing of purpose includes an unusual note: technological advancement is described as 'a blessing to the parents who are clueless about managing the condition', which positions the work as parent-facing. There is no neurodiversity framing and no autistic-community involvement - a notable absence given that the dataset's autistic images were collected from autism-focused online spaces created by and for that community. The premise that 'autistic children show distinctive patterns' in facial and emotional expression is asserted without citation to any evidence about facial morphology." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-116" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. There is no task, protocol or elicitation - the data are photographs. The framing gap is worth stating plainly: the title announces 'Emotion-based Autism Spectrum Disorder Detection' and the introduction argues that 'facial expressions and emotional expressions can help in early detection and diagnosis of ASD', but no expression is labelled, detected, elicited or analysed anywhere in the paper. The features extracted are generic image descriptors, and the classification target is the image's folder. The word 'emotion' does not recur in the method, results or conclusion. So the study measures no behaviour at all while describing itself as behavioural, which places it further outside this review's modality scope than the companion study on the same dataset, that one at least having attached a genuine facial-expression module trained on AffectNet." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-116" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Three ImageNet-pretrained backbones used as fixed feature extractors with fully connected layers excluded, and five classical classifiers - random forest, k-nearest neighbours, decision tree, SVM and logistic regression - applied to each of four feature conditions, giving twenty reported model-condition combinations of which eighteen are tabulated. The design is a systematic grid rather than a single proposed model, which is reasonable for a comparison study. No hyperparameters are reported for any classifier, and no rationale is given for the choice of backbones or descriptors beyond their being commonly used." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-116" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional in the trivial sense. No ethics statement, consent, funding declaration or competing-interests statement appears anywhere. As with the companion study, the dataset consists of identifiable photographs of children obtained without their families' knowledge, with one class assembled specifically because those images appeared in autism contexts - so the collection asserts a health status about identifiable minors, and training and publishing on it propagates that assertion. None of this is acknowledged." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-116" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Keywords: Autism Spectrum Disorder; transfer learning; image features; VGG; ResNet; Inception. Five of six name architectures or feature types; no behavioural, clinical or application term appears. The title's 'Emotion-based' has no counterpart in the keywords, the method or the results, and is the paper's clearest instance of behavioural vocabulary applied to non-behavioural work." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-116" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No study setting. Work was performed on a downloaded Kaggle dataset at two universities in Visakhapatnam, India, with no contact with any participant and no acquisition of any kind." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-116" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "International Journal of Advanced Computer Science and Applications 15(5), 2024, pages 566 onwards - a general computer-science journal published by The Science and Information Organization, outside the clinical and biomedical literature. The venue accounts for the reporting profile: extensive procedural description of feature extraction, a large comparison grid, and no ethics, funding, competing-interests or limitations statement. It does not account for the absence of an evaluation protocol, which is a scientific rather than a formatting omission." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-116" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None proposed. The conclusion restates the method and the comparison without identifying any next step." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-116" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "There is no limitations section and no constraint is acknowledged. The unaddressed problems are the same as for the companion study on this dataset, plus one that is specific to this paper. The dataset's two classes come from different internet sources, so image provenance is confounded with the label - and here the confound is sharper than usual, because five of the eight feature families are handcrafted descriptors that respond directly to gradient structure, texture, keypoint density and perceptual hashing, all of which are functions of resolution, sharpness, compression and lighting rather than of anything about the child. That the handcrafted features alone reach 84.5% is therefore not evidence that facial morphology is informative; it is equally consistent with the two collections being distinguishable as image sets. No diagnostic verification exists for either class. The number of distinct children is unknown. No demographic data are available. Eighteen classifier-feature combinations were evaluated and the maximum reported. And, uniquely among included studies, no evaluation protocol of any kind is described." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-116" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None, and none is possible. No severity, cognitive, language or adaptive information exists for any image." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-116" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. No feature importance, saliency map, activation visualisation, error analysis or example inspection appears for any of the eighteen combinations. The absence is decisive rather than incidental in this design, because the study's own results contain the material for an interpretability check it does not perform: handcrafted descriptors sensitive to image quality reach 84.5% alone, and a single analysis of which descriptors carry that performance - or a single visualisation of what distinguishes the two classes - would establish whether the model responds to faces or to photographs." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-116" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "There are no participants - 2,936 facial photographs from a Kaggle collection, evenly divided at 1,468 per class, described only as colour images of autistic and non-autistic children. The number of distinct children behind them is unknown and unrecoverable. This is the same publicly scraped 'Autistic Children Facial Dataset' already charted in this review in a companion study which used a 2,836-image version, and the two counts imply different snapshots of a dataset that has been revised. The companion study documents the provenance that this one does not mention: autistic images sourced from online platforms focused on autism, non-autistic images gathered separately from the internet." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-116" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Published 2024 by the Department of Computer Science and Systems Engineering at Andhra University with the Department of Applied Psychology at GITAM Deemed to be University, Visakhapatnam. The framing is early detection and parental support, with the observation that diagnosis 'depends predominantly on the aberrations in the functioning of the brain that may not surface in the very early stages' and that technology has been 'a blessing to the parents who are clueless about managing the condition'. The presence of a psychology co-author makes the absence of any diagnostic verification, demographic reporting or ethical consideration more striking rather than less. For this review the study's value is entirely as a second data point on the facial-photograph branch of the literature, and it strengthens three observations already recorded from the companion study on the same dataset. The branch is not small - two independent groups publishing in the same year on the same scraped collection, with a literature review here citing at least half a dozen further examples using facial images, MobileNetV2, EfficientNet and hybrid vision transformers at accuracies from 88% to 92.5%. Its reported accuracies are comparable to or higher than the best-conducted studies in this review, so accuracy in this literature does not order studies by evidential quality. And its methodological reporting can omit the evaluation protocol entirely without that omission preventing publication - which is the strongest available evidence that peer review in this branch is not filtering on the properties that determine whether a number means anything." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-116" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None is measured. The paper's framing is behavioural - emotion, facial expression, distinctive patterns shown by autistic children - and its method is not. HOG captures gradient orientation distributions, LBP captures local texture, ORB captures keypoints and their descriptors, PHASH computes a perceptual fingerprint of the whole image, SIFT detects scale-invariant local features, and the three backbones supply generic ImageNet activations. None of these is a measure of expression, movement or any behaviour, and no expression labels exist in the dataset. For the review this study marks the far end of a boundary the companion paper already approached: automated autism detection that has left behaviour behind entirely while retaining behavioural vocabulary." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-116" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None whatsoever - no age, sex, race, ethnicity, socioeconomic status, cognitive level, language, comorbidity or severity data for any image, and no statement that such information is unavailable. The paper does not report even the age range that the dataset's own description carries. As with the companion study, the omission is consequential because the two classes were assembled from different internet sources, and autism-focused online spaces will differ from general internet image collections in the demographics they represent as well as in photographic convention." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-116" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Fusion within a single modality and across feature families, systematically ablated. Three feature vectors are constructed, each concatenating the same 315 handcrafted features with one backbone's 3,000 deep features, and results are reported for the handcrafted set alone and for each fused vector across five classifiers. The ablation shows a consistent gain from adding deep features - best accuracy rising from 84.5% with handcrafted features alone to 90.2% with ResNet and 94.6% with Inception - which is a clean comparison and is the paper's only methodological contribution. Its interpretability is destroyed by the absence of an evaluation protocol: without knowing how the accuracies were computed, the gain cannot be attributed to better representation rather than to greater capacity to fit the data." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-116" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Curiously uneven. The feature-extraction pipeline is described at unusual procedural length, narrating library imports, directory traversal, per-image processing, DataFrame construction, label-column addition, merging and CSV export, with exact feature counts tabulated for all eight families. The evaluation is described not at all. A reader is given enough to reconstruct how a 3,315-dimensional feature vector was built and nothing whatever about how the reported accuracies were computed. Also absent: the Kaggle dataset identifier and version, any classifier hyperparameters, any seed, and code." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-116" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Precision, recall, F1 and accuracy, reported as whole percentages for five classifiers across four feature conditions. The set is nominally adequate, but three problems undercut it. Precision, recall and F1 are reported as identical values to the percentage point in almost every row, which for a balanced binary problem is arithmetically possible but is presented without the confusion counts that would let a reader verify it. No AUC, confusion matrix or confidence interval appears. And most fundamentally, no evaluation protocol is stated, so it is not determinable what population any of these numbers estimates - they may be held-out, resubstitution, or cross-validated figures, and the paper provides no basis for choosing between those readings." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-116" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "There is no validation strategy. This is not a case of an inadequate or leaky protocol but of no stated protocol at all: the words 'split' and 'validation' do not occur in the paper, no cross-validation is described, no holdout proportion is given, and no resampling scheme is mentioned, yet twenty accuracy figures are tabulated across four feature conditions and five classifiers. The methods section narrates the feature-extraction pipeline in step-by-step detail down to CSV export and then moves directly to results. Consequently none of the reported numbers can be interpreted as an estimate of performance on unseen data, and the comparison the paper is built around - handcrafted versus fused features, and among the three backbones - cannot be evaluated either, since a resubstitution comparison would favour the higher-dimensional representations regardless of their generalisation. Beneath this sits the same structural problem as in the companion study on this dataset: the two classes were assembled from different internet sources, so no split, however constructed, could separate a model that has learned about faces from one that has learned about photographs; and the number of distinct children is unknown, so images of one child may fall on both sides of any partition undetectably." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-116" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:study_design "Secondary computational analysis of a scraped public image dataset; a feature-family and classifier comparison, crossing three transfer-learning backbones and five handcrafted desc…" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: ; comparison: 1,468 images" ] ] ;
