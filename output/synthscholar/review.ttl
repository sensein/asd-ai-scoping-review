    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "The algorithm is locked before the evaluation data are collected, applied to data obtained independently of its developers, with results blinded until data collection is complete. Two five-minute games on a consumer tablet, no examiner rating anywhere in the chain, and no verbal demand on the child." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "Clinical diagnosis on DSM-5 or equivalent ICD-10 criteria, made independently of the study, supplemented for both clinical cohorts by the Strengths and Difficulties Questionnaire, the ESSENCE Questionnaire and an adaptive behaviour scale." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "Prospective design with each child assessed once, the index test applied blind to diagnosis, and results embargoed until collection closes. No results are reported, so execution cannot be assessed." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "Prospective multi-site recruitment across two countries through NHS specialist services, children's centres, nurseries and schools, with a planned 760 children in three prespecified cohorts, full inclusion and exclusion criteria tabulated, and a tightly bounded age window of 30 months to 5 years 11 months. The one residual concern is that recruitment via specialist services and existing diagnoses will not permit direct estimation of predictive value at population prevalence." ] ;
            slr:overall_judgment "low" ;
            slr:tool_used "QUADAS-2" ] .

<https://doi.org/10.1145/3192714.3192819> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "The ASD diagnosis requires a long, elaborate, and expensive procedure, which is subjective and is currently restricted to behavioural, historical, and parent-report information. In this paper, we present an alternative way for detecting the condition based on the atypical visual-attention patterns of people with autism. We collect gaze data from two diﬀer­ ent kinds of tasks related to processing of information from web pages: Browsing and Searching. The gaze data is then used to train a machine learning classiﬁer whose aim is to distinguish between participants with autism and a control group of participants without autism. In addition, we ex­ plore the eﬀects of the type of the task performed, diﬀerent approaches to deﬁning the areas of interest, gender, visual complexity of the web pages and whether or not an area of interest contained the correct answer to a searching task. Our best-performing classiﬁer achieved 0.75 classiﬁcation ac­ curacy for a combination of selected web pages using all gaze features. These preliminary results show that the diﬀerences in the way people with autism process web content could be used for the future development of serious games for autism screening. The gaze data, R code, visual stimuli and task de­ scriptions are made freely available for replication purposes." ;
    dcterms:bibliographicCitation "Yaneva V; Ha LA; Eraslan S; Yesilada Y; Mitkov R (2018). Detecting Autism Based on Eye-Tracking Data from Web Searching. *Proceedings of the 15th International Web for All Conference*. https://doi.org/10.1145/3192714.3192819" ;
    dcterms:creator "Eraslan S",
        "Ha LA",
        "Mitkov R",
        "Yaneva V",
        "Yesilada Y" ;
    dcterms:title "Detecting Autism Based on Eye-Tracking Data from Web Searching" ;
    bibo:doi "10.1145/3192714.3192819" ;
    bibo:pmid "local_54954c19" ;
    fabio:hasPublicationYear 2018 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are comparison groups matched?" ;
                            slr:justification "No formal matching or testing, but age and gender are close; education differs by 2.3 years without discussion." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are participants and recruitment adequately described?" ;
                            slr:justification "Recruitment routes, exclusion criteria, ages, gender, education, web-use frequency and stimulus familiarity all reported, along with every exclusion and the class-balancing removal." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is control status adequately established?" ;
                            slr:justification "Autism Quotient screening with an explicit threshold and a stated clinical rationale." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the sample appropriate and adequate for the stated target?" ;
                            slr:justification "30 high-functioning computer-using adults; the authors note the sample is small and that the task cannot reach young children." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "some concerns" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the reference standard appropriate and independently applied?" ;
                            slr:justification "Diagnosis verified by the recruiting charity with no instrument or criteria named." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are predictors defined without knowledge of outcome?" ;
                            slr:justification "Gaze features are computed automatically within algorithmically or geometrically defined AOIs." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are stimulus confounds controlled?" ;
                            slr:justification "Page order randomised per participant, task order counterbalanced, visual complexity manipulated by design, and prior familiarity with each site surveyed and confirmed low." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the behavioral data acquisition described reproducibly?" ;
                            slr:justification "Eye tracker model and specifications, monitor, viewing distance control, calibration, task durations, randomisation, counterbalancing and the full question set are all published, and the stimuli are released." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "some concerns" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the effect of design choices tested rather than assumed?" ;
                            slr:justification "Task type, AOI definition scheme, feature set, page subset, gender and visual complexity are all systematically varied and reported." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the validation participant-independent?" ;
                            slr:justification "100 folds with 10 training and 5 test participants per group; no test participant's data is ever used for training." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is there external or independent validation?" ;
                            slr:justification "None; single cohort and apparatus." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is uncertainty quantified?" ;
                            slr:justification "95% confidence intervals reported for every accuracy in every table." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is model capacity appropriate to sample size?" ;
                            slr:justification "Logistic regression on a small handcrafted feature set, chosen after comparing several algorithms." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "low" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the dataset accessible or its access conditions stated?" ;
                            slr:justification "Gaze data, code, stimuli and task descriptions released at a named public repository, with replicability listed as a stated contribution." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is code available?" ;
                            slr:justification "R code released in the same repository." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are limitations discussed?" ;
                            slr:justification "A dedicated Limitations subsection covering accuracy gap, unsuitability for young children, and sample size." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are results reported without inflation?" ;
                            slr:justification "0.75 reported plainly and compared unfavourably against fMRI classifiers, with all weaker configurations also reported." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are ethics, consent and prospective ethical risk addressed?" ;
                            slr:justification "Named ethics committee approval before collection, signed consent, debriefing, and an unprompted warning about the ethical implications of profiling conditions from web behaviour." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "low" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "ASD n=15 analysed (9 male, 6 female), mean age 37 +/- 9.14 years, mean 16 +/- 3.33 years of formal education. Control n=15 analysed (8 male, 7 female), mean age 33.66 +/- 8.6 years, mean 18.35 +/- 2.47 years of formal education. No formal matching procedure or comparability test is reported, though age and gender are close in practice. At 40% and 47% female, this is by a wide margin the most gender-balanced sample in the corpus - most comparable studies are 80-90% male. Adults only, and the authors explicitly acknowledge that web tasks are unsuitable for the young children where early detection would matter most. Education differs by about 2.3 years in the controls' favour, which is not discussed." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-015" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Single modality. Gaze features are combined at feature level with non-gaze contextual variables (page identity, AOI identity, correct-answer location, gender, visual complexity), and the paper reports that these additions generally reduced accuracy relative to gaze features alone - a negative fusion result reported plainly. Behaviour-level predictions are aggregated to a participant-level decision by majority vote, a late fusion across observations. The discussion proposes future fusion with non-gaze interaction data (mouse clicks, operation logs) as a route to eye-tracker-free deployment." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-015" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2018. The paper surveys autism classification from fMRI (71-86.7% across several studies) and EEG (94%), and argues that eye tracking 'has not been used to investigate whether it is suitable to detect autism by considering atypical visual attention patterns', claiming to be the first study to test gaze data for autism screening. It also documents an important methodological trend critically rather than approvingly - noting that several high-accuracy results in the literature rest on partitioning by data segment rather than by participant - and situates eye tracking as moving from research equipment into consumer hardware (Samsung Galaxy S4, Tobii gaming trackers, Acer notebooks), anticipating the consumer-device turn this corpus records." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-015" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two groups: adults with a confirmed clinical diagnosis of high-functioning autism or Asperger's syndrome (18 recruited, 15 analysed) and non-autistic control adults (18 recruited, 15 analysed after 2 data-quality exclusions and 1 random removal to balance classes). All recruitment, exclusion and balancing decisions are reported explicitly, including the random removal. No other-diagnosis group." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-015" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Years of formal education reported for both groups; web-use frequency assessed for all participants (all daily users); familiarity with each of the six stimulus websites surveyed to rule out over-familiarity confounds. No IQ, language or adaptive-functioning measures, and no autism severity score for the autistic group. Comorbidity handled only by excluding formally diagnosed intellectual disability, which bounds the sample to high-functioning adults." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-015" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "W4A '18 - the 15th International Web for All Conference (Lyon), themed 'The Internet of Accessible Things'. A technology venue, but specifically a web accessibility venue rather than a machine-learning or clinical one, which shapes the paper's framing around scalability, cost and access rather than diagnostic accuracy." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-015" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two contrasting tasks over the same six web page screenshots. Browsing: up to two minutes per page, free to read or ignore anything, moving on when ready. Searching: 30 seconds per page to answer two questions posed verbally by the researcher, with the answer read aloud - the full set of twelve questions is published in a table. Pages were presented in randomised order per participant and the two tasks were counterbalanced. Pages spanned three ViCRAM-rated visual complexity levels, giving a designed manipulation of stimulus complexity." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-015" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional; a single session with no follow-up. Gaze data over public web pages carry low re-identification risk, which is part of why the data can be released openly. Full ethical approval was obtained from the University of Wolverhampton Faculty of Arts Ethics Committee before collection, all participants signed consent forms after being familiarised with the purpose and procedure, and participants were debriefed. Uniquely in this corpus, the authors also flag prospective ethical risk in the discussion, warning that future profiling of conditions from web-searching behaviour 'will raise ethical considerations which should not be treated lightly'." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-015" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Author keywords: Autism, Eye Tracking, Web, Screening, Diagnostic Classification. CCS concepts: user characteristics, people with disabilities, user studies, web-based interaction, empirical studies in accessibility, accessibility design and evaluation methods. Task vocabulary: 'screening for risk of autism', 'marker of the condition', 'serious games for autism screening', 'accessible and unobtrusive screening method'. The accessibility-research framing is unique in this corpus." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-015" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Handcrafted per-AOI gaze summary features - time to first view, total and percentage viewing time, fixation count and revisit count - computed under two alternative AOI definitions (VIPS-derived page elements versus a generic 2x2 grid), plus categorical contextual variables. No raw scanpaths, time series or learned embeddings. The AOI-definition comparison effectively treats the representation itself as an experimental variable, which is unusual and produces one of the paper's most useful findings." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-015" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A confirmed clinical diagnosis of autism 'as verified by the charity organisation' through which participants were recruited - no instrument, criteria or clinician is named, and verification is delegated to a third-party organisation. By contrast, control status is established rigorously with the Autism Quotient, with an explicit threshold (none above 32) and a rationale (the AQ is used by UK general practitioners as pre-referral screening). As in several other corpus studies, the control ascertainment is better specified than the case ascertainment." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-015" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The strongest validation reasoning in the corpus. The background section explicitly critiques two prior studies (an EEG study reporting 94% and a French speech study reporting 93.5%) for partitioning data segments rather than participants, noting that this allows segments from the same participant into both training and test sets and produces 'potentially overoptimistic results' that do 'not account for real-world scenarios where the algorithm will have the task of correctly classifying a new person'. The study then adopts 100-fold cross-validation with strict participant-level partitioning (10 training and 5 test participants per group per fold) precisely to emulate diagnosing a new person, and reports 95% confidence intervals throughout. Class balance is enforced by design, including the random removal of one control. What is absent: external validation on an independent cohort, any held-out site or apparatus, calibration analysis, and any measurement of the proposed eye-tracker-free variant." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-015" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Supervised learning. Algorithm: logistic regression in R, chosen after testing several classification algorithms. The deliberate choice of a simple linear model with a small feature set, rather than a high-capacity model on 30 participants, is consistent with the paper's general conservatism about overfitting." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-015" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Classification accuracy, reported with 95% confidence intervals for every single configuration in every table - the only study in the corpus to do this systematically - plus confusion matrices for the two best results showing balanced per-class performance (0.722 control, 0.706 ASD for the best browse model). No sensitivity, specificity, F1 or AUC as such, though the confusion matrices permit their derivation." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-015" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Reported by the authors in a dedicated Limitations subsection: the 0.75 accuracy compares unfavourably with the 71-86.7% range reported for fMRI classifiers, which they attribute partly to the data not having been collected for classification; web-searching tasks are unsuitable for the very young children in whom early detection would be most valuable, so a different task would be needed to reach them; and the sample is not large, though they note it exceeds the 12-per-group benchmark study they compare against. Identifiable in review: no diagnostic instrument is named, with verification delegated to the recruiting charity; formally diagnosed intellectual disability is an exclusion criterion so results apply only to high-functioning adults; control education exceeds autistic education by 2.3 years, undiscussed; the headline is selected across two tasks, two AOI schemes, four feature sets and multiple page subsets - though every alternative is reported with confidence intervals, making the selection auditable; and the participant-level aggregation rule (majority vote over behaviours) is a design choice whose sensitivity is not explored." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-015" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Goal: accessible, unobtrusive, scalable screening from everyday behavioural data, explicitly framed as a route to a future serious game rather than as a diagnostic substitute. Main findings: 0.75 accuracy for the Search task with page-specific AOIs; 0.71 (CI 0.69-0.73) for Browse on the two most predictive pages; task type matters (search beats browse); AOI definition matters and interacts with task (generic 2x2 grid gives 0.70 for browse but only 0.56 for search); gender, visual complexity and correct-answer location had no significant influence; adding AOI ID or media ID lowered accuracy relative to gaze features alone." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-015" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No per-feature importance ranking or saliency analysis. Interpretability instead comes from systematic ablation across design variables, which yields several substantive findings: gaze features alone outperform gaze plus contextual features; page-specific AOIs are necessary for search but not for browse, because search requires locating specific elements while browse treats all screen regions as equal; the Apple and AVG pages showed the largest between-group differences during browsing; and gender and visual complexity do not matter. The authors also connect back to prior analyses of the same data identifying longer scan paths, more transitions, shorter fixations and more fixations on irrelevant elements as the underlying behavioural differences." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-015" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The best in the corpus. An explicit 'Open Data' section states that the eye-tracking data, code, and materials are available at a named GitHub repository, and the abstract states the gaze data, R code, visual stimuli and task descriptions are 'made freely available for replication purposes'. Full replicability is listed as one of the paper's three stated contributions. Beyond the release, the paper publishes the complete search question set, the AOI definition methods, the eye tracker specifications, viewing distance, calibration procedure, cross-validation scheme, and confidence intervals for every configuration, and directs readers to the repository for results of page combinations not shown in the paper." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-015" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Design tasks specifically intended to amplify visual-processing differences between groups, since the present stimuli were repurposed; explore capturing the same differences without an eye tracker at all, using operation logs, mouse clicks, task accuracy and miss rate, so that screening could run on ordinary hardware; develop a serious game for large-scale accessible screening; extend the gaze-classifier approach to other conditions with visual attention differences such as dementia, schizophrenia and ADHD; and confront the ethical implications of profiling for clinical conditions from web behaviour." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-015" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Laboratory setting with a controlled eye tracker and fixed viewing distance. Existing data - the eye-tracking corpus was originally collected to investigate web-searching difficulties experienced by autistic users, and the authors are explicit that 'the data used in this study was not collected with this objective in mind', treating this as a limitation on achievable accuracy." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-015" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Gaze: fixation timing, duration, count and revisit behaviour within areas of interest during naturalistic web interaction. Distinctively, the stimuli are real web pages rather than faces or social scenes, so the measured construct is general attention allocation and search strategy rather than social attention." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-015" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Hardware: Gazepoint GP3 video-based eye tracker at 60 Hz with 0.5-1 degree of visual angle accuracy, a 19-inch LCD monitor, and an integrated sensor controlling viewing distance at approximately 65 cm; nine-point calibration. Software: Gazepoint software for capture; the extended VIPS (Vision-Based Page Segmentation) algorithm for page-specific AOI definition; the ViCRAM tool for rating page visual complexity; R for logistic regression and cross-validation." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-015" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "'people with autism', 'participants with autism', 'people on the autism spectrum', 'autistic individuals', 'autistic readers', 'the group with autism', 'neurotypical participants', 'control group of participants without autism', 'non-autistic control participants'. Notably mixed and deliberately so - the paper uses 'people with autism' and 'autistic' interchangeably, consistently pairs them with 'neurotypical' rather than 'normal' or 'healthy', and uses 'condition' rather than 'disorder' in its own prose. It also frames misdiagnosis in terms of harm to 'a person's self-perception', a person-centred framing absent elsewhere in the corpus." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-015" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "Single session; up to 2 minutes per web page for browsing and 30 seconds per web page for searching, across six web pages, in randomised page order with counterbalanced task order" ;
                    slr:study_design "Cross-sectional case-control classification study; secondary machine-learning analysis of eye-tracking data originally collected to study web accessibility difficulties in autistic…" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder - high-functioning autism or Asperger's syndrome, adults" ;
                    slr:sample_size_text "ASD/index: 18 recruited (12 male, 6 female); 3 discarded for calibration difficulties and head-movement data loss, leaving 15 analysed (9 male, 6 female); comparison: 18 recruited (10 male, 8 female); 2 discarded for data quality and 1 further removed at random to balance classes, leaving 15 analysed (8 male, 7 female)" ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "Best overall: 0.75 accuracy for the Search task with page-specific AOIs and all gaze features. Browse task best: 0.71 (95% CI 0.69-0.73) using gaze features on the Apple and AVG pages combined; all pages with gaze features gave 0.66 (0.64-0.68). Generic 2x2 AOIs gave 0.70 for browse but only 0.56 for search. Individual browse pages ranged from 0.45 (BBC) to 0.63 (Apple). Confusion matrix for the b",
                        "Gaze data from ordinary web browsing and searching distinguished autistic from non-autistic adults at up to 0.75 accuracy under strictly participant-independent validation. The search task elicited larger between-group differences than free browsing. How areas of interest are defined matters and interacts with task: generic grid AOIs were adequate for browsing but collapsed performance for searchi" ;
                    slr:outcome "Classification accuracy with 95% confidence intervals for every reported configuration, plus confusion matrices for the two best results" ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "Best overall: 0.75 accuracy for the Search task with page-specific AOIs and all gaze features. Browse task best: 0.71 (95% CI 0.69-0.73) using gaze features on the Apple and AVG pages combined; all pages with gaze features gave 0.66 (0.64-0.68). Generic 2x2 AOIs gave 0.70 for browse but only 0.56 for search. Individual browse pages ranged from 0.45 (BBC) to 0.63 (Apple). Confusion matrix for the b; Gaze data from ordinary web browsing and searching distinguished autistic from non-autistic adults at up to 0.75 accuracy under strictly participant-independent validation. The search task elicited larger between-group differences than free browsing. How areas of interest are defined matters and interacts with task: generic grid AOIs were adequate for browsing but collapsed performance for searchi" ] ] ;
