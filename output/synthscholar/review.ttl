        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "One potential limitation of this study is the use of a classification method at the begging of the process. Indeed, because of the sample size and its characteristics, it was necessary to train the network according to the original labels of the two groups and then build the latent space and the respective distributions. Therefore, we had to rely on the traditional assessment method to provide the ground truth to the model." ] ;
            oa:hasTarget <urn:slr:article:06efef346587> ;
