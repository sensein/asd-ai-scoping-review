                    slr:judgment "high" ;
                    slr:supporting_quote "Labels are a binary field in a downloaded file. No diagnostic instrument, criterion, assessor or date is reported for the ASD group, and no screening evidence for the non-autistic group." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Class-conditional mean imputation writes outcome information into the feature matrix before any split; SHAP-based feature selection was performed over the whole dataset; the preprocessing account contradicts itself on whether normalisation was applied; and no architecture, learning rate, epoch count or seed is given." ],
                [ a slr:RoBDomainJudgment ;
