    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "Documented formal diagnoses and an AQ-screened control group, with all exclusions itemised, but controls recruited by snowball sampling from a different route than cases, education visibly imbalanced in favour of controls, and demographic matching unverifiable from the extracted text." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "Formal diagnosis documented by requirement of the recruiting services, all meeting ADOS criteria, with intellectual disability and reading disorder excluded; controls positively screened with the AQ-50 and one excluded on that basis." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "Participant-level splitting repeated 100 times with per-participant voting - the correct design, argued for explicitly - but the reported accuracies are maxima over task, AOI definition, feature set, split ratio and page subset, all selected on the same evaluation." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
