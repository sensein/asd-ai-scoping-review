    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "Metric-learning weights are learned only on training folds so scores are computed without reference to the comparator HOC scores; three-fold cross-validation with class-balanced folds, replicated at ten folds; and the sample-size adequacy is argued quantitatively via the 1-in-10 rule and Raudys's expected-error formula." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "DSM-5 confirmed on site by research-reliable assessors using ADOS-2 (standardised to module 3), ADI-R and parent-report SRS-2 - the most complete diagnostic ascertainment in the corpus." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "Trial selection is explained and justified (4 of 14 trials, restricted to 100% speed to avoid speed confounds), repeated trials are used deliberately for test-retest estimation, and all 48 children appear in the analyses." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "Community and school recruitment with a thorough instrument battery and IQ threshold, and group comparison statistics tabulated - but the demographic values are not recoverable from the extracted text, and the IQ-at-or-above-80 criterion with an 8-12 age band bounds the sample to more able school-age children." ] ;
            slr:overall_judgment "low" ;
            slr:tool_used "QUADAS-2" ] .

<https://doi.org/10.1016/j.compbiolchem.2025.108619> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "A neurological disease, named autism spectrum disorder (ASD), is portrayed through divergence with social interaction, communication, and repetitive activities. As heredity is an important source, initial identification and treatment can diminish the need for wide examinations and expensive medical procedures for those with ASD. Prolonged effects and severity can be avoided at a timely determination of ASD. This study develops a hybrid deep-learning method for ASD detection. Pre-processing, feature selection and ASD detection are three steps involved. In the pre-processing phase, input data is passed in which noise and artefacts present in the data are removed using Yeo-Jhonson transformation. Next, by integrating Double exponential Smoothing (DES) in Elk Herd Optimizer (EHO), Double exponential Smoothing-Elk Herd Optimizer (DeSEHO), is proposed to select features. At last, the features that are selected are subjected to the ASD detection phase. In this stage, the Mo­ ments Embedding ResNeXt (MEResNeXt), which is the combination of Moments Embedding Network (MoNet) and ResNeXt, is used for ASD detection. The results of the research show that MEResNeXt performed better in terms of traditional models which show accuracy of 95.3 %, sensitivity of 96.5 %, and specificity of 94.8 %." ;
    dcterms:bibliographicCitation "Rai S (2026). A novel hybrid deep learning model using MEResNext for autism spectrum disorder detection. *Computational Biology and Chemistry, 120, Article 108619*. https://doi.org/10.1016/j.compbiolchem.2025.108619" ;
    dcterms:creator "Rai S" ;
    dcterms:title "A novel hybrid deep learning model using MEResNext for autism spectrum disorder detection" ;
    bibo:doi "10.1016/j.compbiolchem.2025.108619" ;
    bibo:pmid "local_24fefc5f" ;
    fabio:hasPublicationYear 2026 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Participants appropriate to the question" ;
                            slr:justification "No participants and no sample size; the number of records analysed appears nowhere in the article." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Data source and eligibility described" ;
                            slr:justification "Dataset identified by name only, with no accession, class balance, demographics or collection description." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Sample size justified" ;
                            slr:justification "Not merely unjustified - unreported at every stage." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Predictors defined and measured appropriately" ;
                            slr:justification "Q-CHAT-10 items are the summands of the label's score; Yeo-Johnson power transformation is applied to binary responses on the stated ground of removing noise and artefacts." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Predictors assessed blind to outcome" ;
                            slr:justification "The DeSEHO metaheuristic selects features against an unstated fitness function, with no statement of nesting relative to any partition." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Model choice justified" ;
                            slr:justification "MoNet's moment embedding and ResNeXt's aggregated residual transformation are image-recognition constructs applied to a short tabular vector with no rationale offered." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Outcome definition and ascertainment" ;
                            slr:justification "Outcome is stated as Q-CHAT-10 score above 3; no clinical ascertainment for any record." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Outcome determined independently of predictors" ;
                            slr:justification "It is not - the label is a threshold on the sum of the items in the feature pool." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Reporting proportionality" ;
                            slr:justification "Roughly forty equations specify borrowed architecture internals while sample size, class balance, split and selected-feature count are all absent." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Performance measures adequate" ;
                            slr:justification "No confidence intervals, no class balance and therefore no baseline; accuracy and specificity are defined incorrectly in the text." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Analysis unit matches the clinical claim" ;
                            slr:justification "Presumably one row per child, but the article never states the analysis unit or the number of rows." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Validation design guards against optimism" ;
                            slr:justification "No split, cross-validation or held-out set is described; the headline is read off the best region of iteration and training-percentage sweeps." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Limitations and overinterpretation" ;
                            slr:justification "Two sentences of model-level caveats; a full limitations table applied to other people's studies and none to this one; ethics and consent both declared Not Applicable without reasoning." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Accuracy, sensitivity, specificity and F1, plotted against iteration count and training percentage. Two of the four definitions given in the text are wrong: accuracy is described as dividing the total number of instances by the number of correctly classified instances, which is the reciprocal of accuracy and would exceed 1; and specificity is described in words as dividing the total number of false positives and true negatives by the sum of both, which is identically 1. The accompanying equations for sensitivity and specificity are correct, so these are errors of exposition rather than of computation, but they appear in a section whose stated purpose is to define the evaluation measures. No confidence interval, no chance level and no class balance accompany any figure." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-157" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional secondary analysis. Ethical approval and informed consent are both declared Not Applicable, without reasoning - the paper does not invoke the public-data exemption that comparable studies at least state, and offers nothing in its place. A related reporting anomaly: the article has a single author, Saloni Rai, whose CRediT contribution is listed only as Data curation, yet the author statements read All authors have made substantial contributions to conception and design and the acknowledgements thank the co-authors of this manuscript for their valuable and constructive suggestions." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-157" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No acquisition instrumentation. Implementation in Python with no library, version, seed or hardware. Method components: Yeo-Johnson transformation, the Elk Herd Optimizer with double exponential smoothing, the Moments Embedding Network and ResNeXt." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-157" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. No age, sex, ethnicity, geography, socioeconomic status or recruitment information, and no acknowledgement that any of it is missing." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-157" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Computational Biology and Chemistry 120:108619 (Elsevier), 2026 issue. A computational-biology venue, and the mismatch shows: a paper with no sample size, no validation protocol, no reported class balance, two incorrect metric definitions, image architectures applied to binary questionnaire responses, and author statements referring to co-authors of a single-authored manuscript." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-157" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No task or paradigm - a caregiver checklist. The article does not reproduce or discuss a single Q-CHAT-10 item, so no behaviour is named anywhere in it." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-157" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The stated goal is a hybrid deep-learning method for ASD detection in three stages: Yeo-Johnson transformation to remove noise and artefacts, DeSEHO (Double Exponential Smoothing integrated into the Elk Herd Optimizer) for feature selection, and MEResNeXt (Moments Embedding Network combined with ResNeXt) for classification. Headline findings: accuracy 95.3%, sensitivity 96.5%, specificity 94.8%, described as performing better than traditional models." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-157" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Parent-reported early social-communication behaviour, entirely unspecified - the article names the Q-CHAT-10 instrument and describes its scoring rule but never states or discusses a single item, so no behaviour is identified anywhere in the paper." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-157" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Enhance preprocessing techniques, improve the efficiency of feature selection, and ensure the model's adaptability across diverse datasets. The last is the only one that addresses a genuine gap, and it is stated without reference to any external dataset." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-157" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2026 issue. Framing is early-detection and cost-saving: initial identification and treatment can diminish the need for wide examinations and expensive medical procedures, and prolonged effects and severity can be avoided at a timely determination of ASD. The contribution is expressed as architectural novelty - a named hybrid (MEResNeXt) built from two named components, fed by a named metaheuristic (DeSEHO) built from two further named components - with the accuracy figure as its warrant. It is the corpus's clearest example of method-naming as the unit of contribution: four new acronyms are introduced, forty equations specify borrowed architecture internals, and the number of children behind the result is never mentioned." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-157" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No participants, and no sample size of any kind. The article never states how many records the analysed dataset contains, how many are ASD-positive, or how many are negative - a gap that persists through a results section built entirely on performance curves. The data source is identified only as Autism screening data for toddler, the public Q-CHAT-10 collection. Since no split, test set or fold structure is described either, there is no point in the paper at which a reader can say how many observations any reported number rests on." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-157" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two sentences, both concerning the model rather than the study: the reliance on the Yeo-Johnson transformation for noise removal may not be sufficient for all types of data, and the complexity of the model may lead to overfitting, especially with smaller datasets. Notably, the article contains an extensive limitations apparatus pointed at other people's work - Table 1 tabulates the advantages and disadvantages of each prior study, and the related-work section names constraints for several of them - while none of that scrutiny reaches the circular label, the unreported sample size, the absent validation protocol or the Not Applicable ethics declaration." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-157" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "ASD, autism spectrum disorder, autistic individuals, individuals with ASD, patient, ASD patients. The register is medical and dated - autism is introduced as a neurological disease, individuals are described as needing the right treatment as soon as possible to recover their condition and diminish the disorder's effects. One passage is more sympathetic, noting that individuals with ASD have uniqueness and a few have incomparable ability in academics, music skills and visual. No autistic or community perspective appears." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-157" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Autism spectrum disorder; Disease detection; Hybrid deep learning; Optimization algorithm. Four terms, three naming machinery in the most generic possible way; neither the instrument, the population, the modality nor the validation appears." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-157" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A tabular vector of Q-CHAT-10 items and individual characteristics, Yeo-Johnson transformed and then reduced by the DeSEHO metaheuristic. Two observations. First, Yeo-Johnson is a variance-stabilising power transformation for continuous skewed variables; applying it to binary checklist responses to remove noise and artefacts, and justifying that choice at length against Box-Cox on the ground that it accommodates negative values, is a category error about the data. Second, the ten items are the summands of the score whose threshold defines the label, so whatever subset DeSEHO retains, the target remains an arithmetic function of the feature pool." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-157" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. The metaheuristic selects a feature subset and neither its size nor its membership is reported; no importance ranking, attribution or ablation appears; and no component of the three-stage pipeline is isolated. In a paper whose contribution is a specific combination of transformation, optimiser and architecture, no experiment shows that any of the three contributes anything." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-157" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Very low, in an unusually instructive way. The article devotes several pages and roughly forty numbered equations to the internals of the MoNet sub-matrix square-root layer, including its forward and backward propagation and the symmetrisation of matrix derivatives - a level of mathematical specification exceeding anything else in the charted corpus. It reports none of what would be needed to repeat the study: no sample size, no class balance, no split or cross-validation scheme, no test-set size, no metaheuristic search space or budget, no count or identity of selected features, no learning rate, batch size or epoch count in the running text, no seed, no code, and no dataset accession. The detail is concentrated entirely on the parts that are reproduced from prior architecture papers and absent from the parts that are specific to this experiment." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-157" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No fusion - a single questionnaire modality. The hybrid designation refers to combining two convolutional architectures over the same tabular input." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-157" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "MEResNeXt, combining the Moments Embedding Network with ResNeXt. Both are convolutional architectures designed for images: MoNet's contribution is a bilinear second-order moment embedding with a sub-matrix square-root layer developed for fine-grained visual recognition, and ResNeXt's is the aggregated residual transformation with cardinality developed for ImageNet classification. Applying them to a short tabular vector of binary questionnaire responses is never justified, and neither the spatial structure that motivates convolution nor the fine-grained texture statistics that motivate moment embedding exists in the data." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-157" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "There is no validation design to assess. The article describes no train-test split, no cross-validation, no held-out set and no test-set size; it never states how many records the dataset contains or what its class balance is; and its results are presented as curves of accuracy, sensitivity, specificity and F1 against iteration count (20 to 80) and training percentage (70%, 80%), with the abstract's 95.3% / 96.5% / 94.8% taken from the best region of those curves. Reading performance off the maximum of a sweep is model selection on the reported quantity, and here there is not even a stated partition on which the sweep is evaluated. Underneath that sits the estimand: the label is a threshold on the sum of the ten Q-CHAT-10 items supplied as features, so the task is reconstruction of a checklist rule regardless of how the data are partitioned. The contrast with the rest of this branch is instructive. local_ed30e24c reached a flawless 292 of 292 with all items retained and pre-split SMOTE; local_14df790d reached 0.99 and mapped the mechanism through its feature-subset comparison; local_8ff20c48 fell to 0.83 after deleting five items. This study reports 95.3% after an unreported metaheuristic selection of an unreported number of features - a figure whose position in that range is determined by how much of the label's arithmetic the optimiser happened to retain, which the paper does not report and therefore cannot interpret." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-157" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No study setting. A downloaded dataset analysed in Python; no hardware, runtime or environment is described." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-157" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None, and the paper states the substitute rule explicitly: if the Q-CHAT-10 score is higher than 3 then the class value is allocated as YES which implies ASD traits potential; if not, NO is allocated. The outcome is therefore a threshold on the sum of the ten checklist items that also constitute the feature set - the seventh instance of this structure in the review, after local_8253c2ec, local_a0d73248, local_8ff20c48, local_ed30e24c, local_b9de0d7f and local_14df790d. No clinician, instrument administration or diagnostic criterion enters at any point." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-157" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. No cognitive, adaptive, language or severity measure." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-157" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
