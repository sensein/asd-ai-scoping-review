    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "No diagnostic instrument, criteria or clinician is reported for the ASD group, and control status is asserted rather than screened." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Stepwise discriminant analysis selected 3 features from 20 using group labels on the full dataset, and an exhaustive grid search over kernels, C, gamma, polynomial degree and 1-50 hidden neurons was run outside the cross-validation loop; the reported 93.3% is therefore optimistic and is additionally the best of four classifier configurations." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Mixed convenience recruitment (specialist autism centre plus social-media outreach) with no gender data at all, no age-matching test despite a ~0.9-year group difference in a paediatric gait study, and no diagnostic instrument behind the 'mild category of ASD' label." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "All 60 children appear in the analysis and trial validity criteria are stated, but only a single left-limb stance from one selected trial per child is analysed and the trial-selection rule is not given; no exclusions or failed trials are reported." ] ;
            slr:overall_judgment "high" ;
            slr:tool_used "QUADAS-2" ] .

<urn:slr:article:bb59da535587> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "distinctive characteristics and categorize children with ASD and healthy controls based on individual images. Elbattah et al. (24) developed a machine learning (ML)-based approach to aid in the diagnosing process. This approach relies on acquiring knowledge of sequence-oriented patterns in action eye motions. The primary philosophy was to represent eye-tracking data as written documents that analyze a sequence of rapid eye movements (saccades) and periods of gaze fixation. Therefore, the study utilized the natural language processing (NLP) technique to transform the unorganized eye-tracking information. Li et al. (25) introduced an automated evaluation framework for detecting typical intonation patterns and predictable unique phrases that are important to ASD. Their focus was on the linguistic and communication difficulties experienced by young children with ASD. At first, the scientists utilized the Open SMILE toolkit to extract high-dimensional auditory characteristics at the sound level. They also employed a support vector machine (SVM) backend as the standard baseline. Furthermore, the researchers suggested many DNN arrangements and structures for representing a shared prosody label derived directly from the audio spectrogram after the constant Q transform. Identification and intervention for ASD have enduring effects on both ASD children as well as their families, necessitating informative, medical, social, and economic assistance to enhance their overall wellbeing. Professionals have problems in conducting ASD assessments due to the absence of recognized biophysiological diagnostic techniques (25, 26). Therefore, the diagnosis is often determined by a thorough evaluation of behavior, using reliable and valid standardized techniques such as the Autism Diagnostic Observation Schedule (ADOS) (27) and the Autism Diagnostic Interview-Revised (ADI-R) (28). These tools, widely approved in investigation and research domains, are considered the most reliable method for diagnosing ASD in medical situations (29, 30). However, using them involves the use of many materials, a significant amount of time, and is somewhat expensive (25, 26). Furthermore, the diagnostic technique necessitates the involvement of skilled and knowledgeable interviewers, who have the potential to influence the process. This is accompanied by the inclusion of intricate clinical procedures (25, 31). Collectively, these difficulties frequently contribute to a postponed identification, leading to a delay in the initiation of early intervention (26). Research indicates that early treatments for children with ASD before the age of five result in a much higher success rate of 67%, compared to a success rate of just 11% when interventions begin after the age of 5 (32). Eye-tracking technology is regarded as a beneficial method for doing research on ASD since it allows for the early detection of autism and its characteristics (33, 34) in a more" ;
    dcterms:bibliographicCitation "Alsharif N; Al-Adhaileh MH; Al-Yaari M; Farhah N; Khan ZI (2025). Utilizing deep learning models in an intelligent eye-tracking system for autism spectrum disorder diagnosis. *Frontiers in Medicine, 11*." ;
    dcterms:creator "Al-Adhaileh MH",
        "Al-Yaari M",
        "Alsharif N",
        "Farhah N",
        "Khan ZI" ;
    dcterms:title "Utilizing deep learning models in an intelligent eye-tracking system for autism spectrum disorder diagnosis" ;
    bibo:pmid "local_44d3aef5" ;
    fabio:hasPublicationYear 2025 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Participants appropriate to the question" ;
                            slr:justification "No participants; images from an unnamed repository with the number of distinct children unknown and image counts reported as child counts in the abstract." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Sample size justified" ;
                            slr:justification "No justification; the test-set size of 55 is never stated and must be recovered from a support column." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Data source and eligibility described" ;
                            slr:justification "Described only as a freely accessible public repository, with no accession, URL, DOI or summary of the originating collection's task, equipment or diagnostic procedure." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Preprocessing applied without leakage" ;
                            slr:justification "The split correctly precedes augmentation and augmentation is confined to training - but rotation and flipping of scanpath traces produce examples corresponding to no possible viewing behaviour." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Predictors defined and measured appropriately" ;
                            slr:justification "Scanpaths treated as pictures rather than sequences, so no gaze metric is extracted; the underlying viewing task is not described, leaving stimulus identity as an uncontrolled determinant of image geometry." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Predictors assessed blind to outcome" ;
                            slr:justification "Transfer learning from ImageNet with no label-informed feature selection." ;
                            slr:rating "Low" ] ;
                    slr:overall_concern "unclear" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Outcome definition and ascertainment" ;
                            slr:justification "Labels inherited from a public collection with no diagnostic procedure described." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Outcome determined independently of predictors" ;
                            slr:justification "Formally independent, but the label's own validity is unestablished." ;
                            slr:rating "Unclear" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Validation design guards against optimism" ;
                            slr:justification "Single unseeded image-level split with no cross-validation and no participant grouping; split proportions unstated." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Analysis unit matches the clinical claim" ;
                            slr:justification "Claims concern screening children; metrics are computed over scanpath images with multiple images per child." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Limitations and overinterpretation" ;
                            slr:justification "No limitations section, no future work; 100% accuracy is offered to physicians and healthcare professionals for use in diagnosis." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Reporting completeness" ;
                            slr:justification "Per-model hyperparameter tables covering architecture, dropout, loss, optimiser, learning rate, batch sizes and epochs - fuller than most of this corpus." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Performance measures adequate" ;
                            slr:justification "No specificity tabulated, no confidence intervals, no chance level; 55 test images support a four-way architecture ranking and a comparison against three prior studies." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Visual scanning behaviour, encoded as a rendered scanpath image showing the geometric trace of fixations and saccades. Because the images are treated as pictures rather than as sequences, no fixation duration, saccade amplitude, area-of-interest dwell or temporal ordering is extracted or reported - the behavioural content of the data is entirely implicit in the picture." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-156" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No participants. 547 scanpath images from a public eye-tracking repository, 328 labelled non-ASD and 219 ASD. The abstract converts this image count into a participant count, describing the dataset as scan pathways obtained from 328 characteristically emerging children and 219 children with autism - which would make this one of the larger primary eye-tracking cohorts in the field. The methods section states the correct version, that these are image counts. The source collection is the Cilia/Carette scanpath set, whose originators are cited in the comparison table and in which a few dozen children contributed multiple scanpath images each; the number of distinct children behind the 547 images is never given here. Every reported metric rests on a test partition of 55 images, recoverable only from the support column of the per-class results tables." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-156" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The stated goal is to automate ASD categorisation from eye-tracking data using deep learning, in response to the cost, delay and subjectivity of conventional assessment. Headline findings: MobileNet reached 100% accuracy with perfect precision, recall and F1 for both classes and ROC 100%; VGG19 92%; DenseNet169 78%; the proposed model is ranked above three prior studies on the same dataset (87%, 90%, 79%). The paper attributes its advantage explicitly to preprocessing - our model achieved high accuracy because we have used a different preprocessing approach from improving dataset." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-156" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Published 19 July 2024 (indexed here under 2025), 44 days from submission. Framing is unqualified diagnostic assistance: the classifiers are said to demonstrate the potential of eye-tracking data to aid physicians in efficiently and accurately screening for autism, and users and healthcare professionals can utilize these classifiers to enhance the accuracy rate of ASD diagnosis. The contribution is stated as a leaderboard position - 100% against 87%, 90% and 79% on the same public dataset - and attributed to preprocessing. There is no limitations section, no future work and no hedge of any kind." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-156" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Frontiers in Medicine 11:1436646 - an open-access clinical journal, accepted in 44 days. A 100% diagnostic accuracy claim, an abstract that reports image counts as child counts, an absent ethics statement, an unstated test-set size and no limitations section all passed clinical review." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-156" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. Labels are inherited from a public image collection with no diagnostic instrument, criterion, assessor or date reported, and the originating study's diagnostic procedure is not summarised. The paper's opening argument is that conventional ASD assessment relies on subjective criteria and lacks objectivity - a criticism advanced in favour of a label whose ascertainment it never examines." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-156" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. No age, sex, ethnicity, geography or recruitment source for any image, and no acknowledgement that this information is absent - despite the introduction discussing sex ratios in ASD prevalence and noting that girls with ASD often have fewer observable symptoms, a point directly relevant to a dataset whose sex composition is unknown." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-156" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "autism spectrum disorder; eye tracking; deep learning; VGG19; MobileNet; DenseNet169; hybrid model. Four of seven terms name specific architectures; validation, participants and task are absent." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-156" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional. There is no ethics statement, consent statement or exemption claim anywhere in the article, and no consideration of the provenance or consent basis of the underlying eye-tracking recordings of children." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-156" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The preprocessing order is handled correctly - the dataset is split before augmentation, and augmentation is applied during training via ImageDataGenerator - which is better than several neighbours in this corpus. Everything else about the evaluation undercuts the result. The split is at the image level on a scanpath collection in which each child contributes multiple images, so images generated from the same child's viewing session sit on both sides of the partition; this is the same within-participant leakage documented across the video, EEG-epoch, thermal, cry and facial-image branches, and it is sufficient to explain a perfect score. The test partition holds 55 images, a figure the paper never states and that must be recovered from a support column, so every reported metric carries roughly plus or minus 11 to 13 percentage points of sampling noise; MobileNet's 100% means 55 of 55 correct. There is no cross-validation, no repetition and no seed, and the spread across four architectures trained identically on the same data - 100%, 92%, 78% and the hybrid - is itself evidence of how unstable a 55-image estimate is, though the paper reads it as a genuine ranking of methods. The comparison against three prior studies on the same dataset (87%, 90%, 79%) is attributed to a different preprocessing approach, when the more parsimonious explanation is that the earlier figures came from evaluations that were less permissive. Finally, the paper never describes the viewing task behind the scanpaths, so it cannot exclude that the classifier is recognising which stimulus produced a trace rather than who produced it." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-156" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Mixed. Strengths: per-model parameter tables covering base architecture, pooling, dense widths, dropout, output layer, loss, optimiser, learning rate, batch sizes and epochs; and an explicit, correctly ordered preprocessing sequence in which the split precedes augmentation and augmentation is confined to training. Weaknesses: the dataset is described only as a freely accessible public repository with no accession, URL or DOI; the split proportions are never stated and the test size must be inferred from a support column; there is no seed, no code, and no statement of how many children the images come from; and the hybrid model is specified only by a figure." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-156" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No fusion of modalities - one image source. The hybrid model combines two ImageNet backbones over the same image, which is architectural ensembling rather than multimodality." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-156" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Per-class precision, recall, F1 and support, overall accuracy, macro averages, ROC curves and training/validation curves. Specificity is defined by equation and never tabulated. No confidence interval accompanies any figure, and none is possible to infer without the split proportions, which are not stated. The support column is the only place the test-set size appears: 33 non-ASD and 22 ASD, 55 images in total. On 55 images the 95% interval around VGG19's 92% runs from roughly 82% to 98% and around DenseNet169's 78% from roughly 65% to 88%, so the reported ordering of the four architectures - and the ranking against the three prior studies at 87%, 90% and 79% - is not statistically distinguishable." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-156" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No study setting. Images downloaded from an unnamed public repository; the compute environment is tabulated but not quoted in the extracted text. Critically, the acquisition setting of the original data - the viewing task, the stimuli, the eye tracker, the session structure - is nowhere summarised, so a reader cannot say what behaviour the scanpaths record." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-156" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "640x480 scanpath images, enhanced, converted to arrays and normalised to [0,1], with rotation, shifting and flipping augmentation applied during training only. Augmentation of a scanpath image is worth a separate note: flipping and rotating a gaze trace changes its spatial relationship to the stimulus that produced it, so the augmented examples correspond to no possible viewing behaviour - a transformation that is standard for photographs and semantically incoherent for scanpaths." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-156" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. There is no limitations section and the word limitation does not occur in the article. Nothing is said about the image-level split on a dataset with repeated images per child, about the 55-image test set, about the absence of any description of the underlying task, or about the fact that three architectures trained on the same data under the same protocol span 78% to 100%." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-156" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. There is no future-work section; the paper closes on the claim that healthcare professionals can use these classifiers to enhance the accuracy rate of ASD diagnosis." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-156" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "ASD, autism spectrum disorder, persons diagnosed with ASD, people without ASD, children with autism, characteristically emerging children, ASD children. The phrase characteristically emerging children appears to be a rewording of typically developing and, together with formulations like monotonous and stereotyped behaviors and the commonness of ASD, suggests heavy paraphrasing throughout. The register is otherwise clinical without being pejorative, and there is no autistic-community perspective." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-156" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. No cognitive, adaptive, language or severity measure." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-156" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. No saliency, attribution or scanpath-feature analysis, and no ablation of the hybrid. In a study whose premise is that gaze patterns carry diagnostic information, no gaze pattern is identified, and the paper does not report what distinguishes the ASD scanpath images from the others." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-156" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No acquisition instrumentation described. Modelling used ImageNet-pretrained MobileNet, VGG19 and DenseNet169 backbones with custom heads, Keras ImageDataGenerator for augmentation, RMSprop or Adam at learning rate 0.0001, batch sizes 16 (training) and 32 (validation), and 100 epochs. Parameter tables per model are provided and are more complete than most in this corpus." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-156" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Not reported. The paradigm behind the scanpaths is never described. This matters more than usual for a scanpath dataset, because the geometry of a scanpath image is jointly determined by the child and by the stimulus, and without knowing the stimulus set one cannot tell whether the classifier is reading gaze behaviour or stimulus identity." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-156" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Four transfer-learning classifiers: MobileNet, VGG19, DenseNet169 and a VGG19+MobileNet hybrid, each with ImageNet weights, the top layers removed, a pooling layer, dense layers with ReLU and dropout, and a two-unit softmax output." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-156" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "Internal across the four architectures. External: figures quoted from three prior studies on the same dataset - Akter et al. 2021 (87% accuracy, AUC 79%), Cilia et al. 2021 (CNN, 90%) and Elbattah et " ;
                    slr:study_design "Retrospective secondary analysis of a public eye-tracking scanpath image dataset; four deep learning classifiers compared on a single image-level train/validation/test split." ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: 219 images labelled ASD; comparison: 328 images labelled non-ASD" ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "MobileNet accuracy 100% with perfect precision, recall and F1 for both classes and ROC 100%; VGG19 92%; DenseNet169 78% (non-ASD precision 74%, recall 97%; ASD precision 92%, recall 50%); the hybrid model is reported but its headline figure is not captured in the extracted text." ;
                    slr:outcome "Per-class precision, recall, F1 and support, overall accuracy, macro averages, ROC curves, and training/validation accuracy and loss curves. Specificity is defined by equation but not tabulated." ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "MobileNet accuracy 100% with perfect precision, recall and F1 for both classes and ROC 100%; VGG19 92%; DenseNet169 78% (non-ASD precision 74%, recall 97%; ASD precision 92%, recall 50%); the hybrid model is reported but its headline figure is not captured in the extracted text." ] ] ;
