    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "some" ;
                    slr:supporting_quote "Repeated nested cross-validation with preprocessing performed inside each split and leakage named explicitly, but feature-family selection was made by inspecting importances across all folds before retraining, and the unit of analysis is not stated so child-disjointness cannot be confirmed." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Parent report with a described safeguard requiring confirmation of formal assessment and reporting of therapy type, but no instrument, clinician contact or record verification; comparison-group status unscreened." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "Group sizes and collection window are given, but no accounting of children or sessions excluded, no statement of sessions per child, and the restriction to CAFE prompts is justified without quantifying what it removed." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "No group-specific ages, an arithmetically impossible whole-sample age standard deviation, four comparison children not reporting sex, no demographic comparison, and no cognitive, language or severity measures; recruitment selects for smartphone access, English literacy and research engagement." ] ;
            slr:overall_judgment "some" ;
            slr:tool_used "QUADAS-2" ] .

<urn:slr:article:b694f7dc9504> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Background: Autism spectrum disorder (ASD) is a widespread neurodevelopmental condition with a range of potential causes and symptoms. Standard diagnostic mechanisms for ASD, which involve lengthy parent questionnaires and clinical observation, often result in long waiting times for results. Recent advances in computer vision and mobile technology hold potential for speeding up the diagnostic process by enabling computational analysis of behavioral and social impairments from home videos. Such techniques can improve objectivity and contribute quantitatively to the diagnostic process. Objective: In this work, we evaluate whether home videos collected from a game-based mobile app can be used to provide diagnostic insights into ASD. To the best of our knowledge, this is the first study attempting to identify potential social indicators of ASD from mobile phone videos without the use of eye-tracking hardware, manual annotations, and structured scenarios or clinical environments. Methods: Here, we used a mobile health app to collect over 11 hours of video footage depicting 95 children engaged in gameplay in a natural home environment. We used automated data set annotations to analyze two social indicators that have previously been shown to differ between children with ASD and their neurotypical (NT) peers: (1) gaze fixation patterns, which represent regions of an individual’s visual focus and (2) visual scanning methods, which refer to the ways in which individuals scan their surrounding environment. We compared the gaze fixation and visual scanning methods used by children during a 90-second gameplay video to identify statistically significant differences between the 2 cohorts; we then trained a long short-term memory (LSTM) neural network to determine if gaze indicators could be predictive of ASD. Results: Our results show that gaze fixation patterns differ between the 2 cohorts; specifically, we could identify 1 statistically significant region of fixation (P<.001). In addition, we also demonstrate that there are unique visual scanning patterns that exist for individuals with ASD when compared to NT children (P<.001). A deep learning model trained on coarse gaze fixation annotations demonstrates mild predictive power in identifying ASD. Conclusions: Ultimately, our study demonstrates that heterogeneous video data sets collected from mobile devices hold potential for quantifying visual patterns and providing insights into ASD. We show the importance of automated labeling techniques in generating large-scale data sets while simultaneously preserving the privacy of participants, and we demonstrate that specific social engagement indicators associated with ASD can be identified and characterized using such data. J Med Internet Res 2022 | vol. 24 | iss. 2 | e31830 | p. 1 https://www.jmir.org/2022/2/e31830 (page number not for citation purposes) Varma et al JOURNAL OF MEDICAL INTERNET RESEARCH XSL•FO RenderX (J Med Internet Res 2022;24(2):e31830) doi:" ;
    dcterms:bibliographicCitation "Varma M; Washington P; Chrisman B; Kline A; Leblanc E; Paskov K; Stockham N; Jung JY; Sun MW; Wall DP (2022). Identification of Social Engagement Indicators Associated With. **." ;
    dcterms:creator "Chrisman B",
        "Jung JY",
        "Kline A",
        "Leblanc E",
        "Paskov K",
        "Stockham N",
        "Sun MW",
        "Varma M",
        "Wall DP",
        "Washington P" ;
    dcterms:title "Identification of Social Engagement Indicators Associated With" ;
    bibo:pmid "local_db6c2d7c" ;
    fabio:hasPublicationYear 2022 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the sample representative?" ;
                            slr:justification "Self-selected from approximately 1,000 app downloads, among families willing to record and share video of their child." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the class balance appropriate?" ;
                            slr:justification "380 autistic against 69 comparison videos; the imbalance drives the metric choice and the held-out test set contains 43 against 11." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is developmental or language level measured?" ;
                            slr:justification "No cognitive, language, adaptive or severity measure for either group." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are comparison groups matched on age?" ;
                            slr:justification "Ages 2-15 pooled with no group means, tests or covariate adjustment; the distribution appears only in a figure." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are participants and recruitment adequately described?" ;
                            slr:justification "Recruitment route, group sizes, sex and overall age range given; no group-specific ages, no clinical characterisation, no exclusions." ;
                            slr:rating "Partly" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the annotation pipeline described reproducibly?" ;
                            slr:justification "Both off-the-shelf tools named with their outputs, the 75% confidence threshold, the face-count exclusion rule, and frame counts before and after." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the reference standard appropriate and independently applied?" ;
                            slr:justification "Unverified parent report of diagnostic status via survey." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the elicitation context described reproducibly?" ;
                            slr:justification "App, charades format, 90-second limit, phone-on-forehead arrangement and prompt categories all specified." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the measurement frame interpretable?" ;
                            slr:justification "Areas of interest are camera-relative directions from a phone on a moving head and cannot be matched to facial regions, as the authors concede." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is quality filtering applied uniformly?" ;
                            slr:justification "Automated thresholds applied to all frames, with comparable per-video retention across groups." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "some concerns" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are metrics appropriate to the class structure?" ;
                            slr:justification "Macro- and weighted-average precision and recall chosen over accuracy with the reasoning stated." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is uncertainty quantified for the group comparisons?" ;
                            slr:justification "Two-sided permutation tests with 100,000 rearrangements at every location." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is hyperparameter selection separated from the held-out estimate?" ;
                            slr:justification "Window and shift chosen on validation, three best configurations evaluated once on test." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the split child-disjoint?" ;
                            slr:justification "Stated explicitly, and maintained despite overlapping sliding-window feature construction." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are multiple comparisons corrected?" ;
                            slr:justification "Bonferroni applied to both the 16 fixation tests and the 61 transition tests, with the stringency acknowledged." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is a baseline reported for classification?" ;
                            slr:justification "No majority-class, chance or permutation comparator, despite a test set of 43 against 11 where majority-class weighted recall would be about 0.80." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are negative results reported?" ;
                            slr:justification "Fifteen of 16 fixation regions and 60 of 61 transition pairs non-significant, and the classifier described as showing mild predictive power." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "some concerns" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is privacy addressed substantively?" ;
                            slr:justification "Annotation performed entirely computationally so that no human viewed participant video, stated as a design contribution." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the dataset accessible or its access conditions stated?" ;
                            slr:justification "No availability statement." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are competing interests disclosed?" ;
                            slr:justification "Senior author founder of Cognoa; a co-author a part-time consultant for the same company." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is code available?" ;
                            slr:justification "Not mentioned, though both annotation tools are off-the-shelf." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are ethics and consent reported?" ;
                            slr:justification "Stanford IRB eProtocol 39562 with parental consent to share each recording." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the weak result reported without inflation?" ;
                            slr:justification "Described as 'mild predictive power' with macro- and weighted-average statistics both reported." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the interpretive limit of the measurement acknowledged?" ;
                            slr:justification "The authors state that areas of interest cannot be matched to facial regions because of camera motion." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "low" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The split is child-disjoint and stated as such, which is the single most important property and is applied correctly even under a feature construction that generates heavily overlapping windows: 324 videos to training, 71 to validation and 54 to a held-out test set, 'ensuring that all videos corresponding to a single child were assigned to the same set'. Hyperparameters were selected on validation and only the three best configurations evaluated on the test set, so the held-out estimate is not tuned. Group comparisons are protected by permutation testing with Bonferroni correction across both feature families. Three limits remain. There is no independent cohort. There is no baseline or null for the classification results, which matters acutely given a test set of 43 autistic and 11 comparison videos where the majority-class weighted-average recall of roughly 0.80 exceeds the reported 0.656 - a comparison the paper does not make. And the split is by video within child rather than being balanced on any covariate, so with an unreported age span of 2 to 15 years the training and test partitions could differ substantially in age composition without this being detectable. The overall picture is a study that validates its statistical claims rigorously and its predictive claim only loosely, while describing the latter as mild." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-089" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two limitations are stated and both are real. Class imbalance is identified as the reason macro-averaged and weighted-average statistics diverge, with dataset augmentation proposed as the remedy. More importantly, the interpretability of the areas of interest is conceded directly: 'due to camera motion and variation in the location of the smartphone relative to the parent's face, the gaze fixation maps are difficult to interpret qualitatively, and AOIs cannot be definitely matched to a parent's specific facial regions'. That is the central caveat on the whole study and the authors state it plainly rather than gesturing at eye contact or mouth-looking. What is not acknowledged: that diagnostic labels are unverified parent report, conceded by the same group in their companion speech paper but absent here; that the sample spans thirteen years of childhood with no age reporting, matching or covariate adjustment; that weighted-average recall of 0.656 falls below the roughly 0.80 a majority-class predictor would achieve on a test set of 43 autistic and 11 comparison videos; and that no confidence intervals, permutation tests or baselines accompany the classification results, in contrast to the rigour applied to the group comparisons." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-089" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Interpretability is pursued through the design of the analysis rather than through model attribution, and the outcome is honest about its own limits. The two group-comparison analyses are fully interpretable in their own terms - which regions, which transitions, what percentages - and the graph representation adds a sequential dimension that a fixation profile alone would miss. The reported effect is concrete: 13% of comparison children's gaze shifts occur between two adjacent central regions against 9.4% for autistic children. What is missing, and is conceded, is the mapping from those regions to anything in the world. Because the phone moves with the parent's head, region BC is a direction relative to a moving camera, not the parent's eyes or mouth, so the finding cannot be connected to eye contact, mouth-looking, or the Pelphrey and Chawarska results the introduction builds on. The LSTM receives no attribution analysis at all. The net position is that the study establishes a difference exists without being able to characterise it, and says so." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-089" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two groups from a crowdsourced app population: 68 children with parent-reported autism (53 male, 15 female) contributing 380 videos and 27 neurotypical children (18 male, 9 female) contributing 69 videos, 95 children and 449 videos in total, from approximately 1,000 individuals who downloaded the app. The imbalance is substantial and runs opposite to the direction usual in this corpus - cases outnumber controls by more than two to one at child level and by more than five to one at video level, which the authors identify as the reason for choosing macro- and weighted-average metrics over accuracy. After frame filtering the imbalance is similar (520,536 autistic frames against 99,084), so per-video frame retention was comparable between groups, which is a useful check that the automated quality filters did not operate differentially. No other-diagnosis comparison group." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-089" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "'children with ASD', 'individuals with ASD', 'the ASD cohort', against 'neurotypical (NT) children'. Person-first throughout, and 'neurotypical' rather than 'typically developing' or 'normal', which is the more neurodiversity-aligned term. Autism is described conventionally as 'characterized by social impairments, communication difficulties, and restricted and repetitive patterns of behavior', and the behavioural framing is deficit-oriented in places ('impaired social interactions', 'difficulty with maintaining eye contact'), though the analytic language is neutral and descriptive - differences in fixation distribution and transition frequency rather than abnormality. The privacy framing is notable for treating participants as people with interests to protect rather than as data sources." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-089" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Parent report alone. Parents who chose to share videos 'completed a survey to provide the age, sex, and diagnostic status of their children'. No instrument, no clinician involvement, no record verification, and no description of how diagnostic status was elicited. The companion study from the same group using the same app for speech analysis concedes this directly, noting that such labels 'are self-reported and thus unverified' and describing the mitigating design of offering diagnostic options unfamiliar to families who have not been evaluated. Neither the concession nor the mitigation appears here, and the limitations section does not mention the reference standard at all. Comparison-group status likewise rests on parental assertion with no screening." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-089" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Four directions, of which two are unusually practical. Expand the population and correct the class imbalance by augmentation. Analyse additional motion features such as limb movements and coordination, which the charades format would support naturally since the child is acting out prompts with their whole body. And - the most substantive - 'performing qualitative human-centered investigations or pragmatic randomized controlled trials to evaluate clinical usability' and 'evaluating the real-world diagnostic capabilities of our approach across diverse environmental settings'. Proposing a pragmatic randomised trial and human-centred usability work as the next step, rather than a larger dataset or a better architecture, is a translational rather than technical research agenda and is rare in this corpus." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-089" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Participants' own homes with no researcher present, no environmental control and no equipment standardisation - and the paper's positioning depends on this. The related-work section is unusually specific in critiquing prior computer-vision studies on precisely this point, noting that Hashemi and Chang 'controlled the room lighting and distance of the camera from the participant's face' and concluding that 'the ability of these techniques to translate to natural nonclinical environments and unstructured tasks remains to be explored'. The consequences are then reported rather than hidden: 'excessive camera movement and poor lighting conditions rendered some frames in our data set too blurry for use', and 'other adults or siblings would often join in gameplay, resulting in multiple faces in the frame'. Roughly 43% of frames were discarded by the automated quality filters. This is the most uncontrolled acquisition setting in the corpus and the paper treats that as its subject rather than as noise." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-089" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Single modality, and no fusion is attempted, though the companion speech study from the same group and app processes audio from the same recordings - so the two papers together represent an unexploited multimodal opportunity on a shared corpus, which neither notes. Within the modality, two representations of the same annotation are compared: a static fixation profile and a dynamic transition graph. Both yield exactly one significant finding after correction, and interestingly they converge on the same location - fixation differs at region BC and the significant transition is between BB and BC - which is a form of internal corroboration the paper does not draw attention to. Only the fixation representation is carried into the classifier; the transition matrices, which encode sequence and might plausibly carry more information, are used only descriptively." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-089" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Goal: determine whether gaze fixation and visual scanning differences associated with autism can be detected from unstructured home video on consumer phones, without eye trackers, manual annotation or structured tasks. Main findings: one of 16 gaze regions (BC, p < .001) and one of 61 transition pairs (BB-BC, p < .001) differed significantly after Bonferroni correction across 100,000-permutation tests, with comparison children making 13% of transitions between these regions against 9.4% for autistic children; an LSTM on the discretised gaze sequences reached macro-averaged recall 0.598 and weighted-average recall 0.656 on a child-disjoint held-out set, described by the authors as mild predictive power; and the entire pipeline operated without any human viewing participant video." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-089" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The representation is where the study's tradeoff is concentrated. Frame-level gaze is discretised from continuous (x, y) direction estimates into a 4x4 grid, then one-hot encoded and windowed. Discretisation is defensible given noisy estimates from uncalibrated phone video, and the sliding window with shift smaller than window generates overlapping samples, which multiplies the effective training set from 449 videos into many thousands of sequences - a legitimate augmentation given that the split is child-disjoint so the overlap cannot cross the partition. The decisive property, however, is the coordinate frame: gaze is expressed relative to the camera, which sits on the parent's forehead and moves with them. A region in this space is a direction, not a target, and the authors state that it cannot be matched to facial anatomy. The consequence is that the representation supports detecting that gaze distributions differ but not saying what they differ about - which is precisely the distinction between a signal and a behavioural finding, and the paper is clear about which it has." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-089" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Journal of Medical Internet Research 24(2):e31830 (2022), a digital health venue. Authorship spans Stanford's Departments of Computer Science, Bioengineering, Pediatrics and Biomedical Data Science, and Neuroscience, from the same group that produced the crowdsourced speech study on the same GuessWhat corpus. Funding is extensive, listing four NIH grants, an NSF award and numerous foundations. The senior author declares founding Cognoa and a co-author declares part-time consulting for the same company - relevant context given that the corpus's FDA pivotal trial paper evaluates a Cognoa device, and that the present study's honest reporting of a weak result sits in a portfolio that also contains a regulated commercial product." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-089" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two very different standards are applied to the two halves of the paper, and the contrast is instructive. The group comparisons are analysed with exemplary conservatism: two-sided permutation tests with 100,000 rearrangements at every location, Bonferroni correction applied to both families, and the correction's stringency explicitly noted as reducing Type 1 error at the cost of power. Reporting one significant region from 16 and one transition from 61 under that regime is a credible finding precisely because 15 and 60 negatives are reported alongside. The classification results receive no equivalent treatment - four metrics for three configurations with no confidence intervals, no permutation null and no baseline. The metric choice is nonetheless well reasoned, with macro- and weighted-average precision and recall selected over accuracy because of the imbalance and the divergence between them correctly interpreted as class-dependent performance. What is missing is the comparison that would locate the result: with 43 autistic and 11 comparison videos in the test set, always predicting autism yields weighted-average recall around 0.80, above the reported 0.656." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-089" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "An LSTM chosen to exploit temporal structure, with the architecture kept minimal - w cells each taking a 16-dimensional one-hot vector, a single fully connected output and a sigmoid - and a weighted binary cross-entropy loss to handle the class imbalance. Only window size and shift are varied, explored across 50 to 500 frames and 10 to 100 respectively on the validation set, with the three best carried to the held-out test set. No alternative architecture, no baseline classifier and no chance comparator is reported, which is the main gap: given the imbalance, a majority-class predictor and a permutation null are both necessary to interpret a macro-averaged recall of 0.598, and neither is provided. The restraint in model complexity is appropriate for 95 children, but the absence of any comparator makes the modest result harder to situate than the group-difference analysis, where permutation testing does exactly that job." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-089" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Keywords: mobile health, autism spectrum disorder, social phenotyping, computer vision, gaze, mobile diagnostics, pattern recognition, autism, diagnostic, pattern, engagement, gaming, app, insight, vision. The presence of 'social phenotyping' alongside 'mobile health' and 'gaming' locates the work in digital phenotyping delivered through consumer software rather than in vision research or clinical assessment." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-089" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. No cognitive, language, adaptive, severity or comorbidity measure for either group. Nothing therefore relates the gaze findings to any clinical dimension, and with an age span of 2 to 15 years and no developmental measure, neither age nor ability can be separated from diagnosis as an explanation for the observed differences." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-089" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2022. The framing is the standard access and delay argument - 1 in 44 prevalence, lengthy parent questionnaires and clinical observation producing 'long waiting times for results', and a goal of 'mitigating the problems associated with limited diagnostic resources for neurodevelopmental disorders, especially in regions where access to care is limited'. What distinguishes the positioning is the structure of the related-work critique, which sorts prior video-based work into three categories and identifies a specific cost for each: manual annotation 'require[s] large numbers of trained annotators when implemented on a large scale, which is expensive and time-consuming' and 'may compromise the privacy of participants'; eye trackers 'require custom hardware that can often be expensive and inaccessible, especially for individuals living in resource-limited regions'; and structured-environment studies controlled 'room lighting and distance of the camera from the participant's face', leaving translation to natural settings untested. The study then removes all three constraints simultaneously and reports what remains, which is a small but statistically defensible difference and a weak classifier. Read that way the paper is a deliberate test of how much signal survives the removal of every experimental control - and the answer, reported without inflation, is not much." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-089" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Reported only in aggregate and incompletely. Sex is given as 53 male and 15 female in the autistic group against 18 male and 9 female in the comparison group - 77.9% versus 66.7% male - with no test and no discussion. Age is reported only as an overall range of 2 to 15 years, with the distribution shown in a figure and no group means, medians, standard deviations or tests in the text, and one comparison-group child not providing an age at all. That is the study's most consequential reporting gap: gaze allocation, sustained attention, and willingness to engage in a charades game with a parent all change enormously between a 2-year-old and a 15-year-old, and the analysis pools the entire range without stratifying, covarying or reporting whether the groups are comparable. No IQ, language, adaptive or severity measure for either group, and no exclusion criteria described." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-089" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional, with videos accumulated opportunistically as families played and chose to share; no follow-up. Ethics approval from the Stanford IRB under a named eProtocol number, with parental consent to share each recording built into the app flow. Privacy is treated as a design constraint rather than a compliance step, and is one of the paper's three stated contributions: annotation was performed entirely computationally so that no human annotator ever viewed the footage, and the discussion explicitly contrasts this with prior manual-annotation work that 'may compromise the privacy of participants by providing annotators with access to video footage'. The senior author declares founding Cognoa and a co-author declares part-time consulting for the same company." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-089" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No specialised hardware at all - participants' own phones, with no model, camera specification, resolution or frame rate reported. The analytic chain uses two off-the-shelf systems applied without task-specific training: Amazon Rekognition for 30 facial landmarks and bounding boxes, and OpenFace for gaze direction. Both are used as noisy annotators with explicit quality gates - frames with zero or more than two faces removed, and frames with OpenFace gaze confidence below 75% removed - and the authors are appropriately cautious about what survives, stating that 'we expected the final annotations to be of high quality, but the presence of some noise and incorrect labels was to be expected'. Using general-purpose vision tools as automated annotators rather than training bespoke models is what makes the privacy-preserving claim credible and the pipeline reproducible, and it is a deliberate architectural choice rather than a convenience." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-089" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Good on pipeline, weak on participants. Fully reported: the app, game format, 90-second limit and recording arrangement; video and frame counts before and after filtering, broken down by group; both annotation tools with their outputs and the exact exclusion rules including the 75% confidence threshold; the gaze coordinate convention with its sign meanings; the 4x4 discretisation; the graph construction and normalisation for the transition analysis; the permutation test specification with 100,000 permutations and both Bonferroni thresholds; the sliding-window parameterisation with the ranges explored; the LSTM architecture, optimiser, learning rate, batch size and loss function; the three-way split with per-group video counts and the child-level constraint; and the metric choice with its rationale. Not reported: group-specific ages; any statistical comparison of demographics; the diagnostic elicitation; phone models or video specifications; the number of children excluded at any stage; and any data or code release." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-089" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two constructs drawn deliberately from clinical instruments: gaze fixation, 'which represent[s] regions of an individual's visual focus', and visual scanning, 'which refer[s] to the ways in which individuals scan their surrounding environment', both described as 'included in standard clinical diagnostic instruments'. The theoretical grounding is specific - fixation on the eyes signals communicative intent in dyadic interaction, and autistic individuals are reported to fixate instead on the mouth or other regions; scanning is grounded in Pelphrey's finding that neurotypical viewers transition between core facial features while autistic viewers scan non-feature areas such as the forehead and cheeks. Both constructs are then operationalised in a coordinate frame that cannot distinguish eyes from forehead from background, which the authors concede. The scanning analysis is nonetheless the more original contribution: modelling gaze shifts as a weighted graph and comparing adjacency matrices captures the sequential structure of looking rather than only its aggregate distribution, and it is what yields the interpretable finding that comparison children move between two adjacent central regions 13% of the time against 9.4% for autistic children." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-089" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Ninety-second charades within a mobile game, with the child acting out prompts - emotions, sports, animals, chores - while the parent guesses, and the phone held on the parent's forehead with the front camera facing the child. The design achieves something specific: because the parent must watch the child to guess, the game creates a genuine dyadic social interaction in which the child's gaze toward the parent's face is functionally motivated, rather than a passive viewing task. The authors describe this as supplying 'inherent structure' in camera position, child location and interaction type while leaving the child free of hardware. The corresponding weakness is that the phone is mounted on a moving head, so the coordinate frame in which gaze is measured drifts continuously - which is why the resulting regions cannot be mapped to facial features. The prompts also vary between videos, so the elicited behaviour is not held constant across children." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-089" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "90-second gameplay sessions, with each child contributing a mean of 4.7 videos (SD 7.3); 449 videos totalling 11.1 hours and 1,084,267 frames" ;
                    slr:study_design "Cross-sectional analysis of a crowdsourced home-video corpus, combining permutation-tested group comparisons with a child-disjoint supervised classification experiment" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Children with a parent-reported autism diagnosis, aged 2 to 15" ;
                    slr:sample_size_text "ASD/index: 68 children (53 male, 15 female) contributing 380 videos; comparison: 27 children (18 male, 9 female) contributing 69 videos" ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "Automated gaze estimation applied to 449 unstructured 90-second home gameplay videos from 95 children detected statistically robust but numerically small group differences: one of 16 gaze-direction regions and one of 61 transition pairs survived Bonferroni correction across 100,000-permutation tests, with comparison children making 13% of their gaze shifts between two adjacent central regions agai",
                        "Best configuration (window 100, shift 10) on the held-out test set: weighted-average precision 0.661, weighted-average recall 0.656, macro-averaged precision 0.595, macro-averaged recall 0.598. The two other configurations performed similarly or slightly worse (window 200: 0.635 / 0.662 / 0.577 / 0.561; window 500: 0.624 / 0.625 / 0.577 / 0.576). The authors describe this as 'mild predictive power" ;
                    slr:outcome "Macro-averaged and weighted-average precision and recall, chosen deliberately over accuracy because 'our data set exhibits class imbalance with cases outnumbering controls, these metrics provide the most accurate representation of model performance'. No accuracy, AUC or confidence intervals are repo" ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "Best configuration (window 100, shift 10) on the held-out test set: weighted-average precision 0.661, weighted-average recall 0.656, macro-averaged precision 0.595, macro-averaged recall 0.598. The two other configurations performed similarly or slightly worse (window 200: 0.635 / 0.662 / 0.577 / 0.561; window 500: 0.624 / 0.625 / 0.577 / 0.576). The authors describe this as 'mild predictive power; Automated gaze estimation applied to 449 unstructured 90-second home gameplay videos from 95 children detected statistically robust but numerically small group differences: one of 16 gaze-direction regions and one of 61 transition pairs survived Bonferroni correction across 100,000-permutation tests, with comparison children making 13% of their gaze shifts between two adjacent central regions agai" ] ] ;
    slr:content_sha256 "60b2673f5ecd980b06482efe8bb22d402605396e7de9010dacfcad75da0c3a2f" ;
