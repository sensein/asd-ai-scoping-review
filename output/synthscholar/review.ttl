                    rdf:value "the features of the rate of gaze away from the screen (area0) and the rate of head-eye co-movements (head-eye) extracted under hypotheses 1 and 2 account for a large proportion in classifying ASD and normal children" ] ;
            oa:hasTarget <urn:slr:article:7df517928741> ;
