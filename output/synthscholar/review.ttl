            slr:relevance_score "0.97"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "Data from all subjects with ASD and six TD controls were collected on the Tobii Pro TX300 at a 300 Hz sampling rate. The remaining TD samples were collected on the Tobii X2-60 with a sampling rate of 60 Hz. The precisions of the two devices were similar, and their differences in the rate of data collection did not factor into the analysis of the data." ] ;
            oa:hasTarget <urn:slr:article:bf28de6e32db> ;
