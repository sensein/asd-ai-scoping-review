    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "A single unseeded image-level 70/30 split on a corpus that repeats individuals, with no partition counts and no cross-validation. The testing-phase accuracy (98.42%) exceeds the training-phase accuracy (97.75%), and the stated 50 epochs disagree with the 25-epoch learning curves." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "A four-stage pipeline with no ablation of any component; the wavelet basis, network topology, fused vector dimensionality and input resolution are unspecified; the chimp optimiser has no stated objective, search space or budget, and the partition on which its fitness was evaluated is not identified." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "No participants; 2,940 images from an unnamed public corpus with no demographics, no provenance and an unknown number of distinct children. The paper itself notes that the absence of demographic information prevents any fairness assessment." ],
                [ a slr:RoBDomainJudgment ;
