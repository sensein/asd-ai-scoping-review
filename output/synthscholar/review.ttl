    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "Tiered DSM-IV diagnosis by a licensed psychiatrist of at least five years' experience, re-evaluated by a senior psychiatrist with escalation to two further seniors on disagreement, plus Raven's IQ measurement and exclusion of ADHD and schizophrenia; unavailability of ADOS and ADI-R disclosed." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Forward feature selection chooses features by the same leave-one-out accuracy that is reported, with the maximum quoted across 21 feature counts, four classifiers and three feature sets, and no outer validation loop." ],
