<urn:slr:article:8f4dcae4a760> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Screening autism spectrum disorder in children using machine learning on speech transcripts Rida Assaf1, Zein Shehabeddine1 & Vikram Ramesh2 Early detection of Autism Spectrum Disorder (ASD) in children is crucial for timely interventions that can improve developmental outcomes. Traditional diagnostic methods are often resource-intensive, time-consuming, and may raise ethical concerns regarding privacy, particularly for minors. In this study, we evaluate the feasibility of privacy-preserving machine learning models for ASD detection using children’s speech transcripts. By exclusively leveraging structured text-based inputs, our method inherently avoids the direct use of identifiable biometric data, such as raw audio or video, thus significantly reducing privacy risks. Although we have not implemented explicit cryptographic privacy measures (e.g., differential privacy, encryption), our approach minimizes privacy concerns inherently associated with sensitive biometric data. We conducted experiments on two datasets from the TalkBank repository, focusing on linguistic features such as Mean Length of Utterance (MLU) and Mean Length of Turn Ratio (MLT Ratio). Our results demonstrate strong predictive performance, with models achieving accuracy above 86% across both datasets. Notably, we found that a small, focused subset of features was sufficient to maintain this level of performance, reducing the need for extensive data collection, thereby enhancing privacy. These findings highlight the promise of computational linguistics in advancing non-invasive, ethical approaches to ASD detection, providing a foundation for future applications in clinical and educational contexts." ;
    dcterms:bibliographicCitation "Assaf R; Shehabeddine Z; Ramesh V (2026). Screening autism spectrum. *Scientific Reports, 15(1), Article 34134*." ;
    dcterms:creator "Assaf R",
        "Ramesh V",
        "Shehabeddine Z" ;
    dcterms:title "Screening autism spectrum" ;
    bibo:pmid "local_1b457442" ;
    fabio:hasPublicationYear 2026 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Participants appropriate to the question" ;
                            slr:justification "Children with diagnoses from peer-reviewed developmental studies, and - in the Eigsti corpus - a developmental-delay comparison group alongside typical development." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Data source and eligibility described" ;
                            slr:justification "Both corpora cited and linked, selection criteria stated, and demographic composition tabulated by group and sex including ethnicity for one corpus." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Confounders addressed" ;
                            slr:justification "Nadig ASD children average roughly two years older than the TD children and are more male-weighted; neither difference is adjusted for, and age is entered as a predictor." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Model development guarded against optimism" ;
                            slr:justification "Grid search under stratified cross-validation with selected values reported, a depth-2 random forest appropriate to sample size, and a quantified train-validation overfitting check." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Predictors defined and measured appropriately" ;
                            slr:justification "Standard, interpretable child-language measures - MLU, MLT ratio, total words, parts of speech - from naturalistic language samples." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Predictors independent of the outcome" ;
                            slr:justification "Age is included among the features and is confounded with group membership in the Nadig corpus." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "unclear" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Outcome determined independently of predictors" ;
                            slr:justification "Diagnosis predates and is unrelated to the transcript features." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Outcome definition and ascertainment" ;
                            slr:justification "Diagnoses from the originating peer-reviewed studies, accessed through a repository requiring consent and ethical approval from contributors." ;
                            slr:rating "Low" ] ;
                    slr:overall_concern "low" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Differential comparison included" ;
                            slr:justification "A three-class analysis including developmental delay is run and its lower result (ROC-AUC 0.71) reported and interpreted as showing misdiagnosis risk." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Performance measures adequate" ;
                            slr:justification "Six metrics with stated rationales for every configuration, but no confidence intervals, no fold variance, and no majority-class baseline against a 68.4%-imbalanced corpus." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Analysis unit matches the clinical claim" ;
                            slr:justification "One row per child; folds partition children." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Validation design guards against optimism" ;
                            slr:justification "Child-level stratified cross-validation with an overfitting check and KS-validated SMOTE, but SMOTE's placement relative to the folds is unstated." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Limitations and overinterpretation" ;
                            slr:justification "Sample size, age-range narrowness, the loss of prosodic information as the cost of the privacy choice, and the weak three-class result are all named; the privacy claim is explicitly qualified as lacking cryptographic guarantees." ;
                            slr:rating "Low" ] ;
                    slr:overall_concern "unclear" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Three classifiers - logistic regression, random forest at maximum depth 2, and TabNet - with logistic regression selected for the interpretability analysis on the basis of its performance. The depth-2 random forest is an appropriate constraint for 38-48 cases and is reported rather than left implicit." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-169" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Naturalistic language sampling rather than a designed classification task, which is a strength - the speech is spontaneous interaction, not an elicited response to a stimulus. The features derived from it are conversational as well as lexical: Mean Length of Turn Ratio measures the child's turn length relative to the adult's, capturing conversational participation rather than isolated production." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-169" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No modality fusion - text alone, deliberately. The paper's argument is that excluding audio and video is the point, since transcripts avoid identifiable biometric data, and it acknowledges the cost: prosodic features indicative of atypical speech cannot be captured in text. Its future-work proposal to add limited prosodic cues while preserving text-level privacy is an explicit privacy-information trade-off, which no other study in this corpus formulates." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-169" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Computational linguistics; Machine learning; Artificial intelligence; Feature importance; Autism spectrum disorder (ASD); Privacy. Privacy as a keyword reflects the paper's organising argument rather than being decorative." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-169" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "ASD, autism spectrum disorder, children with ASD, typically developing, delayed development. The register is neutral and the paper's framing is unusually ethics-forward: it argues that a major drawback of facial-image approaches is the invasion of privacy, especially for minors, and the need to collect their images over prolonged periods of their childhood, and that MRI-based approaches rely on invasive data collection raising ethical and privacy concerns. One phrase slips - facial features recorded at the onset of the disease - but the overall orientation treats the children's data as something requiring protection rather than as a resource." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-169" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None for acquisition; transcripts retrieved through TalkBank APIs. Modelling used logistic regression, random forest and TabNet with grid-searched hyperparameters; no software, version or seed is named." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-169" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Eighty-six children across two independently collected public corpora. Eigsti et al.: 48 children aged 3-6 in three balanced groups of 16 - typically developing, developmental delay and ASD - each recorded in a 30-minute free-play session, with ethnic composition reported (39 White, 3 LatinX, 6 African-American). Nadig and Bang: 38 children, 26 typically developing and 12 with ASD, sampled at three time points over a year in parent-child interactions. The analysis unit is the child throughout, and the two corpora are analysed separately, merged, and - for Eigsti - as a three-class problem. The presence of a developmental-delay group is the design's most valuable feature and is the reason this study can say something the rest of the speech branch cannot." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-169" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Well executed. Logistic-regression coefficients were accumulated across all five cross-validation folds and averaged rather than taken from a single fit, and the resulting ranking was then tested by refitting on the top four non-part-of-speech features alone, which reproduced nearly the same 86% accuracy. That reduced-model check is a genuine validation of the importance ranking rather than an assertion, and it supports the paper's privacy argument directly - fewer features means less data collection. The named features are clinically interpretable, and their directions are stated. The one problem is that age is among them, and age is confounded with group." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-169" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No setting of the authors' own. The source recordings were 30-minute free-play sessions (Eigsti) and parent-child interactions at three time points over a year (Nadig), both naturalistic language-sampling protocols from developmental research rather than screening paradigms." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-169" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The design is sound in structure and limited by two things the paper handles unevenly. Structurally: 5-fold stratified cross-validation at the child level, grid-searched hyperparameters under the same scheme, an explicit overfitting check reporting a train-validation gap of no more than 4% with the small sample sizes named as the reason for checking, SMOTE confined to the one imbalanced corpus and validated by Kolmogorov-Smirnov tests showing near-identical distributions, and six metrics reported for every configuration. That is careful work. Two problems remain. The first is confounding, and it is visible in the paper's own table: in the Nadig corpus the typically developing children average 29 and 34 months while the ASD children average 61 and 53 months - roughly a two-year gap - and the ASD group is 83% male against 58%. Age is then included as a feature and identified as one of the four that carry the signal. A classifier separating a four-year-old from a two-and-a-half-year-old on utterance length and vocabulary is doing developmental rather than diagnostic work, and the Nadig ROC-AUC of 0.93 cannot be separated from that. The Eigsti corpus is better matched (TD 40-45 months, ASD 55-56) and yields a lower 0.87. The second is the placement of SMOTE relative to the folds, which is not stated - though the distributional validation is more than most studies provide. Against these, the study's most valuable number is the one it foregrounds itself: 0.71 for the three-class task including developmental delay, against 0.87-0.93 for ASD versus typical development. The gap is internally controlled - same features, same corpus, same pipeline - and it quantifies how much of the binary performance is autism-specific rather than a general clinical-versus-typical distinction." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-169" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Fifty-two tabular features per child spanning participant details, utterance statistics, stem words and parts of speech. The inclusion of age among the predictors is the study's principal unaddressed problem: the two groups in the Nadig corpus differ in mean age by roughly two years by the authors' own table, and age is reported as one of the four features that carry the result." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-169" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The stated goal is to test whether privacy-preserving machine learning on speech transcripts can screen for ASD, on the argument that structured text avoids identifiable biometric data such as raw audio or video. Headline findings: ROC-AUC 0.93 on Nadig and 0.87 on Eigsti binary with logistic regression, approximately 0.96 on the merged data with TabNet, accuracy above 86% on both binary datasets, and a four-feature model reproducing nearly the same 86%. The result the authors themselves flag as important is the three-class Eigsti task, where the best ROC-AUC falls to 0.71." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-169" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Six metrics per model per configuration - accuracy, precision, recall, F1, ROC-AUC and p-values - with the rationale for each stated. The reporting is complete and the paper draws the right comparison from it: ROC-AUC 0.93 for ASD versus TD in Nadig, 0.87 in Eigsti, roughly 0.96 merged, and 0.71 for the three-class task including developmental delay. Missing: confidence intervals, fold variance, and the majority-class baselines - which matter particularly for Nadig, where 26 TD against 12 ASD gives a 68.4% baseline against a reported accuracy above 86%." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-169" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Inherited from two peer-reviewed developmental-language studies, whose own diagnostic procedures are cited but not summarised. Governance is handled by reference to TalkBank's contribution requirements, which oblige contributing researchers to obtain informed consent from participants or guardians and the necessary ethical approvals before sharing. That is a reasonable basis for secondary analysis of a curated academic repository and is stated rather than assumed - a different situation from the web-scraped and platform-hosted collections elsewhere in this review." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-169" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional analysis of longitudinally collected data. Ethics rests on TalkBank's stated requirement that contributors obtain informed consent and ethical approval before sharing, which the paper cites explicitly. The privacy argument is the paper's organising claim and it is stated with appropriate qualification: the authors acknowledge that they have not implemented explicit cryptographic privacy measures such as differential privacy or encryption, and claim only that text-based inputs inherently avoid identifiable biometric data. That qualification, placed in the abstract, is more careful than the unqualified privacy-preserving claims made elsewhere in this corpus." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-169" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Broader age ranges, more diverse environments and dialects, transfer learning from larger speech corpora, features capturing developmental-delay-specific nuances, conversational agents or robotic assistants for scalable screening, and a multimodal extension adding limited prosodic cues while preserving the privacy advantage of text. The last is a considered trade-off rather than a generic call for more modalities." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-169" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Substantive and mostly well aimed. Stated: the small size and limited diversity of the corpora, particularly the narrow 3-6 year age range; the absence of prosodic information - pitch, rhythm, intonation - which text cannot represent and which is indicative of atypical speech in autism, an honest acknowledgement that the privacy advantage carries an information cost; the risk of overfitting given 48 and 38 participants, addressed by a quantified train-validation comparison; and the markedly lower performance on the three-class task, read as showing that features specific to developmental delay are needed to reduce misdiagnosis risk. Not stated: that the ASD and TD groups in the Nadig corpus differ in mean age by roughly two years and that age is one of the four features the paper identifies as carrying the signal." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-169" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Moderate to high. Both corpora are public and linked with their source studies cited; participant counts, sex, mean ages, total words and utterance statistics are tabulated by group; the feature count is given; the selected hyperparameters are reported for all three models; the SMOTE validation is quantified with KS statistics and p-values; and the overfitting check is reported as a numerical train-validation gap. Missing: code, seed, software versions, the complete 52-feature list, and the placement of SMOTE relative to the folds." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-169" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Scientific Reports 15(1):34134 (Nature Portfolio). A multidisciplinary venue. The reporting reflects it: demographic tables by group and sex, six metrics with stated rationales, a quantified overfitting check, KS validation of the oversampling, and a limitations section that names the information cost of the privacy choice." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-169" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No severity or cognitive instrument is reported. The Eigsti developmental-delay group provides a partial control for general developmental level in the three-class analysis, which is the closest the study comes to separating autism-specific from delay-general language differences." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-169" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Framing is screening-support and privacy-forward, and both claims are qualified in the abstract itself - the models are described as a foundation for future applications in clinical and educational contexts, and the privacy claim is explicitly limited to the absence of biometric data rather than to any cryptographic guarantee, with the authors stating that they have not implemented differential privacy or encryption. The paper's contribution to this review is twofold. It is the only study in the corpus to make privacy the design criterion and to argue explicitly that facial-image approaches invade the privacy of minors - a critique that applies directly to the sixteen facial-image studies charted here, several of which reuse web-scraped photographs of identifiable children with no ethics statement. And its three-class result (ROC-AUC 0.71 including developmental delay, against 0.87-0.93 against typical development) joins local_b6ac2b98 and local_69b10fe4 as the review's differential-diagnosis calibration points." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-169" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Expressive language and conversational participation in spontaneous interaction. The two leading features are behaviourally specific and directionally interpretable: Mean Length of Utterance, where lower values indicate shorter and simpler utterances and are associated with higher ASD likelihood, and Mean Length of Turn Ratio, the child's turn length relative to the adult's, where lower values indicate that the child contributes less to conversational exchange. Both correspond to well-established clinical observations, and the paper relates them accordingly rather than presenting them as discoveries." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-169" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The most complete demographic reporting in the speech branch. Sex, participant counts, mean ages, total words and mean and median utterance lengths are tabulated by group and by sex for both corpora, and Eigsti's ethnic composition is given. That reporting is what makes the study's central confound visible: in the Nadig corpus the typically developing children have mean ages of 29 and 34 months while the ASD children have mean ages of 61 and 53 months, a gap of roughly two years, and the ASD group is 83% male against 58% in the TD group. The authors note the age difference explicitly, attributing it to the significant language delays typically observed in children with ASD - but they then include age in the feature set." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-169" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "Three algorithms across four dataset configurations - Nadig binary, Eigsti binary, merged, and Eigsti three-class - with six metrics each." ;
                    slr:study_design "Retrospective secondary analysis of two public child-language corpora; supervised classification (binary ASD versus TD in each corpus and merged, plus three-class ASD/TD/DD in one)…" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: 16 with ASD in Eigsti (12 male, 4 female; mean ages 56 and 55 months) and 12 in Nadig (10 male, 2 female; mean ages 61 and 53 months).; comparison: Eigsti: 16 typically developing (13 male, 3 female; mean ages 40 and 45 months) and 16 with developmental delay (14 male, 2 female; mean ages 57 and 54 months) - a genuine second clinical comparison group. Nadig: 26 typically developing (15 male, 11 female; mean ages 29 and 34 months)." ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "Logistic regression reached ROC-AUC 0.93 on Nadig and 0.87 on Eigsti binary; TabNet reached approximately 0.96 on the merged dataset; and random forest reached only 0.71 on the three-class Eigsti task distinguishing ASD, TD and developmental delay. Accuracy above 86% is reported across both binary datasets, and a model using only the top four non-part-of-speech features achieved nearly the same 86" ;
                    slr:outcome "Six metrics - accuracy, precision, recall, F1, ROC-AUC and p-values - for every model and configuration, with the rationale for each stated (precision and recall for medical evaluation, F1 to consolidate them, ROC-AUC for skewed data)." ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "Logistic regression reached ROC-AUC 0.93 on Nadig and 0.87 on Eigsti binary; TabNet reached approximately 0.96 on the merged dataset; and random forest reached only 0.71 on the three-class Eigsti task distinguishing ASD, TD and developmental delay. Accuracy above 86% is reported across both binary datasets, and a model using only the top four non-part-of-speech features achieved nearly the same 86" ] ] ;
    slr:content_sha256 "885121ec9c79b63cbb451abc270217d9217c938322f51492fa629440d281adb7" ;
    slr:full_text_artifact [ a slr:StoredArtifact ;
            prov:wasDerivedFrom <urn:slr:article:8f4dcae4a760> ;
