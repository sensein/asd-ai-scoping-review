    slr:journal "Journal of Neurodevelopmental" ;
    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "Participant-level 80/20 split with all participants entering the analysis and outlier removal quantified per feature. But the test partitions contain roughly 13 to 19 participants and no confidence interval accompanies any accuracy figure." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "Three groups recruited through condition-specific charities and verified research databases, with documentary evidence of formal clinical diagnosis required, mutual exclusion between conditions, and exclusion of co-occurring movement or developmental disorders. Gender and non-verbal reasoning matched; both clinical groups age-matched to controls; the unmatched ASD-PD age difference, and the significant depression and anxiety differences, are controlled statistically and residualised from the classification inputs." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "Kinematic features derived from a standardised stylus task with fully reported outlier and transformation procedures, and all three classifiers reported rather than the best. However, the discriminatory feature sets were selected by group-difference significance computed over all participants, so configurations using them saw held-out labels during selection." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "Documented formal clinical diagnoses, with the authors explicitly noting that absence of a diagnosis does not exclude undiagnosed cases and that the PD and control cohorts predate widespread autism diagnosis." ] ;
            slr:overall_judgment "some" ;
            slr:tool_used "QUADAS-2" ] .

<https://doi.org/10.21437/interspeech.2017-1007> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Autism spectrum disorder (ASD) is a neurodevelopmental disorder usually diagnosed in or beyond toddlerhood. ASD is deﬁned by repetitive and restricted behaviours, and deﬁcits in social communication. The early speech-language development of individuals with ASD has been characterised as delayed. However, little is known about ASD-related characteristics of pre-linguistic vocalisations at the feature level. In this study, we examined pre-linguistic vocalisations of 10-month-old individuals later diagnosed with ASD and a matched control group of typically developing individuals (N = 20). We segmented 684 vocalisations from parent-child interaction recordings. All vocalisations were annotated and signal-analytically decomposed. We analysed ASD-related vocalisation speciﬁcities on the basis of a standardised set (eGeMAPS) of 88 acoustic features selected for clinical speech analysis applications. 54 features showed evidence for a differentiation between vocalisations of individuals later diagnosed with ASD and controls. In addition, we evaluated the feasibility of automated, vocalisation-based identiﬁcation of individuals later diagnosed with ASD. We compared linear kernel support vector machines and a 1-layer bidirectional long short-term memory neural network. Both classiﬁcation approaches achieved an accuracy of 75% for subject-wise identiﬁcation in a subject-independent 3-fold cross-validation scheme. Our promising results may be an important contribution en-route to facilitate earlier identiﬁcation of ASD." ;
    dcterms:bibliographicCitation "Pokorny FB; Schuller B; Marschik PB; Brueckner R; Nyström P; Cummins N; Bölte S; Einspieler C; Falck-Ytter T (2017). Earlier identification of children with autism. **. https://doi.org/10.21437/interspeech.2017-1007" ;
    dcterms:creator "Brueckner R",
        "Bölte S",
        "Cummins N",
        "Einspieler C",
        "Falck-Ytter T",
        "Marschik PB",
        "Nyström P",
        "Pokorny FB",
        "Schuller B" ;
    dcterms:title "Earlier identification of children with autism" ;
    bibo:doi "10.21437/interspeech.2017-1007" ;
    bibo:pmid "local_7b3e6b3a" ;
    fabio:hasPublicationYear 2017 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are comparison groups matched on the variables that matter?" ;
                            slr:justification "Exact age (all 10 months), exact sex balance (5/5 in each group), and family-language balance." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the sample appropriate and adequate for the stated target?" ;
                            slr:justification "n=20 - the authors state plainly that impact is limited by the small number of subjects." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are participants and recruitment adequately described?" ;
                            slr:justification "Cohort provenance, risk status, outcome ascertainment and per-subject characteristics are all reported, including pacifier use." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "some concerns" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the elicitation setting appropriate for the population?" ;
                            slr:justification "Naturalistic parent-child free play with personnel absent, minimising task demands on a 10-month-old." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the behavioral data acquisition described reproducibly?" ;
                            slr:justification "Camera model and placement, recording length, audio format and sampling rate, segmentation criterion, exclusion of vegetative sounds and the annotation scheme are all specified." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are predictors defined without knowledge of outcome?" ;
                            slr:justification "Segmentation and annotation were performed by an author blinded to group membership, and features are extracted automatically by openSMILE." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the reference standard appropriate and independently applied?" ;
                            slr:justification "DSM-5 diagnosis at 3 years, prospectively and independently of the acoustic data." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "low" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is there external or independent validation?" ;
                            slr:justification "None; larger datasets are named as required future work." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the sample size adequate?" ;
                            slr:justification "20 subjects; the subject-level result rests on 15 of 20 correct assignments." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are multiple comparisons corrected?" ;
                            slr:justification "54 of 88 features declared significant at alpha 0.05 with no correction reported." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is model selection separated from performance estimation?" ;
                            slr:justification "A dedicated development partition selects the SVM complexity parameter, BLSTM architecture and early-stopping point; only then are train and development merged for final testing." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the validation scheme subject-independent?" ;
                            slr:justification "Explicitly subject-independent 3-fold partitioning, with partitions matched for gender and diagnosis and published per subject." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "some concerns" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the dataset accessible or its access conditions stated?" ;
                            slr:justification "No data availability statement; cohort recordings of infants." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are sample bias and limitations discussed?" ;
                            slr:justification "Sample size and the sample-size-dependence of the model comparison are acknowledged; the high-risk sibling design and the uncorrected multiple testing are not." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are ethics, consent and privacy handling reported?" ;
                            slr:justification "Ethical review board approval is noted in a footnote; no consent statement, anonymization or data-protection provision for infant audio-video." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is code or an implementation available?" ;
                            slr:justification "No code release, but the pipeline uses an open feature standard and open toolkits with hyperparameters and partitions published, so it is largely re-implementable." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are negative and null results reported?" ;
                            slr:justification "The absence of a volubility difference and the failure of the BLSTM to outperform the SVM are both reported plainly rather than omitted." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "some concerns" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two groups of 10: infants at heightened familial risk (younger siblings of children with ASD) later diagnosed with ASD at 3 years, and typically developing infants from a low-risk population with normal 3-year outcome. Both groups fully specified per subject in Table 1, including vocalisation counts and cross-validation partition assignment - subject-level transparency that is rare in this corpus. No other-diagnosis group." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-009" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Handcrafted standardised acoustic features: the 88-parameter eGeMAPS set of statistical functionals computed over 25 smoothed low-level descriptors per vocalisation. The BLSTM additionally consumes the descriptors on 10 ms time steps, so the deep model sees a frame-level time series while the SVM sees utterance-level functionals - a representation difference the paper does not foreground." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-009" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Goal: earlier identification - characterise ASD-related acoustic specificities in pre-linguistic vocalisations and test the feasibility of automated identification. Main findings: 54 of 88 eGeMAPS features differed significantly between groups (five with |r| > 0.3, strongest being mean spectral slope 0-500 Hz over unvoiced segments at r = 0.3966); vocalisation-level UAR 64.5% (SVM) and 62.9% (BLSTM); subject-level accuracy 75% with optimised thresholds (70% at a fixed 0.5 threshold), correctly assigning 8/10 ASD and 7/10 TD infants. Volubility did not differ between groups (p = 0.104), a negative result reported plainly." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-009" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No data availability statement and no code release, but reproducibility of the method is comparatively strong: the feature set is a published open standard (eGeMAPS) extracted with an open-source tool (openSMILE), both classifiers use widely available toolkits (Weka, TensorFlow), the SVM complexity grid is stated, the BLSTM architecture search outcome (one layer, eight cells), time step (10 ms), optimiser and early-stopping rule are given, the exact cross-validation partitions are published per subject in Table 1, and the optimised per-fold decision thresholds are listed. This is among the most re-implementable pipelines in the corpus; only the cohort recordings are unavailable." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-009" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Laboratory setting - a closed recording room with ceiling-mounted cameras, deliberately arranged so parents would play as they would at home and with study personnel absent during recording. Existing data: retrospective analysis of recordings collected within the EASE (Early Autism Sweden) longitudinal high-risk sibling study." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-009" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The strongest validation design among the early speech studies here: subject-independent 3-fold cross-validation with partitions matched for gender and diagnosis and balanced for vocalisation count, and a genuine three-way train/development/test split in which the SVM complexity parameter, the BLSTM architecture and the early-stopping point are all selected on development data only. Confusion matrices and fold standard deviations are reported. Weaknesses: the headline subject-level accuracy uses thresholds optimised on the merged training and development partitions of each fold, which is defensible but should be read alongside the 70% fixed-threshold result; there is no external or independent validation and no held-out site; class imbalance is handled by reporting UAR rather than by resampling; and no real-time or deployment evaluation is performed, though a paediatric-examination scenario is proposed." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-009" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "'children with autism spectrum disorder', 'individuals with ASD', 'individuals later diagnosed with ASD', 'infants later diagnosed with ASD', 'the ASD group', 'typically developing (TD) infants', 'TD controls', 'affected individuals'. Consistently person-first, and notably careful in using 'later diagnosed with ASD' for the infants, which correctly avoids attributing a diagnosis to a 10-month-old who did not yet have one." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-009" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "INTERSPEECH 2017 (18th Annual Conference of the International Speech Communication Association) - a technology/computational venue (speech science and signal processing), not an autism or clinical venue, though the author list spans developmental neuroscience, child psychiatry and machine learning." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-009" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Hardware: Panasonic HC-V700 camcorders ceiling-mounted in the room corners so infant behaviour could be captured continuously regardless of orientation; audio extracted from one camera as single-channel 44.1 kHz AAC. Software: Noldus Observer XT for video coding and segmentation; openSMILE (audEERING) for eGeMAPS extraction; Weka with sequential minimal optimisation for SVM training; TensorFlow with the Adam optimiser for the BLSTM." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-009" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Speech-language developmental level was annotated using the Stark Assessment of Early Vocal Development-Revised (SAEVD-R), recording whether each infant produced vocalisation types more complex than single canonical syllables - 4 ASD and 4 TD infants did, so the groups were comparable on this measure. No cognitive, adaptive or IQ measures are reported, and comorbid conditions are not described. Pacifier use during recording is noted for three infants, and one misclassified TD infant is flagged as having used one - an unusually granular disclosure of a potential acoustic confound." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-009" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Speech/voice: pre-linguistic infant vocalisations (babbling and other non-vegetative vocal breathing groups) characterised by spectral, energy and frequency-related acoustic parameters. No linguistic content, since the infants are pre-verbal. Parental voice is present in the recordings but is not analysed." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-009" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Larger and more fine-grained studies; systematic comparison of alternative acoustic feature sets; alternative feature pre-processing such as bag-of-words representations; and other deep learning architectures. The authors also sketch the intended deployment scenario - early preventative judgements from vocalisations captured during routine paediatric examinations in the first year of life - which frames the eventual clinical target rather than a research step." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-009" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Single modality; no fusion. Video was recorded but used only for segmentation and annotation, not as a modelling input - a notable choice given that the same recordings could have supported gaze or motor analysis. Within the modality, per-vocalisation decisions are aggregated into a subject-level judgement by computing an ASD ratio and thresholding it, which is a late/decision-level fusion across utterances." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-009" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Reported by the authors: the small number of subjects limits the impact of the results, and a genuine performance difference between SVM and deep learning 'might only become evident on a dataset with a considerably higher number of vocalisations'. They also note that a proportion of ASD infants' vocalisations carry no acoustic atypicality, and disclose pacifier use as a possible source of error for one misclassified control. Identifiable in review: n=20 makes the 75% subject-level figure equivalent to 15/20 correct with a very wide confidence interval; the headline 75% uses per-fold optimised thresholds rather than the fixed 0.5 threshold (70%); vocalisation counts are unbalanced between groups (259 ASD vs 425 TD) and per subject (9 to 98), so subject-level ratios rest on very different amounts of evidence; 54 of 88 features are declared significant with no multiple-comparison correction, so a substantial share are likely false positives; and the high-familial-risk sibling design means the ASD group is not representative of general-population screening." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-009" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "ASD diagnosis at 3 years of age using DSM-5 criteria within the EASE longitudinal cohort; TD status confirmed by normal outcome at the same 3-year assessment. The specific instruments used at the 3-year assessment are not named in this paper. Group membership was withheld from the annotator during segmentation." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-009" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Supervised learning. Algorithms: linear-kernel SVM (Weka SMO) as the baseline, chosen for robustness and insensitivity to feature overfitting, and a one-layer bidirectional LSTM neural network with eight cells as the deep-learning alternative. The comparison is reported as effectively a tie, which the authors attribute to sample size rather than to the architectures." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-009" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Univariate Mann-Whitney U tests with effect size r, with the top ten features tabulated and the strongest visualised as per-group probability density estimates. Most informative features are voice-quality and spectral-balance measures over unvoiced segments - spectral slope 0-500 Hz and 500-1500 Hz, Hammarberg index, alpha ratio - together with MFCC variability, unvoiced segment length, f0 mean and range, and voiced segments per second. No model-internal importance (no SVM weights or BLSTM attribution) is reported, and the acoustic-phonetic interpretation of the differences is left undeveloped." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-009" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A semi-standardised free-play parent-child interaction on a mat with toys, 12 minutes per infant, with parents instructed to play as at home. No task demands were placed on the infant. Vocalisations were then manually segmented by vocal breathing groups using Noldus Observer XT, with vegetative sounds excluded, and annotated for developmental complexity against SAEVD-R by an annotator blinded to group membership." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-009" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The parent study is longitudinal - infants recorded at 10 months with diagnostic outcome at 3 years, a 26-month prospective interval - but the acoustic analysis itself is cross-sectional at the single 10-month recording. Data are highly sensitive: audio-video of identifiable infants and their parents in intimate play interaction. Ethical review board approval at the participating centres is stated in a single footnote; there is no consent statement, no anonymization or de-identification procedure, and no data-protection or access-control provision despite the media type." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-009" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Index terms: autism spectrum disorder, early identification, infant vocalisation analysis, speech-language pathology. Task vocabulary: 'earlier identification', 'automatic vocalisation-based approach', 'early acoustic markers', 'pre-linguistic vocalisations', 'feasibility', 'en-route to'. The framing is markedly more cautious than most of the corpus - the claim is feasibility and markers, not diagnosis." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-009" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Unweighted average recall as the primary metric with weighted average recall alongside, both reported with standard deviations across folds; full vocalisation-level confusion matrices for both classifiers; and subject-level accuracy at two explicitly stated thresholds. Using UAR rather than accuracy is the methodologically correct choice for the unbalanced 259-vs-425 vocalisation split, and this is one of the few corpus studies to make it." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-009" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "ASD n=10 (5 male, 5 female); TD n=10 (5 male, 5 female). All infants exactly 10 months old at recording, so age is matched by design with no variance. Gender is exactly balanced within and across groups, and the authors additionally describe the sample as family-language-balanced. This is one of the very few corpus studies with perfect sex balance - though at n=20 total it is also among the smallest. Highly relevant to early diagnosis: 10 months is the youngest recording age in the corpus, with outcome ascertained 26 months later." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-009" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2017. The paper notes that early speech-language development in ASD has repeatedly been characterised as delayed and deviant but that only a few studies examine vocalisation specificities at the feature level, and that most of those assessed crying with single acoustic features such as fundamental frequency or duration. It positions itself as one of the first to explore ASD-related pre-linguistic vocalisation specificities across a wide standardised parameter set - documenting the shift from single hand-picked acoustic measures to standardised high-dimensional feature sets that characterises the speech strand of this corpus." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-009" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "Single 12-minute parent-child interaction recording per infant (240 minutes total across 20 infants); outcome diagnosis established at 3 years of age" ;
                    slr:study_design "Retrospective analysis nested in a prospective longitudinal high-risk sibling cohort (EASE, Early Autism Sweden); cross-sectional classification at the 10-month recording" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder (younger siblings at heightened familial risk, later diagnosed)" ;
                    slr:sample_size_text "ASD/index: 10 (5 male, 5 female); comparison: 10 (5 male, 5 female)" ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "Pre-linguistic vocalisations of 10-month-olds later diagnosed with ASD differ measurably from those of typically developing infants: 54 of 88 standardised acoustic features showed significant group differences, five with moderate effect sizes, with spectral-slope and unvoiced-segment measures strongest. Automated identification is feasible but modest - 64.5% UAR per vocalisation and 75% subject-le",
                        "Vocalisation-level: SVM UAR 64.5% +/- 3.3% (WAR 69.0% +/- 2.6%); BLSTM UAR 62.9% +/- 2.0% (WAR 70.7% +/- 2.6%). Subject-level: both approaches 70% accuracy at a 0.5 majority-vote threshold and 75% with optimised thresholds - 8 of 10 ASD and 7 of 10 TD infants correctly assigned. Volubility did not differ between groups (Mann-Whitney p = 0.104)" ;
                    slr:outcome "Unweighted average recall (UAR) and weighted average recall (WAR) with standard deviations across folds, full confusion matrices at the vocalisation level, and subject-wise accuracy at both a fixed 0.5 threshold and an optimised threshold" ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "Vocalisation-level: SVM UAR 64.5% +/- 3.3% (WAR 69.0% +/- 2.6%); BLSTM UAR 62.9% +/- 2.0% (WAR 70.7% +/- 2.6%). Subject-level: both approaches 70% accuracy at a 0.5 majority-vote threshold and 75% with optimised thresholds - 8 of 10 ASD and 7 of 10 TD infants correctly assigned. Volubility did not differ between groups (Mann-Whitney p = 0.104); Pre-linguistic vocalisations of 10-month-olds later diagnosed with ASD differ measurably from those of typically developing infants: 54 of 88 standardised acoustic features showed significant group differences, five with moderate effect sizes, with spectral-slope and unvoiced-segment measures strongest. Automated identification is feasible but modest - 64.5% UAR per vocalisation and 75% subject-le" ] ] ;
