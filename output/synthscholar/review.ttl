    slr:journal "PsyCh Journal, 10(4), 550-565" ;
    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "Three age-matched groups with the high-functioning and typically developing groups additionally matched on both verbal and nonverbal intelligence, all with tabulated cognitive and SCQ scores and tested pairwise comparisons; the untested sex imbalance is the only residual concern and is acknowledged." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "Trial exclusion rates reported per group (1.16%, 3.54%, 0.81%), calibration acceptance criterion stated quantitatively, absence of a learning effect verified before pooling trials, and the experimenter blind to functioning subgroup." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "All 68 features used without selection, the single hyperparameter fixed by piloting on an external dataset, subject-wise leave-one-out cross-validation, and no optimisation performed on the evaluation data." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "DSM-5 diagnoses by pediatricians at licensed hospitals corroborated by above-threshold Chinese SCQ scores for every autistic participant, with the unavailability of validated Chinese ADOS and ADI-R disclosed and explained." ] ;
            slr:overall_judgment "low" ;
            slr:tool_used "QUADAS-2" ] .

<urn:slr:article:0f2f3a5e7d29> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "In this paper, the standard facial expression database FER2013 and CK + are used as the main training samples for autism diagnosis model.The facial expression image data of 16 Chinese children were collected as supplementary training samples.We use deep convolution neural network VGG19 and Resnet18 artificial intelligence algorithms to research and develop an smart information system for the diagnosis of autism through facial expression data.Ten normal children and ten autistic children were recruited for the comparative test to verify the accuracy of the system.After testing, the accuracy of facial expression recognition of this system reaches 81.4%.This research is based on the actual business needs of the hospital. The system can diagnose autism as early as possible,and promote the early treatment and rehabilitation of patients, thereby reducing the economic and mental burden of patients. Therefore, this smart information system has good social benefits and application value." ;
    dcterms:bibliographicCitation "Zhao W (2020). Research and Design of Autism Smart Diagnosis Information System Based on Chinese Children's Facial Expression Data and Deep Convolution Neural Network. *Proceedings of the 53rd Hawaii International Conference on System Sciences*." ;
    dcterms:creator "Zhao W" ;
    dcterms:title "Research and Design of Autism Smart Diagnosis Information System Based on Chinese Children's Facial Expression Data and Deep Convolution Neural Network" ;
    bibo:pmid "local_7547db68" ;
    fabio:hasPublicationYear 2020 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the sample appropriate and adequate for the stated target?" ;
                            slr:justification "Twenty children evaluated for a system the paper claims is 'suitable for the diagnosis of autism for children and adults all over the world'." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are participants and recruitment adequately described?" ;
                            slr:justification "Recruitment institutions, group sizes, sex splits and age ranges are given; nothing else." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is group independent of recruitment site?" ;
                            slr:justification "All autistic children from one Guangzhou centre, all controls from one Zhengzhou school." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are comparison groups matched on the variables that matter?" ;
                            slr:justification "Ages 3-6 versus 5-8 with almost no overlap, on a task whose difficulty depends directly on developmental stage." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the behavioral data acquisition described reproducibly?" ;
                            slr:justification "The prompting protocol, three repetitions and elicitation aids are described; camera specification, distance, lighting and session length are not, though the paper concedes lighting materially affects results." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Can measurement failure be distinguished from clinical signal?" ;
                            slr:justification "A low recognition rate may reflect non-imitation, developmental immaturity, atypical production or out-of-distribution faces; the design cannot separate these from autism." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the reference standard appropriate and independently applied?" ;
                            slr:justification "One sentence attributing diagnosis to an unnamed professional physician; controls confirmed by parent report." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Does the measured behaviour match the construct claimed?" ;
                            slr:justification "The motivating literature concerns autistic people's difficulty recognising others' expressions; what is measured is the system's ability to classify the child's produced expression." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is a model trained against the diagnostic outcome?" ;
                            slr:justification "The CNNs classify expression categories only; diagnosis is a hand-set threshold on their agreement with the prompt." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is any cross-validation or held-out evaluation performed?" ;
                            slr:justification "No split, no folds, no held-out set, and no accuracy reported on FER2013 or CK+." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are diagnostic performance metrics reported?" ;
                            slr:justification "Only recognition rate; no sensitivity, specificity, AUC or statistical test, despite the data permitting them." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are training details sufficient to reproduce the models?" ;
                            slr:justification "No hyperparameters, epochs, augmentation or optimisation details; the 'synthesis' of VGG-19 and ResNet-18 is unspecified." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is training data appropriate to the target population?" ;
                            slr:justification "FER2013 and CK+ are largely adult and posed; the 112 supplementary images came from typically developing 5-8 year olds, the control group's own population." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the decision threshold derived independently of the evaluation data?" ;
                            slr:justification "The 60% cut-off is read off the same twenty children's results it is then applied to, and even so misclassifies two controls at 57.1%." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are per-participant results reported?" ;
                            slr:justification "Per-child recognition rates are given for all twenty children, which is what makes the flaws above verifiable." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Do stated conclusions match the evidence?" ;
                            slr:justification "Twenty children support claims of worldwide applicability, objectivity and accuracy, and the abstract's 81.4% is a proxy-task rate presented as system accuracy." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the dataset accessible or its access conditions stated?" ;
                            slr:justification "No release of the 112 supplementary images or the evaluation data." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is code available?" ;
                            slr:justification "None." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are ethics and consent reported?" ;
                            slr:justification "Parents were informed of the purpose; no committee approval, written consent, anonymization or retention policy, for a study handling children's facial images including a diagnosed clinical group." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "high" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Autistic group: 10 children, 5 boys and 5 girls, aged 3-6, recruited through Guangzhou Children's Care Center. Control group: 10 children, 5 boys and 5 girls, aged 5-8, recruited through Amy Education School in Zhengzhou. Sex is balanced within and across groups, which is unusual for this corpus. Age is not: the ranges barely overlap and the autistic children are systematically younger, which matters because facial expression production, imitation compliance and attention to a screen prompt all change substantially between 3 and 8 years. Recruitment site is fully confounded with group. No means, standard deviations, IQ, developmental level, ethnicity or socioeconomic information is reported for either group." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-036" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The weakest validation in the corpus. No train/validation/test split, no cross-validation, no held-out set, and no reported performance on the source expression datasets. The clinical evaluation is a single pass over 20 children whose groups differ in age and recruitment site, with the decision threshold fitted to those same 20 results. There is no independent sample, no external site, no repeat measurement, and no comparison against the diagnostic scales the system is meant to support - which is notable given the paper analyses those scales item by item to justify its design but never compares its output against them." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-036" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Only recognition rate: the proportion of seven prompted expressions the classifier assigned to the prompted category, reported per expression, per child and per group. No sensitivity, specificity, AUC, precision, recall, F1, confusion matrix or statistical test. Because the threshold rule reduces to a binary decision on 20 children, sensitivity of 10/10 and specificity of 8/10 could be derived, but the paper does not do so and the threshold was chosen on these same data." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-036" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. No IQ, developmental quotient, language, adaptive functioning, symptom severity or comorbidity measure is reported for either group. Severity grading is named only as future work." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-036" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Deep supervised learning: VGG-19 and ResNet-18 convolutional neural networks for seven-way facial expression classification. The paper argues explicitly for deep over traditional approaches, on the grounds that handcrafted features (oriented gradient histograms, Gabor filters, local directional patterns, enhanced local binary patterns) are 'artificial design, time-consuming and laborious' and work well only on small image sets, whereas end-to-end deep models combine feature extraction and classification. Critically, neither network is trained on an autism label - the diagnostic layer is a hand-set threshold on classification agreement, not a learned model." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-036" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two groups of ten: 10 autistic children aged 3-6 from Guangzhou Children's Care Center and 10 typically developing children aged 5-8 from Amy Education School in Zhengzhou. A separate group of 16 typically developing Chinese children aged 5-8 (8 boys, 8 girls) supplied 112 training images. No other-diagnosis comparison group. At 20 evaluation participants this is among the smallest clinical evaluations in the corpus, and it is a system test rather than a model validation." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-036" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "High-definition cameras; client applications for computers and smartphones; a four-layer architecture (application, communication, application server with firewall, database server); SQL Server; HDF5 feature files; JSON over TCP; VGG-19 and ResNet-18. Public training corpora: FER2013 (35,887 images at 48x48, seven expressions) and CK+ (593 sequences from 123 people at 640x480, 69% female, including African American, Asian and South American subjects). A specified non-functional requirement - end-to-end response under 5 seconds - is one of the few deployment constraints stated anywhere in this corpus." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-036" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No multimodal fusion. Adding recognition of children's physical movement to achieve 'diagnosis of autism from multiple perspectives' is named as future work. There is a nominal model-level combination - VGG-19 and ResNet-18 are said to be trained and then 'synthesised' - but no mechanism, weighting or comparative result is given for either model separately, so the combination cannot be evaluated." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-036" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Goal: build a deployable hospital information system that diagnoses autism from facial expression imitation using deep CNNs, reducing subjectivity and physician time and extending early diagnosis to underserved regions. Main findings: mean expression recognition rate of 81.4% in typically developing children versus 34.3% in autistic children; a proposed 60% threshold below which a child is said to show a tendency toward autism; recognition errors in typically developing children concentrated on disgust and surprise; and in autistic children happy and sad were best recognised while neutral and disgust were worst." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-036" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A single modality - facial expression, captured as still images during prompted imitation of seven categories (angry, disgust, fear, happy, sad, surprise, neutral). The behaviour targeted is expression production on demand rather than spontaneous expression or expression recognition ability, although the paper's motivating literature concerns autistic people's difficulty recognising others' expressions, which is a different construct from the one measured." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-036" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional; a single session per child with no follow-up. Data are facial images of identifiable children including a clinically diagnosed group, stored server-side in a SQL Server database and with collection photographs reproduced in the paper. Governance reporting is the weakest in the corpus: parents were informed of the purpose of data collection, but no ethics committee approval, no written consent procedure, no anonymization and no retention or access policy is described - which is a serious omission for a system whose stated deployment path is public download by app or web page." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-036" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Proceedings of the 53rd Hawaii International Conference on System Sciences (HICSS) - an information-systems conference, not a clinical or machine-learning venue, which explains the weighting toward architecture, workflow and deployment over validation. Published under CC BY-NC-ND 4.0 with a stable handle." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-036" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "One sentence: 'The selected children with autism were diagnosed by a professional physician.' No instrument, criteria, date or diagnostician detail. The paper describes ICD-10, DSM-IV, ABC, CARS and CABS as the instruments the collaborating hospitals use, and analyses their facial-expression-related items in detail to motivate the design, but does not state which if any were applied to these ten children. Typically developing status rests entirely on parents answering that their child had no history of autism." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-036" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Poor. The system architecture, network topology, module decomposition, data formats and interface flow are described in detail, but nothing needed to reproduce the machine learning is given: no training procedure, no train/validation/test split, no hyperparameters, no epochs, no augmentation, no accuracy on the source expression datasets, and no description of how the VGG-19 and ResNet-18 outputs were 'synthesised'. No code and no data are released. The clinical evaluation reports per-child recognition rates in full, which is welcome, but no statistical test accompanies them." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-036" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No interpretability method - no saliency maps, no attention visualisation, no feature attribution. What the system exposes instead is a per-expression probability histogram shown to the user, with the maximum-probability bar taken as the prediction, and a per-expression breakdown of which categories failed. This is interface transparency rather than model interpretability: it shows what the model decided, not why. The clinical interpretation offered - that autistic children have facial expression recognition obstacles, so their expressions are harder to classify - is asserted from the prior literature rather than derived from the model." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-036" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Prompted facial expression imitation. The system randomly displays one of seven expressions (angry, disgust, fear, happy, sad, surprise, neutral) and prompts the child by picture and sound to reproduce it, presenting the same expression three times, with elicitation aids such as cartoon smiling faces, children's songs and animations for situational simulation. The design is explicitly modelled on how physicians administer the diagnostic scales - 'The doctor observes the tester's reaction to determine whether the tester is autistic after requesting the tester to make the corresponding expression' - and the paper justifies the choice by itemising the expression-related items in the CABS, ABC and CARS scales." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-036" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Test the system in a large number of cooperating hospitals; collect far more facial expression data from both typically developing and autistic children and build a dedicated children's facial expression database, since existing databases are built mainly from adults and children have rounder faces, larger eyes and less prominent bones that make their features harder to recognise; extend the system to recognise physical movement so autism can be assessed from multiple perspectives; and add severity grading into severe, moderate and mild." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-036" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Raw facial images processed end-to-end, with learned convolutional features persisted as HDF5 feature files for reuse and incremental retraining. Training data are FER2013 (35,887 low-resolution 48x48 images), CK+ (593 sequences from 123 people at 640x480), and 112 images from 16 Chinese children aged 5-8. The mismatch between the training distribution - largely adult, largely posed, mostly non-Chinese - and the target population of 3-6 year old autistic children is the input-representation problem the paper's supplementary collection was meant to address but at 112 images cannot." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-036" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "'autistic children', 'normal children', 'autistic patients', 'children with autism', 'healthy children volunteers'. The autistic/normal contrast is used throughout, and disease framing is explicit - autism is described as 'a representative disease of generalized developmental disorders' undergoing 'a transition from rare diseases to epidemics', with extensive discussion of the financial and psychological burden on families and society. This is the most pathologising vocabulary in the corpus, standing at the opposite end from the identity-first, non-autistic-comparison usage of the Manchester kinematics papers." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-036" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The authors acknowledge that the algorithm 'is affected by the environment and light' and that accuracy suffers accordingly, noting that two typically developing children scored 57.1%; that errors concentrate on disgust and surprise because those expressions involve only minor local facial change and some participants produced them weakly; and that more real samples are needed. They do not acknowledge the design's central problems. No model is trained on autism labels, so a proxy task's failure rate is being treated as a diagnostic signal, and the design cannot separate non-imitation, atypical imitation, developmental immaturity and out-of-distribution faces from autism. The groups differ in age (3-6 versus 5-8) and are fully confounded with recruitment site. The supplementary training images came from typically developing 5-8 year olds, the control group's own population, which biases the classifier toward recognising control-group faces. The 60% threshold is fitted to the same 20 children it is evaluated on. And the abstract's 81.4% is the expression recognition rate in typically developing children, not a diagnostic accuracy, yet is presented as 'the accuracy of facial expression recognition of this system'." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-036" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Testing was conducted in quiet classrooms at two cooperating institutions - Amy Education School in Zhengzhou for the typically developing group and Guangzhou Children's Care Center for the autistic group. System requirements were developed through repeated consultation with physicians at Hubei Maternal and Child Health Hospital, Wuhan Children's Hospital and Guangzhou Women and Children's Medical Center, including direct observation of how they administer the diagnostic scales." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-036" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No formal keyword list. Vocabulary: 'autism smart diagnosis information system', 'deep convolution neural network', 'facial expression recognition', 'system architecture', 'network topology', 'social benefits and application value'. The register is information-systems and deployment-oriented rather than clinical or statistical - the paper's own framing is that it addresses 'the actual business needs of the hospital'." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-036" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2020. The framing is epidemiological and economic rather than methodological: prevalence rising from 3-5 per 10,000 in the 1980s to 2.76% among US children aged 3-14 by 2016; an estimated 10 million people with autism in China including 2 million children, growing by nearly 200,000 annually, with no national statistical survey; 33% of parents reporting that caregiving seriously affected their careers with an average annual income loss of 30,957 yuan. Against that, the paper identifies the bottleneck as clinical throughput and subjectivity - one to two hours per diagnosis, results 'easily disturbed by external factors such as hospital level, physician's subjective level, patient's education level, age' - and positions an app-deliverable CNN system as the answer, with explicit emphasis on remote and underdeveloped areas. The paper is a clear marker of the corpus's deployment-first strand, in which access and cost arguments substitute for validation." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-036" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "One test session per child; the system displays each of seven target expressions three times and collects the child's imitation each time" ;
                    slr:study_design "Systems engineering and development paper with a small two-group validation test; no model is trained on autism labels, and the diagnostic rule is a threshold applied to expression…" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Preschool children with autism" ;
                    slr:sample_size_text "ASD/index: 10; comparison: 10" ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "A client-server system was built in which children imitate seven prompted facial expressions, a CNN classifies each attempt, and agreement with the prompt is scored. Typically developing children's expressions were recognised at 81.4% and autistic children's at 34.3%, and the authors propose a 60% recognition rate as the threshold below which a child 'would have a tendency to suffer from autism', ",
                        "Mean expression recognition rate 81.4% in the typically developing group (per-child: 85.7, 85.7, 85.7, 57.1, 85.7, 100, 71.4, 100, 85.7, 57.1) and 34.3% in the autistic group (28.5, 28.5, 28.5, 42.9, 42.9, 57.1, 28.5, 42.9, 28.5, 14.3). Applying a 60% threshold separates the groups completely on this sample - all ten autistic children fall below 60% and eight of ten controls above - but two typica" ;
                    slr:outcome "Per-expression and per-child recognition rate (proportion of the seven target expressions the system classified in agreement with the prompt), plus group means. No sensitivity, specificity, AUC, confusion matrix or statistical test of the group difference" ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "Mean expression recognition rate 81.4% in the typically developing group (per-child: 85.7, 85.7, 85.7, 57.1, 85.7, 100, 71.4, 100, 85.7, 57.1) and 34.3% in the autistic group (28.5, 28.5, 28.5, 42.9, 42.9, 57.1, 28.5, 42.9, 28.5, 14.3). Applying a 60% threshold separates the groups completely on this sample - all ten autistic children fall below 60% and eight of ten controls above - but two typica; A client-server system was built in which children imitate seven prompted facial expressions, a CNN classifies each attempt, and agreement with the prompt is scored. Typically developing children's expressions were recognised at 81.4% and autistic children's at 34.3%, and the authors propose a 60% recognition rate as the threshold below which a child 'would have a tendency to suffer from autism', " ] ] ;
