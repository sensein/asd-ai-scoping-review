    slr:journal "I" ;
    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "DSM-IV-R for ASD and K-SADS-PL for ADHD under specialist supervision is acceptable, but no structured autism instrument (ADOS/ADI-R) was used and the control group's typical status is asserted rather than assessed." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "Index and reference assessments are contemporaneous, but 'technical problems' caused unequal usable samples and the paper does not report how many participants were enrolled versus analysed." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "No validation scheme is reported at all; random oversampling to balance classes appears to precede classification, and the reported figures are the best classifier, best data type and best class grouping selected post hoc from a large grid." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
