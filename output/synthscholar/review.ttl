    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "Recruitment routes, inclusion and exclusion criteria are fully specified and sex is evenly balanced in both groups, but groups differ in age with the autistic sample 3.75 years older and extending 13 years further, and the classifier demonstrably exploits this (class probability correlated with age at rs = 0.35)." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "Leave-one-participant-out cross-validation with nested three-fold hyperparameter tuning, one aggregate feature vector per participant with an explicit statement of no repeated measures, features restricted a priori by domain knowledge and an independent EMG study, and gender entered as a model feature." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "Prior ICD-10 specialist clinic diagnoses with ADOS in 35 of 37 and ADI-R in 21, AQ for all participants, verbal intelligence confirmed, and controls prospectively excluded for any psychiatric history." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "All exclusions reported with reasons, tracking success quantified (99% of frames at mean confidence 0.99 with no group difference), participant- and frame-level exclusion thresholds pre-stated, and the one participant dropped for missing audio identified." ] ;
            slr:overall_judgment "low" ;
            slr:tool_used "QUADAS-2" ] .

<https://doi.org/10.1109/CBMS52027.2021.00016> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "The use of Eye Tracking (ET) has been investigated as an auxiliary mechanism to diagnose Autism Spectrum Disorder (ASD). One of the paradigms investigated using ET is Joint Attention (JA), which refers to moments when two individuals are focused on the same object/event so that both are aware that the focus of attention is shared. The computational tools that assist in the diagnosis of ASD have used Image Processing and Machine Learning techniques to process images, videos and ET signals. However, the JA paradigm is still little explored and presents challenges, as it requires analyzing the gaze trajectory and needs innovative approaches. The purpose of this article is to propose a model capable of extracting features from a video used as a stimulus to capture ET signals in order to verify JA and classify individuals as belonging to the ASD or Typical Development (TD) group. The main differential in relation to the approaches in the literature is the deﬁnition and implementation of the concept of ﬂoating Regions of Interest, which allows monitoring the gaze in relation to an object, considering its semantics, even if the object presents different characteristics throughout the video. A model based on ensembles of Random Forest classiﬁers was implemented to classify individuals as ASD or TD using the trajectory features extracted from the ET signals. The method reached 0.75 accuracy and 0.82 F1-score, indicating that the proposed approach, based on trajectory and JA, has the potential to be applied to assist in the diagnosis of ASD." ;
    dcterms:bibliographicCitation "Cardoso TV; Michelassi GC; Franco FO; Sumiya FM; Portolese J; Brentani H; Machado-Lima A; Nunes FLS (2021). Autism Spectrum Disorder Diagnosis Based on Trajectories of Eye Tracking Data. *2021 IEEE 34th International Symposium on Computer-Based Medical Systems (CBMS), 50-55*. https://doi.org/10.1109/CBMS52027.2021.00016" ;
    dcterms:creator "Brentani H",
        "Cardoso TV",
        "Franco FO",
        "Machado-Lima A",
        "Michelassi GC",
        "Nunes FLS",
        "Portolese J",
        "Sumiya FM" ;
    dcterms:title "Autism Spectrum Disorder Diagnosis Based on Trajectories of Eye Tracking Data" ;
    bibo:doi "10.1109/CBMS52027.2021.00016" ;
    bibo:pmid "local_51a0af74" ;
    fabio:hasPublicationYear 2021 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are participants and recruitment adequately described?" ;
                            slr:justification "Group sizes, sex splits, age ranges and means and CARS scores given; no standard deviations, IQ, comorbidity or recruitment detail." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is control status positively screened?" ;
                            slr:justification "CARS administered to the typically developing group, all scoring below the 30-point threshold." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are comparison groups matched on the variables that matter?" ;
                            slr:justification "Means and sex proportions match; ranges differ at both ends over a 3-18 year span with no test or adjustment." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the sample appropriate and adequate for the stated target?" ;
                            slr:justification "86 participants is among the larger single-site eye-tracking cohorts in the corpus." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "some concerns" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the reference standard appropriate and independently applied?" ;
                            slr:justification "DSM-5 plus CARS by specialists, with the same instrument applied to both groups and scores reported." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the behavioral data acquisition described reproducibly?" ;
                            slr:justification "Tracker model, sampling rate, head-movement tolerance, viewing distance, stimulus resolution and duration, segment boundaries with frame counts, and fixation and visit definitions all specified." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are predictors defined without knowledge of outcome?" ;
                            slr:justification "Features are computed automatically from gaze records against specialist-demarcated regions defined on the stimulus, not on participant data." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Does the feature construction match the target construct?" ;
                            slr:justification "Floating regions track referents by semantic identity and the anticipation feature permits gaze arriving before the referent appears, matching the anticipatory character of joint attention." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "low" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the segment-selection finding independently tested?" ;
                            slr:justification "Segments 1, 3 and 8 emerge from an exhaustive search over all subsets, with the joint attention interpretation applied afterwards." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is a single-model baseline over concatenated features reported?" ;
                            slr:justification "The benefit of segment-wise decomposition itself is never isolated against a pooled-feature classifier." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is uncertainty quantified?" ;
                            slr:justification "No confidence intervals, per-fold variability or statistical comparison between the three strategies." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is class balancing confined to training data?" ;
                            slr:justification "SMOTE applied to training samples only, stated explicitly." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is model selection separated from performance estimation?" ;
                            slr:justification "511 classifier subsets, three strategies, swept thresholds, five balancing methods and per-segment hyperparameter grids all scored on the reporting cross-validation with no outer loop." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are metrics adequate to expose the sensitivity-specificity trade-off?" ;
                            slr:justification "All five metrics reported, revealing specificity of 0.53 for the best model and 0.30 for the highest-F1 alternative." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are limitations stated?" ;
                            slr:justification "Class imbalance, dependence on therapist demarcation and scope for better methods are all named." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are ethics and consent reported?" ;
                            slr:justification "No committee approval, consent procedure or governance statement, with participants as young as 3 recruited through a university psychiatry department." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are descriptive group differences reported?" ;
                            slr:justification "No means, distributions or tests for any of the 15 features by group, despite feature design being the paper's contribution." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the low specificity addressed?" ;
                            slr:justification "Defended as appropriate for a sensitive rule-out test, but the consequence of referring roughly half of typically developing children onward is not discussed." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the dataset accessible or its access conditions stated?" ;
                            slr:justification "No release or availability statement." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is code available?" ;
                            slr:justification "Libraries and search grids named; no code and no selected hyperparameter values." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "high" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "'individuals with ASD', 'children with ASD', 'Typical Development (TD)', 'patients'. Person-first in most places, with 'patients' used once for the whole sample. The framing is neutral and developmental rather than deficit-laden, describing autism as 'a neurodevelopmental disorder with clinical presentation and varied functional impact' and grounding joint attention in normal development - infants follow gaze within days of birth and develop referential understanding of gaze cues over the first two years." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-053" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Autistic group: 56 participants, 38 male and 18 female, aged 5-18 with mean 10. Typically developing: 30 participants, 20 male and 10 female, aged 3-15 with mean 10. Means match exactly and sex proportions are close (68% versus 67% male), but the age ranges differ at both ends, no standard deviations are given, and no statistical test of matching is reported. The age span is wide - 3 to 18 years - across which gaze-following and anticipation in joint attention change substantially, and age is neither modelled nor controlled. CARS scores are reported for both groups (33-45, mean 34.5 for autism; below 30 for typical development), which is more clinical detail than most of the corpus provides. No IQ, language, comorbidity, ethnicity or socioeconomic data." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-053" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Accuracy, sensitivity, precision, specificity and F1 for the best configuration of each ensemble strategy. Reporting all five is what makes the result honestly interpretable and exposes the sensitivity-specificity imbalance that accuracy alone would conceal - the equal-weight ensemble achieves an F1 of 0.81 while correctly classifying only 30% of typically developing participants. No AUC, no confidence intervals, no per-fold variability and no statistical comparison between strategies, so whether 0.75 differs meaningfully from 0.71 on 86 participants is not established." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-053" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Fifteen trajectory and timing features per region per segment, giving nine feature vectors of 15 x R dimensions per participant. Three aspects are distinctive. First, distance-to-centre features (mean, standard deviation, coefficient of variation) capture how tightly gaze is held on a region rather than merely whether it was there. Second, ordinal features (order of longest visit, order of longest fixation) encode sequence position within a segment. Third, the anticipation features permit negative values by searching gaze records from the preceding segment, so a participant whose gaze arrives before the referent appears is distinguished from one who arrives promptly. Missing values, arising when a region was never visited or fixated, are imputed as the segment's final time or order multiplied by an empirically chosen constant of 4 - a defensible encoding of 'never' as an extreme value, though the constant was tuned rather than derived." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-053" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Laboratory eye tracking with participants recruited through the Department of Psychiatry at the University of Sao Paulo's School of Medicine, in collaboration with the School of Arts, Sciences and Humanities and the bioinformatics postgraduate programme. Funded by CNPq, FAPESP/INCT-MACC, CAPES and PRONAS/PCD. No ethics approval statement appears." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-053" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Three purpose-built 10-second joint attention videos at 1920 x 1080, forming a graded series: in video A only the therapist's eyes move; in video B the gaze shifts toward an object of interest; in video C the hand points to the object. Each is segmented at the points where the set of relevant regions changes, giving nine analysed segments in total. The design is unusually well matched to the construct - joint attention involves coordinated mutual engagement with a third entity, so a stimulus that isolates gaze-only, gaze-to-object and gaze-plus-point conditions decomposes the paradigm into its components, and the segment-level ensemble then reveals which components carry information." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-053" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Tobii Pro TX300 with a removable 23-inch monitor, up to 300 Hz sampling and head-movement tolerance to 50 cm/s, at 50-70 cm viewing distance; Python with scikit-learn including GridSearchCV and SMOTE implementations. The 300 Hz sampling against video frame rate yields approximately ten gaze records per frame, which is what makes fine-grained trajectory features and the anticipation measure feasible." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-053" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2021 IEEE 34th International Symposium on Computer-Based Medical Systems (CBMS), pages 50-55 - a medical informatics conference, with authorship spanning computing, bioinformatics and a university psychiatry department." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-053" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Index terms: Autism Spectrum Disorder; Ensemble Method; Eye tracking; Image processing; Joint attention; Machine Learning; Random Forest; Trajectory; Typical Development. 'Trajectory', 'joint attention' and 'image processing' together capture the contribution - the paper is about representing a dynamic referential sequence computationally, with classification as the demonstration." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-053" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Acknowledged: the dataset is imbalanced and synthetic sampling is a stopgap pending more real data; region demarcation still requires a therapist and automatic identification would make the method faster; and accuracy could be improved with other methods such as genetic algorithms for meta-classifier construction. The low specificity is noted and defended rather than treated as a limitation - the authors argue that 'our major goal is to capture all possible individuals with the disorder' and that highly sensitive tests suit early rule-out. Not acknowledged: the reported 75% is the maximum over 511 classifier subsets, three ensemble strategies, swept thresholds, five balancing methods and per-segment hyperparameter grids, all selected on the same 10-fold estimate with no outer validation loop, so the figure is optimistically biased and the segment-1-3-8 finding is a selection outcome rather than an independent result; the practical consequence of 53% specificity - referring roughly half of typically developing children onward - is not discussed; ages span 3-18 with different ranges per group and no adjustment; CARS scores are collected but never related to model output; and no ethics approval is reported." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-053" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No cross-modal fusion - gaze only. The combination that does occur is across time and across regions: nine segment-specific classifiers are ensembled, and the finding is that the whole is greater than any part, with every individual segment classifier below 75% while the best three-segment combination reaches it. This is a temporal rather than sensory fusion result, and it carries a clear message for the corpus's video-based studies - that a joint attention response is a sequence and that classifying any single moment of it underperforms classifying the sequence. The authors' own reading is that segments 1, 3 and 8 'present three fundamental stages of JA' and that 'the complete action process is necessary', though this identification comes from an exhaustive search rather than an a priori hypothesis." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-053" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Specialist evaluation using DSM-5 criteria together with CARS, with the autistic group's scores reported as a range and mean. Notably, CARS was administered to the typically developing group as well, confirming all scored below the 30-point diagnostic threshold - so both groups were assessed on the same instrument and control status is verified rather than assumed. The paper also footnotes the CARS threshold explicitly. What is missing is any account of who performed the assessments, when, or with what reliability, and no ADOS or ADI-R is described." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-053" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Anticipatory and referential gaze during joint attention - specifically whether and when the participant's gaze arrives at, dwells on and returns from the regions a therapist's gaze or gesture directs it toward. The construct targeted is more specific than the social-attention measures elsewhere in the corpus: not how much a child looks at faces, but whether the gaze tracks a referential sequence in time, including whether it arrives before the referent appears. The anticipation feature, which permits negative first-visit times computed against records from the preceding segment, is the direct operationalisation of that." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-053" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No model-explanation method, but the ensemble structure delivers interpretability at the level that matters clinically. Because each classifier corresponds to a specific video segment, the winning combination identifies which moments of the joint attention sequence carry discriminative information - here the gaze at rest, the gaze shifting to the object, and the gaze returning. The authors also report that regions containing the eyes outperformed regions containing the therapist's hand, which speaks directly to the gaze-versus-gesture distinction in joint attention. Both findings are interpretable and clinically legible; both are outcomes of an exhaustive search rather than tests of prior hypotheses, and no group-level feature statistics are reported to corroborate them." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-053" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Random forests, one per video segment, combined into an ensemble by weighted voting - a design that mirrors the temporal structure of the stimulus rather than flattening it. Three combination strategies are compared systematically, and the exhaustive variant testing all 511 subsets is thorough as an exploration but constitutes a very large selection space when evaluated on the same cross-validation used for reporting. No deep learning, which is appropriate at 86 participants, and no single-model baseline over concatenated features is reported, so the benefit of the segment-wise decomposition itself is not isolated." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-053" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2021. The framing identifies a specific methodological gap rather than a general access problem: joint attention is 'an important marker to differentiate children with ASD from 12 months onwards', its verification 'requires the therapist's experience, attention and time spent, considering that the specialist's observation not using any tools is the most common practice', and the obstacle to automating it is technical - 'the studies cited in the literature that use ET signals combined with computational methods do not process trajectory data or ignore that the paradigm involves the displacement of regions of interest'. The developmental grounding is unusually explicit for this corpus, linking gaze-following to inferences about intentions and motivations and framing anticipation as 'the action of providing a view of the immediate future based on the immediate past', which 'appears to be difficult in ASD'. That framing directly motivates the anticipation feature, giving the paper a rare coherence between construct, feature design and analysis." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-053" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two groups totalling 86 participants: 56 autistic (38 male, 18 female, aged 5-18, mean 10) and 30 typically developing (20 male, 10 female, aged 3-15, mean 10). The class ratio is 65:35 in favour of autism, which the authors identify as a limitation and address with SMOTE on training folds. No other-diagnosis comparison group. At 86 participants this is among the larger single-site eye-tracking cohorts in the corpus." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-053" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional; a single viewing session per participant with no follow-up. Data are gaze coordinates over purpose-recorded video of a therapist. No ethics committee approval, parental consent procedure, anonymisation or data governance statement appears anywhere in the paper, despite participants aged from 3 years recruited through a university psychiatry department - the most conspicuous reporting gap in an otherwise clinically careful study." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-053" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Goal: build gaze trajectory features that can represent the joint attention paradigm computationally, using semantically tracked floating regions of interest, and classify autism from them. Main findings: 75% accuracy, 87% sensitivity, 53% specificity and 0.82 F1 from an ensemble using three of nine video segments; the informative segments correspond to the therapist's gaze resting, shifting to the object, and returning; no single segment exceeded 75% alone; and regions containing the eyes outperformed those containing the pointing hand." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-053" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Strong on the feature and modelling pipeline, absent on governance and descriptive results. Fully reported: all 15 features with their definitions and which were newly devised; the floating region identification procedure including specialist demarcation of the first frame and automated propagation; segment boundaries with frame counts; the missing-value imputation rule with its constant; Min-Max normalisation; the SMOTE variants and random forest hyperparameter grids; all three ensemble strategies with their threshold ranges; and the 10-fold cross-validation. Absent: any ethics or consent statement; any group-level descriptive statistics for the features; the identity of the selected hyperparameters; data or code release; and any account of missing or excluded data." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-053" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Enlarge the dataset so that class balance can be achieved with real rather than synthetic samples; automate region-of-interest identification to remove the therapist from the loop and speed the method; and explore alternative machine learning approaches including genetic algorithms for meta-classifier construction. The authors also note the approach generalises to any joint attention video provided a therapist marks the first and last frame of each region." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-053" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "10-fold cross-validation with SMOTE correctly restricted to training samples - a detail explicitly stated and often got wrong elsewhere in this corpus. The problem is scale of selection: three ensemble strategies, all 511 classifier subsets, thresholds swept in fine increments, five SMOTE variants plus the unbalanced original, and a GridSearchCV over three hyperparameters for each of nine random forests, with the best result across all of that reported from the same 10-fold estimate. There is no outer cross-validation loop, no held-out set, no independent cohort and no repetition over alternative fold partitions. The consequence is that both the headline accuracy and the substantive claim about which segments matter are selection outcomes rather than validated findings." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-053" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "CARS scores for both groups, reported as ranges and a group mean. The autistic range of 33-45 spans mild-to-moderate through severe on standard CARS bands, so the sample covers meaningful severity variation - but this is never exploited. No severity-stratified analysis is performed, no relationship between CARS score and classifier output is examined, and no IQ, language or adaptive measure appears. Given that the discriminative signal is in anticipatory gaze during joint attention, which plausibly varies with severity, relating classifier confidence to CARS would have been a straightforward and valuable analysis." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-053" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "One session per participant viewing three video stimuli of approximately 10 seconds each, divided into nine analysed segments" ;
                    slr:study_design "Cross-sectional case-control classification study with an engineering contribution in feature construction" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Children and adolescents with autism" ;
                    slr:sample_size_text "ASD/index: 56; comparison: 30" ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "Best configuration (variable ensemble using segments 1, 3 and 8 at threshold 2): accuracy 0.75, sensitivity 0.87, precision 0.78, specificity 0.53, F1 0.82. Homogeneous configuration with equal weights: accuracy 0.71, sensitivity 0.93, precision 0.72, specificity 0.30, F1 0.81. Homogeneous configuration with accuracy-based weights: accuracy 0.71, sensitivity 0.77, precision 0.79, specificity 0.60,",
                        "Gaze trajectory features computed against semantically tracked floating regions of interest classified autism at 75% accuracy with 87% sensitivity and an F1 of 0.82, but only 53% specificity. The most interpretable result is the segment analysis: the best ensemble used the three segments corresponding to the therapist's gaze resting, moving to the object, and returning, and no single segment reach" ;
                    slr:outcome "Accuracy, sensitivity, precision, specificity and F1, reported for the best configuration of each of the three ensemble strategies. Reporting specificity alongside sensitivity is what makes the result interpretable and reveals its main weakness" ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "Best configuration (variable ensemble using segments 1, 3 and 8 at threshold 2): accuracy 0.75, sensitivity 0.87, precision 0.78, specificity 0.53, F1 0.82. Homogeneous configuration with equal weights: accuracy 0.71, sensitivity 0.93, precision 0.72, specificity 0.30, F1 0.81. Homogeneous configuration with accuracy-based weights: accuracy 0.71, sensitivity 0.77, precision 0.79, specificity 0.60,; Gaze trajectory features computed against semantically tracked floating regions of interest classified autism at 75% accuracy with 87% sensitivity and an F1 of 0.82, but only 53% specificity. The most interpretable result is the segment analysis: the best ensemble used the three segments corresponding to the therapist's gaze resting, moving to the object, and returning, and no single segment reach" ] ] ;
