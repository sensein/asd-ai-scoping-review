    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "A four-stage procedure - GARS-2 parental questionnaire, DSM-5-based caregiver interview, direct observation by two doctoral-level child clinical psychologists, and independent confirmation by a child psychiatrist in a different setting. Independent second-clinician confirmation appears in almost no other study in this review, and the absence of ADOS is explained by the lack of an official Farsi version and listed as a limitation." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Recording settings differ sharply by group - 87.10% of autistic cries from autism centres against a comparison group split between health centres and homes - and all three analysed measures are sensitive to room acoustics and background noise, with harmonics-to-noise ratio directly indexing periodic-to-aperiodic energy. Two device classes were used with no level normalisation reported, and cry-eliciting causes also differ between groups. Partial standardisation (common format, 25 cm distance, quiet-environment exclusion) mitigates but does not remove this." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "No test partition exists; the final model was selected as the best of 2,000 epochs on the validation set; and the evaluation unit is the cry instance with no participant-level splitting described, so with roughly six instances per child, cries from the same child fall on both sides of the boundary. Exclusion rules and per-child yields are reported clearly, but partition sizes and composition are not." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Sixty-two children from a single Iranian corpus, with sex matched exactly at 24:7 in both groups - a genuine strength - but a 4.8-month mean age difference untested and unadjusted in a period of rapid vocal maturation, no cognitive, language or comorbidity data, and no screening instrument described for the comparison group." ] ;
            slr:overall_judgment "high" ;
            slr:tool_used "QUADAS-2" ] .

<https://doi.org/10.1007/s11760-023-02668-y> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "With the increasingly growing incidence of autism disorder, the early diagnosis of this disorder is of utmost importance. The appropriate diagnosis of this condition depends on the correct and accurate decision of the specialist. Thus, given the limited number of specialists in this area, the development of an efﬁcient classiﬁcation system is necessary. This study aims to analyze the eye-tracking data obtained from computer games to classify autistic and normal children. Twenty normal children from Namjoo public elementary school and 20 autistic children from the Daily Rehabilitation Clinic for Children with Special Disorders from the Tehran metropolis were selected for this study. Data were analyzed using a multilayer perceptron neural network with a backpropagation learning algorithm and a scaled conjugate gradient training algorithm. The classiﬁcation results were evaluated using the confusion matrix. The graphs from the game and the children’s gaze ﬁxation data were analyzed in this study to achieve a person-to-person evaluation and extract suitable features to classify autistic and typical children. The highest output precision and accuracy were obtained as 76.6% and 73.8%, respectively, for the case with all features considered." ;
    dcterms:bibliographicCitation "Aminoleslami S; Maghooli K; Sammaknejad N; Haghipour S; Sadeghi-Firoozabadi V (2023). Classification of autistic and normal children using analysis of eye-tracking data from computer games. *Signal, Image a*. https://doi.org/10.1007/s11760-023-02668-y" ;
    dcterms:creator "Aminoleslami S",
        "Haghipour S",
        "Maghooli K",
        "Sadeghi-Firoozabadi V",
        "Sammaknejad N" ;
    dcterms:title "Classification of autistic and normal children using analysis of eye-tracking data from computer games" ;
    bibo:doi "10.1007/s11760-023-02668-y" ;
    bibo:pmid "local_f1b626c8" ;
    fabio:hasPublicationYear 2023 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Participant selection and spectrum representativeness" ;
                            slr:justification "Twenty autistic boys with 'high-performance autism' from one Tehran clinic, restricted further to those who could sit at a computer, tolerate calibration and whose face perception a therapist judged adequate; 5 of 25 approached (20%) excluded on those grounds. All male. No severity or cognitive measure, so representativeness is unassessable." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Handling of missing data and attrition" ;
                            slr:justification "Twenty per cent of approached autistic children were excluded before recording, for reasons (refusal to sit, calibration failure) that plausibly correlate with sensory and attentional difficulty, with no characterisation of those children and no comparable filter applied to the comparison group. Out-of-range gaze samples were retained by enlarging the analysis space rather than quantified, and no tracking-ratio or data-loss statistic is reported." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Comparison group adequacy" ;
                            slr:justification "Mainstream schoolchildren described as 'normal' and 'healthy', with no screening instrument, no stated exclusion criteria and no evidence that autism or other conditions were ruled out. No clinical comparison group, which the authors themselves identify as needed for differential diagnosis." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Confounder control" ;
                            slr:justification "Age is matched to within three weeks and sex is constant by design, which are real strengths. Everything else is uncontrolled: no IQ or cognitive measure on what is fundamentally a visual matching task, no language measure, and no accounting for the fact that the JAFFE stimuli are other-race faces for an Iranian sample - a factor the paper's own literature review shows it is aware of." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Index test definition and prespecification" ;
                            slr:justification "Four feature subsets compared on the same data with the best reported; network architecture unreported; iteration count and learning coefficient tuned by MSE on an unstated partition; and the quoted operating characteristics taken from the pooled total rather than the test partition." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Reference standard quality" ;
                            slr:justification "Clinic admission following diagnosis by a paediatric psychiatrist and a paediatric clinical psychologist, with no instrument, criteria version, date or reliability reported, and a comparison group established only by school recruitment and the label 'normal', with no screening." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Measurement standardisation" ;
                            slr:justification "One eye tracker, one laboratory, one stimulus set and one protocol for both groups, with calibration required before recording - so acquisition does not differ by group. But the eye tracker is never identified by make, model or sampling rate, the fixation-detection parameters are unstated, and no calibration accuracy criterion is given, which matters because every feature is a fixation count or duration." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Outcome measurement blinding" ;
                            slr:justification "Feature extraction and classification are automated from logged gaze data; no human rating enters the measurement pipeline." ;
                            slr:rating "Low" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Data splitting and leakage control" ;
                            slr:justification "Arithmetic on the reported percentages fixes the dataset at 240 rows split 168/36/36, i.e. six rows per child randomly scattered across partitions, so every test row has five siblings from the same child in training. Region-level fixation counts and durations are stable individual characteristics, making this a direct leakage channel." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Sample size adequacy for the modelling" ;
                            slr:justification "Forty children, 240 rows, 18 features, and a neural network of unreported size. The 36-observation test partition means a single observation moves test accuracy by 2.8 points, and three observations separate the reported test result from chance." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Performance estimation and chance level" ;
                            slr:justification "The headline precision and accuracy are pooled across training, validation and test; held-out test accuracies are 52.8-58.3% against a 50% chance floor on 36 observations. No baseline, permutation test or confidence interval is reported, and ROC curves are plotted without AUC values. The consistent ~20-point train-to-test gap across all four configurations is never mentioned." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Preprocessing and feature selection nesting" ;
                            slr:justification "No selection algorithm was used, but four predefined feature subsets were each evaluated on the same data and the best-performing one reported as the study's result, which is selection by another route." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Reporting of results and uncertainty" ;
                            slr:justification "The tables are commendably disaggregated by partition, which is the only reason the held-out figures are recoverable at all. But the abstract, results narrative and conclusion all quote the pooled total, roughly 15 points above the test value, without noting the distinction; no confidence intervals are given anywhere; and ROC curves are shown without AUC." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Data, code and protocol availability" ;
                            slr:justification "Data available from the corresponding author on reasonable request. No code, no preregistration, no analysis plan, no deposited dataset." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Ethics, consent and conflicts" ;
                            slr:justification "Ethics approval from a named committee with a verifiable identifier (IR.IAU.SRB.REC.1401.152), stated in its own subsection - better than most reports charted here. But parental consent appears only as an inclusion criterion for the autistic group, with no consent statement for the school-recruited comparison children and no mention of child assent. Funding and competing interests are declared." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Completeness of methods reporting" ;
                            slr:justification "Task design, stimulus source, region segmentation, feature definitions, MATLAB version, training algorithm and activation functions are all given. Missing: the eye tracker's identity, sampling rate and accuracy; the fixation-detection parameters; the MLP's hidden layers and node counts; the learning rate and iteration count actually used; the split procedure and seed; and the fact, recoverable only by arithmetic, that the modelled units are observations rather than children." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Acknowledgement of limitations" ;
                            slr:justification "Three limitations are stated, of which one - the need for clinically overlapping comparison conditions - is genuinely important. None of the decisive issues is acknowledged: the pooled-versus-held-out reporting, the observation-level split, the train-to-test gap, the subset comparison, the all-male sample, the other-race stimuli, or the differential attrition." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Published 2023 from the Islamic Azad University Science and Research Branch and Tabriz Branch, with the Institute for Cognitive and Brain Sciences and the Faculty of Education and Psychology of Shahid Beheshti University, Tehran; no funding received. The framing is workforce scarcity: 'since the proper diagnosis of this condition depends on the correct and accurate decision of the specialist, the availability of adequate specialists in this area seems necessary. Unfortunately, the number of these specialists is low with respect to the growing autistic population', leading to the goal of a system 'easily applicable by not-so-expert users'. That is a task-shifting rationale rather than an accuracy-improvement one, and it recurs across the Iranian and Chinese papers in this corpus. The introduction is unusually wide-ranging for a short engineering paper, surveying therapeutic games, socially assistive robots, brain-computer interfaces and fuzzy learning before arriving at its own design, and it conspicuously cites work on same-race versus other-race face processing in autism without applying that literature to its own choice of Japanese stimuli for Iranian children. The conclusion's call to include 'conditions overlapping with autism for differential diagnosis' is a 2023-typical acknowledgement that the case-control geometry is the field's binding constraint." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-099" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The three stated limitations are real but peripheral - no transfer to adults, a desire for richer graph features, and the need for clinically overlapping comparison conditions, the last being a genuinely important acknowledgement that the study can only separate autistic children from unscreened schoolchildren. The unstated limitations dominate. First and most serious, the reported precision and accuracy are pooled across training, validation and test. The tables disaggregate honestly, so the information is present, but the abstract, results narrative and conclusion all quote the total. For the best configuration the held-out accuracy is 58.3% against a 50% chance level - on 36 observations, a difference of three. Second, the modelled rows are not children. Arithmetic on the reported percentages fixes the dataset at 240 rows split 168/36/36 in the MATLAB default proportions, so each of the 40 children contributes six rows that are randomly scattered across the three partitions, and every test row has five siblings from the same child in training. Given that the features are region-level fixation counts and durations, which are strongly stable within an individual, this is a direct route for identity information to leak. Third, four feature subsets were compared on the same data and the best reported as the study's result. Fourth, the stimuli are other-race faces for this sample, an effect the paper's own citations show it is aware of. Fifth, 20% of the approached autistic children were excluded for non-cooperation or calibration failure with no comparable filter on the comparison group and no description of those excluded. Sixth, the sample is entirely male and this is never discussed. Seventh, no IQ or cognitive measure exists to separate social-attention differences from task-comprehension differences on what is essentially a visual matching task. Eighth, ROC curves are displayed without any AUC value, so the one metric that would summarise discriminability across thresholds is shown graphically and not reported numerically." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-099" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The weakest element, and it fails on two counts that compound one another. First, the reported performance is not held-out. The abstract, results narrative and conclusion all quote 76.6% precision and 73.8% accuracy, which Table 5 identifies as the TOTAL column - the pooled figure across training, validation and test. The test column of the same table reads 66.7% precision and 58.3% accuracy, with sensitivity 57.1% and specificity 60.0%. The same pattern holds for every feature subset: total accuracies of 65.0-73.8% against test accuracies of 52.8-58.3%, with training accuracies of 67.9-78.6%. A roughly 20-point train-to-test gap in all four configurations is the signature of overfitting on a small dataset, and it is neither reported nor discussed. Second, the split is over observations rather than children. The paper says only that '70 percent of data ... were used for training and the remaining 30 percent for tests and validation', but the reported percentages determine the arithmetic exactly: with 240 rows split 168/36/36 in the MATLAB Neural Network Toolbox default proportions, 78.6% of 168 is 132, 66.7% of 36 is 24, 58.3% of 36 is 21, and (132 + 24 + 21)/240 = 73.75%, reproducing the reported total to the decimal, and the same reconstruction works for the other three subsets. Forty children therefore contribute six rows each, randomly scattered, so every test row has five siblings from the same child in the training set. Because the features are per-region fixation counts and durations - quantities that are highly stable within an individual and reflect that person's habitual looking style as much as their diagnosis - this is a direct channel for identity leakage, and it means even the 58.3% test figure is optimistic relative to a genuinely unseen child. Two further issues: four feature subsets were compared on the same data and the best reported, and no chance baseline, permutation test or confidence interval accompanies any figure, although the balanced design makes chance exactly 50% and the test partition is small enough that three observations separate the reported result from it. The corrective is available and would be worth doing: partition the 40 children, generate observations within partitions, tune the network on training children only, choose the feature subset on a development set, and report test-column figures with confidence intervals as the study's result." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-099" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Split between a well-specified experiment and an under-specified model. Reproducible: the game's two stages and objectives, the JAFFE stimulus source, the 240-image protocol, the stimulus resolution and the region segmentation with its named zones, the 18-feature definition as fixation count and fixation time per region, the MATLAB version, the training algorithm (scaled conjugate gradient backpropagation) and the activation functions (tanh hidden, sigmoid output), and the ethics approval identifier. Not reproducible: the eye tracker itself, the fixation-detection parameters, the MLP's hidden-layer count and node counts, the learning rate and iteration count that were 'optimised' by MSE, the random split and seed, and the code. Data are available from the corresponding author on reasonable request. The single most consequential reporting gap is not technical but presentational: because the abstract and conclusion quote the pooled total rather than the test column, a reader who does not open the tables will take away a figure roughly 15 points higher than the study's own held-out result." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-099" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Signal, Image and Video Processing 17:4357-4365, Springer - a signal-processing engineering journal, published as an Original Paper. The venue accounts for the reporting balance: the metric tables are exhaustive and correctly disaggregated by training, validation and test partition, and ROC curves are plotted for every configuration, while the clinical apparatus is minimal (no diagnostic instrument, no cognitive measure, no screening of the comparison group) and the eye tracker is never identified. Received 30 March 2023, revised 25 May 2023, accepted 10 June 2023, published online 4 July 2023." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-099" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Three directions are stated. Enrich the feature set derived from the eye-tracking graph in order to improve precision and accuracy - a reasonable ambition, and one the study has itself left unexploited, since the introduction develops a graph-theoretic framing of fixations as vertices and saccades as edges but no graph metric is ever computed. Extend the classifier to include conditions that overlap with autism so that differential diagnosis becomes possible - the most valuable of the three, and an acknowledgement that separating autistic children from unscreened schoolchildren does not establish clinical utility. And note that a system trained on children will not transfer to adults without retraining. Not mentioned, and more pressing: participant-level validation, reporting held-out rather than pooled performance, an independent cohort, culturally matched stimuli, inclusion of girls, and any cognitive covariate." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-099" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The dominant contrast throughout is 'autistic and normal children', with 'normal' used in the title, abstract, results, discussion and conclusion, supplemented by 'healthy children' and 'typical children'. Framing autistic children against 'normal' peers is the least considered terminology encountered in this corpus and carries an implication - abnormality - that 'typically developing' does not. Autism itself is 'autism disorder' or 'the autism spectrum disorder', characterised by 'communication deficits', 'impairment in social interactions' and the statement that autistic children 'lack the ability to learn the socio-cognitive skills with normal development'. Severity is expressed as 'high-performance autism' and, in one passage discussing robot-assisted education, the text refers to 'students with mental retardation' - outdated in current English usage. Against this, the study's motivation is service-oriented rather than dismissive: it is framed around the shortage of specialists relative to a growing autistic population and the goal of supporting, not replacing, clinical judgement, and the introduction is unusually positive about autistic children's engagement with technology, citing evidence of 'inherent dependence on technology and positive behavior toward computer-based training'. There is no neurodiversity framing and no autistic-community involvement statement." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-099" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A two-stage computer game built specifically for this study, informed by picture-exchange approaches in which cards depicting facial expressions convey concepts non-verbally. Stage S1 (face recognition): three photographs of Japanese women are displayed in a row beside a target figure, and the child must identify which candidate matches the target. Stage S2 (expression matching): the same women are shown with happy, sad and surprised expressions, with 'happy' as the target. All stimuli come from the JAFFE database. Children were familiarised with example images first, and conditions were checked as suitable before the full run of 240 game images. The design has clear merits - it is engaging rather than passive, it has an objectively correct answer on every trial so gaze can be interpreted against task demands, and it targets a behaviour (facial expression processing) with strong theoretical links to autism. Three features constrain what it can show. The stimuli are other-race for this sample, and the other-race face effect is a documented modulator of both face-processing performance and gaze distribution - the paper cites this literature but not in relation to its own design. Only static images are used, so no dynamic or interactive social content is present. And the analysis discards trial structure entirely: fixations are pooled into region counts and durations, so whether the child looked at the correct candidate, in what order, or how their strategy evolved across 240 trials is not represented, even though the single-child illustration in Fig. 7 shows exactly that kind of trial-level reasoning being informative." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-099" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "An 18-dimensional vector of region-based fixation statistics per observation. The stimulus space, 1024 x 768, was augmented beyond its true extent to accommodate out-of-range gaze samples, then partitioned into named regions: on FIG 1, FIG 2 and FIG 3; on the Reference FIG; around each of these; and two OUT regions below the outer figures. Fixations were clustered by location of node aggregation and two quantities extracted per region - the number of fixation nodes and the fixation time. Four nested subsets of this matrix were evaluated separately: around the figures, on the figures, on and around the figures, and all features. The representation carries no temporal information: no scan-path order, no saccade amplitudes or directions, no transition probabilities between regions, no within-trial dynamics, and no trial-to-trial evolution across the 240 images. This is a notable gap given the introduction's extended development of a graph-theoretic view in which fixations are vertices and saccades are edges - Fig. 6 even displays such a graph for one autistic child - because every quantity that graph representation would naturally yield (degree distribution, edge weights, path structure, transition entropy) is left uncomputed, and the model receives only vertex-region tallies." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-099" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Stimuli: the Japanese Female Facial Expression (JAFFE) database, presented at 1024 x 768. Capture: a stationary eye-tracking system at Shahid Beheshti University, depicted in a photograph but never identified - no manufacturer, model, sampling rate, spatial accuracy or precision figure appears anywhere in the paper, which is a significant omission because every feature is a fixation count or duration and fixation detection depends directly on sampling rate and on the detection algorithm's parameters, neither of which is stated. Analysis: MATLAB R2020b, using fixation detail output (start, duration, end, X, Y) and the Neural Network facilities for the MLP. Calibration was performed and used as a gate, with failure to calibrate an explicit exclusion criterion, but the protocol, point count and accuracy threshold are not described. Out-of-range samples were retained by enlarging the analysis space beyond the stimulus and labelling the surplus 'OUT', which is a pragmatic choice but implies non-trivial tracking error that is never quantified." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-099" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional, single session, no follow-up, no test-retest reliability. Ethics reporting is the strongest element of the paper's governance: approval was obtained from the Research Ethics Committee of Islamic Azad University, Tehran Science and Research Branch, with the approval identifier IR.IAU.SRB.REC.1401.152 stated in a dedicated Ethics subsection and repeated in the declarations - a named committee and a verifiable reference number, which most reports in this corpus do not provide. Consent is handled less completely: parental consent appears as an inclusion criterion for the autistic group only, with no consent statement for the school-recruited comparison children and no mention of child assent. Funding (none received) and competing interests (none) are declared." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-099" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Limited but honest. The features are individually meaningful - counts and durations of looking at specified places - and the region diagram makes each one concrete. The four-subset comparison functions as a coarse importance analysis, showing that the full set outperforms either the figure regions or their surroundings alone, and the paper's interpretation of this is straightforward and reasonable: more regions provide more detail. A single-child worked example traces the fixation points and times for one trial and shows the child concentrating on the target and the matching candidate before answering correctly, which usefully demonstrates that the raw data are behaviourally interpretable. Against this, no group-level feature analysis is reported at all - no means, no distributions, no effect sizes, no statistical comparison of where the two groups looked - so the paper never states, and cannot state, what visual behaviour distinguishes autistic from comparison children in its own data. It reports only that a network reached a certain accuracy. For a study whose stated purpose is to support specialist decision-making, the absence of any description of the discriminative behaviour is a substantive gap: a clinician can act on 'autistic children fixated less on the reference face' but not on 'an unspecified MLP scored 73.8% pooled across partitions'." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-099" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Weak and under-specified. Autistic status rests on admission to the recruiting clinic, where 'the children were admitted into this clinic based on the diagnosis made by a pediatric psychiatrist and a pediatric clinical psychologist and underwent a comprehensive evaluation', restated in the inclusion criteria simply as 'the diagnosis of autism spectrum disorders made by specialists'. Two clinicians of different disciplines is better than one, and the involvement of a psychiatrist and a clinical psychologist is a reasonable clinical standard, but no diagnostic instrument is named, no DSM or ICD version is cited, the 'comprehensive evaluation' is not described, no diagnosis date or interval to testing is given, and no reliability is quantified. The comparison group is weaker still: children were recruited from a mainstream public elementary school and are called 'normal' and 'healthy', with no screening instrument administered, no exclusion criteria listed and no statement that autism or developmental concerns were ruled out - so undetected autistic traits or other neurodevelopmental conditions in the comparison group cannot be excluded. The autistic group additionally passed two functional gates that shape who was studied: a therapist's judgement that the child had 'relative perception of people's faces', and the ability to sit at a computer and attend to images. Both are defensible for a face-processing task but both further narrow an already high-functioning sample." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-099" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Author keywords: Artificial neural network; Autism spectrum disorder; Computer games; Eye-tracking. 'Computer games' rather than 'serious games' or 'gamified assessment' reflects the paper's framing of the task as a therapeutic-game artefact repurposed for measurement, and the introduction devotes several paragraphs to games as therapy before turning to classification. No application term - screening, diagnosis, classification - appears in the keywords, although the body text uses 'diagnosis system' freely. Terms carried through the body: therapeutic games, facial emotion recognition, expression matching, fixation duration, fixation count, graph theory, eye-tracking graph, multilayer perceptron, scaled conjugate gradient, confusion matrix." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-099" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Visual attention during face recognition and facial-expression matching, operationalised entirely spatially. For each defined region of the display - on each of the three candidate figures, on the reference figure, around each of these, and in two regions outside them - two quantities are computed: the number of fixation nodes falling there and the total fixation time spent there. The behavioural hypothesis is the standard one for eye tracking in autism, that autistic and non-autistic children distribute gaze differently when required to compare faces and match expressions, with the paper's own framing that 'the recorded data on eye movements suggest a clear difference between the eye fixation patterns of normal subjects and subjects with autism spectrum disorders'. Two aspects of the operationalisation are worth noting for the synthesis. The regions are defined by task structure (which figure) rather than by facial anatomy - there are no eye, mouth or face-interior areas of interest - so the classic autism finding of reduced eye-region fixation cannot be tested by this feature set at all; what is measured is which stimulus the child compared and how long they dwelt on it, which is closer to a matching-strategy measure than to a social-attention measure. And the distinction between 'on' and 'around' a figure is the study's one attempt to capture a qualitative gaze property, on the implicit reasoning that fixating adjacent to rather than on a face is itself informative; the ablation shows neither subset alone outperforms their union." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-099" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Goal: to classify autistic from non-autistic children by analysing eye-tracking data captured while they play a purpose-designed computer game, motivated explicitly by the shortage of diagnostic specialists relative to a growing autistic population and the wish for a system 'easily applicable by not-so-expert users'. The game was designed with expert guidance around two objectives drawn from picture-exchange practice: face recognition and facial-expression matching. Findings as reported: precision 76.6% and accuracy 73.8% with all 18 features, which the paper presents as the best of four nested feature subsets and describes as 'a suitable diagnostics system'. Findings as they should be read: those numbers are the TOTAL column of Table 5, pooling training, validation and test rows, and the held-out test values in the same table are precision 66.7%, accuracy 58.3%, sensitivity 57.1% and specificity 60.0% - between 6 and 10 points above a 50% chance level on 36 observations. Across all four feature subsets the pattern is identical and consistent: total accuracies of 65.0-73.8% concealing test accuracies of 52.8-58.3%, with training accuracies of 67.9-78.6%. The gap between training and test performance is present in every configuration and is never remarked on. Two subsets also show unstable held-out behaviour, with test sensitivity of 33.3% for 'around FIGs' and test specificity of 33.3% for 'on FIGs'." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-099" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No fusion. A single modality with 18 features from one sensor, and the four reported conditions are nested subsets of that same feature set rather than distinct modalities. One near-miss is worth recording: the discussion states that 'the children's verbal responses to the observed game were also recorded during the test' and that 'the results indicate the significant matching of the provided responses to the recorded eye-tracking patterns'. A second behavioural channel - whether the child correctly identified the target, and what they said - was therefore captured and would have been straightforward to fuse with gaze, all the more so because the task has an objectively correct answer on every one of 240 trials, so accuracy, latency and error patterns were available at no additional cost. None of it is quantified, analysed or entered into the model; the claimed correspondence between speech and gaze is asserted without a single supporting number. This is the same pattern seen in the tablet-based motor study charted elsewhere in this review, where the cognitive-performance channel was deliberately discarded to isolate the motor signal: a second modality present in the raw data and suppressed rather than fused." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-099" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two groups of 20, total 40 children, all male, aged roughly 4 to 12 years. The autistic group was drawn from the Daily Rehabilitation Clinic for Children with Special Disorders in Tehran, affiliated to the Family Institute of Shahid Beheshti University; the comparison group came from Namjoo public elementary school. Enrolment and attrition are reported for the autistic group only: 25 children with 'high-performance autism' were selected, of whom 5 (20%) were excluded under the study's stated exclusion criteria - refusing to sit on the chair, or failure to calibrate the eye tracker - and their data were never recorded. No exclusions, and indeed no exclusion criteria at all, are reported for the comparison group, so the two groups passed through different filters. The modelled dataset is not 40 rows but 240: arithmetic on the reported training, validation and test percentages fixes the row count exactly (168 + 36 + 36 = 240, with 132 + 24 + 21 = 177 correct and 177/240 = 73.75% matching the reported 73.8% total), so each child contributes six observations to a randomly partitioned dataset." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-099" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Single-city, two-source recruitment in Tehran, with testing centralised at one laboratory. Autistic children came from the Daily Rehabilitation Clinic for Children with Special Disorders, a specialist service affiliated to the Family Institute of Shahid Beheshti University; comparison children came from Namjoo public elementary school. All eye tracking took place on one stationary system at the Faculty of Education and Psychology, Shahid Beheshti University, so unlike some studies in this corpus the acquisition chain is identical for both groups and no equipment confound arises. The recruitment geometry is nonetheless the standard clinic-versus-school case-control arrangement at 50% prevalence, and here it is compounded by asymmetric filtering: the autistic group faced five inclusion criteria and two exclusion criteria that removed 20% of those approached, while no criteria at all are stated for the school-recruited comparison group. The children who could not tolerate sitting at the computer or could not be calibrated - plausibly those with greater sensory or attentional difficulty - are precisely those absent from the analysed autistic sample." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-099" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Precision, accuracy, sensitivity and specificity, each reported separately for the training, validation and test partitions and for the pooled total, across all four feature subsets - sixty-four numbers in total. The disaggregation is a real reporting virtue and is what makes it possible to see what the study actually achieved: it is only because the tables separate the columns that a reader can recover the held-out test accuracy of 58.3% behind the abstract's 73.8%. Two summary tables then compare precision and accuracy across subsets, again by partition. ROC curves are plotted for all four configurations, but no AUC is reported for any, so the single number that would summarise discriminability independent of threshold is presented only as a picture. Also missing: confidence intervals of any kind, F1, calibration, and any participant-level metric. Given that the test partition contains 36 observations, a confidence interval would have been the most informative addition - at 58.3% on 36 observations the interval comfortably includes chance." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-099" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A single shallow multilayer perceptron, trained by error backpropagation using the scaled conjugate gradient algorithm, with hyperbolic tangent activation in the hidden layer and sigmoid activation at the output, implemented in MATLAB R2020b. No alternative classifier was evaluated - no SVM, random forest, logistic regression or even a linear baseline - despite the introduction surveying several such methods, so there is no evidence that the neural network is better suited to 18 features and 240 rows than a simpler model would be. Nor is the network itself specified: the paper devotes a paragraph to explaining that the number of hidden layers and nodes is problem-dependent and then never states what was used, and the iteration count and learning coefficient are described as optimised by MSE without saying on which partition. For a dataset of 240 rows and 18 features, a shallow MLP is a defensible choice and overfitting is the expected risk; the reported train-to-test gaps of roughly 20 points in every configuration are consistent with that risk having materialised." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-099" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No cognitive, language, adaptive or severity instrument was administered to any participant in either group. The autistic sample is described only as having 'high-performance autism disorder', a label with no accompanying score, cut-off or source, and the conclusion leans on it interpretively - arguing that accuracy above 73% is 'desirable given the status of children with high-performance autism disorder', i.e. that the task is intrinsically harder in a less impaired sample. That is a reasonable argument but it cannot be evaluated, because no measure of functioning or severity exists to place the sample on any scale, nor to check whether the misclassified children were the less affected ones. Two informal proxies appear in the inclusion criteria - a therapist's judgement of the child's face perception, and the capacity to sit and attend at a computer - and both operate as gates rather than as measurements. The absence of IQ is particularly consequential here because the index task is a visual matching task drawn from the same family as nonverbal reasoning tests: any group difference in fixation distribution over candidate figures could as easily reflect differences in matching strategy or task comprehension as differences in social attention, and there is no covariate with which to separate them." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-099" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Table 1 reports sex, group size, and mean and standard deviation of age: autistic 20 male, 8.40 +/- 2.45 years; comparison 20 male, 8.45 +/- 1.90 years, with an overall span of about 4 to 12 years. Age matching is excellent - the means differ by three weeks - though the autistic group is more dispersed. Beyond this, nothing: no IQ or developmental quotient despite the autistic group being labelled high-functioning, no language measure, no adaptive functioning, no comorbidity, no medication, no socioeconomic status, no race or ethnicity, and no autism severity. Two features of the reported demographics deserve emphasis. The sample is 100% male in both groups. This is stated in the table and never mentioned again - not as a design decision, not as a limitation, not in the conclusion - even though the introduction itself notes that autism prevalence is higher in boys, which is a reason to sample boys but not a reason to leave the restriction undiscussed. And the participants are Iranian children in Tehran while the facial stimuli are Japanese women from the JAFFE database, so every trial involves other-race face processing. The paper's own literature review cites work on differences between autistic and typically developing children in processing same-race versus other-race faces, and even reports that study's 70% accuracy as a comparator, yet never connects that literature to its own stimulus choice." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-099" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:study_design "Cross-sectional two-group diagnostic-classification study using a purpose-designed computer game as the elicitation task" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: ; comparison: 20" ] ] ;
    slr:content_sha256 "f42bb30e1679579124923b9ad1c4ad452b8fa66675b79ad2c675b35412a6cebe" ;
