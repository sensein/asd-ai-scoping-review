            slr:decision "include" ;
            slr:decision_rationale "Title and abstract describe classical and deep learning models detecting autism from linguistic features extracted from speech transcripts of 64 children aged 3 to 6, drawn from CHILDES and ASDBank, with accuracies of 77% to 84%. Human participants, a language-behaviour modality, computational models and an autism classification target are all present." ;
            slr:screening_stage "title_abstract" ],
        [ a prov:Activity,
                slr:ScreeningDecisionRecord ;
            dcterms:title "Phase 3 diagnostic evaluation of a smart" ;
            bibo:pmid "local_7b468950" ;
            slr:assessed_on "full_text" ;
            slr:decision "include" ;
            slr:decision_rationale "Full text confirms a prospective, multi-site, STARD-designed diagnostic classification study protocol, registered as NCT03438994 with status 'Pre-results'. Three cohorts are specified - 280 typically developing, 280 autistic and 200 with another neurodevelopmental disorder - across Glasgow and Gothenburg, with children playing two iPad games while touch-screen and triaxial inertial sensors record movement, and a third-party algorithm classifying the data blind to diagnosis. Included as part of the verified corpus, and charted with the record made explicit that no results are reported: the article specifies design, recruitment, sample size justification, blinding, outcomes and analysis, and states that 'the results are blind until data collection is complete'. It contributes to the review as the corpus's only prospectively registered phase III diagnostic evaluation and as its methodological benchmark." ;
            slr:full_text_source "user_supplied_pdf" ;
            slr:screening_stage "full_text" ],
        [ a prov:Activity,
                slr:ScreeningDecisionRecord ;
            dcterms:title "Ensemble of Deep Learning with Crested Porcupine Optimizer Based Autism" ;
            bibo:pmid "local_13c1f46d" ;
