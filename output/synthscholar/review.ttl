                    slr:judgment "high" ;
                    slr:supporting_quote "No validation scheme of any kind is described; mRMR feature selection uses class labels with no stated nesting; and the reported accuracy is the maximum of a sweep across one to forty-five features chosen on the same data." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "All 97 participants are accounted for and calibration was required to pass before proceeding, but no data-loss, exclusion or gaze-validity rates are reported despite artefact rejection being applied to the EEG." ],
