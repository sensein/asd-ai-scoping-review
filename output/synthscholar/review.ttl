            slr:relevance_score "0.88"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "The training process spanned 2000 epochs, with the model exhibiting superior validation accuracy being designated as the final trained classifier." ] ;
            oa:hasTarget <https://doi.org/10.1007/s10803-025-06811-1> ;
