        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "Due to the size of data is small (14 ASC and 16 controls), we used a second layer of cross-validation methodology introduced by [23], which further divided the Training data into a training/development set. ... Therefore we treat the test sample as unknown when selecting features and parameters. All selections are based on the performance on the Training data, not test data." ] ;
            oa:hasTarget <urn:slr:article:8da61cddafb9> ;
            slr:claim_label "Feature and parameter selection were nested inside an inner training/development split so the held-out test sample never influenced selection." ;
            slr:relevance_score "0.95"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
