                    slr:judgment "low" ;
                    slr:supporting_quote "All 45 high-risk children were followed to 24 months with the 40/5 split reported explicitly; the interval between behavioural measurement and diagnosis is stated; no participants are unaccounted for." ],
                [ a slr:RoBDomainJudgment ;
