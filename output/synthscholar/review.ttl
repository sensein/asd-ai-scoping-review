    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "DSM-IV diagnosis by a licensed psychiatrist with Raven's confirming intellectual level and explicit comorbidity exclusion is reasonably specified, but no ADOS, ADI-R or other standardised observational instrument was used, and control status rests on report of no disorders." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Restricted to high-functioning autistic children with average non-verbal IQ and with ADHD, intellectual disability and schizophrenia excluded, recruited from a single hospital psychiatry department; the resulting contrast is cleaner but substantially easier than the clinical discrimination task." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "The t-test screen from 18 to 9 features used the full labelled dataset outside cross-validation, forward feature selection then maximised the same accuracy metric that is reported, and the headline is the best of five classifiers across four k values." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "All 43 participants contribute to the 43x18 analysis matrix; trial reinitiation rules for protocol violations are stated, and data trimming (first and last 3 seconds) and noise thresholds are specified." ] ;
            slr:overall_judgment "high" ;
            slr:tool_used "QUADAS-2" ] .

<urn:slr:article:fc05c327fddf> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Autism Spectrum Disorder (ASD) is a multifaceted neurological development disability that is characterized by deficits in social communication and emotion detection. Early and accurate identification of ASD is important; however, clinicians and researchers have often depended upon lengthy, in-clinic assessments. This research work proposes two deep learning models. This study proposes two deep learning models: a Hybrid resNet50V2+InceptionV3 model for ASD prediction from facial images and an enhanced MobileNet for recognizing six emotions in children with ASD. Data sets were collected from two public datasets. Preprocessing was performed (normalization and augmentation) and a hybrid ResNet50V2+InceptionV3 model and enhanced MobileNet were trained and tested. The hybrid model produced 95 % accuracy for predicting ASD, and the enhanced MobileNet achieved 73.3 % accuracy for predicting emotions; both accuracy rates were significantly improved as compared to baseline models. Overall, both models demonstrated that hybrid and enhanced model architectures improve the predictive accuracy and generalization of children with ASD from facial images. The models can also be used as non-invasive methodologies for early detection of ASD and emotion classification in clinical or educational contexts. Future research will include multimodal inputs and methods in explainable AI for further clinical implication." ;
    dcterms:bibliographicCitation "Akalya T; Ramyachitra D; Shabarna M; Legha C (2025). Deep learning-based detection of autism spectrum disorder and emotion recognition in children. *Pattern Recognition, 173, Article 112906*." ;
    dcterms:creator "Akalya T",
        "Legha C",
        "Ramyachitra D",
        "Shabarna M" ;
    dcterms:title "Deep learning-based detection of autism spectrum disorder and emotion recognition in children" ;
    bibo:pmid "local_86a67a4f" ;
    fabio:hasPublicationYear 2025 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Confounder control" ;
                            slr:justification "No age, sex or ancestry data - acknowledged by the authors - in a study whose motivating claim is that autistic children show facial morphological differences, a quantity that varies with all three." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Participant selection and spectrum representativeness" ;
                            slr:justification "A public image assembly with no ascertainment, no spectrum description and an unreported number of distinct children." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Handling of missing data and attrition" ;
                            slr:justification "An explicit quality filter discards images lacking a visible frontal face with eyes, nose and mouth - real quality control for this branch - but the number discarded and its class distribution are unreported." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Comparison group adequacy" ;
                            slr:justification "Images of children from non-autism-related sources in the same corpus, with no screening or demographic characterisation." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Index test definition and prespecification" ;
                            slr:justification "Both architectures are specified with their constituent networks and layer types and the hybrid's rationale is argued rather than assumed; hyperparameters are not reported and no operating point is prespecified." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Outcome measurement blinding" ;
                            slr:justification "Classification is fully automated with no human rater at inference." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Measurement standardisation" ;
                            slr:justification "Uncontrolled internet photographs with potentially class-correlated acquisition conditions, partly mitigated by a frontal-face quality requirement and by normalisation." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Reference standard quality" ;
                            slr:justification "No diagnostic instrument or clinician judgement for any image; labels are folder membership, described in the paper as 'well-labelled' which conflates consistency with validity." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Data splitting and leakage control" ;
                            slr:justification "Image-level splitting with the number of distinct children unreported; stratification balances classes across partitions but does nothing about subject overlap." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Sample size adequacy for the modelling" ;
                            slr:justification "A hybrid of two deep backbones trained on 2,526 images from an unknown number of children, on CPU hardware that the authors say limited tuning." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Performance estimation and chance level" ;
                            slr:justification "The autism metric set is mutually incompatible on its own stated test set with no reconciliation, and no chance baseline is given. A single split is used, which the authors acknowledge with its reason." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Preprocessing and feature selection nesting" ;
                            slr:justification "A separate validation partition is maintained for the autism task and stratification is applied correctly; augmentation ordering relative to splitting is not stated." ;
                            slr:rating "Unclear" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Completeness of methods reporting" ;
                            slr:justification "Corpora, exact partition sizes for both tasks, stratification procedure, quality-filter criterion, preprocessing, both architectures with component networks, baseline comparators, six-metric tables, confusion matrices, the single-split decision with its reason, and the training hardware." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Ethics, consent and conflicts" ;
                            slr:justification "No ethics or consent statement anywhere, for training data comprising identifiable photographs of children collected from the internet. Funding and competing interests are also absent." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Acknowledgement of limitations" ;
                            slr:justification "A dedicated section naming missing demographics, small sample, static-image restriction, absent external clinical validation, absent explainable-AI component and CPU-limited training - among the more candid in this branch, though the metric inconsistency and the provenance confound are unmentioned." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Reporting of results and uncertainty" ;
                            slr:justification "The fullest metric set in this branch, and internally contradictory for the autism task - accuracy, specificity, precision and AUC cannot simultaneously take the values reported on a balanced 280-image test set. No confidence intervals and no chance baseline." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Data, code and protocol availability" ;
                            slr:justification "Both corpora are public and cited; no code is released." ;
                            slr:rating "Unclear" ] ;
                    slr:overall_concern "unclear" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. The children were photographed outside any study, in unknown circumstances. This is a specific problem for the emotion task, which the paper does not raise: an emotion label attached to a photograph taken for unknown reasons has no eliciting condition, so what the child was feeling, whether the expression was posed or spontaneous, and what prompted it are all unknown - and the paper's own argument is that autistic facial expression differs from the neurotypical patterns on which such labels are usually based, which makes the labelling process itself the thing most in need of scrutiny." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-139" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A hybrid ResNet50V2 plus InceptionV3 for autism classification, and an enhanced MobileNet - MobileNet layers followed by global average pooling and fully connected layers - for six-way emotion recognition, each compared against baseline architectures including VGG16 with Random Forest. Choosing MobileNet for the emotion task is sensible given CPU-only training, and the baseline comparisons with confusion matrices give the emotion result more support than the autism result receives. The hybrid's motivation is argued rather than asserted, which is more than most of this branch offers." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-139" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None implemented, and the gap is acknowledged. The introduction argues that 'clinicians find XAI models useful since the decision making process of AI models is easier to understand', and the limitations section records that 'the deep learning models were not provided with explainable AI visualization, thereby, limiting clinical interpretability'. Stating the value of interpretability, not delivering it, and then saying so is more honest than the several studies in this branch that claim interpretability analyses they do not perform. The absence nonetheless leaves the central question untouched: with no attribution, nothing indicates whether the autism model responds to facial phenotype or to the photographic character of images drawn from autism-related web sources." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-139" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No study setting. Both corpora are public Kaggle assemblies, with the autism images drawn from internet sources by a third party. The paper's stated reason for choosing Kaggle - 'large, well-labelled public data promoting reproducibility in work' - is a genuine consideration and explains why this corpus has attracted at least nine independent analyses, but it addresses reproducibility of the computation rather than validity of the labels." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-139" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. The autism labels reflect folder membership in a public collection whose positive class was assembled from autism-associated online content; no child is known to have received a diagnostic assessment, and no instrument, clinician judgement or record is cited anywhere. The paper describes the corpus as 'large, well-labelled public data promoting reproducibility', which conflates consistent labelling with valid labelling - the labels are consistent in that every image in the autistic folder carries the same tag, and they are not diagnoses. This is the ninth study in the review resting on this corpus family and the position is unchanged. The emotion labels are category assignments from the source corpus and are adequate for what they measure, though nothing establishes that they were assigned by raters familiar with autistic facial expression, which is the very phenomenon the paper says general-population models miss." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-139" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "There are no participants. The autism corpus comprises 2,886 images partitioned 2,526 training, 280 testing and 80 validation - the standard split of the Piosenka Kaggle autistic-children collection, which this review has now charted in eight other studies - after poor-quality images were discarded. The emotion corpus supplies 703 training and 130 testing images. The number of distinct children behind either count is never stated, and no age, sex, ancestry, cognitive, language or clinical information is available for any class. The authors name this directly as their first limitation, observing that 'the absence of demographic information such as gender and ethnicity in the utilized Kaggle datasets might hinder the generalization across different populations' - which is a more explicit acknowledgement than most studies on this corpus offer, and which correctly identifies the consequence without identifying the deeper problem, that the corpus's autistic class was harvested from autism-related online sources so that the label records image provenance." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-139" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The fullest metric reporting of any Kaggle-corpus study in this review - accuracy, precision, sensitivity, specificity, F1 and AUC for the autism model, six measures plus confusion matrices for emotion - and that completeness is what makes the problem visible. The autism figures are 'accuracy = 95, precision = 0.96, sensitivity/recall = 0.94, Specificity = 42.5, F1 = 0.95 and AUC = 78'. These cannot all be correct. On the stated balanced 280-image test set, a recall of 0.94 recovers about 132 of 140 positives while a specificity of 0.425 recovers about 60 of 140 negatives, giving 192 correct and an accuracy near 68%. The same figures imply about 80 false positives, so precision would be near 0.62 rather than 0.96. And an AUC of 0.78 is not compatible with 95% accuracy on balanced classes. Reporting specificity at all is what exposes this - the seven other Kaggle-corpus studies charted here that report accuracy alone would have concealed an identical failure. If the specificity of 42.5% is the accurate figure, the model correctly identifies fewer than half of non-autistic children, which is worse than chance and is the study's most important result. The emotion metrics, by contrast, are internally consistent and modest." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-139" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Better than most of this branch on protocol. Reported: both corpora with their source, the exact partition sizes for both tasks (2,526/280/80 and 703/130), the stratified random sampling procedure with its stated purpose of preserving class proportions, the image quality-filtering criterion requiring a frontal face with eyes, nose and mouth visible, the preprocessing steps, both architectures with their constituent networks and layer types, the baseline comparators, a full six-metric set for each task, confusion matrices, the explicit statement that only one split was used and why, and the training hardware. Not reported: class counts within each partition, the number of distinct children, hyperparameters, code, ethics arrangements, funding and competing interests." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-139" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional secondary analysis with no longitudinal element. No ethics or consent statement appears anywhere, for work whose training data are identifiable photographs of children collected from the internet without their families' knowledge. Funding and competing interests are not stated in the retrieved text." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-139" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two failures of different kinds, and the reporting quality that exposes the second is worth crediting. The first is standard for this corpus family: the split is at image level, 2,526 training against 280 testing and 80 validation, with the number of distinct children behind 2,886 images unreported, so in a web-assembled collection where a child may appear in several photographs, images of one child can fall on both sides of the boundary. Stratified random sampling was used and is correctly described as preserving class proportions across partitions - but stratification balances classes, not subjects, and the paper does not consider subject overlap. The authors do state candidly that 'the dataset was split only once, and the procedure was not repeated due to the high computational expense of training deep learning models', which names a real limitation with its reason and is more forthcoming than most of this branch. The second failure is arithmetic and more serious. The autism model's reported metrics - accuracy 95, precision 0.96, recall 0.94, specificity 42.5, F1 0.95, AUC 78 - are mutually incompatible on the stated balanced test set: recall 0.94 with specificity 0.425 gives roughly 68% accuracy, precision would be near 0.62 rather than 0.96, and an AUC of 0.78 cannot accompany 95% accuracy. No reconciliation is offered anywhere. The instructive point for the synthesis is that this inconsistency is detectable only because the study reported specificity and AUC alongside accuracy; the seven other studies charted here on the same corpus report accuracy alone or accuracy with precision and recall, and an identical internal contradiction in any of them would be invisible. If the specificity is the accurate figure, the model is below chance at identifying non-autistic children, and the paper's 95% headline conceals a result that would substantially undercut the branch's claims. The provenance confound in the corpus is untouched by any of this, since a model recognising autism-related web imagery would succeed on any partition." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-139" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Absent, and identified as absent by the authors. No age, sex, ancestry, socioeconomic, cognitive or comorbidity information exists for either corpus, and the limitations section names gender and ethnicity specifically as missing in a way that constrains generalisation. Two consequences go beyond what is acknowledged. Facial classifiers key strongly on apparent age and sex-linked morphology, and autism is diagnosed roughly four times more often in boys, so an unmeasured sex imbalance between a class harvested from autism-related sources and a class harvested elsewhere could produce the entire separation. And the paper's own motivating claim is morphological - that autistic children 'show morphological differences within their face' - which is precisely the kind of quantity that varies with age, sex and ancestry, none of which is recorded." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-139" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Pattern Recognition 173:112906, Elsevier; received 13 June 2025, revised 11 November 2025, accepted 8 December 2025, online 9 December 2025, with a 2026 volume date. A pattern-recognition venue, and the profile is characteristic: the partition sizes, stratification procedure, quality filter, architectures and metric tables are all documented, while a metric set that is arithmetically impossible on its own stated test set was published without reconciliation, alongside no ethics statement, no diagnostic ascertainment and no chance baseline. The limitations section is nonetheless one of the better ones in the branch, which suggests the shortfall is in verification rather than in candour." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-139" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No acquisition equipment. Training ran on CPU-based hardware, which the authors identify as a limitation that 'limited more profound tuning and real-time optimization' - an honest disclosure, and one that also indicates how low the computational barrier to this branch is." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-139" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Deficit-framed and, in one passage, seriously mischaracterising. Autism is 'a multifaceted neurological development disability' with 'deficits in social communication and emotion detection', and autistic children are described as 'noted for odd actions or hyper/hypo activity because of aggression, self-aggression, and stereotypical movements'. The most objectionable sentence conflates several distinct things: 'Individuals with a severe form of autism can erupt in dangerous outbursts caused by abnormal facial expressions associated with complex emotional states and mistreatment of autistic children'. Against this, two passages show genuine attention to autistic experience. The introduction observes that 'children with significant autism are non-verbal making it difficult for them to express or understand words' and that 'children who are unable to manage their feelings find it hard to express how they feel' - which frames the emotion-recognition task as serving communication rather than surveillance. And the paper's stated motivation for building a separate emotion model is the best reasoning in it: existing systems are 'primarily trained for healthy ones and consequently missing abnormal facial movements', so a model trained on autistic faces is needed. That is the correct diagnosis of a real problem, and one another study in this review confirms empirically by showing that affect models trained on neurotypical faces transfer poorly to autistic children." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-139" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A dedicated limitations section names six issues and is among the more candid in this branch: missing demographic information on gender and ethnicity limiting generalisation across populations; a small image count possibly yielding a less robust model; analysis restricted to static images so that 'facial cues that were dynamic like gaze direction and micro-expressions were not captured'; no validation on independent clinical datasets; no explainable-AI visualisation, limiting clinical interpretability; and CPU-based training restricting tuning. The methods add that only a single split was performed, with the computational reason given. What is not addressed is more consequential. The autism model's reported metrics are mutually inconsistent - accuracy 95% cannot hold alongside specificity 42.5% and recall 94% on a balanced test set, and precision 0.96 cannot hold alongside specificity 0.425 at a 1:1 ratio - and no reconciliation appears anywhere, so the headline figure is uninterpretable. If the specificity is the accurate value then the model misclassifies more than half of non-autistic children, which is below chance and would be the paper's most important result. The corpus's provenance confound is unmentioned, no diagnostic ascertainment exists, the image-level split leaves subject overlap unexaminable since the number of distinct children is unreported, the quality filter introduces an unreported selection, and no chance baseline is given." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-139" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. No severity, cognitive, adaptive or language measure exists for any image in either corpus." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-139" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two constructs, of very different tractability. The autism task targets facial morphology, on the premise that autistic children 'show morphological differences within their face' - a physiognomic claim, unmeasured here, with the models receiving whole face images so that expression, pose, apparent age, ancestry and image provenance are all equally available. The emotion task targets six-way facial expression in autistic children specifically, and the construct argument for it is the paper's strongest contribution: general-population emotion models are 'primarily trained for healthy ones and consequently missing abnormal facial movements'. That correctly identifies a real gap, and the resulting 73.33% is instructive precisely because it is modest - emotion recognition on posed neurotypical adult faces reaches 98-99% in the benchmark literature charted elsewhere in this review, so a drop to the low seventies on autistic children's faces is consistent with the independent finding that affect models transfer poorly across this population. Read together with that study, this one supplies a second data point for the same conclusion." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-139" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Published 2025 by the Department of Computer Science at Bharathiar University, Coimbatore. For this review the study contributes three things. It is the ninth built on the Kaggle autistic-children facial corpus, using the standard 2,526/280/80 partition, and it reports the fullest metric set of any of them - which is precisely what makes its central problem visible: the autism model's figures cannot all be true, since accuracy of 95% is incompatible with the specificity of 42.5% and recall of 94% reported beside it on a balanced 280-image test set, and precision of 0.96 is incompatible with that specificity at a 1:1 ratio. The seven earlier studies on this corpus report accuracy alone or accuracy with precision and recall, and an identical contradiction in any of them would have been undetectable. The lesson for the synthesis is that specificity is not merely an additional metric but an arithmetic check, and its near-universal absence from this branch removes the field's simplest defence against inconsistent reporting. If the 42.5% is the accurate value, the model identifies fewer than half of non-autistic children correctly - below chance, and a finding that would tell against the whole branch. Second, the study's emotion component is genuinely well motivated and its result is instructive. The stated rationale is that existing emotion models are 'primarily trained for healthy ones and consequently missing abnormal facial movements', so a recogniser trained on autistic faces is needed - correctly identifying a real problem - and the resulting 73.33% on six classes sits far below the 98-99% that posed neurotypical benchmarks support, which corroborates the independent finding elsewhere in this review that affect models transfer poorly to autistic children. Third, its limitations section is among the more candid in the branch, naming missing gender and ethnicity data, small sample size, the restriction to static images, the absence of external clinical validation, the absence of any explainable-AI component despite having argued for one, and CPU-only training - and the methods separately state that only a single split was performed and why. That candour makes the unreconciled metric table the more conspicuous. What remains unaddressed throughout is the corpus's provenance: the autistic class was harvested from autism-related online sources, so the label records where an image was found, and no diagnostic ascertainment exists for any child depicted." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-139" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Keywords: Autism spectrum disorder, Emotion prediction, Facial expression analysis, Deep learning, Artificial intelligence. Balanced across population, both tasks and method. Terms carried through the body: hybrid architecture, hierarchical features, explainable AI, stratified sampling, non-invasive, morphological differences." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-139" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two aims are pursued. The first is autism prediction from facial images using a hybrid architecture, justified by the argument that 'a single CNN is utilized within most studies which limits generalization. Therefore hierarchical features with fine grains are not obtained' - so combining ResNet50V2 and InceptionV3 should capture features at multiple granularities. The second, and the paper's better idea, is emotion recognition trained specifically on autistic children's faces, on the reasoning that existing systems are 'primarily trained for healthy ones and consequently missing abnormal facial movements'. The reported results diverge sharply in credibility. The emotion model reached 73.33% on six classes against a VGG16-plus-Random-Forest baseline at 57.33%, with precision 72.26, recall 73.33, specificity 83.90 and F1 70.38 - a modest, internally coherent figure on a genuinely hard task, and one consistent with the difficulty another study in this review documents for affect recognition in autistic children. The autism model's reported set is not coherent: 'accuracy = 95, precision = 0.96, sensitivity/recall = 0.94, Specificity = 42.5, F1 = 0.95 and AUC = 78'. On a balanced 280-image test set, recall 0.94 with specificity 0.425 yields roughly 68% accuracy, not 95%; precision 0.96 is impossible alongside specificity 0.425 at a 1:1 ratio, where the implied 80 false positives against 132 true positives would give precision near 0.62; and an AUC of 0.78 is incompatible with an accuracy of 0.95. The figures cannot all be right and no reconciliation is offered." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-139" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Multimodal inputs and explainable-AI methods are proposed in the abstract, and the limitations section implies five more: demographic diversity, larger datasets, dynamic rather than static analysis, external clinical validation, and GPU-based training. All are reasonable. The step the study most needs and does not propose is reconciliation of its own metric table, followed by participant-level splitting with the number of distinct children reported." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-139" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Normalised and augmented face images, filtered to require a visible frontal face with eyes, nose and mouth. The quality filter is a genuine and unusual step for this branch, since web-scraped corpora contain profile shots, partial faces and heavy occlusion that add noise without adding signal - but it also selects a subset whose class balance is unreported, and if image quality differs systematically between two folders drawn from different online sources then the filter itself could shift the composition." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-139" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Architectural rather than modal fusion. The autism model combines ResNet50V2 and InceptionV3 at the feature level, with the rationale that single-network approaches fail to obtain 'hierarchical features with fine grains'. Combining backbones whose receptive-field structures differ - residual depth against inception-module width - is a coherent argument for multi-granularity feature capture, and it is stated rather than assumed. No ablation isolates what each backbone contributes, so whether the hybrid outperforms its components is not established, and given the inconsistency in the reported metric set the comparison could not be evaluated in any case." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-139" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:study_design "Retrospective algorithm-development study on two public image corpora, fitting a hybrid architecture for autism classification and a separate network for emotion recognition, each …" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: ; comparison: As above" ] ] ;
    slr:content_sha256 "f50db97e12a184ba8d591127cdc010308c496cdc6cc8fbcab32a9e8907ca780b" ;
