            slr:overall_judgment "low" ;
            slr:tool_used "QUADAS-2" ] .

<https://doi.org/10.1007/s10803-022-05685-x> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "This study segmented the time series of gaze behavior from nineteen children with autism spectrum disorder (ASD) and 20 children with typical development in a face-to-face conversation. A machine learning approach showed that behavior segments produced by these two groups of participants could be classified with the highest accuracy of 74.15%. These results were further used to classify children using a threshold classifier. A maximum classification accuracy of 87.18% was achieved, under the condition that a participant was considered as ‘ASD’ if over 46% of the child’s 7-s behavior segments were classified as ASD-like behaviors. The idea of combining the behavior segmentation technique and the threshold classifier could maximally preserve participants’ data, and promote the automatic screening of ASD." ;
    dcterms:bibliographicCitation "Zhao Z; Wei J; Xing J; Zhang X; Qu X; Hu X; Lu J (2022). Use of Oculomotor Behavior to Classify Children with Autism and Typical Development: A Novel Implementation of the Machine Learning Approach. *Jo*. https://doi.org/10.1007/s10803-022-05685-x" ;
    dcterms:creator "Hu X",
        "Lu J",
        "Qu X",
        "Wei J",
        "Xing J",
        "Zhang X",
        "Zhao Z" ;
    dcterms:title "Use of Oculomotor Behavior to Classify Children with Autism and Typical Development: A Novel Implementation of the Machine Learning Approach" ;
    bibo:doi "10.1007/s10803-022-05685-x" ;
    bibo:pmid "local_3ba6d25c" ;
    fabio:hasPublicationYear 2022 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Participant selection and spectrum representativeness" ;
                            slr:justification "Autistic children recruited from a tertiary mental health centre against community controls; restricted to ages 6-13, non-verbal IQ >= 70, conversational competence, no ADHD or schizophrenia, no medication. Children with severe symptoms are excluded by design and the authors say so. 34 of 39 participants are male." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Comparison group adequacy" ;
                            slr:justification "Typically developing children only. No developmental delay, ADHD or language disorder group. The discussion concedes that whether the approach separates autism from other clinical phenotypes 'remains unexplored'." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Handling of missing data and attrition" ;
                            slr:justification "Handled well and transparently: 4 of 43 excluded for tracking failure with group membership stated, segments with >30% loss discarded under a cited rule, and the segmentation design explicitly justified as a way to retain children who would otherwise be dropped for partial data loss." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Confounder control" ;
                            slr:justification "The ASD group's non-verbal IQ is 15.3 points lower (p = .019) and enters no analysis; conversation duration differs by 74% (p < .01) and directly determines how many segments each group contributes. Neither is adjusted, matched or modelled." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Measurement standardisation" ;
                            slr:justification "Fixed 80 cm interviewer distance, one-point calibration verified against named targets before every session, fixed 50 Hz sampling, identical device for all participants, single analysed session with published questions, and participants kept naive to the device's purpose. Acquisition is well standardised and free of the between-group equipment differences seen elsewhere in this corpus." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Reference standard quality" ;
                            slr:justification "Multi-psychiatrist DSM-IV consensus with escalation on disagreement - defensible and clearly described - but no standardised instrument, no reliability statistic, DSM-IV rather than DSM-5, and no autism screening of the control group." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Index test definition and prespecification" ;
                            slr:justification "Neither the window length nor the classification threshold was prespecified; both were chosen post hoc to maximise accuracy on the analysis sample. Table 4 makes the selection distribution visible (0.77-0.87), which is to the authors' credit, but the abstract reports only the maximum." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Outcome measurement blinding" ;
                            slr:justification "Feature computation and classification are automated and label-free at the point of measurement. The live interviewer was presumably not blind to group, which is an unaddressed avenue for differential elicitation, but the measurement itself is not human-rated." ;
                            slr:rating "Low" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Data splitting and leakage control" ;
                            slr:justification "Segments, not participants, were randomly partitioned into the ten cross-validation folds. With one continuous recording per child and windows as short as 1 s, near-duplicate segments from the same child sit on both sides of every split. No participant-level or subject-independent evaluation is reported at any point." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Performance estimation and chance level" ;
                            slr:justification "Genuinely mixed. At the segment level a majority-class baseline is computed and plotted at every window length - an empirically derived chance floor that correctly acknowledges the group-linked class imbalance, and better practice than most studies here. At the participant level there is no baseline, no permutation test, no AUC value and no confidence interval for 87.18%, and that figure is the maximum of a two-dimensional search." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Preprocessing and feature selection nesting" ;
                            slr:justification "Forward feature selection was run to choose the feature subset and the same subset was then reused in all ten folds - the paper states this directly. Selection therefore saw the test data. No scaling or normalisation procedure is described." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Sample size adequacy for the modelling" ;
                            slr:justification "39 children for a per-child claim; the ROC in Fig. 5 is built from 39 points and a single child moves accuracy by 2.6 points. The thousands of segments give an appearance of statistical power that the 39 independent units do not support." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Ethics, consent and conflicts" ;
                            slr:justification "No ethics approval statement, no Declaration of Helsinki statement and no parental consent or child assent statement appears in the report, despite minors, a clinical population and deliberate non-disclosure of the device's purpose. Funding (eight grants) and conflicts of interest (none) are declared in full." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Completeness of methods reporting" ;
                            slr:justification "Experimental protocol reported to a reimplementable standard - segmentation indices, bin sizes, entropy formula, loss threshold, appendix questions, device settings. Computational reporting is thin: SVM kernel, regularisation, scaling, seeds, the threshold search grid and the per-length segment counts (shown only as a bar chart) are all absent." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Data, code and protocol availability" ;
                            slr:justification "No code, no data, no preregistration, no analysis plan. The dataset is a reuse of the authors' own prior study, which is disclosed clearly, but neither release is available for independent checking." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Acknowledgement of limitations" ;
                            slr:justification "Three real limitations are stated and the work is self-labelled proof-of-concept; the confound between oculomotor behaviour and visual attention is conceded outright. But nothing is said about segment-level splitting, post hoc threshold selection, unnested feature selection or the IQ difference." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Reporting of results and uncertainty" ;
                            slr:justification "Rich feature-level tables with t-tests at all ten window lengths, and Table 4 honestly displays all ten participant-level results rather than only the best. But no confidence intervals anywhere, no AUC value, and the abstract and conclusion foreground the maximum accuracy without noting it was selected." ;
                            slr:rating "Unclear" ] ;
                    slr:overall_concern "unclear" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "This is the paper's weak point and the reason its two headline numbers should be read very differently from each other. Segment level: tenfold cross-validation with random partition of segments. The text is unambiguous that the unit is the segment ('all behavior samples were randomly partitioned into 10 subsamples'), and there is no statement anywhere that a child's segments were kept together. With 19 + 20 children each contributing tens to hundreds of windows from one continuous recording, adjacent segments from one child are near-duplicates in feature space, and the classifier can exploit stable individual gaze idiosyncrasies - the exact leakage that Keles et al. in this corpus quantified directly by identifying individuals from gaze at 35.4% against 6.2% chance. So 74.15% is not an estimate of performance on an unseen child. Participant level: the aggregation is applied to those already-leaky segment labels, and then two further quantities are optimised on the same 39 children - the window length (10 candidates, Table 4 shows accuracies 0.77 to 0.87) and the threshold (a sweep whose grid is not specified, optimal values 0.40 to 0.56). Reporting the maximum of that joint search as the study's accuracy is best-of-many reporting; the median of Table 4 is 0.78. Feature selection is likewise unnested, run once on all data with the chosen subset reused in every fold. What the study does do right is the segment-level chance floor: the majority-class baseline is computed and plotted at every window length precisely because the class imbalance is group-linked, and the SVM beats it throughout. That is more care about chance than most studies here take, which makes the absence of the corresponding participant-level baseline or permutation test more conspicuous. A corrected design would partition the 39 children into folds, generate segments within folds, run forward feature selection inside each training fold, and select the window length and threshold on training children only - and would very likely report a materially lower number, as Cilia et al. found when they moved from image-level to participant-level evaluation of the same data." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-095" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Classical machine learning in two stages. Stage one is a support vector machine classifying individual gaze behaviour segments as ASD-like or TD-like, chosen because 'SVM has been often used in ML studies in the field of ASD' - a popularity rather than a suitability argument, with no comparison against any other classifier. Stage two is a threshold classifier: count the proportion of a child's segments labelled ASD-like and call the child autistic if it exceeds a cut-off tuned to maximise accuracy (46% at the optimal 7 s window). No deep learning, no ensemble, no probabilistic model. The two-stage design - weak per-segment classifier plus aggregation to a strong per-participant decision - is the same multiple-instance shape used by Kojovic et al. in this corpus, and it is a sound idea; the difference is that Kojovic partitioned children before generating segments and this study did not, which is precisely what separates a legitimate aggregation gain from an inflated one." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-095" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cognitive ability: Raven's Advanced Progressive Matrices in both groups, non-verbal only, used both as an eligibility gate (IQ >= 70) and as a reported demographic. Language: a qualitative judgement by a speech-language psychologist that the child could sustain average verbal communication - no standardised score. Severity: none. No ADOS calibrated severity score, CARS, SRS, ADI-R algorithm score or any other symptom-quantification instrument was obtained, which is a direct consequence of the stated lack of access to ADOS/ADI-R. The study therefore cannot relate its gaze-entropy features to symptom severity, cannot report where on the spectrum its 19 children sit, and cannot test whether misclassified children were the less severely affected ones. Combined with the exclusion of children with severe symptoms and of those with IQ below 70, the analysed autistic sample is a narrow, cognitively able, verbal slice of the population." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-095" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two stated goals: first, to test whether gaze behaviour segments produced by autistic and TD children can be classified by machine learning; second, to test whether children themselves can be classified from the proportion of their segments the model labels ASD-like. The framing is explicitly novelty-driven - the authors assert that prior eye-tracking ML studies all extracted features from visual fixation patterns and that 'no study has been found to identify ASD with oculomotor behavior', drawing a conceptual distinction between where attention is directed (fixation) and how the eyes move in the sockets (oculomotor). Findings: segment classification peaked at 74.15% (9 s windows, single feature: entropy of gaze allocation in the x-y plane, sensitivity 75.45%, specificity 72.51%), above the majority-class baseline at every window length; child classification peaked at 87.18% (7 s windows, 46% threshold, sensitivity 89.47%, specificity 85.00%). Feature-level statistics show entropy differences significant at every window length from 1 to 10 s (all p <= .006 for the x-y plane), while range differences are significant only at the shortest windows and fall away beyond 4 s - so the discriminative signal is the irregularity of gaze allocation, not its spatial extent. Secondary observation of substantive interest: ASD children took 191 s to complete the same six-question session against 110 s for TD children (U = 48, p < .01)." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-095" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Journal of Autism and Developmental Disorders 53:934-946, an Original Paper - a clinically oriented specialist autism journal rather than an engineering or machine-learning venue. The venue choice shows in the reporting profile: participant characterisation, diagnostic procedure, task protocol and feature-level statistics with t-tests at every window length are all reported to clinical standards, while the computational specification (SVM kernel, regularisation, scaling, code) is thin and the cross-validation unit is left ambiguous. The paper was received in an earlier form, accepted 13 July 2022 and published online 1 August 2022 in the 2022 volume year with a 2023 issue assignment." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-095" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No fusion in this study - a single modality, six features, and the best model uses exactly one of them. The paper is nonetheless one of the more informative in the corpus about fusion, because the authors have a directly comparable prior study on the identical 39 children: Zhao et al. (2021a) reached 84.62% with visual fixation features alone and 92.31% by adding a single non-eye-tracking feature, conversational length. Set beside the present 87.18% from oculomotor features alone, this gives an unusually clean within-sample comparison of three feature families on the same participants - and it also shows how much of the gain in the earlier fusion result came from conversational length, a variable that is essentially a direct measure of the group difference in task duration reported here (191 s versus 110 s). That is worth flagging as a caution about multimodal gains: a fused feature that is itself a near-proxy for group membership will raise accuracy without adding behavioural insight. The authors' recommendation is to fuse oculomotor with fixation features, and, in the longer term, eye tracking with EEG, neuroimaging and kinematics, arguing that segmentation is the enabling technique because it preserves participants who would otherwise be dropped for data loss in any one stream." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-095" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Author keywords: Autism; Behavior segmentation; Entropy; Eye-tracking; Machine learning; Oculomotor. Two are methodological signatures rather than topic labels - 'Behavior segmentation' names the paper's own technique of cutting a continuous gaze recording into short windows, and 'Entropy' names its single discriminative feature - so the keyword set advertises a method rather than a clinical application. 'Oculomotor' is the conceptual claim the paper stakes out against the existing visual-fixation literature. Neither 'diagnosis' nor 'screening' appears, although the abstract closes by proposing to 'promote the automatic screening of ASD'. Terms carried through the body: threshold classifier, gaze allocation, Shannon entropy, support vector machine, forward feature selection, majority class prediction, face-to-face conversation." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-095" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The paradigm is a structured dyadic conversation, notable in this corpus for being live and social rather than screen-based. Four topic sessions were arranged - Generic question, Hobby sharing, Yes-no question, Question raising - but only the first was analysed, for two stated reasons: gaze behaviour is topic-sensitive so pooling sessions would make segments heterogeneous and harder to classify, and the first session was the longest, yielding the most segments. The six questions of that session are published in an appendix. Two design features deserve credit. Head-mounted rather than remote tracking was chosen deliberately so that head movement is unconstrained and gaze in the scene-camera frame reflects eye-in-socket movement. And the participants were kept naive: they were not told the glasses recorded gaze, were not instructed to keep still, and post-experiment questioning confirmed none had guessed - a control against reactive gaze that most eye-tracking studies in this corpus do not report. The countervailing weakness is that the interviewer is a live human whose own behaviour is not standardised or measured, and who was presumably not blind to group; anything the interviewer did differently with the two groups is baked into the child's gaze." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-095" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Diagnosis was clinical and consensus-based rather than instrument-based, and the paper is candid about why: 'Due to a limited access to established ASD diagnostic instruments such as ADOS and ADI-R, the accuracy of the ASD diagnosis in the present study was assured through a variety of other rigorous procedures.' Those procedures were DSM-IV criteria applied by a licensed psychiatrist with at least five years' experience, re-evaluation by a senior psychiatrist, and adjudication by at least two further senior psychiatrists if they disagreed. Additional gates: non-verbal IQ >= 70 on Raven's APM, absence of schizophrenia or ADHD, no medication at the time of the experiment, and adequate conversational ability judged by a speech-language psychologist. TD children were community-recruited, Raven-screened to IQ > 70, self/parent-reported free of physical or mental disorder, and with no ASD/ADHD in first-degree relatives. Note the DSM edition: DSM-IV, not DSM-5, in a study published in 2022. Multi-psychiatrist consensus is a defensible reference standard and better than the single-clinician or registry labels used elsewhere in this corpus, but it is unblinded to everything the clinicians already knew about the child, is not quantified for reliability, and yields no severity gradation." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-095" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Split. The experimental side is highly reproducible: the conversation protocol and its six questions are published, the 80 cm distance and 50 Hz sampling are given, the segmentation arithmetic is written out index by index, the binning is exact (10 px bins giving 192 x-bins, 108 y-bins and 20,736 x-y blocks), the Shannon entropy formula is stated, and the 30% data-loss rule is cited to its source. The computational side is not: no code, no data, no preregistration, no SVM kernel or regularisation parameter, no random seed, no scaling procedure, no statement of how many segments existed at each window length in numbers rather than a bar chart, and no specification of the grid of thresholds searched. A reader could re-run the experiment on new children but could not reproduce the reported numbers from the authors' data." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-095" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two groups. Enrolled: 20 ASD and 23 TD. Analysed: 19 ASD and 20 TD, after data from 1 ASD and 3 TD children were dropped for eye-tracking technical failure. Total analysed n = 39. No third or clinical comparison group. The unit of analysis for the model, however, is the gaze behaviour segment, not the child: at 9 s the two groups jointly contribute several thousand segments (exact counts shown only graphically in Fig. 2b), and because ASD sessions were 74% longer on average the ASD group supplies systematically more segments at every window length." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-095" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Tobii Pro Glasses 2 head-mounted eye tracker sampling at 50 Hz, with an integrated 1920 x 1080 scene camera; gaze coordinates exported in pixels by Tobii Pro Lab. Cognitive assessment by Raven's Advanced Progressive Matrices. Analysis tooling is not named - no MATLAB, Python, R, scikit-learn or LIBSVM is identified, and the SVM implementation, kernel and hyperparameters are unspecified. Calibration was one-point at the interlocutor's body position within Tobii's recommended 0.5-1.5 m working distance, verified qualitatively by checking that the live-view gaze marker overlapped named targets; no numeric accuracy or precision criterion was applied, and no per-participant tracking-ratio statistic is reported beyond the rule that segments with >30% loss were discarded." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-095" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Accuracy, sensitivity and specificity at both the segment and participant level, plus an ROC curve for the participant-level threshold sweep (the AUC is not stated numerically). Sensitivity and specificity are defined explicitly and correctly at the segment level. Missing: AUC value, PPV/NPV, F1, confidence intervals of any kind, calibration, and any significance test on the classification results (the t-tests reported are on the features, not the models). The absence of confidence intervals matters at this sample size: with 39 children, the difference between 87.18% (34/39 correct) and the 77% seen at four of the ten window lengths is four children." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-095" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional; no longitudinal component, no follow-up, no repeat testing, no test-retest reliability for the entropy features. Ethics reporting is the weakest element of the paper: the retrieved full text contains no institutional review board statement, no Declaration of Helsinki statement, and no description of parental consent or child assent, despite the study involving minors, a clinical population, and a deliberate withholding of the device's true purpose from participants. The parent study (Zhao et al., 2021c) may carry the approval, but a secondary analysis reusing identifiable behavioural recordings should restate it. What is declared is a conflict-of-interest statement (none) and a detailed funding list of eight grants." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-095" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Age, sex and IQ reported per group with formal group comparisons: age 99.6 +/- 25.1 versus 108.8 +/- 27.0 months (t(37) = 1.09, p = .283); sex 17:2 versus 17:3 male:female (chi-square = .174, p = .676); IQ 100.8 +/- 22.7 versus 116.1 +/- 22.7 (t(37) = 2.45, p = .019). Age range 6-13 years by inclusion. Nothing else: no race or ethnicity, no socioeconomic status, no parental education, no language background, no medication status beyond the exclusion gate, no comorbidity counts. Both groups are drawn from Shenzhen, China, so the sample is culturally homogeneous - relevant because gaze-to-face norms are known to vary cross-culturally and the entire feature set is spatial gaze allocation during a face-to-face conversation. The significant IQ gap deserves emphasis: it is the one variable that separates the groups, and it is neither matched, regressed out, nor discussed as a confound." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-095" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Six hand-crafted scalar features per fixed-length window of the raw gaze coordinate stream: entropy_x, entropy_y, entropy_xy, range_x, range_y, range_xy. The window length is itself a modelled hyperparameter, swept from 1 to 10 s. The binning that defines the entropy is spatial and fixed to the scene camera resolution (10 px cells), which means the features are defined in the wearer's own head-centred frame rather than in a world or face-referenced frame - an appropriate choice given head-mounted tracking, but one that makes the features depend on the geometry of where the interviewer sat. No normalisation, standardisation or per-participant centring is described, so between-child differences in absolute gaze spread enter the model directly - the same property that makes segment-level pooling risky." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-095" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The authors state three limitations - restricted phenotype (IQ >= 70, verbal, no severe symptoms, 34 of 39 male), restricted and relatively late age band (6-13 years when the clinically decisive window is nearer 3-4), and, in the discussion, the absence of any non-TD clinical comparison. They self-describe the work as 'proof-of-concept'. The unstated limitations are the ones that bear on the headline numbers. (i) Segments, not children, were randomly partitioned into the ten cross-validation folds, so a child's own segments appear in both training and test sets; with only 39 children and thousands of segments, an SVM can learn individual gaze signatures rather than a group property, and the 74.15% is therefore an upper bound of unknown tightness. (ii) The participant-level 87.18% is the maximum over ten window lengths crossed with an unspecified grid of thresholds, all evaluated on the same 39 children - Table 4 shows the neighbouring windows giving 0.77-0.85, so the reported figure sits at the top of its own selection distribution and the honest summary of the method is closer to 'around 0.79 typical, 0.87 at the best of ten'. (iii) Forward feature selection was performed once on all the data and the resulting feature set reused in every fold, so selection is unnested. (iv) The ASD group's IQ was 15 points lower (p = .019) and is never controlled; gaze dispersion during a demanding conversational task is plausibly related to cognitive ability. (v) ASD children spent 74% longer in the session, which both drives the segment-level class imbalance and means the two groups' segments come from conversations of different length and, presumably, different affective character. (vi) No ethics or consent statement. To the authors' credit, the one comparison they do make carefully is the majority-class baseline at the segment level, which is exactly the empirical chance floor the imbalance demands." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-095" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Fuse oculomotor with visual fixation features, since the authors' own earlier work on the same children reached 84.62% from fixation alone and 92.31% with fixation plus conversational length; build a representative ASD oculomotor template on the model of Eraslan et al.'s scan-path trend analysis and classify by similarity to it; pursue the neural basis of gaze irregularity; push the age range down towards the 43-month mean diagnostic age, motivated by evidence of atypical oculomotor behaviour in infants later diagnosed; test against developmental delay and ADHD rather than TD alone; extend to children with more severe presentations and a balanced sex ratio; and separate inherent oculomotor function from visual-attention allocation in unconstrained settings. The last of these is the most interesting, because it is an admission that the paper's central conceptual claim - that it measures oculomotor behaviour rather than attention - is not established by its own data." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-095" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Published online 2022, issued 2023, from Shenzhen University's Institute of Human Factors and Ergonomics with the Shenzhen Guangming District Center for Disease Control and Prevention and Shenzhen Kangning Hospital - an engineering-plus-public-health-plus-psychiatry collaboration, funded by eight Chinese grants including the National Natural Science Foundation, the Shenzhen Science and Technology Innovation Committee and a Guangdong Key Realm R&D Program. The framing is incremental and explicitly novelty-staking: the authors argue that all prior eye-tracking classification work has used visual fixation patterns and that 'no study has been found to identify ASD with oculomotor behavior', then draw a conceptual distinction between where attention is directed and how the eyes move in the sockets. The clinical motivation is the standard one for the period - diagnosis depends on clinician experience and caregiver report, is time-consuming and may be biased by subjective factors - and the proposed role is complementary, that eye tracking 'might be incorporated in clinical practice to complement existing diagnostic procedure'. The paper is unusual for 2022 in explicitly flagging that the whole eye-tracking classification literature, its own work included, has only ever tested against typical development." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-095" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Gaze allocation during live social interaction, reduced to two constructs: regularity, measured as Shannon entropy of the spatial distribution of raw gaze points over 10 px bins (x-axis, y-axis and the 20,736-cell x-y grid), and spatial extent, measured as the maximum distance between the two most remote gaze points on each axis and in the plane. Crucially the representation is deliberately atemporal - gaze allocation 'captured how gaze behavior was mapped spatially without taking into account the temporal information', so no scan path, no fixation/saccade parsing, no dwell time and no areas of interest. The behavioural claim being tested is that autistic children spread gaze more diffusely and less predictably across the visual field during conversation. The results support this for entropy at every window length and for range only at short windows. Two further behaviours are measured but not modelled: conversational duration (191 s versus 110 s, p < .01), which the authors interpret as social-processing difficulty, and, implicitly, the willingness to wear glasses and converse for several minutes, which the sample was selected to guarantee." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-095" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "'Children with autism spectrum disorder (ASD)' and 'children with typical development (TD)', used consistently. Person-first throughout ('children with ASD', 'individuals with ASD', 'people with ASD'); the abbreviations ASD and TD are used as group labels in tables and figures. Deficit-oriented vocabulary is used freely in the interpretation - 'social deficits', 'attentional deficit', 'impairments', 'atypical oculomotor performance', 'ASD behaviors' - and the model's output classes are named 'ASD-like' and 'TD-like' behaviours. There is no engagement with neurodiversity framing and no autistic-community involvement statement." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-095" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Single site in Shenzhen, China. Autistic children were recruited from a first-class mental health centre (Shenzhen Kangning Hospital / Shenzhen Mental Health Center, the affiliation of the child-psychiatry co-author); TD children came from nearby communities. The recording setting is a controlled but not screen-based one: a face-to-face structured conversation with an interviewer at a fixed 80 cm distance, with the child wearing eye-tracking glasses. This is a clinic-adjacent laboratory setting, not a naturalistic home or classroom setting and not a primary-care setting, so the recruitment path guarantees a spectrum-narrow, already-diagnosed autistic sample facing an unselected community control group - the classic case-control geometry whose accuracy does not transfer to a screening population." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-095" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Good by the standards of this corpus, and honest about the limits of its own interpretation. Forward feature selection produces an explicit ranking, and Table 3 shows the striking result that a single feature - entropy of gaze allocation in the x-y plane - achieves the maximum 74.15% and that adding any of the other five slightly reduces accuracy. Table 2 gives group means, SDs and t-tests for all six features at all ten window lengths, letting a reader see that entropy separates the groups at every scale while range does not beyond 4 s. The discussion then supplies a mechanistic account rather than a post-hoc story: higher entropy in the ASD group follows from gaze being distributed more evenly between social and irrelevant regions instead of concentrating on face and body, referencing the authors' own fixation analysis of the same children. And they close by conceding the interpretive cost - 'the atypical oculomotor performance in the children with ASD was inseparable from visual attention in our study' - which is a rare admission that a paper's headline construct is confounded with the one it set out to distinguish itself from. The model is not interrogated at the individual level: no per-child probabilities, no error analysis, no examination of which five children were misclassified." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-095" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:study_design "Cross-sectional two-group diagnostic-classification study; secondary analysis of eye-tracking data collected for a previously published experiment (Zhao et al., 2021c), reusing the…" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: ; comparison: 20" ] ] ;
    slr:content_sha256 "d623501875433e6b297b6f5c48b1741ae972b7c5b2bdd14dfb55236158692e02" ;
