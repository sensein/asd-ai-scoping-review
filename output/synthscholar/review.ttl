            slr:media_type "text/plain" ] ;
    slr:journal "Signal, Image a" ;
    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Case-control sampling with autistic children from a specialist rehabilitation clinic and comparison children from a mainstream school, at 50% prevalence. Filtering is asymmetric: the autistic group faced five inclusion and two exclusion criteria that removed 5 of 25 approached children (20%) for refusing to sit or failing calibration, with no characterisation of those excluded, while no criteria at all are stated for the school-recruited comparison group and no autism screening was applied to it. The autistic sample is further restricted to 'high-performance' children who could sit at a computer and whose face perception a therapist judged adequate. Both groups are entirely male, which is stated in the table and never discussed." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Five of 25 approached autistic children were excluded before any data were recorded, with no comparable attrition reported for the comparison group. The interval between diagnosis and testing is unreported. Most importantly, the analysis units are 240 observations rather than 40 children, randomly partitioned 168/36/36, so each child's six rows are scattered across training, validation and test - a structural flow problem that makes even the test partition non-independent of training." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Autism status rests on clinic admission following diagnosis by a paediatric psychiatrist and a paediatric clinical psychologist plus an undescribed 'comprehensive evaluation'. Two clinicians of different disciplines is a reasonable clinical basis, but no instrument, no DSM or ICD version, no date, no interval to testing and no reliability statistic is reported. The comparison group's status rests on school recruitment and the descriptor 'normal', with no screening instrument, no exclusion criteria and no statement that autism or other neurodevelopmental conditions were ruled out." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "The index test was not prespecified: four nested feature subsets were evaluated on the same data and the best reported as the result, and the network's iteration count and learning coefficient were selected by minimising MSE on an unstated partition. The network's own architecture is never reported. Decisively, the figures quoted in the abstract and conclusion are pooled across training, validation and test rather than held-out, so the reported operating characteristics are not those of the test partition." ] ;
            slr:overall_judgment "high" ;
            slr:tool_used "QUADAS-2" ] .

<https://doi.org/10.1038/s41598-021-94378-z> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Clinical research in autism has recently witnessed promising digital phenotyping results, mainly focused on single feature extraction, such as gaze, head turn on name-calling or visual tracking of the moving object. The main drawback of these studies is the focus on relatively isolated behaviors elicited by largely controlled prompts. We recognize that while the diagnosis process understands the indexing of the specific behaviors, ASD also comes with broad impairments that often transcend single behavioral acts. For instance, the atypical nonverbal behaviors manifest through global patterns of atypical postures and movements, fewer gestures used and often decoupled from visual contact, facial affect, speech. Here, we tested the hypothesis that a deep neural network trained on the non-verbal aspects of social interaction can effectively differentiate between children with ASD and their typically developing peers. Our model achieves an accuracy of 80.9% (F1 score: 0.818; precision: 0.784; recall: 0.854) with the prediction probability positively correlated to the overall level of symptoms of autism in social affect and repetitive and restricted behaviors domain. Provided the non-invasive and affordable nature of computer vision, our approach carries reasonable promises that a reliable machine-learning-based ASD screening may become a reality not too far in the future." ;
    dcterms:bibliographicCitation "Kojovic N; Natraj S; Mohanty SP; Maillart T; Schaer M (2021). Using 2D video-based pose estimation for automated prediction of autism spectrum disorders in young children. *Scientific Reports, 11(1), Arti*. https://doi.org/10.1038/s41598-021-94378-z" ;
    dcterms:creator "Kojovic N",
        "Maillart T",
        "Mohanty SP",
        "Natraj S",
        "Schaer M" ;
    dcterms:title "Using 2D video-based pose estimation for automated prediction of autism spectrum disorders in young children" ;
    bibo:doi "10.1038/s41598-021-94378-z" ;
    bibo:pmid "local_35004e74" ;
    fabio:hasPublicationYear 2021 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are comparison groups matched on the variables that matter?" ;
                            slr:justification "Matched on age, gender and ADOS module, and the training/testing partitions matched on the same covariates." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is cognitive level equated between groups?" ;
                            slr:justification "Best-estimate IQ is measured but not matched, and correlates with model output at -0.283." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are participants and recruitment adequately described?" ;
                            slr:justification "Three samples sized and aged, cohort recruitment documented in three cited publications, with severity, adaptive and cognitive measures for all." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the sample appropriate and adequate for the stated target?" ;
                            slr:justification "237 videotaped assessments of children aged 1.2-6.9, directly matching the early-screening target age." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is a comparison group with other developmental concerns included?" ;
                            slr:justification "Only typical development; the clinically decisive discrimination against other delays is untested." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the comparison group actively screened?" ;
                            slr:justification "Screened for neurological or psychiatric illness and for autism in any first-degree relative - stricter than any other study here." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "low" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the behavioral data acquisition described reproducibly?" ;
                            slr:justification "ADOS modules specified with rationale, video counts, durations and segment statistics tabulated, and the full pose-estimation and preprocessing chain given with parameters." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the source of the movement signal isolated to the child?" ;
                            slr:justification "OpenPose extracts keypoints for all persons; examiner and often caregiver appear in the same input with no separation described." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is acquisition heterogeneity retained rather than controlled away?" ;
                            slr:justification "Different rooms, examiners and camera systems, with robustness to this variability reported." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the reference standard appropriate and independently applied?" ;
                            slr:justification "DSM-5 clinical diagnosis corroborated by ADOS-G/ADOS-2 in an established cohort." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Does the representation exclude appearance and scene confounds?" ;
                            slr:justification "Background removed entirely; only skeletons on black, with features computed for invariance to rigid-body and affine transformation." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "low" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are multiple comparisons corrected?" ;
                            slr:justification "Bonferroni thresholds stated explicitly for each family, and a collinearity-aware PLS-C with 1000 permutations and 1000 bootstraps replaces 27 separate tests." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is uncertainty quantified?" ;
                            slr:justification "No confidence intervals on any performance figure and no comparison against a trivial age-based baseline." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the train/test split by participant?" ;
                            slr:justification "68 children train, 68 held out, matched on diagnosis, age, gender and ADOS module; no child on both sides." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is model selection separated from performance estimation?" ;
                            slr:justification "Architecture and segment length chosen on an 80-20 split inside the training set, with least-validation-loss checkpointing." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the unit of analysis the participant?" ;
                            slr:justification "~505 segment predictions per video averaged into one ASD probability per child before any metric is computed." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is a second validation sample tested?" ;
                            slr:justification "101 further children, but autistic only and from the same cohort, so it estimates sensitivity rather than replicating externally." ;
                            slr:rating "Partly" ] ;
                    slr:overall_concern "low" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is code available?" ;
                            slr:justification "Not mentioned, though all components are standard and fully parameterised." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the dataset accessible or its access conditions stated?" ;
                            slr:justification "No release or availability statement in the extracted text." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are ethics and consent reported?" ;
                            slr:justification "Geneva Faculty of Medicine ethics approval, written parental consent for all children, and separate explicit consent for identifiable published images." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is sensitive video data handled by design?" ;
                            slr:justification "De-identification is achieved by the analytic representation itself - skeletons on black - not by policy assurance." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is a limitations section present?" ;
                            slr:justification "None; only the interpretability caveat is stated, and that in support of future work." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are anomalous or null findings discussed?" ;
                            slr:justification "The VABS-II motor null (p = 0.066) and the inverse IQ correlation both pass without comment." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the model's output validated against independent clinical instruments?" ;
                            slr:justification "ADOS severity, VABS-II subdomains and best-estimate IQ, all Bonferroni-corrected." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "some concerns" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Three samples, all explicitly sized. Training set: 34 autistic and 34 typically developing children. Testing Set 1: a further 34 and 34, drawn from the same 136-child pool and 'equally distributed' with the training set, matched on diagnosis, age, gender and ADOS module. Testing Set 2: 101 videos from autistic children only, aged 2 to 6.9. The partition is by participant, so the 68 children in Testing Set 1 contributed no data to training - the defining structural strength of the study. Testing Set 2's single-class composition is a real limitation on what it can validate: with no typically developing children, its 80.2% figure is sensitivity alone and cannot detect a model that has drifted toward calling everyone autistic. No other-diagnosis or developmentally-delayed comparison group appears anywhere, so the model is never tested against the discrimination that matters clinically - autism versus other developmental concern - only against typical development." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-072" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No keyword list appears in the extracted text. The operative vocabulary is 'digital phenotyping', '2D pose estimation', 'deep neural network', 'non-verbal social interaction' and 'automated screening' - a framing that positions the work within clinical digital phenotyping rather than computer vision, notwithstanding that the machinery is entirely the latter." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-072" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No internal interpretability - no attention, no saliency, no layer analysis - and the authors state the limitation plainly: 'the current level of analysis prevents us from drawing solid conclusions on what is represented in the NN'. What replaces it is external validation against clinical ratings, executed with more statistical care than any comparable analysis in the corpus. Correlations against ADOS severity, VABS-II and best-estimate IQ are Bonferroni-corrected at explicitly stated thresholds (p < 0.025, p < 0.013, p < 0.002 for the 27-item analysis). Recognising that ADOS items are collinear and that 27 separate tests would be the wrong instrument regardless of correction, the authors then run a Partial Least Squares Correlation with 1000 permutations to test the latent component and 1000 bootstrap resamples to establish salience stability - a multivariate treatment that yields a single significant component (p = 0.001) rather than a list of individually surviving items. The resulting picture is coherent: non-verbal coordination items load highest, verbal items lowest. The inference is nonetheless indirect - it establishes that model output covaries with clinically rated non-verbal atypicality, not that the network computes it, and the correlations are inflated by being taken across two groups whose severity distributions barely overlap." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-072" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Autistic group in the main pool: 68 children, 2.80 +/- 0.92 years, range 1.2-5.1. Typically developing group: 68 children, 2.55 +/- 0.97 years, same range. Testing Set 2: 101 autistic children, 3.46 +/- 1.16 years, range 2-6.9. Groups are stated to be matched for diagnosis, age, gender and ADOS module, with the sex distribution given in supplementary Table S1 rather than the main text - the only demographic detail displaced to supplementary material. Matching on ADOS module is a subtler control than most studies apply: module assignment depends on expressive language level, so matching on it partially equates the groups on language, which for a non-verbal-behaviour classifier removes an obvious alternative explanation. The comparison group is nonetheless typically developing rather than developmentally delayed, so age and module matching cannot equate general developmental level - and best-estimate IQ, which is measured, is not reported as matched and correlates with the model output." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-072" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Accuracy, precision, recall, specificity and F1 on the balanced held-out set - a complete set for a binary task, and one that shows the model is not trading sensitivity for specificity (0.854 against 0.765, the most balanced profile among the higher-accuracy studies in this corpus). Two additional evaluations go beyond the standard panel and are more informative than any of them. Accuracy as a function of input video length quantifies the deployment tradeoff directly, showing ~70% at 10 minutes rising to 81% at full length - a dose-response curve for evidence, which no other study here provides. And prediction consistency within an individual, reported as the cumulative incidence of the segment length needed for 100% stable class attribution across randomly drawn windows, measures whether a single child would receive the same answer twice - a reliability question distinct from accuracy and one that matters more for a screening tool than the point estimate does. Missing: no confidence intervals on any figure, no confusion matrix, and no significance test against a trivial baseline such as age." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-072" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Clinical diagnosis under DSM-5, corroborated by gold-standard instruments (ADOS-G or ADOS-2) administered as part of an established longitudinal cohort study, with cohort recruitment procedures documented in three cited prior publications. Comparison children were screened not only for known neurological or psychiatric illness but also for autism in any first-degree relative - a criterion stricter than nearly any other study in this corpus, since it excludes children carrying familial liability who might show subthreshold features and thereby blur the contrast. Ethics approval from the Faculty of Medicine of Geneva University, written informed parental consent for all children, and separate explicit consent for the identifiable figure images." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-072" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Strong on the pipeline, with one class of omission. Reported: OpenPose model variant and keypoint count; background removal; the decision to compute feature vectors from image output rather than raw coordinates, with the stated purpose of invariance to rigid-body and affine transformation; downsampling from 696x554 to 320x240; 5-second segmentation with the selection justified by validation loss against 10 and 15 seconds; full VGG16 layer geometry; LSTM size and both dropout rates; optimiser, loss, batch size, epochs and the 80-20 internal split; the least-validation-loss checkpointing rule; the 0.5 threshold on averaged ASD probability; the sliding-window procedure with its 20-second start and 20-second step; every Bonferroni-corrected significance threshold; and the PLS-C decomposition with its 1000 permutations and 1000 bootstrap resamples. Video-level statistics are tabulated (68/68/101 videos, 47.8/48.7/50.0 hours, ~505 segments per video). Missing: no code or model weights release, no data availability statement in the extracted text, no random seeds, and - the substantive gap - no statement of how many people appear per frame or whether any person-selection was applied to OpenPose's multi-person output, which is exactly the detail needed to know whose movement the classifier is reading." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-072" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Non-verbal social interaction taken as a global pattern rather than as an inventory of separable behaviours - the study's central conceptual commitment. The stated target is 'global patterns of atypical postures and movements, fewer gestures used and often decoupled from visual contact, facial affect, speech', with the emphasis on decoupling: the claim is that autistic non-verbal behaviour differs less in the presence or absence of individual acts than in how gesture, gaze, posture and affect are coordinated with one another and with the partner. That is a behavioural construct which single-behaviour paradigms cannot in principle capture, and it justifies both the whole-assessment input and the temporal modelling. The post-hoc symptom analysis supports the framing empirically: the items that tracked model output most strongly were integration of gaze with other behaviours (0.591), pointing (0.540) and unusual eye contact (0.500) - coordination items rather than frequency items." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-072" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The most consequential representational decision in the corpus: rendered skeletons on a black background, with the background removed entirely. This forecloses whole classes of confound that demonstrably affect other studies here - clinic decor, lighting, camera model, image resolution, clothing, and the facial appearance that group-specific recording conditions can encode. It simultaneously delivers de-identification, which the authors name as a co-equal motivation. Two further choices support generalisation: features are computed from rendered image output rather than raw keypoint coordinates, explicitly 'to obtain feature vectors invariant to a rigid body and affine transformations', so a child positioned differently relative to the camera is not thereby a different input; and downsampling to 320x240 keeps the representation coarse. The residual limitation is that the rendering includes every person OpenPose detects, so the representation is of the interaction scene rather than of the child." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-072" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Scientific Reports 11:15069 (2021), doi 10.1038/s41598-021-94378-z - a broad-scope journal reaching both clinical and computational readerships. The authorship is genuinely interdisciplinary and the division of labour shows in the paper: the Psychiatry Department at the University of Geneva supplies the cohort, the gold-standard clinical measures and the ADOS-item interpretation; AIcrowd supplies the deep learning; and the Geneva School of Economics and Management and Citizen Cyber Lab supply the scalability framing. Two authors are marked as contributing equally, one clinical and one computational. That composition explains why this study alone in the corpus combines competent deep learning with full clinical characterisation, correct partitioning and Bonferroni-corrected multivariate validation - most papers here have one side of that expertise or the other." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-072" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The ADOS assessment itself, filmed end to end and averaging 42 minutes - not a purpose-built task. Only Modules Toddler, 1 and 2 were used, on the stated grounds that these are conducted while moving around a room with attractive toys and demand less language, whereas Modules 3 and 4 are table-based and discussion-heavy. The paradigm's key property is that it requires no new protocol, instrumentation or examiner training: any clinic that already videotapes ADOS sessions holds the raw material. Against that, it inherits a structural feature the paper does not examine - the ADOS is an interactive assessment in which a trained examiner actively presses for social behaviours and adapts to the child's responses, so the recorded scene is a joint product of child and clinician, and the video contains the examiner and frequently a caregiver as well." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-072" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Goal: test whether a network trained purely on non-verbal social interaction, represented as skeletal motion, can differentiate autistic from typically developing children - explicitly framed against prior digital phenotyping that focused on 'relatively isolated behaviors elicited by largely controlled prompts'. Main findings: 80.9% accuracy (precision 0.784, recall 0.854, specificity 0.765, F1 0.818) on 68 held-out children; 80.2% on a further 101 autistic children; ~70% from 10 minutes of video, with 100% within-child prediction consistency from a random 10-minute segment for half the autistic sample; robustness to different rooms, examiners and cameras; ASD probability correlated with ADOS severity (total 0.451, social affect 0.509, repetitive behaviours 0.409), inversely with adaptive functioning (-0.444) and IQ (-0.283); and 15 of 27 ADOS items significantly related after Bonferroni correction, predominantly non-verbal, confirmed by a permutation-tested PLS-C latent component (p = 0.001)." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-072" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Comprehensive and, unusually, used analytically rather than descriptively. ADOS calibrated severity scores for total, social affect and restricted/repetitive behaviour; VABS-II Adaptive Behavior Composite with communication, socialisation, daily-living and motor subdomains; and a Best Estimate IQ constructed to combine 'the most representative cognitive functioning measures for each child', since instruments varied with age and with each child's ability to attend demanding tasks - a pragmatic solution to a real problem in toddler cognitive assessment, and one that is documented rather than glossed. All three feed the validation analyses. Comorbidities are not described for the autistic group." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-072" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional analysis of data acquired within a longitudinal cohort; no longitudinal modelling is performed here, though the parent study follows children over time and the authors position the measure as suitable for tracking development. Ethics are reported in full: approval by the Ethics Committee of the Faculty of Medicine of Geneva University, methods stated to conform to that institution's guidelines and regulations, informed written consent obtained from a parent or legal guardian for every child, and separate explicit consent for publication of identifying images from both the adults and the guardian of the child appearing in Figure 1. The privacy engineering is stronger still: reducing video to skeletons on a black background was adopted partly 'to ensure de-identification of the persons involved', so the analytic representation is itself the anonymisation - among the few instances in this corpus where sensitive video data are handled by design rather than by assurance." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-072" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two concrete and well-motivated directions. Add a spatio-temporal attention mechanism 'to allow knowledge on the specific elements in space and time used to inform the diagnosis process in the network' - which, if it also resolved which person's skeleton drives the decision, would address the study's main unexamined confound. And perform fine-grained annotation along the non-verbal continuum for the behaviours that contributed most, specifically 'the precise annotation of the incidence of communicative gestures, shared affective states, atypical social overtures', to establish what the network learned and to build a measure more sensitive than a 3- or 4-point clinical scale. The broader agenda is finer-grained digital phenotyping able to process data 'at the spatio-temporal resolution that is off limits to human coding', to uncover manifestations not previously evidenced and to define subtypes for more precise clinical action." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-072" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The corpus's reference implementation of correct validation for a segment-generating modality. Three properties matter. Participant-wise partition: the 136 children are split 68/68 into training and Testing Set 1, matched on diagnosis, age, gender and ADOS module, so no child's frames appear on both sides - and matching the partitions on covariates, not merely the groups, is a refinement almost nothing else here applies. Participant-level aggregation: the network trains and predicts on 5-second segments (~505 per video, ~34,000 in training), but every segment prediction within a video is averaged into one ASD probability per child before any metric is computed, so the reported 80.9% is over 68 children and not over 34,000 clips. This is precisely the correction that Cilia had to apply retrospectively, watching image-level accuracy of ~90% fall to ~71% at participant level, and applying it by construction is what makes this figure comparable to a clinical one. Hyperparameter selection is confined to an 80-20 split inside the training set, with the least-validation-loss checkpoint carried forward. Two limits persist. Testing Set 2, though larger, contains only autistic children and comes from the same cohort, so it estimates sensitivity in a slightly older sample rather than replicating externally - no independent site or cohort is tested. And the covariate matching does not extend to cognitive level: best-estimate IQ is measured, differs between a typically developing and an autistic group as a matter of course, and correlates with the model's output at -0.283, so some portion of the separation may reflect general developmental level rather than autism specifically. No leave-one-site-out or examiner-held-out analysis addresses the parallel possibility that examiner behaviour contributes." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-072" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "University of Geneva, Switzerland, within an ongoing longitudinal study of early autism development. The assessments were not staged for this analysis - they are the cohort's routine clinical ADOS sessions, conducted 'in several different rooms', by 'different examiners', and 'filmed with different camera systems'. That heterogeneity is the study's most under-appreciated methodological asset: where other work in this corpus achieves high accuracy under a single fixed acquisition setup and therefore cannot distinguish diagnostic signal from site signature, here the acquisition varies within both classes, so camera, room and examiner cannot serve as proxies for group. The authors report classification robustness to this variability explicitly in supplementary analysis and treat it as evidence for generalisability rather than as noise to be apologised for." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-072" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The study's weakest aspect: there is no limitations section, and the Discussion is uniformly positive. Only one caveat is stated anywhere - that 'the current level of analysis prevents us from drawing solid conclusions on what is represented in the NN' - and it is offered in support of the future-work agenda rather than as a constraint on the claims. Four issues go unaddressed. OpenPose extracts keypoints for all persons present and the videos contain examiner and often caregiver alongside the child, so the model may be reading clinician behaviour, which is systematically different when a clinician is eliciting from a child who does not respond; nothing in the paper isolates the child. The clinical-validity correlations are computed across a mixed two-group sample where severity is near-floor in one group, so they largely re-express the group difference rather than demonstrating within-group grading. ASD probability correlates inversely with IQ and adaptive functioning, raising a developmental-level confound that is reported without comment. And the single null in the entire correlation table is the VABS-II motor subdomain (-0.186, p = 0.066) - the domain a pose-based classifier would most be expected to track - which passes without remark. Testing Set 2 is also presented as endorsing 'the model's stability' without noting that a single-class sample cannot detect loss of specificity." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-072" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2021 (received March, accepted July). The framing is the standard early-detection argument but stated with unusual precision and with quantities attached: autism is detectable at 14 months and with high certainty before two years, yet over 70% of affected children are not diagnosed before 51 months; children diagnosed before age two can gain up to 20 IQ points over the following year, while those diagnosed after four 'will not show any substantial cognitive gain even with adequate intervention'. That last figure converts the diagnostic delay from an inconvenience into a quantified loss and is the strongest version of the early-detection premise in this corpus. The critique of existing tools is equally specific - most screening tests are questionnaire-based, perform with low to moderate accuracy, and are 'prone to recall and subjectivity bias'. What most distinguishes the paper's positioning, though, is its critique of the prior computational literature rather than of clinical practice: it names the field's dominant paradigm - single-feature extraction from controlled prompts - as the limitation to be overcome, and argues that a construct defined by the decoupling of behaviours from one another cannot be measured by indexing those behaviours one at a time. The Discussion is also careful about scope in a way few papers here are, stating that diagnosis 'is unlikely to be set on the track of automated performance before long' and positioning the contribution as screening that catalyses referral." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-072" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "'children with autism', 'children with ASD', 'individuals with autism', against 'typically developing (TD) children', 'their typically developing peers'. Consistently person-first, and the phrase 'their typically developing peers' in the abstract is a comparatively warm construction. 'Patients' never appears. Autism is described in DSM terms as 'impairments in social communication and interactions, and the presence of restricted, repetitive patterns of interests and behaviors', and the surrounding language is clinical rather than pathologising - 'atypical', 'aberrant' and 'unusual' applied to behaviours rather than to children. The Discussion is notably respectful in framing the purpose as supporting development during a plastic period rather than as detecting defect." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-072" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Single-modality by design, and the design is an argument. Sound is discarded, faces are discarded, appearance and scene are discarded, and what remains is 2D skeletal motion alone. The authors' case is that this isolates the non-verbal channel cleanly, and it is strengthened by the symptom analysis: of 27 ADOS items, the 15 that tracked model output were predominantly non-verbal, while the lowest-loading items on the PLS-C latent component were the verbal ones - immediate echolalia and stereotyped language - which the authors correctly attribute to a largely pre-verbal sample rather than to a modelling failure. Their handling of intonation, the one vocal item that loaded highly on a model that cannot hear, is the most careful piece of reasoning in the paper: rather than claiming the network recovered prosody, they explain that atypical intonation occurs in more severely affected, minimally verbal children who simultaneously score higher on atypical social overtures, atypical social response and undirected vocalisation, so the correlation runs through severity rather than through sound. Multi-person fusion is present but unexamined - skeletons of child, examiner and caregiver enter the same input without separation." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-072" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Deliberately minimal on the acquisition side. OpenPose 'uses a simple 2D camera input not requiring any external markers or sensors, thus allowing the retrospective analysis of videos' and is 'immune to variations in resolutions and setting' - so no motion capture suits, markers, depth sensors or calibrated rigs, and existing archives become usable. Analytically: OpenPose COCO model with 18 keypoints (13 body, 5 facial); VGG16 pretrained on ImageNet; a 512-unit LSTM; rmsprop with categorical cross-entropy; training on the Geneva Baobab HPC cluster across RTX 2080Ti, Titan X and Quadro P1000 GPUs; GraphPad Prism v.8 and SPSS v.25 for statistics, both with URLs. The contrast with the marker-based and depth-camera motor studies elsewhere in this corpus is the point - equivalent or better accuracy from ordinary video." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-072" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A CNN-LSTM action-recognition architecture - VGG16 for per-frame spatial encoding, a 512-unit LSTM for temporal dependency within 5-second windows - selected because it 'previously showed a good performance in video-based action classification'. The choice matches the construct: if what distinguishes the groups is the temporal coordination of non-verbal behaviours rather than their static configuration, a model without temporal structure could not capture it. The authors report that the final architecture 'was obtained upon testing various configurations', with the alternatives shown in supplementary Figure S2, and that 5-second segments beat 10- and 15-second segments on validation loss - so architecture and segment length were both selected on the internal validation split rather than on the held-out children, which is the correct separation." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-072" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "One videotaped ADOS assessment per child, averaging 42 minutes; total 47.8 hours in training, 48.7 in Testing Set 1 and 50.0 in Testing Set 2" ;
                    slr:study_design "Case-control classification with a participant-wise training and testing partition, plus a second larger single-group validation sample, drawn from an ongoing longitudinal cohort s…" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Young children with autism, aged approximately 1 to 7 years" ;
                    slr:sample_size_text "ASD/index: 68 in the training and Testing Set 1 pool (34 each), plus 101 in Testing Set 2; comparison: 68 (34 training, 34 in Testing Set 1); none in Testing Set 2" ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "A network seeing nothing but moving stick figures on a black background - no faces, no sound, no scene, no annotation - separated autistic from typically developing children at 80.9% accuracy with balanced sensitivity and specificity, on children held out at the participant level and predicted at the child level rather than the clip level. The result held at 80.2% in a second sample of 101 childre",
                        "Testing Set 1 (68 children, balanced): accuracy 80.9%, precision 0.784, recall 0.854, specificity 0.765, F1 0.818. Testing Set 2 (101 autistic children): 80.2% accuracy, which since the sample is single-class is a sensitivity estimate. Roughly 70% accuracy was already reached using only 10 minutes of video, and for half the autistic sample a randomly drawn 10-minute segment gave 100% consistent cl" ;
                    slr:outcome "Accuracy, precision, recall (sensitivity), specificity and F1 on Testing Set 1; accuracy on Testing Set 2; accuracy as a function of video segment duration; and cumulative incidence of the segment length required for 100% within-child prediction consistency" ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "Testing Set 1 (68 children, balanced): accuracy 80.9%, precision 0.784, recall 0.854, specificity 0.765, F1 0.818. Testing Set 2 (101 autistic children): 80.2% accuracy, which since the sample is single-class is a sensitivity estimate. Roughly 70% accuracy was already reached using only 10 minutes of video, and for half the autistic sample a randomly drawn 10-minute segment gave 100% consistent cl; A network seeing nothing but moving stick figures on a black background - no faces, no sound, no scene, no annotation - separated autistic from typically developing children at 80.9% accuracy with balanced sensitivity and specificity, on children held out at the participant level and predicted at the child level rather than the clip level. The result held at 80.2% in a second sample of 101 childre" ] ] ;
