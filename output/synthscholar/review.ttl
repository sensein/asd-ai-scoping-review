            slr:decision "include" ;
            slr:decision_rationale "Full text confirms use of the Saliency4ASD challenge dataset (300 training and 100 test images with ASD and TD scanpaths), 30 engineered features across three families, a TreeBagger random forest, and reported accuracy, recall, specificity, F1, precision and AUC-ROC on a held-out test set." ;
            slr:full_text_source "user_supplied_pdf" ;
            slr:screening_stage "full_text" ],
