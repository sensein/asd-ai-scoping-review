                    slr:judgment "high" ;
                    slr:supporting_quote "No clinical diagnosis for any respondent. 'Class/ASD' is the summed A1-A10 score thresholded at the AQ-10 cut-off - a deterministic function of a predictor the paper enumerates among its own inputs." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
