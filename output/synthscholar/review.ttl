    slr:journal "Frontiers" ;
    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "Approximately 99% of the five-year-old residents of one municipality, assessed during routine preschool medical examinations, with both groups drawn from the same population cohort and differing only in SRS-2 score. There is no recruitment, no case-control geometry and no spectrum truncation, and the single-age inclusion criterion removes the age confound that affects every other motor study in this review. Age and sex ratio do not differ between groups, and the SRS-2 cut-off is sex-specific. The one limitation, insufficient to raise the rating, is that the sample comes from a single small Japanese town." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Feature selection and hyperparameter optimisation were performed jointly, reducing sixteen candidate variables to three to five per model and fixing the SVM cost parameter, with no statement of whether this occurred inside the leave-one-out folds. Three variable sets were compared on the same participants. No threshold or operating point is prespecified. On 126 participants with 19 positives, unnested joint selection would be sufficient to produce the reported perfect scores." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "The target is a maternal-report SRS-2 total dichotomised at a published population cut-off, with no clinical assessment, diagnostic instrument or second informant for any participant. The authors state that clinical evaluation should be integrated alongside the SRS-2 to improve reliability. A single-informant questionnaire threshold is a legitimate screening target but is not autism, and no reliability estimate accompanies it." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "All 126 participants received both the SRS-2 and the balance assessment, each contributing one feature vector, with leave-one-out cross-validation partitioning participants. No attrition is reported and coverage of the target population is near-complete. The reference standard and index test were obtained in the same period and independently of one another. Unreported: signal-quality criteria for the pressure and pose streams, and any handling of pose-estimation failure." ] ;
            slr:overall_judgment "high" ;
            slr:tool_used "QUADAS-2" ] .

<urn:slr:article:aa6615a55671> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Predictive model using autism diagnostic observation schedule, second edition for differential diagnosis between schizophrenia and autism spectrum disorder Dan Nakamura 1,2*, Yoichi Hanawa 1, Shizuka Seki 1, Misato Yamauchi 1, Yuriko Iwami 1, Yuta Nagatsuka 1, Hirohisa Suzuki 1,2, Keisuke Aoyagi 1, Wakaho Hayashi 1, Takeshi Otowa 3,4 and Akira Iwanami 1,2 1Department of Psychiatry, Showa University School of Medicine, Tokyo, Japan, 2Department of Psychiatry, Showa University Karasuyama Hospital, Tokyo, Japan, 3Department of Psychiatry, Teikyo University School of Medicine, Tokyo, Japan, 4Department of Psychiatry, Teikyo University Hospital, Tokyo, Japan" ;
    dcterms:bibliographicCitation "Nakamura D; Hanawa Y; Seki S; Yamauchi M; Iwami Y; Nagatsuka Y; Suzuki H; Aoyagi K; Hayashi W; Otowa T; Iwanami A (2024). Predictive model using autism. **." ;
    dcterms:creator "Aoyagi K",
        "Hanawa Y",
        "Hayashi W",
        "Iwami Y",
        "Iwanami A",
        "Nagatsuka Y",
        "Nakamura D",
        "Otowa T",
        "Seki S",
        "Suzuki H",
        "Yamauchi M" ;
    dcterms:title "Predictive model using autism" ;
    bibo:pmid "local_cd7545e2" ;
    fabio:hasPublicationYear 2024 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Confounder control" ;
                            slr:justification "Age, sex and education matched and tested; the schizophrenia group extensively characterised on symptom severity, medication and illness course. But intelligence was measured with different instruments in each group - a reading-based premorbid estimate against a directly administered full-scale IQ - and the authors state that the groups therefore cannot be compared on it, which matters because several discriminating items concern conversational structure and content." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Participant selection and spectrum representativeness" ;
                            slr:justification "Consecutive clinical recruitment from one hospital's services for both groups, but restricted to full-scale IQ above 85 and to verbally fluent adults suitable for ADOS-2 Module 4, with comorbidity excluded from both groups and severe positive symptoms from the schizophrenia group. The diagnostically ambiguous and comorbid cases the model targets are exactly those excluded." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Handling of missing data and attrition" ;
                            slr:justification "All 90 participants completed both the diagnostic process and the ADOS-2, with no attrition, indeterminate results or missing item codes reported." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Comparison group adequacy" ;
                            slr:justification "The comparison group is another clinical population recruited from the same service and matched on age, sex and education - the design this review has repeatedly identified as missing across the corpus, and the only instance of it among included studies." ;
                            slr:rating "Low" ] ;
                    slr:overall_concern "unclear" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Reference standard quality" ;
                            slr:justification "Consensus DSM-5 diagnosis by several psychiatrists with extensive experience in both conditions, drawing on clinical interaction and full history, with ADOS-2 and ADI-R explicitly excluded from the process - deliberate independence from the index test, and the strongest reference-standard arrangement in the review for a study of this kind." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Index test definition and prespecification" ;
                            slr:justification "Both published algorithms were applied at their published cut-offs with no modification, which fully prespecifies the study's principal analysis. The six-item model, by contrast, was selected post hoc from 32 candidates on the full sample." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Outcome measurement blinding" ;
                            slr:justification "Administrator blinding to the established diagnosis is nowhere stated, and both groups were recruited from the same service with diagnosis preceding assessment, so blinding is unlikely. Every index-test input is a clinician's ordinal judgement, and no within-study inter-rater reliability was computed at item level." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Measurement standardisation" ;
                            slr:justification "ADOS-2 Module 4 administered by research-certified psychiatrists following a published protocol of 15 prescribed activities over 40 to 60 minutes with published coding criteria for all 32 items - the most standardised behavioural measurement in the review." ;
                            slr:rating "Low" ] ;
                    slr:overall_concern "unclear" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Performance estimation and chance level" ;
                            slr:justification "Both training and test accuracies reported (85.4% and 65.3%); AUC interpretive bands prespecified; DeLong's test for the paired ROC comparison; odds ratios with confidence intervals throughout; and the baseline is the instrument's own published algorithms on the same participants rather than a nominal chance line. The abstract nonetheless presents the apparent AUC of 0.938 without the held-out figure attached." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Sample size adequacy for the modelling" ;
                            slr:justification "Six binary predictors selected from 32 candidates in a sample of 90. The authors state this directly: 'The model had six variables, which was a large number compared to the number of samples; hence, the AUC may have increased due to overfitting.' Sample size was justified against a comparable prior study rather than by power calculation." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Data splitting and leakage control" ;
                            slr:justification "The unit is the participant throughout, each contributing one set of item codes, and the holdout split partitions participants. No form of within-participant leakage is possible." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Preprocessing and feature selection nesting" ;
                            slr:justification "Six items selected from 32 candidates on the full sample, with the apparent accuracy and AUC computed from that same sample and whether selection was repeated inside the training split unstated. The authors identify the resulting overfitting explicitly." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "unclear" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Ethics, consent and conflicts" ;
                            slr:justification "Medical Ethics Committee approval at Showa University School of Medicine, Declaration of Helsinki conformity, and written informed consent from the adult participants themselves rather than through proxies. No financial support of any kind and no competing interests declared." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Acknowledgement of limitations" ;
                            slr:justification "Four limitations stated, including the incomparability of the two intelligence instruments and - the notable one - an explicit account of the holdout accuracy drop with overfitting named as the cause and external validation stated as the requirement. Blinding and item-level reliability are the omissions." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Reporting of results and uncertainty" ;
                            slr:justification "Sensitivity, specificity and explicit false-positive rates for both algorithms; AUCs against prespecified bands with DeLong's test; odds ratios with confidence intervals for every domain and item; non-zero proportions for all 32 items with tests; and both holdout accuracies. The one presentational fault is that the abstract carries the apparent AUC without the held-out figure." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Data, code and protocol availability" ;
                            slr:justification "Contributions stated to be in the article and supplementary material with further inquiries to the corresponding author. No code, no data deposit, no preregistration - though a sample size justification by reference to a prior comparable study is provided." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Completeness of methods reporting" ;
                            slr:justification "Site, separate recruitment windows, full eligibility criteria for both groups, the diagnostic procedure with the explicit exclusion of ADOS-2 and ADI-R, the complete battery per group, the module with activity count and duration and both algorithms' cut-offs, the item dichotomisation rule with a worked psychometric justification, significance thresholds including a stricter alpha for correlations, and the statistical software with version. Missing: blinding, item-level reliability, and the holdout split proportions." ;
                            slr:rating "Low" ] ;
                    slr:overall_concern "low" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Fully interpretable by construction and, unusually, the interpretation is the point rather than a supplement to it. The six predictors are named ADOS-2 items with published behavioural definitions, each reported with an odds ratio, confidence interval and direction, so the model reads as a clinical statement: atypicality in eye contact (OR 34.29), quality of social overtures (OR 10.84) and emphatic or emotional gestures (OR 6.49) points toward autism, while atypicality in reporting of events (OR 0.05), responsibility (OR 0.06) and comments on others' emotions or empathy (OR 0.14) points toward schizophrenia. The complete 32-item table with non-zero proportions and tests lets a reader see the whole profile rather than only the selected six, and the profiles are coherent enough to be taught. The study also performs the construct-validity analysis that this review has repeatedly noted as absent elsewhere: rather than accepting that the ADOS-2 measures autism, it asks what the instrument is measuring in the schizophrenia group and answers with evidence - correlations across all domains with the PANSS negative scale, higher negative-symptom scores in cut-off-positive patients, and cut-off positivity predicted by the negative scale alone. Establishing what a positive score means in a population where it is wrong is a stronger form of interpretability than any saliency map in this corpus." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-125" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two representations, compared directly. The instrument's own algorithm domain scores - communication and reciprocal social interaction under the original algorithm, social affect and restricted repetitive behaviour under the revised - which aggregate item ratings into totals against published cut-offs. And a binary per-item vector recording whether each of the 32 items received a non-zero score. The dichotomisation is the more interesting choice and is justified on psychometric rather than convenience grounds: for several items a higher rating denotes a different presentation rather than a more severe one, and the paper works through item B11, quality of social response, where a rating of 1 describes limited, awkward or inconsistent reactions and a rating of 2 describes odd, stereotyped or contextually inappropriate ones - 'there was no clear difference between scores 1 and 2 regarding the severity of ASD symptoms, and the differences were considered to be limited to phenotypic differences in symptoms'. Treating such a scale as ordinal and summing it is exactly what the algorithms do, and the collapse to presence-or-absence of atypicality is part of why the item-level analysis recovers information the totals lose." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-125" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Frontiers in Psychiatry 15:1493158, Original Research, open access under CC BY; received 13 September 2024, accepted 19 November 2024, published 18 December 2024. Editorial and review handling is disclosed by name as the venue requires. This is a clinical psychiatry journal and the paper reads accordingly: the diagnostic process is described in detail with the explicit exclusion of ADOS-2 and ADI-R from it, the full clinical battery is reported for each group, sample size is justified against a comparable prior study, significance thresholds are stated including a stricter alpha for correlations, AUC interpretive bands are prespecified, effect sizes carry confidence intervals throughout, and the limitations section names overfitting as the explanation for the study's own validation drop. What a computational venue would have added is missing - no code, no data deposit, no statement of the holdout procedure's details - and what a computational venue would have missed is present in full." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-125" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Four limitations are stated and the fourth is the most consequential and the most creditable. The sample is small and the findings require careful interpretation. No upper age limit was applied, which may have caused an age imbalance, though the authors judge the impact limited given the similar ranges, means and standard deviations. Intelligence could not be compared because JART was used in one group and WAIS-III in the other. And: 'the holdout validation result of the Predictive Model showed a decrease in diagnostic accuracy. The model had six variables, which was a large number compared to the number of samples; hence, the AUC may have increased due to overfitting. Therefore, additional validation of the model using external data is required.' Reporting a held-out accuracy of 65.3% against a training accuracy of 85.4%, and naming overfitting as the explanation, places this paper in a very small minority within this corpus - most studies that perform such a check report only the favourable figure, and several report perfect scores without any check at all. What is not stated: whether ADOS-2 administrators were blind to diagnosis, which matters because every input is a clinician judgement; that item-level inter-rater reliability was never established within this study although the analysis operates at that granularity while the instrument's published reliability is at algorithm level; that the two groups were recruited two years apart in non-overlapping windows; that the abstract and results still present AUC 0.938 as the model's discriminative ability with the 65.3% figure confined to the body; that excluding comorbidity from both groups and severe positive symptoms from the schizophrenia group removes precisely the ambiguous cases the model is for; and that no positive predictive value is computed for any realistic clinical case mix." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-125" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The strongest reference standard in the review for the specific question at hand, and its strength lies in what was deliberately left out of it. Diagnoses in both groups were made under DSM-5 by consensus among several psychiatrists with extensive experience in both conditions, drawing on interactions during diagnostic assessment and on prior psychiatric and medical histories. The paper then states the crucial fact: 'ASD diagnosis was a good clinical estimate, as neither the ADOS-2 nor the Autism Diagnostic Interview-Revised (ADI-R) was employed in the assessment process.' Because ADOS-2 items are the index test, any contribution of ADOS-2 to the diagnosis would have made the analysis circular - the model would be predicting a label partly derived from its own inputs, which is the failure this review has documented in the questionnaire-item studies where the class label is an arithmetic function of the modelled features. Here the separation is explicit and deliberate, and it is what makes the headline negative finding meaningful: when the ADOS-2 algorithm labels 45% to 52% of schizophrenia patients as autistic, that is a genuine disagreement with an independent clinical judgement rather than an artefact of shared information. Two qualifications. Best-estimate consensus diagnosis is the accepted standard in adult psychiatry but has no external criterion, so disagreement between algorithm and clinicians is evidence about the algorithm only if the clinicians are taken as correct. And whether the ADOS-2 administrators were blind to the established diagnosis is not stated, which matters more here than in an automated study because every item code is a clinician's judgement." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-125" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Consistently medical and diagnostic, which fits the venue and the question. Autism is 'a neurodevelopmental disorder characterized by persistent deficits in social communication and restricted or repetitive behavioral patterns of interest'; participants are 'patients with schizophrenia' and 'participants with ASD'. The framing throughout is nosological rather than functional - the question is which category a person belongs to and how to tell, not what support they need - and the language of the instrument itself supplies terms like 'unusual eye contact' and 'speech abnormalities associated with autism'. What lifts the paper above simple deficit framing is its treatment of overlap. The introduction traces the shared history seriously, from Bleuler's use of 'autistic' as a basic symptom of schizophrenia through modern evidence of co-occurrence, familial clustering and shared genetic risk, and it describes the distinguishing features in clinical detail - the content and duration of delusions, the presence or absence of self-disturbance, the developmental timing of onset - rather than asserting a clean boundary. The discussion then treats the overlap as substantive rather than as measurement error, proposing that negative symptoms in schizophrenia and social-communication features in autism may share underlying deficits in social cognition. No neurodiversity framing appears and no autistic person is reported as involved in the work, but the paper does not pathologise its participants beyond the diagnostic task it sets itself." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-125" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Well chosen for the question and honestly reported. Sensitivity and specificity of both published algorithms against clinical diagnosis, with the false-positive rates given as the headline numbers (45.0% original, 52.5% revised) rather than left to be derived. AUC for both algorithms and for the six-item model, with the interpretive bands stated in advance (excellent 0.90-1, good 0.80-0.90, fair 0.70-0.80, poor 0.60-0.70, bad 0.50-0.60) and DeLong's test for the paired comparison. Odds ratios with 95% confidence intervals for every domain and every retained item. Apparent classification accuracy of 86.6%. And both holdout figures - 85.4% training, 65.3% test. Reporting the drop is the single most valuable reporting decision in this record. Two gaps: the abstract and results present the apparent AUC of 0.938 as the model's discriminative ability without the held-out figure attached, so a reader who does not reach the limitations section will take away the wrong number; and no positive predictive value is computed for any realistic case mix, which for a differential-diagnosis aid would depend on the relative frequency of the two conditions among referred patients." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-125" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Strong on the clinical protocol, silent on computation. Reported: the site, the separate recruitment windows, full inclusion and exclusion criteria for each group, the diagnostic procedure with the explicit statement that ADOS-2 and ADI-R were excluded from it, the complete battery administered to each group, the ADOS-2 module with its activity count, duration, item count and both algorithms' cut-offs, the item dichotomisation rule with the psychometric argument for it and a worked example, the non-zero proportions for all 32 items with chi-square tests, the complete regression output including odds ratios and confidence intervals for every domain and every retained item, the prespecified AUC interpretive bands, DeLong's test for the paired ROC comparison, both training and test accuracies from holdout validation, the significance thresholds including a stricter alpha of 0.01 for correlations, the sample size justification by reference to a prior comparable study, and the statistical software with version. Not reported: administrator blinding, within-study inter-rater reliability at item level, the holdout split proportion and whether the split was repeated, and code. Data are available from the corresponding author on request." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-125" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional with a single assessment session per participant and no follow-up, though the schizophrenia group's clinical characterisation includes age at onset and duration of illness, giving a longitudinal dimension to the covariates if not to the design. No test-retest data. Ethics reporting is complete: approval by the Medical Ethics Committee of Showa University School of Medicine, conduct in accordance with the Declaration of Helsinki and with local legislation and institutional requirements, and written informed consent from the participants themselves - who, being adults with measured IQ above 85, consented on their own behalf rather than through proxies, which is true of very few studies in this review. The authors declare no financial support of any kind and no competing interests, and acknowledge a named colleague for teaching them ADOS-2 administration and an editing service for language." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-125" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Outpatient and inpatient services of a single university psychiatric hospital in central Tokyo, with both groups drawn from the same institution. This removes the recruitment asymmetry that affects nearly every case-control study in this review, where the autistic group comes from clinical services and the comparison group from schools, kindergartens or community advertising - an asymmetry that introduces differences in ascertainment, motivation and setting alongside the diagnostic difference of interest. Here both groups are patients of the same service, assessed in the same place by the same certified administrators. The setting is also the deployment setting: a differential-diagnosis aid for autism versus schizophrenia would be used in exactly this kind of adult psychiatric service. The corresponding limitation is a single site in one country with one clinical culture, and the two groups were recruited in non-overlapping windows about two years apart, which the paper does not discuss." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-125" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Published December 2024 by psychiatry departments at Showa University and Teikyo University in Tokyo, with no funding of any kind declared and no competing interests, acknowledging a named colleague for teaching the team ADOS-2 administration. The framing is entirely clinical: the two conditions overlap in symptoms, co-occur, cluster in families and share genetic risk, while the features clinicians use to separate them become unavailable in exactly the cases where separation is hardest - when verbal expression is poor, when symptoms are concealed, or when an autistic adult's characteristics did not surface until adolescence. For this review the study is important out of proportion to its size, for four reasons. It is the only included study whose comparison group is another clinical population rather than typical development, and it therefore supplies the evidence that the free-play study charted alongside it identifies as missing when it observes that distinguishing autistic from other non-typically-developing children is the harder and more clinically relevant problem. Its central result is negative and well established: the ADOS-2 - the instrument this literature routinely calls the gold standard and against which computational models are benchmarked - achieved AUCs of 0.562 and 0.569 for autism against schizophrenia in verbally fluent adults, misclassifying 45% to 52% of schizophrenia patients as autistic, with no domain score carrying significant predictive value. That figure should sit beside every high accuracy in this review, because those accuracies were obtained against typically developing comparison groups and none of them has been tested against the discrimination that actually matters in a clinic. Its explanatory finding names the mechanism: what the ADOS-2 detects in schizophrenia is negative-symptom severity, evidenced by correlations across all domains with the PANSS negative scale, by markedly higher negative-symptom scores in cut-off-positive patients, and by a regression in which cut-off positivity is predicted by the negative scale alone - so a measure of social-communication atypicality behaves, in this population, as a measure of negative symptoms. And its own positive contribution is reported with a candour that is rare here: a six-item model reached an apparent AUC of 0.938 and 86.6% accuracy, then fell to 65.3% on a held-out split, and the authors attribute the gap to having six variables in a sample of ninety and conclude that external validation is required. A study that publishes the number that undermines its own headline is a useful counterweight to a corpus in which perfect scores are reported without any held-out check at all." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-125" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "External validation of the six-item model on independent data is stated as the explicit requirement and follows directly from the holdout result. The discussion also opens a mechanistic direction: since the ADOS-2's apparent autism signal in schizophrenia tracks negative symptoms, and since negative symptoms and autistic social-communication features may both reflect deficits in social cognition supported by overlapping brain regions, the two may be partly the same construct measured under different diagnostic labels. Not proposed, and needed if the model is to progress: blinded administration, item-level inter-rater reliability, a sample that includes the diagnostically ambiguous and comorbid cases the model is intended for, comparable cognitive measurement across groups, and predictive values computed for realistic clinical mixes." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-125" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Better characterised on the clinical side than any other included study and weaker on one specific comparison. Reported and compared: age, sex, years of education, and Autism Spectrum Quotient totals for both groups. The schizophrenia group additionally has PANSS positive, negative, general psychopathology and total scores, DIEPSS drug-induced extrapyramidal symptom severity, chlorpromazine-equivalent antipsychotic dosage, age at onset and duration of illness - and all of these are used analytically, in correlations with ADOS-2 scores and in comparisons between cut-off-positive and cut-off-negative subgroups. That depth is what allows the study's most important finding, that ADOS-2 positivity in schizophrenia tracks negative-symptom severity. The gap is intelligence. Both groups were screened at a full-scale IQ above 85, but with different instruments - WAIS-III administered directly to the autism group, the Japanese Adult Reading Test estimating premorbid ability in the schizophrenia group - and the authors state that they were therefore 'unable to accurately compare intelligence between patients with schizophrenia and ASD'. This is not a minor asymmetry: JART is a reading-based estimate of premorbid rather than current function, and schizophrenia commonly involves cognitive decline from premorbid levels, so the two groups may be matched on a threshold while differing substantially in current cognitive ability. Since ADOS-2 Module 4 requires fluent speech and several discriminating items concern the structure and content of conversation, an uncontrolled difference in current verbal ability is a live alternative explanation for part of the item-level pattern. Ancestry and socioeconomic status beyond education are not reported." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-125" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "ADOS-2 Module 4 - 15 standardised interactive activities over 40 to 60 minutes, administered by research-certified psychiatrists, with behaviour rated on 32 items against published criteria. Module 4 is the version for verbally fluent adolescents and adults. This is the most rigorously standardised behavioural paradigm anywhere in this review: the activities are prescribed, the coding criteria are published and detailed, administrators require formal certification, and the instrument's psychometrics are established in the literature (the paper cites sensitivity 89.6 and specificity 82.2 for the algorithms in their validation populations, figures that refer to autism against non-autism rather than against schizophrenia). Two properties of the paradigm are directly relevant to the review's synthesis. It is designed around social presses - the examiner actively creates situations that require reciprocity, so it samples behaviour under demand rather than passively - which is why it elicits far more of the phenotype in an hour than the 90-second free-play or 3-minute video paradigms charted elsewhere. And its cost is the mirror image of the automated approaches: an hour of certified clinician time per participant, which is exactly the bottleneck those approaches exist to relieve. This study is therefore useful as a reference point for what a full-cost, fully standardised behavioural assessment achieves - and the answer, for the autism-versus-schizophrenia question, is an AUC of about 0.56." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-125" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Logistic regression throughout, at three levels: domain scores from each published algorithm as predictors of clinical diagnosis; per-item regressions on dichotomised non-zero indicators to identify predictive items; and a combined six-item model. A further logistic regression within the schizophrenia group predicted ADOS-2 cut-off positivity from the clinical variables that differed between cut-off-positive and cut-off-negative subgroups, returning the PANSS negative scale alone. ROC curves were compared by DeLong's test. With 90 participants and a differential-diagnosis question, regression is the correct tool and no machine learning is attempted or needed - the value of the analysis lies in what the coefficients say, not in maximising a discrimination statistic. The one modelling weakness is the size of the search: six items were chosen from 32 candidates on 90 participants by seeking 'the combination of assessment items with the highest diagnostic predictive accuracy', which is an unregularised selection over a large space, and the holdout result confirms the cost." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-125" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The most thorough severity characterisation in the review, and it is used to answer a question rather than to describe the sample. The Autism Spectrum Quotient was administered to both groups as a self-report measure of autistic traits. The schizophrenia group additionally received PANSS across all four scales, DIEPSS, antipsychotic dosage in chlorpromazine equivalents, age at onset and duration of illness. These measures then carry the study's explanatory finding. All ADOS-2 domains and totals from both algorithms correlated positively with the PANSS negative scale in the schizophrenia group, with strong correlations for the original algorithm's social domain and the revised algorithm's total. Schizophrenia participants meeting the autism cut-offs had substantially higher negative-scale scores than those who did not - 27.61 against 18.36 on the original algorithm (p < 0.001) and 26.29 against 18.37 on the revised - while the positive and general psychopathology scales did not differ. And logistic regression entering all variables that differed between cut-off-positive and cut-off-negative subgroups found that cut-off positivity was predicted by the PANSS negative scale score alone. The conclusion is specific and important: what the ADOS-2 detects in adults with schizophrenia is negative-symptom severity, not autism. This is the kind of construct-validity analysis that this review has repeatedly found missing from studies whose severity data would have supported it, performed here on the group where it matters most." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-125" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. The instrument, a trained administrator and a scoring sheet are the entire apparatus; analysis used SPSS 29.0. The absence of equipment is worth stating explicitly in a review otherwise populated by eye trackers, pressure sensors, motion capture, webcams and wearables, because it inverts the usual cost structure. Nothing needs to be bought, calibrated or maintained, and nothing can fail to acquire - but the assessment consumes 40 to 60 minutes of a psychiatrist who holds research certification in the instrument, plus scoring time. Every automated approach in this corpus is, in effect, an attempt to move cost from that clinician to a device. This study measures what the clinician-borne version delivers on a question the automated work has not attempted." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-125" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None in the sensor sense - a single observational instrument supplies everything. But the retained six-item model is cross-channel in the same way that the free-play model charted elsewhere is: it combines a discourse-content item (reporting of events), a gesture item (emphatic or emotional gestures), a gaze item (unusual eye contact) and three social-reciprocity items (comments on others' emotions or empathy, responsibility, quality of social overtures). No single channel would have sufficed, and the directions differ by channel - gaze, gesture and overture atypicality point toward autism while discourse and empathic-commentary atypicality point toward schizophrenia. That opposition of signs within one model is what allows a six-item combination to reach an apparent AUC of 0.938 where the algorithm totals, which simply add atypicality across channels, reach 0.56. It is a clean demonstration that summing behavioural abnormality destroys the information needed for differential diagnosis, and it should temper the widespread practice in this corpus of building composite atypicality scores." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-125" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The clearest case in the review of a study whose validation honestly undercuts its own headline, and it deserves to be read as a model of reporting rather than as a failure. The six items were selected from 32 candidates using all 90 participants, and the apparent accuracy of 86.6% and AUC of 0.938 come from that same sample - so those figures are development-set performance, not estimates of generalisation. The authors then did what most of this corpus does not: they split the data into training and test samples and reported both results, 85.4% and 65.3%. A twenty-point drop on a single random split of 90 participants is what selection of six binary predictors from 32 candidates should produce, and the authors say so explicitly, naming the number of variables relative to the sample as the cause and concluding that external validation is required. The honest summary of the study's positive finding is therefore that a six-item ADOS-2 combination looks promising and has not yet been shown to generalise. Several further points bear on the validation. The split unit is the participant, so no leakage of the kind that dominates the image and frame-level branches of this review is possible. The comparison baseline is substantive rather than nominal - the instrument's own published algorithms on the same participants - which is more informative than a chance line and makes the negative finding robust to the selection problem entirely, since the algorithms were not fitted here at all. The holdout is a single random split whose proportions and repetition are unstated, and whether item selection was repeated within the training fold is not said; if it was not, the 65.3% is itself optimistic. Administrator blinding to diagnosis is not addressed, and every input is a clinician judgement made after diagnosis was established, so differential expectation is a plausible contributor to the item-level differences. Item-level inter-rater reliability was not computed within the study, although the instrument's published reliability concerns algorithm totals rather than individual items. And the exclusion of comorbid cases from both groups and of severe positive symptoms from the schizophrenia group means that the model was developed on the clean cases and would be deployed on the ambiguous ones. None of this touches the negative result, which is the study's durable contribution: the ADOS-2 algorithms, applied as published by certified administrators to verbally fluent adults with IQ above 85, misclassify 45% to 52% of schizophrenia patients as autistic and achieve AUCs of 0.562 and 0.569 against an independent clinical diagnosis." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-125" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Keywords: schizophrenia, autism spectrum disorder, autism diagnostic observation schedule second edition (printed with a typographical error as 'siagnostic'), differential diagnosis, predictive model. The set is clinically oriented and precise - naming both conditions, the instrument, the diagnostic question and the analytic approach - and would be found by a clinician searching for differential diagnosis rather than by an engineer searching for a method. Terms carried through the body: Module 4, original and revised algorithms, social affect, restricted and repetitive behaviour, PANSS negative scale, cut-off positivity, holdout validation, DeLong's test, non-zero scores." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-125" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The full 32-item behavioural repertoire of ADOS-2 Module 4, spanning communication (spoken language level, speech abnormalities, echolalia, stereotyped word use, offering and asking for information, reporting of events, conversation, descriptive gestures, emphatic gestures) and reciprocal social interaction (unusual eye contact, facial expressions directed to the examiner, language production linked with nonverbal communication, shared enjoyment, communication of own affect, comments on others' emotions or empathy, insight into social situations and relationships, responsibility, quality and amount of social overtures, quality of social response), plus imagination and restricted repetitive behaviour items. The item-level table is the study's richest contribution to this review's behavioural synthesis, because it shows that both conditions produce social-communication atypicality but of distinguishable kinds. The autism group scored non-zero more often on asking for information (90.0% against 50.0%), emphatic or emotional gestures (74.0% against 40.0%), unusual eye contact (72.0% against 22.5%), language production linked to nonverbal communication (90.0% against 55.0%) and quality of social overtures (88.0% against 47.5%). The schizophrenia group scored non-zero more often on reporting of events (60.0% against 24.0%), conversation (57.5% against 32.0%), communication of own affect (80.0% against 54.0%) and comments on others' emotions or empathy (75.0% against 34.0%). Roughly speaking, the autistic profile concentrates in the mechanics of nonverbal social exchange - gaze, gesture, the coordination of speech with nonverbal behaviour, the initiation of overtures - while the schizophrenia profile concentrates in the content and organisation of discourse and in affective and empathic commentary. The finding that matters for every behavioural study in this review is that a measure sensitive to social-communication atypicality in general will flag both groups, and that separating them requires attending to which atypicalities are present rather than how many." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-125" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Ninety adults recruited from the outpatient and inpatient services of Showa University Karasuyama Hospital in central Tokyo: 40 with schizophrenia (27 men, 13 women, mean age 33.53 years, SD 10.95) recruited between April 2022 and December 2023, and 50 with autism (35 men, 15 women, mean age 33.80 years, SD 8.39) recruited between October 2018 and December 2020. Both groups required a full-scale IQ above 85 and both were diagnosed under DSM-5 by consensus among several psychiatrists with extensive experience in both conditions. Three features distinguish this sample from almost every other in the review. Both groups are clinical, drawn from the same service, so there is no clinic-versus-community recruitment asymmetry and no typically developing comparison group at all. Both are adults with fluent speech and average or above-average measured ability, which is the population in which differential diagnosis is genuinely difficult and in which most of this corpus's paediatric work has nothing to say. And roughly a third of each group is female (30% and 33%), against the heavy male preponderance typical of autism research samples - a consequence of studying adults presenting to psychiatric services rather than children referred to developmental research. Groups did not differ on age, sex or years of education. The unit of analysis is the participant, with one set of ADOS-2 item codes each." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-125" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The aim was to identify similarities and differences in the symptoms of schizophrenia and autism, establish a more objective method of differential diagnosis, and characterise autistic features in schizophrenia - motivated by a clinical problem the introduction sets out at length: the two conditions co-occur, cluster in families, share genetic risk and produce overlapping presentations, while the features that distinguish them (the content and duration of delusions, self-disturbance, developmental timing) are precisely the ones that become unavailable when verbal expression is poor, when symptoms are concealed, or when a high-functioning autistic adult's characteristics did not surface until adolescence. The findings answer that question in three parts. The ADOS-2's own algorithms failed: 45.0% and 52.5% of the schizophrenia group screened positive on the original and revised algorithms, AUCs were 0.562 and 0.569, and no domain score of either algorithm carried significant predictive value. An item-level model built on six items - A7 reporting of events, A10 emphatic or emotional gestures, B1 unusual eye contact, B6 comments on others' emotions or empathy, B8 responsibility, B9 quality of social overtures - reached apparent accuracy 86.6% and AUC 0.938, significantly outperforming both algorithms by DeLong's test, but dropped to 65.3% under holdout validation. And the autistic-looking features in schizophrenia proved to be negative symptoms: ADOS-2 scores correlated with the PANSS negative scale, cut-off-positive patients had higher negative-symptom scores than cut-off-negative patients, and cut-off positivity was predicted by the negative scale alone. The negative finding is the durable one. The positive finding is a promising direction whose own validation shows it is not yet ready." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-125" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:study_design "Cross-sectional clinical comparison and diagnostic prediction-model development study, contrasting two clinical groups rather than a clinical group against typical development, wit…" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: ; comparison: 40 adults with DSM-5 schizophrenia (27 men, 13 women), mean age 33.53 years (SD 10.95), all with JART-estimated full-scale IQ above 85" ] ] ;
    slr:content_sha256 "950102ba05d816eabffd7e496ede08fe1851b8d531835af41f79766eea2b5592" ;
