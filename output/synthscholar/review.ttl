    slr:journal "International Journal of Intelligent Engineering and Systems, 18(4" ;
    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "A three-stage pipeline with no architecture, learning rate, batch size, epoch count or image resolution specified, an unstated Fire Hawk Optimizer search space and objective, and no ablation isolating any component." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "A 2,540/400 image-level split is defined but not used: the reported accuracy of 96.94% equals 2,850 of 2,940 correct classifications over the entire dataset, so 86% of the evaluated images were training images. The 400-image test set yields no reported number." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
