    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "The three-level severity grouping is inherited from the original collection with no named instrument behind the moderate/severe distinction, and the severe stratum has no corresponding measurements." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "One hundred and nine children with no age, sex or demographic information reported, and a severe-ASD group of nine for whom no Kinect data exist at all - so one of the three classified groups contains no real measurements from any child." ],
