    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "No diagnostic instrument, criteria or procedure is reported; class labels are inherited from the dataset without description." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "Image counts for training and test are stated, but no scanpath counts, no participant counts and no exclusions are reported." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "An organiser-held-out test set with withheld labels is a genuine strength, but subject identity is inconsistent across images so subject-independent evaluation is impossible and the reported figures are scanpath-level rather than person-level." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "No participant counts, ages, genders or selection criteria are reported at all; the sample is defined only by inheritance from a challenge dataset whose composition is not described." ] ;
