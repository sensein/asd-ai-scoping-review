    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Groups matched only on age range and sex ratio with no means or tests; no cognitive, language or severity measures; comparison group unscreened; and the two groups were recruited, recorded and processed as entirely separate collections at different times." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "The two groups were recorded on different equipment in different settings - tripod-mounted video camera in a therapy room versus parents' phones at home - and every reported acoustic family depends directly on microphone type, distance and room acoustics; feature selection was performed on the full dataset before splitting." ],
                [ a slr:RoBDomainJudgment ;
