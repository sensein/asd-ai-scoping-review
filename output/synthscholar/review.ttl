        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "A CARS score of 30 or above, per ADOS guidelines, and being between the ages of 8 and 12 were eligibility prerequisites. Because ADI-R and ADOS evaluations are not widely available in India, experienced physicians made diagnoses using the DSM-5 criteria together with CARS scores." ] ;
            oa:hasTarget <urn:slr:article:420caf43bd93> ;
