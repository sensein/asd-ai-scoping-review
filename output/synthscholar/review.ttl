<urn:slr:article:f7f1df920e13> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "In this work, we focused on classiﬁcation of the participants with Attention Deﬁcit Hyperactivity Disorder (ADHD), Autism Spectrum Disorder (ASD) and typically developing children, based on their performances during an emotion recognition experiment that we developed. We prepared an experiment environment where participants were shown images of faces of people exhibiting certain emotions up to a certain strength and then they answered the question “What is the emotion of this person?” . The response and response latency of the participants were recorded and used for the classiﬁcation process. Before the classiﬁcation step, in order to select the relevant images which are used as features in this work, ReliefF feature selection algorithm was used. Machine learning feature selection and classiﬁcation algorithms were used on different deﬁnitions of the classiﬁcation problem where the differentiation between two classes against each other or one class against the other two classes were aimed. The selected features (images shown) and the classiﬁcation performance changed based on the classiﬁcation problem deﬁnition." ;
    dcterms:bibliographicCitation "Uluyagmur-Ozturk M; Arman AR; Yilmaz SS; Findik OTP; Genc HA; Carkaxhiu-Bulut G; Yazgan MY; Teker U; Cataltepe Z (2016). ADHD and ASD Classification Based on Emotion Recognition Data. *I*." ;
    dcterms:creator "Arman AR",
        "Carkaxhiu-Bulut G",
        "Cataltepe Z",
        "Findik OTP",
        "Genc HA",
        "Teker U",
        "Uluyagmur-Ozturk M",
        "Yazgan MY",
        "Yilmaz SS" ;
    dcterms:title "ADHD and ASD Classification Based on Emotion Recognition Data" ;
    bibo:pmid "local_dc5fc4bb" ;
    fabio:hasPublicationYear 2016 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are participants and recruitment adequately described?" ;
                            slr:justification "Group sizes and mean ages only - no SDs, ranges, gender, IQ or comorbidity information." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are comparison groups matched?" ;
                            slr:justification "No matching procedure or comparability test reported; imbalance corrected only by oversampling." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the sample appropriate and adequate for the stated target?" ;
                            slr:justification "n=61 across three groups with only 13 controls, for a three-way differential classification claim." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the reference standard appropriate and independently applied?" ;
                            slr:justification "DSM-IV-R and K-SADS-PL under specialist supervision, but no ADOS/ADI-R and no assessment of control status." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are predictors defined without knowledge of outcome?" ;
                            slr:justification "Responses and latencies are automatically logged." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the behavioral data acquisition described reproducibly?" ;
                            slr:justification "Stimulus set (Cohn-Kanade, 40 images) and logged variables are stated, but the presentation software, display, timing precision and session protocol are not." ;
                            slr:rating "Partly" ] ;
                    slr:overall_concern "some concerns" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the reported result free of selection optimism?" ;
                            slr:justification "Best of five classifiers x three data types x eight class groupings, with and without feature selection." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is a validation scheme reported?" ;
                            slr:justification "No cross-validation, split or repetition count anywhere in the paper." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is there external or independent validation?" ;
                            slr:justification "None." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is class-imbalance handling free of leakage?" ;
                            slr:justification "Random oversampling to 30 per group appears to be applied to the full dataset before classification." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are sample bias and imbalance discussed?" ;
                            slr:justification "Class imbalance is acknowledged and corrected, but demographic bias, the tiny control group and comorbidity are not discussed." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is code or an implementation available?" ;
                            slr:justification "None." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are ethics, consent and privacy handling reported?" ;
                            slr:justification "Named ethics board with protocol and reference numbers, and signed parental consent forms." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are limitations and future directions stated?" ;
                            slr:justification "Neither a limitations section nor any future work is offered." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the dataset accessible or its access conditions stated?" ;
                            slr:justification "No data availability statement; only the public stimulus set is identifiable." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "high" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Reported by the authors: class imbalance across groups, attributed to 'technical problems' and corrected by random oversampling to 30 per group. Identifiable in review: very small control group (n=13); no gender data at all, so sex bias cannot be assessed in a literature where ASD samples are typically male-skewed; no age matching; single-site outpatient recruitment; no reported handling of ASD-ADHD comorbidity despite a three-way design; post-hoc selection of the best-performing class grouping and classifier; oversampling apparently applied before rather than within validation; and no validation scheme reported, so all accuracies are of unknown optimism." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-003" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None proposed. The conclusion summarises results only and states no open questions or future directions." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-003" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "'participants with Attention Deficit Hyperactivity Disorder (ADHD)', 'participants with Autism Spectrum Disorder (ASD)', 'typically developing children', 'control group', 'people with ASD', 'participants with asd'. Consistently person-first/diagnosis-first; no identity-first usage." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-003" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Symbolic/event-based per-stimulus features: a 40-dimensional vector of binary correctness values and a 40-dimensional vector of millisecond latencies, indexed by image identity, plus their concatenation. No raw time series, embeddings or images are fed to the models." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-003" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A computerised emotion-recognition task: 40 facial-expression images shown up to a certain expression strength, with the participant answering 'What is the emotion of this person?'. Response correctness and latency were logged. Participants were recruited from outpatient referrals and randomly assigned to sessions." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-003" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Goal: differential classification of diagnosis (screening rather than diagnosis) from emotion-recognition task behavior, including several binary regroupings of the three classes. Main findings: ASD-vs-others 91.11% (AdaBoost + ReliefF on response time); ADHD-vs-ASD ~90% on response time; control-vs-others 80%; feature selection and group redefinition both improved accuracy." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-003" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Behavioral task performance in response to facial-expression stimuli: response correctness and response latency. This is recorded behavior in a perceptual task rather than a directly sensed modality such as gaze, speech or motion." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-003" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Effectively unaddressed. No cross-validation scheme, train/test split or repetition count is reported; no external validation; no held-out site; no statistical comparison between classifiers; no deployment or real-time claim. Class imbalance is handled by random oversampling to 30 instances per group, apparently applied to the full dataset before classification, which would leak duplicated samples across any train/test boundary." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-003" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Supervised learning. Algorithms: decision tree, random forest, support vector machine, k-nearest neighbour and AdaBoost, each evaluated with and without ReliefF feature selection across eight class-grouping definitions." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-003" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A custom application displaying Cohn-Kanade images and logging responses and latencies; the platform, display hardware and timing precision are not specified. The acknowledgements credit an eye tracker (ITU Computer Engineering Kullab) and sensors (tazi Machine Learning Solutions), but neither contributes data to the reported analysis." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-003" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Three groups: ASD (n=18), ADHD (n=30) and typically developing controls (n=13). Group sizes are reported; this is one of the few corpus studies with a non-autistic clinical comparison group. No demographic breakdown beyond mean age." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-003" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Accuracy only - reported as best and mean across the three data types. No sensitivity, specificity, precision, recall, F1, AUC or confidence intervals, which is a serious gap for imbalanced clinical classes." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-003" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No data availability statement, no code release, no hyperparameters (beyond ReliefF k=10), no seeds, and - critically - no statement of the validation scheme. The Cohn-Kanade stimulus set is public, but the collected participant data are not. Not reproducible as reported." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-003" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Clinic setting - a child and adolescent psychiatry outpatient department. Newly collected application-log data; stimuli drawn from the existing public Cohn-Kanade facial-expression database." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-003" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "ReliefF weighting (k=10, Manhattan distance) selects informative images, and symmetric uncertainty quantifies feature-class correlation per grouping (highest for ADHD-vs-ASD: 0.336 on correctness, 0.449 on latency). The number of selected images is reported but not which images or emotions they were, so no interpretable behavioral feature emerges." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-003" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "ASD n=18 (mean age 10.5), ADHD n=30 (mean 9.46), control n=13 (mean 9.22). No standard deviations, no age ranges, and no gender distribution for any group. No matching procedure and no statistical test of group comparability is reported. Class imbalance was handled after the fact by random oversampling to 30 per group." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-003" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2016. The related-work section positions the study against neuroimaging-based ADHD classification and against kinematic ASD classification in 2-4 year-olds (Crippa et al.), explicitly noting that its own high-functioning, older ASD participants are harder to separate from controls - an early acknowledgement that sample severity drives reported accuracy across this literature." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-003" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No cognitive, linguistic or adaptive-functioning measures reported. ASD participants are described as high-functioning and older than the low-functioning samples in prior work, but no IQ figures are given. Comorbidities are not described, and it is not stated whether ASD-ADHD co-occurrence was excluded - a material omission given the three-group design." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-003" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Author keywords: ReliefF feature selection; human-computer interaction; classification; emotion recognition; Autism; ASD; ADHD; ASD diagnosis; ADHD diagnosis. Task vocabulary: 'classification of the participants', 'predict the diagnosis', 'differentiate participant groups'." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-003" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two behavioral streams (correctness and latency) are combined by simple feature concatenation (RC&RT) and compared against each separately - an early-fusion feature-level combination. No integration with clinical scores, demographics or parent report." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-003" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional, single session; no session duration or number of sessions reported. Data are behavioral logs (correctness and millisecond latencies), not identifiable media, so sensitivity is low. Ethics approval (Marmara University Medical Faculty Ethical Advisory Board, protocol 09.2014.0194) and signed parental consent are reported; no anonymization or data-protection procedure is described." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-003" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "15th IEEE International Conference on Machine Learning and Applications (ICMLA) 2016 - a technology/computational venue (machine learning), not an autism or clinical venue." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-003" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "ASD: DSM-IV-R diagnostic criteria. ADHD: Turkish version of K-SADS-PL. Both applied at the Marmara University Child and Adolescent Psychiatry Outpatient Department under the supervision of the department head. No ADOS or ADI-R." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-003" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "Single computerised session per participant; 40 emotional images presented; no session duration reported" ;
                    slr:study_design "Cross-sectional case-control classification study with multiple redefined binary class groupings" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder and attention deficit hyperactivity disorder" ;
                    slr:sample_size_text "ASD/index: 18 ASD; 30 ADHD; comparison: 13" ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "Best ASD-vs-others: 91.11% accuracy (AdaBoost with ReliefF on response-time data). Control-vs-others: 80% (k-NN, 15 selected features; 68.89% without feature selection). ADHD-vs-ASD: ~90% on response-time data with AdaBoost, and 80% on combined RC&RT; best mean accuracy across data types 85.56% for the ADHD-ASD grouping",
                        "Response correctness and latency in a facial emotion-recognition task carry enough signal to separate ASD, ADHD and typically developing children; ReliefF feature selection improved accuracy in general, and redefining the three-class problem into binary groupings raised accuracy further. The strongest result was distinguishing ASD from the combined ADHD-plus-control group (91.11%) using response t" ;
                    slr:outcome "Accuracy only (best and mean across data types)" ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "Best ASD-vs-others: 91.11% accuracy (AdaBoost with ReliefF on response-time data). Control-vs-others: 80% (k-NN, 15 selected features; 68.89% without feature selection). ADHD-vs-ASD: ~90% on response-time data with AdaBoost, and 80% on combined RC&RT; best mean accuracy across data types 85.56% for the ADHD-ASD grouping; Response correctness and latency in a facial emotion-recognition task carry enough signal to separate ASD, ADHD and typically developing children; ReliefF feature selection improved accuracy in general, and redefining the three-class problem into binary groupings raised accuracy further. The strongest result was distinguishing ASD from the combined ADHD-plus-control group (91.11%) using response t" ] ] ;
