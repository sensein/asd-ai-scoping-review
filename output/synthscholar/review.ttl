        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "In addition, the comparison between the IC differences shows that children with ASD have more diversity in DVPs. When the pattern section length was less than five, the IC difference for the ASD group was greater than the BG difference, which easily caused misjudgment." ] ;
            oa:hasTarget <urn:slr:article:5e6c6c482e7c> ;
