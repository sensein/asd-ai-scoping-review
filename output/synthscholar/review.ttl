        [ a prov:Activity,
                slr:ScreeningDecisionRecord ;
            dcterms:title "Prediction for children with autism spectrum disorder based on digital behavioral features during free play" ;
            bibo:pmid "local_abad69fd" ;
            slr:assessed_on "full_text" ;
            slr:decision "include" ;
            slr:decision_rationale "Full text confirms a prospective primary study conducted at Peking University Sixth Hospital and associated intervention centres between January and August 2022. Two hundred and forty-six children were assessed; autism was established by best-estimate clinical diagnosis from senior child and adolescent psychiatrists under DSM-5 criteria and corroborated by CARS-2, with exclusions for comorbid psychiatric diagnosis, major physical or neurological disease and prior psychotropic medication. A standardised 90-second free play task was videotaped, coded by three trained coders against a purpose-built manual with inter-coder consistency of 83.7-91.7%, converted into 81 count, duration and proportion indicators, and reduced by univariate screening and stepwise logistic regression to a five-predictor nomogram evaluated with ROC, Hosmer-Lemeshow, bootstrap and a calibration curve. Eligible on all criteria. The behavioural coding is performed by humans rather than by an algorithm, which the review records but does not treat as disqualifying: the modelling step is computational, the indicators are quantitative and designed by the authors to serve as a substrate for later automatic recognition, and the study occupies the same evidential position as the automated studies while being far better specified on the clinical side." ;
            slr:full_text_source "user_supplied_pdf" ;
            slr:screening_stage "full_text" ],
        [ a prov:Activity,
                slr:ScreeningDecisionRecord ;
            dcterms:title "Analyzing Human-Robot Interaction Using Machine Vision for Autism screening" ;
            bibo:pmid "local_cb9a5b48" ;
            slr:assessed_on "full_text" ;
            slr:decision "include" ;
            slr:decision_rationale "Full text confirms 8 children with ASD and 8 typically developing children, 190 s of overhead-camera-tracked interaction with the RoboParrot robot, grid-based presence features, KNN/SVM/decision tree/discriminant/logistic classifiers with 8-fold cross-validation, and a reported accuracy of 81.3%." ;
            slr:full_text_source "user_supplied_pdf" ;
            slr:screening_stage "full_text" ],
        [ a prov:Activity,
