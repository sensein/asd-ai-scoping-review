            slr:relevance_score "0.91"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "We used AutoML tool to analyse the performance of different classifier models and employed Support Vector Machine (SVM) with radial basis function (RBF) kernel for further analysis since SVM reported the best classification accuracy ... We employed grid search and 5 fold cross-validation method to determine the optimal regularisation parameter C and the free parameter gamma" ] ;
            oa:hasTarget <urn:slr:article:6de639c98328> ;
