            slr:overall_judgment "high" ;
            slr:tool_used "QUADAS-2" ] .

<https://doi.org/10.1109/ACCESS.2017.DOI> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Autism Spectrum Disorder (ASD) is a neurological condition that significantly affects cognitive abilities, language comprehension, object recognition, interpersonal skills, and communication capabilities. Its primary origin is genetic, and early detection and intervention can mitigate the need for costly medical procedures and lengthy examinations for individuals affected by ASD. An effective teaching approach may be challenging to determine for a child with autism. Autism Spectrum Disorder is highly diverse, with each affected child being unique. It is often stated that no two autistic children are alike, meaning that what benefits one child may not be suitable for another. Two ASD screening datasets of toddlers are merged in this study. The SMOTE method to balance the dataset, followed by feature selection methods. The research introduces a two-phase system: the first phase employs various machine learning models, including an ensemble of random forest and XGBoost classifiers, for accurate ASD identification. In the second phase, the study focuses on identifying appropriate teaching methods for children with ASD by evaluating their physical, verbal, and behavioural performance. This research aims to provide personalized educational approaches for individuals with ASD, harnessing machine learning to enhance precision in addressing their unique needs." ;
    dcterms:bibliographicCitation "Hajjej F; Ayouni S; Alohali MA; Maddeh M (2025). Novel Framework for Autism Spectrum Disorder Identification and Tailored Education With Effective Data Mining and Ensemble Learning Techniques. *IEEE Access*. https://doi.org/10.1109/ACCESS.2017.DOI" ;
    dcterms:creator "Alohali MA",
        "Ayouni S",
        "Hajjej F",
        "Maddeh M" ;
    dcterms:title "Novel Framework for Autism Spectrum Disorder Identification and Tailored Education With Effective Data Mining and Ensemble Learning Techniques" ;
    bibo:doi "10.1109/ACCESS.2017.DOI" ;
    bibo:pmid "local_b9de0d7f" ;
    fabio:hasPublicationYear 2025 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Data source and eligibility described" ;
                            slr:justification "One dataset cited by URL, the other with no accession; no eligibility criteria, response rates or respondent verification for either." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Participants appropriate to the question" ;
                            slr:justification "Two pooled online questionnaire datasets with no recruitment description; the regional structure that motivated the merge is never used or reported." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Sample size justified" ;
                            slr:justification "No sample size is reported at any stage - not the merged total, not the post-SMOTE total, not the class counts, not the split sizes." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Predictors assessed blind to outcome" ;
                            slr:justification "Three feature-selection methods rank features against the class label with no statement of nesting inside the training partition." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Predictors defined and measured appropriately" ;
                            slr:justification "The ten Q-CHAT-10 items are constituents of both phase labels; the physical, verbal and behavioural performance invoked for Phase II does not exist in the data." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Preprocessing applied without leakage" ;
                            slr:justification "SMOTE oversampling is applied with no statement of whether it precedes or follows the split, and no row counts allow the question to be settled." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Outcome determined independently of predictors" ;
                            slr:justification "In both phases the outcome is an arithmetic function of the predictor set." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Outcome clinically meaningful" ;
                            slr:justification "The severity-to-intervention mapping (PRT, technology-aided instruction, PECS, task analysis, IBI) is uncited, has no evidence base, and assigns the most intensive intervention to the least affected band." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Outcome definition and ascertainment" ;
                            slr:justification "Phase I outcome is the Q-CHAT-10 cut-off; Phase II outcome is a column fabricated with numpy by binning the same score, with no educational or clinical assessment behind it." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Performance measures adequate" ;
                            slr:justification "No AUC, specificity, calibration or confidence interval; no chance level for either the binary or the seven-class task; the printed cross-validation average does not match the printed folds." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Limitations and overinterpretation" ;
                            slr:justification "No limitations section, no future work; Phase II results are offered to educators as a basis for decisions with significant impact on children's learning and development." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Analysis unit matches the clinical claim" ;
                            slr:justification "One row per toddler, matching the claim's subject; an unknown proportion of rows are SMOTE-synthetic." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Validation design guards against optimism" ;
                            slr:justification "80:20 split plus 10-fold cross-validation over a circular label, with SMOTE and feature selection of unstated ordering; the two-cohort merge that would have permitted genuine external validation is discarded." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Reported result traceable" ;
                            slr:justification "The 99.99% used to claim superiority over four published figures appears in no results table and exceeds the study's own best tabulated value of 0.99." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No modality fusion. The only fusion is the merging of two questionnaire datasets from different regions, which is dataset pooling rather than multimodal integration - and, as noted, the regional structure created by that merge is then discarded rather than used for cross-cohort validation." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-149" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Autism Spectrum Disorder (ASD); Autism Students Learning; SMOTE; Multi-model Learning; Feature Engineering. Three of five terms name technique; the educational claim that occupies half the paper appears only as Autism Students Learning." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-149" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Parent-reported early social-communication behaviours from Q-CHAT-10 - response to name, eye contact, gestures, pointing, pretend play, gaze following, comforting, early speech, staring. No behaviour is observed, and the physical and verbal performance invoked in the Phase II framing does not exist in the data." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-149" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No participants were recruited. Two public toddler screening datasets are merged: the Kaggle ASD Toddler set (1,054 instances, 17 columns) and an online questionnaire dataset covering toddlers aged 12-36 months across regions of Saudi Arabia. The size of the second dataset is never given, the size of the merged set is never given, and the size after SMOTE oversampling is never given - so the number of rows behind every table in the paper is unknown, and it cannot be determined how many are real records and how many synthetic. Class counts are likewise absent. The stated motivation for merging - improving diversity by combining two regions - is the paper's best idea and is never exploited: the two cohorts are pooled rather than used as development and held-out sets." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-149" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No instrumentation. Python with scikit-learn for modelling; numpy is named specifically as the library used to create the Phase II teaching-method column. No versions, seed, hardware or runtime." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-149" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No validated cognitive, adaptive, language or severity measure. The Q-CHAT-10 total is repurposed as a severity index in Phase II, binning children into five severity levels. Q-CHAT-10 is a binary screening instrument with a single cut-off; it was neither designed nor validated to grade severity, and using its total as a severity scale is an unsupported extension that Phase II then rests on entirely." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-149" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2025 (accepted version, citation DOI 10.1109/ACCESS.2024.3349988). Framing moves beyond diagnosis into intervention allocation: the aim is personalised educational approaches for individuals with ASD, harnessing machine learning to enhance precision in addressing their unique needs, with results said to help educators make informed decisions. The paper opens by insisting that no two autistic children are alike and closes by assigning them to six intervention categories on the basis of a ten-item checklist total that the authors themselves binned. It is the corpus's clearest example of a pipeline whose output is an action taken on a child rather than a probability, built on a target the authors wrote with numpy." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-149" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None, and the paper states the label rule plainly enough that this is not in doubt: a 1 is scored for each Q-CHAT-10 item answered Always, Usually or Sometimes, and a total above 3 indicates the presence of potential ASD traits. That threshold is the outcome variable. No clinician, diagnostic instrument, criterion or assessment date exists for any record in either dataset, and the online questionnaire origin of the Saudi data means the respondents were not verified either." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-149" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Accuracy, precision, recall and F1 across four feature conditions, seven classifiers and an ensemble; per-fold cross-validation values; Phase II results; and a state-of-the-art comparison. No AUC, no specificity, no calibration, no confidence interval, and no chance level for either the binary Phase I task or the seven-class Phase II task. Two internal inconsistencies matter. The 10-fold table prints an average accuracy of 0.986 while the ten listed fold accuracies average 0.9876, and it contains a fold reporting recall 0.999 against accuracy 0.988 and another reporting accuracy 0.999 - values out of line with their neighbours. More seriously, the comparison table credits the proposed approach with 99.99% accuracy, positioning it above four quoted literature figures (98.77%, 97.82%, 99.25%, 99.85%), when the study's own best tabulated result is 0.99 and its cross-validated average is 0.986. The headline claim of surpassing the state of the art rests on a number the paper never produced." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-149" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No study setting. Two downloaded or pre-existing questionnaire datasets, analysed in Python. No computing environment, runtime or data-handling arrangement is described." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-149" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None stated. There is no future-work section." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-149" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. There is no limitations section and no caveat anywhere. Unmentioned: that the label is a threshold on the summed predictors; that the Phase II target was manufactured by the authors from that same total; that the reported 99.99% appears in no table; that the printed cross-validation average does not equal the mean of the printed folds; that row counts are absent throughout; and that no ethics approval was sought for a study producing educational placement recommendations." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-149" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Low. The one Kaggle dataset is linked and the Q-CHAT-10 label rule is stated explicitly, which is better than most of the branch. Everything else is missing: the second dataset has no accession, the merged dataset that is claimed as a contribution is not deposited, no row counts are reported at any stage (pre-merge, post-merge, post-SMOTE, per class, per split), no hyperparameters are given for any of eight models, no seed or library versions appear, the number and identity of features retained by each of the three selection methods are never stated, and the order of SMOTE relative to the split is unspecified. The manuscript is also visibly an unedited accepted version - the header retains Date of publication xxxx 00, 0000 and the placeholder DOI 10.1109/ACCESS.2017.DOI, and the running footer reads VOLUME 4, 2016 throughout." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-149" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two goals. Phase I: identify ASD from merged toddler screening data using seven classifiers plus a proposed RF-XG voting ensemble, under three feature-selection schemes. Phase II: recommend an appropriate teaching method for each child from their physical, verbal and behavioural performance. Headline findings: RF-XG reaches 0.94 on original features, 0.92 with Bi-Directional Elimination, 0.98 with Boruta and 0.99 with ML-based feature selection; 10-fold cross-validation averages 0.986; and Phase II predicts the teaching-method label at 0.9917. The comparison table separately claims 99.99%, a number that appears in none of the results tables and exceeds every figure the study actually reports." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-149" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Seven classical classifiers - random forest, decision tree, logistic regression, KNN, SVM, gradient boosting, XGBoost - plus an RF-XG voting ensemble presented as the novel contribution. Three feature-selection techniques (Bi-Directional Elimination, Boruta, ML-based selection) are compared. No hyperparameter is reported for any model." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-149" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None reported. Gender is present as a variable and is named as a factor in the Phase II rationale; ethnicity, region and jaundice exist as columns; no counts, proportions or distributions are printed for any of them. The absence of a regional breakdown is the notable one, since regional diversity is the stated reason for merging the two datasets and the merged column would have made a two-cohort comparison immediate." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-149" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "ASD, autism spectrum disorder, autistic children, children with ASD, individuals affected by ASD, high-level and low-level autistic children, autism students. The abstract opens with a genuinely thoughtful observation - that ASD is highly diverse, each affected child is unique, no two autistic children are alike, and what benefits one child may not suit another - and the whole paper is then organised around assigning children to one of six teaching methods on the basis of a checklist total. The severity vocabulary (high-level, moderate-to-high, low-level autistic children) applies the label to the child rather than to support needs, and the framing describes ASD as having a primary origin that is genetic and as significantly affecting cognitive abilities and object recognition." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-149" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A single feature-ranking figure from the ML-based selection method. No attribution analysis, no examination of which features drive the teaching-method assignment, and no interrogation of why three different feature-selection methods produce accuracies spanning 0.92 to 0.99 on the same data." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-149" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "IEEE Access - a high-volume open-access multidisciplinary engineering journal. The published PDF is the unedited accepted version, retaining template placeholders in the header (Date of publication xxxx 00, 0000; DOI 10.1109/ACCESS.2017.DOI) and a VOLUME 4, 2016 footer throughout. No reviewer questioned a fabricated educational-placement target, a 99.99% figure absent from the results, or the absence of any ethics statement in a paper recommending educational interventions for individual children." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-149" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Tabular rows of ten binary Q-CHAT-10 items plus demographic and history fields, SMOTE-augmented and feature-selected. The ten items are the constituents of the Q-CHAT-10 total whose threshold defines the Phase I label and whose bands define the Phase II label, so in both phases the predictor set arithmetically determines the outcome." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-149" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No task or paradigm - an online caregiver questionnaire. Phase II claims to assess children's physical, verbal and behavioural performance, and this claim is unsupported at the most basic level: the dataset contains ten checklist items and a handful of demographic fields, and no physical, verbal or behavioural performance measure of any kind." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-149" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Phase I follows the familiar pattern: an 80:20 split plus 10-fold cross-validation over data whose label is a threshold on the summed predictors, with SMOTE applied at an unstated point relative to the split and feature selection of unstated nesting. Row counts are absent at every stage, so no reported figure can be located to a sample. That much places the study alongside local_ed30e24c, local_8253c2ec and local_a0d73248 in the circular-label group. Phase II is a different and more serious matter, and it is the reason this record exists. The teaching-method target did not come from any school, therapist, assessment or record: the paper states that a new column named Teaching Method was added to the dataset using the numpy library, containing integers 1 to 6 for six specialised teaching methods plus 0 for no special education needed, and that these were assigned on the basis of severity as analysed from the Q-CHAT-10 score, which is the count of the A1-A10 values. The models are then trained to predict that manufactured column from the other columns - including A1 to A10 themselves. The reported 0.9917 accuracy therefore measures how well a classifier reproduces an arithmetic rule that the authors wrote, applied to the very features they wrote it from. It is not an estimate of anything about children, education or autism; a lookup table would score 1.00. Compounding this, the mapping from severity band to intervention (Pivotal Response Training for high-level, technology-aided instruction for moderate-to-high, PECS for moderate, task analysis for low-to-moderate, Intensive Behavioral Intervention for low) is asserted with no evidence base, no clinical input and no citation, and it inverts the usual intensity gradient by assigning the most intensive intervention to the least affected group. The results are then offered to educators and professionals as a basis for informed decisions about teaching methods that can have a significant impact on the children's learning and development. The merged two-region design offered a genuine external-validation opportunity - train on one cohort, test on the other - and it is not taken." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-149" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional secondary analysis. There is no ethics statement, no consent statement and no data-governance statement anywhere in the article. That absence is more consequential here than in most of this corpus, because the output is not a screening probability but a specific educational placement recommendation for individual children, offered to educators as a basis for decisions affecting their learning and development." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-149" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "Internal: seven classifiers against the RF-XG ensemble, across four feature conditions. External: literature-quoted accuracies of 98.77%, 97.82%, 99.25% and 99.85%, none re-run." ;
                    slr:study_design "Retrospective secondary analysis of two merged public tabular screening datasets; two phases of supervised classification (ASD traits, then teaching method), with SMOTE balancing, …" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: Not reported.; comparison: Not reported." ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "Phase I: with original features RF-XG reaches 0.94; with Bi-Directional Elimination 0.92; with Boruta 0.98; with ML-based feature selection 0.99. Ten-fold cross-validation gives an average accuracy of 0.986. The state-of-the-art comparison table, however, lists the proposed approach at 99.99%, a figure that appears in no results table and exceeds every value the study reports. Phase II: RF-XG pred" ;
                    slr:outcome "Accuracy, precision, recall and F1 for each model in each feature condition (Tables 3-6), per-fold cross-validation results (Table 7), Phase II classification results (Table 8), and a state-of-the-art comparison (Table 9). No AUC, no specificity, no calibration, no confidence intervals." ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "Phase I: with original features RF-XG reaches 0.94; with Bi-Directional Elimination 0.92; with Boruta 0.98; with ML-based feature selection 0.99. Ten-fold cross-validation gives an average accuracy of 0.986. The state-of-the-art comparison table, however, lists the proposed approach at 99.99%, a figure that appears in no results table and exceeds every value the study reports. Phase II: RF-XG pred" ] ] ;
