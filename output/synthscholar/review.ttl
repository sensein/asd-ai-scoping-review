    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "Prospective M-CHAT-R/F screening for all, with ADOS-2 Toddler Module and DSM-5 determination by research-reliable licensed psychologists for those referred, and part of the comparison group also directly evaluated; mean 0.7 months between diagnosis and app administration." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "Participant-level leave-one-out cross-validation cited to the validation-bias literature, Hanley-McNeil confidence intervals on every AUC, formal variance-based classifier comparison, inter-eye normalisation of displacement, population-wide entropy tolerance, and analysis restricted to verified attending segments." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "Exclusion criteria stated in full, per-movie sample sizes after the 40% data-quality gate reported in every figure, attention rates given for both groups (95% and 93%), and the excluded non-autism group identified with its reason." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "some" ;
