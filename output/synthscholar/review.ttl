    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "All 58 recruited subjects are accounted for and the five ASD exclusions are reported with their reason, but the exclusions are entirely within one group and no sensitivity analysis addresses whether the excluded subjects differed systematically." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "Broad multi-source recruitment with control status defined by explicit exclusions and both age and sex differences formally tested as non-significant, but control ages extend to 34 against an ASD maximum of 17, IQ is uncontrolled and reported only as a range, and five ASD subjects were excluded for eye-tracking failure with no controls excluded." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "The eye tracker is confounded with diagnostic group - all ASD subjects were recorded at 300 Hz while 29 of 35 controls were recorded at 60 Hz - and fixation frequency, duration, timing and saccade amplitude, the features the model ranks most important, are precisely those a fivefold sampling-rate difference distorts; the authors dismiss this in a single sentence without analysis." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "Diagnosis established through standardized instrument testing, review of diagnostic history and prior evaluations, and DSM criteria confirmed by clinical research staff, with controls screened by exclusion of psychiatric history, developmental delay and special education." ] ;
            slr:overall_judgment "high" ;
            slr:tool_used "QUADAS-2" ] .

<urn:slr:article:d77a4a355d1d> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Autism spectrum disease (ASD) is a neurological disease that affects social interaction, communication and behaviour, thus early diagnosis is essential for treatment. Existing detection methods, such as 2D face scans and eye tracking data, are ineffective in capturing difﬁcult facial features and minor asymmetries. Hence, this study presents a novel Convolutional Shape Appearance Model with Randomized Trees-based XGBoost to increase the accuracy and reliability of ASD detection using 3D facial landmark localization. Existing methods fail to capture small facial asymmetries and detailed landmarks essential for accurate diagnosis from 3D facial images, which limits the accuracy of diagnosing ASD-related behaviours. To address this, a novel convolutional neural network (CNN) with an active shape appearance model (ASAM) is introduced, which combines the strengths of CNNs in automatically learning intricate facial features from 3D images and ASAM’s ability to capture variations in facial shapes and textures, thereby enhancing the feature extraction process and accurate localization of facial landmarks. Furthermore, existing detection methods struggle to integrate and analyse facial asymmetry and the complex interactions between multiple facial features simultaneously, leading to reduced accuracy in detecting ASD. Thus, a Euclidian graph with a Randomized Treesbased XGBoost approach is utilized, which captures spatial relationships between facial landmarks and models complex feature interactions, thereby enhancing the accuracy and reliability of ASD detection. The ﬁndings demonstrate that the suggested model offers excellent levels of accuracy, precision, recall, detection accuracy, sensitivity and speciﬁcity when compared to other existing models." ;
    dcterms:bibliographicCitation "Attar N; Paygude S (2025). Enhanced ASD detection using 3D facial landmark localization with convolutional shape appearance model and graph-randomized XGBoost. *Sādhanā, 51(1), Article 30*." ;
    dcterms:creator "Attar N",
        "Paygude S" ;
    dcterms:title "Enhanced ASD detection using 3D facial landmark localization with convolutional shape appearance model and graph-randomized XGBoost" ;
    bibo:pmid "local_986436f2" ;
    fabio:hasPublicationYear 2025 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Data source and eligibility described" ;
                            slr:justification "Dataset URL is given, but no eligibility criteria, provenance, collection method or annotation procedure; Table 1's demographic and morphology strata are not present in the cited source." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Sample size justified" ;
                            slr:justification "No justification. Image count is treated as sample size; effective n at the child level is never considered." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Participants appropriate to the question" ;
                            slr:justification "No participants; images of unknown children from public web sources, with the number of distinct individuals unknown and repeated faces likely." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Predictors defined and measured appropriately" ;
                            slr:justification "Predictors are described as 3D facial landmarks but are 2D Dlib landmarks on 224x224 web photographs; the reported 0.9 mm localisation error has no metric basis in the data." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Preprocessing applied without leakage" ;
                            slr:justification "Cross-validation is correctly nested inside the training split, but augmentation is described as a preprocessing step rather than as confined to training folds." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Predictors assessed blind to outcome" ;
                            slr:justification "Landmark extraction is automatic and label-independent, but the Table 1 annotations that characterise the data were produced by an undescribed process." ;
                            slr:rating "Unclear" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Outcome definition and ascertainment" ;
                            slr:justification "Outcome is a Kaggle folder label on a web-scraped image; no clinical ascertainment of any kind." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Outcome determined independently of predictors" ;
                            slr:justification "Formally independent - the label was not derived from the image features - but the label's own validity is unestablished, so independence is uninformative." ;
                            slr:rating "Unclear" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Validation design guards against optimism" ;
                            slr:justification "Image-level split, an unexplained 200-image hand-selected final evaluation subset, and metrics reported at the maximum of an epoch sweep with no stopping criterion." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Analysis unit matches the clinical claim" ;
                            slr:justification "Claims concern screening children; the analysis unit is the image, on a corpus with unknown per-child image counts." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Performance measures adequate" ;
                            slr:justification "Specificity claimed but never reported; no confidence intervals; the five cross-validation folds are never summarised; and the confusion matrix, the stated evaluation size and the reported precision, recall, F1 and accuracy are mutually inconsistent." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Limitations and overinterpretation" ;
                            slr:justification "A substantive limitations section that addresses the wrong study - four of five items concern 3D imaging hardware never used - while the data provenance, label validity, annotation source and internal arithmetic go unmentioned; future work proposes classroom deployment." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No task or paradigm. Static photographs, no stimulus, no interaction, no session. The construct measured is facial morphology, though the abstract describes the target as ASD-related behaviours and the keyword list includes eye tracking, which appears nowhere in the method." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-143" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Accuracy, precision, recall, F1, loss, AUC, detection accuracy (reported separately from accuracy and never defined), miss rate, fall-out, millimetre localisation error, and a confusion matrix. The abstract claims excellent specificity but no specificity value appears. The internal arithmetic does not hold: the confusion matrix reports 146 true non-ASD, 141 true ASD, 9 false positives and 4 false negatives, summing to 300 cases although the stated final evaluation set is 200 images and the test split is 506. Those cell counts give accuracy 287/300 = 0.957, precision 141/150 = 0.940 and recall 141/145 = 0.972 - none of which match the reported 0.985, 0.975 and 0.987. Separately, F1 is given as 0.925 while precision and recall are 0.975 and 0.987, whose harmonic mean is 0.981; no combination of the reported figures is mutually consistent." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-143" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Multimodal extension (3D scans plus voice analysis, eye tracking and movement data); explainability to improve clinical trust and transparency; real-world deployment in classrooms and social interactions on mobile or edge devices; robustness to lighting, expression and morphological variation. The classroom-deployment proposal is worth flagging - it would place automated facial ASD screening in schools, applied to children who have not consented and on the basis of a model trained on web-scraped photographs with no diagnostic labels." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-143" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Facial landmark detection; autism spectrum condition detection; 3D facial landmark; convolutional neural network; eye tracking. The last is a keyword for a modality the study does not use, and 3D facial landmark describes data the study does not have." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-143" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional. Ethics reporting is absent: the declarations section contains only a conflict-of-interest line. There is no approval, no consent statement, and no consideration of the fact that the corpus consists of photographs of identifiable children scraped from the web and redistributed with an autism label attached. The limitations section does raise a genuine ethical point - that false positives cause unnecessary family stress and false negatives delay intervention - which makes the silence on image provenance more conspicuous rather than less." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-143" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No fusion - a single image modality. The architecture stacks several representations of the same photograph (CNN features, shape-appearance model, landmark graph, boosted trees), which the paper presents as integrating multiple facial features but which is pipeline depth rather than multimodality. Genuine multimodal fusion with voice, gaze and movement is deferred to future work." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-143" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "An 80-20 stratified image-level split (2,020 / 506) with 5-fold cross-validation inside the training portion. The cross-validation placement is correct in principle and better than most of this branch. Four problems undo it. First, the split is image-level, not child-level, on a corpus known to contain repeated faces, so the same child can appear on both sides. Second, augmentation by rotation and scaling is described as part of preprocessing rather than as applied within training folds only. Third, and most serious, the headline numbers do not come from the 506-image test set at all: 200 images (100 ASD, 100 non-ASD) were selected from the test set for the final evaluation, with no selection rule stated, which is the definition of a hand-picked evaluation subset - and the accompanying confusion matrix nonetheless totals 300. Fourth, every reported metric is presented as a monotone function of epoch count with the maximum always at the largest value tried (500), and no criterion determined where to stop, so the reported figures are the best point on a curve rather than the output of a prespecified procedure. The cross-validation folds, having been run, are never reported as a mean and standard deviation." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-143" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Sadhana 51(1):30 - the Indian Academy of Sciences' general engineering-sciences journal, not a clinical or specialist vision venue. This is relevant to the review's venue analysis: the mismatch between a 2D Kaggle photo set and a paper about 3D scanning, the unsourced demographic table, the absent ethics statement and the internally inconsistent confusion matrix all survived a 324-day review cycle at a general engineering journal." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-143" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Claimed but not delivered. Randomized Trees are described at length as revealing which facial features are most relevant for distinguishing between ASD and non-ASD individuals, yet not a single importance value, ranking or plot is reported - the one output that would have shown whether the model attends to facial geometry or to image-provenance artefacts. Explainability is then listed as future work, in a paper whose central claim is that specific facial measurements carry diagnostic information." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-143" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No diagnostic confirmation of any kind. The class labels are Kaggle folder names on images gathered from the open web. No clinical assessment, no instrument, no assessor, no date, and no record of who the children are. The paper does not mention this once, and instead treats the labels as ground truth adequate to support claims about automated ASD screening." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-143" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Section 5.1 is a real limitations section and, judged in isolation, a thoughtful one: cost and technical barriers to 3D imaging in clinics, the asymmetric harms of false positives and false negatives, residual demographic bias from underrepresented facial morphologies, lighting effects on scan quality, and computational cost precluding real-time use. Judged against the study, it is misaddressed - four of the five items concern 3D scanning hardware the study never used. Nothing is said about the dataset's web provenance and absent diagnostic labels, about the unexplained demographic annotations, about evaluating on a hand-selected 200-image subset, about the confusion matrix that sums to 300, or about the fact that all comparator figures are quoted from another paper rather than measured." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-143" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "OpenCV and Dlib for landmark detection, Python for the pipeline, XGBoost for classification; Windows 10, 8 GB RAM, Intel i3, no GPU. Training settings: Adam, learning rate 0.001 chosen by grid search over [0.0001, 0.01], batch size 32, 500 epochs, 224x224 input, rotation and scaling augmentation. No versions, no seed, no runtime." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-143" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "There are no participant groups in any meaningful sense. The unit is the image file: 2,526 images, 1,263 labelled ASD and 1,263 labelled non-ASD, downloaded from a Kaggle re-upload of the web-scraped autism face corpus. The number of distinct children behind those images is never asked, and because the corpus is known to contain multiple images of the same faces, the effective sample is unknown and certainly far below 2,526. An 80-20 split gives 2,020 training and 506 test images, but the headline evaluation is then run on 200 images selected from the test set - and the reported confusion matrix sums to 300 (146 + 141 + 9 + 4), agreeing with neither figure." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-143" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. No cognitive, adaptive, language or severity measure - none is derivable from a photograph, and none is discussed as missing." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-143" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Table 1 presents an unusually complete-looking demographic breakdown: age bands 2-5 / 6-9 / 10-12 years (850 / 880 / 796), sex 1,340 male and 1,186 female, ethnicity Caucasian 750, Asian 620, African 530, Hispanic 370, Middle Eastern 156 and Indigenous 100, urban 1,480 versus rural 1,046, and a partition by facial structure variation into broad upper face 505, wide-set eyes 725, shorter middle face 625 and narrow jawline 671. Every row sums exactly to 2,526. None of this metadata exists in the cited Kaggle dataset, which distributes only two folders of JPEGs; the paper describes no annotation procedure, no rater, and no automatic estimator for age, ethnicity, urban/rural residence or facial morphology category. The table is presented as evidence that the dataset adequately reflects real-world diversity, minimizing biases in ASD classification. Assigning every one of 2,526 web-scraped photographs - including all 1,263 non-ASD ones - to one of four ASD-associated facial morphology categories is not a description of a dataset; it is an unsourced annotation layer that cannot be verified and that the study's own conclusions then rest on." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-143" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No study setting. Images were downloaded; computation ran on a Windows 10 desktop with 8 GB RAM and an Intel i3 CPU. That configuration is worth recording because it is not plausible hardware for training a CNN, a shape model and a graph network for 500 epochs on 2,020 images, and no training time is reported." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-143" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Static facial morphology rather than behaviour: inter-landmark geometry and facial asymmetry, operationalised as upper-face breadth, eye spacing, mid-face length and jawline shape, over landmarks at the eye corners, eyebrows, nose tip, mouth corners and jaw outline. The theoretical warrant offered is that discrepancies in facial landmarks between those with ASD and those without indicate underlying variances in brain development." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-143" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Nominally a 3D landmark graph; actually a 2D landmark configuration from Dlib applied to 224x224 web photographs, with rotation and scaling augmentation. The depth channel that the entire introduction argues is essential does not exist in the data. This mismatch propagates into the results: the reported landmark localisation error falling from 2.5 mm at 100 epochs to 0.9 mm at 500 epochs is a physical measurement that no part of the input can support, since the images have neither metric calibration nor ground-truth 3D landmark positions." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-143" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Received 4 October 2024, revised 13 March 2025, accepted 24 August 2025 - the longest review cycle among the recently charted studies, and by far the least effective. Framing is diagnostic-replacement with an explicit efficiency argument: enabling more accurate and automated ASD screening, reducing reliance on subjective assessments, and facilitating timely interventions. Positioning is entirely comparative against numbers quoted from a single prior paper, with the contribution expressed as a higher AUC (0.98 against 0.74, 0.66 and 0.64) rather than as an estimate of anything." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-143" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The stated goal is to overcome the failure of 2D face scans and eye tracking to capture subtle facial asymmetries by performing 3D facial landmark localisation with a CNN plus active shape appearance model, encoding inter-landmark geometry as a Euclidean graph, and classifying with Randomized-Trees-guided XGBoost. Headline findings at 500 epochs: accuracy 0.985, precision 0.975, recall 0.987, F1 0.925, AUC 0.98, detection accuracy 0.99, miss rate and fall-out both 0.07, and landmark localisation error 0.9 mm. The central problem is that the premise and the data do not meet: the entire methodological argument is about depth information that 3D scans obtain and 2D images lack, while the actual input is a Kaggle folder of 2D web photographs processed with Dlib's 2D 68-point detector at 224x224. A localisation error quoted in millimetres cannot be established from such images at all, since they carry no scale reference and no metric ground truth." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-143" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Low. Positives: the source dataset is publicly linked, the split ratio is stated, and the main optimisation settings are listed. Negatives dominate: no code, no seed, no software versions, no architectural specification sufficient to rebuild CNN-ASAM or the GECN, no landmark count, no XGBoost parameters, no identification of which 200 test images produced the headline numbers, and a Table 1 whose annotations have no reconstructible source. Independent replication is impossible in principle, not merely inconvenient." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-143" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A four-stage hybrid: CNN with Active Shape Appearance Model for landmark localisation; a Euclidean graph over the landmarks encoded by graph encoder convolutional networks; Randomized Trees for feature importance; XGBoost for the final binary decision. Each stage is motivated by a stated deficiency of prior work, in the now-standard architecture-stacking rhetoric of this literature, but no ablation isolates any stage's contribution." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-143" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "ASD, autism spectrum disorder, autism spectrum disease, autism spectrum condition, ASD patients, affected persons, neurotypical youngsters, non-ASD. The framing is medical-pathological throughout, opening with autism spectrum disease is a neurological disease and treating the face as a biomarker of brain abnormality under the phrase the face predicts the brain. Autistic people are described as patients diagnosed with ASD who often behave in the same way. There is no engagement with autistic perspectives, and no acknowledgement that the study is inferring a neurodevelopmental condition from the appearance of children's faces." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-143" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "Reported against literature-quoted figures for AdaBoost, MobileNet-V2, VGG-19, decision tree and SVM taken from a single prior paper - AUC 0.74 (SVM), 0.66 (AdaBoost), 0.64 (MobileNet-V2); miss rates " ;
                    slr:study_design "Retrospective secondary analysis of a public Kaggle facial-image dataset; supervised binary image classification with an 80-20 stratified split, 5-fold cross-validation inside the …" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: 1,263 images labelled ASD; comparison: 1,263 images labelled non-ASD" ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "Accuracy 0.985, precision 0.975, recall 0.987, F1 0.925, AUC 0.98, detection accuracy 0.99, miss rate 0.07, fall-out 0.07, landmark localisation error 0.9 mm - all at 500 epochs. At 100 epochs the same model reports accuracy 0.60 and AUC 0.6." ;
                    slr:outcome "Accuracy, precision, recall, F1, loss, AUC, detection accuracy, miss rate, fall-out, landmark localisation error in millimetres, and a confusion matrix. Specificity is named in the abstract as a demonstrated strength but is never reported as a number." ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "Accuracy 0.985, precision 0.975, recall 0.987, F1 0.925, AUC 0.98, detection accuracy 0.99, miss rate 0.07, fall-out 0.07, landmark localisation error 0.9 mm - all at 500 epochs. At 100 epochs the same model reports accuracy 0.60 and AUC 0.6." ] ] ;
