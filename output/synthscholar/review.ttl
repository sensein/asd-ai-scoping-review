    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "Repeated 10-fold cross-validation with principal component reduction and hyperparameter tuning nested inside folds, permutation testing with 5,001 iterations, one feature vector per participant, and analysis scripts deposited on OSF." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Forty percent of the English autistic sample and 15% of the English comparison sample were dropped between recruitment and analysis with no reason given; the English groups differ by 42 percentage points in proportion male and by three years in mean age; IQ was measured with different instruments in the two language groups; and part of the Cantonese sample was recruited through employment programmes for adults with prior diagnoses of unknown provenance." ],
                [ a slr:RoBDomainJudgment ;
