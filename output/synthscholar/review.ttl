    slr:journal "Journal of Autism and Develo" ;
    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "All 30 participants completed the task and were included in the analysis; index and reference assessments were contemporaneous within routine clinical practice; no exclusions or missing data reported." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "DSM-IV-TR clinical diagnosis by a specialist neuropsychiatrist with independent psychologist confirmation is reasonable, but ADOS was administered to only 7 of 15 ASD children, so the gold-standard instrument does not cover the full clinical group." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "The headline 96.7% is the maximum over feature-subset sizes 1-17 evaluated on the same 30 subjects, and the FDR feature ranking is not shown to be recomputed inside each leave-one-out fold; both inflate the accuracy estimate." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Small convenience sample recruited from a single specialist institute over 18 months, with controls drawn from pediatricians and kindergartens; groups differ significantly on chronological age and IQ, so selection is not independent of characteristics that plausibly drive the kinematic differences." ] ;
            slr:overall_judgment "high" ;
            slr:tool_used "QUADAS-2" ] .

<urn:slr:article:fcc0cc14d937> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "SHORT REPORT Semantic Mapping Reveals Distinct Patterns in Descriptions of Social Relations in Adults with Autism Spectrum Disorder Sean X. Luo, Jacqueline A. Shinall, Bradley S. Peterson, and Andrew J. Gerber Adults with autism spectrum disorder (ASD) may describe other individuals differently compared with typical adults. In this study, we ﬁrst asked participants to describe closely related individuals such as parents and close friends with 10 positive and 10 negative characteristics. We then used standard natural language processing methods to digitize and visualize these descriptions. The complex patterns of these descriptive sentences exhibited a difference in seman- tic space between individuals with ASD and control participants. Machine learning algorithms were able to automati- cally detect and discriminate between these two groups. Furthermore, we showed that these descriptive sentences from adults with ASD exhibited fewer connections as deﬁned by word–word co-occurrences in descriptions, and these connections in words formed a less “small-world” like network. Autism Res 2016, 9: 846–853. V C 2015 International Society for Autism Research, Wiley Periodicals, Inc." ;
    dcterms:bibliographicCitation "Luo SX; Shinall JA; Peterson BS; Gerber AJ (2016). Semantic mapping reveals distinct patterns in descriptions of social relations in adults with autism spectrum disorder. *Autism Research, 9(8), 846-8*." ;
    dcterms:creator "Gerber AJ",
        "Luo SX",
        "Peterson BS",
        "Shinall JA" ;
    dcterms:title "Semantic mapping reveals distinct patterns in descriptions of social relations in adults with autism spectrum disorder" ;
    bibo:pmid "local_be8aa62f" ;
    fabio:hasPublicationYear 2016 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are participants and recruitment adequately described?" ;
                            slr:justification "Recruitment routes, inclusion/exclusion criteria and an extensive baseline table (IQ, verbal IQ, AQ, ADOS, SCL-90, WMS, social adjustment) are reported." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are comparison groups matched on the variables that matter?" ;
                            slr:justification "Age and verbal IQ matching is claimed and survives ANOVA, but gender is inverted between groups and unmatched, and the group means for age differ by 7-12 years." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the sample appropriate and adequate for the stated target?" ;
                            slr:justification "n=159 is large for this corpus, but only 27 have ASD, all high-functioning adults with IQ >= 70." ;
                            slr:rating "Partly" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the behavioral data acquisition described reproducibly?" ;
                            slr:justification "The elicitation prompt and valence-rating question are quoted verbatim and the task is trivially repeatable." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the measured construct isolated from trivial confounds?" ;
                            slr:justification "Vocabulary size and every individual word frequency were tested and did not differ between groups, so the effect is not a vocabulary artefact." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the reference standard appropriate and independently applied?" ;
                            slr:justification "DSM-IV diagnosis with ADOS and SCL-90-based exclusion of other diagnoses." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are predictors defined without knowledge of outcome?" ;
                            slr:justification "Text is digitised by an automatic NLP pipeline." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "low" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the validation scheme appropriate?" ;
                            slr:justification "10-fold cross-validation with chance testing, but LSI fold-refitting is unstated and the operating threshold is chosen as optimal." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is class imbalance handled?" ;
                            slr:justification "27 vs 132 with no resampling or class weighting reported." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is overfitting acknowledged and quantified?" ;
                            slr:justification "Fold variance is reported and the SVM's higher AUC is explicitly attributed in part to overfitting." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are confounders controlled in the predictive model?" ;
                            slr:justification "Age, gender, verbal IQ, vocabulary subsection and WMS added as covariates in both the MANOVA and the classifier; the network result re-tested under a GLM with covariates." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is there external or independent validation?" ;
                            slr:justification "None." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "some concerns" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is code or an implementation available?" ;
                            slr:justification "None; key pipeline detail is deferred to Supporting Information." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are performance limits reported without overclaiming?" ;
                            slr:justification "Modest AUCs reported plainly, low sensitivity acknowledged, and the result framed as a rule-out rather than rule-in test." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the dataset accessible or its access conditions stated?" ;
                            slr:justification "No data availability statement; the text data are personally sensitive so restriction would be defensible if stated." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are sample bias and generalisability discussed?" ;
                            slr:justification "Sample size and the shortage of women with ASD are discussed; the inverted gender imbalance between groups and the age gap are not." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are ethics, consent and privacy handling reported?" ;
                            slr:justification "Written informed consent before enrollment and named IRB approval; however verbatim personal descriptions are reproduced in Table 2 without a stated de-identification step." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "some concerns" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Single modality. Positive and negative descriptions are analysed both combined and separately (the network difference loses significance when split, which the authors attribute to reduced power). Demographic and cognitive variables (age, gender, verbal IQ, vocabulary, WMS) are added to the classifier as covariates and do not improve performance - an integration attempt that is reported as null rather than omitted." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-005" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "DSM-IV criteria for Asperger's Disorder, high-functioning autism or PDD-NOS with IQ >= 70, assessed at an academic developmental neuropsychiatry clinic. ADOS was administered (group mean 12.40, SD 3.89) and the SCL-90 was used to exclude other DSM-IV diagnoses. This is one of the better-specified diagnostic pipelines in the corpus." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-005" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional, one session; no time scale or follow-up reported, and the authors state that the clinical importance of the findings will depend on future longitudinal data. The material is highly sensitive - free-text descriptions of participants' own family members and friends, including negative characteristics - and two full description sets are reproduced verbatim in Table 2. Written informed consent was obtained before enrollment and the New York State Psychiatric Institute / Columbia University IRB approved all procedures; no text anonymization or de-identification procedure is described." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-005" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "10-fold cross-validation with random partitioning; performance tested against chance with Bonferroni-corrected t-tests; classifier variance across folds reported and explicitly interpreted as evidence of SVM overfitting. Covariate robustness is tested (age, gender, verbal IQ, vocabulary, WMS added to the model - no improvement) and the network result is re-tested under a generalized linear model with covariates. No external or independent validation, no held-out site, no class-imbalance handling despite a 27:132 split, and no deployment claim beyond a proposal for future real-time clinical visualisation. Whether LSI was refitted inside each fold is not stated." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-005" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Yes, extensively: full-scale, verbal and performance IQ, Wechsler Memory Scale, Autism Quotient, Inventory of Interpersonal Problems, SCL-90 and Social Adjustment Scale reported for all groups. Comorbidity was actively excluded via SCL-90 screening, and the authors use verbal IQ, vocabulary subsection and WMS as covariates to show the semantic effect is not explained by structural language ability." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-005" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "'adults with autism spectrum disorder (ASD)', 'individuals with ASD', 'ASD participants', 'these individuals', 'patient population', 'typical adults', 'typical participants', 'the typical group'. Person-first throughout; notably the comparison group is called 'typical' rather than 'normal' or 'control' in most places, though 'normal participants' appears once in a figure caption." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-005" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Handcrafted symbolic representation: each description is a word-frequency vector over a 1161-word vocabulary, reduced to a low-dimensional LSI projection (six dimensions capture 96% of variance). Word ordering, phrases and higher-order correlations are explicitly omitted. Separately, a word-word co-occurrence graph is built and summarised by its mean local clustering coefficient." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-005" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Clinic/research setting - an academic outpatient developmental neuropsychiatry program plus advertisement and advocacy-group recruitment, with instruments delivered through a computer-based program. Newly collected data; no existing dataset used." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-005" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Reported by the authors: small patient sample, especially few female participants with ASD, with an explicit note that male and female ASD participants may differ in language patterns; the model omits word ordering and phrase-level effects; the prompted format may not capture core language-generation deficits; mechanisms are not disambiguated. Identifiable in review: group sizes are very unequal (27 vs 132) and gender is imbalanced in opposite directions between groups (85% male ASD vs 66% female typical) while gender is not matched - a serious confound for a language-production measure; the ASD group is also on average 7-12 years older; the sample is high-functioning adults (IQ >= 70, mean verbal IQ ~107) so results cannot extend to the wider spectrum; no statement that LSI was refitted within cross-validation folds; and 59% White in the ASD group with no other ethnicity analysis." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-005" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Goal: detection/discrimination of ASD in adults from language production, plus mechanistic characterisation of semantic-network structure. Main findings: LSI-space positions differ significantly between groups (MANOVA p=0.037); classifiers separate groups above chance with AUC 0.67 / 0.71 / 0.82 (linear / quadratic / SVM) but sensitivity only ~0.50-0.52 against specificity ~0.68-0.74; the ASD semantic network is significantly less small-world (C=0.10 vs 0.32, p<0.001) after covariate adjustment; no individual word and no vocabulary-size difference between groups." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-005" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Apply the method to freely generated rather than prompted verbal material; adopt more theory-driven models to improve sensitivity and specificity; incorporate word ordering and phrase-level correlations; recruit more women with ASD; develop analyses that separate structural-language, social-language and compensatory mechanisms so interventions can be tailored; conduct longitudinal studies to establish clinical importance; combine with functional neuroimaging to test neural correlates of semantic similarity; and build real-time clinical visualisation of where a patient's descriptions sit in semantic space." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-005" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "ASD n=27, 4 female / 23 male, age 34.80 (15.90), full-scale IQ 106.30 (16.30), verbal IQ 107.00 (17.00). Typical males n=45, age 27.70 (10.00), verbal IQ 117.00 (12.00); typical females n=87, age 22.80 (6.90), verbal IQ 116.00 (23.00). Matching is claimed on age and verbal IQ and no significant baseline difference was found by one-way ANOVA (except AQ), but the means differ substantially and the group sizes are very unequal (27 vs 132). Gender is markedly mismatched and in opposite directions - the authors acknowledge the ASD group's male preponderance and name the shortage of female ASD participants as a limitation. Adults only; no early-diagnosis relevance." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-005" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Autism Research (INSAR/Wiley), as a Short Report - an autism-specific clinical/research journal, not a computational venue." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-005" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two groups: adults with ASD (n=27, one non-completer) and typical adults (n=132, two non-completers), the latter reported separately as 45 males and 87 females. No other-diagnosis group - indeed other DSM-IV diagnoses were an exclusion criterion." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-005" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "AUC (the primary metric), classification correct rate, sensitivity, specificity, ROC curves, and - unusually - the variance of performance across folds. Headline: AUC 0.82 for SVM (variance 0.12), 0.71 quadratic, 0.67 linear; sensitivity 0.50-0.52 and specificity 0.68-0.74 at the optimal threshold. Chance comparison by two-tailed t-test with Bonferroni correction." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-005" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The 20 words contributing most to the LSI dimensions are visualised as two semantic networks (ASD vs typical), showing different hubs and markedly fewer connections in the ASD network. The interpretable finding is structural rather than lexical: mean local clustering coefficient 0.10 (SD 0.11) for ASD vs 0.32 (SD 0.15) for typical, p<0.001, robust to adjustment for gender, age, verbal IQ and vocabulary. Critically, no individual word frequency and no vocabulary-size difference reached significance, so the discriminative information lies entirely in word co-occurrence structure." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-005" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No data availability statement and no code release; several methodological details (the NLP pipeline, the connectivity normalisation) are deferred to Supporting Information rather than the main text. LSI, the three classifiers and the 10-fold scheme are named but hyperparameters, seeds and the fold-level treatment of LSI are not specified. Not reproducible as reported, although the elicitation protocol itself is trivially repeatable." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-005" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2016. The paper positions data mining of language production for psychopathology as previously proposed but never demonstrated quantitatively across diagnostic groups, presenting itself as a first step - an early marker of the linguistic-content strand that grows later in this corpus (social media text, picture-book narratives, conversation transcripts)." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-005" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No sensing hardware - data are typed/recorded sentences collected through a computer-based self-report program (platform unspecified). Software: standard NLP tokenisation, latent semantic indexing, and MATLAB with statistics and bioinformatics toolboxes for classification, ROC/AUC and network analysis." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-005" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Supervised learning with unsupervised dimensionality reduction. Algorithms: linear discriminant, quadratic discriminant and RBF-kernel SVM; latent semantic indexing (an SVD-based technique related to PCA) provides the representation. Graph-theoretic network analysis (local clustering coefficient) is used descriptively alongside the classifiers." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-005" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A single structured elicitation prompt: describe four personally important individuals using 10 positive and 10 negative sentences each, then rate the strength of each description from 0 to 10. The authors explicitly note this prompted format is a design choice - it standardises the assay but does not probe free language generation." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-005" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Language: lexical/semantic content of elicited descriptive sentences about social relations. No acoustic, prosodic, gaze or motor data - this is one of the few purely linguistic-content studies in the corpus." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-005" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Author keywords: machine learning; semantic web; autism spectrum disorder; latent semantic indexing; classification; small-world network. Task vocabulary: 'automatically detect and discriminate between these two groups', 'quantifying language production', 'computer-assisted strategy', 'screen out an ASD diagnosis'. The 'semantic web' and 'small-world network' vocabulary is distinctive within this corpus." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-005" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "Single session, simple one-session format; each participant described four important individuals with 10 positive and 10 negative sentences each" ;
                    slr:study_design "Cross-sectional case-control classification study (short report)" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder (Asperger's disorder, high-functioning autism, PDD-NOS)" ;
                    slr:sample_size_text "ASD/index: 27 enrolled (one did not complete); comparison: 132 enrolled (two did not complete); 45 typical adult males and 87 typical adult females" ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "AUC 0.67 (linear), 0.71 (quadratic), 0.82 (SVM, variance 0.12). At the optimal threshold, specificity 0.68 / 0.72 / 0.74 and sensitivity 0.50 / 0.52 / 0.52 for linear / quadratic / SVM. Adding age, gender, verbal IQ, vocabulary and working memory to the model did not improve classification. Group difference in LSI space significant by MANOVA (p=0.037)",
                        "Descriptions of social relations produced by adults with ASD occupy a distinguishable region of latent semantic space, and machine-learning classifiers detect the difference above chance - but with low sensitivity (~0.5) and moderate specificity (~0.7), which the authors read as a rule-out rather than rule-in test. Independently, the semantic co-occurrence network of the ASD group is significantly" ;
                    slr:outcome "AUC (cross-validated), classification correct rate, sensitivity, specificity, ROC curves, and variance of performance across folds" ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "AUC 0.67 (linear), 0.71 (quadratic), 0.82 (SVM, variance 0.12). At the optimal threshold, specificity 0.68 / 0.72 / 0.74 and sensitivity 0.50 / 0.52 / 0.52 for linear / quadratic / SVM. Adding age, gender, verbal IQ, vocabulary and working memory to the model did not improve classification. Group difference in LSI space significant by MANOVA (p=0.037); Descriptions of social relations produced by adults with ASD occupy a distinguishable region of latent semantic space, and machine-learning classifiers detect the difference above chance - but with low sensitivity (~0.5) and moderate specificity (~0.7), which the authors read as a rule-out rather than rule-in test. Independently, the semantic co-occurrence network of the ASD group is significantly" ] ] ;
