            slr:content_hash "e5f2a8f2ffb29048c9af29d13b11220a0f9f0ddb720b171961f8cc6b8ab1e97e" ;
            slr:content_size_bytes 43533 ;
            slr:content_withheld "Extracted publisher text removed for redistribution; content_hash retained." ;
            slr:created_at_time "2026-08-14T05:29:21.331515+00:00"^^xsd:dateTime ;
            slr:full_text_source "user_supplied_pdf" ;
            slr:media_type "text/plain" ] ;
    slr:journal "Joint Proceedings of the ACM IUI 20" ;
    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "The index test is essentially prespecified. A linear SVM at default regularisation was applied to a fixed 6,272-feature representation with no feature selection, and exactly one hyperparameter - the cross-correlation window, over four candidate values - was optimised, inside a nested cross-validation loop. Classification is automated and blind to the reference standard. The representation itself was designed a priori on stated principles (identity removal, localised bases, exclusion of nose and cheek regions and of Facial Action Coding System units on dimensionality grounds), and those choices are argued in the text rather than justified by their effect on accuracy. Researcher degrees of freedom are unusually low for this literature." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Case-control sampling at a specialist research centre, with 15 autistic adults and 27 neurotypical controls recruited specifically as controls and characterised to raters as 'clear cases of individuals without autism'. Selecting the well-separated ends of the distribution is appropriate for a human-benchmark study but is the classic QUADAS-2 high-risk configuration for accuracy estimation, and the authors identify it themselves as their key external-validity limit. Mitigating factors that do not lift the judgement: groups were matched on age, sex ratio, full-scale IQ and verbal IQ; enrolment and the two exclusions are fully reported; and the eligibility requirement of native English fluency is stated. All participants are adults able to sustain a 3-minute unstructured conversation with a stranger." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "Diagnostic status was confirmed prospectively as part of this study using the Clinical Best Estimate process informed by ADOS-2 Module 4 and DSM-5 criteria - the accepted research gold standard, integrating a standardised observational instrument with clinical judgement. Control status was established by deliberate recruitment as neurotypical rather than by mere absence of a diagnosis. The reference standard was determined independently of the index test, and the conversation confederates who generated the index-test material were blind to diagnostic status. The only deductions, insufficient to change the judgement, are that no ADOS-2 severity score is reported and that no inter-rater reliability figure is given for the Clinical Best Estimate consensus." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "All 44 enrolled participants underwent both the reference standard and the CASS; 2 were excluded for absent consent to this specific analysis or unprocessable data, both reasons stated, leaving 42 all of whom appear in the analysis. Each participant contributes exactly one feature vector, so there is no clustering or serial dependence in the evaluation units, and the nested cross-validation partitions participants. The reference standard and the index-test recording occurred within the same study visit battery. The one unaddressed flow point is that the bored condition of the CASS was collected and not analysed, which is a scope decision rather than a selective-reporting problem since it is stated plainly." ] ;
            slr:overall_judgment "unclear" ;
            slr:tool_used "QUADAS-2" ] .

