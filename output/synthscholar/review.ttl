    slr:journal "Intelligent Decision Technologies, 18(1)" ;
    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "None described. The label is a binary 'Detected' or 'Not detected' for a merged autism-and-visual-SPD construct, with no instrument, criterion, clinician or procedure. The dataset section's reference to a 'new dataset named AQ10 ... developed based on autism screening' conflates a dataset with an existing screening questionnaire whose items appear nowhere in the reported variables." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Two mutually inconsistent validation descriptions are given - a variable learning-percentage split illustrated at 65/35, and 5-fold cross-validation - neither tied to the reported results. No unit of splitting is stated and none is recoverable, since the number of contributing individuals is never given. Metrics are reported to five decimal places with no denominator." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "No sample size, no group sizes, no demographics, no recruitment route, no eligibility criteria and no setting are reported anywhere. Data are described only as 'collected manually' from 'various subjects'. Selection cannot be assessed because nothing about it is stated." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Feature selection optimises a fitness function using inter- and intra-class similarity, and therefore class labels, with no statement of nesting within training partitions. The selected feature subset - the explicit output of the paper's central method - is never disclosed. Five model variants and four conventional classifiers were compared with the proposed method reported as best, and no operating point is prespecified." ] ;
            slr:overall_judgment "high" ;
            slr:tool_used "QUADAS-2" ] .

<urn:slr:article:10ab04b596b1> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Signs of autism spectrum disorder (ASD) emerge in the ﬁrst year of life in many children, but diagnosis is typically made much later, at an average age of 4 years in the United States. Early intervention is highly effective for young children with ASD, but is typically reserved for children with a formal diagnosis, making accurate identiﬁcation as early as possible imperative. A screening tool that could identify ASD risk during infancy offers the opportunity for intervention before the full set of symptoms is present. In this paper, we propose two machine learning methods, synthetic saccade approach and image based approach, to automatically classify ASD given the scanpath data from children on free viewing of natural images. The ﬁrst approach uses a generative model of synthetic saccade patterns to represent the baseline scanpath from a typical non-ASD individual and combines it with the input scanpath as well as other auxiliary data as inputs to a deep learning classiﬁer. The second approach adopts a more holistic image based approach by feeding the input image and a sequence of ﬁxation maps into a state-of-the-art convolutional neural network. Our experiments indicate that we can get 65.41% accuracy on the validation dataset." ;
    dcterms:bibliographicCitation "Wu C; Liaqat S; Cheung SC; Chuah CN; Ozonoff S (2019). Predicting Autism Diagnosis using Image with Fixations and Synthetic Saccade Patterns. *2019 IEEE International Conference on Multimedia & Expo*." ;
    dcterms:creator "Cheung SC",
        "Chuah CN",
        "Liaqat S",
        "Ozonoff S",
        "Wu C" ;
    dcterms:title "Predicting Autism Diagnosis using Image with Fixations and Synthetic Saccade Patterns" ;
    bibo:pmid "local_309e5baa" ;
    fabio:hasPublicationYear 2019 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are participants and recruitment adequately described?" ;
                            slr:justification "Per-image viewer counts only; no distinct participant totals, no control ages, no genders, no recruitment information." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the sample appropriate and adequate for the stated target?" ;
                            slr:justification "The stated aim is screening infants and toddlers, but the sample is children aged 5-12." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are comparison groups matched?" ;
                            slr:justification "No matching information; control demographics entirely absent." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the reference baseline independent of the clinical labels?" ;
                            slr:justification "STAR-FC is trained on general-population viewing and generates the synthetic typical scanpath without reference to any participant labels." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are predictors defined without knowledge of outcome?" ;
                            slr:justification "All features are computed automatically from scanpaths, images and a stimulus-driven saliency model." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the reference standard appropriate and independently applied?" ;
                            slr:justification "No diagnostic information of any kind." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the behavioral data acquisition described reproducibly?" ;
                            slr:justification "Eye tracker model, monitor size and 3-second viewing duration are given from the source dataset; no calibration, distance, room or session details." ;
                            slr:rating "Partly" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the internal split participant-independent?" ;
                            slr:justification "Partitioned by image, so the same children's scanpaths appear in both internal training and validation." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is a genuinely blind held-out evaluation performed?" ;
                            slr:justification "The organiser's 100-image test set had labels withheld from the authors." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the internal-versus-blind performance gap reported?" ;
                            slr:justification "Both result tables are published in full, showing 6-11 point accuracy drops and specificity collapsing from around 0.65 to 0.28-0.47." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are model configurations reported in full?" ;
                            slr:justification "Layer counts, neuron counts, activations, dropout, optimiser, learning rates, batch sizes, epochs and trainable parameter counts given for all three models." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is class imbalance addressed?" ;
                            slr:justification "Specificity collapses to 0.282-0.471 on the blind test with no rebalancing or threshold adjustment reported." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "some concerns" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are limitations discussed?" ;
                            slr:justification "One sentence attributing the performance gap to distributional imbalance and insufficient training images; no limitations section." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the dataset accessible or its access conditions stated?" ;
                            slr:justification "A public Grand Challenge benchmark is used and cited, though no access route is given." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is code available?" ;
                            slr:justification "None, though architectures and hyperparameters are fully specified." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are prior headline results treated critically?" ;
                            slr:justification "The cited 92% adult result is explicitly qualified as possibly not applicable to children's gaze patterns." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are ethics and data provenance reported?" ;
                            slr:justification "No ethics, consent or provenance statement for the secondary data." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is blind-test performance reported honestly?" ;
                            slr:justification "The substantially worse blind-test results are published alongside validation results rather than omitted." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "some concerns" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The paper's chief contribution to this review. Evaluation is performed twice: on an internal split partitioned by image (240 train, 60 test) and on an organiser-held blind test set of 100 images. The consistent 6-11 point accuracy drop and 0.09-0.14 AUC drop between the two regimes constitutes a direct measurement of internal-validation optimism on the same models and data. Overfitting is otherwise controlled by an extensive augmentation regime, dropout, L2 regularisation and batch normalisation, and the frozen pretrained image branch limits capacity. Absent: participant-level partitioning at any stage, cross-validation, permutation testing, class-imbalance handling despite the collapsing specificity, and any calibration or deployment analysis." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-029" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None proposed. The paper closes by noting the validation-to-test performance gap and its possible causes without setting out future work, consistent with its four-page challenge-entry format." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-029" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. No feature importance, saliency analysis or ablation beyond the small-versus-full model comparison, and no behavioral property is identified as characteristic of autistic gaze. The finding that the 7-feature model outperforms the 47-feature model on validation and nearly matches the 11.3-million-parameter CNN on the blind test is interpretable evidence that the aggregate statistics and deviation-from-typical distances carry most of the usable signal, but this is not developed." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-029" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Setting not reported - entirely secondary analysis of the Saliency4ASD benchmark. The source dataset used a Tobii T120 eye tracker with a 17-inch monitor, but no room, distance, calibration or session details are given." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-029" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two contrasting representations tested side by side. First, handcrafted: aligned coordinate pairs plus duration statistics plus three trajectory distances, in 7- and 47-dimensional variants. Second, learned: each fixation rendered as a sparse image channel carrying its duration at its location, Gaussian-smoothed to counter sparsity, with 33 channels stacked in temporal order - an unusual encoding that preserves both fixation order (by channel index) and duration (by value) while letting a convolutional network read spatial position directly rather than from coordinates." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-029" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "'children with ASD', 'individuals with ASD', 'people on the autism spectrum', 'ASD subjects', 'typically developed (TD) viewers', 'neurotypical individuals', 'children who develop typically'. Mixed but generally neutral, with 'neurotypical' and 'typically developed' used rather than 'normal' or 'healthy'." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-029" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Index terms: Autism Spectrum Disorders, Visual Saliency, Deep Learning. Task vocabulary: 'screening tool', 'ASD risk during infancy', 'atypical visual attention', 'synthetic saccade', 'holistic automated diagnosis tool'. The early-intervention framing is prominent - 'squandering years of potential intervention when the brain is most plastic'." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-029" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional; 3 seconds of viewing per image with no temporal or longitudinal component. The data are fixation coordinates over public stimulus images, so re-identification risk is minimal. No ethics approval, consent or data-provenance statement appears - understandable for secondary use of a released challenge dataset, but not acknowledged as such." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-029" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None reported. No cognitive, linguistic, adaptive or severity measures, and no comorbidity information - consistent with the absence of participant metadata in the challenge dataset as used here." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-029" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Free viewing of 300 natural images, each shown at original full resolution for 3 seconds. The paper adds a computational task of its own: generating a synthetic 'typical viewer' scanpath for every image using STAR-FC, a multi-saccade generator that fixates centrally, applies a retinal transform with anisotropic blurring, combines peripheral low-level and central high-level conspicuity streams into a priority map with inhibition of return, and iterates." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-029" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Gaze: fixation coordinates and durations during free viewing of natural scenes. The distinguishing conceptual move is that gaze is not analysed in isolation but relative to a computationally simulated typical scanpath, so the measured quantity is deviation from a modelled norm rather than an absolute gaze property." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-029" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2019. The paper documents the state of gaze-based autism classification concisely: atypical visual attention 'sometimes emerged even before the onset of the disorder', with delayed attentional disengagement in infants correlating with later toddlerhood diagnosis, but 'a holistic automated diagnosis tool remain elusive'. It cites the 92% accuracy reported for deep-network gaze classification in 20 high-functioning ASD and 19 typically developed adults and immediately qualifies that this 'may not be directly applicable to gaze patterns from children' - one of the few instances in the corpus of a paper explicitly discounting a headline result it builds upon. The existence of the Saliency4ASD challenge itself evidences the field's move toward shared benchmarks with blind evaluation around 2019." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-029" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Goal: an easy-to-use ASD screening tool for infants and toddlers, motivated by the gap between early symptom emergence and a mean US diagnosis age above 4 with fewer than 25% diagnosed before age 3. Main findings: internal validation accuracies of 61.62-65.41% with AUC 0.63-0.69, falling on the organiser's blind test set to 53.88-55.13% with AUC 0.545-0.553 and specificity as low as 0.282. The 492-parameter model performed best on validation and was matched by the 11.3-million-parameter CNN on the blind test." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-029" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No acquisition hardware used by these authors; the source data came from a Tobii T120 eye tracker with a 17-inch monitor. Analysis: STAR-FC for synthetic scanpath generation; dynamic time warping for alignment; ResNet-18 pretrained backbones; PyTorch on a Titan XP GPU. Notably the hyperparameters are reported in full for all three models - layer counts, neuron counts, activations, dropout, optimiser, learning rate, batch size, epochs and trainable parameter counts - which is better than corpus norm." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-029" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Mixed but above average for a workshop paper. The source dataset is a public benchmark with an organiser-defined blind test set, so results are comparable against other entrants. All three model architectures are specified in reproducible detail including trainable parameter counts, and the augmentation regime is fully described (colour jitter, up to 20-pixel location jitter, duration scaling in [0.75, 1.25], random Gaussian sigma in [0.1, 2], horizontal flips, with affine transforms deliberately excluded to avoid pushing fixations out of frame). What is missing: no code release, no random seeds, no participant counts, no STAR-FC configuration details, and no statement of how the 240/60 image split was drawn." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-029" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Sparse. 14 ASD and 14 TD children viewed each of 300 images, but the number of distinct children is not reported. Age is given only for the ASD group: 5 to 12 years, mean 8. No control age data, no gender data for either group, no matching procedure and no comparability testing. Given that gaze behaviour changes substantially between ages 5 and 12, and that no control ages are reported at all, demographic confounding cannot be assessed." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-029" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Not reported. Class labels are inherited from the Saliency4ASD challenge dataset with no description of diagnostic instrument, criteria or procedure for either group." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-029" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two forms of fusion. In the synthetic saccade approach, real and synthetic scanpaths are aligned by dynamic time warping and concatenated along with aggregate duration statistics and three trajectory distance measures - fusing observed behaviour with a model-generated reference. In the image-based approach, a two-branch architecture separately encodes the stimulus image (frozen pretrained ResNet-18) and the fixation channels (ResNet-18 with a 33-channel input layer), concatenating their 512-dimensional outputs into a 1024-dimensional vector - fusing stimulus content with gaze behaviour. Both are stimulus-plus-behaviour fusions rather than multi-behavioural fusions." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-029" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two groups by dataset label - ASD and typically developing - with 14 of each viewing every image. The total number of distinct participants is never stated, only the per-image viewer counts, so the actual sample size is unrecoverable from this paper. No other-diagnosis group." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-029" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Reported by the authors only briefly: 'The performance gap may be caused by the imbalanced distribution of training and test dataset and lacking of training images'. They also note, when citing the prior 92% adult result, that it 'may not be directly applicable to gaze patterns from children' - a caution about transfer that few corpus papers offer about their own antecedents. Identifiable in review: the internal split is partitioned by image, not by participant, so the same child's scanpaths appear in both internal training and validation, which is the most likely reason internal accuracy exceeds blind test accuracy by 6-11 points; the number of distinct participants is never stated; no control ages, no genders, no diagnostic information; specificity on the blind test collapses to 0.282-0.471, meaning the models achieve their apparent sensitivity largely by over-calling ASD; and the unit of analysis is the scanpath rather than the person, so no person-level estimate exists." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-029" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Accuracy, sensitivity, specificity and AUC for all three models on both the internal validation split and the organiser's blind test set. Reporting the full metric set twice, on two evaluation regimes, is what makes this paper informative: the sensitivity-specificity asymmetry on the blind test (0.807 sensitivity against 0.282 specificity for the full synthetic saccade model) shows the models are largely defaulting to the ASD label, which a single accuracy figure would conceal." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-029" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "IEEE International Conference on Multimedia and Expo Workshops (ICMEW) 2019, as an entry to the Saliency4ASD Grand Challenge - a multimedia and computer-vision venue, not an autism or clinical venue." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-029" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Supervised deep learning throughout. Fully connected networks of two capacities for the synthetic saccade approach, and a dual-branch convolutional architecture built on pretrained ResNet-18 for the image-based approach. STAR-FC, a computational saliency and saccade generation model, is used upstream as a reference generator rather than as a classifier. No conventional machine-learning comparators are included." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-029" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "Each child viewed each image at original full resolution for 3 seconds" ;
                    slr:study_design "Cross-sectional classification study on a shared benchmark with an organiser-provided held-out test set; entry to the Saliency4ASD Grand Challenge" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: 14 children with ASD viewed each image (the total number of distinct ASD participants is not stated); comparison: 14 children viewed each image; total distinct participants not stated" ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "Internal validation: synthetic saccade (small) 65.41% accuracy, 0.66 sensitivity, 0.65 specificity, 0.69 AUC; synthetic saccade (full) 63%, 0.69, 0.66, 0.66; image-based 61.62%, 0.60, 0.64, 0.63. Organiser's blind test set: synthetic saccade (small) 54.15%, 0.741 sensitivity, 0.351 specificity, 0.546 AUC; synthetic saccade (full) 53.88%, 0.807, 0.282, 0.545; image-based 55.13%, 0.635, 0.471, 0.553",
                        "Two deep-learning approaches to classifying ASD from free-viewing scanpaths - one comparing each real scanpath against a computationally generated 'typical' baseline, one rendering fixations as image channels for a two-branch CNN - reached 61-65% accuracy on an internal image-partitioned split but only 54-55% on the organiser's blind test set, with AUC falling to 0.545-0.553 and specificity collap" ;
                    slr:outcome "Accuracy, sensitivity, specificity and AUC, reported for all three model variants on both the internal validation split and the organiser's blind test set" ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "Internal validation: synthetic saccade (small) 65.41% accuracy, 0.66 sensitivity, 0.65 specificity, 0.69 AUC; synthetic saccade (full) 63%, 0.69, 0.66, 0.66; image-based 61.62%, 0.60, 0.64, 0.63. Organiser's blind test set: synthetic saccade (small) 54.15%, 0.741 sensitivity, 0.351 specificity, 0.546 AUC; synthetic saccade (full) 53.88%, 0.807, 0.282, 0.545; image-based 55.13%, 0.635, 0.471, 0.553; Two deep-learning approaches to classifying ASD from free-viewing scanpaths - one comparing each real scanpath against a computationally generated 'typical' baseline, one rendering fixations as image channels for a two-branch CNN - reached 61-65% accuracy on an internal image-partitioned split but only 54-55% on the organiser's blind test set, with AUC falling to 0.545-0.553 and specificity collap" ] ] ;
