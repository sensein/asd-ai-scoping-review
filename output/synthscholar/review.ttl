    slr:journal "Scientific Reports, 15(1), Article 34134" ;
    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Two small public corpora (48 and 38 children) with markedly unequal group ages in the Nadig corpus - typically developing children averaging 29-34 months against ASD children averaging 53-61 months - and a more male-weighted ASD group; neither is adjusted for, and age is included as a predictor." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "Diagnoses inherited from two peer-reviewed developmental-language studies with their own procedures, accessed through a curated academic repository whose contribution rules require consent and ethical approval." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "Child-level 5-fold stratified cross-validation with a quantified train-validation overfitting check and KS-validated SMOTE confined to the one imbalanced corpus - but SMOTE's placement relative to the folds is unstated, no confidence intervals or fold variance are reported, and the majority-class baselines (68.4% for Nadig) are not given." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "Fifty-two interpretable linguistic and demographic features with grid-searched hyperparameters reported and a shallow random forest appropriate to the sample size, and importance coefficients averaged across folds rather than taken from a single fit. But age is in the feature set and is confounded with group." ] ;
            slr:overall_judgment "high" ;
            slr:tool_used "QUADAS-2" ] .

<urn:slr:article:90465004ce07> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Existing research has shown that human eye-movement data conveys rich information about underlying mental processes, and that the latter may be inferred from the former. However, most related studies rely on spatial information about which diﬀerent areas of visual stimuli were looked at, without considering the order in which this occurred. Although powerful algorithms for making pairwise comparisons between eye-movement sequences (scanpaths) exist, the problem is how to compare two groups of scanpaths, e.g., those registered with vs. without an experimental manipulation in place, rather than individual scanpaths. Here, we propose that the problem might be solved by projecting a scanpath similarity matrix, obtained via a pairwise comparison algorithm, to a lower-dimensional space (the comparison and dimensionality-reduction techniques we use are ScanMatch and t-SNE). The resulting distributions of low-dimensional vectors representing individual scanpaths can be statistically compared. To assess if the diﬀerences result from temporal scanpath features, we propose to statistically compare the cross-validated accuracies of two classiﬁers predicting group membership: (1) based exclusively on spatial metrics; (2) based additionally on the obtained scanpath representation vectors. To illustrate, we compare autistic vs. typically-developing individuals looking at human faces during a lab experiment and ﬁnd signiﬁcant diﬀerences in temporal scanpath features." ;
    dcterms:bibliographicCitation "Król M; Król ME (2019). A Novel Eye Movement Data Transformation Technique that Preserves Temporal Information: A Demonstration in a Face Processing Task. *Sensors, 19(10), Article 2377*." ;
    dcterms:creator "Król M",
        "Król ME" ;
    dcterms:title "A Novel Eye Movement Data Transformation Technique that Preserves Temporal Information: A Demonstration in a Face Processing Task" ;
    bibo:pmid "local_88ddfdd1" ;
    fabio:hasPublicationYear 2019 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are participants and recruitment adequately described?" ;
                            slr:justification "Group sizes, sexes, age ranges and means, IQ means and the IQ inclusion threshold all reported." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the sample appropriate and adequate for the stated target?" ;
                            slr:justification "44 participants suffices for a methods demonstration; IQ above 85 restricts the sample and both groups are heavily male." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are comparison groups matched on the variables that matter?" ;
                            slr:justification "Age- and IQ-matched with near-identical means, though no formal tests and a wider ASD age range." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "some concerns" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the reference standard appropriate and independently applied?" ;
                            slr:justification "ICD-10 clinical diagnosis independently re-confirmed with ADOS-2 by the research team." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are predictors defined without knowledge of outcome?" ;
                            slr:justification "AOIs are defined by an automatic landmark detector and all downstream processing is algorithmic." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are stimulus confounds controlled?" ;
                            slr:justification "Each face shown once per subject with one randomly chosen expression to avoid familiarity and face-emotion interactions; stimuli balanced by sex and age band; full-head images with landmark tracking rather than cropped standardised faces." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the behavioral data acquisition described reproducibly?" ;
                            slr:justification "Eye tracker, sampling rate, accuracy, chinrest, viewing distance, calibration and validation, quality monitoring, fixation detection thresholds and full trial timing all specified." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "low" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is there external or independent validation?" ;
                            slr:justification "None; single cohort." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the key claim isolated by a matched control condition?" ;
                            slr:justification "A spatial-only representation produced by randomly permuting scanpath characters through the identical pipeline isolates the contribution of temporal ordering." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the result checked against alternative methods?" ;
                            slr:justification "A Levenshtein plus non-metric MDS benchmark is run and reported as showing no significant temporal contribution." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is performance tested against chance?" ;
                            slr:justification "Permutation testing with 1000 permutations for both models, given accuracies near 50%." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the validation subject-independent?" ;
                            slr:justification "Explicitly stated that each subject's data entered only one fold, with both groups evenly split." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "low" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is code available?" ;
                            slr:justification "Released with the data." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is data reuse disclosed?" ;
                            slr:justification "Reuse of Experiment 1 data in a companion paper is disclosed with the reason given." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the low absolute accuracy foregrounded?" ;
                            slr:justification "53.9% and 55.5% are reported plainly but their diagnostic negligibility is not discussed." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the dataset accessible or its access conditions stated?" ;
                            slr:justification "Data and code released as supplementary information." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are ethics, consent and assent reported?" ;
                            slr:justification "Named ethics committee, written consent from adults or guardians, plus oral consent from underage subjects themselves." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are claims proportionate to the evidence?" ;
                            slr:justification "The paper claims a temporal difference exists, not that autism can be detected; no diagnostic performance claim is made." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "low" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The strongest reproducibility profile in the corpus alongside Yaneva et al. Data and code are both released as supplementary information. The method is documented exhaustively: eye tracker specifications, calibration and validation procedure, fixation detection thresholds, the 68+8 AOI construction and why the extra 8 frame points were added, the 50 ms character-repetition encoding, the substitution matrix construction with its distance and group logic and its [-1,+1] rescaling, the length normalisation rationale, the t-SNE implementation used, the LightGBM hyperparameters, the class priors, and the subject-level fold constraint. The authors also report that manipulating t-SNE settings and LightGBM defaults produced no qualitative change - an informal robustness check." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-017" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Sensors (MDPI) - an instrumentation and sensing journal, neither autism-specific nor clinical, consistent with the paper's methodological framing." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-017" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Goal: primarily methodological - to enable statistical comparison of two groups of scanpaths on temporal features, with autism as the demonstration domain. Main findings: t-SNE embeddings of ASD and TD scanpaths differed highly significantly for both eyes (Cramer test p < 0.001); adding the temporal representation to a spatial-only feature set raised classification accuracy from 53.9% to 55.5% (p = 0.032), establishing a genuine temporal difference beyond the known spatial one; both models were above chance by permutation test; and a benchmark using Levenshtein distance with non-metric MDS found no significant temporal contribution, indicating the effect depends on the specific ScanMatch/t-SNE combination." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-017" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Among the strongest in the corpus: all ASD participants had prior clinical diagnoses under WHO ICD-10 criteria, and all diagnoses were additionally confirmed by the research team using ADOS-2, described accurately as 'a standardized, validated instrument for the assessment of autism spectrum conditions'. Control status was established by absence of any history of autism spectrum or other neurodevelopmental disorders. Independent re-confirmation with a gold-standard instrument, rather than reliance on prior diagnosis alone, is uncommon here." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-017" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Laboratory setting with a chinrest, fixed viewing distance and periodic data-quality monitoring. The data were collected by the authors across two experiments, with Experiment 1 data also used in a separate publication on information extraction - disclosed transparently on the grounds that 'recruiting ASD subjects and validating their diagnoses is extremely costly'." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-017" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "ASD n=21 (2 female, 10%), mean age 16.27, range 11-29, mean full-scale IQ 109.4. TD n=23 (5 female, 22%), mean age 16.31, range 10-21, mean full-scale IQ 112.3. Groups are described as age- and IQ-matched and the means are indeed near-identical, though the ASD age range extends to 29 while no control exceeded 21, and no standard deviations or formal comparison tests are reported. All participants had full-scale IQ above 85, so the sample is restricted to average-or-above intellectual ability. Both groups are heavily male. Adolescents and adults, so no early-diagnosis relevance." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-017" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No autism-specific future work is proposed. The methodological conclusion is that the technique 'could be used in other problems in which one needs to compare two sets of eye movement sequences in terms of their temporal features', positioning the contribution as a general tool for eye-movement research rather than an autism screening development." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-017" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Supervised learning with unsupervised embedding: gradient boosted decision trees (LightGBM) over t-SNE embeddings of a ScanMatch similarity matrix. The Needleman-Wunsch sequence alignment underlying ScanMatch is a classical bioinformatics algorithm repurposed for gaze. A benchmark condition substitutes Levenshtein distance and Kruskal's non-metric multidimensional scaling for the ScanMatch/t-SNE pair." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-017" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Gaze: binocular fixation sequences with duration and order, encoded relative to automatically detected facial landmarks. The distinguishing feature is that temporal ordering is preserved and made the object of analysis, whereas the corpus's other gaze studies aggregate into dwell times or fixation counts that discard sequence." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-017" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A distinctive three-stage representation: fixation sequences are first converted to character strings where each AOI symbol is repeated proportionally to fixation duration (one character per 50 ms), so that duration is encoded in string length; pairwise ScanMatch alignment then produces a similarity matrix incorporating spatial proximity and anatomical group membership through a purpose-built substitution matrix; and t-SNE finally embeds each scanpath as a point in two dimensions. This converts an inherently pairwise, non-vector representation into per-item coordinates that can be tested statistically - which is exactly the barrier the paper sets out to solve." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-017" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Classification accuracy averaged over folds and iterations, with a paired t-test between the two models, confusion matrices for both, and permutation-based verification against chance. Group-level distributional differences are tested separately with the non-parametric Cramer test with reported statistics, critical values and p-values for each eye. The reporting is statistically thorough, though absolute accuracy is the only classification metric and no sensitivity, specificity or AUC is given." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-017" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The paper has no dedicated limitations section, since it is framed as a methods demonstration. It does report transparently that Experiment 1 data were reused from a companion paper and why. Identifiable in review: the absolute accuracies of 53.9% and 55.5% are barely above chance and correspond to a 1.6 percentage point improvement, so while the temporal claim is statistically supported the practical discriminability is negligible - a fact the paper does not emphasise; the unit of analysis is a single two-second trial rather than a person, so no participant-level diagnostic estimate exists; the ASD age range extends to 29 against a control maximum of 21 despite matched means; both groups are heavily male on very small female counts; all participants have IQ above 85, so the sample excludes much of the spectrum; and trials with no AOI transitions in either eye were excluded, which may remove disproportionately many ASD trials given the noted tendency toward stray fixations." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-017" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Five face-perception tasks spanning emotion recognition, a non-social perceptual judgement (brow versus lip width), free viewing, age estimation and a social evaluation ('nice' or not), across 60 trials per subject. Stimuli were 60 FACES database photographs balanced by sex and across three age bands, each shown once per subject with one randomly chosen expression from six to avoid familiarity effects and face-emotion confounds. Notably the study deliberately used images of the entire head with varying facial-feature locations, criticising the field's usual practice of using cropped images with standardised feature positions as 'somewhat unrealistic' - and solved the resulting AOI problem with automatic landmark detection." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-017" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional; two experiments in a laboratory session series with no follow-up. The data are gaze coordinates over third-party stimulus faces, so re-identification risk is minimal and the public release is correspondingly low-risk. Consent handling is exemplary: ethics approval from the named Faculty Research Ethics Committee, written consent from adult subjects or from guardians of underage subjects, and additionally oral consent obtained from the underage subjects themselves - a two-tier assent procedure that only one other study in this corpus matches." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-017" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two groups: 21 individuals with ASD and 23 age- and IQ-matched typically developing controls, total 44. Group sizes, sexes and IQ means are all reported. No other-diagnosis comparison group." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-017" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Among the best in the corpus. Subject-level partitioning is explicit and enforced, with both groups evenly split across folds and class priors set to 0.5. The 5-by-2 repeated cross-validation design is a recognised procedure for comparing classifiers. Both models are permutation-tested against chance (p < 0.001, k = 1000), which matters given accuracies near 50%. A benchmark using alternative standard techniques is run and reported as null, guarding against the conclusion being an artefact of the general pipeline. Sensitivity to algorithm settings is informally checked for both t-SNE and LightGBM. Absent: external validation on an independent sample, and any participant-level aggregation that would yield a diagnostic estimate." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-017" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Intelligence measured with the Wechsler Scales for all participants, with group means reported (109.4 and 112.3) and a minimum threshold of 85 applied as an inclusion criterion - so IQ is both measured and controlled by restriction and matching. Vision was normal or corrected-to-normal and neurological conditions excluded for all subjects. No language or adaptive measures, and ADOS-2 severity scores are not reported despite the instrument being administered." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-017" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No feature-level interpretation is offered, and this is a deliberate choice: the paper establishes that temporal ordering carries group-discriminative information without claiming to characterise what the ordering difference is. The illustrative hypothesis it uses to motivate the design - that TD subjects might look at the eyes before the mouth while ASD subjects do the reverse - is offered as a possibility to be tested, not a finding. The permuted-character control is the interpretive mechanism: because it destroys order while preserving AOI frequencies, any accuracy gain over it must come from sequence." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-017" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2019. The paper's field characterisation is methodological rather than clinical: it observes that 'most related studies rely on spatial information about which different areas of visual stimuli were looked at, without considering the order in which this occurred', and that 'even state-of-the-art analyses of this type are typically based on spatial but not temporal eye movement information'. It also criticises the prevailing stimulus convention - that existing studies 'typically use facial images with cropped peripheral regions... and such that the locations of the key facial regions are the same across images', which 'facilitates the analysis but can be seen as somewhat unrealistic'. Both observations identify structural simplifications in the gaze literature that this corpus otherwise leaves unexamined." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-017" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "'subjects with ASD', 'individuals with autism spectrum disorder (ASD)', 'the ASD population', 'ASD subjects', 'autistic vs. typically-developing individuals', 'typically developing (TD) controls'. Mixed person-first and identity-first, with 'typically developing' rather than 'normal' throughout. Autism is described as 'a developmental disorder affecting social and communicative functioning and related to repetitive, limited patterns of behavior and interests' - a conventional clinical framing without pathologising language." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-017" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Author keywords: eye tracking; scanpath comparison; dimensionality reduction; machine learning; autism; face perception. Task vocabulary: 'scanpath', 'areas-of-interest', 'temporal scanpath features', 'substitution matrix', 'dimension-reduced scanpath representation'. Notably the vocabulary is that of eye-movement methodology rather than diagnosis - words like 'screening', 'detection' and 'biomarker' are absent." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-017" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Hardware: SMI RED250 Mobile remote eye tracker at 250 Hz with 0.4 degree accuracy; 15-inch Dell Precision M4800 at 1280x720; chinrest at 65 cm; 5-point calibration with 4-point validation and automated periodic quality checks prompting repositioning. Software: C# experimental program; SMI event detector (60 ms minimum fixation, 50 degrees/s velocity threshold); Wolfram Mathematica 11.3 for the facial landmark detector and LightGBM; MATLAB (van der Maaten's original code) for t-SNE; R for the Cramer test." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-017" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Single modality, but with an unusual internal contrast: spatial-only and spatial-plus-temporal representations of the same data are constructed through identical pipelines and compared, which is a form of ablation rather than fusion. Left and right eye representations are kept separate and both included as features, motivated by a possible lateral offset with each eye directed slightly toward its own side of the face. Face emotion, gender, age and task type were tested as additional predictors and reported as not significantly improving either model." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-017" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "Two experiments comprising five task blocks of 12 trials each, giving 60 trials per subject; each trial presented a 500 ms fixation cross, a 2000 ms facial image, and a 2000 ms blank screen or questio" ;
                    slr:study_design "Cross-sectional case-control methods-demonstration study using data from two laboratory experiments with the same participants" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: 21 (including 2 females); comparison: 23 (5 females)" ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "Spatial-only model 53.9% accuracy; spatial-plus-temporal model 55.5%; the difference significant at t(5) = -2.94, p = 0.032. Both significantly above chance by permutation test (p < 0.001, k = 1000). Cramer test on t-SNE point distributions: left eye statistic 358.84 against critical value 61.59, p < 0.001; right eye statistic 205.25 against critical value 62.33, p < 0.001. Benchmark using Levensh",
                        "The paper introduces a general technique for statistically comparing groups of scanpaths on temporal features: compute a pairwise similarity matrix with ScanMatch, embed it with t-SNE, and compare the resulting low-dimensional distributions. Demonstrated on autism, the distributions of ASD and TD scanpath embeddings differed highly significantly, and a classifier given the temporal representation " ;
                    slr:outcome "Classification accuracy averaged across cross-validation iterations and folds, with a paired t-test comparing models, confusion matrices for both models, and permutation-derived p-values against chance" ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "Spatial-only model 53.9% accuracy; spatial-plus-temporal model 55.5%; the difference significant at t(5) = -2.94, p = 0.032. Both significantly above chance by permutation test (p < 0.001, k = 1000). Cramer test on t-SNE point distributions: left eye statistic 358.84 against critical value 61.59, p < 0.001; right eye statistic 205.25 against critical value 62.33, p < 0.001. Benchmark using Levensh; The paper introduces a general technique for statistically comparing groups of scanpaths on temporal features: compute a pairwise similarity matrix with ScanMatch, embed it with t-SNE, and compare the resulting low-dimensional distributions. Demonstrated on autism, the distributions of ASD and TD scanpath embeddings differed highly significantly, and a classifier given the temporal representation " ] ] ;
