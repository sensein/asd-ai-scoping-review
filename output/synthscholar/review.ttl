<urn:slr:article:2062d0824ac5> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Autism Spectrum Disorder (ASD) is a rising disorder in the brain among newborns aged 0 to 36 months, emphasizing the urgent need for early and accurate detection to mitigate potential developmental risks. Deep learning and machine learning techniques have shown promise in diagnosing ASD, particularly in children aged 36 to 72 months. However, the effectiveness of these diagnostic models heavily depends on the quality and accuracy of the training data. Inaccurate or mismatched data can lead to unreliable diagnoses and inappropriate clinical interventions. In this paper, we propose a machine unlearning-integrated explainable AI (XAI) framework for the early detection of autism spectrum disorder and brain disabilities in newborns. Central to our framework is the Machine Unlearning-Integrated Explainable AI Partitioning Autism Detection and Brain Disorder (MUXAI-ASDBD) algorithm, a novel partitioning-based XAI approach built on Convolutional Neural Network (CNN). This algorithm provides layer-wise explainability during training and incorporates a machine unlearning mechanism at the summation layer, along with probability distribution analysis, to enhance diagnostic accuracy and computational efficiency. The MUXAI-ASDBD framework was evaluated using multiple benchmark datasets, including Ages and Stages Questionnaires (ASQ), CSBS, PEDS, the Modified Checklist for Autism in Toddlers (M-CHAT), and the Screening Tool for Autism in Toddlers and Children (STAT). We also integrated neuroimaging data from brain disorder MRI and EEG datasets. This work extends our previously published implementation, in which we detected autism but did not correct errors, as we do here. Simulation results showed that the MUXAI-ASDBD framework reduced error rates by 23%, reduced false positives, improved accuracy to 98%, and reduced processing time for autism detection using the given multimodal data." ;
    dcterms:bibliographicCitation "Lakhan A; Mohammed MA; Hamouda H; Thaljaoui A; Baslem A; Al-Andoli MN (2026). An explainable machine unlearning algorithm framework for early detection of autism spectrum disorder and brain disabilities in newborns. **." ;
    dcterms:creator "Al-Andoli MN",
        "Baslem A",
        "Hamouda H",
        "Lakhan A",
        "Mohammed MA",
        "Thaljaoui A" ;
    dcterms:title "An explainable machine unlearning algorithm framework for early detection of autism spectrum disorder and brain disabilities in newborns" ;
    bibo:pmid "local_367db0b6" ;
    fabio:hasPublicationYear 2026 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Sample size justified" ;
                            slr:justification "25,000 positive cases reported from a 10,000-sample dataset, with a 21-to-1 class ratio described as balanced." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Participants appropriate to the question" ;
                            slr:justification "No participants; the study population's age is stated three incompatible ways and no consistent count of children exists." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Data source and eligibility described" ;
                            slr:justification "Datasets named and a repository cited, but sample sizes are mutually contradictory and Table 4, presented as the dataset, is a results table with algorithm names in a column." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Preprocessing reported" ;
                            slr:justification "Partitioning is the only preprocessing described and its parameter is inconsistent; feature vectors are printed as illustrative example values." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Predictors assessed blind to outcome" ;
                            slr:justification "No feature-selection procedure is described, so no label-informed step is documented - nor is anything else." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Predictors defined and measured appropriately" ;
                            slr:justification "Questionnaire data are fed to 224x224 convolutional backbones with no stated encoding; the modality set and partition count differ between sections." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Outcome determined independently of predictors" ;
                            slr:justification "Cannot be assessed - neither the label nor its relationship to the inputs is described." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Outcome definition and ascertainment" ;
                            slr:justification "No label ascertainment is described for any dataset; the named instruments are screening tools; one outcome scheme includes a 50/50 random category." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Limitations and overinterpretation" ;
                            slr:justification "Two deployment-level caveats only; the framework is claimed to be able to validate itself in real-world clinical implementations and to be implementable in hospital settings." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Performance measures adequate" ;
                            slr:justification "Sensitivity, specificity, PPV, NPV, AUC and calibration are named and none is reported as a number; confidence intervals are described as 95 to 98%; results appear as low/medium/high bar charts." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Internal consistency of reporting" ;
                            slr:justification "Sample size, class balance, partition count, modality set and age range each stated inconsistently; cybersecurity vocabulary about malicious and fraudulent events appears in the results; a response-to-reviewers sentence survives in the body text." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Validation design guards against optimism" ;
                            slr:justification "An exemplary validation paragraph - subject-level separation, Youden thresholding, ablation, deletion audits - none of whose outputs is reported, applied to a self-contradicting sample." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Analysis unit matches the clinical claim" ;
                            slr:justification "Claims concern newborns; the analysis unit is undetermined and the population's age is inconsistent across the article." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No acquisition instrumentation. Model components: ResNet-50 (50 layers) or InceptionV3 (48 layers) at 224x224 input, Adam at learning rate 0.003 (described as increasing), batch size 64, 150 epochs, binary cross-entropy; unlearning and retraining times of 3.2 s and 5.6 s per partition; an inter-modality correlation threshold of 0.65. A testbed with 32 GB RAM and 2 TB storage is named." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-160" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No participants and no coherent sample. The methods state within four consecutive sentences that the study utilised MRI datasets of newborns comprising 10,000 samples and that the final dataset included 25,000 positive cases and 1200 negative cases, with class balance maintained. Both claims cannot hold: 25,000 positives cannot come from 10,000 samples, and a ratio of nearly 21 to 1 is not balance. Elsewhere the CSBS description reports 500 subjects, and Table 4, labelled Standard dataset, lists the same identifier range 01-1000 five times over with different family relationships (son, daughter, niece) and a different algorithm name in each row, so it is a results table presented as a data description. No consistent count of children exists anywhere in the article." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-160" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "MUXAI-ASDBD, described as a partitioning-based explainable CNN framework with layer-wise explainability and a machine-unlearning mechanism at the summation layer, using ResNet-50 or InceptionV3 as per-partition feature extractors. Baselines named are CNN, GNN, ACNN, SVM, LSTM and a proposed FCNN-LSTM - a list that does not match the framework the paper is proposing, since the title framework is a partitioned CNN and the proposed baseline is a fully connected LSTM." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-160" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Not separately developed beyond the deployment limitations. The paper closes on the claim that the framework improved interpretability and diagnostic reliability." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-160" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No task or paradigm. Developmental screening instruments and archived imaging. The most concrete behavioural description concerns CSBS items on communication via eye movements (straight, upward, leftward, downward) and repetitive hand and finger movements, recorded as binary responses over 30-second monitoring windows." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-160" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The stated goal is a machine-unlearning-integrated explainable AI framework for early ASD and brain-disability detection in newborns, motivated by a genuinely important argument: once a newborn's data is used in training, most models provide no mechanism to remove it if parents withdraw consent, which raises ethical and legal problems under GDPR and HIPAA. Headline findings: a 23% reduction in error rates, reduced false positives, accuracy improved to 98%, and reduced processing time. The results are described as simulation results." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-160" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Multimodal fusion is the framework's structural claim: each modality is partitioned, processed by per-partition CNNs, aggregated into a modality representation, and fused into a single feature vector for a softmax classifier. The claim cannot be evaluated. The modality set differs between sections (MRI, video, audio, text and EEG versus MRI, video and text); no dataset is characterised well enough to know what any modality contains; the fused feature vectors are printed as illustrative example numbers; and no ablation isolates any modality's contribution except a reference to an MRI-only ablation whose results are not shown in the extracted text." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-160" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. No sex, ethnicity, socioeconomic or geographic information for any dataset. Age is reported three incompatible ways: newborns aged 0 to 36 months in the title and abstract, children aged 12-36 months in the MRI inclusion criteria, and aged 3-6 years in the CSBS description. Since the paper's central claim is that existing tools are restricted to toddlers above 18 months and that it addresses the gap in newborns, the age of the analysed population is the single most consequential fact in the study and it is stated three different ways." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-160" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "ASD, autism spectrum disorder, newborns, newborn babies, infants, children, brain disabilities, brain disorder. Autism is grouped throughout with brain disabilities and brain disorders as a single detection target, and the abstract describes ASD as a rising disorder in the brain among newborns. No autistic or community perspective appears. A distinct register intrudes in the results, where false positives are explained as occurring when the system flags safe/normal data as malicious or abnormal, and precision is explained in terms of how likely a nominated event is to be true when the model declares it malicious, fraudulent, or different from the expected behaviour - vocabulary from cybersecurity or fraud detection that has been carried into a paper about newborns." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-160" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The validation section contains, in isolation, the most methodologically literate paragraph of any weak study in this review: a 70/15/15 partition with strict subject-level separation to avoid leakage across folds, stratified sampling to preserve class distribution, Youden-index thresholding on validation data, clinically meaningful metrics including PPV and NPV and calibration, paired t-tests and Wilcoxon signed-rank tests, ablation of the MRI-only modality, runtime measurement with means and standard deviations, and a subject-level deletion threat model under which the unlearned model should remain statistically indistinguishable from one retrained without the deleted data, audited by removing specified subjects and validating forgetting against deletion audit sets. Every element of that is the right thing to do. None of it can be assessed, because the article does not report a single number from any of it and because the data description it would apply to is self-contradicting - 10,000 MRI samples yielding 25,000 positive cases, a 25,000-to-1,200 split called class balance, six partitions in one section and four in another, three mutually exclusive age ranges. The experiments are moreover described throughout as simulation results, and the only quantitative outputs shown are before-and-after bar charts binned into low, medium and high. The gap between the methodological vocabulary and the reported evidence is the finding here: this is the corpus's clearest instance of validation language functioning as a genre convention rather than as a description of work performed." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-160" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Alexandria Engineering Journal 145 (2026) 164-181 (Elsevier) - a general engineering journal. Review did not surface a sample description in which 25,000 positive cases are drawn from 10,000 samples and a 21-to-1 ratio is called balanced, three incompatible age ranges for the study population, partition counts differing between sections, a named metric set none of whose values are reported, cybersecurity vocabulary about malicious and fraudulent events in a paper about infants, or a surviving response-to-reviewers sentence in the body text." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-160" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Autism spectrum disorder; Newborn babies; Machine un-learning; Convolutional neural network; Explainable artificial intelligence. Five terms; the population claim (newborn babies) is the one the article's own data description contradicts three times." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-160" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. No diagnostic instrument administration, criterion, assessor or record is described for any dataset. The named sources - ASQ, CSBS, PEDS, M-CHAT and STAT - are developmental screening instruments, not diagnoses, and the paper does not describe how any label was assigned. One results passage categorises outcomes as yes (Y), random (R) - indicating a 50% probability of yes and a 50% probability of no - and not detected (N), which introduces a coin-flip category into what is presented as a diagnostic output." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-160" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional. Ethics and consent are declared unnecessary on the stated ground that the work involved no hospital deployments, and the same passage claims that the datasets were fully identified and processed with strict subject-level partitioning, with fully authorised controlled access, audit logging and standard encryption. Fully identified is the opposite of de-identified and appears in a sentence listing privacy safeguards, so it is presumably an error - but it is the operative word in the article's only statement about the identifiability of newborn data. The irony is structural rather than incidental: the paper's entire motivation is that models must be able to forget a newborn's data when parents withdraw consent, and it obtains no consent and no ethical review for its own use of that data." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-160" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. No cognitive, adaptive, language or severity measure." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-160" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The article makes strong reproducibility claims - a public GitHub repository for both code and data, frozen configuration files, and an explicit statement that the entire pipeline can be replicated end-to-end - and simultaneously makes reproduction impossible by contradicting itself about what was run. The partition count is six in the methodology and four in the parameter table; the sample is 10,000 MRI scans and also 25,000 positives plus 1,200 negatives; the age band is 0-36 months, 12-36 months and 3-6 years in three places; the modality set is MRI, video, audio, text and EEG in one section and MRI, video and text in another. Feature vectors are printed as illustrative example values rather than as results. A sentence from the revision process also survives in the published text, reporting that figures are revised with corrected captions, algorithm numbering is standardized, and placeholder references are replaced with accurate citations." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-160" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "224x224 images for the CNN backbones; the representation of questionnaire data is never specified, which matters because five of the seven named datasets are questionnaires and a 224x224 convolutional backbone cannot consume a checklist without a stated encoding. Aggregated feature vectors appear in the text as literal illustrative values such as [0.5, 0.6, ..., 0.8] and [0.45, 0.55, ..., 0.75]." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-160" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No study setting. Datasets are said to have been processed in different computing laboratories; a testbed with 32 GB RAM and 2 TB storage is named for timing measurements. The paper states that the work involved no hospital deployments while also claiming, in its contributions list, past experience implementing the system in clinical settings and that the framework can effectively validate itself in real-world clinical implementations." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-160" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Developmental screening behaviours as captured by ASQ, CSBS, PEDS, M-CHAT and STAT items - communication through eye movements and repetitive hand and finger movements are the only behaviours described concretely - together with imaging and physiological modalities named but not characterised." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-160" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Layer-wise explainability is the framework's named contribution and no explainability result is presented. Modality-specific outputs are described in a single sentence as gradient spectrogram features for audio and spatiotemporal attention maps for video, each demonstrating interpretability in a clinically meaningful context, with no figure, attribution or quantitative measure to support the claim in the extracted text." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-160" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two sentences, both about deployment: the framework depends on the availability and quality of multimodal datasets, which may vary across clinical settings, and repeated unlearning operations can incur overhead at scale. Neither addresses the evidence. Unmentioned: the contradictory sample sizes, the three different age ranges, the absence of any diagnostic label description, the absence of any numeric result table for the headline accuracy, the majority-class baseline implied by the reported class ratio, and the fact that the experiments are described as simulations." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-160" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The named metric set is clinically appropriate and unusually complete for this corpus - sensitivity, specificity, PPV, NPV, ROC AUC and calibration, with thresholds set by the Youden index and significance assessed by paired t-tests and Wilcoxon signed-rank tests. None of it is reported. No sensitivity, specificity, PPV, NPV, AUC or calibration value appears in the extracted text, no test statistic or p-value is given, and the phrase all reported with 95 to 98% confidence intervals conflates a confidence level with an interval width. What is actually presented is bar charts of error rate, false-positive count and precision binned into low, medium and high before and after unlearning, plus a headline accuracy of 98% and a 23% error reduction with no denominator. If the stated class ratio of 25,000 positives to 1,200 negatives held, the majority-class baseline would be 95.4% and the headline would be 2.6 points above it." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-160" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2026. The framing rests on a genuinely important and under-addressed problem: that once a newborn's data enters a training set there is usually no mechanism to remove it when parents withdraw consent, and that this is a live obligation under GDPR and HIPAA. That argument is correct and is made nowhere else in this corpus. What follows it does not support any of the claims made from it - accuracy improved to 98%, error rates reduced by 23%, false positives reduced, and a framework said to be able to validate itself in real-world clinical implementations and to be implementable in hospital settings. The study reports no confusion matrix, no metric values from its own named metric set, no consistent sample size and no ethics approval, in a paper whose organising principle is the ethical handling of newborns' data." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-160" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "CNN, GNN, ACNN, SVM, LSTM and FCNN-LSTM, reported in tables whose rows mix dataset description with algorithm scores." ;
                    slr:study_design "Simulation-based evaluation of a proposed algorithmic framework across several named behavioural screening datasets and imaging modalities. The experiments are described throughout…" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: Stated as 25,000 positive cases in one passage; no other count is given.; comparison: Stated as 1,200 negative cases in the same passage." ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "Maximum diagnostic accuracy of 98%, a 23% reduction in overall error rate, reduced false positives and reduced processing time. No confusion matrix, no per-dataset accuracy table and no numeric confidence interval accompanies these figures in the extracted text." ;
                    slr:outcome "Sensitivity, specificity, positive and negative predictive value, ROC AUC and calibration scores are named as the evaluation set, said to be reported with 95 to 98% confidence intervals - a phrasing that conflates the confidence level with an interval. Paired t-tests and Wilcoxon signed-rank tests a" ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "Maximum diagnostic accuracy of 98%, a 23% reduction in overall error rate, reduced false positives and reduced processing time. No confusion matrix, no per-dataset accuracy table and no numeric confidence interval accompanies these figures in the extracted text." ] ] ;
