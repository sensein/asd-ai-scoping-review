                    slr:judgment "some" ;
                    slr:supporting_quote "Frame counts before and after filtering are given by group and per-video retention is comparable, but no accounting is given of children or videos excluded at any stage, and demographic composition of the three partitions is not reported." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Self-selected app users with a 13-year age span and no group-specific ages, means or tests reported; cases outnumber controls more than two to one at child level and five to one at video level; no cognitive, language or severity data; no exclusion criteria." ],
                [ a slr:RoBDomainJudgment ;
