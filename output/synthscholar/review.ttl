        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "Resize+ Normalization • Resize+ Normalization+ CLAHE • Resize+ Normalization+ Greyscale+ CLAHE" ] ;
            oa:hasTarget <https://doi.org/10.1145/3660853.3660888> ;
            slr:claim_label "Three preprocessing configurations compared, one removing colour and normalising local contrast - the two appearance cues most likely to differ between images from different online sources. The right experiment for this problem, though its per-configuration results are not reported." ;
            slr:relevance_score "0.9"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "the neurotypical group exhibited significantly higher Mean_rateHM (p < .0001, r = .47), Mean_accelHM (p < .0001, r = .62), and Integrated_entropyHM (p < .0001, r = .51) during social movies than the nonsocial movies. In contrast, the autistic group did not exhibit differences in Mean_rateHM, Mean_accelHM, and Integrated_entropyHM during the social versus nonsocial movies." ] ;
            oa:hasTarget <urn:slr:article:dbb27be8e821> ;
            slr:claim_label "Neurotypical toddlers modulated head movement by social content while autistic toddlers did not - a within-group contrast stronger than the between-group difference." ;
            slr:relevance_score "0.95"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "No images before augmentation 175 262 44 66 / No images after augmentation 1750 1834 44 66" ] ;
            oa:hasTarget <https://doi.org/10.3390/electronics11040530> ;
            slr:claim_label "Augmentation was correctly confined to the training and validation partitions with the test set left unaugmented - the discipline that Gaspar and colleagues violated on the same dataset." ;
            slr:relevance_score "0.9"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "When using only the EEG power, we obtained a 68% classification. When only eye-tracking data was used for classification, the accuracy was 72.33% for own-race faces and 66.67% for other-race faces. When the two types of faces were combined, the accuracy was 75.89%. With a combination of EEG and eye-tracking data, the accuracy of classification reached 85%." ] ;
            oa:hasTarget <urn:slr:article:3ba88bcdc38e> ;
