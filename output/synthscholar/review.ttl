    slr:journal "Molecular Auti" ;
    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "ADOS-2 Module 4 with the Hus and Lord algorithm and stated cutoff tolerances at both sites, plus prior clinician diagnosis and independent confirmation by a licensed clinical psychologist at Caltech." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "Every exclusion is counted and reasoned, but 10 of 58 autistic participants (17%) were dropped for gaze data quality against 3 of 108 controls (3%), and this differential is reported without discussion; both episodes were viewed on the same day, so the reliability interval is about an hour." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "Two sites, community recruitment, complete flow accounting from 183 to 153, and groups formally matched and tested on age (p = 0.617), sex (p = 0.353) and full-scale IQ (p = 0.525), with severity spanning ADOS CSS 3-10." ],
                [ a slr:RoBDomainJudgment ;
