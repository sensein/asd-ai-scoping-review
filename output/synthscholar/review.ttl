            oa:hasBody [ a dcterms:Text ;
                    rdf:value "the dataset containing 2940 children's facial images (1470 autistic and 1470 non-autistic images) is split into training and testing datasets. The training set contains 2540 facial images (1270 autistic and 1270 non-autistic images) and the testing set contains 400 facial images (200 autistic and 200 non-autistic images)." ] ;
            oa:hasTarget <https://doi.org/10.22266/ijies2025.0531.01> ;
