        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "SE-MSF-CNN with WSO obtained a mean accuracy of 90% (0.03, 95% CI [89.6-90.4%]) and an area under the curve (AUC) of 0.94 (0.03, 95% CI [93.6-94.4%]) when trained on the YTUIA dataset and tested on Piosenka" ] ;
