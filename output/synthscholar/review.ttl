    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "All 16 children completed the fixed 190-second protocol and all appear in the classification results; misclassifications are enumerated individually." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "The reported 81.3% is the best cell of a five-classifier by three-feature grid plus a stacking design, none of which is nested inside the 8-fold cross-validation; the same stacking degrades four of the five classifiers, indicating the gain is not robust." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "A three-clinician process (pediatrician, psychologist, validating psychiatrist) is described, which is more than most corpus studies report, but no standardised instrument is used and control status is asserted from daycare attendance." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Sixteen children from a single autism treatment centre, with control ages (2.11-7.6 years) spanning roughly double the ASD range (2.1-4.1) and no matching, no means and no gender data - age is confounded with group in a measure of physical approach behaviour." ] ;
            slr:overall_judgment "high" ;
            slr:tool_used "QUADAS-2" ] .

<urn:slr:article:752eeff1ddb3> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "RESEARCH ARTICLE Identifying Children with Autism Spectrum Disorder Based on Their Face Processing Abnormality: A Machine Learning Framework Wenbo Liu, Ming Li, and Li Yi The atypical face scanning patterns in individuals with Autism Spectrum Disorder (ASD) has been repeatedly discov- ered by previous research. The present study examined whether their face scanning patterns could be potentially use- ful to identify children with ASD by adopting the machine learning algorithm for the classiﬁcation purpose. Particularly, we applied the machine learning method to analyze an eye movement dataset from a face recognition task [Yi et al., 2016], to classify children with and without ASD. We evaluated the performance of our model in terms of its accuracy, sensitivity, and speciﬁcity of classifying ASD. Results indicated promising evidence for applying the machine learning algorithm based on the face scanning patterns to identify children with ASD, with a maximum classiﬁcation accuracy of 88.51%. Nevertheless, our study is still preliminary with some constraints that may apply in the clinical practice. Future research should shed light on further valuation of our method and contribute to the development of a multitask and multimodel approach to aid the process of early detection and diagnosis of ASD. Autism Res 2016, 9: 888–898. V C 2016 International Society for Autism Research, Wiley Periodicals, Inc." ;
    dcterms:bibliographicCitation "Liu W; Li M; Yi L (2016). Identifying children with autism spectrum disorder based on their face processing abnormality: A machine learning framework. *Autism Research, 9(8), 888-898*." ;
    dcterms:creator "Li M",
        "Liu W",
        "Yi L" ;
    dcterms:title "Identifying children with autism spectrum disorder based on their face processing abnormality: A machine learning framework" ;
    bibo:pmid "local_863980f8" ;
    fabio:hasPublicationYear 2016 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the sample appropriate and adequate for the stated target?" ;
                            slr:justification "n=87 is respectable for 2016 but small for pattern classification, as the authors acknowledge; sample prevalence far exceeds population prevalence." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are participants and recruitment adequately described?" ;
                            slr:justification "Demographics, NVIQ and AQ given in Table 1, but recruitment route and setting are deferred to the source publication." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are comparison groups matched on the variables that matter?" ;
                            slr:justification "Two separately matched TD groups (chronological age and nonverbal ability), with identical sex ratios - a stronger control design than almost anything else in the corpus." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "some concerns" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the behavioral data acquisition described reproducibly?" ;
                            slr:justification "Eye tracker model, sampling rate, stimulus dimensions, masking, block structure and presentation timing all specified." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are predictors defined without knowledge of outcome?" ;
                            slr:justification "Fixation coordinates are outcome-independent, but the K-means quantisation that defines the feature space is fitted on the pooled data of all labelled participants." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the reference standard appropriate and independently applied?" ;
                            slr:justification "DSM-IV clinical diagnosis confirmed only by the AQ-Child questionnaire; ADOS/ADI-R explicitly unavailable." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "some concerns" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the validation free of hyperparameter and threshold optimism?" ;
                            slr:justification "K tuned per experiment 'to reach the best accuracy' and the decision threshold set at the accuracy-maximising value on the same data." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the validation scheme subject-independent?" ;
                            slr:justification "Leave-one-participant-out with participant-level score aggregation - notably better than the instance-level cross-validation common in this literature." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is there external or independent validation?" ;
                            slr:justification "None; replication on larger samples is named as future work." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is class imbalance handled appropriately?" ;
                            slr:justification "29 ASD vs 58 TD handled by a flexible threshold, itself tuned on the evaluation data." ;
                            slr:rating "Partly" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the dataset accessible or its access conditions stated?" ;
                            slr:justification "No data availability statement; dataset is from a prior publication." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are results reported consistently?" ;
                            slr:justification "The direction of the discriminative-region preferences contradicts between the Results and Discussion sections." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are sample bias, generalisability and deployment limits discussed?" ;
                            slr:justification "An exemplary limitations section: base-rate/prevalence caveat, age and culture adaptation of face scanning, sample-characteristic confounds, small sample, and the need for longitudinal predictive validation." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are ethics, consent and privacy handling reported?" ;
                            slr:justification "No consent or ethics statement in this paper; conflict-of-interest and funding are declared." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is code or an implementation available?" ;
                            slr:justification "None, though the method is described in unusually reproducible detail including the K values and the 0.3255 threshold." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "some concerns" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Diagnosis by experienced clinicians against DSM-IV criteria, confirmed with the Chinese AQ-Child. The authors explicitly state that ADI-R and ADOS were unavailable to them - so no gold-standard observational instrument was used." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-004" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No data availability statement, no code release, no seeds. The pipeline (K-means quantisation, histogram normalisation, RBF-SVM, LOO with participant-level score averaging, threshold selection) is described in enough detail to re-implement in principle, and K values and the optimal threshold (0.3255) are reported - better than most contemporaries - but the underlying dataset is not accessible. Not reproducible in practice." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-004" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Supervised learning. Algorithm: RBF-kernel support vector machine, preceded by unsupervised K-means clustering used purely as a quantisation/feature-construction step." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-004" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Author keywords: autism spectrum disorder; face processing; eye tracking; machine learning. Task vocabulary: 'identify children with ASD', 'classification framework', 'computer-aid diagnosis', 'ASD risk', 'biomarker', 'early detection'." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-004" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Three groups: ASD (n=29) and two typically developing control groups - chronological-age-matched (n=29) and nonverbal-ability/IQ-matched (n=29). All groups reported with sex ratio, age, nonverbal IQ raw score and AQ. No other-diagnosis clinical group." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-004" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Gaze: fixation coordinates during face viewing, aggregated as spatial frequency distributions. Temporal/scanpath information was deliberately excluded because cross-region transitions were too sparse in the training data." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-004" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Accuracy, sensitivity, specificity, ROC curves and AUC - a fuller metric set than most corpus studies of this period. Headline: 88.51% accuracy / 93.10% sensitivity / 86.21% specificity / AUC 89.63%. No confidence intervals; a significance marker (p<0.001) is attached to the overall accuracy." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-004" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional single session. Data are gaze coordinates, low in identifiability; face stimuli are third-party images. This paper carries no ethics, consent or data-protection statement - procedures are deferred to the source publication - and no anonymization is described. Longitudinal follow-up is named as future work, not performed." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-004" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Interpretability by mean-histogram differencing: FeatDif = FeatASD - FeatTD, with the largest-magnitude bins visualised on the face and re-tested as a reduced feature set (top seven bins retain 79.31% accuracy). The informative regions are periocular and perioral, which the authors link to the eye-avoidance hypothesis. Direction of preference is reported but stated inconsistently across sections." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-004" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "ASD n=29, 25M/4F, age 7.90 (1.45), NVIQ raw 22.29 (10.80), AQ 85.48 (14.90). TD-Age n=29, 25M/4F, age 7.86 (1.38), NVIQ 29.90 (9.96), AQ 62.74 (12.57). TD-Ability n=29, 25M/4F, age 5.74 (1.01), NVIQ 22.28 (7.90), AQ 64.03 (12.21). Age matching holds for TD-Age (t=0.09, n.s.) and ability matching holds for TD-Ability (t=0.00); sex ratio identical across all three groups. This double-matching design is stronger than most of the corpus." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-004" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Leave-one-participant-out cross-validation with participant-level aggregation - subject-independent at the decision level, which is better than the instance-level cross-validation common in this corpus. But K and the decision threshold are selected to maximise accuracy on the same data, K-means quantisation uses all participants' fixations, and there is no external or independent test set, no held-out site and no cross-cultural check. Class imbalance (29 ASD vs 58 TD) is handled by a tuned flexible threshold rather than resampling. Base-rate limitation on deployment is explicitly discussed; no real-time claim, though the authors note remote eye trackers make rapid data collection feasible." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-004" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Data-driven histogram (bag-of-locations) representation: fixation coordinates are quantised to K K-means cell centroids over the face image and counted, then normalised by total fixation count, giving one K-dimensional histogram per viewed face. Explicitly orderless - no raw time series, scanpath sequence or deep embedding." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-004" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Goal: screening / computer-aided detection - binary ASD vs TD classification from face-scanning patterns, plus localisation of discriminative facial regions. Main findings: 88.51% accuracy (93.10% sensitivity, 86.21% specificity, AUC 89.63%) across all faces; better on other-race (90.80%) than same-race faces (81.61%); ASD separable from both the age-matched (84.48%) and ability-matched (86.21%) TD groups; seven facial regions alone retain 79.31% accuracy; classification score uncorrelated with age." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-004" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Nonverbal IQ measured with the Combined Raven Test (CRT-C2) for all participants and used to construct the ability-matched control group; AQ-Child reported for all three groups. No language or adaptive-functioning measures. Comorbid conditions are not described or excluded." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-004" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Hardware: Tobii T60 remote eye tracker, 60 Hz binocular. Software: Tobii Studio for acquisition; MATLAB for K-means quantisation, SVM training and ROC/AUC computation." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-004" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "'children with ASD', 'children with autism spectrum disorder', 'individuals with ASD', 'the ASD group', 'typically developing (TD) children', 'TD counterparts', 'typical population'. Person-first throughout; no identity-first ('autistic') usage." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-004" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Autism Research (INSAR/Wiley) - an autism-specific clinical/research journal, not a computational venue." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-004" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A face recognition memory task: three study blocks in which the child memorises one Chinese and one Caucasian face (3 s each), each followed by three test blocks with two target and two foil faces shown until response. Stimuli were grey-scale, front-view, with hair and ears removed by an elliptical mask." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-004" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Laboratory eye-tracking setting. Existing data - the study is an explicitly secondary machine-learning analysis of the eye-movement dataset collected for Yi et al. (2016), which had analysed it with a conventional area-of-interest approach." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-004" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Reported by the authors: sample prevalence (33% ASD) far exceeds population prevalence (~1%), so positive predictive value in practice would be much lower; face-scanning is age- and culture-adapted so the model may not transfer across ages or cultures; ASD sample characteristics such as symptom severity and cognitive function may drive scanning patterns; sample size is small for pattern classification. Identifiable in review: strong male skew (25/29, ~86% male, replicated across all groups); single-country Chinese sample with race-specific face stimuli; diagnosis confirmed by questionnaire (AQ-Child) rather than ADOS/ADI-R; cluster number K and decision threshold tuned for maximum accuracy on the same data; K-means quantisation fitted on all participants including the held-out test participant, a subtle transductive leak; and the direction of the discriminative-region effects is stated inconsistently between Results and Discussion." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-004" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Single modality; no fusion is performed. The discussion explicitly proposes future multimodal fusion with physiological, speech, motion and facial-expression measures. Within the modality, image-level decisions are fused to a participant-level decision by averaging confidence scores - a late/decision-level fusion across stimuli rather than across modalities." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-004" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2016. The paper characterises machine learning in autism research as so far dominated by feature selection to shorten diagnostic instruments (ADOS/ADOS-G item reduction) and by neuroimaging, with behavioral classification only just beginning (citing Crippa et al. 2015 as the motivating precedent) - documenting the field's pivot toward behavioral prediction that this corpus goes on to record." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-004" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Validate and replicate on larger samples; run longitudinal high-risk-infant studies to test whether infant face-processing predicts later symptom severity; refine the algorithm and determine the minimum number of eye-movement features needed for clinical use; extend to other stimuli (social and non-social) and other tasks; and combine face-scanning with brain activity, skin conductance, speech, motion, body gestures and facial expressions in a multimodal risk measure. The paper is an early and explicit call for multimodal ASD prediction." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-004" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "Single session; three study blocks (two faces each, 3 s per face) followed by three test blocks per study block; test faces presented until response" ;
                    slr:study_design "Cross-sectional case-control classification study; secondary machine-learning analysis of a previously published eye-tracking dataset (Yi et al., 2016)" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: 29; comparison: 58 (29 age-matched + 29 IQ-matched)" ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "All faces: 88.51% accuracy, 93.10% sensitivity, 86.21% specificity, AUC 89.63%. Other-race faces: 90.80% / 96.55% / 87.93% / AUC 94.41%. Same-race faces: 81.61% / 75.86% / 84.48% / AUC 82.40%. ASD vs TD-Age: 84.48% (AUC 85.37%); ASD vs TD-IQ: 86.21% (AUC 88.94%). Top seven regions only: 79.31% accuracy, 68.96% sensitivity, 84.48% specificity",
                        "Face-scanning patterns, represented as data-driven histograms over K-means-quantised fixation coordinates, classified children with ASD from TD children at up to 88.51% accuracy (AUC 0.90), and separated ASD from both age-matched and ability-matched TD groups. Other-race faces discriminated better than same-race faces. Seven facial regions carried most of the signal, retaining 79.31% accuracy, and" ;
                    slr:outcome "Accuracy, sensitivity, specificity, ROC curves and AUC" ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "All faces: 88.51% accuracy, 93.10% sensitivity, 86.21% specificity, AUC 89.63%. Other-race faces: 90.80% / 96.55% / 87.93% / AUC 94.41%. Same-race faces: 81.61% / 75.86% / 84.48% / AUC 82.40%. ASD vs TD-Age: 84.48% (AUC 85.37%); ASD vs TD-IQ: 86.21% (AUC 88.94%). Top seven regions only: 79.31% accuracy, 68.96% sensitivity, 84.48% specificity; Face-scanning patterns, represented as data-driven histograms over K-means-quantised fixation coordinates, classified children with ASD from TD children at up to 88.51% accuracy (AUC 0.90), and separated ASD from both age-matched and ability-matched TD groups. Other-race faces discriminated better than same-race faces. Seven facial regions carried most of the signal, retaining 79.31% accuracy, and" ] ] ;
