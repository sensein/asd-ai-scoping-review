    slr:journal "Diagnostics, 14(22)" ;
    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "The outcome is a binary ASD_traits field in a downloaded spreadsheet, with no clinical assessment, instrument administration, criterion or assessor described for any case, while the paper frames the task as diagnosis." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "The 19-variable predictor set includes CARS, the Social Responsiveness Scale, the AQ10 total, the Q-CHAT-10 score and the ten AQ-10 items - four instrument measurements of the target condition plus the constituents of one of them. Expert-guided feature selection and record removal were performed on the full dataset before cross-validation, and the nesting of grid-search tuning within the outer folds is not specified." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Secondary use of a public Kaggle dataset with no described collection procedure, setting, country or dates. Preprocessing removed 1,351 of 1,985 records on unstated criteria, and the class balance of neither the raw nor the analysed dataset is reported anywhere, despite the introduction identifying class imbalance as a known problem in ASD datasets." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "Cross-validation partitions children and per-fold metrics are published, so there is no within-participant leakage and the flow through the modelling stage is transparent. But 68% of records were removed before that stage with no accounting, and no class counts exist for any partition." ] ;
            slr:overall_judgment "high" ;
            slr:tool_used "QUADAS-2" ] .

<urn:slr:article:2bf712f2292c> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Autism spectrum disorder (ASD) is a lifelong condition generally characterized by social and communication impairments. The early diagnosis of ASD is highly desirable, and there is a need for developing assistive tools to support the diagnosis process in this regard. This paper presents an approach to help with the ASD diagnosis with a particular focus on children at early stages of development. Using Machine Learning, our approach aims to learn the eye-tracking patterns of ASD. The key idea is to transform eye-tracking scanpaths into a visual representation, and hence the diagnosis can be approached as an image classification task. Our experimental results evidently demonstrated that such visual representations could simplify the prediction problem, and attained a high accuracy as well. With simple neural network models and a relatively limited dataset, our approach could realize a quite promising accuracy of classification (AUC > 0.9)." ;
    dcterms:bibliographicCitation "Carette R; Elbattah M; Cilia F; Dequen G; Guérin JL; Bosche J (2019). Learning to Predict Autism Spectrum Disorder based on the Visual. *Proceedings of the 12th In*." ;
    dcterms:creator "Bosche J",
        "Carette R",
        "Cilia F",
        "Dequen G",
        "Elbattah M",
        "Guérin JL" ;
    dcterms:title "Learning to Predict Autism Spectrum Disorder based on the Visual" ;
    bibo:pmid "local_fea042be" ;
    fabio:hasPublicationYear 2019 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are participants and recruitment adequately described?" ;
                            slr:justification "Only whole-sample age and gender statistics; no per-group breakdown, and distributions shown only as box plots." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are comparison groups matched?" ;
                            slr:justification "No matching procedure or comparability test reported, with groups recruited through entirely different routes." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the sample appropriate and adequate for the stated target?" ;
                            slr:justification "59 children, all around age 8, despite an early-detection framing; the authors name small sample size as the primary limitation." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the behavioral data acquisition described reproducibly?" ;
                            slr:justification "Eye tracker model and sampling rate, monitor size and resolution, viewing distance, calibration scheme, room conditions and stimulus categories all specified." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the representation free of apparatus artefacts?" ;
                            slr:justification "The illustrated ASD case is described as looking toward the bottom of the screen where the eye-tracking device was physically placed, a potential apparatus-driven signal that is noted but not investigated." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the reference standard appropriate and independently applied?" ;
                            slr:justification "Unspecified multidisciplinary clinic examination with CARS only; controls unscreened." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are predictors defined without knowledge of outcome?" ;
                            slr:justification "Rendering and feature extraction are fully automatic from gaze coordinates." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "some concerns" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are baselines compared on equal terms?" ;
                            slr:justification "Naive Bayes, logistic regression, SVM and random forests all reported at approximately AUC 0.70 against the neural networks' 0.90+." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the validation participant-independent?" ;
                            slr:justification "Never stated; the unit of analysis is the image, with multiple images per child." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is there external or independent validation?" ;
                            slr:justification "None." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is augmentation performed inside the fold split?" ;
                            slr:justification "2,735 synthetic samples were generated from the 547 images before cross-validation, so augmented near-duplicates of test images can appear in training." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is model complexity explored?" ;
                            slr:justification "Four architectures compared, with the finding reported that added depth and width gave no improvement." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the severity-prediction target independent of the diagnostic measure?" ;
                            slr:justification "The multi-label target is CARS bands, and CARS is also the instrument characterising the diagnosis, making that experiment partly circular." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is code available?" ;
                            slr:justification "No code, though the rendering procedure and libraries are described in detail and a demonstration web application is deployed." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are competing interests declared?" ;
                            slr:justification "The work is 'generously supported by the Evolucare Technologies company', a commercial healthcare IT firm, acknowledged in the funding note but with no competing-interests statement." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are ethics, consent and assent reported?" ;
                            slr:justification "Parental informed consent and child assent both confirmed, with institutional/national committee standards and the 1964 Helsinki declaration cited." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are limitations discussed?" ;
                            slr:justification "A short limitations section covers sample size and stimulus duration but not the validation design, demographics or the apparatus observation." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the dataset accessible or its access conditions stated?" ;
                            slr:justification "547-image dataset with metadata publicly released on Figshare with an explicit reuse intention." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "some concerns" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None quantitatively. Two example visualisations are compared qualitatively, with the observation that both show high-density central regions and that the ASD exemplar tended to look toward the bottom of the screen. The confusion matrix for the multi-label model does carry an interpretable finding - that non-ASD is discriminated well while ASD categories, especially severe ASD, are at least 20% worse - which suggests the representation captures the presence of atypicality better than its gradation." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-026" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Passive video viewing lasting about 5 minutes on average, with scenarios deliberately varied in content and length to allow ocular activity to be analysed from different perspectives. Stimuli were designed to attract children (colourful balloons, cartoons) with elements whose position changes during the experiment, and some videos featured a human presenter speaking in French who attempts to direct the child's attention to visible or invisible elements. Additional SMI Experiment Center stimuli spanned static and dynamic naturalistic scenes with and without receptive language, joint attention stimuli, static faces or objects, and cartoons. A five-point calibration with subsequent verification procedures preceded recording." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-026" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Hardware: SMI Red-m remote screen-based eye tracker at 250 Hz mounted below a 17-inch monitor at 1280x1024, with the child approximately 60 cm away; physical white barriers around the setup. Software: SMI Experiment Center for stimulus presentation; Python with Matplotlib for scanpath rendering; Keras for image augmentation and neural network training; scikit-learn for PCA and conventional classifiers; Azure ML Studio hosting the models as web services with an ASP.NET and JavaScript front end for the demonstration application." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-026" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No cognitive, linguistic or adaptive measures are reported for either group, and no comorbidity information. CARS is the only clinical instrument, reported as a sample-level mean and median with a box-plot distribution." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-026" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Goal: assistive diagnosis supporting early detection, achieved by converting scanpaths into images so the problem becomes image classification. Main findings: neural networks exceeded AUC 0.90 (best approximately 0.92 with a single 200-neuron hidden layer) against approximately 0.70 for Naive Bayes, logistic regression, SVM and random forests on the same data; increasing model depth or width gave no further gain; and a four-class CARS-severity model reached approximately 83% overall but performed at least 20% worse on ASD categories than on non-ASD, particularly for severe ASD." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-026" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Gaze: raw point-of-regard coordinates over time, from which velocity, acceleration and jerk are derived and encoded chromatically. Distinctively, the representation preserves the full spatiotemporal trajectory rather than aggregating into area-of-interest dwell times, which is the dominant approach elsewhere in the corpus." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-026" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional; a single approximately 5-minute session per child with no follow-up. The data are gaze coordinates rendered into abstract images, so identifiability is low and the public release is correspondingly low-risk. Consent handling is reported carefully: both informed consent from parents and assent from the children themselves were confirmed for all cases, and procedures followed institutional and/or national research committee ethical standards and the 1964 Helsinki declaration with later amendments." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-026" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Reported by the authors in a brief limitations section: the relatively small number of participants, and the fairly short duration of the video scenarios, with longer scenarios possibly allowing a richer visual representation. Identifiable in review and more consequential: the unit of analysis is the image not the child, with 547 images from 59 children plus 2,735 augmented synthetic derivatives, and no statement that cross-validation was participant-independent - so images and their own augmented near-duplicates can span the training and test folds, which would inflate the reported AUC substantially; no per-group age or sex data at all; the qualitative observation that the ASD exemplar looked toward the bottom of the screen where the eye tracker was physically located raises the possibility of apparatus-driven signal; the multi-label experiment predicts CARS bands from data collected on children whose diagnosis was itself characterised by CARS, which is partly circular; and the work was funded by a commercial healthcare IT company, acknowledged but not declared as a competing interest." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-026" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "ASD-diagnosed children were examined in multidisciplinary ASD specialty clinics, with autism intensity rated by psychologists using CARS. Typically developing status rests on recruitment from mainstream schools plus careful consideration of parental reports of any possible concerns. No ADOS, ADI-R or structured screening instrument is used, and CARS serves both as the severity measure and, implicitly, as part of the diagnostic characterisation - which matters because CARS bands are later used as the multi-label prediction target." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-026" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "HEALTHINF 2019, part of the 12th International Joint Conference on Biomedical Engineering Systems and Technologies (BIOSTEC) - a health informatics and biomedical engineering venue, technology-focused rather than clinical, though the work is described as interdisciplinary collaboration between psychology and AI research units." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-026" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2019. The related-work section surveys the eye-tracking evidence base - shorter and less frequent saccades in high autistic traits, longer fixation on dynamic geometric images in ASD toddlers, declining eye fixation in infants aged 2 to 6 months who later developed ASD, and cohort evidence for eye tracking as an objective measure of autism risk and severity - and then the machine-learning turn, citing RNN classification of Fragile X from gaze during conversation (86-91%) and the authors' own earlier saccade-feature model on 17 children. It positions the visual-representation approach as novel: 'It is claimed that such approach has not been applied before in the context of ASD, to the best of our knowledge'. The accompanying dataset release and deployed web service also document the field's move toward shared benchmarks and demonstrable tooling around 2018-2019." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-026" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No dedicated future-work section. The limitations imply that longer video scenarios should be tested, and the conclusion suggests the scanpath-visualisation approach may generalise to comparable diagnostic problems and to other psychological disorders. No proposals for participant-level validation, larger or independent samples, or addressing the demographic reporting gaps." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-026" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two groups: 29 ASD-diagnosed children and 30 non-ASD children, total 59. Group sizes are reported. For the multi-label experiment the ASD group is further split by CARS severity into Low, Mild and Severe bands, making four classes. No non-autistic clinical comparison group." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-026" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Laboratory setting - a quiet university room with white barriers to reduce visual distraction, children seated alone or on a parent's lap at approximately 60 cm. Newly collected data, with the resulting image dataset released publicly on Figshare and described in more detail in an earlier publication by the same group." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-026" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "AUC with standard deviation across cross-validation folds, plotted as ROC curves for all four neural architectures, plus a normalised confusion matrix for the multi-label severity model. AUC is a reasonable primary metric, and reporting fold standard deviations is better than corpus norm. However no accuracy, sensitivity, specificity or precision is given for the binary task, and no confidence intervals, so the per-class error profile of the main result cannot be assessed." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-026" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Unusually strong on data, weaker on process. The 547-image dataset with metadata is publicly released on Figshare with the explicit intention that others reuse it, and a working demonstration application is deployed at a stated URL. The rendering procedure is described in reproducible detail - the colour-gradient encoding of velocity, acceleration and jerk, the one-quarter-diagonal cap, the vertical mirroring, the 200-point threshold and how it was chosen, the 100x100 rescaling, the grayscale luminance equation, and the PCA reduction to 50 components. What is missing: no code release, no random seeds, no statement of how cross-validation folds were partitioned, no augmentation transformation parameters beyond 'rotation, shearing', and no per-group demographics." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-026" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "'individuals diagnosed with ASD', 'ASD-diagnosed children', 'ASD-diagnosed participants', 'children with ASD', 'typically developing (TD) children', 'Non-ASD'. Predominantly diagnosis-first labelling driven by the classification framing, with the notable phrasing that individuals with ASD 'typically suffer from deficits' and that symptoms 'place a considerable strain on their lives and their families' - a deficit-and-burden framing." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-026" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Single modality, but with an internal fusion of four kinematic quantities into one image: spatial path as line geometry, velocity as the red channel, acceleration as green and jerk as blue. This packs position and its first three temporal derivatives into a single representation that a generic image classifier can consume - an elegant encoding, though the subsequent grayscale conversion collapses the three colour channels back into a single luminance value, discarding the channel separation the encoding created." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-026" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Reported only at whole-sample level: 59 children, 38 male (64%) and 21 female (36%), mean age 7.88 years and median 8.1 years, with age and CARS distributions shown as box plots. No per-group age means, standard deviations, ranges or sex breakdowns are given, and no matching procedure or comparability test is reported. This makes it impossible to assess whether the ASD and non-ASD groups differ in age or sex - a material gap since gaze behaviour changes markedly across childhood. The sample is school-aged (around 8 years), so despite the paper's early-detection framing it does not test the youngest ages." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-026" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Supervised learning, with the problem deliberately recast as image classification. Conventional baselines (Naive Bayes, logistic regression, SVM, random forests) are compared against feed-forward artificial neural networks of increasing capacity (single layer with 50, 200 or 500 neurons; two layers of 80 and 40), trained with 100 epochs and 20% dropout. PCA provides unsupervised dimensionality reduction. Notably no convolutional architecture is used despite the image framing, since PCA-compressed grayscale vectors are fed to fully connected layers." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-026" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A two-stage engineered-then-learned representation: scanpaths are first rendered into RGB images encoding position and its derivatives via colour gradients, then compressed by rescaling to 100x100, grayscale conversion, and PCA from 10,000 dimensions to 50 components. The classifier therefore operates on a 50-dimensional linear projection of a grayscale rendering rather than on the image directly, which is a significant loss of the spatial structure the rendering was designed to create." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-026" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Author keywords: Autism Spectrum Disorder, Machine Learning, Eye-tracking, Scanpath. Task vocabulary: 'assistive tools to support the diagnosis process', 'learn the eye-tracking patterns of ASD', 'visual representation', 'image classification task', 'second opinion that is considered to be less biased and reproducible'. The framing of machine learning as a less biased second opinion is a recurring justification in the corpus." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-026" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "This is the study's weakest dimension. Ten-fold cross-validation is reported with AUC standard deviations, and dropout and augmentation are used as regularisers, but the fundamental question of what constitutes a fold is never addressed: 547 images derive from 59 children and 2,735 further synthetic images derive from those 547, so unless partitioning is by participant - which is never stated - the test folds contain images from children whose other images, and augmented copies of whose images, were used in training. Augmentation performed before rather than within the fold split compounds this. There is no external validation, no held-out site, no participant-level reporting, no class-imbalance treatment (328 non-ASD vs 219 ASD images), and no permutation or significance testing. The deployed web application demonstrates practical delivery but not validity." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-026" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "Single session; average eye-tracking experiment duration approximately 5 minutes per participant across multiple video scenarios of varying length" ;
                    slr:study_design "Cross-sectional case-control classification study, with the unit of analysis being the scanpath image rather than the participant" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: 29; comparison: 30" ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "Binary classification: conventional models approximately AUC 0.70; all neural networks above 0.90, with the single-layer 200-neuron model best at approximately 0.92. Multi-label severity classification (non-ASD, low, mild, severe): approximately 83% for the single-layer model and 81% for the two-layer model, with the confusion matrix showing non-ASD discriminated well and ASD labels at least 20% l",
                        "Rendering eye-tracking scanpaths as colour-coded images that encode velocity, acceleration and jerk allowed ASD prediction to be treated as an image classification problem, reaching AUC above 0.90 with a single-layer neural network - substantially better than conventional classifiers on the same data (AUC approximately 0.70). Model complexity beyond a single hidden layer gave no improvement. A fin" ;
                    slr:outcome "AUC with standard deviation across folds, ROC curves for all architectures, and a normalised confusion matrix for the multi-label severity model" ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "Binary classification: conventional models approximately AUC 0.70; all neural networks above 0.90, with the single-layer 200-neuron model best at approximately 0.92. Multi-label severity classification (non-ASD, low, mild, severe): approximately 83% for the single-layer model and 81% for the two-layer model, with the confusion matrix showing non-ASD discriminated well and ASD labels at least 20% l; Rendering eye-tracking scanpaths as colour-coded images that encode velocity, acceleration and jerk allowed ASD prediction to be treated as an image classification problem, reaching AUC above 0.90 with a single-layer neural network - substantially better than conventional classifiers on the same data (AUC approximately 0.70). Model complexity beyond a single hidden layer gave no improvement. A fin" ] ] ;
