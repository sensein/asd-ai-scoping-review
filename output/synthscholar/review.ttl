    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "15 preschool children with no ages, no genders (explicitly not considered) and no recruitment description; the ASD group were all in daily intervention and trained on similar tasks, which the authors themselves identify as making their behaviour atypical of an undiagnosed screening population." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Observation probabilities were elicited from a clinician survey rather than estimated from data, the confidence-scaling parameter was tuned by judgement until belief values looked 'more appropriate', a human operator supplied critical observations in real time, and no held-out evaluation of any kind was performed." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Not all children completed all tasks, four sessions ended in robot failure with children unwilling to continue, and three sessions were judged too short for assessment - but no per-child completion table is given and the resulting attrition is not accounted for systematically." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "No diagnostic instrument is reported for either group; the comparator is a post-hoc expert judgement of behaviour from transcripts, adopted precisely because the authors found behaviour and diagnosis diverged in their sample." ] ;
            slr:overall_judgment "high" ;
            slr:tool_used "QUADAS-2" ] .

<urn:slr:article:b4a900945ede> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Educators face challenges in accommodating children with Autism Spectrum Disorder (ASD), particularly those without a deﬁnitive clinical diagnosis. Full-day schools provide a convenient setting to implement ASD screening techniques. Children diagnosed with ASD can receive customized interventions, allowing educators to customize teaching to individual needs and promote inclusive education. However, screening methods must seamlessly integrate into the educational environment, ensuring they are noninvasive and engaging. This study proposes a Serious Game (SG) tablet application that combines user requirements for inclusive design with Machine Learning (ML) techniques for screening analysis, oﬀering a playful tool for ASD screening. This tablet application includes three classical games designed to analyze executive functions (EF) in children. We recruited three inclusive education teachers to supervise 12 children aged between 3 and 6 years old, including 6 with ASD and 6 typically developing children. The teachers also facilitated the children’s use of our tablet application. Over three months, children completed 640 game matches, and preprocessing these matches resulted in a comprehensive dataset. We compared seven well-known and commonly used ML approaches: Random Forest (RF), Multilayer Perceptron (MLP), K-Nearest Neighbor (KNN), Logistic Regression (LR), Deep Learning (DL), Support Vector Machine (SVM), and Naive Bayes (NB). According to our results, the RF model performed best with an accuracy of 96 %. Our study sheds light on the integration of playful approaches based on SG and ML techniques in educational environments, laying the groundwork for future research and practical applications to screen for suspected ASD among children in school settings." ;
    dcterms:bibliographicCitation "Martins SRAL; Souza FAD; Teixeira LC; Leal BRA; Silva DMPF; Silva CMRD (2026). Towards screening of children students with autism spectrum disorder based on executive functions with serious game and machine learning approaches. **." ;
    dcterms:creator "Leal BRA",
        "Martins SRAL",
        "Silva CMRD",
        "Silva DMPF",
        "Souza FAD",
        "Teixeira LC" ;
    dcterms:title "Towards screening of children students with autism spectrum disorder based on executive functions with serious game and machine learning approaches" ;
    bibo:pmid "local_b26db2f2" ;
    fabio:hasPublicationYear 2026 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Data source and eligibility described" ;
                            slr:justification "Inclusion and exclusion criteria enumerated and justified for both children and supervising professionals, with three participant profiles defined and the scope restriction stated." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Participants appropriate to the question" ;
                            slr:justification "Clinically diagnosed and non-diagnosed children matched across age bands in the setting where the tool would be used, but only 12 in total and with sex composition unreported." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Sample size justified" ;
                            slr:justification "No justification; 12 children yield 640 analysis rows, and the small sample is named as a major constraint by the authors." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Model development guarded against optimism" ;
                            slr:justification "Grid search with 5-fold cross-validation, full search space and selected values published for all seven models, and learning curves inspected per model." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Predictors defined and measured appropriately" ;
                            slr:justification "Session-level telemetry from a purpose-built executive-function battery grounded in the autism executive-dysfunction literature, with data fields tabulated by type and example." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Predictors independent of the outcome" ;
                            slr:justification "Game performance is independent of diagnosis; the guardian anamnesis questionnaire was collected but not used as a predictor." ;
                            slr:rating "Low" ] ;
                    slr:overall_concern "low" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Outcome determined independently of predictors" ;
                            slr:justification "Diagnosis predates the game sessions and is unrelated to the telemetry." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Outcome definition and ascertainment" ;
                            slr:justification "Clinical diagnosis used as an inclusion criterion with no procedure, instrument or assessor described." ;
                            slr:rating "Unclear" ] ;
                    slr:overall_concern "unclear" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Limitations and overinterpretation" ;
                            slr:justification "Six named threats including sample size, convenience sampling, scope restriction, overfitting risk, absence of longitudinal data, and the ethics of school-based screening with stigmatisation risk; claims bounded to screening rather than diagnosis." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Interpretation of validation evidence" ;
                            slr:justification "High validation accuracy is read as strong generalization capability, and the paper states that high accuracy and robust metrics reinforce the low likelihood of overfitting - inverting the inference under session-level splitting." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Analysis unit matches the clinical claim" ;
                            slr:justification "Claims concern screening children; every metric is computed over game sessions at roughly 53 per child." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Validation design guards against optimism" ;
                            slr:justification "Session-level partitioning and 5-fold cross-validation with no participant grouping, on 12 children - leave-one-child-out was available and unused." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Performance measures adequate" ;
                            slr:justification "Accuracy, precision, recall and F1 for seven models with learning curves, but no confidence intervals, no fold variance, no chance level, and no relation of the figure to 12 children." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. Comorbidity and severity are handled by exclusion rather than measurement: three participant profiles are defined - ASD alone, ASD with co-occurring disorders, and children whose disabilities would impair application use - and the scope is restricted to signs of ASD exclusively, with each exclusion criterion enumerated and justified. That is transparent design, and it also means the sample excludes the children for whom screening decisions are hardest." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-170" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "High on artefacts. Code and dataset are publicly deposited on GitHub with replication named as the explicit purpose - the second study in the charted corpus to release working code. The full hyperparameter grid and selected values are tabulated for all seven models; the collected data fields are listed with types and example values; inclusion and exclusion criteria are enumerated for both children and professionals; the consent procedure is described at both levels; and the game design and its executive-function rationale are documented through a methodology flowchart. Missing: an ethics committee reference, sex composition, a random seed, software versions, and - most consequentially - any statement of how the 640 sessions were assigned to the training, testing and validation partitions." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-170" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The design is careful everywhere except the one place that determines the answer. Careful: three months of primary collection in the real deployment setting; age-matched groups organised into bands; enumerated inclusion and exclusion criteria for children and professionals; guardian and professional consent; a purpose-built task grounded in the executive-function literature; grid search with 5-fold cross-validation and the full search space published; seven algorithms under one protocol; learning curves inspected per model; code and data deposited; and a six-item threats section including the ethics of school-based screening. Decisive: the analysis unit is the game session. Six hundred and forty sessions from 12 children give roughly 53 sessions per child, and the partition into 20% validation and an 80/70/30 training-testing split - together with 5-fold cross-validation - is performed over sessions with no participant grouping described. Every fold therefore contains sessions from the same children as its training data, played on the same device in the same room with the same supervising professional, so a classifier can reach 96% by recognising individual children rather than autism. With six children per class, no session-level partition can produce a participant-level estimate. Two further points compound this. The learning curves showing high training and validation accuracy are read as suggesting a strong generalization capability, and the paper states elsewhere that the high accuracy observed in the models and the robust metrics reinforce the low likelihood of overfitting - inverting the inference, since under session-level splitting high validation accuracy is what leakage produces. And no feature importance is reported, so there is no evidence about what the 96% is built on. The remedy was available and cheap: with 12 children, leave-one-child-out validation would have given twelve honest folds." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-170" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Accuracy, precision, recall and F1 for all seven models, plus learning curves plotting training and cross-validation accuracy against training-set size. The learning curves are read carefully - training accuracy above validation accuracy is correctly described as expected, and the absence of an abrupt decline is noted - but the reading stops short of asking why validation accuracy is so high at all. No confidence interval, no fold variance and no chance level appears; and the 96% is not related to the effective sample of 12 children." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-170" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "ASD, autism spectrum disorder, children with ASD, typically developing children, atypical and typical children, neurotypicals. The register is educational rather than clinical and the orientation is inclusive - the stated purpose is to let educators tailor teaching to individual needs and promote inclusive education, and the discussion warns against stigmatisation. One phrase dates the framing (ASD as a neuropsychiatric disorder), and the keyword list begins with Phishing, an artefact from an unrelated manuscript." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-170" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Clinical diagnosis is an inclusion criterion - children with a diagnosis form the ASD group and children without form the control group - but the diagnosing procedure, instrument and assessor are not described. The framing is honest about why this matters in context: the study's motivating problem is that a significant number of children with ASD in Brazilian early and primary education remain without an appropriate clinical diagnosis, which leaves educators without information to tailor teaching. The tool is proposed for exactly those undiagnosed children, and is trained on children whose diagnostic status is already known." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-170" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2026. The framing is the most appropriately bounded in the primary-data group: the tool is offered as laying the groundwork for future research and practical applications to screen for suspected ASD among children in school settings, and the discussion states explicitly that screening should be understood as an initial support for identifying warning signs and guiding the search for specialised clinical evaluation, not as a definitive diagnosis, with professional training required to reduce misinterpretation and the risk of stigmatisation named. Its contribution to this review is a study that gets almost everything right about design, ethics, transparency and scope - primary collection in the real setting, matched groups, published code and data, a full hyperparameter grid, enumerated criteria, dual consent, and an unprompted discussion of screening ethics - and then reports a 96% that its own validation design cannot support, because 640 game sessions from 12 children were split by session rather than by child." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-170" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Three classical games on a tablet, purpose-designed around executive functions - planning, cognitive flexibility, inhibitory control, working memory and performance monitoring - with the theoretical grounding cited to Pennington and Ozonoff and to Hill. The paradigm is genuinely constructed for the question rather than repurposed, and the games' accessibility and usability requirements were derived from a prior review stage documented in the methodology flowchart." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-170" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Seven algorithms under a single protocol - random forest, MLP, deep MLP, KNN, logistic regression, SVM and naive Bayes - with the full grid search published. The comparison is genuinely controlled and the spread it produces (96% down to 82% and lower) is informative in itself." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-170" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A tablet running the study's own serious-game application. Modelling used seven standard algorithms with grid-searched hyperparameters; no software, version, seed or compute environment is named." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-170" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. Random forest was the best model and supplies feature importances at no cost, and none is reported. The study's entire justification is that specific executive functions are impaired in autism and that a game can measure them, so the identification of which game-derived variables carried the signal was both available and central - and it is absent." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-170" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No modality fusion - game telemetry alone. The behavioural anamnesis questionnaire completed by guardians is collected and not used as a predictor, which keeps the model's inputs clean of parent-report information but also leaves an available modality unexploited." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-170" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "One row per game session, with fields covering session duration in seconds, game identity and task-performance variables, tabulated with data types and examples. The row is a session, not a child, and the paper does not remark on the distinction anywhere." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-170" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Longitudinal protocols with additional collections at different time points to assess response stability and tool robustness; larger and more diverse samples to address the convenience-sampling limitation; and training for education professionals as a condition of deployment. Each addresses a stated threat." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-170" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Phishing; ASD screening; Machine learning; Serious game. The first keyword belongs to an unrelated manuscript and survives in the published article." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-170" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A specialised educational service setting within Brazilian full-day schools, with the games administered by a trained education professional during the child's normal activities and guardians not present. This is the only study in the charted corpus whose data were collected in the setting where the resulting tool would actually be used, and the choice is argued: full-day schools provide a convenient setting, the professional's existing daily relationship with the children was leveraged, and the application was incorporated into planned educational demands." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-170" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "One of the fullest threats-to-validity sections in the corpus, with six distinct items: small sample size as a major constraint on generalisation given the variability among individuals with ASD; convenience sampling as a source of selection bias restricting profile diversity and compromising external validity; the restriction of scope to ASD signs alone, with each exclusion criterion enumerated and justified; overfitting risk from the reduced sample; the absence of longitudinal data, with repeated collections recommended; and the ethical implications of school-based screening including stigmatisation risk. The one thing not identified is the thing that governs the result: that 640 sessions come from 12 children and are partitioned by session. The paper instead argues in the opposite direction, stating that the high accuracy observed in the models and the robust metrics reinforce the low likelihood of overfitting - which reads a symptom as reassurance." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-170" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional analysis of three months of collection. Consent is documented at both levels - guardians signed an Informed Consent Form as the precondition for each child's participation, and the administering professional signed a Free and Informed Consent Form after training - though no ethics committee reference appears in the extracted text. The paper also contains an ethical discussion that no other study in this corpus offers: it states that the ethical implications of early screening in educational settings must be considered, including the risk of stigmatisation and the responsible use of the generated information; that screening should be understood as an initial support for identifying warning signs and guiding the search for specialised clinical evaluation, not as a definitive diagnosis; and that use of the tool should be accompanied by appropriate training for education professionals to reduce misinterpretations and promote an inclusive and respectful approach to differences. For a tool intended to be operated by teachers on undiagnosed children, that is the right set of concerns and it is stated without prompting." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-170" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The stated goal is a serious-game tablet application combining inclusive-design requirements with machine learning, to give educators a playful, non-invasive ASD screening aid usable inside the school day. Headline findings: random forest reached 96% accuracy, MLP, deep MLP and SVM 94%, KNN 90%, logistic regression 82% and naive Bayes lower, with learning curves showing training accuracy above validation accuracy and no abrupt decline." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-170" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Expert Systems With Applications 295 (2026) 128884 (Elsevier) - an applied AI journal. Review did not surface that 640 analysis rows come from 12 children with no participant-level partitioning, nor the Phishing keyword." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-170" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Age is reported and controlled by design - children were organised into groups G3, G4 and G5 by age, and the ASD and control groups were matched across those bands specifically to make the samples more homogeneous. Sex is not reported. Nothing on socioeconomic status or ethnicity, though the school-based recruitment in a Brazilian public inclusive-education setting is described. Guardians completed a behavioural anamnesis questionnaire whose contents are not reported." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-170" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Twelve children aged 3-6 years - six with a clinical ASD diagnosis and six without, matched across the same age bands - who together completed 640 game sessions over three months in their own school setting. The recruitment structure is documented in unusual detail: three inclusive-education professionals were recruited with stated inclusion and exclusion criteria, trained on the tool, and supervised the children's use of it, with guardians absent during play. The gap between the number of children and the number of analysis rows is the study's decisive feature: 640 sessions from 12 children is roughly 53 per child, and the dataset is partitioned by session rather than by child." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-170" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Executive function as elicited by three purpose-built games - planning, cognitive flexibility, inhibitory control, working memory and performance monitoring - captured through session-level telemetry including duration and task-performance fields. This is behaviour observed during a designed task rather than reported on a checklist or inferred from an appearance, and the construct is theoretically motivated rather than chosen for convenience. What the paper does not do is say which behaviours distinguished the groups: no feature importance is reported, so the executive-function framing that justifies the whole design is never connected to a result." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-170" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "Seven algorithms under identical grid search and cross-validation, with learning curves plotted for each." ;
                    slr:study_design "Prospective primary data collection in an inclusive-education setting followed by supervised binary classification of game-session telemetry, with grid-searched hyperparameters and…" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: 6 children with a clinical ASD diagnosis, three in the 3-4 year band and three in the 5-6 year band.; comparison: 6 children without an ASD diagnosis, matched on the same age distribution, serving as the control group." ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "Random forest 96% accuracy; MLP, deep MLP and SVM 94%; KNN 90%; logistic regression 82%; naive Bayes lower still." ;
                    slr:outcome "Accuracy, precision, recall and F1 for each of the seven models, plus learning curves showing training and cross-validation accuracy against training-set size." ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "Random forest 96% accuracy; MLP, deep MLP and SVM 94%; KNN 90%; logistic regression 82%; naive Bayes lower still." ] ] ;
