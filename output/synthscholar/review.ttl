            slr:relevance_score "0.9"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "Even though the current results are encouraging, there is space for further improvement by focusing on more in-depth exploration of kinematic and kinetic gait parameters. Evaluation on a large dataset still need to be further extended to confirm the current observations." ] ;
