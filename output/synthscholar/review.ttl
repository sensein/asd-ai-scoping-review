    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Approximately 7,000 recordings reduced to 1,017 with retention below one third and no breakdown by group; the mapping from recordings to children is never stated; and the selection of 511 and 506 recordings is described only as random." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "No diagnostic instrument, criterion, clinician role or setting reported anywhere; comparison-group status asserted without screening." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "A single 80:20 split over recordings rather than children, with roughly six utterances per child distributed across both sides; no cross-validation of the classifier, no repetition, no confidence intervals; Method 2's figure is the maximum over 256 frequency sequences; and the two-channel configuration underpinning the feature construction is never described." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "No ages, sexes, cognitive, language or severity data for either group; participant counts given only as 'more than 80' and 'more than 60'; and less than a third of recordings were usable with the loss driven by autistic children's pronunciation difficulty, so the analysed sample is the more verbally able subset." ] ;
            slr:overall_judgment "high" ;
            slr:tool_used "QUADAS-2" ] .

<urn:slr:article:dac3e7a03f26> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "A timely diagnosis of autism is paramount to allow early therapeutic intervention in preschoolers. Deep Learning tools have been increasingly used to identify specific autistic symptoms. But they also offer opportunities for broad automated detection of autism at an early age. Here, we leverage a multi-modal approach by combining two neural networks trained on video and audio features of semi-standardized social interactions in a sample of 160 children aged 1 to 5 years old. Our ensemble model performs with an accuracy of 82.5% (F1 score: 0.816, Precision: 0.775, Recall: 0.861) for screening Autism Spectrum Disorders (ASD). Additional combinations of our model were developed to achieve higher specificity (92.5%, i.e., few false negatives) or sensitivity (90%, i.e. few false positives). Finally, we found a relationship between the neural network modalities and specific audio versus video ASD characteristics, bringing evidence that our neural network implementation was effective in taking into account different features that are currently standardized under the gold standard ASD assessment." ;
    dcterms:bibliographicCitation "Natraj S; Kojovic N; Maillart T; Schaer M (2024). Video-audio neural network ensemble for comprehensive screening of autism spectrum disorder in young children. *PLOS ONE, 19(10), Article e0308388*." ;
    dcterms:creator "Kojovic N",
        "Maillart T",
        "Natraj S",
        "Schaer M" ;
    dcterms:title "Video-audio neural network ensemble for comprehensive screening of autism spectrum disorder in young children" ;
    bibo:pmid "local_7d7f1fcc" ;
    fabio:hasPublicationYear 2024 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Handling of missing data and attrition" ;
                            slr:justification "All 160 children contributed recordings and appear in the analysis; segment counts and total durations are reported for both partitions and both modalities. No losses reported. The 90% video-segment confidence filter is a post-hoc output selection whose effect on aggregate accuracy is not quantified." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Comparison group adequacy" ;
                            slr:justification "Typically developing children matched on age and sex and assessed with the same ADOS protocol in the same setting - a better-matched comparison than any other included study on recording context. But no non-autistic clinical comparison group, so the harder discrimination is untested." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Confounder control" ;
                            slr:justification "Sex matched exactly at 48 male and 32 female per group; age matched; the train-test split additionally matched on age, sex and ADOS module. Cognitive and language data are deferred to supplementary material rather than reported, and no sex-stratified analysis is run despite the sample uniquely supporting one." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Participant selection and spectrum representativeness" ;
                            slr:justification "Consecutive enrolment in an established longitudinal autism cohort over eleven years, ages 1.1-5.1 with no severity threshold applied, and a comparison group actively screened for neurological and psychiatric conditions and for first-degree family history." ;
                            slr:rating "Low" ] ;
                    slr:overall_concern "low" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Outcome measurement blinding" ;
                            slr:justification "Classification is fully automated from pose and audio with no human rater at inference; the interpretability analysis uses independently coded ADOS items." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Index test definition and prespecification" ;
                            slr:justification "Both architectures, segment lengths, aggregation rules and the three ensemble strategies are fully specified, with all tuning decisions confined to the training half's validation split. The decision tree's 60% threshold is reported explicitly." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Reference standard quality" ;
                            slr:justification "DSM-5 clinical criteria supported by gold-standard assessment in a clinical research cohort - substantively strong. But instruments are deferred to supplementary material, and independence from the ADOS recordings used as model input is not established." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Measurement standardisation" ;
                            slr:justification "Identical ADOS protocol and setting for both groups, audio normalised across microphones to a common format, video normalised to fixed-resolution skeletal renderings. Equipment varied across an eleven-year window but not by group." ;
                            slr:rating "Low" ] ;
                    slr:overall_concern "unclear" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Sample size adequacy for the modelling" ;
                            slr:justification "Deep networks trained on 80 children and evaluated on 80. Segment counts are large but the effective sample is the participant count, and the ensemble's advantage over video alone corresponds to two test children." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Preprocessing and feature selection nesting" ;
                            slr:justification "Segment lengths, MFCC count, batch size and epoch count all selected on the training half's validation partition, with the direction of observed overfitting reported. Test participants untouched throughout." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Performance estimation and chance level" ;
                            slr:justification "Complete six-metric table for all five model variants on a balanced test set, so chance is 50% and both operating extremes are reported. But no confidence intervals on 80 children, no positive predictive value at realistic prevalence in a paper framed around screening, and the abstract transposes precision with recall and specificity with sensitivity." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Data splitting and leakage control" ;
                            slr:justification "Participant-level 50-50 split with each half matched on age, sex and ADOS module; segments nested strictly within participants so no within-participant leakage is possible despite tens of thousands of clips; validation carved from the training half only." ;
                            slr:rating "Low" ] ;
                    slr:overall_concern "unclear" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Completeness of methods reporting" ;
                            slr:justification "Cohort, window, demographics, matching variables for groups and split, segment lengths with their empirical basis, audio normalisation and rationale, all acoustic features, complete architectures with layer sizes, dropout, optimiser, batch size and epochs, aggregation and filtering rules, all three ensemble strategies, and the full interpretability procedure with three importance metrics and a cross-modality normalisation model." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Ethics, consent and conflicts" ;
                            slr:justification "University of Geneva Faculty of Medicine ethics approval, written parental consent for all children, and separate specific consent from the depicted child, their guardian and the examiner for publication of identifying images - a level of consent detail no other included study reports. Six funding sources itemised with grant numbers and a no-role statement; no competing interests." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Reporting of results and uncertainty" ;
                            slr:justification "Six metrics for all five models in one table, including negative predictive value, and every ensemble variant presented rather than only the best. But no confidence intervals anywhere, and two transposition errors in the abstract that the results table does not share." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Acknowledgement of limitations" ;
                            slr:justification "The ensemble's failure to beat the individual modalities is named directly, and two more consequential interpretive cautions are volunteered in the discussion - that ambient non-vocal sound may have driven the audio classification, and that the examiner's prosody adapts to child severity so the model may be reading the adult. The reference-standard circularity, the absent confidence intervals and the absent predictive values are not addressed." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Data, code and protocol availability" ;
                            slr:justification "Training code for both networks on GitHub; a de-identified pose-estimation subsample on Zenodo with a DOI; raw recordings withheld with a correct and specific reason. A considered middle position that the study's own skeletal representation made possible." ;
                            slr:rating "Low" ] ;
                    slr:overall_concern "low" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Among the soundest validation designs in the review, with two residual issues that bound rather than undermine it. The 160 children were split 50-50 into training and test halves of 80, each containing 40 autistic and 40 typically developing children matched for age, sex and ADOS module - so the held-out half is not merely participant-disjoint but constructed to be comparable to the training half on the three variables most likely to drive an artefactual result. That is stronger than a random split and stronger than anything else charted here. Within the training half, 80% trained and 20% validated, and every hyperparameter decision - segment length for both modalities, MFCC count, batch size, epoch count - was made on that validation set with the test children untouched; the authors even report the direction of the failures they observed while tuning, noting that larger batch sizes and epoch counts increased validation loss. Segments are nested strictly within participants, so although tens of thousands of 5- and 10-second clips were generated, none of the within-participant leakage that dominates the image and frame-level branches of this corpus is possible. The reported figures are computed on 80 children. The first residual issue is statistical: 80 test children is small, one case is worth 1.25 accuracy points, no confidence intervals are given, and an exact interval around 82.5% would run from roughly 72% to 90% - so the ensemble's 2.5-point advantage over the video model, two children, cannot be distinguished from noise, and the paper's framing of the ensemble as the best model rests on a difference the data cannot resolve. The second is the reference-standard circularity discussed above: the diagnosis was supported by 'gold standard diagnostic assessments' and the model input is the ADOS session, so unless the diagnostic ADOS was a different session from the recorded one, the label is not independent of the material. The severity of this is limited - the model receives raw pose and undiarised audio rather than coded items, so it must recover from signal what a clinician judged, which is a genuine inference rather than a lookup - but it is not zero, and a single sentence stating whether ADOS entered the diagnostic decision would settle it. Set against these, the design's positive features are substantial: matched recording context across classes, appearance stripped from the video representation by construction, participant-level matched splitting, tuning confined to a validation partition, a complete metric table for every model variant, and an interpretability analysis that identifies a plausible confound in the authors' own audio channel. The reported 78.8% to 82.5% is one of the more trustworthy performance figures in this review." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-128" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The most substantive interpretability work in the review, and the only instance of a study explaining its models in the vocabulary of the clinical construct rather than in the vocabulary of the input. Random regression forests were fitted with all 27 ADOS-2 items as predictors and each network's prediction confidence as the outcome; importance was assessed through three metrics simultaneously - percentage increase in mean squared error, increase in node purity, and p-value - and a third normalising forest was calibrated on the averaged confidence of both networks so that importances from the two separate models could be placed on a common scale and compared. The design of this analysis is careful in a way that saliency maps elsewhere in this corpus are not, because it produces claims that can be checked against clinical knowledge. The video result is coherent and expected: joint attention initiation, quality of social overtures, unusual eye contact and pointing gestures, a nonverbal social-communication cluster that a model of dyadic body motion should be sensitive to. The audio result is coherent and unexpected: showing behaviour, pointing gesture, unusual sensory exploration and hand mannerisms, none of which is a vocal construct. The authors follow this where it leads rather than around it, proposing that non-vocal ambient sound from object manipulation drove part of the classification and noting that sensory interests was the single most correlated item, and separately raising the possibility that the examiner's prosodic adaptation to the child contributes. An analysis that tells the authors their audio model is probably not listening to speech, reported as such, is worth more to this review than any number of attention heatmaps." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-128" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Published October 2024 by the Psychiatry Department of the Faculty of Medicine at the University of Geneva with the Geneva School of Economics and Management, funded through a Swiss National Science Foundation Sinergia grant for digital phenotyping of autism, NCCR Synapsy, two further SNSF grants, the Private Foundation of the HUG, a university equipment grant and Fondation Pole Autisme. The framing is clinical and the argument for automation is stated without disparaging existing practice: the gold-standard diagnostic procedure is credited as 'the product of convergent clinical and research work over the past four decades', existing screening questionnaires are described as 'highly valuable' while varying in validity and replicability, and the gap identified is the years-long latency between first observable signs and diagnosis. For this review the study is one of the most useful included, for four reasons that are largely independent of its accuracy. Its recording context is matched across classes - both groups assessed with the same protocol in the same setting - which removes at a stroke the acquisition confound that this synthesis has had to record against the photograph, video-frame and clinic-versus-school audio studies. Its video representation strips appearance by construction, rendering pose as skeleton-on-black, so identity and setting cannot contribute to the classification; that is a designed answer to the confound rather than an assertion that none exists, and it also made partial data sharing possible. Its splitting is participant-level and matched on age, sex and ADOS module, with tuning confined to a validation partition carved from the training half. And its interpretability analysis, which regresses model confidence on all 27 ADOS items across both modalities with a normalisation model to make them comparable, produces the review's clearest demonstration that a modality label does not determine the construct measured: the audio model's most predictive items are showing, pointing, sensory exploration and hand mannerisms rather than anything vocal, and the authors conclude in their own voice that ambient non-vocal sound from object manipulation, and possibly the examiner's prosodic adaptation to the child, contributed to what they had labelled a speech-based classifier. That finding generalises to every study in this corpus using undiarised interaction audio. The performance itself - 80.0% video, 78.8% audio, 82.5% ensemble, on 80 held-out children - is modest, honestly reported, and roughly what one should expect from an unconfounded design, which is itself the most useful calibration this review can offer against the 95-100% figures reported elsewhere. Two cautions travel with it: no confidence intervals on an 80-child test set, where the ensemble's advantage over video alone is two children and cannot be distinguished from noise; and no statement of whether the ADOS sessions used as model input contributed to the diagnoses used as labels, which would take one sentence to resolve." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-128" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The classification analysis is cross-sectional, but the participants are drawn from a longitudinal cohort explicitly established to study early development in autism, and the recruitment window spans eleven years - the longest in this review. No longitudinal modelling or follow-up outcome is reported here. Ethics reporting is complete and in one respect exceeds every other included study: approval by the Ethics Committee of the Faculty of Medicine at the University of Geneva; written informed consent from a parent or legal guardian for all children; and separately, specific consent obtained from the child depicted in a figure, from their legal guardian and from the examiner for publication of identifying images in an open-access article. That last item is a detail no other paper here reports, and it stands in sharp contrast to the studies charted nearby that train on identifiable photographs of children scraped from support pages without any ethics statement at all. Six funding sources are itemised with grant numbers and a no-role statement, and competing interests are declared as none." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-128" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "One limitation is formally stated - that the simple ensemble could not outperform the individual modalities - and two more consequential ones are volunteered in the discussion without being labelled as such. The authors propose that 'peculiar non-vocal acoustic features (i.e., ambient sound), such as any repetitive sound that would reflect an increased need for sensory stimulation in autistic children (e.g., repeatedly dropping objects or banging them, or perseverating on a musical toy)' contributed to the audio classification, supporting this with their own finding that sensory interests was the ADOS item most correlated with audio-based prediction. And they note prior work showing that examiners attune their prosody to a child's symptom severity, in which 'the psychologist's prosodic cues better predicted the child's autistic symptom severity than the prosody of the child himself' - so a full-band audio model trained on undiarised recordings may be reading the adult's behaviour as much as the child's. Volunteering both is unusual and valuable. What is not addressed: the probable circularity between the ADOS-supported diagnosis and the ADOS-derived model input, which one sentence about whether ADOS entered the diagnostic decision would resolve; the absence of confidence intervals on an 80-child test set, where an exact interval around 82.5% spans roughly 72% to 90% and where the ensemble's 2.5-point advantage over video alone amounts to two children; the absence of any positive predictive value at realistic prevalence in a paper framed around screening, where specificity of 0.875 would place most positive calls on non-autistic children at a population base rate; the unquantified effect of the 90% segment-confidence filter; the eleven-year window across which equipment, personnel and diagnostic practice all changed; the absence of a sex-stratified analysis despite a sample uniquely suited to one; and the restriction of the comparison group to typically developing children, leaving the harder discrimination against other developmental conditions untested." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-128" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Clinical research assessment sessions in the Geneva Autism Cohort, with both groups undergoing the same ADOS protocol in the same setting. This is the single most important design property of the study for the purposes of this synthesis. Across the video, audio and photograph branches charted here, the recurring failure is that the two classes are recorded under systematically different conditions - clinic against school, autism-advocacy websites against general internet, home videos of stereotypy against kindergarten footage - so that acquisition context is a perfect proxy for the label and no amount of downstream methodological care can separate them. Here the context is common to both classes by construction: same room, same protocol, same examiner role, same equipment. Whatever the models are detecting, it is not the difference between being in a clinic and being at school. The residual acquisition concern is temporal rather than group-related: recordings span eleven years, and audio was explicitly normalised 'to homogenize the audio format from different microphones used for ADOS recordings', so equipment changed over that period - but there is no reason to expect equipment drift to align with diagnosis." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-128" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two behavioural channels selected to be complementary, and the study's own analysis of what each captures is the most informative such account in the review. The video channel targets whole-body movement and gestural interaction within the child-examiner dyad, and its confidence relates most strongly to initiation of joint attention, quality of social overtures, unusual eye contact and pointing gestures - a coherent nonverbal social-communication cluster, and exactly what one would predict for a model of interactive body motion. The audio channel targets the full acoustic band without diarisation, so it contains child vocalisation, examiner speech and ambient sound from object manipulation - and its confidence relates most strongly to showing behaviour, pointing gesture, unusual sensory exploration and hand mannerisms, which are not vocal constructs at all. The authors draw the correct inference: the audio model is probably keying substantially on non-vocal sound produced by the child's interaction with objects, with sensory interests the single most correlated item, and possibly also on the examiner's prosodic adaptation to the child. This is a rare and important result for the review. It shows that a modality label ('audio') does not determine the construct measured, that a model can succeed by detecting the acoustic signature of behaviour rather than of speech, and that when a recording captures a dyad the model may be measuring the wrong member of it. Any study in this corpus using undiarised interaction audio inherits both possibilities, and none of the others examines them." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-128" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two architectures matched to their data. For video, an ImageNet-pretrained VGG16 with its dense layers removed extracts per-frame features from 5-second segments, feeding a 512-unit LSTM, then 512 fully connected ReLU units and a softmax; segment predictions are filtered at 90% confidence and averaged across the session, with the child classified autistic if the mean exceeds 0.5. For audio, five Librosa feature families averaged along the time axis into a one-dimensional vector feed two 1D convolutional layers, max pooling, a third convolutional layer, dropout 0.5, flattening, 512 dense units and a softmax, trained with categorical cross-entropy and Adam at batch size 512 for 30 epochs. Both are conventional and appropriately sized for 160 children; the authors report that larger batch sizes and epoch counts increased validation loss, which indicates that capacity was actively constrained rather than maximised. Fusion is by simple rules rather than a learned combiner - which is both why it underperforms and why the authors identify better fusion as the obvious next step." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-128" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The aim is broad automated screening rather than detection of a single symptom, achieved by combining two neural networks trained on the video and audio channels of the same semi-standardised assessment, and by then asking which clinical features each modality is sensitive to. The performance findings are modest and are not oversold: video alone 80.0% accuracy on the held-out 80 children, audio alone 78.8%, and the best ensemble 82.5% with sensitivity 0.775 and specificity 0.875. Alternative combination rules trade these off - an OR rule reaching sensitivity 0.90 at specificity 0.75, an AND rule reaching specificity 0.925 at sensitivity 0.60 - and the authors present all five variants in one table rather than only the best. The fusion result is honestly negative in the accuracy sense and the authors say so, identifying 'the inability of the simple ensemble model to outperform the individual modalities' as an important limitation; what fusion does provide is complementary errors, with both networks simultaneously wrong on only 8.75% of cases, and operating-point control. The more interesting findings are interpretive. Video confidence tracks initiation of joint attention, quality of social overtures, unusual eye contact and pointing gestures - a coherent nonverbal social-communication cluster. Audio confidence tracks showing behaviour, pointing, unusual sensory exploration and hand mannerisms - which are not vocal constructs, leading the authors to propose that ambient non-vocal sound from object manipulation contributed to the audio classification, and to note prior evidence that examiners' prosody adapts to child severity such that a full-band model may partly be reading the adult. Those two admissions are the study's most valuable output for this review." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-128" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Clinically conventional and, within that idiom, careful and accurate. Autism is 'a group of neurodevelopmental disorders characterized by a wide range of symptoms across two main dimensions: social and nonsocial', and the description that follows is notably precise about heterogeneity - noting that autism 'can be present with or without cognitive and language delay, widening the breadth of clinical presentations', and that 'the heterogeneity of ASD manifestations is a major obstacle to timely diagnosis and personalized medicine'. Person-first phrasing predominates ('children with ASD', 'individuals with autism'), with 'autistic individuals' and 'individuals on the autism spectrum' appearing alongside it. Two aspects of the framing are substantively better than the corpus norm. The description of social symptoms is relational rather than located in the individual: they 'often transcend the isolated instances of behaviors and arise from specific mismatches in the dynamic between agents and their social context' - which is why the study models the child-examiner dyad rather than the child alone, and it is a conceptual position with methodological consequences. And the account of the gold-standard diagnostic procedure treats it as 'the product of convergent clinical and research work over the past four decades', crediting rather than dismissing existing clinical practice, which is a marked contrast to the framing common in the engineering venues where clinical assessment is characterised chiefly as subjective and slow. There is no neurodiversity framing and no reported involvement of autistic people in the design." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-128" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A complete confusion-matrix-derived set - accuracy, precision, recall, specificity, negative predictive value and F1 - reported for all five models in a single table, which is fuller than almost anything else in this corpus and unusual in presenting every ensemble variant rather than the best one. Reporting negative predictive value alongside precision is a further mark of care. Three gaps and two errors. No confidence intervals appear anywhere, on a test set of 80 children where a single case is worth 1.25 accuracy points and an exact binomial interval around 82.5% runs from roughly 72% to 90% - which means the ensemble's advantage over the video model alone, two children, is not distinguishable from noise. No positive predictive value at realistic prevalence is computed, although the paper is framed around screening and the balanced design makes the reported precision of 0.861 an artefact of the 1:1 construction; at a population base rate the same specificity of 0.875 would place the large majority of positive calls on non-autistic children. And the interpretive bands for what counts as good performance are not stated. The two errors are both in the abstract and neither affects the results section: the abstract describes 'higher specificity (92.5%, i.e., few false negatives) or sensitivity (90%, i.e. few false positives)', reversing the meaning of both terms, and gives the ensemble as 'Precision: 0.775, Recall: 0.861' where the table correctly has precision 0.861 and recall 0.775. Table 1 is internally consistent throughout." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-128" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Late fusion of two independently trained networks, with three combination rules compared and all results reported. The honest headline is that fusion did not improve accuracy materially: 82.5% for the confidence-gated ensemble against 80.0% for video alone and 78.8% for audio alone, a gain of two children out of eighty, and the authors name this as an important limitation rather than presenting the ensemble as a success. What fusion does deliver is two things worth recording. First, genuine error complementarity - both networks were simultaneously wrong on only 8.75% of test cases, meaning that roughly 90% of the errors made by one model were correctable in principle by the other, which is precisely the condition under which a better fusion rule should help and is the strongest argument for the authors' own proposed future work. Second, operating-point control: the OR rule yields sensitivity 0.90 at specificity 0.75 and the AND rule yields specificity 0.925 at sensitivity 0.60, so the same two models can be configured for a high-recall screening role or a high-precision confirmatory one. Presenting this as tunability rather than as a single best number is the correct framing for a screening application and is not done elsewhere in this corpus. The interpretability analysis further shows that the two modalities index partly different clinical constructs, which is the substantive justification for combining them at all." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-128" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "One hundred and sixty children aged 1.1 to 5.1 years, enrolled in the Geneva Autism Cohort between 25 September 2012 and 10 September 2023: 80 autistic children (48 male, 32 female, mean age 2.68 +/- 0.89 years) meeting DSM-5 criteria with diagnosis supported by gold-standard assessment, and 80 typically developing children (48 male, 32 female, mean age 2.46 +/- 0.98 years) screened for absence of known neurological or psychiatric conditions and for no history of autism in any first-degree relative. Three features of the sample are worth emphasising. Both groups underwent the same ADOS assessment in the same setting, so the recording context is common to both classes - which removes the setting confound that this review has documented repeatedly across the video, audio and image branches, where clinical groups are recorded in clinics and comparison groups in schools, kindergartens or on the internet. Sex is exactly matched at 48 male and 32 female per group, giving 40% girls, which is by a considerable margin the highest female representation of any included study and the only instance of deliberate exact matching on sex. And the matching extends to the analysis: the 50-50 train-test split was itself constructed so that each half contained 40 autistic and 40 typically developing children matched for age, sex and ADOS module, so the held-out set is not merely disjoint but comparable by construction. The unit of analysis is the child, with segments nested within children and never crossing the split." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-128" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "ADOS-2 item scores across all 27 items are available and are used analytically rather than descriptively, which is the study's most valuable methodological choice on this axis. Rather than reporting group means and moving on, the authors fit random regression forests with the 27 items as predictors and each network's prediction confidence as the outcome, then calibrate a third model so that the two modalities' importance estimates can be compared on a common scale. This asks - and partly answers - the question this review has repeatedly found unasked: what is the model actually responding to, expressed in clinical terms. The answer for the video model is a coherent nonverbal social-communication cluster (initiation of joint attention, quality of social overtures, unusual eye contact, pointing gestures). The answer for the audio model is not a vocal cluster at all (showing behaviour, pointing gesture, unusual sensory exploration, hand mannerisms), which the authors read as evidence that ambient non-vocal sound contributed to classification. No cognitive or adaptive severity measure is reported in the main text." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-128" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Among the strongest reproducibility records in the review, and the only one combining published code with a partial data release. Reported in full: the cohort and its eleven-year recruitment window, group sizes with age and sex, the matching variables for the groups and separately for the train-test split, the exact 50-50 participant split with 40-40 composition per half and the 80-20 internal training-validation division, segment lengths for both modalities with the empirical basis for choosing them, the audio normalisation format and its stated rationale, all five acoustic feature families and the 150-MFCC selection, complete architectures for both networks including LSTM units, dense layer sizes, dropout rate, loss function, optimiser, batch size and epoch count with the observation that larger values overfit, the segment aggregation rule and the 90% confidence filter, all three ensemble strategies including the decision tree's 60% threshold, a complete six-metric table for all five models, and the full interpretability procedure with its three importance metrics and cross-modality normalisation model. Training code for both networks is published on GitHub, and a de-identified subsample of pose-estimation videos is deposited on Zenodo with a DOI. What is unavailable is the raw recordings, and the reason given is correct - they 'contain identifiable features such as faces and voices of participants, and as such cannot be shared integrally'. Cognitive and diagnostic-instrument detail is deferred to supplementary material, and no confidence intervals are given." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-128" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Not given as a formal keyword list in the retrieved text. Terms carried through the article: deep learning, multi-modal, ensemble, screening, semi-standardised social interaction, ADOS, pose estimation, OpenPose, digital phenotyping, prosody, diarization, joint attention, social overtures, sensory interests, random regression forest. The vocabulary spans computational and clinical registers evenly, reflecting a psychiatry department doing its own engineering rather than an engineering group applying methods to a clinical dataset." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-128" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "PLOS ONE 19(10):e0308388, Research Article, open access under CC BY; received 30 April 2024, accepted 12 July 2024, published 3 October 2024. PLOS ONE's structural requirements produced the data-availability statement, funding itemisation and competing-interests declaration, and the venue's data-sharing policy is visibly what prompted the considered middle position adopted here - raw recordings withheld because they contain faces and voices, a de-identified pose subsample deposited on Zenodo with a DOI, and training code published on GitHub. That is the policy working as intended, and it is worth noting for the review that the same policy which cannot compel raw sharing of identifiable child data did elicit a genuinely useful partial release, made possible by the study's own choice of a skeletal representation." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-128" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The ADOS, a semi-structured 40-60 minute assessment comprising free play and activities modelled on everyday play, administered identically to both groups, with average session lengths of about 46 minutes in each partition. The authors set out the paradigm choice as a considered trade-off rather than a default, and their statement of it is the clearest in this review: automating social-symptom measurement has usually required 'over-standardization ... at the expense of less ecological feature presentation', whereas the ADOS activities 'are specifically designed to be representative of naturalistic interactions, with a high amount of prompts aiming at eliciting communication and reciprocal exchanges in a restricted time period'. That formulation identifies exactly what a good behavioural paradigm needs - dense elicitation of the target behaviour within a bounded time, without collapsing into a single narrow construct - and it sits usefully between the two poles this review has charted. At one pole, the 90-second free-play study demonstrated empirically that a brief sample cannot reach restricted and repetitive behaviour at all; at the other, response-to-name and screen-based paradigms deliver a clean readout of one construct. Forty-six minutes of ADOS spans the phenotype, and the interpretability analysis confirms it - the models' confidence relates to joint attention, social overtures, eye contact, pointing, showing, sensory exploration and hand mannerisms, which is most of the diagnostic space. The cost is that the paradigm requires a trained ADOS examiner, so it does not remove the expert bottleneck that motivates the field, and the authors' proposal that this could eventually move to home settings without specialised equipment is aspirational rather than demonstrated." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-128" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The video representation is the study's most important technical decision and functions as a designed confound control. Rather than modelling raw frames, the authors apply OpenPose and plot the resulting skeletal keypoints over a plain black background at 320x240, 'hence preserving a visual gist of the social interaction between the examiner and the child'. This removes face, expression, clothing, body habitus, skin tone, room, furniture, lighting and every other appearance cue - so a classifier operating on it cannot be exploiting the identity and setting confounds that this review has documented throughout the image-based branch, where models trained on photographs may be recognising where an image came from rather than who is in it. Here the confound is architecturally excluded, not merely unmeasured. It also makes partial data sharing possible, which is why a de-identified pose subsample could be deposited on Zenodo when the raw video could not. The audio representation is the mirror image: the full band with no diarisation, retaining child voice, examiner voice and ambient sound, summarised as time-averaged MFCCs, Mel spectrogram, chromagram, spectral contrast and tonal centroid over 10-second windows. Time-averaging discards temporal structure within each window, so prosodic contour is only weakly represented - consistent with the finding that the audio model's predictive items are gestural and sensory rather than vocal." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-128" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Standard ADOS session recording equipment, unspecified and heterogeneous across the eleven-year window - which the authors handle by normalising audio to a 2-channel 44 kHz 192 kbps format explicitly 'to homogenize the audio format from different microphones', matched to the parameters of the Urban8K benchmark corpus. Analysis used OpenPose for pose estimation, ImageNet-pretrained VGG16 for video features and Librosa for acoustic features. The equipment story matters for the translational claim: nothing here is specialised. No eye tracker, no motion capture, no wearable, no force plate - a camera and a microphone in a room where an assessment was happening anyway. That places the study alongside the one-legged-standing and free-play studies charted here as instrumentation that a clinic could actually deploy, and unlike them it captures 46 minutes of dense social interaction rather than 90 seconds. The bottleneck it does not remove is the ADOS examiner." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-128" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Strong in substance and incompletely reported in one respect that matters. Autistic children met DSM-5 clinical criteria with the diagnosis 'further supported by employing gold standard diagnostic assessments', within an established longitudinal cohort staffed by a clinical psychiatry department - so this is genuine clinical ascertainment, not a questionnaire threshold or a dataset label, and it stands among the better reference standards in this review. The comparison group was actively screened rather than merely assumed typical: absence of known neurological or psychiatric conditions, and no first-degree relative with autism, which excludes the elevated-likelihood siblings who would otherwise blur the contrast. The unresolved issue is independence. The model's input is the ADOS recording, and 'gold standard diagnostic assessments' in a paediatric autism cohort ordinarily means ADOS, so the same session that supplied the model's training data may have contributed to the diagnostic label it is trained to predict. That is a circularity of the same family as the questionnaire studies excluded from this review, though far milder in degree - the model sees raw pose and audio rather than the clinician's coded items, so it must rediscover from signal what the clinician judged, rather than reproducing an arithmetic function of its inputs. Still, it means the label is not independent of the material, and the fix would be one sentence: another study in this review states explicitly that neither ADOS nor ADI-R entered its diagnostic process, which is exactly the statement needed here and is absent. The main text also defers the specific instruments to supplementary material, so a reader cannot check." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-128" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Age and sex are reported per group and exactly matched, and the matching is carried through into the train-test split alongside ADOS module - a three-way matching of the evaluation partition that no other included study performs. Because ADOS module assignment depends on expressive language level, matching on module constrains the groups on a language dimension without measuring it directly, which is a partial substitute for the language measure that is otherwise absent from the main text. Cognitive and developmental assessment details are deferred to supplementary material rather than reported, which is the description's main weakness. Ancestry, socioeconomic status and comorbidity within the autistic group are not reported. The 40% female representation deserves particular note in the context of this review: a speech study charted elsewhere here found that a model reaching 94.8% sensitivity on a pooled test set fell to 43.6% on girls, and that finding is only discoverable in samples where girls are present in reasonable numbers. This study has the sample composition to run that analysis and does not run it - which is a missed opportunity rather than a flaw in the sample." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-128" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "More sophisticated fusion architectures that better exploit the complementary strengths of the two modalities - motivated directly by the finding that simple late fusion did not improve accuracy despite the networks failing together on only 8.75% of cases, which is exactly the pattern that a better combination rule should be able to exploit. Beyond that: additional modalities; identification of autism subtypes from behavioural patterns, which the ADOS-item analysis makes plausible; and extension to home settings without specialised equipment. Not proposed, and needed: confidence intervals and a larger test sample; predictive values at realistic prevalence; sex-stratified evaluation; a non-autistic clinical comparison group; and an explicit statement of whether the ADOS recordings used as input contributed to the diagnoses used as labels." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-128" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:study_design "Prospective case-control diagnostic classification study nested in a longitudinal cohort, with two independently trained deep models, ensemble combination, participant-level held-o…" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: ; comparison: 80 typically developing children (48 male, 32 female), mean age 2.46 +/- 0.98 years, screened for absence of known neurological or psychiatric conditions and for no history of autism in any first-degree relative" ] ] ;
    slr:content_sha256 "0e712cc768f1bf39cf03add4da5863ab65f2e5b54dee8e9bb226662607141d83" ;
