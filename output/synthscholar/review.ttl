    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "91 recruited and 88 analysed with exclusion criteria stated in advance, including an 80% eye-tracking record-rate threshold; frame preprocessing and grouping fully described." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Sex distributions differ significantly between severity groups (55% versus 31% male, p = 0.02) with the severe group majority female, and no adjustment is made in a model whose key features are face and skin presence; ages are well matched and clinical stability was required." ],
                [ a slr:RoBDomainJudgment ;
