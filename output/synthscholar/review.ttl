    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Predictors are the ten Q-CHAT-10 items that constitute the label's scoring function in Phase I and the severity bands in Phase II. Three feature-selection methods are applied with unstated nesting and unstated retained-feature counts; SMOTE is applied at an unstated point relative to the split; no hyperparameters are reported for any of eight models." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Phase I outcome is the Q-CHAT-10 threshold (score above 3), explicitly defined in the paper, with no clinical diagnosis for any record. Phase II outcome is a column the authors created with numpy by binning that same score, with no educational assessment, therapist judgement or school record behind it." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "No sample sizes are given for any partition. The printed 10-fold average (0.986) does not equal the mean of the printed folds (0.9876), and the headline 99.99% in the state-of-the-art comparison appears in no results table and exceeds every figure the study reports." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Two public questionnaire datasets merged with no recruitment, sampling frame or response rate described, and with no row counts reported at any stage - before merging, after merging, after SMOTE, per class or per split. Class balance and demographic distributions are absent despite the variables being present." ] ;
            slr:overall_judgment "high" ;
            slr:tool_used "QUADAS-2" ] .

<https://doi.org/10.1145/3233547.3233574> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Autism Spectrum Disorder (ASD) is a pervasive and lifelong neurodevelopmental disability where early treatment has been shown to improve a person’s symptoms and ability to function. One of the most significant obstacles to effective treatment of ASD is the challenge of early detection, but unfortunately, due to the limited availability of screening and diagnostic instruments in some regions, many affected children remain undiagnosed or are diagnosed late. Recent studies have shown that characteristics in vocalizations could be used to build new ASD screening tools, but most prior efforts are based on recordings made in controlled settings and processed manually, affecting the practical value of such solutions. On the other hand, we are increasingly surrounded by smart devices that can capture an individual’s vocalizations, including devices specifically targeted at child populations (e.g., Amazon Echo Kids Edition). In this paper, we propose a practical and fully automatic ASD screening solution that can be implemented on such devices, which captures and analyzes a child’s everyday vocalizations at home, without the need for professional help. A 17-month experiment on 35 children is used to verify the effectiveness of the proposed approach, showing that we can obtain an unweighted F1-score of 0.87 for the classification of typically developing and ASD children." ;
    dcterms:bibliographicCitation "Gong Y; Yatawatte H; Poellabauer C; Schneider S; Latham S (2018). Automatic Autism Spectrum Disorder Detection Using Everyday. *Proceedings of the 2018 ACM Interna*. https://doi.org/10.1145/3233547.3233574" ;
    dcterms:creator "Gong Y",
        "Latham S",
        "Poellabauer C",
        "Schneider S",
        "Yatawatte H" ;
    dcterms:title "Automatic Autism Spectrum Disorder Detection Using Everyday" ;
    bibo:doi "10.1145/3233547.3233574" ;
    bibo:pmid "local_5b1d0b36" ;
    fabio:hasPublicationYear 2018 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are comparison groups matched?" ;
                            slr:justification "No matching, no group age or gender statistics, no comparability test; toddlers concentrated in ASD and teenagers among controls." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are participants and recruitment adequately described?" ;
                            slr:justification "Every subject is tabulated individually with age, gender, diagnosis and data volume, but no group-level statistics are computed and recruitment route is not described." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the sample appropriate and adequate for the stated target?" ;
                            slr:justification "27 analysed children spanning 3 months to 17 years for a screening claim; 18 ASD versus 9 TD." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are real-world data quality problems characterised?" ;
                            slr:justification "Interrupted tests, parent-assisted completion, varying noise levels and ASR error on atypical speech are all documented, with a sample corrupted transcript reproduced and error-robust features designed in response." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the reference standard appropriate and independently applied?" ;
                            slr:justification "No diagnostic instrument, criteria or clinician reported for any group." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the behavioral data acquisition described reproducibly?" ;
                            slr:justification "Device, microphone, app functions, test structure, stimulus material (reproduced in full in the appendix), recording triggers, cloud pipeline and segmentation procedure are all specified." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are predictors defined without knowledge of outcome?" ;
                            slr:justification "Acoustic and linguistic features are extracted by standard automatic toolkits with no manual coding." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the sample size adequate for the feature dimensionality?" ;
                            slr:justification "1330 features against 27 subjects, mitigated but not resolved by CFS selection." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is there external or independent validation?" ;
                            slr:justification "None; single cohort, single device type." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the contribution of each component quantified?" ;
                            slr:justification "Single-source ablation across all five sources plus usage pattern, showing fusion at 0.87 against a best single source of 0.77." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the metric appropriate for the class distribution?" ;
                            slr:justification "Unweighted average F1 chosen explicitly because classes are unbalanced." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the validation scheme subject-independent with separated model selection?" ;
                            slr:justification "Leave-one-subject-out with a dedicated 8-subject development set for grid search over epochs and learning rate." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "some concerns" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is code or an implementation available?" ;
                            slr:justification "No code, though all toolkits are standard and named and hyperparameter ranges are given." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are ethics, consent and privacy handling reported?" ;
                            slr:justification "HIPAA-compliant encrypted storage and parent-controlled monitoring activation are described as privacy measures, but there is no ethics approval, no IRB reference, no consent statement, and no consideration of third parties recorded during 890 hours of in-home monitoring." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are negative and unexpected results reported?" ;
                            slr:justification "Usage pattern is reported as non-discriminative against the authors' own prior expectation, and linguistic features are reported as weaker than acoustic ones with a mechanistic explanation." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are confounds actively guarded against?" ;
                            slr:justification "Age and gender are deliberately excluded as features because they may be recruitment-correlated with the label - but the same confound at the sample level is left unaddressed." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the dataset accessible or its access conditions stated?" ;
                            slr:justification "No data availability statement for a corpus that would be highly valuable and highly sensitive." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "high" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "This is the study's weakest reporting. Sample sizes are clear (18 ASD, 9 TD, 8 at-risk) and every subject's individual age, gender and diagnosis is listed in Table 1, but no group-level age mean, SD or gender distribution is computed anywhere, and no matching or comparability test is performed. Ages span 3 months to 17 years at recruitment. Inspecting Table 1, the ASD group includes children aged 2, 3 and 4 years while the TD group includes 16-year-olds, so the groups are grossly unmatched on age - a decisive confound for acoustic voice features, which change dramatically across childhood and adolescence." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-014" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Reported by the authors, unusually thoroughly for a conference paper: large variance in data volume per subject (4 to 1968 recordings) driven by device-usage preference rather than condition; real-life data errors including interrupted tests and parents completing tests on the child's behalf, which would overestimate development level; varying background noise across subjects; absence of speaker diarization so child and parent speech cannot be separated; ASR error rates that increase precisely when child speech is atypical, undermining the linguistic features; and misclassification associated with low data volume for two of the three errors. They also deliberately excluded age and gender as features because 'in the subject recruitment process, it is possible that age and gender information have some implicit connection with the label'. Identifiable in review: that same recruitment confound is not addressed at the sample level - ages span 3 months to 17 years with toddlers over-represented in the ASD group and teenagers among the TD group, entirely unmatched, so acoustic maturation is confounded with diagnosis; 18 ASD versus 9 TD with only 27 analysed; no diagnostic instrument whatsoever; no ethics or consent statement; and the 17-month longitudinal structure is collapsed to a single averaged vector, discarding the developmental information the design was uniquely placed to capture." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-014" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "'ASD children', 'children diagnosed with ASD', 'affected individuals', 'affected children', 'typically developing (TD) children', 'at-risk children', and notably 'the child's health condition' when referring to diagnostic status. Predominantly diagnosis-first ('ASD children') with a medicalised framing of autism as a health condition; the paper also uses 'neurodevelopmental disability' and 'disorder' interchangeably." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-014" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Develop a speaker diarization algorithm suited to everyday monitoring conditions, named as important future work because the absence of diarization degrades both acoustic and linguistic analysis; incorporate age and gender to enable age- and gender-dependent fine-grained inference; and extend beyond screening to evaluating intervention effectiveness and tracking child development over time." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-014" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Home setting, and uniquely so in this corpus - devices were mailed to families and all collection occurred inside children's homes with no professional supervision, deliberately to emulate real deployment of child-specific smart devices. Newly collected data; no existing dataset used." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-014" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Supervised learning. Algorithm: binary SVM optimised by stochastic gradient descent with a hinge loss objective, preceded by correlation-based feature subset selection. No deep learning, and no comparison against alternative classifiers - the paper's contribution is the data collection and fusion scheme rather than the model." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-014" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Author keywords: Autism spectrum disorders, pervasive health, data mining, speech processing, natural language processing. Task vocabulary: 'ASD screening tool', 'ASD biomarkers', 'fully automatic', 'everyday vocalizations', 'continuous and transparent monitoring', 'first ASD screening solution'. The 'pervasive health' and 'transparent monitoring' framing situates this in ubiquitous computing rather than clinical assessment." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-014" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Handcrafted features at two levels of abstraction: acoustic functionals (mean, max, min over 74 COVAREP descriptors sampled at 10 ms, giving 222 dimensions per recording, then averaged across recordings) and symbolic linguistic features from ASR transcripts (LIWC psycholinguistic categories, plus task-performance counts such as correct, irrelevant and repeated word ratios and word error rate). Notably the task-specific features are designed to be robust to the real-world failure mode observed - a parent prompting the child - by counting irrelevant and repeated words rather than only correct ones." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-014" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2018. The paper characterises prior speech-based autism work as demonstrating that vocalisations contain usable biomarkers across infants, young children and teenagers, but criticises it on two specific grounds: recordings are 'mostly based on audio data obtained in very controlled environments' and are 'often manually reviewed, segmented, and processed by speech experts', which limits both practicality and recording length. It positions the emergence of affordable child-specific smart devices (Amazon Echo Kids Edition at $79, Xiaomi Kids Smartwatch at $45) as the enabling shift - documenting the corpus-wide movement from laboratory instrumentation toward consumer hardware and naturalistic settings, and framing it explicitly as a global health-equity argument." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-014" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "ACM-BCB'18 - the 9th ACM International Conference on Bioinformatics, Computational Biology and Health Informatics, in the mHealth session. A technology/health-informatics venue, not an autism or clinical journal." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-014" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Hardware: Apple iPod Touch with an iRig Mic Cast external microphone (chosen to ensure data quality), sent to each family. Software: a custom iOS app implementing the four gamified tests and the monitoring mode with voice-activity-triggered recording and automatic cloud upload; Sookasa for HIPAA-compliant encrypted Dropbox storage; COVAREP for acoustic feature extraction; Google Cloud Speech-to-Text for ASR; LIWC for linguistic analysis; a custom self-adaptive SVM voice-activity segmentation using per-recording energy percentiles to handle varying background noise." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-014" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Fusion is the paper's central methodological claim and is done at two levels. Across modalities: acoustic and linguistic features are extracted separately and concatenated. Across sources: features from four structured tests plus passive monitoring plus usage pattern are all concatenated into one 1330-dimensional vector, with missing sources explicitly encoded as -1 so the model can handle non-participation rather than requiring imputation. The benefit is quantified by ablation - every single source scored 0.47-0.77 alone against 0.87 fused - and confirmed by CFS selecting at least one feature from each source, which the authors correctly note implies the sources are complementary rather than redundant given CFS's redundancy penalty. No integration with clinical scores or demographics, deliberately." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-014" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Goal: a practical, affordable, fully automatic home screening tool requiring no professional help, explicitly motivated by the scarcity of psychiatrists in South East Asia, the Western Pacific and Africa (0.21, 0.28 and 0.05 per 100,000). Main findings: unweighted F1 0.87 and accuracy 88.9% (24/27) from fused multi-source features; every single source performed worse alone (best 0.77); acoustic features dominated linguistic ones; and usage pattern was not discriminative." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-014" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Leave-one-subject-out with a genuine three-way split - one test subject, 18 training and 8 development subjects, with epochs and learning rate grid-searched on development only - which is subject-independent and separates model selection from performance estimation. Class imbalance is addressed at the metric level via unweighted F1. Robustness to real-world data corruption is a design goal rather than an afterthought: missing sources are explicitly encoded, error-correcting linguistic features are designed against the observed parent-prompting failure, and voice-activity segmentation adapts per recording to differing noise levels. Age and gender are deliberately excluded to prevent the model exploiting recruitment-correlated demographics. Absent: external or independent validation, any held-out site or device, calibration, and any deployment measurement despite the app being the contribution. Whether CFS is recomputed inside each leave-one-out fold is stated only as being 'conducted in the model training', which is suggestive but not explicit." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-014" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Three groups recruited: 18 children diagnosed with ASD, 9 typically developing children, and 8 at-risk children defined as undiagnosed younger siblings of ASD children. Only the 27 with definite TD or ASD status entered the classification experiment; the at-risk group was excluded because undiagnosed, which is handled transparently. Per-subject characteristics are tabulated individually." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-014" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None reported. No cognitive, linguistic or adaptive-functioning measures, no autism severity instrument, and no comorbidity information for any group. The reading materials are drawn from the Goldman-Fristoe Test of Articulation, so a standardised articulation instrument supplies the stimuli, but it is not scored as an assessment. The authors note narratively that 'some non-verbal children may not able to finish the reading test' but no verbal-ability data exist." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-014" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two complementary protocols. Structured: four gamified exercises activated by child or parent - picture description of social scenarios (9 pictures), word reading (5 lists of 10-11 words), sentence reading (2 sentences) and story reading (2 ~100-word stories), with materials drawn from the Goldman-Fristoe Test of Articulation and reproduced in full in the appendix. Unstructured: a monitoring mode that continuously listens and begins recording on voice-activity detection, capturing everyday communication. Crucially the paper documents real-world protocol failure honestly, reproducing a transcript in which a parent prompts and speaks over the child throughout a word-reading test, and designing error-robust features (irrelevant-word and repeated-word ratios) in response." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-014" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Interpretability is handled through three complementary analyses. CFS selection reports exactly which features were chosen from which source. Per-source correlation coefficients with the diagnostic label are tabulated with the top five features per source. Single-source ablation quantifies each source's standalone contribution. The findings are substantive: acoustic features dominate, specifically high-order Mel cepstrum envelope and harmonic model phase distortion mean coefficients plus quasi-open quotient - all voice-quality measures; only one linguistic feature (LIWC_Interrog) survives CFS, and linguistic features appear in the top-five correlations of only the picture description test, leading the authors to conclude that linguistic features are discriminative mainly when speech content is not fixed. Directions of effect are not reported, only correlation magnitudes." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-014" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Longitudinal in collection (17 months, April 2016 to September 2017) but cross-sectional in analysis - all of a subject's recordings are averaged into one feature vector, so no temporal or developmental modelling is performed despite the long span. The data are among the most sensitive in the corpus: 890 hours of passive in-home audio from children's bedrooms, inevitably capturing parents and other household members. Two protections are described - HIPAA-compliant encryption (Sookasa over Dropbox) for cloud storage, and parent-controlled activation/deactivation of monitoring mode 'for privacy considerations'. But there is no ethics approval statement, no IRB reference, no parental or child consent statement, and no consideration of consent for third parties recorded incidentally." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-014" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No data availability statement and no code release. Method reporting is otherwise strong: all toolkits are named and are standard (COVAREP, LIWC, Google Cloud Speech-to-Text), feature dimensions are tabulated per source and per type totalling 1330, the missing-data encoding (-1 padding rather than interpolation) is stated, normalisation is described, the grid-search ranges for epochs and learning rate are given, and the complete reading and picture stimulus materials are reproduced in an appendix. The pipeline is re-implementable; the corpus is not accessible." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-014" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Unweighted average F1-score as the primary metric, selected explicitly because the classes are unbalanced (18 ASD vs 9 TD) - the methodologically correct choice and one only a minority of corpus studies make. Accuracy (88.9%) and a confusion matrix are also reported, along with per-single-source F1 scores enabling the fusion ablation. No sensitivity, specificity, AUC or confidence intervals." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-014" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Not reported at all. Children are described as 'diagnosed with ASD' with no instrument, no criteria, no diagnosing professional and no date. TD status is asserted without any screening. At-risk status is defined purely by sibling relationship. Given that diagnostic label is the classification target and the paper proposes a screening tool, the complete absence of reference-standard information is the study's most serious gap." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-014" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Speech and language jointly: acoustic/paralinguistic properties (voice quality, spectral envelope, harmonic phase distortion, F0) and linguistic content derived from ASR transcripts (LIWC categories, vocabulary size, repetition, reading accuracy, words per second). The explicit joint acoustic-linguistic framing is unusual in this corpus, where most speech studies are purely paralinguistic." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-014" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "17 months of continuous data collection from April 2016 to September 2017; 1858 interaction recordings totalling 19.8 hours and 7427 monitoring recordings totalling 890.4 hours of detected voice activ" ;
                    slr:study_design "Longitudinal observational data collection (17 months) with cross-sectional classification analysis at the subject level" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder, plus an at-risk younger-sibling group" ;
                    slr:sample_size_text "ASD/index: 18 diagnosed with ASD (all 18 used in the classification experiment); plus 8 at-risk siblings excluded from the experiment because undiagnosed; comparison: 9" ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "Everyday vocalisations captured passively and through gamified tests on a consumer device at home, over 17 months, supported ASD screening at unweighted F1 0.87 without any professional supervision or manual processing. Multi-source fusion was decisively better than any single source (0.87 versus a best single-source 0.77), and CFS selected features from all five sources, confirming they are compl",
                        "Fused model: unweighted average F1 0.87, accuracy 88.9% (24 of 27 subjects correct), with three misclassified subjects individually identified. Single-source F1 scores: story reading 0.77, word reading 0.76, monitoring 0.72, picture description 0.68, sentence reading 0.49, usage pattern 0.47 - all substantially below the fused 0.87" ;
                    slr:outcome "Unweighted average F1-score as the primary metric (chosen explicitly because the classes are unbalanced), with classification accuracy and a confusion matrix, plus per-single-source F1 scores for the ablation" ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "Fused model: unweighted average F1 0.87, accuracy 88.9% (24 of 27 subjects correct), with three misclassified subjects individually identified. Single-source F1 scores: story reading 0.77, word reading 0.76, monitoring 0.72, picture description 0.68, sentence reading 0.49, usage pattern 0.47 - all substantially below the fused 0.87; Everyday vocalisations captured passively and through gamified tests on a consumer device at home, over 17 months, supported ASD screening at unweighted F1 0.87 without any professional supervision or manual processing. Multi-source fusion was decisively better than any single source (0.87 versus a best single-source 0.77), and CFS selected features from all five sources, confirming they are compl" ] ] ;
