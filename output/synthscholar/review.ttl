    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "Clinical diagnosis with CARS2 severity band reported, which defines the population adequately. For the validation claim the standard is the treating therapist's 0-100 attention ratings, for which no rating procedure, blinding or reliability estimate is described." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "The measurement apparatus is the robot the child is attending to, so orientation geometry is directly encoded, and every scoring rule and constant is stated. But detection is by Haar cascade at approximately 1 Hz, a detected face is equated with attending, and the constants are operator-adjustable per child so scores are not comparable across children." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Longitudinal design across seven weeks with 34 sessions, but 5 of 11 children did not complete and attrition is unexplained; sessions are clustered within 6 children with no adjustment; and no control condition exists for the longitudinal comparison." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Eleven autistic boys from a single hospital, all male, all mild to moderate by CARS2 and all required to be verbally responsive, with 5 of 11 not completing the long-term study and no reason given. No comparison group. Severity is reported only as an eligibility range rather than per child." ] ;
            slr:overall_judgment "high" ;
            slr:tool_used "QUADAS-2" ] .

<https://doi.org/10.1007/s40747-025-01790-3> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Autism Spectrum Disorder (ASD) is a complex neurodevelopmental condition marked by difﬁculties in social skills, repetitive behaviours, and communication. Early and accurate diagnosis is essential for effective intervention and support. This paper proposes a secure and privacy-preserving framework for diagnosing ASD by integrating multimodal kinematic and eye movement sensory data, Deep Neural Networks (DNN), and Explainable Artiﬁcial Intelligence (XAI). Federated Learning (FL), a distributed machine learning approach, is utilized to ensure data privacy by training models across multiple devices without centralizing sensitive data. In our evaluation, we employ FL using a shallow DNN as the shared model and Federated Averaging (FedAvg) as the aggregation algorithm. We conduct experiments across two scenarios for each dataset: the ﬁrst using FL with all features and the second using FL with features selected by XAI. The experiments, conducted with three clients over three rounds of training, show that the L_General dataset produces the best results, with Client 2 achieving an accuracy of 99.99% and Client 1 achieving 88%. This study underscores FL’s potential to preserve privacy and security while maintaining high diagnostic accuracy, making it a viable solution for healthcare applications involving sensitive data." ;
    dcterms:bibliographicCitation "Almadhor A; Alasiry A; Alsubai S; Al Hejaili A; Kovac U; Abbas S (2025). Explainable and secure framework for autism prediction using multimodal eye tracking and kinematic data. *Complex & Intelligent Sys*. https://doi.org/10.1007/s40747-025-01790-3" ;
    dcterms:creator "Abbas S",
        "Al Hejaili A",
        "Alasiry A",
        "Almadhor A",
        "Alsubai S",
        "Kovac U" ;
    dcterms:title "Explainable and secure framework for autism prediction using multimodal eye tracking and kinematic data" ;
    bibo:doi "10.1007/s40747-025-01790-3" ;
    bibo:pmid "local_e771fb69" ;
    fabio:hasPublicationYear 2025 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Sample size justified" ;
                            slr:justification "No justification; 44 examples support a grid of dozens of reported metric values, each computed on nine test cases." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Participants appropriate to the question" ;
                            slr:justification "Forty-four examples with no age, sex or any other characteristic reported; the paper does not state whether they are children or adults." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Data source and eligibility described" ;
                            slr:justification "Source described only as an open-source movement dataset on Mendeley Data, with no name, DOI or URL, and a data-availability statement that contradicts the open-source description." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Predictors assessed blind to outcome" ;
                            slr:justification "Missing values were imputed with the mean of each respective class - imputation conditioned on the outcome label, computed over the full dataset." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Preprocessing applied without leakage" ;
                            slr:justification "SHAP-based feature selection was performed on the whole dataset before the federated experiments, and the normalisation account is self-contradictory." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Predictors defined and measured appropriately" ;
                            slr:justification "No task, stimulus or acquisition procedure is described, and not one of the 120 kinematic or 48 behavioural features is named anywhere in the text." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Outcome determined independently of predictors" ;
                            slr:justification "Class-conditional imputation makes the predictor matrix partly a function of the label." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Outcome definition and ascertainment" ;
                            slr:justification "Outcome is an inherited binary field with no stated diagnostic basis for either group." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Internal consistency of reporting" ;
                            slr:justification "The best result is credited to Client 2 with Client 1 at 88% in the abstract, to Client 3 at 0.88 in the contributions list, and reported as accuracy 1.00 in the results; the preprocessing section both denies and asserts normalisation." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Validation design guards against optimism" ;
                            slr:justification "No split ratio, seed, cross-validation or repetition; nine-case test sets; and label-dependent imputation and feature selection both preceding any split." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Limitations and overinterpretation" ;
                            slr:justification "No limitations section; a nine-case result is presented as high diagnostic accuracy making the framework a viable solution for healthcare applications, and the sole future direction concerns metasurface hardware." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Analysis unit matches the clinical claim" ;
                            slr:justification "The unit appears to be the person or the instructional segment; the text does not make clear which, and the relationship between 44 examples and per-segment features is never explained." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Performance measures adequate" ;
                            slr:justification "No specificity, AUC, calibration or confidence interval; all accuracies quantised to multiples of one ninth, with 99.99% denoting nine of nine correct and described as flawless classification." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Accuracy, precision, recall and F1, reported per client, per feature subset, per local model and for the global model in both scenarios. No specificity, no AUC, no calibration, no predictive values and no confidence interval anywhere. The metric grid is dense and the reported values are internally revealing: they take only the values 0.11, 0.22, 0.33, 0.44, 0.55, 0.66, 0.77, 0.88 and 1.00, which are the achievable accuracies on nine test cases. The headline of 99.99% is that same 9/9 restated, and the paper describes it as flawless classification performance. One tabulated value, Client 3 on L_Attention at 0.01, is not a multiple of one ninth and is presumably a typographic corruption of 0.11." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-146" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. No IQ, adaptive behaviour, language, severity or comorbidity measure of any kind." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-146" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Tabular vectors of 120 kinematic or 48 behavioural/eye features per instructional segment, organised into four named subsets (K_General, K_Attention, L_General, L_Attention). Preprocessing includes one step that deserves separate note: missing values and anomalies were replaced with the mean value of each respective class - imputation conditioned on the outcome label, computed over the whole dataset before any split. Where a feature has missing values at different rates in the two groups, that step writes the label into the feature matrix directly, and it is a sufficient mechanism to produce a nine-of-nine result on its own." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-146" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Supervised deep learning in a simulated federated architecture: two local DNNs per client (a shallow dense network for binary classification, and a five-hidden-layer network described as multi-class), three clients, three communication rounds, FedAvg aggregation into a global model. XGBoost with SHAP serves as a separate feature-ranking model. No classical baseline is fitted for comparison." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-146" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2025, published online 19 February, 126 days from submission to acceptance. Framing is infrastructural rather than clinical - the contribution is offered as a viable solution for healthcare applications involving sensitive data that preserves privacy and security while maintaining high diagnostic accuracy. The claim of high diagnostic accuracy rests on nine test cases; the claim of privacy preservation rests on a federated architecture simulated over a single downloaded file; and the paper's own governance obligations - stating an ethical basis for reusing 44 people's behavioural recordings - go unmet. It is the corpus's clearest example of privacy engineering standing in for research ethics." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-146" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Forty-four examples in total - 22 individuals diagnosed with ASD and 22 non-autistic individuals - taken from an open-source movement dataset on Mendeley Data that is neither named nor cited. Nothing else is known about them: not their age band (the introduction discusses both children and adults without saying which these are), not their sex, not their recruitment, not the country, not the year. The 44 examples were divided among three simulated federated clients by an unstated rule, and each client's evaluation rests on nine test cases - a figure that appears nowhere in the text and is recoverable only from the confusion matrices (6 true negatives, 2 true positives, 1 false negative, 0 false positives) and from the fact that every accuracy in Tables 2 through 5 is a multiple of one ninth." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-146" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. There is no limitations section. Nothing is said about 44 examples being the entire dataset, about nine-case test sets, about accuracies quantised to multiples of one ninth, about class-mean imputation using the outcome label, about the contradictory normalisation account, about the absent ethics statement, or about the three federated clients being partitions of a single small file rather than independent institutions." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-146" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Not described. Labels come as a binary field in the downloaded dataset (1 autistic, 0 non-autistic). No diagnostic instrument, criterion, assessor, setting or date is reported for either group, and the source dataset's own procedures are not summarised. The comparison group's non-autistic status is likewise asserted with no screening evidence." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-146" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "SHAP over an XGBoost surrogate produces a summary plot ranking feature importance, and the ranked features define the second experimental scenario. The intent is right and the framework is one of the review's few genuine attempts at explanation before rather than after modelling. Two things undercut it. First, no feature is ever named in the text, so the explanation is reported as an activity rather than a result and nothing can be learned about which movements or gaze behaviours matter. Second, SHAP values estimated from 44 rows are not stable quantities, and the all-features versus selected-features comparison bears this out - selection helps some client-subset combinations and severely harms others with no interpretable pattern, which the paper attributes to data heterogeneity rather than to sampling variance." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-146" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "This is the review's clearest case of a metric grid resting on almost nothing. The entire empirical base is 44 examples. Those are divided among three simulated federated clients by a rule that is never stated, and each client's reported accuracy is computed on nine test cases - a number that appears nowhere in the text and must be reconstructed from the confusion matrices (6+2+1+0 = 9; 6+3 = 9) and from the quantisation of every tabulated accuracy to multiples of one ninth. On nine cases the standard error of an accuracy estimate is roughly 17 percentage points, so the difference between the paper's best result (1.00, reported as 99.99%) and its worst (0.11) is barely more than sampling noise, and the four-subset by three-client by two-scenario by two-model grid amounts to dozens of comparisons among estimates that cannot be distinguished from each other. Three further problems compound it. Class-conditional mean imputation was applied across the full dataset, writing outcome information into the predictor matrix. SHAP-based feature selection was likewise performed on the whole dataset before the federated runs. And no split ratio, seed, cross-validation or repetition is reported, so none of the figures carries a variance estimate. Finally, the headline itself is unstable across the paper: the abstract credits 99.99% to Client 2 and 88% to Client 1, the contributions list credits 88% to Client 3, and the results section reports the best configuration as accuracy 1.00 - three descriptions of the same experiment. The framing of nine correct classifications out of nine as flawless classification performance and as high diagnostic accuracy suitable for healthcare applications is not supportable at any sample size this study has." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-146" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The stated goal is a secure, privacy-preserving ASD diagnostic framework combining multimodal kinematic and eye-movement data, deep neural networks, federated learning with FedAvg, and SHAP-based explanation, evaluated in two scenarios (all features versus SHAP-selected features) across three clients and three rounds. The reported headline is that L_General gives the best results with an accuracy of 99.99% and F1 of 99.99%, described as flawless classification performance. The substantive finding, once the tables are read, is different and more interesting: performance is wildly unstable. Across the four feature subsets and three clients, accuracies in the all-features scenario range from 0.01 to 0.88, and SHAP-based feature selection helps some client-subset combinations and badly hurts others (Client 2 on K_General rises from 0.22 to 0.66 while Client 2 on K_Attention falls from 0.55 to 0.33). The paper reports this variability but attributes it to data heterogeneity rather than to the estimator's variance at n=9." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-146" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional secondary analysis. Ethics reporting is absent - no approval, no consent, no exemption statement, and the word ethic does not appear in the article. This absence is the paper's most consequential internal contradiction: the entire contribution is framed as a privacy-and-security advance for sensitive health data, invoking GDPR and HIPAA, yet the study reuses identifiable behavioural recordings of 44 people without stating any ethical basis for doing so. Federated learning here protects data from a hypothetical future adversary while the actual governance question - whether these 44 people agreed to this - is never raised." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-146" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "This is one of the few charted studies with genuine cross-modal structure, and its fusion design is worth recording precisely. Two local models operate on separate files, one specialising in kinematic features and one in eye-movement features; their outputs are merged and passed to a global model with its own dense layers and dropout. That is late fusion at the model level, in contrast to the feature-concatenation fusion used elsewhere in the corpus. The design is sound in outline. What it cannot support is inference: with 44 examples divided among three clients and evaluated on nine cases, no comparison between the unimodal and fused configurations is distinguishable from noise, and the paper never makes that comparison explicitly in any case." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-146" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Multimodal data; Kinematic features; Eye movement; Federated learning; Explainable artificial intelligence (XAI); Security and privacy; Autism spectrum disorder (ASD). Seven terms, five of them naming machinery or infrastructure properties; the condition appears last and the participants not at all." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-146" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A single paragraph proposing Physical Neural Networks based on stacked intelligent metasurfaces to process multimodal sensory data at the hardware level, reducing computational overhead and enhancing privacy through localised data handling. Computational overhead is not a difficulty encountered anywhere in a study that fits shallow networks to 44 rows, and the proposal addresses none of the study's actual weaknesses." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-146" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Movement kinematics and eye-movement behaviour, split into general and attention-specific variants: 120 kinematic features and 48 observational-behavioural features per instructional segment, with the attention-specific eye subset described as covering fixation and saccade characteristics. Because no task is described and no feature is ever named, the behavioural content of the study is opaque - the reader cannot identify a single behaviour that distinguishes the groups." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-146" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Very low, and internally contradictory on a basic point. The preprocessing section states that each feature is preserved in its original, continuous form without normalization and then, one paragraph later, that the MinMax scaler was employed for scaling and the dataset normalised; the pseudocode also calls MinMaxScaler. The dataset is described as openly available on Mendeley but is given no name, DOI or URL, and the formal data-availability statement instead says the data are available from the corresponding author on reasonable request. Code is available on demand only. No split ratio, no seed, no client partition rule, no layer widths, no learning rate, no epochs. The paper also refers to Pearson correlation analysis by the abbreviation PCA, which elsewhere denotes principal component analysis." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-146" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Complex & Intelligent Systems 11:173 (Springer) - a computational-intelligence journal. Relevant to the review's venue analysis in a specific way: this is a privacy-and-governance paper by construction, invoking GDPR and HIPAA, published without an ethics statement of any kind, and its headline accuracy of 99.99% on nine test cases passed review over 126 days." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-146" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Not reported. Features are said to be extracted per instructional segment, and the eye-movement subsets are labelled General and Attention, but no task, stimulus, instruction, session length or protocol is described anywhere in the article. A reader cannot say what the participants were doing when the kinematic and gaze data were recorded." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-146" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. Not a single demographic characteristic is reported for the 44 people - no age, sex, ethnicity, geography, language or clinical background. This is a striking omission in a paper whose entire argument concerns the responsible, privacy-preserving handling of sensitive personal health data: the study invokes GDPR and HIPAA in its abbreviation table while reporting nothing at all about the individuals whose data it processes, and without asking whether they consented to this reuse." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-146" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "ASD, autism spectrum disorder, individuals with ASD, autistic individuals, non-autistic individuals, ASD patients. The register is comparatively neutral for this corpus: the comparison group is called non-autistic rather than normal, autistic individuals is used alongside person-first phrasing, and the introduction notes that the spectrum makes each individual's experience unique. There is no autistic-community engagement and no discussion of how the people in the dataset were labelled or whether they knew their data would be reused." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-146" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None described. No acquisition setting, no laboratory, no clinic, no country of origin for the data. The federated clients are simulated - the paper says they represent independent clients such as hospitals or personal devices, but all three run on the authors' own partition of one 44-row file, so no distributed data actually exists." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-146" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No acquisition instrumentation is named, because the data were downloaded and the source acquisition is not summarised. Computational components: a shallow DNN with dense layers, ReLU and dropout (Local Model 1), a five-hidden-layer DNN described as multi-class although the task is binary (Local Model 2), FedAvg aggregation, XGBoost with SHAP for feature ranking, MinMaxScaler. No library, version, seed, hardware or runtime." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-146" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "Internal only: all-features versus SHAP-selected features, across four feature subsets and three clients, for two local models and the global model. No external baseline is re-run." ;
                    slr:study_design "Retrospective secondary analysis of a single small public dataset, reorganised into a simulated federated-learning experiment with three clients and three communication rounds; two…" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: 22 individuals diagnosed with ASD; comparison: 22 non-autistic individuals" ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "The abstract reports the L_General dataset producing the best results, with Client 2 reaching accuracy 99.99% and Client 1 reaching 88%. The contributions list instead attributes 99.99% to Client 2 and 0.88 to Client 3. The results section reports Local Model 2, Client 2, L_General, all features achieving accuracy 1.00 and F1 1.00. Since the test set contains nine cases, 1.00 means nine of nine co" ;
                    slr:outcome "Accuracy, precision, recall and F1 per client, per feature subset, per local model and for the global model, in both scenarios; confusion matrices and training/validation accuracy and loss curves for the best configuration." ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "The abstract reports the L_General dataset producing the best results, with Client 2 reaching accuracy 99.99% and Client 1 reaching 88%. The contributions list instead attributes 99.99% to Client 2 and 0.88 to Client 3. The results section reports Local Model 2, Client 2, L_General, all features achieving accuracy 1.00 and F1 1.00. Since the test set contains nine cases, 1.00 means nine of nine co" ] ] ;
