    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Group-wise ages and sexes are never reported for a 12-32 month cohort whose outcome is age-sensitive social smiling, so no matching can be verified; recruitment route and referral basis are not described." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "196 stimulus samples from 41 children are accounted for and incomplete protocols are acknowledged and mean-imputed, but the number of children with missing stimuli and the extent of imputation are not reported." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "Autism labels rest on unspecified DSM-IV clinical diagnosis with no instrument reported, though the intermediate stimulus scores have a genuine three-clinician independent majority-vote reference standard." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "Perception training data is cleanly disjoint from the evaluation cohort and autism classification is held out at the child level, but the decision tree was selected as best of four on the same leave-one-out estimate reported, and stimulus scoring is evaluated at the trial level with the same child across folds." ] ;
            slr:overall_judgment "some" ;
            slr:tool_used "QUADAS-2" ] .

<https://doi.org/10.1109/ICREST51555.2021.9331152> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Autism spectrum disorder is a neurodevelopmental disorder that characterizes by reducing concentration on social activities and improving interest in non-social tasks. The aim of this work is to investigate eye gazing images and identify autism applying various machine learning techniques. Therefore, we collected eye-tracking data from the Figshare data repository. But, these scanpath images were almost similar for normal and autistic children. To obtain similar groups, k-means clustering method was used and generated four clusters. Further, several classifiers were applied into primary data and these clusters and evaluated the performance of them using various metrics. After the assessment of overall results, MLP shows the highest 87% accuracy in cluster 1. In addition, it shows the best area under curve, f-measure, g-mean, sensitivity, specificity, fall out and miss rate respectively. This predictive model could notably useful to forecast ASD status at early stages." ;
    dcterms:bibliographicCitation "Akter T; Ali MH; Khan MI; Satu MS; Moni MA (2021). Machine Learning Model To Predict Autism Investigating Eye-Tracking Dataset. *2021 2nd International Conference on Robotics, Electrical and Sign*. https://doi.org/10.1109/ICREST51555.2021.9331152" ;
    dcterms:creator "Akter T",
        "Ali MH",
        "Khan MI",
        "Moni MA",
        "Satu MS" ;
    dcterms:title "Machine Learning Model To Predict Autism Investigating Eye-Tracking Dataset" ;
    bibo:doi "10.1109/ICREST51555.2021.9331152" ;
    bibo:pmid "local_712542ca" ;
    fabio:hasPublicationYear 2021 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the composition of the analysis units disclosed?" ;
                            slr:justification "Cluster sizes, class balance within clusters and the participant-to-cluster mapping are all unreported." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are comparison groups matched on the variables that matter?" ;
                            slr:justification "Not addressed anywhere." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the sample appropriate and adequate for the stated target?" ;
                            slr:justification "59 children underlying 547 images, with the analysis conducted entirely at image level." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are participants and recruitment adequately described?" ;
                            slr:justification "Whole-sample age range and sex split only, inherited at second hand, with no group-wise figures." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the behavioral data acquisition described reproducibly?" ;
                            slr:justification "Stimuli, protocol, eye tracker and scanpath rendering are all omitted, though documented in the source publication." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are predictors defined without knowledge of outcome?" ;
                            slr:justification "Raw pixels are label-independent, but k-means partitioning used the full image set." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the representation appropriate to the data?" ;
                            slr:justification "Raw 16,384-dimensional pixel vectors fed to naive Bayes, kNN and logistic regression cannot exploit the spatial structure of scanpath images." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the reference standard appropriate and independently applied?" ;
                            slr:justification "Only CARS severity classification is mentioned; the source study's ADI-R and ADOS-G confirmation is not carried over." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the known inflation on this dataset addressed?" ;
                            slr:justification "The originating study reported approximately 90% image-level against approximately 71% participant-level on these same images; this check is not repeated." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are reported figures internally consistent?" ;
                            slr:justification "The abstract states 87% accuracy while the results table gives 88.89%." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are degenerate classifiers identified?" ;
                            slr:justification "Several cells show single-class prediction signatures - 26.7% specificity with 0.500 AUC - that are reported but never flagged." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is clustering fitted independently of the test data?" ;
                            slr:justification "K-means was applied to the entire image set before classification." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is multiplicity across the results grid addressed?" ;
                            slr:justification "The headline is the best of nine classifiers across four clusters and the pooled set, with no correction or confidence intervals." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the validation split at the participant level?" ;
                            slr:justification "Ten-fold cross-validation over images from 59 children with no statement of participant grouping." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the source dataset properly credited?" ;
                            slr:justification "Originating study cited and the Figshare repository URL given." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is code available?" ;
                            slr:justification "Library and platform named; no code, no hyperparameters, no seed." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is any behavioural or clinical interpretation offered?" ;
                            slr:justification "No account of what distinguishes the classes or what the clusters represent." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are metrics reported comprehensively?" ;
                            slr:justification "Eight metrics for all nine classifiers across all five datasets, which is what makes the degenerate cells detectable." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are limitations stated?" ;
                            slr:justification "No limitations section and no caveats of any kind." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "high" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No data collection. The source data were gathered from schools in Hauts-de-France; all analysis here was performed in Google Colaboratory using scikit-learn, by authors at institutions in Bangladesh and Australia." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-065" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Reported entirely at second hand and only for the whole sample: 59 participants, 38 male (64%) and 21 female (36%), aged approximately 3 to 13 years, recruited from schools in the Hauts-de-France region. No group-wise ages, sexes, means or standard deviations appear, and no matching is discussed. The source study reports mean ages of 7 years 7 months and 8 years 0 months by group, so the information exists but is not carried over." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-065" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Poor for a computational paper. Reported: the source dataset with its repository link and originating citation, the preprocessing chain (greyscale, brightness increase, resize to 128 x 128), the number of clusters, the nine classifier names, ten-fold cross-validation, the eight evaluation metrics, and a complete 45-row results table. The k-means algorithm is set out in full mathematical detail, which is unnecessary for a standard method. Not reported: how many images or children fall in each cluster and their class balance; any hyperparameter for any classifier; the random seed; the rationale for choosing four clusters; whether images from a child were kept together; and any code. The mathematical exposition of k-means occupies more space than the entire account of how the classifiers were configured." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-065" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None stated." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-065" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Raw 128 x 128 greyscale pixels with brightness increased - 16,384 features per image, with no engineered representation, no dimensionality reduction and no convolutional structure. Applying classifiers such as naive Bayes, k-nearest neighbours and logistic regression directly to raw pixels of spatially structured images is a poor match of method to data, and is likely why the pooled results plateau around 74%: none of these models can exploit spatial locality. The source study used a convolutional network on the same images for exactly this reason." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-065" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Inherited and incompletely transmitted. The paper states only that 'the severity of autism were classified by the psychologists using the Childhood Autism Rating Scale' - describing a severity instrument rather than a diagnostic procedure. The source study reports diagnosis confirmed by health professionals using ADI-R and ADOS-G in multidisciplinary clinics, which is stronger ascertainment than this paper conveys. Non-autistic status is not described at all." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-065" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2021. The framing is brief and largely a literature enumeration, cataloguing prior eye-tracking autism work including the source dataset's own publications, web-page gaze studies, video-based screening paradigms, geometric-preference subtyping and autism risk indices. Its stated motivation is that 'there are needed a elaborated work that can explore significant factors of eye-signs for detecting autism', though the analysis performed does not in fact explore any factors. Its most interesting incidental observation is the honest one that motivates the clustering: 'these scanpath images were almost similar for normal and autistic children', which is a candid statement that the raw visual difference between groups is small - consistent with the source study's finding that participant-level accuracy sits near 71%." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-065" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. No feature importance, no saliency, no cluster characterisation and no behavioural interpretation. The paper does not state what the four clusters correspond to - whether they separate stimulus types, participants, image quality or something else - which leaves its central claim uninterpretable: the reader cannot tell whether clustering identified clinically meaningful subgroups or simply partitioned the images in a way that happened to make one subset easier. Given that images from the same child are visually similar, one plausible explanation is that clusters partly track individual participants, which would make the within-cluster accuracy gain a direct consequence of increased within-fold similarity." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-065" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "scikit-learn in Python on Google Colaboratory. No hardware, hyperparameters, random seeds or software versions are reported." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-065" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None used. CARS is mentioned as having been applied in the source study but no scores are reported, no severity stratification is performed, and no cognitive, language or adaptive measures appear. Since the source dataset's accompanying publication reports CARS and ECSP scores, the omission is a choice of this reanalysis rather than a constraint of the data." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-065" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Inherited from the source dataset: visual scanning behaviour rendered as a spatial trace. This paper adds no behavioural analysis of its own and does not characterise the target behaviour beyond the assertion in its introduction that autistic children show reduced attention to social content." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-065" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Goal: improve classification on an existing scanpath image dataset by clustering it first into more homogeneous subgroups. Main findings: best accuracy of 88.89% with a multilayer perceptron in cluster 1, against 74.2% for the best classifier on the pooled dataset; the other three clusters reached 70.7%, 75.8% and 77.8%; and the authors conclude that clustering produced groups in which classes were more separable." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-065" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No multimodal fusion. The only combination performed is unsupervised partitioning followed by supervised classification, which is a pipeline rather than a fusion. The result - higher accuracy within one cluster than on the pooled data - is presented as evidence that clustering helps, but no cluster is characterised, no analysis explains what makes cluster 1 different, and the improvement is a maximum over 36 cluster-by-classifier combinations, so it cannot be distinguished from selection across the grid." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-065" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "'autistic children', 'ASD children', 'normal children', 'ASD patients', 'control instances'. The comparison group is 'normal' and autistic children are described as showing 'an unbearable social attitudes and unable to present regular physiological responses' - phrasing that is both pathologising and unclear. Autism is characterised in the abstract as 'reducing concentration on social activities and improving interest in non-social tasks', which restates a contested empirical claim as a definition." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-065" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional secondary analysis of publicly released images. No ethics statement appears, which is largely defensible for reuse of open data, though the paper does not discuss the terms of that reuse. The Figshare repository is cited with its URL, and the originating study is credited." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-065" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two groups inherited from the source dataset: 30 autistic and 29 non-autistic children, contributing 219 and 328 scanpath images respectively. The analysis operates on images rather than children throughout, and the 59 participants are never treated as the unit of anything. Following k-means partitioning, the effective analysis units become four image clusters of unstated composition - the paper does not report how many images, or how many children, fall in each cluster, nor the class balance within them, which makes the per-cluster metrics difficult to interpret." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-065" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Eight metrics for all nine classifiers on all five datasets, which is comprehensive in coverage and is the paper's strongest feature. Reporting specificity and fall-out alongside sensitivity is what makes the degenerate cells visible: in cluster 1, naive Bayes and SVM both show 73.3% accuracy with 26.7% specificity and exactly 0.500 AUC, and the best model itself pairs 88.9% sensitivity with only 69.4% specificity. Missing: confidence intervals, confusion matrices, cluster composition, and any statistical comparison - so whether 88.89% differs meaningfully from 77.8% is not established." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-065" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Not described. The paper does not report what the children were looking at, how long the stimuli lasted, or how scanpaths were rendered into images - all of which are documented in the source publication and all of which bear on what the classifiers are learning. A reader of this paper alone cannot tell whether the images encode gaze position only or, as in the source, gaze velocity through colour gradient." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-065" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2021 2nd International Conference on Robotics, Electrical and Signal Processing Techniques (ICREST), pages 383-387 - a general engineering conference with no clinical or autism-specific remit." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-065" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. There is no limitations section and no caveat on sample size, validation design, cluster interpretation or generalisability. Identifiable in review: ten-fold cross-validation operates over 547 images from 59 children with no statement that a child's images were confined to one fold, and the source study demonstrated on these same images that participant-level splitting reduces accuracy from approximately 90% to approximately 71%; k-means clustering was performed on the full image set before classification, so cluster membership was determined using test images; the headline is the best of 45 cluster-by-classifier cells with no multiplicity correction or confidence intervals; the abstract quotes 87% against the table's 88.89%; several reported cells are near-degenerate single-class predictors that are not flagged; and no clinical or behavioural interpretation of any result is offered." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-065" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Nine classifiers spanning trees, ensembles, kernel methods, neural networks and probabilistic models, applied uniformly across all five datasets. Breadth is the only principle - no rationale is given for any individual choice, no hyperparameters are reported, and the winning algorithm differs by cluster (multilayer perceptron in cluster 1, random forest in clusters 3 and 4, three classifiers tied in cluster 2), which at these sample sizes is consistent with noise rather than with any property of the clusters." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-065" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Index terms: ASD, Eye Tracking, K-Means Clustering, Classifier, Machine Learning. Three of five name generic methods, which reflects a paper whose contribution is a pipeline applied to someone else's data." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-065" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The decisive weakness, and unusually well documented because the source study performed the missing check. Ten-fold cross-validation is applied over 547 scanpath images drawn from 59 children, with no statement that a child's images were confined to a single fold. The study that released these images ran both configurations and reported approximately 90% accuracy pooling images against approximately 71% holding out participants - so the inflation attributable to image-level splitting on this exact dataset is known and is roughly 19 points. This reanalysis does not repeat that check. Separately, k-means clustering used the entire image set, so the partition determining each model's training and test pool was fitted on data including the test images. There is no held-out set, no participant-level analysis, no confidence intervals and no independent cohort." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-065" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "Not applicable - the source protocol collected approximately 10 minutes of viewing per child across multiple stimuli" ;
                    slr:study_design "Secondary computational analysis of a publicly released dataset; no new data collection, no new participants" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Children with autism, as characterised in the source dataset" ;
                    slr:sample_size_text "ASD/index: 30 children contributing 219 scanpath images; comparison: 29 children contributing 328 scanpath images" ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "Applying k-means clustering to a public scanpath image dataset before classification raised the best reported accuracy from 74.2% on the pooled data to 88.89% within one of four clusters. The authors interpret this as clustering having produced groups in which the classes are more separable. Read against the source study that released the dataset - which reported approximately 90% with image-level",
                        "Cluster 1 with multilayer perceptron: 88.89% accuracy, 79.2% AUC, 87.8% F-measure, 78.6% G-mean, 88.9% sensitivity, 69.4% specificity. Cluster 2 best 70.7% (logistic regression, random forest, XGBoost). Cluster 3 best 75.8% accuracy (random forest). Cluster 4 best 77.8% accuracy with 72.3% AUC (random forest). Pooled dataset best 74.2% accuracy with 71.5% AUC (random forest). Note that the abstrac" ;
                    slr:outcome "Accuracy, AUC, F-measure, G-mean, sensitivity, specificity, fall-out and miss rate, reported for all nine classifiers across four clusters and the pooled dataset - 45 rows of eight metrics" ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "Cluster 1 with multilayer perceptron: 88.89% accuracy, 79.2% AUC, 87.8% F-measure, 78.6% G-mean, 88.9% sensitivity, 69.4% specificity. Cluster 2 best 70.7% (logistic regression, random forest, XGBoost). Cluster 3 best 75.8% accuracy (random forest). Cluster 4 best 77.8% accuracy with 72.3% AUC (random forest). Pooled dataset best 74.2% accuracy with 71.5% AUC (random forest). Note that the abstrac; Applying k-means clustering to a public scanpath image dataset before classification raised the best reported accuracy from 74.2% on the pooled data to 88.89% within one of four clusters. The authors interpret this as clustering having produced groups in which the classes are more separable. Read against the source study that released the dataset - which reported approximately 90% with image-level" ] ] ;
