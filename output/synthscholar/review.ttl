    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "No diagnostic instrument, criteria, clinician or date for the autistic group and no screening for the comparison group; the label is a questionnaire field." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "A single 80/20 split with a 40-child test set, no cross-validation, SelectKBest's k tuned because it gave the best results, and the maximum reported across 27 algorithm-by-selection combinations." ],
                [ a slr:RoBDomainJudgment ;
