            slr:full_text_source "user_supplied_pdf" ;
            slr:screening_stage "full_text" ],
        [ a prov:Activity,
                slr:ScreeningDecisionRecord ;
            dcterms:title "Automated identification of postural control for children with autism spectrum disorder using a machine learning approach" ;
            bibo:pmid "local_878c259f" ;
            slr:assessed_on "title_abstract" ;
