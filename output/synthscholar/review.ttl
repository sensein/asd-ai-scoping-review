    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Confounders addressed" ;
                            slr:justification "The ASD group's receptive vocabulary is substantially lower (PPVT-III 50.0 versus 67.3) and its age variability more than double the comparison group's; neither is entered as a covariate in a story-comprehension task." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Participants appropriate to the question" ;
                            slr:justification "Clinician-diagnosed ASD group and a typically developing comparison group, both characterised on age, symptomatology, nonverbal intelligence and receptive vocabulary." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Data source and eligibility described" ;
                            slr:justification "The corpus is cited with its ethics approval and its participants tabulated, but recruitment procedure and sex composition are not reported in this paper." ;
                            slr:rating "Unclear" ] ;
                    slr:overall_concern "unclear" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Model development guarded against optimism" ;
                            slr:justification "Grid search confined to the inner loop of a nested cross-validation, with the search space published for every algorithm and interpretable models chosen deliberately." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Predictors defined and measured appropriately" ;
                            slr:justification "Eighteen standard AOI-based temporal gaze features over eyes, mouth and nose, enumerated in full." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Predictors independent of the outcome" ;
                            slr:justification "No clinical instrument score, demographic variable or diagnostic measure enters the feature set." ;
                            slr:rating "Low" ] ;
                    slr:overall_concern "low" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Outcome determined independently of predictors" ;
                            slr:justification "Diagnosis predates the eye-tracking session and is unrelated to the gaze record." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Outcome definition and ascertainment" ;
                            slr:justification "Diagnoses made by neuropaediatricians or clinical psychologists externally and prior to inclusion." ;
                            slr:rating "Low" ] ;
                    slr:overall_concern "low" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Limitations and overinterpretation" ;
                            slr:justification "Three stated limitations plus separate sections on linguistic confounds and on clinical viability, with performance explicitly benchmarked against the 80-90% threshold and the work labelled a research exploration." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Interpretability properly placed" ;
                            slr:justification "Feature importance and SHAP computed on each fold's test set and then averaged, with convergent findings related to prior cognitive literature." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Analysis unit matches the clinical claim" ;
                            slr:justification "Multiple instances per child, but folds are participant-independent so no child spans the split." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Performance measures adequate" ;
                            slr:justification "Macro F1 and AUC chosen for small imbalanced data, with intervals, per-condition and per-story breakdowns, paired significance tests and a trivial-baseline comparison." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Validation design guards against optimism" ;
                            slr:justification "Nested five-fold cross-validation, participant independence, per-fold class balancing, bootstrap 95% intervals and an explicit per-fold majority-class baseline." ;
                            slr:rating "Low" ] ;
                    slr:overall_concern "low" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Eighteen AOI-based temporal gaze features per experimental instance, where an instance is one participant viewing one story under one modality in one speech phase. No clinical instrument score, demographic variable or diagnostic measure enters the feature set - the SCQ, KBIT-2 and PPVT-III are reported as sample characteristics and kept out of the model." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-162" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The BeGaze corpus was collected in a Spanish research setting with children viewing pre-recorded storytelling clips on screen with AOIs defined over the narrator's face. The bilingual Castilian/Valencian environment of the recorded participants is treated as a methodological factor in its own right rather than left unmentioned." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-162" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Well reported for the variables collected. Group sizes, mean ages with standard deviations, SCQ, KBIT-2 nonverbal intelligence and PPVT-III receptive vocabulary are all tabulated by group, and the pattern is described accurately: nonverbal intelligence comparable across groups (104.3 versus 108.78) while the ASD group shows higher SCQ (12.6 versus 4.7) and markedly lower receptive vocabulary (50.0 versus 67.3). Sex is not reported. Two features deserve note for interpretation. The ASD group's age variability is more than double the comparison group's (SD 19.4 versus 8.8 months), and the receptive-vocabulary gap is large and not adjusted for in the models - in a task whose stimulus is a narrated story, receptive vocabulary is a plausible driver of where a child looks. The paper does address linguistic background separately, devoting a discussion section to the Castilian/Valencian bilingual environment of the recordings." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-162" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A dedicated limitations section naming three constraints - small sample for specific modality/phase pairings limiting generalisation and increasing overfitting risk; the context-specific storytelling task potentially not transferring to other situations; and predefined AOIs and fixed time intervals limiting analytic granularity - plus a separate section on cultural and linguistic constraints addressing the Castilian/Valencian bilingual environment, and a further section (7.3) that positions the work explicitly against clinical viability benchmarks. The self-assessment is distributed through the discussion rather than confined to a closing paragraph, and it is accurate. The one limitation not raised is the substantial receptive-vocabulary difference between groups, which is measured, reported, and then not adjusted for in a task built on comprehending narrated stories." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-162" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Autism spectrum disorder; Early identification in children; Eye-tracking; Audio-visual speech comprehension; Explainable Artificial Intelligence. Five terms covering condition, application, modality, task and method, with the task - audio-visual speech comprehension - named specifically rather than generically." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-162" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Sequential models that exploit the temporal structure of AOI fixations rather than aggregating them into summary features; larger cross-linguistic cohorts to assess bilingual exposure; and cost-benefit analysis of false positives to define what performance threshold would count as meaningful in low-stakes screening. The last of these is a form of future work no other study in this review proposes - defining the target rather than raising the number." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-162" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Modality is manipulated experimentally rather than fused computationally, which is a different and arguably more informative use of the term. By presenting the same storytelling task audio-only and audio-visually and comparing gaze features across the two, the study isolates what the visual speech channel contributes to group discrimination - and finds that it contributes most before speech onset. That is a designed contrast producing an interpretable answer, in contrast to the corpus's several studies that concatenate modalities and report only the combined figure." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-162" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Proceedings of the ACM on Human-Computer Interaction 10(3), Article ETRA012, the ETRA eye-tracking venue. The disciplinary fit shows in the reporting: participant-independent nested cross-validation, bootstrap intervals, a majority-class lower bound, paired significance testing between conditions, fold-level attribution computation, and an explicit comparison of the achieved performance against published clinical-viability thresholds." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-162" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A well-designed and unusually informative paradigm. Children watched a professional storyteller narrating short children's stories with the face clearly visible, then answered comprehension questions. Six stories were used, three audio-only and three audio-visual, counterbalanced across participants, and each instance was segmented into pre-speech, speech and post-speech phases. This yields a factorial design in which modality and temporal phase can be varied independently, and it is the only study in the charted corpus that manipulates the stimulus systematically rather than presenting a single fixed stimulus set. The paper also notes what it did not control - that the data were not stratified by story content - and then tests that concern directly in a per-story analysis." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-162" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Macro F1 and AUC, chosen explicitly because the data are small and imbalanced, with bootstrap 95% confidence intervals on every estimate; per-condition, per-phase and per-story breakdowns with standard deviations; paired t-tests between modalities within each phase with full statistics; and - critically - a per-fold majority-class baseline built into the design as a lower bound to test whether the gaze features add anything beyond class distribution. That last element is present in only one other charted study. The reported numbers are correspondingly modest and are described as such: about 55% F1 in the speech phase, 64.1% F1 and 64.5% AUC at best, with the paper noting where differences fail to reach significance and attributing that to the limited number of observations." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-162" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Independent and clinician-made: diagnostic classification was conducted externally by qualified specialists (neuropaediatricians or clinical psychologists) prior to inclusion in the corpus, with the SCQ administered separately as a symptomatology measure. The label therefore predates and is unrelated to the gaze data - the property that separates this study from the checklist-threshold and folder-label branches of this review." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-162" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Six classical interpretable classifiers - SVM (linear kernel only, chosen deliberately to preserve interpretability), logistic regression, random forest, XGBoost and a shallow MLP among them - selected explicitly because the study prioritises explainability over capacity. SVM was most consistent across conditions; logistic regression gave the single best result. No deep sequence model is used, and the authors give the reason: the corpus is small and the features are lightweight." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-162" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Forty-five Spanish children from the BeGaze corpus: 19 with an ASD diagnosis made externally by neuropaediatricians or clinical psychologists before inclusion, and 26 typically developing children, focused on the 5-8 year preschool-to-primary transition. Each child contributed multiple samples - one per story, under two modality conditions and segmented into three temporal phases - and the cross-validation folds are explicitly participant-independent, so the multiplication of samples per child does not leak across the split. This is the correct handling of a repeated-measures design and it is rare in this corpus." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-162" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Social attention to a speaking face, decomposed by facial region and by time relative to speech onset: fixation count, average fixation duration, dwell-time and fixation-time percentages, normalised dwell coverage and revisits, for the eyes, mouth and nose separately. The substantive behavioural findings are specific and testable - eye revisits and mouth fixation count rank highest in importance, mouth fixation time and cross-AOI revisits emerge as candidate biomarkers under both attribution methods, and the audio-visual advantage is concentrated in the pre-speech phase, which the authors read as anticipatory attention to the mouth before speech begins." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-162" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two attribution methods - model feature importance and SHAP - applied convergently, and computed on each cross-validation fold's test set before averaging, which is the correct placement and is stated explicitly. The result is a ranked feature list dominated by eye revisits, mouth fixation count and mouth fixation-time percentage, interpreted against existing cognitive literature on social attention rather than presented as a novel discovery. The authors also note honestly where interpretation fails: for features beyond the leading ones no clear pattern emerged, which they attribute to the modest performance of the classifiers rather than explaining away." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-162" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "ASD, autism spectrum disorder, children with ASD, typically developing children, TYP. The register is measured and clinical without pathologising; gaze differences are framed as attentional and perceptual patterns and as potential biomarkers rather than as deficits, and the comparison group is typically developing throughout. One inherited phrase from the literature review describes eye tracking as quantifying social attention deficits. There is no autistic or community perspective, but nothing in the language overstates." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-162" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Screen-based eye tracking with predefined AOIs over eyes, nose and mouth; the device model is not named, which is the study's one notable acquisition-reporting gap. Analysis used Scikit-learn, XGBoost and PyTorch on an Intel i7 desktop with 16 GB RAM and no GPU, a configuration the authors highlight deliberately as evidence that the pipeline is deployable without specialised hardware." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-162" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The stated goal is to investigate eye-tracking-based ASD detection during audio-visual storytelling using traditional but explainable machine learning, and to identify which gaze features and which phases of speech carry discriminative information. Headline findings: best performance 64.1% F1 and 64.5% AUC (logistic regression, audio-visual speech phase); around 55% F1 in the speech phase across both modalities; a statistically significant advantage for audio-visual over audio-only stimuli in the pre-speech phase but not during or after speech; and convergent feature-importance and SHAP evidence that mouth fixation time and revisits across facial areas of interest are the most informative features. The abstract states in its second-to-last sentence that performance remains modest." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-162" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional. Ethics reporting is complete for the corpus: approval by the Ethics Committee of the Universitat de Valencia, conduct in accordance with the Declaration of Helsinki, and informed consent from the legal guardians of all participants. Funding is fully itemised across six grants." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-162" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "SCQ for autism symptomatology, KBIT-2 for nonverbal intelligence and PPVT-III for receptive vocabulary, all administered by the research team using Spanish-adapted standardised instruments and reported by group with standard deviations. No ADOS or calibrated severity score." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-162" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "High. The corpus is cited to its source with its ethics approval; participant characteristics are tabulated with standard deviations on four measures; the 18 features are enumerated by area of interest; the factorial design is described in full including story counterbalancing; the grid-search space is published for every algorithm; the nested cross-validation, participant independence, per-fold class balancing and bootstrap interval procedure are all specified; the software stack is named; and per-story and per-condition results are tabulated with variability. Missing: the eye-tracking device, a code or data availability statement, and the number of instances contributing to each modality/phase cell." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-162" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2026 (May). The framing is the most disciplined in the review. The abstract concedes in its own body that performance remains modest; the results section opens by observing that the modest overall performances underscore the inherent challenges of detecting ASD from gaze-based features in data-scarce naturalistic settings; and section 7.3 states that roughly 64% F1/AUC positions the work as a research exploration rather than a deployable diagnostic tool, given benchmarks for clinical viability often exceed 80-90%. Value is claimed only for preliminary screening as a complement to human judgement, and the proposed future work includes defining, by cost-benefit analysis, what performance threshold would count as meaningful for low-stakes screening. Set beside the studies in this corpus reporting 99% and 100% from checklist thresholds and web-scraped photographs, its contribution is not a method but a demonstration of what the honest number looks like." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-162" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "This is the most rigorously validated study in the charted corpus, and its result is the corpus's most useful single number. The design is five-fold nested cross-validation with participant-independent splits, class balance preserved within folds, hyperparameter selection confined to the inner loop, retraining on the full training portion before a single outer-fold evaluation, bootstrap 95% confidence intervals on every estimate, and a per-fold majority-class baseline included specifically to test whether the features beat class distribution. Each child contributes multiple samples across stories, modalities and phases, and the participant-independent split is what prevents that from becoming the leakage that inflates most of this literature. The outcome is 64.1% F1 and 64.5% AUC at best and around 55% in most conditions - and the authors state plainly that this positions the work as a research exploration rather than a deployable diagnostic tool, given that benchmarks for clinical viability often exceed 80-90%. Two qualifications remain. The sample is 45 children, and the paper repeatedly notes that the limited number of observations prevents modality differences from reaching significance. And the ASD group's receptive vocabulary is markedly lower (PPVT-III 50.0 versus 67.3), which is measured and reported but not adjusted for in a task requiring comprehension of narrated stories - so part of the gaze difference may be a comprehension difference. Neither qualification changes the study's value to this review, which is calibrative: run with correct participant-level nesting, an explicit trivial baseline, confidence intervals and a purpose-designed social-attention paradigm, eye-tracking classification of autism in children reaches the low sixties." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-162" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "Six algorithms against one another across twelve experimental conditions (two modalities x three phases, plus global comparisons), and - importantly - against an explicit majority-class baseline compu" ;
                    slr:study_design "Secondary analysis of a purpose-collected eye-tracking corpus (BeGaze); supervised binary classification with six classical algorithms across a factorial design of two stimulus mod…" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: 19 children with a specialist-confirmed ASD diagnosis; mean age 75.9 months (SD 19.4); SCQ 12.6 (5.3); KBIT-2 108.78 (16.77); PPVT-III 50.0 (28.5); comparison: 26 typically developing children; mean age 78.1 months (SD 8.8); SCQ 4.7 (5.6); KBIT-2 104.3 (12.7); PPVT-III 67.3 (22.6)" ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "Best performance 64.1% F1 and 64.5% AUC, from logistic regression in the audio-visual speech-phase condition. Across conditions the speech phase was most stable at around 55% F1. Audio-visual stimuli significantly outperformed audio-only in the pre-speech phase; no significant modality difference emerged during or after speech. Per story, audio-only averaged 57.7 (SD 9.8) and audio-visual 64.1 (SD" ;
                    slr:outcome "Macro F1 and AUC prioritised explicitly because of small and imbalanced data, with bootstrap 95% confidence intervals; per-condition results across modality and phase; per-story F1 with standard deviations; paired t-tests comparing modalities within each phase; feature importance and SHAP attributio" ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "Best performance 64.1% F1 and 64.5% AUC, from logistic regression in the audio-visual speech-phase condition. Across conditions the speech phase was most stable at around 55% F1. Audio-visual stimuli significantly outperformed audio-only in the pre-speech phase; no significant modality difference emerged during or after speech. Per story, audio-only averaged 57.7 (SD 9.8) and audio-visual 64.1 (SD" ] ] ;
