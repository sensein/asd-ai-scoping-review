<urn:slr:article:628a8bb5f003> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "In this paper, a vision-based approach is proposed to analyze the Human Robot Interaction (HRI) and extract features that can be used to distinguish between children with autism and Typically Developed (TD) children. The algorithm has been tested on the interaction of a set of children with autism and TD children with a parrot-like robot. For each subject, 190 seconds of interaction was recorded, and tracking algorithms were used to determine the position of each child with respect to the robot. Then, features were extracted and Gaussian SVM was used to distinguish between TD and children with autism reaching 81.3% accuracy." ;
    dcterms:bibliographicCitation "Moghadas M; Moradi H (2018). Analyzing Human-Robot Interaction Using Machine Vision for Autism screening. *2018 6th RSI International Conference on Robotics and Mechatronics (IcRoM)*." ;
    dcterms:creator "Moghadas M",
        "Moradi H" ;
    dcterms:title "Analyzing Human-Robot Interaction Using Machine Vision for Autism screening" ;
    bibo:pmid "local_cb9a5b48" ;
    fabio:hasPublicationYear 2018 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the sample appropriate and adequate for the stated target?" ;
                            slr:justification "n=16, half the sample of the predecessor study this paper automates; the authors name this as their limitation." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are comparison groups matched?" ;
                            slr:justification "Control ages extend to 7.6 years against a maximum of 4.1 in the ASD group, with no matching procedure or statistical test." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are participants and recruitment adequately described?" ;
                            slr:justification "Recruitment site, clinical team composition and age ranges are given; no means, SDs, gender or diagnostic instrument." ;
                            slr:rating "Partly" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the reference standard appropriate and independently applied?" ;
                            slr:justification "Multi-clinician diagnosis with psychiatric validation, but no standardised instrument and no screening of controls." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are predictors defined without knowledge of outcome?" ;
                            slr:justification "Tracking and grid occupancy are automatic, but initial child detection could involve 'manual tagging' and the cosine-similarity features are computed relative to other labelled children in the sample." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the elicitation protocol standardised?" ;
                            slr:justification "A fixed 190-second scenario identical across children, with parents instructed not to intervene." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the behavioral data acquisition described reproducibly?" ;
                            slr:justification "Robot, camera placement, session length and scenario structure are described, and the tracker is named and justified against alternatives; grid dimensions in physical space, camera specifications and the scenario script are not given." ;
                            slr:rating "Partly" ] ;
                    slr:overall_concern "some concerns" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are negative results reported?" ;
                            slr:justification "The binary Presence Vector is reported as non-discriminative (p=0.160) rather than dropped silently." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is a chance or permutation control performed?" ;
                            slr:justification "Participants were randomly regrouped into pseudo-ASD and pseudo-TD groups and the statistical pipeline rerun, yielding no significant differences - a genuine and rare robustness check." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is there external or independent validation?" ;
                            slr:justification "None." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is classifier and feature selection nested within validation?" ;
                            slr:justification "Five classifiers across three feature configurations plus a stacking layer, all compared on the same 16 children." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the sample size adequate?" ;
                            slr:justification "16 children, with 8-fold cross-validation leaving two per test fold; 81.3% equals 13/16." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are ethics, consent and privacy handling reported?" ;
                            slr:justification "No ethics approval, no parental consent statement and no anonymization, despite dual-camera video of identifiable young children and a published photograph of a participant." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is code or an implementation available?" ;
                            slr:justification "None, and no hyperparameters or software versions are given." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the dataset accessible or its access conditions stated?" ;
                            slr:justification "No data availability statement." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the screening trade-off between false positives and negatives reasoned about?" ;
                            slr:justification "The authors argue explicitly that false positives are preferable to false negatives in screening because flagged children are re-examined by an expert." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are errors and failure modes analysed?" ;
                            slr:justification "All four first-layer misclassifications are explained individually, and the systematic failure on shy typically developing children is stated plainly with a proposed mitigation." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "high" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None reported. No cognitive, linguistic or adaptive measures for either group, and no autism severity instrument. Functioning level enters only as a post-hoc anecdote - two misclassified autistic children are described as 'high-functional in autism range' - which is used to explain errors rather than as measured data." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-012" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Goal: automate an existing manually-coded robot-interaction screening protocol. Main findings: the time-weighted spatial occupancy pattern (WPV cosine similarity) separated the groups significantly (t-test p=0.001, ANOVA p=1.09e-05) while the binary presence pattern did not (p=0.160); the ratio of time spent directly in front of the robot was also significant (p<0.05); a Gaussian SVM stacking both feature families reached 81.3% accuracy with 2 false positives and 1 false negative; a random-regrouping control produced no significant differences, confirming the effect was not an artefact." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-012" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "ASD n=8, age range 2.1-4.1 years. TD n=8, age range 2.11-7.6 years. No means, no standard deviations, and no gender distribution for either group. The groups are not age-matched and the mismatch is substantial - the control range extends to 7.6 years while no autistic child was older than 4.1 - which is a serious confound for a measure based on where a child physically positions themselves relative to a robot, since approach behaviour, mobility and social confidence all change markedly between age 2 and age 7. Very young sample, so relevant in principle to early screening." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-012" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Interpretability comes from statistical comparison rather than model attribution. The Weighted Presence Vector similarity is shown to separate groups (p=0.001) while the binary Presence Vector does not (p=0.160), which is an informative negative result: the discriminative signal lies in how long a child stays near the robot, not in which regions they ever visit. The presence ratio in the robot-facing cell is directly interpretable as attraction to the robot. Importantly, the authors ran a permutation-style control - randomly regrouping the children and repeating the analysis, which produced no significant differences - a check almost no other study in this corpus performs." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-012" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Limited. 8-fold cross-validation is used and explicitly motivated by overfitting prevention, but with 16 children this leaves two per test fold, and neither the choice among five classifiers nor the two-layer stacking design is nested inside it. The random-regrouping control is a genuine robustness check on the statistical claim, though not on the classifier. There is no external or independent validation, no held-out site, no class-imbalance issue (8/8), and no real-time or deployment evaluation despite screening being the stated application. Generalisability is addressed only by the authors' plan to test more children, and the known failure mode (shy typically developing children) is handled by proposing combination with other methods rather than by any modelling change." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-012" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Diagnosis by a clinical team - a developmental-behavioural pediatrician and a child psychologist - with a child psychiatrist validating the psychologist's initial evaluation. This multi-clinician process is described in more detail than most corpus studies, but no standardised instrument is named (no ADOS, ADI-R, GARS or SCQ), despite the introduction reviewing exactly such instruments. Control status was established by attendance at mainstream daycare and absence of observed cognitive deficit, with no screening instrument." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-012" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "'children with autism', 'children with ASD', 'ASD children', 'Typically Developed (TD) children', 'TD children', 'normal ones', 'autistic ones', 'suspicious cases'. Mixed usage - person-first in the formal descriptions, but the comparison group is called 'normal' in the hypothesis statements and misclassified controls are described as 'suspicious cases'. The paper also uses 'high-functional in autism range' when explaining errors." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-012" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Keywords as printed: 'autism screening; human robot interactions; image processing; classification' (the keyword line retains an unedited template fragment, 'Keywords-component; formatting'). Task vocabulary: 'autism screening', 'human-robot interaction', 'vision-based approach', 'Presence Vector', 'Weighted Presence Vector', 'suspicious cases'." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-012" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Spatial/locomotor behaviour: the child's physical position and dwell time relative to a social robot, derived from overhead video tracking. Facial video is captured but not analysed. This is proxemic and approach behaviour rather than gaze, speech or fine motor kinematics." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-012" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Hardware: RoboParrot, a parrot-like social robot with speech, blinking, singing, laughing and limited movement, teleoperated by tablet and placed inside a cage; two cameras, one beside the robot for facial expression and one overhead for global movement. Software: motion detection or manual tagging for initial child detection; Kernelized Correlation Filter tracking, chosen after comparison against MIL, Boosting and TLD trackers; custom grid partitioning, cosine similarity, and classifiers. No specific software packages or versions are named." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-012" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two groups of 8: children with ASD and typically developing children, total n=16. Group sizes are reported; no other-diagnosis group. The predecessor study being automated (Soleiman et al.) used 32 children, so this automation paper works on half that sample." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-012" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Poor. No data availability statement, no code, no software versions, no hyperparameters (the Gaussian SVM kernel width and the KNN k are never given), no random seeds, and no specification of how the 4x4 grid maps onto physical space. Table 1, which holds the per-group presence ratios, is not recoverable as values. The method is describable in principle - grid occupancy, cosine similarity, standard classifiers - but no quantitative result other than the accuracies and p-values can be extracted from the paper." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-012" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Clinic setting - the Center for Treatment of Autistic Disorders (Tehran Autism), with the robot placed in a cage and cameras positioned overhead and beside it. Newly recorded interaction data, but building directly on an existing robot-screening platform and protocol from the same research group." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-012" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Supervised learning. Algorithms: decision tree, k-nearest neighbours, Gaussian-kernel SVM, linear discriminant analysis and logistic regression, each evaluated on both feature families and on the stacked combination. Gaussian SVM was selected as the final model. Statistical hypothesis testing (t-test, ANOVA) is used alongside classification to establish that the features carry group information." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-012" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Test on more children for higher accuracy and confidence; study child-parent interaction during screening sessions; develop a more robust protocol to cut image-processing cost and complexity; exploit the front camera for facial emotion and other features; and integrate with other intelligent screening approaches. The last of these follows directly from their own finding that the method misclassifies shy typically developing children, so it is a limitation-driven rather than generic proposal." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-012" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Reported by the authors: the limited number of cases is explicitly named as a limitation, with a stated plan to run on more children; and the method is acknowledged to fail on shy typically developing children, which the authors address by arguing it should be combined with other screening methods rather than used alone. Identifiable in review: control age range (2.11-7.6 years) roughly doubles the ASD range (2.1-4.1) with no matching, confounding age with group in a spatial-approach measure; no gender data despite a strongly sex-skewed condition; no diagnostic instrument; the best of five classifiers across three feature configurations is reported with no nesting of that selection inside the 8-fold cross-validation; the stacking layer degrades four of five classifiers, so the 81.3% may reflect a fortunate combination rather than a real gain; and post-hoc explanations of the four first-layer errors (shyness, high functioning) are unmeasured narrative rather than data." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-012" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Accuracy only, reported for five classifiers across three feature configurations, supplemented by narrative false-positive and false-negative counts (2 and 1 for the final model). No sensitivity, specificity, precision, F1, AUC or confidence intervals, though the raw counts allow them to be derived: with 8 per group, 2 FP and 1 FN gives sensitivity 87.5% and specificity 75%." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-012" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The 6th RSI International Conference on Robotics and Mechatronics (IcRoM 2018), Tehran - a technology/robotics venue, not an autism or clinical venue." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-012" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two feature families derived from the same modality - similarity of time-weighted spatial occupancy patterns, and the presence ratio in the robot-facing cell - are each fed to separate first-layer classifiers whose outputs are combined by a second-layer classifier. The authors describe this explicitly as a form of sensor fusion, though both inputs come from one sensor; it is decision-level fusion across feature views. Notably the fusion helped only the SVM (75% and 75% to 81.3%) and hurt the other four classifiers (dropping to 68.8%). No integration with clinical scores, demographics or parent report." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-012" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2018. The paper situates itself against traditional questionnaire-and-expert screening (3DI, ASD-OC), noting clinical guidance that no questionnaire can be recommended as a diagnostic test and that a combination of direct behavioural observation and caregiver report is recommended instead - then frames robot-based screening as 'a new trend'. Its own contribution is explicitly the automation of a previously manual feature-extraction step in an existing robot protocol, illustrating the corpus-wide progression from manually coded behavioural observation to automated sensing of the same behaviour." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-012" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A fixed 190-second scenario of interaction with RoboParrot, beginning with a greeting from the robot followed by several communication actions designed to motivate the child to engage further. The robot speaks, blinks, sings, laughs and moves slightly, and is teleoperated from a tablet. Parents accompanied their child but were instructed not to get involved. The child is free to move within the space in front of the robot; there is no task instruction to the child." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-012" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional; a single 190-second session per child with no repeat or follow-up. The data are highly sensitive - continuous video of identifiable young children from two angles, including a close-range facial camera, plus a published photograph of a child interacting with the robot. There is no ethics approval statement, no parental consent statement, and no anonymization or data-protection provision anywhere in the paper. Only the funding council and recruiting clinic are acknowledged." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-012" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Symbolic/spatial-occupancy representation: continuous tracked position is discretised onto a 4x4 grid and summarised either as a 16-bit binary occupancy vector or a 16-dimensional dwell-time proportion vector, then converted into pairwise cosine similarities between children. The classification features are therefore relational - how similar this child's spatial pattern is to others' - rather than absolute, which is an unusual representation choice in this corpus and one that makes the features dependent on the composition of the sample." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-012" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "Single session of 190 seconds of interaction per child, in a fixed scenario beginning with a robot greeting followed by scripted communication actions" ;
                    slr:study_design "Cross-sectional case-control classification study; an explicit automation of the manually-coded protocol of Soleiman et al." ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: 8; comparison: 8" ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "Final Gaussian SVM stacked classifier: 81.3% accuracy (13/16 correct), with 2 false positives and 1 false negative. First-layer classifiers each misclassified 2 TD and 2 ASD children. On individual features: cosine similarity gave 75% for KNN and SVM, 68.8% for discriminant and logistic regression and 50% for decision tree; presence ratio gave 75% for all five classifiers; the stacked combination ",
                        "The proportion of interaction time a child spends directly in front of a social robot, and the similarity of their spatial occupancy pattern to other children's, distinguishes ASD from typically developing children well enough for a Gaussian SVM to reach 81.3% accuracy on 16 children. The qualitative binary presence pattern carried no signal; only the time-weighted version did. A permutation contr" ;
                    slr:outcome "Accuracy only, plus narrative reporting of false positives and false negatives" ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "Final Gaussian SVM stacked classifier: 81.3% accuracy (13/16 correct), with 2 false positives and 1 false negative. First-layer classifiers each misclassified 2 TD and 2 ASD children. On individual features: cosine similarity gave 75% for KNN and SVM, 68.8% for discriminant and logistic regression and 50% for decision tree; presence ratio gave 75% for all five classifiers; the stacked combination ; The proportion of interaction time a child spends directly in front of a social robot, and the similarity of their spatial occupancy pattern to other children's, distinguishes ASD from typically developing children well enough for a Gaussian SVM to reach 81.3% accuracy on 16 children. The qualitative binary presence pattern carried no signal; only the time-weighted version did. A permutation contr" ] ] ;
