            slr:relevance_score "0.9"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "Should the sensitivity and specificity of the assessment fall within clinically useful levels comparable to or exceeding current observer-rated tests (ADOS-2, Autism Diagnostic Interview-Revised, ADI-R), we expect this instrument to be an attractive and useful addition to the assessment and diagnostic toolbox." ] ;
            oa:hasTarget <https://doi.org/10.1136/bmjopen-2018-026226> ;
