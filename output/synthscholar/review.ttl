    bibo:pmid "local_83b99e73" ;
    fabio:hasPublicationYear 2020 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are participants and recruitment adequately described?" ;
                            slr:justification "Recruitment site, period, and full inclusion and exclusion criteria for both groups are given." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are comparison groups matched on the variables that matter?" ;
                            slr:justification "Significant age difference and significant differences in adaptive, fine motor, language and personal-social developmental quotients." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the sample appropriate and adequate for the stated target?" ;
                            slr:justification "88 infants with prospective outcomes is respectable for this design, but 5 N-ASD children cannot support the differential-screening claim the paper most wants to make." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the sex distribution representative?" ;
                            slr:justification "11% female in the high-risk group; sex was matched only nominally and the distributions differ visibly." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the reference standard appropriate and independently applied?" ;
                            slr:justification "ADI-R and ADOS at 24 months with DSM-5 diagnosis by two pediatric psychiatrists; all confirmed cases met cut-off on both." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the behavioral data acquisition described reproducibly?" ;
                            slr:justification "Still-face timing, instructions, room setup and the five coding definitions are fully specified." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is coding reliability established?" ;
                            slr:justification "Roughly 20% of videos double-coded; ICCs from 0.76 to 0.83 across the five behaviours." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are predictors defined without knowledge of outcome?" ;
                            slr:justification "Coding predates diagnosis, but which behaviours entered the model was decided by t-tests against the group labels on the full dataset." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "low" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is there independent validation on unseen data?" ;
                            slr:justification "The verification cohort of 45 contains the 40 confirmed-ASD training cases; only 5 children were genuinely held out." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Does the model discriminate the clinically decisive cases?" ;
                            slr:justification "All five children who resolved off the spectrum were misclassified." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are multiple algorithms compared on identical features?" ;
                            slr:justification "SVM, naive Bayes and random forest on the same ten indicators for both episodes." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is feature selection nested within the validation loop?" ;
                            slr:justification "The ten features were chosen because full-dataset t-tests showed significant group differences, outside cross-validation." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Do reported metrics reconcile with the confusion matrix?" ;
                            slr:justification "83.35% reported for the SF episode against 70/83 = 84.3% derivable from the matrix; the FF figures show a comparable discrepancy." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are error patterns examined?" ;
                            slr:justification "Accuracy stratified across four age bands to test whether misclassification clusters by age; no regularity found." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are ethics and consent reported?" ;
                            slr:justification "Named committee approval (2017-KY089-01), written guardian consent, and specific consent for publication of potentially identifiable images or data." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the study prospectively registered?" ;
                            slr:justification "Chinese Clinical Trial Registry ChiCTR-OPC-17011995 - one of very few registered studies in this corpus." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the central negative result reported?" ;
                            slr:justification "The failure to classify any of the five N-ASD children is stated plainly and discussed, not omitted." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is code available?" ;
                            slr:justification "Library and functions named; no code, no hyperparameters." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is a data availability statement provided?" ;
                            slr:justification "A statement exists but points to article and Supplementary Material rather than participant-level data." ;
                            slr:rating "Partly" ] ;
                    slr:overall_concern "low" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No multimodal fusion. All features come from a single modality (video-coded social behaviour). The study's structural comparison is instead across conditions of the same modality: the still-face episode versus the free-interaction episode, and the still-face episode won for every classifier (83.35 vs 81.18 for SVM, 83.13 vs 80.72 for random forest, 82.35 vs 80.54 for naive Bayes). This is a useful counterpoint to the corpus's fusion studies - here the gain comes from choosing a better elicitation condition rather than adding a sensor." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-034" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Ten hand-defined behavioural statistics per child: duration and frequency of eye contact, active social engagement and social smiling in the FF episode, and duration and frequency of eye contact and active social engagement in the SF episode. All are produced by human coders in Observer XT 12, not by automated sensing - so the representation is interpretable and clinically legible, but the pipeline is not automatable and the home self-screening application the paper envisages would require replacing this stage entirely." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-034" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two groups plus a prospectively emergent third. At enrolment: 45 high-risk infants and 43 typically developing infants, 88 in total, aged 8-23 months. At 24-month follow-up the high-risk group split into 40 confirmed ASD and 5 who no longer met criteria (N-ASD). Classification used the 40 confirmed ASD against the 43 TD. The N-ASD subgroup is the corpus's clearest instance of a genuine clinical comparison group - children who present as high-risk but do not go on to be diagnosed - and the study's inability to classify any of them is the most informative negative result in this record." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-034" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Goal: determine whether still-face paradigm social behaviours differ before 24 months and whether machine learning on them can screen for autism prospectively. Main findings: high-risk infants showed less eye contact, social smiling and active social engagement in free interaction, and less eye contact and active social engagement under the maternal still face; negative-emotion behaviours did not differ; SVM reached 83.35% for the still-face episode and 81.18% for free interaction, with the still-face episode superior for all three algorithms; still-face behaviours correlated with CSBS-DP symptom severity while free-interaction behaviours did not; and the model misclassified all five children who resolved off the spectrum." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-034" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Comprehensive by corpus standards. Gesell Developmental Scale developmental quotients across five domains (adaptive, gross motor, fine motor, language, personal-social) for all participants; CSBS-DP with three factor scores and total, CARS, and ABC for symptom severity in the high-risk group. All were used analytically - correlated against behavioural indicators - not merely tabulated. The requirement that the mother be the primary caregiver is also a stated inclusion criterion for both groups, controlling a variable that matters for a mother-infant interaction paradigm." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-034" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Dyadic social-interaction behaviour: eye contact, social smiling, non-social smiling, protest behaviour and active social engagement, each measured as both duration and frequency. Uniquely in the corpus, behaviour is measured relationally - against a caregiver whose responsiveness is experimentally manipulated - rather than as a property of the child alone, and the manipulation is what generates the discriminative signal." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-034" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Frontiers in Pediatrics (Child and Adolescent Psychiatry section) - a clinical pediatrics venue, not a computational one, which matches the paper's weighting toward the behavioural and diagnostic findings over the modelling." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-034" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The strongest ascertainment in the corpus's infant-screening strand, because it is prospective rather than concurrent. Entry to the high-risk group required a positive M-CHAT plus a pediatric psychiatrist's judgement that the child met DSM-5 core criteria while under 24 months. At 2 years every high-risk child was re-evaluated with both the ADI-R and the ADOS, and clinically diagnosed by two pediatric psychiatrists against DSM-5; all confirmed cases reached cut-off on both instruments. Exclusions removed Rett syndrome, fragile X, isolated language disorder, intellectual disability, craniocerebral trauma and neurological illness. Typically developing status rests on exclusion criteria plus Gesell assessment rather than a positive screen." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-034" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Prospective longitudinal in the essential respect: behavioural measurement at 8-23 months, diagnostic outcome at 24 months. The behavioural measurement itself is a single cross-sectional session. Data are video of identifiable infants with their mothers - among the most sensitive material in the corpus. Governance is correspondingly well reported: named ethics approval (2017-KY089-01), written guardian consent, specific consent for publication of potentially identifiable images or data, and prospective trial registration." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-034" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2020. The framing is the diagnostic delay gap: autism can currently be diagnosed at 2 years but 'age at ASD diagnosis is still 40 months or even later', and Chinese prevalence estimates rose from 0.07% to 1.8%. The authors position video-based behavioural coding as the objective alternative to the retrospective parent interviews and rating scales that dominated earlier work, which they characterise as 'highly subjective and unfavorable for widespread promotion'. They also note that machine-learning screening had by then reached over 80% accuracy using EEG and brain imaging, and argue that combining social behavioural indicators with biological indicators is the necessary next step - positioning this paper as supplying the behavioural half of that combination." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-034" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Above corpus average. A data availability statement exists, trial registration is prospective, ethics approval is named with its reference number, inter-coder reliability is quantified per behaviour, the behavioural coding definitions are stated in full, the classifier library and functions are named, and the validation scheme is described precisely enough to reproduce. What is missing: hyperparameters (SVM kernel and C, forest size), any code release, participant-level data despite the availability statement, and reconciliation between the headline accuracies and the confusion matrix." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-034" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Keywords: high-risk autism spectrum disorder; the Still-Face Paradigm; social behavior; machine learning; model for early screening. The vocabulary is developmental-psychology first and computational second - 'social behavior', 'emotion regulation', 'social expectations', 'infant-mother interaction' - with machine learning entering as a screening instrument rather than as the object of study." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-034" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Expand the sample, especially the N-ASD group, to verify the model on children who resolve off the spectrum; make identifying N-ASD from ASD an explicit objective; develop more effective machine-learning models; repeat the analysis under controlled physiological and psychological ages to address the age-matching problem; and develop the still-face paradigm into a convenient, objective and standardised self-screening mode usable at home." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-034" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Outpatient clinic of the Child Mental Health Research Center, Nanjing Brain Hospital Affiliated to Nanjing Medical University, with typically developing controls recruited from the Nanjing area over the same period (December 2017 onward). Prospectively registered with the Chinese Clinical Trial Registry as ChiCTR-OPC-17011995." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-034" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A two-episode still-face paradigm: 2 minutes of normal mother-infant interaction under fixed instructions, then 1 minute in which the mother holds a neutral, unresponsive face. The classic reunion episode was omitted, following the common two-episode variant. The design logic is that the still-face episode manufactures a controlled social challenge - all of the mother's social signals vanish at once - and the paper's central empirical claim is that this challenge is more diagnostically informative than ordinary interaction, since the SF episode beat the FF episode for every classifier and only SF behaviours correlated with symptom severity." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-034" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two limitations are stated: the groups could not be age-matched because autistic children generally have delayed development, so matching on age would unmatch developmental level; and the sample was small. The N-ASD failure is discussed candidly - 'the 5 N-ASD was not classified correctly', attributed to class imbalance and to only ten indicators per sample, with identifying N-ASD from ASD named as a goal for future work. The contrary finding on negative emotion is also flagged as needing further validation. Identifiable in review but not acknowledged: the verification step is largely circular, since 40 of the 45 high-risk children used to verify the SVM were in its training set; the age gap coincides with significant differences in four of five developmental quotients, so group separation may partly reflect developmental level rather than autism; features were selected by group-difference t-tests computed on the full dataset before cross-validation, which leaks label information into the feature set; and the reported accuracies do not exactly match the tabulated confusion matrices." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-034" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Leave-one-out cross-validation over 83 samples, then an attempted verification on the 45 high-risk children. The verification is where the design breaks down: 40 of those 45 are the confirmed-ASD children the model trained on, so only the 5 N-ASD cases are genuinely unseen - and all 5 were misclassified. There is a further subtler problem: the ten features were chosen because t-tests on the full dataset showed them to differ significantly between groups, so feature selection preceded and stood outside the cross-validation loop, leaking label information into every fold. No independent site, no held-out cohort, no calibration analysis, and no comparison against the M-CHAT baseline that all high-risk children had already passed." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-034" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Video recording in a designated observation room; The Observer XT 12 behavioural observation and coding system; Python with scikit-learn (SVC, GaussianNB, RandomForestClassifier). Clinical instrumentation: M-CHAT, Gesell Developmental Scale, CSBS-DP, CARS, ABC, ADI-R, ADOS. No custom hardware and no automated behavioural sensing." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-034" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "High-risk: n = 45, 40 male / 5 female (11% female), mean age 19.71 +/- 3.43 months. Typically developing: n = 43, 32 male / 11 female (26% female), mean age 16.40 +/- 4.70 months. The age difference is significant (t = 3.80, p < 0.01) and is the authors' first stated limitation, with the explicit rationale that matching on age would unmatch developmental level. Gesell developmental quotients differ significantly on adaptive (80.29 vs 92.98), fine motor (86.64 vs 93.70), language (60.84 vs 86.51) and personal-social (78.80 vs 92.28) domains; only gross motor is comparable (92.02 vs 92.77). Sex distributions were nominally matched by design with a non-significant chi-square (p = 0.08) but differ visibly. All participants are from the Nanjing area of China, with no ethnicity or socioeconomic reporting." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-034" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Three classical supervised classifiers compared on identical tabular features: support vector machine, Gaussian naive Bayes and random forest, all from scikit-learn. No deep learning, which is appropriate at n = 83 with 10 features. The three algorithms perform within about three percentage points of each other, which is itself informative: with this feature set the choice of classifier matters far less than the choice of elicitation episode." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-034" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Overall accuracy per algorithm per episode, plus an SVM confusion matrix. Deriving from the matrix: SF episode sensitivity 85.0% and specificity 83.7%; FF episode sensitivity 87.5% and specificity 76.7%, so the still-face episode's advantage lies in specificity. No AUC, precision, recall or F1 is reported directly, although the paper does discuss 'low recall rate of N-ASD samples'. Accuracy is additionally stratified across four age bands to test whether misclassification clusters by age; no regularity was found." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-034" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "'infants and toddlers with high-risk autism spectrum disorder (HR)', 'children with ASD', 'infants and toddlers with ASD', 'typical development (TD)', 'infants and toddlers with TD'. Person-first throughout, with 'typical development' rather than 'normal' or 'healthy'. Disorder-framed language dominates ('a serious neurodevelopmental disorder', 'social communication barriers'), and the discussion invokes the extreme male brain theory and the intense world theory as explanatory frames." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-034" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Interpretability is inherent rather than post hoc: the features are named clinical behaviours, so the model operates on quantities a clinician already reasons about. Interpretation is supported by two separate analyses rather than by a model-explanation method - t-tests establishing which behaviours differ and in which episode, and Pearson correlations linking still-face behaviours to CSBS-DP symptom severity. The substantive interpretation is that the still-face episode's social challenge exposes communication impairment more sharply than ordinary interaction, evidenced by the SF episode both classifying better and being the only episode whose behaviours correlate with symptom severity. No feature importances, coefficients or ablations are reported." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-034" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "One still-face session at enrolment (2 minutes face-to-face interaction followed by 1 minute of maternal still face), with diagnostic follow-up at 2 years of age" ;
                    slr:study_design "Prospective cohort with case-control classification: high-risk infants enrolled at 8-23 months, followed to 24 months for diagnostic confirmation, then classified against a concurr…" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Infants and toddlers at high risk of autism, prospectively confirmed" ;
                    slr:sample_size_text "ASD/index: 45 high-risk at enrolment, of whom 40 were confirmed ASD at 24 months and 5 no longer met criteria (the N-ASD group). Classification models were trained on the 40 confirmed cases; comparison: 43" ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "A three-minute mother-infant still-face session, coded for five social behaviours, distinguished high-risk from typically developing infants aged 8-23 months, and SVM models on ten of those indicators reached 83.35% accuracy against diagnoses confirmed prospectively at 24 months. The still-face episode outperformed the free-interaction episode for every algorithm, which the authors interpret as th",
                        "SVM was best in both episodes: 81.18% (FF) and 83.35% (SF). Random forest reached 80.72% and 83.13%; naive Bayes 80.54% and 82.35%. The SF episode outperformed the FF episode for all three algorithms. The SVM confusion matrix for the SF episode shows 34 of 40 ASD and 36 of 43 TD correctly classified (sensitivity 85.0%, specificity 83.7%); for the FF episode, 35 of 40 ASD and 33 of 43 TD (sensitivi" ;
                    slr:outcome "Overall classification accuracy per algorithm per episode, plus a confusion matrix for the SVM. No sensitivity, specificity, AUC, precision or F1 is reported as such, though the confusion matrix permits their derivation. Accuracy was also stratified by age band (8-11, 12-15, 16-19, 20-23 months) to " ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "SVM was best in both episodes: 81.18% (FF) and 83.35% (SF). Random forest reached 80.72% and 83.13%; naive Bayes 80.54% and 82.35%. The SF episode outperformed the FF episode for all three algorithms. The SVM confusion matrix for the SF episode shows 34 of 40 ASD and 36 of 43 TD correctly classified (sensitivity 85.0%, specificity 83.7%); for the FF episode, 35 of 40 ASD and 33 of 43 TD (sensitivi; A three-minute mother-infant still-face session, coded for five social behaviours, distinguished high-risk from typically developing infants aged 8-23 months, and SVM models on ten of those indicators reached 83.35% accuracy against diagnoses confirmed prospectively at 24 months. The still-face episode outperformed the free-interaction episode for every algorithm, which the authors interpret as th" ] ] ;
