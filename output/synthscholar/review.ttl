    slr:journal "2" ;
    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Window size was swept with the best reported; tuning effort differed between compared classifiers by the authors' own account; no development set separate from the evaluation data is described; and the decisive step - k-means pseudo-labelling of roughly 5,192 unlabelled users - was applied before the headline result was computed, so the classifier is largely fitted to and evaluated against machine-generated labels." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "The unit of cross-validation is never stated. Each user contributes many windows in proportion to their app use, so window-level partitioning - the natural reading of the description - would place a user's own data on both sides of every fold, and no user-level result is reported. 761 users (12.6%) were excluded for insufficient events with no characterisation. Data span two and a half years but are analysed cross-sectionally with no modelling of change, learning or disease progression." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Unverified voluntary self- or proxy-report through an optional in-app survey completed by 214 of 6,033 users, with no clinical assessment, instrument, clinician or verification of any kind, and no record of who completed it. For the great majority of the modelled data there is no human-reported label at all, only a k-means cluster assignment. Participant totals are internally inconsistent across the text and two tables." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Self-selected users of a free commercial app, with the labelled subset consisting of the 3.4% who voluntarily completed an optional survey. No inclusion or exclusion criteria beyond a minimum event count. The comparison group is a heterogeneous aggregate of eight loosely specified categories, half of them 'other' or 'none', dominated by acquired adult-onset conditions while the autism group is predominantly children - so age, aetiology and communication history all differ systematically between groups, and none is reported by group, matched or adjusted." ] ;
            slr:overall_judgment "high" ;
            slr:tool_used "QUADAS-2" ] .

<urn:slr:article:533b421d2f0b> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Visual attention of young children with autism spectrum disorder (ASD) has been well documented in the literature for the past 20 years. In this study, we developed a Decision Support System (DSS) that uses machine learning (ML) techniques to identify young children with ASD from typically developing (TD) children. Study participants included 26 to 36 months old young children with ASD (n = 61) and TD children (n = 72). The results showed that the proposed DSS achieved up to 87.5% success rate in the early assessment of ASD in young children. Findings suggested that visual attention is a unique, promising biomarker for early assessment of ASD. Study results were discussed, and suggestions for future research were provided." ;
    dcterms:bibliographicCitation "Ozdemir S; Akin-Bulbul I; Kok I; Ozdemir S (2022). Development of a visual attention based decision support system for autism spectrum disorder screening. *International Journal of Psychophysiology, 173, 69-8*." ;
    dcterms:creator "Akin-Bulbul I",
        "Kok I",
        "Ozdemir S" ;
    dcterms:title "Development of a visual attention based decision support system for autism spectrum disorder screening" ;
    bibo:pmid "local_bc62bc4b" ;
    fabio:hasPublicationYear 2022 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is a developmental-delay comparison group included?" ;
                            slr:justification "Identified by the authors as needed in future work." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the comparison group screened stringently?" ;
                            slr:justification "No autism in any first- or second-degree relative, no sibling with developmental, behavioural or emotional symptoms, all M-CHAT no risk." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are comparison groups matched on age?" ;
                            slr:justification "34.85 versus 32.90 months, p = 0.07, with age matching stated as the design intention." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are comparison groups matched on sex?" ;
                            slr:justification "37:24 versus 38:34, p = 0.00, acknowledged in the limitations." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are comparison groups matched on developmental level?" ;
                            slr:justification "Bayley cognitive 77.79 versus 98.0 and language 67.70 versus 101.27, both p < 0.001, neither adjusted nor acknowledged." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are participants and recruitment adequately described?" ;
                            slr:justification "Recruitment sources, ages, sex, Bayley scores and M-CHAT distributions given; no standard deviations, and no account of how many entered the classification analyses." ;
                            slr:rating "Partly" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are the features defined?" ;
                            slr:justification "All thirteen listed with definitions given for the less familiar metrics including net dwell time and diversion duration." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the eye-tracking acquisition described reproducibly?" ;
                            slr:justification "Tracker model, 250 Hz sampling, monitor size and resolution, 60 cm viewing distance with individual adjustment, and five-point calibration repeated until deviation fell below one degree." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the reference standard appropriate and independently applied?" ;
                            slr:justification "Clinical DSM-5 diagnosis by licensed child psychiatrists, but no observational instrument and no procedural description." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the stimulus design described and justified?" ;
                            slr:justification "Six pairs, 16-second videos, 2-second fixation dot, counterbalanced position, with empirical rationales for both non-social competitor classes." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are group looking times reported?" ;
                            slr:justification "Mean looking times per area of interest per stimulus set for both groups, giving the behavioural basis for the stimulus comparison." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "low" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is a single-feature baseline reported?" ;
                            slr:justification "Net dwell time alone gave 70.67% and 79.17% against 78.12% and 84.37% for multivariate sets." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Can the analysed sample be reconciled with the recruited sample?" ;
                            slr:justification "Accuracy and true-positive-rate grids across all six tables are inconsistent with 61 and 72; balancing is acknowledged without stating its size or basis." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is feature selection verifiably nested within cross-validation?" ;
                            slr:justification "Asserted that only training data were used, but the implementation is not described and the Wrapper method is accuracy-driven by construction." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the unit of analysis the participant?" ;
                            slr:justification "One feature vector per child per stimulus set, with folds explicitly formed over participants." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are all configurations reported?" ;
                            slr:justification "All 24 classifier-by-selection-by-dataset combinations with seven metrics each." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is a trivial or demographic baseline reported?" ;
                            slr:justification "No comparator using Bayley scores, despite a 34-point language gap between groups." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the headline figure a maximum?" ;
                            slr:justification "87.5% is the best of 24, with no correction or confidence interval." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the prevalence argument sound?" ;
                            slr:justification "The conclusion that above-80% accuracy on balanced data 'indicates that the proposed DSS can also handle class imbalance' does not follow." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are feature-level findings reported?" ;
                            slr:justification "Selection tables for all thirteen features across both areas of interest and both datasets, plus group mean looking times." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the prevalence limitation identified?" ;
                            slr:justification "The authors state the need to test at the true 1-in-54 ratio to establish deployment performance." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the dataset accessible?" ;
                            slr:justification "Machine-learning data posted at a stated URL under an open practices statement." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the developmental confound acknowledged?" ;
                            slr:justification "The 20-point cognitive and 34-point language gaps appear only in the demographic table." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is code available?" ;
                            slr:justification "Not mentioned; analysis performed in WEKA with no hyperparameters reported." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are ethics and consent reported?" ;
                            slr:justification "No ethics approval, protocol number or consent statement anywhere in the text, despite a toddler clinical sample." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the surrounding literature critically appraised?" ;
                            slr:justification "Prior accuracies surveyed with sources of variance identified, Frazier's meta-regression on overestimation cited, and Pierce's geometric-preference finding dissected." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "high" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Four conventional classifiers spanning distinct inductive biases - a decision tree, naive Bayes, random forest and SVM - each run on each of three feature-selection outputs for each of two datasets, giving 24 configurations all of which are reported. Running the full grid and publishing all of it is good practice and exposes the spread: accuracy ranges from 67.5% to 87.5%, an 20-point range on the same participants, and no single classifier dominates across configurations (naive Bayes wins on the toys dataset, random forest and SVM on the animation dataset). The authors read this correctly as indicating that decision trees overfit small data while noting the tree's compensating virtue - it 'can be visualized' and traversed by a clinician, which they illustrate with a worked example walking through the split on social interaction fixation time at 5,879 ms. Choosing conventional classifiers over deep models is appropriate at this sample size. No hyperparameters are stated for any of the four, so the comparison cannot be assessed for equal tuning effort." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-084" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional, single session, no follow-up. The most conspicuous reporting omission in the paper is ethical: no ethics committee approval, protocol number, consent or assent statement appears anywhere in the extracted text, despite the participants being toddlers with clinical diagnoses recruited through hospitals and clinics. Funding by the Scientific and Technological Research Council of Turkey is acknowledged and a conflict-of-interest declaration is present, so the absence is not a matter of missing front matter. Against this, data sharing is handled well: an open practices statement provides a URL at which 'the study data for all machine learning experiments are available', which is more than most studies here offer and which would in principle allow the sample-size discrepancy to be resolved externally." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-084" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "'young children with ASD', 'children with ASD', 'individuals with ASD', against 'TD children' and 'typically developing children'. Consistently person-first, with 'young children' rather than 'subjects' or 'patients' throughout, which suits a toddler sample. The framing is deficit-oriented in describing attention - 'diminished attention to social stimuli', 'social orienting impairment', 'attentional bias toward non-social stimuli may compete with social cognition development' - but the paper is notably even-handed in one respect that most of this corpus is not: it repeatedly frames the phenomenon as involving 'both diminished and superior processing', treating heightened attention to animations and objects as a positive preference rather than only as a failure to attend socially. Autism is described as 'a spectrum rather than a distinct clinical disorder... which means that the symptoms can present in various combinations and range from mild to severe', invoked specifically to explain the study's false negatives." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-084" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A paired preferential-viewing paradigm with social and non-social content presented simultaneously on either side of a central dividing line, six pairs in total, each a 16-second video preceded by a 2-second central red fixation dot, with the 2-second segments excluded from analysis and left-right position counterbalanced. The design's distinctive feature is treating the non-social competitor as an experimental variable rather than a fixed choice. Two competitor classes were used, both selected on empirical rather than theoretical grounds - toys 'selected because many young children with ASD highly preferred these toys during their free play activities at the university-based research center', and spinning animations chosen because 'many young children with ASD's parents report that their children are highly interested in screen time compared to playtime and reading together'. The social videos were deliberately naturalistic, filmed in a playroom with a colourful carpet, shelves and toys, 'to observe how children view a natural environment' - which raises the competitive demand, since the social scene itself contains objects. The comparison then answers a design question the rest of the eye-tracking literature leaves implicit: which competitor best exposes the attentional bias. The answer, that animations beat toys, is directly usable by anyone constructing such a paradigm." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-084" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two claims are made and both are the right ones to make, but neither can be verified from what is reported. The cross-validation is stated to be participant-based - 'the data is divided into ten subsets based on participants... ensuring that all participants' data appeared either in the training or test set' - which forecloses within-participant leakage, though since each child contributes a single feature vector the safeguard is structural rather than earned. Feature selection is stated to use training data only. Against these, three issues remain. The analysed sample cannot be reconciled with the 133 recruited: the accuracy grid across all six results tables is consistent with roughly 20 per class and inconsistent with 61 and 72, and the balancing statement acknowledges that classes were equalised without saying how or how much was discarded. The Wrapper feature-selection method is by definition driven by classification accuracy, and while WEKA's attribute-selection mode can be run under cross-validation, the description does not establish that selection was refitted inside each classification fold rather than performed once and then used throughout - a distinction that determines whether the reported figures carry selection optimism. And the headline 87.5% is the maximum over 24 reported configurations, with no correction, no confidence interval and no held-out confirmation. The public data posting is the mitigating factor: it is the only route by which an external reader could resolve the sample question." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-084" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Five directions, the first two substantive. Recruit a developmental-delay comparison group alongside autistic and typically developing children - the specificity test that the paradigm currently cannot support, and which matters particularly for a preferential-viewing task since developmental delay would be expected to affect social attention. Test at true population prevalence rather than balanced classes, to establish deployment performance. Characterise the symptom profiles of false-negative children, on the hypothesis that the 12.5% miss rate reflects clinical heterogeneity - though this requires severity data the study did not collect. Address the sex imbalance with reference to the established prevalence gap. And develop the system into 'an off-the-shelf and ready-to-use software package'. The last sits uneasily against the preceding four: a system that has not been tested at realistic prevalence, against developmental delay, or with characterised failure modes is not ready for packaging, and the paper does not sequence these." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-084" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "One value per feature per area of interest per participant, averaged across the three videos within each stimulus set - so 26 values per participant per dataset, and the unit of analysis is the child. Features were min-max normalised to [0,1]. Averaging across the three videos within a set discards between-video variability, which is defensible for a screening measure but means the paradigm's internal consistency is never examined. Computing every metric for both the social and the non-social area of interest is the representational choice that makes the design work: it lets the classifier use the relationship between the two halves of the display rather than absolute looking at either, which is what a preferential paradigm is for. The two stimulus sets are kept as separate datasets throughout, so no participant contributes to a combined model." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-084" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Four limitations are stated. Class balance is treated most carefully and is the best-argued passage in the paper: the authors note that 'we need the true ratio of children with ASD to TD children, 1 in every 54 children, to test the usefulness of the DSS for predicting how DSS would perform on a sample representative of the population' - correctly identifying that a balanced design overstates deployment performance, which very few studies in this corpus acknowledge. They then undercut it with a non-sequitur: 'Despite missing this class imbalance, our results show over 80% accuracy and AUC ROC values (for SVM and RF) which indicates that the proposed DSS can also handle class imbalance.' Performance on balanced data carries no information about performance under 1-in-54 prevalence, where positive predictive value would collapse. The sex imbalance is acknowledged. The 12.5% false-negative rate is acknowledged and attributed to clinical heterogeneity, with a call to characterise those children's symptom profiles. Sample size is acknowledged. Not acknowledged: the 20-point cognitive and 34-point language gaps between groups; the discrepancy between recruited and analysed sample sizes; that 87.5% is the maximum across 24 configurations; the absence of an observational diagnostic instrument; the laboratory setting relative to the paper's own call for less intrusive screening; and the absence of any ethics statement." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-084" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Reported with tests, and the picture is one of a single successful match against two large failures. Age: 34.85 months for the autistic group against 32.90 for comparisons, p = 0.07 - matched, though marginally, and matching on age was the stated design intention. Sex: 37:24 against 38:34, reported as p = 0.00, acknowledged in the limitations. Development: Bayley-III cognitive scores of 77.79 against 98.0 and language scores of 67.70 against 101.27, both p < 0.001. The language gap of 33.6 standard score points is the largest developmental difference reported in any study in this corpus, and the cognitive gap of 20 points places the autistic group's mean more than one standard deviation below the comparison group's. Neither is adjusted for, stratified on, or listed as a limitation. The authors' stated reason for matching only on age is that 'the study involved a passive viewing paradigm and did not require cognitive or language processing skills', which conflates task demands with developmental sensitivity: no response was required, but where a 30-month-old looks when a conversing adult and child compete against a spinning animation is itself a developmental milestone, and a group averaging a 34-point language deficit would be expected to attend differently to a social interaction scene for reasons that are not specific to autism. Standard deviations are not reported for age or for either Bayley score." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-084" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2022. The framing is the standard early-screening argument but with more specific and better-sourced grounding than most in this corpus. The clinical problem is stated in concrete terms: 'many clinicians adopt a wait and see approach during the early years, delaying their diagnosis'; assessments are 'time-intensive processes that make many children are waitlisted for a long time'; and access depends on 'financial resources available to a child, the number of clinicians in a region, and governmental policy around access to resources'. The instrument critique is quantitative rather than rhetorical, citing the M-CHAT-R/F's reported positive predictive value of 54% for autism against 98% for developmental delay in a low-risk group, and noting that 'currently, no screening instrument can identify young children with ASD from non-ASD peers with high accuracy'. What most distinguishes the framing, though, is a genuinely critical reading of the machine-learning literature the paper is contributing to. The introduction surveys eight prior studies with their reported accuracies and then observes that 'the results of the reviewed studies indicated a large variance in prediction of ASD diagnosis', attributing it to 'the age of the participants, validation methods, and sample size but also... processing of noise, training dataset imbalances, feature selection, ranking, and data cases that overlap in features', and concluding that 'the variability of ASD classification performance require a careful reading of improvements in ML research related to ASD classification'. The discussion goes further, noting that many machine-learning studies in autism are 'limited by diverse methodological problems such as unreliable evaluation measures, small sample size, class imbalances in data, and invalid diagnostic procedures', citing Frazier's meta-regression that poorly designed and poorly reported studies overestimate group differences, and dissecting Pierce's geometric-preference finding to point out that only 40% of the autistic participants actually showed the preference and that the number of repeated trials was never reported. That level of critical engagement with the surrounding literature is unmatched in this corpus - which makes the study's own unreported sample reduction and unaddressed developmental confound the more striking." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-084" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "International Journal of Psychophysiology 173:69-81 (2022), a psychophysiology journal with a methods-oriented readership. Authorship pairs two special education departments (Hacettepe and Gazi Universities) with two computer engineering departments (Pamukkale and Hacettepe), and the pairing shows in the paper's shape: the paradigm design, stimulus rationale, calibration discipline and literature critique are of special-education quality while the machine learning is competent but conventional and under-specified. Funded by the Scientific and Technological Research Council of Turkey. The authors' own prior systematic review of eye-tracking features in autism is cited and used substantively to position the diversion-duration finding." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-084" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Interpretability is pursued at two levels and both are useful. At feature level, the selections of all three algorithms are tabulated feature by feature and area by area for both datasets, with agreement across algorithms used as the criterion for calling a feature discriminative - a more conservative approach than trusting any single ranking. The resulting claim is specific and checkable: net dwell time, diversion duration and first fixation duration on the social area were selected by all three algorithms in both stimulus sets. The authors then situate this against their own published systematic review of eye-tracking features in autism, noting that fixation count, fixation time, average fixation duration and dwell time dominate the literature while diversion duration is essentially absent - so the finding is that the field's default feature set may not contain its most discriminative member. At model level, the decision tree is reproduced with its thresholds and its traversal explained in clinical terms, presented as a transparency argument rather than a performance one. What is absent is any link between model output and clinical characteristics: no severity measure was collected, so the authors' own proposal to examine the symptom profiles of false negatives cannot be executed on these data." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-084" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Seven metrics per class per configuration - true positive rate, false positive rate, precision, recall, F-measure, ROC area and accuracy - across six full tables, plus two summary tables and two figures. This is among the most complete metric reporting in the corpus, and reporting per class rather than only overall is what makes the study's central asymmetry visible: across every configuration the true positive rate for the autistic class is lower than for comparisons, and in the best model it is 0.800 against 0.950, so the system misses one autistic toddler in five while correctly clearing nineteen comparisons in twenty. For a screening instrument that asymmetry is the wrong way round, and the authors flag the 12.5% false-negative rate explicitly. What is missing: no confidence intervals on any of the 24 accuracy figures, no significance test between configurations, and no chance or demographic baseline - the last being consequential given the 34-point language gap, since a classifier using Bayley language score alone would likely perform comparably and would establish how much of the 87.5% is attributable to gaze rather than to development." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-084" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Single modality, and no cross-modal fusion is attempted. Two within-modality combinations are studied instead, and both are informative. The first is the stimulus comparison: two competitor classes tested as separate datasets so that toys and animations can be compared directly, with animations winning on both raw looking times and classification. The second is a feature-combination test structured as a genuine ablation - net dwell time alone, the single most consistently selected feature, was used to classify and reached 70.67% and 79.17% on the two datasets, against 78.12% and 84.37% for the multivariate selected sets, and the authors report having 'made similar observations for all other single features as well'. That comparison establishes that the multivariate combination contributes real information beyond the best individual metric, which is the check that distinguishes a feature-selection claim from a dimensionality claim and which most studies here omit. What is not tested is combining the two stimulus sets, so whether toys and animations elicit complementary information from different children remains open." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-084" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Strong on acquisition and stimulus design, weak on the analytic sample and the modelling. Reported in full: recruitment sources; inclusion and exclusion criteria for both groups; the complete stimulus structure with durations, pairing, counterbalancing and the rationale for each non-social class; tracker model, sampling rate, monitor, resolution, viewing distance, calibration procedure and tolerance; all thirteen features with definitions for the less familiar ones; the three feature-selection algorithms with their selections tabulated feature by feature and area by area for both datasets; all 24 classifier-by-selection-by-dataset results with seven metrics each; a worked decision tree with split thresholds; group mean looking times per area of interest per stimulus set; and a public data URL. Not reported: how many participants entered the classification analyses and how the balanced subset was formed; any hyperparameters for any of the four classifiers; standard deviations for age or Bayley scores; the number of participants excluded for tracking failure; ethics approval; and how feature selection was nested within cross-validation beyond the assertion that only training data were used." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-084" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two groups recruited: 61 toddlers with a clinical DSM-5 autism diagnosis and 72 typically developing toddlers, all aged 26-36 months, from a university-based research centre in Ankara. Recruitment was multi-source for the autistic group - a research centre database, speech and language clinics, and child psychiatrists at accredited hospitals, across both metropolitan and rural areas - and community-based for comparisons. No developmental-delay comparison group, which the authors identify as needed: future work should include 'children with developmental delays'. The critical unresolved issue is that the classification analyses do not appear to use all 133 recruited children. The paper states that 'we used balanced datasets in our study in terms of ASD and TD children distribution... in which all classes had the same number of training samples', and every reported accuracy across all six results tables falls on a 2.5-percentage-point grid while every per-class true positive rate falls on a 0.05 grid - a pattern arithmetically consistent with roughly 20 participants per class and inconsistent with 61 and 72. No exclusion count, flow accounting or subsampling rule is given anywhere, so the number of children behind the headline 87.5% and the basis on which they were selected are both unstated." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-084" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Developmental level was measured properly, with the Bayley Scales of Infant and Toddler Development, Third Edition - an age-appropriate instrument covering 1 to 42 months, cited with its psychometric properties - administered to both groups and reported separately for cognition and language. That both groups were assessed is a genuine strength relative to studies here that measure cognition in the autistic group only or not at all. The problem is that the resulting data are used descriptively and never analytically: the 20-point cognitive gap and 34-point language gap are tabulated and then absent from every subsequent analysis, with no covariate adjustment, no matched subsample, and no mention in the discussion or limitations. No autism severity instrument was administered, so the model's outputs cannot be related to a severity gradient and the false-negative analysis the authors themselves call for - assessing 'the symptom profiles of false-negative children' - is not possible with the data collected. No comorbidity or medication information beyond the exclusion criteria." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-084" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Clinical diagnosis by licensed child psychiatrists under DSM-5 criteria, established before study entry and applied as an eligibility criterion, with subsequent exclusion of comorbid conditions including seizure disorder, known genetic disorder and uncorrectable sensory impairment. No observational diagnostic instrument - no ADOS, ADI-R or CARS - was administered, so ascertainment rests on clinical judgement whose procedures are not described beyond the practitioners' qualification. The M-CHAT-R/F was administered and its distribution reported by group (55 high risk and 6 medium risk among autistic participants; all 72 comparisons at no risk), which provides useful confirmation that the groups separate on a standardised screener but is not itself a diagnostic instrument, and the authors are clear-eyed about its limits, citing evidence of 'low to moderate accuracy' and explaining their use of it on the practical ground that it 'is the only available standardized screening instrument in the participants' native language'. The comparison group's negative status is established more stringently than the autistic group's positive status: no autism in any first- or second-degree relative, and no sibling with developmental, behavioural or emotional symptoms." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-084" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Fully specified and appropriate to the age group. An SMI RED250 remote eye tracker at 250 Hz - remote rather than head-mounted, which is necessary for toddlers - mounted below a 17-inch LCD at 1680x1050 resolution, with stimuli presented via SMI Experiment Suite and data collected and stored in Experiment Center 3.6. Viewing distance approximately 60 cm with both distance and screen height individually adjusted, five-point calibration with a crying cartoon target repeated until x and y deviation fell below one degree, and a researcher present with each parent-child pair. Areas of interest were drawn in BeGaze, and all analysis performed in WEKA. Reporting the calibration tolerance and the repeat-until-criterion rule is important for a study whose features are all derived from gaze position, and it is done here where most studies in the corpus simply state that calibration was performed." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-084" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Keywords: autism spectrum disorders, eye tracking, visual attention, screening, machine learning, biomarker. The presence of both 'screening' and 'biomarker' signals the applied framing, and 'visual attention' rather than 'gaze' or 'fixation' indicates that the construct rather than the measurement is the intended subject." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-084" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Competitive social attention - specifically, how a toddler allocates looking when social interaction and an attractive non-social alternative are visible simultaneously. This is a stronger operationalisation than measuring attention to social content alone, because it makes the measurement relative rather than absolute and therefore less sensitive to overall engagement or tracking success. The theoretical framing is explicitly two-sided, distinguishing 'diminished' from 'superior' processing and noting that autistic attention 'is captivated by non-social stimuli such as objects, lights, and geometric shapes' - so the target behaviour is a preference rather than only a deficit. The thirteen area-of-interest metrics then decompose that preference into how long (dwell time, net dwell time, fixation time), how often (fixation count, glances count, revisits, appearance count), how quickly (time to first appearance, entry time), how sustained per visit (average fixation duration, first fixation duration, glance duration) and how the eye leaves (diversion duration). That last dimension is the one the authors highlight as novel, and it captures something the others do not - the temporal cost of disengaging from an area, which connects to the attention-disengagement literature in early autism that the introduction reviews." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-084" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Goal: develop and test a decision support system for early autism screening in toddlers, and determine whether toys or animations are the more effective non-social competitor in a preferential-viewing paradigm. Main findings: best accuracy 87.5% with ROC area 0.888 (random forest and SVM with ReliefF features on the animation dataset); animations outperformed toys across most configurations, with mean looking times showing autistic toddlers viewing animations for 6.06 s against 3.20 s for comparisons and people for 5.68 s against 10.37 s; diversion duration, net dwell time and first fixation duration on the social area of interest were selected as discriminative by all three feature-selection algorithms; multivariate feature sets beat net dwell time alone (78.12% and 84.37% against 70.67% and 79.17%); and 12.5% of autistic toddlers were false negatives even in the best model." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-084" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A purpose-built eye-tracking laboratory at a university research centre for children with special needs, with lighting described as optimised for tracking. The acquisition arrangement is described with the care a toddler paradigm requires: children sat approximately 60 cm from the screen either alone or on a parent's lap, screen distance and height adjusted individually, a researcher accompanying each parent-child pair throughout, a five-point calibration using a crying cartoon as the attention-catching target, and calibration repeated for each child until deviation in both x and y fell below one degree. Repeating calibration to a stated tolerance rather than accepting the first attempt is a discipline few studies here report. The setting is a controlled laboratory rather than a clinic or home, which the authors implicitly acknowledge as a limitation of the field when they call for 'less intrusive screening instruments that do not require tightly controlled environments' - a requirement their own paradigm does not yet meet." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-084" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "One session containing both stimulus sets; each set comprised three 16-second paired videos, giving 48 seconds per set with a 2-second central fixation dot between videos" ;
                    slr:study_design "Cross-sectional case-control classification with a factorial comparison of two stimulus sets, three feature-selection methods and four classifiers, plus a single-feature baseline" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Toddlers aged 26 to 36 months with a clinical autism diagnosis" ;
                    slr:sample_size_text "ASD/index: 61 recruited; the classification analyses appear to use a substantially smaller balanced subset; comparison: 72 recruited" ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "A preferential-viewing paradigm pitting social interaction against non-social content classified toddlers aged 26-36 months at up to 87.5% accuracy with ROC area 0.888. The substantive finding is the stimulus comparison: spinning animations were a markedly more effective competitor than familiar toys, producing both larger raw looking-time divergences (autistic toddlers looked at animations for 6.",
                        "Best result: 87.5% accuracy with ROC area 0.888 (random forest) and 0.875 (SVM), both using ReliefF-selected features on the social-animation dataset, with true positive rate 0.800 for the autistic class and 0.950 for comparisons. Best on the social-toys dataset: 85.0% (naive Bayes with Information Gain). Across all 24 configurations accuracy ranges from 67.5% to 87.5%. Averaged across feature-sel" ;
                    slr:outcome "True positive rate, false positive rate, precision, recall, F-measure, ROC area and accuracy, reported per class and per configuration across six tables covering all 24 classifier-by-feature-selection-by-stimulus-set combinations, plus summary tables and figures" ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "Best result: 87.5% accuracy with ROC area 0.888 (random forest) and 0.875 (SVM), both using ReliefF-selected features on the social-animation dataset, with true positive rate 0.800 for the autistic class and 0.950 for comparisons. Best on the social-toys dataset: 85.0% (naive Bayes with Information Gain). Across all 24 configurations accuracy ranges from 67.5% to 87.5%. Averaged across feature-sel; A preferential-viewing paradigm pitting social interaction against non-social content classified toddlers aged 26-36 months at up to 87.5% accuracy with ROC area 0.888. The substantive finding is the stimulus comparison: spinning animations were a markedly more effective competitor than familiar toys, producing both larger raw looking-time divergences (autistic toddlers looked at animations for 6." ] ] ;
