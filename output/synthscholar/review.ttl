<urn:slr:article:3ba88bcdc38e> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Objective: To identify autistic children, we used features extracted from two modalities (EEG and eye-tracking) as input to a machine learning approach (SVM). Methods: A total of 97 children aged from 3 to 6 were enrolled in the present study. After resting-state EEG data recording, the children performed eye-tracking tests individually on own-race and other-race stranger faces stimuli. Power spectrum analysis was used for EEG analysis and areas of interest (AOI) were selected for face gaze analysis of eye-tracking data. The minimum redundancy maximum relevance (MRMR) feature selection method combined with SVM classifiers were used for classification of autistic versus typically developing children. Results: Results showed that classification accuracy from combining two types of data reached a maximum of 85.44%, with AUC ¼ 0.93, when 32 features were selected. Limitations: The sample consisted of children aged from 3 to 6, and no younger patients were included. Conclusions: Our machine learning approach, combining EEG and eye-tracking data, may be a useful tool for the identification of children with ASD, and may help for diagnostic processes." ;
    dcterms:bibliographicCitation "Kang J; Han X; Song J; Niu Z; Li X (2020). The identification of children with autism spectrum disorder by SVM approach on EEG and eye-tracking data. *Computers in Biology and Medicine, 120, Article 103722*." ;
    dcterms:creator "Han X",
        "Kang J",
        "Li X",
        "Niu Z",
        "Song J" ;
    dcterms:title "The identification of children with autism spectrum disorder by SVM approach on EEG and eye-tracking data" ;
    bibo:pmid "local_56237213" ;
    fabio:hasPublicationYear 2020 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is control status positively screened?" ;
                            slr:justification "Kindergarten attendance and absence of family history of autism only." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are comparison groups matched on the variables that matter?" ;
                            slr:justification "Age 4.29 versus 4.26 years and sex 39:10 versus 36:12, both stated as non-significantly different." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the sample appropriate and adequate for the stated target?" ;
                            slr:justification "97 children is relatively large for this corpus, but the age floor of 3 years misses the early-diagnosis window the authors themselves identify as the priority." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are participants and recruitment adequately described?" ;
                            slr:justification "Group sizes, ages with SDs, sex splits and recruitment sources given; no IQ, functioning or socioeconomic data." ;
                            slr:rating "Partly" ] ;
                    slr:overall_concern "some concerns" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are predictors defined without knowledge of outcome?" ;
                            slr:justification "mRMR selection is supervised and no nesting within a resampling scheme is stated." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is signal preprocessing fully specified?" ;
                            slr:justification "Referencing, filtering, downsampling, notch, ICA artefact removal, visual rejection, epoching and Welch parameters all given." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the reference standard appropriate and independently applied?" ;
                            slr:justification "DSM-5 judgement by experienced psychiatrists with PEP-3 support; no ADOS or ADI-R and no scores reported." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the behavioral data acquisition described reproducibly?" ;
                            slr:justification "Eye tracker model, sampling rate, viewing distance, calibration criterion, stimulus counts and durations, interstimulus attention device, AOI definitions, engagement index and the 60 ms threshold are all specified." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "low" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the reported operating point pre-specified?" ;
                            slr:justification "85.44% is the maximum of a curve swept over one to forty-five selected features." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are the selected features disclosed?" ;
                            slr:justification "The identity of the 32 features is never given, so the source of the fusion gain cannot be verified." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is feature selection nested within validation?" ;
                            slr:justification "Supervised mRMR with no stated nesting, over a feature pool much larger than the sample." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is any validation scheme described?" ;
                            slr:justification "No split, folds, held-out set or repetition procedure appears anywhere in the paper." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are single-modality baselines reported?" ;
                            slr:justification "EEG alone 68%, gaze alone 75.89%, making the fusion gain directly readable." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are metrics adequate for a diagnostic claim?" ;
                            slr:justification "Accuracy and AUC only; no sensitivity, specificity, confusion matrices or confidence intervals." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are internal results consistent?" ;
                            slr:justification "The tabulated theta means (1.96 autism versus 2.27 control) run opposite to the text's claim of higher theta in autism, and the control delta standard deviation of 9.23 against a mean of 8.22 appears to be a transcription error." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is code available?" ;
                            slr:justification "Software named; no code and no SVM hyperparameters." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are ethics and consent reported?" ;
                            slr:justification "Helsinki conformity, named ethics committee approval at Beijing Normal University, and parental informed consent." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the dataset accessible or its access conditions stated?" ;
                            slr:justification "A data availability statement offers EEG and eye-tracking data from the corresponding author on request." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is a limitation of the authors' own modality acknowledged?" ;
                            slr:justification "The paper states that EEG alone may be insufficient because prior studies found no differences, especially in high-functioning autism, and uses this to motivate fusion." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "some concerns" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2020. The framing is the standard objectivity argument - 'clinical diagnosis is mainly based on behavioral scale tests including the autism behavior checklist and Childhood Autism Rating Scale' and 'due to subjectivity, evaluation results may not be very accurate' - but with a more specific biomarker orientation than most: biomarkers are defined as objective indicators of biological processes used 'for diagnosis, outcome predictions, and treatment prediction', with high accuracy, reliability and validity named as prerequisites for clinical use. The paper's distinctive contribution to the corpus's framing is its argument for why single-modality approaches fail: it cites a review finding a U-shaped profile of EEG power alterations in autism (excess low- and high-frequency power, deficient alpha), then notes that other studies found no EEG differences at all, particularly in high-functioning autism, and concludes that heterogeneity makes EEG alone insufficient. Eye tracking is added specifically because 'atypical face processing' has been found across all presentations. That is a heterogeneity-driven rationale for fusion rather than a generic more-data-is-better argument, and it is unusual in this literature." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-048" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None reported. PEP-3 yields developmental scores that could have supported severity or functioning analyses, but no scores appear and no stratification is performed. This is a substantive gap given the paper's own explanation for inconsistent EEG findings in the literature - that 'autism can be divided into low function and high function according to behavioral ability' and that heterogeneity is why 'using only EEG evaluation may be insufficient'. Having advanced that argument, the study is unable to test it in its own data." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-048" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Computers in Biology and Medicine, 120, article 103722 - an Elsevier biomedical engineering journal, appropriate for a signal-processing-plus-classification contribution." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-048" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Accuracy and AUC only, but reported for every modality and stimulus condition separately, which is what makes the fusion ladder legible. Missing: sensitivity, specificity, confusion matrices, confidence intervals, and any statistical test of the differences between modality conditions - so whether 85.44% is significantly better than 75.89% on 97 children is not established. The accuracy-versus-feature-count curve is plotted, which is transparent about the sweep but also makes explicit that the headline is a maximum rather than a pre-specified operating point." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-048" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two behavioural-adjacent targets of different kinds. The behavioural measure proper is visual attention allocation during face viewing, decomposed across eight regions from whole-face down to individual eyes, and manipulated by face race. The EEG measure is neurophysiological rather than behavioural - resting-state cortical rhythm power - and the paper interprets it in behavioural terms, linking theta to working memory encoding and retrieval, beta to alertness and motor behaviour, and gamma to sensory processing, working memory, attention and arousal." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-048" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Keywords: Autism; Typically developing children; EEG; Eye-tracking. Purely descriptive of the design, with no methodological or clinical framing term - consistent with a paper whose contribution is presented as the combination of two established measurement modalities rather than as a modelling advance." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-048" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The clearest and most cleanly reported fusion result in the corpus, precisely because both single-modality baselines are given: EEG alone 68%, gaze alone 75.89%, fused 85.44% with AUC rising from 0.865 to 0.93. That is close to a 10-point gain over the better single modality, and the authors' rationale for expecting it is specific rather than generic - EEG abnormalities are inconsistent across the autism spectrum, particularly in high-functioning presentations, whereas 'atypical face processing' has been found 'for all types of ASD', so the modalities should fail on different subgroups. There is a second, within-modality fusion as well: own-race faces alone gave 72.33% and other-race faces 66.67%, but combining both face types gave 75.89%, better than either. The caveat is that with no validation scheme and feature selection over a much larger EEG feature pool, the size of the fusion gain cannot be taken at face value, and the identity of the 32 selected features is not disclosed so complementarity cannot be verified." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-048" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two feature families of very unequal size. EEG contributes relative power in five bands across 62 electrodes - potentially over 300 features, though the paper reports an EEG-only classification 'using the five frequency bands' relative power', suggesting channel-averaged values were used there. Eye tracking contributes 16 features (eight AOIs by two face races) as fixation-time proportions. The relative power formulation is a considered choice, expressing each band as a share of total spectral power to expose 'abnormalities in the rhythmic fluctuations' independent of overall amplitude. The 60 ms fixation threshold on the gaze side is a similarly considered detail, excluding gaze too brief to be conscious. The asymmetry in pool size between modalities is not addressed and matters for interpreting which features the mRMR selection favoured." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-048" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two distinct paradigms in one session. Resting-state EEG for about 6 minutes with eyes open, with the child kept as still and quiet as possible. Then passive viewing of face photographs - a young girl of the child's own race or of another race, each type presented 6 times for 10 seconds in random order, with a dynamic kitten and sound between trials to re-engage attention and no response required. The own-race/other-race manipulation is uncommon in this literature and yields a directly interpretable comparison; the attention-recapturing interstimulus is a practical design detail for this age group that few papers describe." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-048" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "128-channel HydroCel Sensor Net (Electrical Geodesics) at 1000 Hz, with 62 electrodes selected and re-referenced to linked ears; Tobii TX300 at 300 Hz with a five-point calibration required to pass with small error vectors before the experiment proceeded, at roughly 60 cm; MATLAB R2016a with EEGLAB for preprocessing and pwelch for spectral estimation." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-048" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Diagnosis by 'experienced Chinese psychiatrists based on the psychoeducational profile (Third Edition)' and DSM-5 criteria. PEP-3 is a developmental and autism-characteristic assessment rather than a diagnostic instrument in the ADOS or ADI-R sense, so the ascertainment is weaker than the corpus norm for well-documented studies, though DSM-5 clinical judgement by experienced psychiatrists is a reasonable standard. Control status rests on kindergarten recruitment and the absence of 'genetic history of autistic family members', with no screening instrument applied." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-048" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional; a single session per child with no follow-up. Data are EEG traces and gaze coordinates over face photographs, low in identifiability. Governance reporting is complete: conducted according to the Declaration of Helsinki, approved by the ethics committee of Beijing Normal University, with parental informed consent obtained before participation, and a data availability statement offering the data on request." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-048" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two groups, 97 children: 49 with confirmed autism diagnoses and 48 typically developing children recruited from a local kindergarten. No other-diagnosis comparison group. At 97 participants this is one of the larger single-site cohorts in the corpus, and the authors note they 'recruited a relatively large sample size for the sake of classification'." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-048" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Autistic group: n = 49, 39 male and 10 female, mean age 4.29 +/- 1.07 years. Typically developing: n = 48, 36 male and 12 female, mean age 4.26 +/- 1.00 years. The authors state there were no statistical differences in age or gender between groups, and the reported means and SDs bear that out - this is among the best-matched pairs in the corpus, on the two variables most likely to confound gaze during face viewing at this age. Both groups span 3-6 years. No IQ, developmental level, socioeconomic or ethnicity data; recruitment routes differ between groups (clinical for autism, a local kindergarten for controls), which is not addressed." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-048" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The study's decisive weakness. No train/test split, cross-validation, held-out sample or repetition procedure is described anywhere in the methods or results. mRMR feature selection uses class labels and there is no statement that it was nested within any resampling scheme. The reported 85.44% is explicitly the maximum of a curve swept across one to forty-five selected features, so both the feature count and the reported figure were chosen against the same data. With 97 participants and an EEG feature pool potentially exceeding 300 variables, this is exactly the configuration in which unnested supervised selection produces substantial upward bias. There is no independent cohort, no external site and no replication. The accuracies should therefore be read as in-sample separability rather than as estimates of predictive performance." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-048" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Good on signal processing, absent on evaluation. Fully reported: electrode count and selection, sampling rates, referencing scheme, filter bands, downsampling, notch filtering, ICA artefact removal, visual rejection, epoch length, Welch parameters (eight segments, 50% overlap, Hamming window), the five frequency bands with their boundaries, the eight AOIs, the fixation-proportion index definition, the 60 ms fixation threshold, viewing distance, calibration procedure, stimulus counts and durations, and the interstimulus attention device. Entirely absent: any statement of how the classifier was trained and evaluated - no split, no folds, no repetition - together with SVM hyperparameters, the identity of the 32 selected features, and any code release." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-048" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No model-explanation method and no disclosure of which features mRMR selected, which is the paper's main interpretive gap - having established that fusion helps, it cannot say what the fused model is using. Interpretation instead comes from a parallel descriptive analysis: independent t-tests on each band and AOI, with the resulting differences read against established theory. The gaze findings are interpreted through the eye avoidance hypothesis, that autistic people avoid eye contact because they 'may consider it an unbearable social threat and experience uncomfortable physiological responses', making avoidance 'an adaptive strategy' that nonetheless degrades processing of facial identity and intention. The EEG findings are mapped onto cognitive functions band by band. Notably, the descriptive analysis found the strongest gaze effect on background fixation rather than on the eye region, and eye-region differences did not reach significance - a result that sits somewhat awkwardly with the eye-avoidance framing the discussion adopts." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-048" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A shielded room for EEG recording and a separate eye-tracking station, with autistic children recruited clinically and typically developing children from a local kindergarten. Funded by the National Natural Science Foundation of China and the National Key Research and Development Program of China." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-048" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Acknowledged: that the cohort begins at age 3 and that 'diagnosis of autism at earlier ages is a pressing clinical need', with a stated plan to recruit children aged 2 or younger; and that more features should be extracted from both modalities. The paper also usefully concedes a limitation of its own EEG modality, noting that 'no differences in EEG were found in some previous studies, especially for high functioning autism' and concluding that 'using only EEG evaluation may be insufficient to identify children with this complex disease'. Not acknowledged, and decisive: no validation scheme of any kind is described, so the reported accuracies have no established out-of-sample interpretation; mRMR uses class labels with no indication of nesting within any resampling; the headline 85.44% is the maximum of a curve swept over one to forty-five features, so the operating point was selected on the reported data; the identity of the selected features is never given; recruitment routes differ systematically between groups; and no severity or functioning measure is reported despite heterogeneity being central to the paper's own argument." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-048" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Goal: test whether fusing resting-state EEG spectral power with face-viewing gaze features improves autism identification over either modality alone. Main findings: EEG alone 68%, gaze alone 75.89% (AUC 0.865) combining own- and other-race faces, and fused 85.44% with AUC 0.93 at 32 selected features; autistic children fixated the background far more (19.4% versus 3.3%) and the face, nose and mouth less; own-race faces classified better than other-race faces; and EEG showed differences in theta, beta and gamma but not delta or alpha." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-048" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Recruit younger children, aged two years or under, to address the clinical need for earlier diagnosis; and extract additional features from both EEG and eye tracking, since 'multi-modal, multi-feature fusion will likely improve classification accuracy further'." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-048" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A single linear SVM throughout, preceded by mRMR feature selection based on mutual information, chosen for jointly maximising relevance to the class label and minimising redundancy among features. No model comparison is performed - the experimental variable is the modality and the number of selected features, not the learner. This is a defensible focus given the paper's question, but it means there is no evidence about whether the linear SVM is the right choice for these features." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-048" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "'children with ASD', 'autistic children', 'ASD children', 'typically developing (TD) children', 'normal children', 'patients with autism', 'healthy children'. Mixed and inconsistent - person-first in places, 'autistic children' elsewhere, and 'normal' and 'healthy' both used for the comparison group. Autism is framed as 'a very complex neurodevelopmental disorder' and once as 'this complex disease', with aetiology attributed to 'biological factors such as genetic defects, brain inflammation, and abnormal conditions during pregnancy'." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-048" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "One session per child: approximately 6 minutes of eyes-open resting EEG, a break, then eye tracking comprising 12 face presentations (6 own-race and 6 other-race) of 10 seconds each" ;
                    slr:study_design "Cross-sectional case-control classification with a modality-by-modality accuracy comparison" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Preschool children with autism" ;
                    slr:sample_size_text "ASD/index: 49; comparison: 48" ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "Combining resting-state EEG spectral power with gaze allocation during face viewing raised autism classification accuracy to 85.44% (AUC 0.93), against 68% for EEG alone and 75.89% for gaze alone - a substantial and cleanly reported fusion benefit. The behavioural findings are consistent with the reduced social-attention literature: autistic children spent far more fixation time on the image backg",
                        "EEG alone (five relative power bands) 68%. Eye tracking alone: 72.33% with AUC 0.827 for own-race faces, 66.67% with AUC 0.746 for other-race faces, and 75.89% with AUC 0.865 combining both face types. EEG plus eye tracking: maximum 85.44% with AUC 0.93 at 32 selected features. The modality ladder is therefore 68% to 75.89% to 85.44%, a gain of roughly 10 points from fusion over the better single " ;
                    slr:outcome "Accuracy and AUC, reported per modality and per stimulus type. No sensitivity, specificity, confusion matrix, confidence interval or statistical comparison between conditions" ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "EEG alone (five relative power bands) 68%. Eye tracking alone: 72.33% with AUC 0.827 for own-race faces, 66.67% with AUC 0.746 for other-race faces, and 75.89% with AUC 0.865 combining both face types. EEG plus eye tracking: maximum 85.44% with AUC 0.93 at 32 selected features. The modality ladder is therefore 68% to 75.89% to 85.44%, a gain of roughly 10 points from fusion over the better single ; Combining resting-state EEG spectral power with gaze allocation during face viewing raised autism classification accuracy to 85.44% (AUC 0.93), against 68% for EEG alone and 75.89% for gaze alone - a substantial and cleanly reported fusion benefit. The behavioural findings are consistent with the reduced social-attention literature: autistic children spent far more fixation time on the image backg" ] ] ;
