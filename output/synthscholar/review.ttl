    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Hyperparameters for the three classical models were grid-searched with no validation set distinct from the reported test data, and the winning configuration is the best of four models compared on the same split. No text representation is described for the classical models, and no operating point or threshold was prespecified. Classification is automated and blind to labels at inference, but nothing in the pipeline was ever exercised on a writer it had not seen." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "The label is unverified self-disclosure in a public social-media biography, with no diagnosis, instrument, criterion or verification of any kind, and the authors acknowledge that biographies may be false and that accounts may be written by someone other than the owner. The negative label is weaker still: the 31 comparison users are defined only by not stating that they are autistic, with no screening, and their selection is not described at all. The quantity predicted is the presence of an autism keyword in a profile, not the presence of autism." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Convenience sampling of 252 public Twitter accounts, 221 selected by keyword search of biographies for autism-related terms and 31 comparison accounts whose selection process is never described. No demographic information exists for either group, no matching was attempted or possible, and the comparison group was not screened for undisclosed autism. The self-selection is severe: the positive class consists entirely of people who both are autistic and choose to say so publicly on social media, a group likely to be verbally fluent, digitally engaged and often diagnosed in adulthood." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "The 90,000 modelled tweets are treated as independent units although they come from 252 authors, with the entire negative class of 45,000 tweets drawn from just 31 people. A single random 75/25 split over tweets places the large majority of each author's output in training alongside their own test tweets. No user-level result is reported, no cross-validation or repeated split is performed, and the 60% corpus reduction during cleaning is not broken down by user or group." ] ;
            slr:overall_judgment "high" ;
            slr:tool_used "QUADAS-2" ] .

<urn:slr:article:9c6671adbfae> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Machine learning’s effectiveness in evaluating movement in one- legged standing test for predicting high autistic trait Yoshimasa Ohmoto 1, Kazunori Terada 2, Hitomi Shimizu 3, Hiroko Kawahara 3, Ryoichiro Iwanaga 4 and Hirokazu Kumazaki 2,4* 1Department of Behavior Informatics, Faculty of Informatics, Shizuoka University, Shizuoka, Japan, 2Department of Electrical, Electronic, and Computer Engineering, Faculty of Engineering, Gifu University, Gifu, Japan, 3Department of Neuropsychiatry, Graduate School of Biomedical Sciences, Nagasaki University, Nagasaki, Japan, 4Unit of Medical Science, Nagasaki University Graduate School of Biomedical Sciences, Nagasaki, Japan" ;
    dcterms:bibliographicCitation "Ohmoto Y; Terada K; Shimizu H; Kawahara H; Iwanaga R; Kumazaki H (2024). Machine learning’s effectiveness. *Frontiers*." ;
    dcterms:creator "Iwanaga R",
        "Kawahara H",
        "Kumazaki H",
        "Ohmoto Y",
        "Shimizu H",
        "Terada K" ;
    dcterms:title "Machine learning’s effectiveness" ;
    bibo:pmid "local_1e9d0b71" ;
    fabio:hasPublicationYear 2024 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Participant selection and spectrum representativeness" ;
                            slr:justification "Approximately 99% of one municipality's five-year-old population, assessed in situ during routine examinations. Coverage is near-complete and self-selection is minimal; the sample represents the full trait distribution of that cohort rather than a recruited slice." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Confounder control" ;
                            slr:justification "Age is controlled by design, every participant being five years old, which removes the confound that troubles every other motor study here; sex ratio does not differ and the SRS-2 cut-off is sex-specific. But no cognitive, developmental or motor-maturation measure was obtained, so at an age when postural control is still developing a general developmental explanation cannot be separated from an autistic-trait-specific one." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Handling of missing data and attrition" ;
                            slr:justification "No attrition is reported and all 126 participants appear in the analysis. But no signal-quality criterion is described for either the pressure or the pose stream, and no handling of OpenPose failure is reported - relevant because the study's discriminative features depend entirely on the estimated joint angles." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Comparison group adequacy" ;
                            slr:justification "The comparison group is the remainder of the same population cohort below the SRS-2 cut-off - a within-population contrast rather than a recruited control group, which is the correct design for a screening question and is unique in this review alongside the population health-records study." ;
                            slr:rating "Low" ] ;
                    slr:overall_concern "low" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Reference standard quality" ;
                            slr:justification "A maternal-report SRS-2 total dichotomised at a published cut-off, with no clinical assessment, diagnostic instrument, second informant or reliability estimate for any participant. The authors acknowledge this and recommend integrating clinical evaluation." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Outcome measurement blinding" ;
                            slr:justification "Feature extraction and classification are automated from sensor and pose data; the SRS-2 was completed by mothers independently of the balance testing and before it entered any analysis." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Index test definition and prespecification" ;
                            slr:justification "Feature selection and hyperparameter optimisation performed jointly, reducing sixteen variables to three to five per model, with nesting relative to the cross-validation loop unstated; three variable sets compared on the same participants; no prespecified operating point." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Measurement standardisation" ;
                            slr:justification "One pressure sensor, one webcam model and resolution, a fixed 20 Hz synchronised acquisition, a documented physical configuration, and a standard clinical balance test administered identically to every child within a single routine examination programme. The task requires no verbal or social demand, so a motor measurement is obtained without social confound." ;
                            slr:rating "Low" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Sample size adequacy for the modelling" ;
                            slr:justification "Nineteen above-threshold participants for a model selecting three to five features from sixteen. The authors identify this directly, noting that with 'only around 20 above-threshold samples and highly imbalanced sample overall' they were constrained in their choice of validation scheme." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Preprocessing and feature selection nesting" ;
                            slr:justification "Three to five of sixteen variables plus a cost parameter selected per model by a procedure whose nesting within the cross-validation is nowhere stated. On 126 participants with 19 positives this alone would be sufficient to produce the reported perfect scores." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Data splitting and leakage control" ;
                            slr:justification "Leave-one-out cross-validation over participants, each contributing a single feature vector, so within-participant leakage is impossible. But the joint feature-selection and hyperparameter-optimisation step is described without reference to the folds, leaving the most consequential leakage question unresolved." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Performance estimation and chance level" ;
                            slr:justification "Accuracy, sensitivity and specificity all exactly 1.000 for two of three configurations, reported without a majority-class baseline against an 84.9% floor, without confidence intervals on a sensitivity estimated from 19 positives, and without comment on the implausibility of perfect separation in a behavioural measurement. Sensitivity and specificity are at least reported separately, which is essential at this prevalence." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Completeness of methods reporting" ;
                            slr:justification "Population and sampling basis, inclusion criterion, instrument and cut-offs with their source, sensor and camera specifications, synchronised sampling rate, pose-estimation method with joints figured, all sixteen variables named and categorised, the three variable sets, the SVM kernel and cost parameter and the selected variables for each best model, the validation scheme and the statistical software with version. Supplementary materials give per-variable rationale and calculation. The nesting of feature selection is the one substantive omission." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Reporting of results and uncertainty" ;
                            slr:justification "Accuracy, sensitivity and specificity per variable set with the selected variables named; SHAP across all participants; and correlation of predicted probability with continuous SRS-2. But no confidence intervals, AUC, confusion matrix, chance baseline or positive predictive value - the last being directly computable and directly relevant given the population-based design." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Acknowledgement of limitations" ;
                            slr:justification "Four limitations named, including the screening rather than diagnostic nature of the target with a recommendation to integrate clinical assessment, the small above-threshold sample, the single algorithm family, and the need for external validation - and, unusually, an explicit statement that the chosen validation scheme 'can produce optimistic performance estimates due to the small test set in each iteration' with a call for cautious interpretation. The nesting question is not addressed." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Data, code and protocol availability" ;
                            slr:justification "Contributions stated to be included in the article and supplementary material, with further inquiries directed to the corresponding author. No code, no dataset deposit, no preregistration." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Ethics, consent and conflicts" ;
                            slr:justification "Nagasaki University Ethics Committee approval with number 22051204, Declaration of Helsinki conformity, and written informed consent from both the children and their guardians after a comprehensive explanation. Four funding sources itemised and competing interests declared as none." ;
                            slr:rating "Low" ] ;
                    slr:overall_concern "low" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Accuracy, sensitivity and specificity for each of three variable sets, reported alongside the named variables and cost parameter of each best model; SHAP values displayed for all participants; and correlations between SRS-2 total and predicted probability. Reporting sensitivity and specificity separately is essential at 15.1% prevalence and is done. But three gaps matter. No majority-class baseline is stated, so the reported 1.000 is not placed against the 84.9% floor that a trivial all-negative classifier would achieve - although sensitivity of 1.000 does establish that all 19 positives were caught, which a trivial classifier could not do. No AUC, confusion matrix or confidence interval appears; on 19 positives, an exact binomial interval around a sensitivity of 1.000 would extend below 0.82, which is the figure a reader needs. And no positive predictive value is computed, despite the population-based design making it directly meaningful - at the observed 15.1% prevalence and perfect specificity it would be 1.000, but any realistic degradation in specificity would move it sharply, and that sensitivity analysis is exactly what a screening proposal requires." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-121" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Keywords: autistic trait, machine learning, balance, one-legged standing, screening. The set is precise and honest - 'autistic trait' rather than autism, and 'screening' rather than diagnosis, both of which accurately describe what the study does. Terms carried through the body: centre of pressure, convex hull, sway entropy, centre of mass, joint angle correlation, feed-forward process, anticipatory postural control, SHAP, leave-one-out cross-validation, Social Responsiveness Scale." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-121" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "One hundred and twenty-six five-year-olds - 64 boys and 62 girls - constituting approximately 99% of the five-year-old residents of Sazacho, Nagasaki Prefecture, assessed during their routine preschool medical examinations. This is a whole-population age cohort rather than a recruited sample, and it is the second study in this review with genuinely population-based sampling, alongside the Israeli well-baby records study. Group assignment used the Social Responsiveness Scale, Second Edition completed by mothers, dichotomised at published sex-specific Japanese cut-offs of 53.5 for boys and 52.5 for girls: 19 children (9 boys, 10 girls) fell above and 107 (55 boys, 52 girls) below, giving a 15.1% above-threshold rate. The groups differ sharply on the defining variable (SRS-2 69.79 +/- 23.66 against 31.24 +/- 11.48, t = -6.956, p < 0.001) and not on age (all five) or sex ratio (p = 0.81). The unit of analysis is the child, with one 16-dimensional feature vector each." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-121" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "'Children with autism spectrum disorder' and 'children with high autistic trait' are used precisely and the distinction is maintained throughout - the outcome is consistently named 'High autistic trait group' rather than autism, in the title, abstract, methods, results and conclusion. That precision is unusual in this corpus and matters, because the study measures a screening-questionnaire threshold rather than a diagnosis and says so. Clinical description is standard medical-model - 'deficits in social communication and social interactions and repetitive, restricted behaviors', 'motor impairments', 'balance impairments', 'deficiency in balance ability' - and the introduction opens with a cost framing, citing an estimated lifetime social cost of approximately $3.6 million per individual. Against this, the discussion of why balance matters is developmental and person-centred rather than diagnostic: poor balance 'increases the risk of falls among affected children which diminishes their motivation to participate in physical activities', and balance impairments 'can hinder the development of communication and motor skills, limit the children's integration into mainstream society, and adversely affect their social adaptation abilities'. There is no neurodiversity framing and no autistic-community involvement." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-121" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Genuine two-sensor fusion, and the fusion is constitutive rather than additive. A pressure sensor supplies centre of pressure and a webcam supplies joint angles via pose estimation, synchronised at 20 Hz - and the study's proposed variables are precisely the correlations between the two streams, so neither sensor alone could produce them. The ablation is reported across three configurations and is informative: conventional variables derived from the pressure sensor alone gave the weakest accuracy and sensitivity, the proposed cross-sensor correlation variables reached perfect scores on their own, and the combined set also reached perfect scores. That ordering says that the information distinguishing the groups lies in the relationship between body movement and base-of-support movement rather than in either measured separately, which is a more specific and more mechanistically meaningful fusion result than the accuracy gains reported by most multimodal studies in this corpus. The caveat is that all three configurations share the same feature-selection procedure and the same evaluation, so the ordering is more trustworthy than the absolute values - and with two of the three reaching exactly 1.000, the comparison has no headroom to discriminate further." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-121" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "There is none in the diagnostic sense, and the study is explicit about this. Group membership rests entirely on maternal completion of the SRS-2 and application of published sex-specific screening cut-offs; no child received a clinical assessment, ADOS, ADI-R or diagnostic evaluation of any kind. The authors state the consequence directly, recommending that the method form 'part of a comprehensive assessment process that includes clinical evaluation and other standardized measures' and that 'integrating more robust diagnostic tools for ASD, such as clinical assessments or standardized behavioral tests, alongside the SRS-2, would improve the reliability of the screening process'. This places the study in a different category from the diagnostic studies charted elsewhere in this review: what is predicted is whether a mother's questionnaire responses about her child exceed a threshold, which is a legitimate screening target but not autism. Three specific consequences follow. Single-informant report carries known biases and no second informant or reliability statistic is available. A dichotomy imposed on a continuous scale creates borderline cases whose classification is arbitrary, which matters for a model reporting perfect separation. And the 19 above-threshold children are a screening-positive group of whom, at a population SRS-2 cut-off, a substantial proportion would not receive an autism diagnosis on assessment." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-121" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Postural control during single-leg stance, decomposed into three families with a clear theoretical rationale. The conventional family follows prior work: centre-of-pressure path length, mean speed, entropy and convex-hull area, together with the duration of the longest stand, capturing how much and how variably the base of support moves. The proposed family is the study's contribution and captures something different - the correlation between centre-of-pressure movement and the angle of each of ten joints (neck, shoulder, both elbows, both trunk sides, both hips, both knees), plus the difference between centre-of-mass and centre-of-pressure. These measure not how much the child sways but how the body's segments move in relation to the sway, which is a coordination rather than a magnitude construct. The empirical result supports the distinction: the conventional sway variables alone performed less well, while the proposed correlation variables achieved perfect separation, and SHAP attribution identified shoulder, hip and trunk as the dominant contributors. The authors' reading - that upper-body and waist coordination with the base of support is what differentiates children with high autistic traits - is a specific, mechanistically interpretable claim about anticipatory and compensatory postural control rather than about balance ability in general. The paper also flags the transition from two-legged to one-legged stance as a feed-forward process worth examining separately, which is a construct-level insight most balance studies do not articulate." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-121" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Frontiers in Psychiatry 15:1464285, Original Research, open access under CC BY; received 13 July 2024, accepted 30 September 2024, published 17 October 2024. Editorial and review handling is disclosed by name as Frontiers requires, and the reviewers include a researcher whose own work on movement analysis in autism is cited in this review's corpus - an indication that the paper was assessed within the relevant specialist community. The venue's structure produces the ethics, funding, competing-interests and data-availability statements, and supplementary materials carry the per-variable rationale and calculation methods that would not fit the main text." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-121" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The one-legged standing test, administered on a pressure sensor with the child facing the experimenter and multiple trials conducted. Four properties make it well suited to the purpose. It is a standard clinical balance assessment with an established literature, so the construct is not invented for the study. It is brief and requires no verbal instruction beyond the request to stand on one leg, no stimulus, no screen and no social interaction - so a motor measurement is obtained without the social demand that confounds several other motor studies in this review. It was already part of the routine medical examination, which is what made near-complete population coverage feasible. And the authors identify a specific analytic target within it that most balance studies overlook: the transition from two-legged to one-legged standing, which they treat as 'a feed-forward process that is necessary to achieve the one-legged standing outcome' and therefore as informative about anticipatory postural control rather than only about steady-state sway. Limitations of the paradigm are that a single brief task samples a narrow slice of balance ability - the authors call for 'a broader range of balance cues' - and that no test-retest data exist, so the stability of the measures within a child is unknown." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-121" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A linear-kernel support vector machine, with the cost parameter reported (0.01 for the two best models) and between three and five variables selected from sixteen per configuration. The choice of a linear SVM on interpretable biomechanical features is well matched to 126 participants with 19 positives, and the reported model equations - high autistic trait group as a function of named variables - make each fitted model fully transparent. Only one algorithm family was tried, which the authors identify as a limitation and propose remedying by comparison against random forests or deep learning. The more consequential modelling detail is that feature selection and hyperparameter optimisation were performed jointly in a single procedure described in one sentence, with the stated purpose of improving 'performance and generalization of all SVM classification models' - so the search is doing substantial work, reducing sixteen candidates to three to five while also fixing the regularisation, and its relationship to the cross-validation loop is not specified." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-121" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A 16-dimensional summary vector per child. Time-series pressure and pose data are compressed into scalar descriptors: path length, mean speed, entropy and convex-hull area for centre-of-pressure; longest-trial duration for overall balance; and ten joint-wise correlations plus the centre-of-mass to centre-of-pressure difference for the body-pressure relationship. This is aggregation rather than sequence modelling, so the temporal unfolding of a stance is not represented except insofar as entropy and correlation capture it. The correlation features are nonetheless well chosen for the construct: a correlation between a joint angle and centre-of-pressure position is inherently relational and cannot be computed from either stream alone, and it summarises coordination in a single interpretable number. Every variable is named, categorised and explained, with the rationale and calculation method for each given in supplementary material." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-121" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The limitations passage is among the most self-critical in this review and names four constraints, one of them unprompted by convention. The target is a screening cut-off rather than a diagnosis, and the authors recommend that clinical assessment be integrated alongside the SRS-2. The above-threshold sample is small at around 20, and the class imbalance is acknowledged as the reason for choosing leave-one-out cross-validation 'to avoid polarization of prediction toward the Low autistic trait group'. Only an SVM was tried. And external validation on other regions and institutions is needed. Most notably, the authors state the specific hazard their own validation choice creates: 'LOOCV can also produce optimistic performance estimates due to the small test set in each iteration. In addition, it can be unstable when the dataset contains noise or outliers, as individual data points can disproportionately influence the results. These limitations emphasize the need for cautious interpretation of our results.' Naming the optimism of one's own evaluation scheme is rare here. What is not addressed is the more consequential question. The paper states that the procedure 'simultaneously selected the 16 explanatory variables and optimized the hyperparameter', with three to five variables plus a cost parameter chosen per model from sixteen candidates on 126 participants of whom 19 are positive - and it does not say whether that selection occurred inside each leave-one-out fold. If it did not, unnested selection on this configuration would by itself be sufficient to produce accuracy, sensitivity and specificity of exactly 1.000, and the perfect scores would carry no information. Also unaddressed: no majority-class baseline against an 84.9% floor, no positive predictive value despite a genuinely population-based design that could support one, no developmental measure to separate autistic-trait effects from general motor maturation in five-year-olds, and single-informant SRS-2 with no reliability estimate." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-121" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Strong, and directed at the study's substantive question rather than at post-hoc justification. Every one of the sixteen variables is a named biomechanical quantity with its rationale and calculation given in supplementary material, so an attribution is interpretable without further translation. SHAP values are computed for each of the three variable sets and displayed across all participants, and the variables selected by each model are named in the results table - so a reader can see not only which features mattered but which entered each fitted model. The convergent finding across SHAP and model selection, that shoulder, hip and trunk correlations dominate, supports a specific claim about where in the body the difference lies. Most valuable is the continuous check: predicted probability is correlated with SRS-2 total score for each variable set, testing whether the model tracks the underlying trait dimension or merely reproduces the imposed threshold, with a positive relationship reported in every case. That analysis is the one this review has repeatedly noted as absent elsewhere, and it is performed here on the study's own severity variable. What is missing is per-participant error analysis - though with perfect classification there are no errors to analyse, which is itself a reason for scepticism about the perfect scores." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-121" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional, single session, no follow-up and no test-retest reliability. The absence of repeat measurement is a real gap for a proposed screening instrument, since a threshold decision on a single brief balance trial requires knowing how stable that trial is within a child. Ethics reporting is complete: approval by the Ethics Committee of Nagasaki University under number 22051204, procedures conducted in accordance with institutional and national standards and the 1964 Declaration of Helsinki and its amendments, and written informed consent obtained from both the children and their guardians after a comprehensive explanation - the participants section specifies 'all subjects and their guardians provided written informed consent', so assent as well as parental consent. Funding from two JSPS Grants-in-Aid, JST MIRAI and JST CREST is itemised, and competing interests are declared as none." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-121" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A local preschool in Sazacho, Nagasaki Prefecture, during the pupils' routine medical examinations, capturing approximately 99% of the town's five-year-olds. Three features of this setting distinguish it from the recruitment geometry of almost every other study in this review. There is no case-control contrast: both groups come from the same population and differ only in where their SRS-2 score falls, so the spectrum-truncation problem that inflates diagnostic studies does not arise. The measurement is embedded in an examination the children were attending anyway, so it imposes no additional burden and the participation rate is near-total, eliminating the self-selection that affects recruited samples. And the setting is exactly the deployment setting the paper proposes - preschool screening before elementary education - so the data were collected under the conditions in which the method would be used. The corresponding limitation is geographic narrowness: a single small municipality, which the authors identify when calling for validation on datasets from different regions or institutions." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-121" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Sparse but well controlled by design rather than by adjustment. Reported: group sizes, sex ratio with a chi-square test (p = 0.81), age with a t-test (non-significant, and in any case every participant was five years old by inclusion criterion), and SRS-2 total scores per group with a t-test. Not measured: IQ, developmental level, language, adaptive functioning, socioeconomic status, comorbidity or medication. Two features of the design substitute effectively for adjustment on the variables that matter most in a postural study. Restricting the sample to a single age year removes the age confound that troubles most motor studies in this review - postural control changes rapidly between three and six, and every other motor study charted here spans several years. And the sex-specific SRS-2 cut-off means that sex is handled within the outcome definition rather than left as a group difference, which combined with the balanced observed ratio makes sex an unlikely driver. What remains unaddressed is developmental level: no cognitive or motor-development measure was obtained, so at an age when balance is still maturing a general developmental explanation cannot be distinguished from an autistic-trait-specific one. The sample is also drawn entirely from one small Japanese municipality, so the SRS-2 cut-offs, though taken from published Japanese population distributions, are applied to a single local cohort." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-121" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The aim is to test whether machine-learning analysis of movement during the one-legged standing test can identify five-year-olds with high autistic traits, motivated by a specific timing gap: autism can be detected at 14 months and diagnosed reliably by two years, yet over 70% of affected children are not diagnosed until after 51 months, so screening before elementary school entry is needed. Balance is chosen because prior behavioural work reports that autistic children show smaller centre-of-pressure shift, more repetitive centre-of-pressure patterns and less complex postural control in both static and dynamic states, and because the one-legged standing test is already a standard clinical assessment - so the measurement can be added to a routine examination at essentially no cost. Findings: accuracy, sensitivity and specificity all reached 1.000 for the study's proposed variable set (correlations between centre-of-pressure and shoulder, right trunk and right knee angles) and for the combined set, while the conventional variable set based on prior literature performed less well on accuracy and sensitivity though it also achieved specificity of 1.000. SHAP attribution identified shoulder, hip and trunk as the dominant contributors. And SRS-2 total correlated positively with predicted probability across all three variable sets. The substantive claim is therefore not that balance differs in magnitude but that the coordination between upper body and the shifting base of support differs - the conventional sway measures are the weaker predictors and the novel correlation measures are what produce the separation." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-121" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Deliberately modest and fully specified. A 48 cm square LL pressure sensor from NEWCOM Inc. captured plantar pressure distribution; a Logitech c615n webcam at 640 x 480 and 30 fps, placed in front of the child, captured full-body images; the two streams were acquired synchronously at 20 Hz, and the physical configuration of participant, experimenter, camera and sensor is documented in a figure. Joint angles at ten body points were estimated from the video using OpenPose. Statistical analysis used SPSS 27.0. The equipment choice matters for the translational claim: a consumer webcam plus a single pressure mat, with open-source pose estimation, is deployable in a preschool examination room, which is the setting the paper targets. What is not reported is any calibration, signal-quality criterion or handling of pose-estimation failure - relevant because OpenPose accuracy on 640 x 480 video of a five-year-old at unspecified distance is not guaranteed and the study's proposed features depend entirely on the joint angles it produces." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-121" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Well reported. Available from the text: the population, its 99% coverage and the single-age inclusion criterion; the SRS-2 with its sex-specific cut-offs and their published source; the pressure sensor make and size; the webcam model, resolution and frame rate; the 20 Hz synchronised acquisition; OpenPose with its ten joints figured; all sixteen variables named and grouped into three categories; the composition of the three variable sets; the SVM kernel and the cost parameter for each best model; the named variables selected by each model; the leave-one-out scheme; and the statistical software with version. Supplementary materials carry the rationale and calculation method for each explanatory variable and further detail on model construction and evaluation. Not available: code, the dataset, and - the one gap that affects interpretation - whether the joint feature-selection and hyperparameter-optimisation procedure was performed inside or outside the cross-validation loop." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-121" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The SRS-2 total score is the study's only clinical measure, and it serves three roles - defining the groups, characterising them (69.79 +/- 23.66 against 31.24 +/- 11.48), and, most valuably, functioning as a continuous validity check. The authors correlate SRS-2 total with the model's predicted probability of high-trait membership for each of the three variable sets and report a positive relationship in every case. This is the analysis most studies in this corpus fail to perform even when the data are available: it tests whether the model's output tracks the underlying trait dimension or merely reproduces the imposed dichotomy, and a positive continuous relationship is evidence for the former. The authors also identify the natural extension, stating that they 'intend to consider developing a continuous SRS score prediction model as a next step' - which would convert a screening classifier into a trait-estimation instrument. No cognitive, language, adaptive or motor-development measure was obtained for any child." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-121" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Correct on the split unit and ambiguous on the step that matters. The evaluation is leave-one-out cross-validation over 126 participants, each contributing one 16-dimensional vector, so the unit is the person and within-participant leakage is impossible. The class imbalance is acknowledged and drives the choice of scheme, with the authors stating that with around 20 above-threshold samples they 'were forced to use LOOCV to avoid polarization of prediction toward the Low autistic trait group'. They then state the risk this creates in their own words - that leave-one-out 'can also produce optimistic performance estimates due to the small test set in each iteration' and 'can be unstable when the dataset contains noise or outliers' - and conclude that their results need cautious interpretation. That is the right instinct, but it does not reach the decisive issue. The methods state that the procedure 'simultaneously selected the 16 explanatory variables and optimized the hyperparameter', and three to five variables plus a cost parameter were retained per model from sixteen candidates on 126 participants of whom 19 are positive. Whether that joint selection was repeated inside each of the 126 folds is not stated anywhere in the main text. If it was not - and the sentence's placement before the description of cross-validation suggests it may not have been - then the selection saw every participant's label, and on this configuration that alone is sufficient to produce accuracy, sensitivity and specificity of exactly 1.000. Perfect scores on all three metrics for a behavioural measurement in five-year-olds are not a plausible property of the phenomenon, and unnested selection is the most parsimonious explanation. Three further points: no majority-class baseline is given against an 84.9% floor; no confidence interval accompanies a sensitivity estimated on 19 positives; and the three variable sets were compared on the same 126 participants. The corrective is straightforward and would leave the study's substantive contribution intact - nest the selection, report the resulting accuracy with an interval, and add the positive predictive value that the population-based design uniquely permits." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-121" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Six directions, all specific. Develop a continuous SRS score prediction model rather than a dichotomous classifier - the most valuable of them, since it would convert a threshold decision into a trait estimate and is already supported by the observed correlation between SRS-2 and predicted probability. Integrate clinical assessments or standardised behavioural tests alongside the SRS-2 to strengthen the reference standard. Obtain a larger and more balanced sample above the threshold. Compare the SVM against random forests or deep learning. Validate on external datasets from different regions or institutions. And incorporate a broader range of balance cues. Not proposed, and needed: reporting whether feature selection was nested, and computing positive predictive value at the observed population prevalence." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-121" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Published 2024 by informatics and engineering groups at Shizuoka and Gifu Universities with neuropsychiatry and medical sciences at Nagasaki University, funded by two JSPS Grants-in-Aid together with JST MIRAI and JST CREST. The framing is a timing gap stated with unusual precision: autism can be detected at 14 months and diagnosed with high accuracy by two years, yet more than 70% of affected children are not diagnosed until after 51 months, so identifying autistic traits before elementary school entry is the target. The chosen route is to instrument an assessment that already happens - the one-legged standing test within a routine preschool medical examination - which is why near-complete population coverage was achievable. For this review the study is valuable on four counts. It is one of only two with genuinely population-based sampling, and the only one whose comparison group is simply the rest of the same age cohort, so the spectrum-truncation problem that inflates the diagnostic studies does not arise at all. Its measurement is embedded in an existing examination with a consumer webcam and a single pressure mat, so the deployment claim is credible rather than aspirational. Its cross-sensor fusion is constitutive rather than additive, with the discriminative features being correlations between body movement and base-of-support movement that neither sensor could produce alone - and the ablation shows those features outperforming the conventional sway measures drawn from prior literature. And it correlates its model's output with the continuous SRS-2 score, testing whether the prediction tracks the trait dimension rather than only the imposed threshold. Against all this stands a single unresolved question: whether the joint feature-selection and hyperparameter-optimisation procedure was nested within the leave-one-out loop. On 126 children with 19 positives, selecting three to five of sixteen variables plus a cost parameter would by itself explain accuracy, sensitivity and specificity of exactly 1.000, and the paper does not say. The authors' own warning that their validation scheme 'can produce optimistic performance estimates' should be read as applying with more force than they intend." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-121" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:study_design "Cross-sectional population-based screening study embedded in routine preschool medical examinations, with a classification analysis distinguishing children above and below an SRS-2…" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: ; comparison: 107 in the low autistic trait group (55 male, 52 female)" ] ] ;
    slr:content_sha256 "dda8230860b0765d337a1b88c7b773c85da6c3982d6ec675825e8e14eccdc4f6" ;
