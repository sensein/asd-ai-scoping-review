        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "This study acknowledges certain limitations, such as potential biases in the collected dataset, which may arise from users providing false information in their biographies or from tweets being authored by someone other than the profile owner." ] ;
            oa:hasTarget <urn:slr:article:7d280d7f3a95> ;
            slr:claim_label "The only two limitations acknowledged, both about label truthfulness; nothing is said about the tweet-level split, the 31-user negative class, topic confounding, or the absence of any ethics approval." ;
