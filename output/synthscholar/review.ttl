                    slr:supporting_quote "All recruitment, exclusion and balancing steps are reported precisely - 3 ASD and 2 control exclusions for calibration and head-movement data loss, plus 1 random control removal for class balance, and the discrepancy with a prior publication's participant count is footnoted." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "low" ;
