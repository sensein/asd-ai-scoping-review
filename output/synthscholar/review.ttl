        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "Depending on the subject's height it was necessary to sit him/her on the lap of an adult. In these cases, the adult used a blindfold in order to avoid influencing the signals acquired. All selected subjects had more than 80% of the total video time captured by the eye tracking equipment." ] ;
            oa:hasTarget <https://doi.org/10.1038/s41598-021-89023-8> ;
