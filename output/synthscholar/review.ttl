    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "All 35 recruited children are individually tabulated with their recording counts and the 8 undiagnosed at-risk children are transparently excluded, but data volume varies by nearly three orders of magnitude between subjects (4 to 1968 recordings) with no minimum-data inclusion threshold." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "No diagnostic instrument, criteria, clinician or date is reported for the ASD group, and typically developing status is asserted with no screening whatsoever." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "Leave-one-subject-out with a separate 8-subject development set for all hyperparameter tuning, unweighted F1 for imbalanced classes, and age and gender deliberately excluded as features to prevent exploitation of recruitment-correlated demographics." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "27 analysed children spanning 3 months to 17 years with no age or gender matching, no group-level demographic statistics and no comparability testing; toddlers are concentrated in the ASD group and teenagers among controls, confounding vocal maturation with diagnosis on a voice-feature task." ] ;
            slr:overall_judgment "high" ;
            slr:tool_used "QUADAS-2" ] .

<https://doi.org/10.1145/3371382.3378382> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Behavior-based Risk Detection of Autism Spectrum Disorder Through Child-Robot Interaction HIFZA JAVED, The George Washington University, Washington, D.C., United States . CHUNGHYUK PARK, The George Washington University, Washington, D.C., United States . . . Open Access Support provided by: . The George Washington University . PDF Download 3371382.3378382.pdf 08 February 2026 Total Citations: 10 Total Downloads: 278 . . Published: 23 March 2020 . . Citation in BibTeX format . . HRI '20: ACM/IEEE International Conference on Human-Robot Interaction March 23 - 26, 2020 Cambridge, United Kingdom . . Conference Sponsors: SIGCHI SIGAI HRI '20: Companion of the 2020 ACM/IEEE International Conference on Human-Robot Interaction (March 2020) hps://doi.org/10.1145/3371382.3378382 ISBN: 9781450370578 . Behavior-based Risk Detection of Autism Spectrum Disorder Through Child-Robot Interaction Hifza Javed Department of Biomedical Engineering The George Washington University Washington, DC, USA hifzajaved@gwu.edu Chung Hyuk Park Department of Biomedical Engineering The George Washington University Washington, DC, USA chpark@gwu.edu ABSTRACT This work presents a method to identify children at risk for Autism Spectrum Disorder using behavioral data extracted from video analysis of child-robot interactions. Robots were used as a tool to elicit social engagement from the children in order to capture their social behaviors. A Convolutional Neural Network was used to classify the behavioral data as either at-risk ASD or Typical Development. The network performance was compared to two machine learning classifiers and the utility of the proposed method as a way to streamline existing diagnostic procedures was discussed." ;
    dcterms:bibliographicCitation "Javed H; Park CH (2020). Behavior-based Risk Detection of Autism Spectrum Disorder Through. *Companion of the 2020 ACM/IEEE International Conference on Human-Robot Interaction (pp*. https://doi.org/10.1145/3371382.3378382" ;
    dcterms:creator "Javed H",
        "Park CH" ;
    dcterms:title "Behavior-based Risk Detection of Autism Spectrum Disorder Through" ;
    bibo:doi "10.1145/3371382.3378382" ;
    bibo:pmid "local_1579c85a" ;
    fabio:hasPublicationYear 2020 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are comparison groups matched?" ;
                            slr:justification "No matching or comparability test; means differ by 0.8 years with unequal variances; both groups exclusively male." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the sample appropriate and adequate for the stated target?" ;
                            slr:justification "12 children, all male - the smallest sample charted in this corpus." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is sex homogeneity acknowledged?" ;
                            slr:justification "The authors explicitly list 'the inclusion of a single gender' as a limitation." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are participants and recruitment adequately described?" ;
                            slr:justification "Group sizes, sexes, mean ages and interaction durations reported; no recruitment route, diagnostic route or additional characteristics." ;
                            slr:rating "Partly" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the elicitation ecologically valid?" ;
                            slr:justification "Unrestricted movement, no obtrusive sensors, naturalistic robot-mediated play." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the behavioral data acquisition described reproducibly?" ;
                            slr:justification "Interaction scenario, robot types, feature pipeline and window length are described; recording equipment, camera placement and session protocol are not." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are predictors defined without knowledge of outcome?" ;
                            slr:justification "OpenPose and Laban feature extraction are fully automatic from video." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the reference standard appropriate and independently applied?" ;
                            slr:justification "No diagnostic information of any kind." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the sample size adequate?" ;
                            slr:justification "12 children; acknowledged by the authors." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is there external or independent validation?" ;
                            slr:justification "None." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are simpler comparators included?" ;
                            slr:justification "Random forest and KNN reported alongside the CNN, with the null result stated plainly." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the validation partitioned at participant level?" ;
                            slr:justification "Not stated; the unit is the 1-second window with ~18,597 per subject." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is cross-validation or repeated splitting used?" ;
                            slr:justification "A single 80/20 split, with validation and test not distinguished." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are ethics and consent reported?" ;
                            slr:justification "IRB approval with a specific protocol number; no parental consent or child assent statement despite published video stills of participants." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is a null model-comparison result reported?" ;
                            slr:justification "All three classifiers performing equivalently is reported and interpreted as simpler methods sufficing." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is code available?" ;
                            slr:justification "None; no frameworks, versions or training hyperparameters." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are claims proportionate to the evidence?" ;
                            slr:justification "The authors decline to claim diagnostic readiness on the basis of the false negative rate and frame the method as a screening layer." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is any behavioral finding reported?" ;
                            slr:justification "No feature importance or interpretation, so no characterisation of how the groups differed." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the dataset accessible or its access conditions stated?" ;
                            slr:justification "No data availability statement." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "high" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Supervised learning with a deliberate depth comparison: a 1D convolutional neural network chosen for its suitability to ordered temporal data, benchmarked against random forest and k-nearest neighbour, which the authors describe as having 'simpler structures than a deep CNN with fewer hyperparameters that require fine-tuning'. Reporting a null result from this comparison - that all three perform equivalently - is a strength." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-038" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Goal: behavior-based risk detection to streamline standard diagnostic procedures through rapid detection and clinical prioritisation of at-risk children. Main findings: CNN 0.8846 accuracy, 0.8912 precision, 0.8853 recall; random forest 0.8852/0.8876/0.8856; KNN 0.8874/0.8920/0.8878 - all three within 0.003 of one another; false negative rate 0.1787. The authors conclude that simpler methods suffice at this scale and that the method is not ready for standalone diagnostic use." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-038" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Hardware: two robots (a small humanoid and an iPod-based mobile robot) in a sensory maze setup on a table; video recording equipment (unspecified). Software: OpenPose for upper-body tracking and facial keypoint extraction; Laban movement analysis for deriving weight, space and time movement-intent features; a custom 1D CNN with specified layer structure and dropout rate; random forest and k-nearest neighbour comparators. No frameworks, versions or hyperparameters beyond the dropout rate and layer counts are given." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-038" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The weakest dimension. A single 80/20 split with no cross-validation, no repeated splits and no separation between validation and test sets, and - decisively - no statement that partitioning occurred at child level, when the discussion makes clear the unit is the 1-second data window with approximately 18,597 per subject. Dropout at 20% across four layers is the only overfitting control described. There is no external validation, no permutation testing, no class-imbalance handling despite 5 versus 7 children, and no calibration or deployment analysis. The authors do reason about deployment readiness qualitatively, correctly declining to claim diagnostic utility, but generalisation is addressed only through the aspiration to collect more data." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-038" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None reported. No cognitive, linguistic, adaptive or severity measures for either group, and no comorbidity information." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-038" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two behavioral streams from video: upper-body movement (characterised through Laban weight, space and time features intended to capture movement intent) and facial configuration (68 keypoints from the nose and eye regions). Notably the facial keypoints are geometric landmark positions rather than expression classifications, so the model sees face shape and pose rather than interpreted emotion." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-038" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2020. The brief related-work statement characterises prior machine-learning approaches to ASD diagnosis as based on standardised assessment data, brain imaging datasets, and kinematic analysis of upper-body movement during specialised tasks. The paper positions its own contribution against these as using 'only behavioral data captured through video recordings of a naturalistic interaction with social robots' with unrestricted movement and no obtrusive sensors - articulating the corpus-wide trend away from constrained laboratory tasks and toward naturalistic, sensor-free observation." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-038" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Accuracy, precision and recall for all three classifiers, plus a confusion matrix for the CNN from which the 0.1787 false negative rate is derived and discussed. Reporting the false negative rate explicitly, and using it to disclaim diagnostic readiness, is better practice than the corpus norm of quoting accuracy alone. Training accuracy and loss are also given. No AUC, F1, confidence intervals or per-class breakdown beyond the confusion matrix, and no significance testing." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-038" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Author keywords: Autism spectrum disorder, child-robot interaction, multi-modal behaviors, deep learning, machine learning, diagnosis. CCS concepts span robotics, machine learning and human-centered computing user studies. Task vocabulary: 'risk detection', 'at-risk ASD', 'streamline existing diagnostic procedures', 'clinical prioritization', 'accessible layer of screening'. The triage-oriented vocabulary is consistent and the paper avoids diagnostic overclaiming." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-038" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. No feature importance, saliency or ablation analysis is performed, and no behavioral characteristic is identified as distinguishing the groups - so despite using Laban movement analysis, whose weight, space and time dimensions carry established interpretive meaning, nothing is reported about how autistic and typically developing children's movement qualities differed. The study yields a classifier without a finding." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-038" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "'children with Autism Spectrum Disorder (ASD)', 'children at risk for ASD', 'at-risk children', 'typically developing (TD)'. Person-first, and notably the paper consistently frames its target as 'risk detection' rather than diagnosis, which is reflected in the terminology throughout." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-038" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two groups: 5 boys with ASD and 7 typically developing boys, total 12 children. Group sizes, sexes and mean ages are reported. No other-diagnosis comparison group. This is the smallest participant sample in the corpus charted so far." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-038" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "HRI '20 Companion - the Late-Breaking Report track of the 2020 ACM/IEEE International Conference on Human-Robot Interaction. A robotics and human-computer interaction venue, and specifically a short-format preliminary-results track, which bounds what can be expected of the reporting." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-038" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Feature-level fusion of the two modalities: 3 Laban movement features are concatenated with 68 facial keypoints into a single 71-dimensional vector per 1-second window, so movement and facial information are combined before classification. There is no ablation isolating either modality's contribution, so their relative value is unknown. The discussion proposes future fusion with physiological, eye gaze and vocal data." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-038" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Laboratory setting with robots on a table and children standing or seated around it. Newly collected data from a user study; no existing dataset used." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-038" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Increase participant numbers and add repeated interaction sessions, which the authors expect will grow the dataset rapidly and may then favour the CNN over simpler classifiers; incorporate physiological, eye gaze and vocal data to represent ASD behaviours more comprehensively and improve network reliability; and extend the approach to other naturalistic interactions such as play at home, where much larger datasets could be obtained - a direction the authors argue is enabled specifically by the absence of obtrusive sensors and movement restriction." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-038" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "ASD n=5 (all male), mean age 8.2 +/- 1.10 years. TD n=7 (all male), mean age 7.43 +/- 2.30 years. Overall age range 5-10 years. No matching procedure or comparability test is reported; the group means differ by about 0.8 years and the control group's standard deviation is more than double the ASD group's. Both groups are exclusively male, which the authors explicitly list as a limitation - 'the inclusion of a single gender' - making this one of the few corpus studies to name sex homogeneity as a limitation rather than leave it unremarked. Total interaction time is reported per group (3931 s TD, 3442 s ASD), described as making the datasets comparable in size." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-038" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Weak, as expected for a two-page report. No data or code release, no software versions, no CNN training hyperparameters (optimiser, learning rate, epochs, batch size), no random seeds, no KNN k value or random forest configuration, and no specification of how the 80/20 split was drawn. The feature construction is described at a level that would allow approximate reimplementation - OpenPose, 68 facial keypoints from nose and eyes, three Laban features over a 1-second moving window, 71 features total - and the CNN architecture is sketched, but nothing could be reproduced quantitatively." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-038" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A sensory maze scenario in which two robots - a small humanoid and an iPod-based mobile robot - walk around a maze to find stations and interact with sensory stimuli at each. The activity was designed to include multiple opportunities for robot-initiated conversation, encouraging active participation from the child in a joint sensory experience. Children's movement was deliberately unrestricted and no obtrusive sensors were worn, which the authors identify as the design's key advantage for generalisation to naturalistic settings." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-038" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional; a single session per child averaging roughly 9-11 minutes, with no repeated sessions or follow-up. The data are video recordings of identifiable children, and a figure showing children interacting with the robots is published. Institutional Review Board approval is reported with a specific protocol number (GW IRB#111540), but there is no parental consent statement, no child assent statement, and no anonymization, retention or data-protection provision." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-038" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Not reported. No diagnostic instrument, criteria, clinician or confirmation procedure is described for the ASD group, and typically developing status is asserted without screening. Given that diagnostic label is the classification target, this is the study's most fundamental reporting gap, though it is partly a consequence of the two-page format." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-038" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Reported by the authors, and unusually directly for the format: the work 'is limited by the number of participants, the inclusion of a single gender and the exclusive use of behaviors available from video data', and given the 0.1787 false negative rate 'this method cannot be claimed to be ready to be used singularly as a diagnostic tool for ASD'. Identifiable in review and more consequential: the evaluation unit is the 1-second data window rather than the child, with approximately 18,597 data points per subject and a single 80/20 split whose partitioning level is unstated - so windows from the same child are almost certainly split across training and validation, making the reported accuracy a within-child figure rather than a person-level detection estimate; 12 children cannot support a person-level estimate regardless; no diagnostic instrument is reported; ages are unmatched with markedly unequal variances; validation and test sets are not distinguished; and no feature-level interpretation is offered so nothing is learned about what distinguishes the groups behaviourally." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-038" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Handcrafted temporal features over a sliding window: Laban movement analysis converts pose trajectories into three interpretable movement-quality dimensions (weight, space, time) computed over 1-second windows, concatenated with raw facial keypoint coordinates. The representation is therefore partly interpretable in principle - Laban features have established meanings in movement analysis - though no interpretation is pursued." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-038" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "Total interaction time 3931 seconds for the TD group (mean 561.57 s per child) and 3442 seconds for the ASD group (mean 688.4 s per child); single session, no repeated sessions" ;
                    slr:study_design "Cross-sectional case-control classification study reported as a two-page Late-Breaking Report" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: 5 (all boys); comparison: 7 (all boys)" ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "CNN accuracy 0.8846, precision 0.8912, recall 0.8853 (training accuracy 0.883, training loss 0.232). Random forest accuracy 0.8852, precision 0.8876, recall 0.8856. KNN accuracy 0.8874, precision 0.8920, recall 0.8878. False negative rate 0.1787 from the CNN confusion matrix",
                        "Facial keypoints and Laban-derived upper-body movement features extracted from video of unconstrained child-robot interaction supported classification of at-risk ASD versus typical development at approximately 0.88-0.89 accuracy across a CNN, random forest and k-nearest neighbour, with all three performing near-identically. The authors read the similar performance as indicating that simpler method" ;
                    slr:outcome "Accuracy, precision and recall for all three classifiers, plus a confusion matrix for the CNN. Training accuracy and training loss are also reported" ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "CNN accuracy 0.8846, precision 0.8912, recall 0.8853 (training accuracy 0.883, training loss 0.232). Random forest accuracy 0.8852, precision 0.8876, recall 0.8856. KNN accuracy 0.8874, precision 0.8920, recall 0.8878. False negative rate 0.1787 from the CNN confusion matrix; Facial keypoints and Laban-derived upper-body movement features extracted from video of unconstrained child-robot interaction supported classification of at-risk ASD versus typical development at approximately 0.88-0.89 accuracy across a CNN, random forest and k-nearest neighbour, with all three performing near-identically. The authors read the similar performance as indicating that simpler method" ] ] ;
