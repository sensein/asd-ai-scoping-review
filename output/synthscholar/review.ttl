            oa:hasTarget <urn:slr:article:665e8c7a855d> ;
            slr:claim_label "The single discordant case in the screening pathway is disclosed explicitly - a level of transparency about the reference standard that no other study charted here provides." ;
            slr:relevance_score "0.86"^^xsd:float ],
        [ a oa:Annotation ;
