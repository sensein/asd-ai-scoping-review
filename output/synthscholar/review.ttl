        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "Our data set included a split between 95% males with ASD and 5% females with ASD for autistic speech segments, as well as a 39% NT male, 58% NT female... Our data set had a sizable imbalance in terms of the relative proportion of males and females with ASD represented... our imbalance was larger than the observed real-world 4:1 to 3:1 male-to-female incidence ratio" ] ;
            oa:hasTarget <urn:slr:article:44d2304739ef> ;
