    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Two quality-control exclusions are described (calibration failure and off-screen fixation) but neither exclusion count is reported for either group, and the preschool cohort is 78 in the results table against N = 74 in the leave-one-out description." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "DSM-5 plus CARS above 30 for children aged 2 and over, with no ADOS or ADI-R confirmation - acknowledged with its cause - and CARS not administered to comparison children." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "some" ;
                    slr:supporting_quote "Both cohorts matched on age and gender with tests reported and both entered as covariates, and comparison children screened on three instruments; but no developmental or cognitive measure in either group, and the authors identify spectrum bias from comparing clear-cut cases against children with no psychiatric or neurological history." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "Participant-level leave-one-out cross-validation with cohorts modelled separately, single-area classifications tested against permutation-derived thresholds, and a single interpretable metric with no feature selection or hyperparameter search reported." ] ;
            slr:overall_judgment "some" ;
