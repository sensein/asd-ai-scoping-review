    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "Subject-independent partitioning with a genuine three-way train/development/test split; all hyperparameters and stopping criteria selected on development data; segmentation performed blind to group membership. The subject-level threshold is optimised per fold but the fixed-threshold result is also reported." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "Prospective DSM-5 diagnosis at 3 years within an established longitudinal cohort, ascertained 26 months after the index recording and entirely independent of it." ],
                [ a slr:RoBDomainJudgment ;
