        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "Recordings were conducted during structured interaction tasks, including simple games, gesture imitation exercises, and short conversational prompts, to elicit both social and motor behaviors. Each session took around 8–10 minutes per child, resulting in more than 16 hours of raw video data. All videos were recorded in full HD (1920×1080) resolution at 30 fps in standardized lighting conditions." ] ;
            oa:hasTarget <https://doi.org/10.11591/eei.v14i5.10319> ;
