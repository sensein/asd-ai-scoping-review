            oa:hasBody [ a dcterms:Text ;
                    rdf:value "Its non-invasive nature and ease of use would allow for continuous remote monitoring" ] ;
            oa:hasTarget <https://doi.org/10.1007/s10803-025-06811-1> ;
            slr:claim_label "The translational proposal is at-home caregiver screening with continuous remote monitoring - from a commercially funded study whose reported performance is a validation-set maximum with no held-out evaluation." ;
            slr:relevance_score "0.86"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "the authors also addressed that only 40% of the participants with ASD preferred to examine geometric patterns, and 60% of the ASD sample performed similarly to the TD children... the authors reported that the experimental procedure was repeated for some children but did not report the total number of trials repeated" ] ;
            oa:hasTarget <urn:slr:article:533b421d2f0b> ;
