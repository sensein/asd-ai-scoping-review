            slr:relevance_score "0.95"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "However, the BG difference is not sufficiently significant to directly use these hand-crafted features for classification, which may lead to misclassification and low accuracy." ] ;
            oa:hasTarget <urn:slr:article:5e6c6c482e7c> ;
            slr:claim_label "The conventional interpretable gaze features reproduce the expected group differences but cannot classify - an honest statement that the interpretable analysis and the performant model are doing different things." ;
