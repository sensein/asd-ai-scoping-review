            slr:overall_judgment "some" ;
            slr:tool_used "QUADAS-2" ] .

<https://doi.org/10.11591/eei.v14i5.10319> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Article history: Received Mar 20, 2025 Revised Aug 8, 2025 Accepted Sep 1, 2025 This paper proposes a method for detecting autism spectrum disorders (ASD) through the analysis of facial and motor features using machine learning. The aim is to develop an algorithm for automatic ASD diagnosis based on spatiotemporal behavioral patterns. Traditional diagnostic methods rely on subjective expert observations, often delaying intervention. To address this, a hybrid convolutional neural network and long short-term memory (CNN+LSTM) model was employed. Convolutional layers extracted spatial features from video frames, while recurrent layers tracked temporal dynamics. Using MediaPipe face mesh, pose, and hands models, 1,639 parameters were obtained, including facial and pose coordinates, hand landmarks, mouth aspect ratio (MAR), and motion energy. The dataset comprised 100 children, aged 5–9 years (50 with ASD, 50 typically developing (TD)). Stratified cross-validation was applied to ensure subjectindependent evaluation. Results showed 90% accuracy on the training set, 85–90% on validation, and an area under the curve (AUC) greater than 0.90, confirming model stability. Data visualization highlighted significant differences in motor activity and emotional expression between groups. The proposed approach demonstrates the potential for robust and objective ASD detection. It can be applied in clinical and educational contexts to improve early diagnosis and timely intervention." ;
    dcterms:bibliographicCitation "Amirbay A; Baigabylov N; Mukhanova A; Mukhambetova K; Zaitov E; Burganova R; Khusanova K; Akhmedova F (2025). Bulletin of Electrical Engineering and Informatics. *Bulletin of Elec*. https://doi.org/10.11591/eei.v14i5.10319" ;
    dcterms:creator "Akhmedova F",
        "Amirbay A",
        "Baigabylov N",
        "Burganova R",
        "Khusanova K",
        "Mukhambetova K",
        "Mukhanova A",
        "Zaitov E" ;
    dcterms:title "Bulletin of Electrical Engineering and Informatics" ;
    bibo:doi "10.11591/eei.v14i5.10319" ;
    bibo:pmid "local_4ceee075" ;
    fabio:hasPublicationYear 2025 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Handling of missing data and attrition" ;
                            slr:justification "All 100 children contribute and no attrition is reported, but no landmark-detection failure rate, occlusion handling or frame-exclusion criterion is described, and class-correlated missingness is plausible if the groups differ in how often they moved out of frame." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Confounder control" ;
                            slr:justification "A 32-percentage-point sex gap between groups, in a model whose inputs are facial mesh and body landmark geometry, with no stratified or adjusted analysis. No age distribution by group across a developmentally active range. The landmark representation does control appearance, lighting and background well." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Comparison group adequacy" ;
                            slr:justification "Typically developing peers recorded under the same protocol in the same environment - a matched acquisition context that is a genuine strength - but not matched on sex (52% male against 84%) and with age composition unreported." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Participant selection and spectrum representativeness" ;
                            slr:justification "No recruitment source, no ascertainment procedure, no spectrum characterisation, no age distribution by group and no cognitive or language data for 100 prospectively recruited children." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Measurement standardisation" ;
                            slr:justification "Identical protocol for both groups, standardised lighting, fixed 1920x1080 resolution and 30 fps, common session duration, and a landmark representation that discards appearance and background before modelling." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Index test definition and prespecification" ;
                            slr:justification "Feature construction fully specified in advance - 468 face mesh points, 33 pose points, 21 per hand, mouth aspect ratio, per-region motion energy, totalling 1,639 values - with the architecture, loss, optimiser and all four regularisation parameters stated." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Reference standard quality" ;
                            slr:justification "No diagnostic instrument, criteria or clinician described for either group in a prospectively recruited sample." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Outcome measurement blinding" ;
                            slr:justification "Landmark extraction and classification are fully automated with no human rater at any stage." ;
                            slr:rating "Low" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Performance estimation and chance level" ;
                            slr:justification "Accuracy, AUC, precision and recall with paired t-tests across folds and stated 95% intervals - better than most of this corpus. But specificity is omitted although recall of 0.95 against 85-90% accuracy implies it is materially lower; no confusion matrix; and intervals of plus or minus 1.5% are narrower than 20-child validation folds would support, with no derivation given." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Data splitting and leakage control" ;
                            slr:justification "Subject-independent stratified 5-fold cross-validation, with the mechanism and its anti-leakage purpose stated explicitly - the clearest such statement in this review's video branch, and the correct control for frame-level data." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Sample size adequacy for the modelling" ;
                            slr:justification "One hundred children with 16 hours of video and 1,639 features per frame; the effective sample is 100, with 20 children per validation fold. The authors identify dataset growth as future work." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Preprocessing and feature selection nesting" ;
                            slr:justification "No feature selection is performed and features are engineered a priori. But no hyperparameter search is described and architecture selection appears to have used the same folds that supply the reported figures." ;
                            slr:rating "Unclear" ] ;
                    slr:overall_concern "unclear" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Ethics, consent and conflicts" ;
                            slr:justification "No ethics approval, no institutional review board reference, and no consent or assent statement anywhere, for a prospective study recording over 16 hours of video of 100 children including 50 autistic children. Competing interests are declared as none." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Completeness of methods reporting" ;
                            slr:justification "The acquisition protocol, feature construction, validation strategy, regularisation parameters and architecture are all fully specified. Recruitment, diagnostic procedure, age composition by group, and landmark-failure handling are entirely absent." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Reporting of results and uncertainty" ;
                            slr:justification "Confidence intervals and fold-level significance testing are reported, which is above the corpus norm, but accuracy is given as a range rather than a mean, specificity is omitted, and the interval derivation is unstated." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Data, code and protocol availability" ;
                            slr:justification "Data on request only, withheld for privacy and ethical reasons - appropriate for identifiable video, though the modelled landmark coordinates are far less identifying and could have been released. No code." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Acknowledgement of limitations" ;
                            slr:justification "No limitations section. The future-work sentence concedes that the parameter set, architecture and sample are limited, but the sex imbalance, the absent reference standard, the missing specificity and the absent ethics documentation are all unmentioned." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A single webcam recording at 1920x1080 and 30 frames per second under standardised lighting, with MediaPipe face mesh, pose and hands performing landmark extraction. The equipment requirement is the lowest of any instrumented study in this review apart from the free-play video work: one consumer camera and open-source software, with no eye tracker, depth sensor, force plate, wearable or thermal camera. That makes the proposed application in 'clinical and educational contexts' credible as an equipment matter, and it means the 1,639-parameter feature vector is obtainable anywhere a laptop and a room are available. What is missing is the acquisition detail that determines whether landmark coordinates are comparable across sessions: camera distance and angle, the child's seated or standing position, and any per-session calibration. No landmark-detection failure rate is reported, which matters because MediaPipe hand tracking fails intermittently when hands leave frame or overlap, and class-correlated missingness would be indistinguishable from a class-correlated behavioural difference." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-136" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A purpose-designed structured interaction protocol of 8 to 10 minutes per child, comprising simple games, gesture imitation exercises and short conversational prompts, explicitly intended 'to elicit both social and motor behaviors'. This is among the better-judged paradigms in the review. It is short enough to be practical in a clinic or school, it actively elicits the target behaviours rather than waiting for them to occur, and it spans the social and motor domains within one session - which matters because a study charted elsewhere here demonstrated empirically that a 90-second free-play sample cannot reach the restricted and repetitive dimension at all. The gesture-imitation component is a targeted elicitation of motor imitation, a construct with an established clinical literature in autism, and its inclusion means the protocol probes something specific rather than sampling behaviour generically. Against this, the tasks are described only in outline: no script, no item list, no ordering, no statement of whether the examiner's prompts were standardised, and no report of how children who declined a task were handled. The protocol is therefore reproducible in spirit and not in detail." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-136" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A hybrid CNN+LSTM: convolutional layers for spatial feature extraction from the per-frame landmark vector, then an LSTM(64, return sequences) and an LSTM(32) for temporal dependency, then dense(16, ReLU) and dense(1, sigmoid), trained with binary cross-entropy and Adam. The architecture is standard, appropriately sized for 100 participants, and compared against configurations using either component alone, with the hybrid winning at p < 0.05 by paired t-tests across folds. Regularisation is unusually well specified - early stopping at patience 10 on validation loss, dropout 0.5, L2 at 0.001 and per-epoch batch shuffling - and each control is given with its parameter rather than merely named. The gap is that no hyperparameter search is described and the layer sizes are stated without justification, so it is unclear whether the configuration was tuned on the same folds that supply the reported figures." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-136" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Published October 2025 by information systems and sociology groups at L.N. Gumilyov Eurasian National University in Astana, with collaborators at Esil University and the National University of Uzbekistan. The framing is health-systems oriented and accurate for the region - a shortage of qualified specialists and a high burden on healthcare systems - with the technology positioned as a route to 'earlier identification and timely referral to specialists' rather than as a substitute for diagnosis, which is among the better-calibrated translational positions in this review. For the synthesis the study contributes three things. Its acquisition design is one of the strongest here: both groups were recorded under an identical purpose-built protocol in the same controlled environment, so the acquisition confound that undermines the photograph, video-frame, thermal and clinic-versus-school audio studies charted elsewhere cannot operate; the protocol actively elicits both social and motor behaviour in 8 to 10 minutes; and the landmark representation discards appearance, clothing, skin tone, lighting and background before any learning, removing a further class of confound by construction. Its validation is the most explicitly reasoned anti-leakage design in the video branch, naming subject-independence and data leakage directly and specifying four overfitting controls with their parameters - and the resulting 85-90% is modest and credible, benchmarked against external comparators. And it is a clean illustration of a distinction worth stating in the synthesis: leakage control and confound control are separate problems. The autistic group is approximately 84% male against 52% in the comparison group, a 32-percentage-point gap, and the model's inputs are 468 facial mesh points and 75 body and hand landmarks that encode sex-linked morphology and posture; a classifier separating boys from girls would produce exactly these figures under perfectly subject-independent cross-validation. No stratified or adjusted analysis addresses this, and no stream-wise ablation shows whether the signal lies in facial geometry or in hand motion, which would bear directly on the exposure. Two further gaps: no diagnostic reference standard of any kind is described for a prospectively recruited sample, so the predicted label is undefined; and no ethics approval or consent statement appears anywhere, in a study that recorded over 16 hours of video of 100 children including 50 autistic children." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-136" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None described. The 50 children are stated to be 'diagnosed with ASD' and nothing further is given - no instrument, no criteria, no clinician, no setting, no date - and no screening procedure is reported for the 50 comparison children. For a prospective study that designed its own acquisition protocol, recruited 100 families and recorded over 16 hours of video, this is a striking omission, and it contrasts sharply with the care taken over the technical description: the paper specifies the MediaPipe landmark counts, the composition of the 1,639-value feature vector, the dropout rate, the L2 coefficient and the early-stopping patience, while saying nothing at all about how autism was established in the children whose data those numbers describe. The consequence is that the label the model predicts is undefined, and the study's reported 85-90% cannot be located relative to any clinical standard." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-136" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The aim is an automated method for detecting autism from facial and motor features extracted from video, motivated by the subjectivity of expert observation, the weakness of early behavioural signs, and a shortage of specialists. The pipeline extracts 1,639 numerical parameters per frame using MediaPipe face mesh, pose and hands, adds a mouth aspect ratio and per-region motion energy, and models the sequence with a hybrid CNN+LSTM. Reported results: 90% accuracy on training data, 85-90% on validation, recall 0.95 and AUC above 0.9042, with the hybrid significantly outperforming single-architecture baselines at p < 0.05 by paired t-tests across folds. Heat map and movement-energy analyses showed group differences in motor activity and facial expression. The performance is modest and in a credible range for this task, and it is benchmarked against external comparators rather than presented in isolation. What the study cannot establish is what the separation reflects: the autistic group is 84% male against 52% in the comparison group, and the inputs are facial and body geometry, so sex is a live alternative explanation that no reported analysis excludes." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-136" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The broadest simultaneous behavioural coverage from a single camera in this review: facial configuration and expression through a 468-point face mesh, whole-body posture through 33 pose points, and manual gesture through 21 points per hand, all captured at 30 frames per second and reduced to a 1,639-value vector per frame. Two derived measures add interpretable structure. The mouth aspect ratio - the ratio of vertical to horizontal lip distance - is a compact index of mouth opening that relates to both expression and vocalisation. Motion energy, defined as the mean Euclidean displacement of landmark coordinates between consecutive frames and computed separately for the face, the pose and each hand, is a clean measure of how much each body region moves per unit time, and its per-region computation means motor activity can be localised rather than aggregated. The stated behavioural targets - reduced eye contact, atypical emotional expression, and repetitive stereotypical movement - map reasonably onto these streams, though gaze itself is not measured directly and stereotypy is not identified as such, only as elevated hand motion energy. The visualisations reported (heat maps and movement-energy graphs) show group differences in motor activity and facial expression, but no ablation determines which stream the classifier uses, which leaves the construct claim unresolved." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-136" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Sex is reported per group and is badly imbalanced; everything else is absent. The autistic group is approximately 84% male and the comparison group 52% male, so the two classes differ by around 32 percentage points on a variable that directly shapes every input the model receives. The feature vector comprises 468 facial mesh points, 33 pose points and 42 hand landmark points, together with a mouth aspect ratio derived from lip geometry - facial morphology, body proportion and posture are all sex-linked from middle childhood, and a network given these coordinates could achieve substantial separation by distinguishing boys from girls without representing anything about autism. This is the same failure mode that a speech study charted elsewhere in this review exposed empirically, where sensitivity collapsed from 94.8% pooled to 43.6% for girls; here the imbalance is in the sample rather than in the evaluation, so it inflates rather than conceals. No sex-stratified analysis, adjustment or discussion appears. No age distribution by group is reported despite a 5-to-9 range in which facial and motor development changes markedly; no cognitive, language, socioeconomic or ancestry information exists; and comorbidity is not recorded. The landmark representation does control for one class of confound well - appearance, clothing, skin tone, lighting and room are all discarded before modelling - which makes the uncontrolled demographic variables the more conspicuous." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-136" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "There is no limitations section. The introduction's future-work sentence - calling for 'extension of the parameter set, utilization of deeper architectures, growth of dataset size, and optimization towards real-time high-accuracy performance' - concedes by implication that the parameter set, architecture and sample are limited, but nothing qualifies a conclusion. What should have been stated, in order of importance: the autistic group is 84% male against 52% in the comparison group, and the model's inputs are facial mesh and body landmark geometry, so a substantial part of the separation could be sex discrimination, and no stratified or adjusted analysis is reported. No diagnostic reference standard is described for a prospectively recruited sample, so the predicted label is undefined. There is no ethics approval or consent statement for a study recording 16 hours of video of 100 children. No age distribution by group is given across a 5-to-9 range in which facial and motor development changes substantially. All reported figures are cross-validation results with no independent held-out test, so architecture selection and performance estimation share data. No specificity or confusion matrix is reported, and with recall at 0.95 and accuracy at 85-90%, specificity must be materially lower than recall - a fact the reported metrics conceal. The stated 95% confidence intervals of plus or minus 1.5% are narrower than 100 children in 5-fold cross-validation would ordinarily support and their derivation is not given. And no ablation separates the face, pose and hand streams, so the study cannot say which behaviour carries the signal." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-136" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional, single session per child, with no follow-up or test-retest. The ethics position is the study's most serious reporting failure. There is no institutional review board reference, no ethics committee, no consent statement and no assent statement anywhere in the paper - a full-text search returns no occurrence of the word 'consent'. The only appearance of ethics is in the data availability statement, which cites 'privacy and ethical considerations' as grounds for withholding the data, so the authors evidently regard the material as ethically sensitive while documenting no approval for having collected it. This is a prospective study that recruited 100 children including 50 autistic children and recorded more than 16 hours of video of them, so unlike several other studies in this review the omission cannot be attributed to secondary-data status. Competing interests are declared as none; funding is not stated in the retrieved text." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-136" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Strong where this review's video branch is usually weakest, and unexamined where this particular sample is weakest. The splitting is subject-independent stratified 5-fold cross-validation, and the paper states both the mechanism and the purpose: 'To provide strong model validation and prevent data leakage ... The dataset was divided on a subject-independent basis such that data from the same participant was not included in both training and validation datasets.' In a corpus of frame-level data from 100 children, where naive splitting would place frames of the same child on both sides and produce a near-perfect figure, this is exactly the right control, and it is named as such - the clearest anti-leakage statement in this review's video branch. Stratification preserves class ratio across folds; four overfitting controls are specified with their parameters; and the resulting figure of 85-90% is modest and plausible, benchmarked against external comparators rather than presented in isolation. The remaining issues are of two kinds. Procedurally, all reported figures are cross-validation results with no independent held-out test, so architecture selection and performance estimation share the same folds; the reported accuracy is a range rather than a mean with fold-level detail; specificity is not reported although recall of 0.95 against 85-90% accuracy implies it is materially lower; and the stated plus-or-minus 1.5% intervals are narrower than 20-child validation folds would ordinarily support, with no derivation given. Substantively, and more importantly, subject-independence protects against recognising an individual across the split but offers no protection against a group-level confound, and this sample has a severe one: the autistic group is approximately 84% male and the comparison group 52%, while the model's inputs are 468 facial mesh points and 75 body and hand landmarks, all encoding sex-linked morphology and posture. A classifier that separates boys from girls would perform equally well on unseen children and would be entirely consistent with the reported figures. The study is therefore a clear illustration of a distinction the synthesis should draw: leakage control and confound control are different problems, and closing the first - which this paper does deliberately and well - leaves the second untouched." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-136" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Conventional medical framing, more dated in places than most of this corpus. Autism is 'a neurodevelopmental disorder' but also 'this disorder' and, in the opening sentence, is placed within 'identification and investigation of diseases'. The characterisation is deficit-based - 'social deficits, difficulties in communication, and atypical patterns of behavior', with key characteristics given as 'avoidance of eye contact, lack of or excessive expression of emotions, and repetitive stereotypical movements'. 'Children with ASD' and 'neurotypical children' are the standard usages, and 'neurotypical' rather than 'normal' is a small point in the paper's favour. The access argument is stated in health-systems terms that are accurate for the setting - 'a shortage of qualified specialists and a high burden on healthcare systems' - and the proposed role is 'earlier identification and timely referral to specialists', which frames the technology as a routing mechanism rather than a replacement for assessment. No neurodiversity framing appears, and no autistic person or family organisation is reported as involved, which is worth noting for a study that recorded 16 hours of video of children without any documented consent process." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-136" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A per-frame vector of 1,639 values comprising a timestamp, 99 pose landmark coordinates, 63 coordinates for each hand, facial mesh coordinates, the mouth aspect ratio and per-region motion energy, formed into sequences for temporal modelling. Reducing video to landmark coordinates before any learning is a deliberate confound control of the same kind used by the pose-based studies elsewhere in this review: skin tone, clothing, background, lighting and room are all discarded, so none can drive the classification, and this is a substantive advantage over the whole-image approaches in the photograph branch. The residual exposure is facial mesh geometry, which retains craniofacial morphology and therefore retains the sex- and age-linked variation that the sample does not control." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-136" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Accuracy, AUC, precision and recall, with paired t-tests across the 5-fold results at p < 0.05 and 95% confidence intervals for accuracy, precision, recall and F1 stated to lie within plus or minus 1.5%. Reporting intervals and fold-level significance testing at all places the study above most of this corpus. Three problems limit the reporting. Specificity is not given, and with recall at 0.95 and accuracy at 85-90% on a balanced sample, specificity must be substantially below recall - roughly 75-85% by arithmetic - so the metric that a screening application most needs is the one omitted, and the model's error profile is asymmetric in a direction the reported figures obscure. No confusion matrix appears. And the stated interval of plus or minus 1.5% is narrower than 100 children in 5-fold cross-validation would normally support, with 20 children per validation fold meaning a single child moves fold accuracy by 5 percentage points; the derivation of the interval is not stated, so whether it describes across-fold variation or something else cannot be determined." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-136" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "One hundred children aged 5 to 9, recruited in Kazakhstan: 50 described as diagnosed with autism and 50 typically developing peers, recorded under a single purpose-designed protocol yielding over 16 hours of video. The sample is balanced 50:50 by group and the acquisition context is common to both, which removes the recruitment and recording asymmetry that affects most of this review's video and image work. Two demographic facts bound what follows. The sex composition differs sharply between groups - the autistic group is approximately 84% male and 16% female, while the comparison group is 52% male and 48% female - a 32-percentage-point gap reported in the results without comment, adjustment or stratified analysis. And no age distribution by group is given, only the shared 5-to-9 range, across which facial proportions, motor coordination and gestural repertoire all change substantially. No cognitive, language, socioeconomic or comorbidity information is available for either group, and no recruitment source is stated." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-136" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Three landmark streams from one camera, concatenated at the feature level and modelled jointly - within-camera multimodal fusion rather than multi-sensor fusion. The breadth is a genuine advantage: face, posture and hands are rarely combined in one model in this literature, and doing so at 30 frames per second with temporal modelling gives the network access to how expression, posture and gesture co-vary. The paper argues this explicitly, proposing a model that 'simultaneously analyzes facial expressions, head movements, hand gestures, and posture over time, combining spatial and temporal learning'. What is missing is any decomposition: no ablation reports performance with each stream removed, so the relative contribution of face, pose and hands is unknown. That omission is more costly here than usual, because the three streams carry very different confound exposure - facial mesh geometry is strongly sex-linked, hand motion energy much less so - and the study's 32-point sex imbalance between groups makes the distinction decisive for interpreting the result." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-136" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Four directions are named: a larger parameter set, deeper architectures, a larger dataset, and optimisation for real-time performance. All are engineering extensions. Not proposed, and prerequisite to interpreting the present result: a sex-stratified or sex-adjusted analysis, which is the single most informative check the existing data would support; an ablation across the three landmark streams, which would show whether the signal lies in facial geometry, posture or hand movement and therefore how exposed it is to the sex confound; documentation of how autism was ascertained in the 50 children; an independent held-out evaluation; and ethics and consent documentation." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-136" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A controlled recording environment with standardised lighting, using a single webcam, with both groups recorded under the same protocol. That last point matters and is one of the study's real strengths: across the photograph, video-frame, thermal and clinic-versus-school audio branches, this review has repeatedly found the two classes recorded under systematically different conditions, so that acquisition context proxies for the label. Here the setting, lighting, camera, resolution, frame rate and task sequence are common to both groups, and the landmark representation additionally discards appearance and background before modelling. Whatever the study is detecting, it is not the difference between two recording environments. What is not stated is where the recordings took place, how children were recruited to each group, or whether the examiner differed between groups." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-136" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Keywords: autism spectrum disorders, early diagnosis, facial analysis, long short-term memory, mouth aspect ratio, spatiotemporal patterns. Balanced across population, method and construct, with 'mouth aspect ratio' unusually specific for a keyword list and signalling that engineered interpretable features were part of the design. Terms carried through the body: MediaPipe, face mesh, pose, hands, motion energy, motor imitation, gesture, subject-independent, stratified cross-validation." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-136" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Descriptive rather than model-directed. Heat map analysis and movement-energy graphs are presented to show that motor activity and facial expression differ between groups, and because motion energy is computed per region these could localise the difference - but they characterise the data rather than the classifier, and no attribution, ablation or feature-importance analysis is reported for the model itself. Two of the engineered features, the mouth aspect ratio and per-region motion energy, were designed to be interpretable and are physically meaningful, which makes the absence of any analysis relating them to model output the more conspicuous. The specific analysis that this study needed and did not perform is a stream-wise ablation: a result driven by hand motion energy and a result driven by facial mesh geometry would have very different standing given that the two groups differ by 32 percentage points in sex composition, and nothing reported distinguishes them." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-136" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Bulletin of Electrical Engineering and Informatics 14(5):3985-4000, October 2025, open access under CC BY-SA; received 20 March, revised 8 August, accepted 1 September 2025. An electrical engineering and informatics venue, and the profile of what was and was not scrutinised follows: the acquisition protocol, the feature construction, the validation strategy, the regularisation parameters and the architecture are all specified in detail, while the absence of any diagnostic ascertainment procedure and of any ethics or consent statement for a prospective study recording 100 children passed review without comment. The journal's structure elicited conflict-of-interest and data-availability declarations - the latter citing 'privacy and ethical considerations' - but has no field that would have prompted a human-subjects statement." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-136" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. No severity, cognitive, adaptive or language measure is reported for either group, so no gradient analysis is possible and the model's output cannot be related to anything other than group membership. The protocol includes conversational prompts, so verbal ability was engaged in producing the data without being measured." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-136" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Sharply divided. The technical protocol is documented well: task types, session duration, total video volume, resolution, frame rate, lighting standardisation, the three MediaPipe models with their landmark counts (468 face, 33 pose, 21 per hand), the composition of the 1,639-value vector with per-component counts, the definitions of the mouth aspect ratio and of motion energy as mean Euclidean landmark displacement between consecutive frames, the complete validation strategy with fold count, stratification rule, subject-independence, early-stopping patience of 10, dropout of 0.5, L2 coefficient of 0.001 and batch shuffling, the network architecture layer by layer with unit counts and activations, the loss function and optimiser, and the metric set with paired t-tests across folds. The human protocol is not documented at all: no recruitment source, no diagnostic procedure, no age distribution by group, no ethics approval and no consent process. A reader could rebuild the pipeline and could not evaluate, replicate or ethically justify the study that produced the data." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-136" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:study_design "Prospective case-control classification study with purpose-designed multimodal video acquisition and subject-independent cross-validated evaluation" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: ; comparison: 50 typically developing children, 52% male and 48% female" ] ] ;
