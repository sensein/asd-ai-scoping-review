    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "No participant selection. 2,936 images downloaded from Kaggle with the two classes assembled from different internet sources, no demographic information of any kind, an unknown number of distinct children, and no inclusion or exclusion criterion stated or possible." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "The label is a directory name. Features are extracted 'by traversing through the directory structure' with a label column added to denote 'autistic' or 'non_autistic'. No diagnosis, criterion, instrument or verification underlies either class." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "No evaluation protocol is described at all - no split, no cross-validation, no holdout proportion - yet twenty accuracy figures are reported. The image-to-child mapping is unknown, so partition integrity could not be established even if a partition had been specified." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Eighteen classifier-feature combinations evaluated with the maximum reported, no hyperparameters stated for any classifier, and no prespecified operating point. No analysis establishes what the classifiers respond to, and five of the eight feature families are descriptors sensitive to image quality rather than to facial structure." ] ;
            slr:overall_judgment "high" ;
