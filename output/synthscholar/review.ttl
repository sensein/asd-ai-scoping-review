<urn:slr:article:ef9df8726301> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "autism spectrum disorder (ASD) diagnosis often benefits from early identification. This paper proposes an enhanced deep learning model for analyzing facial features in children to aid in early ASD detection. The model integrates the YOLO architecture with convolutional neural networks (CNNs) employing transfer learning. Trained on a Kaggle dataset of 2,836 facial images (1,418 autistic and 1,418 nonautistic children), the model achieves high accuracy with MobileNet (95%), Xception (94%), and InceptionV3 (89%). This approach has the potential to improve existing detection methods for ASD and contribute to better human-computer interaction for individuals with special needs. Notably, the model demonstrates high specificity, effectively distinguishing autistic from non-autistic cases across various facial expressions in benchmark datasets." ;
    dcterms:bibliographicCitation "ElMahalawy J; ElSwaify YA; Elliboudy D; Abbas OM; Moustafa N; Wael N (2024). AI-Powered Human-Computer Interaction Assisting Early Identification of Emotional and Facial Symptoms of Autism Spectrum Disorder in Children: &#x201C;A Deep Learning-Based Enhanced Facial Feature Recognition System&#x201D;. **." ;
    dcterms:creator "Abbas OM",
        "ElMahalawy J",
        "ElSwaify YA",
        "Elliboudy D",
        "Moustafa N",
        "Wael N" ;
    dcterms:title "AI-Powered Human-Computer Interaction Assisting Early Identification of Emotional and Facial Symptoms of Autism Spectrum Disorder in Children: &#x201C;A Deep Learning-Based Enhanced Facial Feature Recognition System&#x201D;" ;
    bibo:pmid "local_261afa51" ;
    fabio:hasPublicationYear 2024 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Comparison group adequacy" ;
                            slr:justification "Photographs 'randomly gathered from the internet' with no screening and no verification of non-autistic status, drawn from an entirely different source population than the autistic class." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Participant selection and spectrum representativeness" ;
                            slr:justification "No participants and no selection process; 1,418 photographs scraped from autism-focused websites, with the number of distinct children unknown and no demographic, clinical or severity information available for any image." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Handling of missing data and attrition" ;
                            slr:justification "No quality assessment of any kind. Preprocessing was performed by the dataset creator and comprised duplicate removal and face cropping; no resolution, compression, capture-condition or per-class quality comparison is reported." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Confounder control" ;
                            slr:justification "The central confound is the dataset's construction: the two classes differ in source and therefore in imaging characteristics, photographic convention and represented demographics, all of which are available to the classifier and none of which is examined. Augmentation of brightness, contrast and noise addresses only part of the surface of this problem." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Index test definition and prespecification" ;
                            slr:justification "Three architectures compared with the best reported; augmentation of ambiguous ordering relative to splitting; two inconsistent input sizes; no prespecified operating point." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Measurement standardisation" ;
                            slr:justification "None is possible. The photographs were captured by unknown people with unknown devices under unknown conditions, and the two classes were assembled from different sources - the opposite of a standardised acquisition chain." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Reference standard quality" ;
                            slr:justification "The label is where an image was found. No diagnosis, instrument, criterion or verification, and errors are unbounded in both directions." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Outcome measurement blinding" ;
                            slr:justification "Classification is automated from image files; no human rating enters the pipeline. This is the only domain item in the record not at high concern." ;
                            slr:rating "Low" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Sample size adequacy for the modelling" ;
                            slr:justification "2,536 training images of unknown provenance and unknown child count, with a 100-image test set on which model rankings differing by one percentage point are asserted." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Preprocessing and feature selection nesting" ;
                            slr:justification "Augmentation is described after the partition but applied to 'the Kaggle dataset comprising 2,836 facial images', implying transformation of the whole corpus before splitting." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Data splitting and leakage control" ;
                            slr:justification "A single fixed partition with augmentation of ambiguous ordering, and an unknown image-to-child mapping that makes participant-level split integrity impossible to establish even in principle." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Performance estimation and chance level" ;
                            slr:justification "One fixed 100-image test set with no cross-validation, no repeated splits and no confidence intervals; no chance baseline stated despite a balanced design; a confusion matrix summing to 280 that matches no stated partition; 100% training accuracy reported without comment; and a units error in the sensitivity and specificity text throughout." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Data, code and protocol availability" ;
                            slr:justification "No code, no dataset identifier or version, no split specification, no preregistration." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Completeness of methods reporting" ;
                            slr:justification "Architectures, appended layers, optimiser, batch size, epochs, early-stopping criterion and augmentation list are given, but the Kaggle dataset identifier, code, split assignment, image-to-child mapping and augmentation ordering are not, and two inconsistent input sizes are stated without reconciliation." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Ethics, consent and conflicts" ;
                            slr:justification "No ethics approval, no consent, and no discussion of either, for a study built on photographs of identifiable children obtained without their families' knowledge, in which one class was collected precisely because those images appeared in autism contexts - so the dataset itself asserts a health status about identifiable minors. A consumer mobile application for families is proposed on this basis. No funding or competing-interests statement." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Reporting of results and uncertainty" ;
                            slr:justification "Sensitivity and specificity are reported alongside accuracy, but with a units error throughout, no confidence intervals, no AUC, and a confusion matrix corresponding to no stated partition size." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Acknowledgement of limitations" ;
                            slr:justification "No limitations section and no acknowledged constraint of any kind. The only self-critical observation in the paper is that batch normalisation and dropout did not improve performance." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. No age (beyond an unverifiable dataset-level claim of 24-72 months), sex, race, ethnicity, socioeconomic status, cognitive level, language, comorbidity or severity data exist for any image. The omission is more consequential here than in other dataset-reuse studies because the two classes were assembled from different sources: autism-advocacy and awareness websites will over-represent certain countries, ethnicities, family circumstances and photographic conventions relative to a random internet image search, and any such difference is directly available to the classifier as a diagnostic cue. A demographic comparison between the two collections is the minimum check that would begin to address this, and none is attempted." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-112" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Three ImageNet-pretrained networks - MobileNet, Xception and InceptionV3 - used as fixed feature extractors with two dense layers appended (1,024 neurons with ReLU and L2 regularisation at 0.015, dropout 0.4, softmax output), trained with RMSprop under early stopping on validation loss with patience ten. Separately, five YOLOv8 classification variants plus a proposed 11.2-million-parameter model for facial expression recognition. The architectural choices are conventional and appropriate to a small image dataset; the paper notes candidly that batch normalisation and dropout 'didn't notably enhance the models' performance' and that early stopping proved more effective. That candour is worth noting because it is the only self-critical observation in the paper. The reported 100% training accuracy alongside 95% validation accuracy is left without comment." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-112" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The design cannot support the claim, and the reasons are structural rather than procedural. A single fixed partition of 2,836 images into 2,536 training, 200 validation and 100 test provides no cross-validation, no repeated splits and no confidence intervals, and the test partition of 100 images makes each image worth a full percentage point. The order of augmentation relative to partitioning is ambiguous, with the text describing the partition and then the augmentation of the full 2,836-image dataset, which if taken at face value places transformed copies of the same photograph on both sides of the split. The number of distinct children behind the images is unknown, so participant-level splitting is not merely absent but impossible, and multiple photographs of the same child may straddle the split undetectably. Training accuracy reached 100%. The confusion matrix corresponds to no stated partition. But none of these is the decisive problem. Because the two classes were assembled from different internet sources, no split of these images - however careful - can distinguish a model that has learned facial morphology from one that has learned image provenance, and no result reported in the paper bears on which it is. The corrective is not a better validation scheme but a different dataset: photographs of diagnostically verified autistic and non-autistic children captured under matched conditions with the same equipment, which is what several other studies in this review provide and what this branch of the literature lacks." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-112" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None, and none is possible. No severity, cognitive, language or adaptive information exists for any image, so nothing can be said about which autistic children the model would detect. The study's proposal - a mobile application for families - would be applied to individual children about whom the model has no information beyond a photograph, and no analysis addresses how the system would behave across the range of presentations, ages, ethnicities or image qualities it would encounter." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-112" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. There is no task, protocol or elicitation - the images are photographs. This matters for the review's framing because a facial-photograph classifier is not measuring behaviour at all: it is measuring appearance. The paper's own premise makes this explicit, grounding the approach in claimed morphological differences in the upper face and mid-face rather than in anything the child does. The attached expression recognition module, trained on AffectNet, does concern behaviour, but AffectNet contains adult and general-population faces annotated for emotion and has no autism labels, so that module says nothing about autism and is never linked to the classification result." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-112" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None, and the absence is the study's central evidential gap rather than a peripheral omission. The paper asserts that its networks work by 'capturing facial features, creating distinctive facial patterns, and evaluating the distances between facial landmarks', and includes a figure of facial landmarks, but no landmark extraction appears in the method and no evidence connects the models' decisions to facial geometry. Given that the two image classes were assembled from different internet sources, the alternative explanation - that the models distinguish autism-website photographs from general internet photographs by their imaging characteristics - is at least as plausible as the stated one, and a single class activation map over correctly and incorrectly classified images would have addressed it directly. No such analysis appears anywhere." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-112" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Accuracy, sensitivity and specificity for three models, plus a confusion matrix; precision and mAP50 for the expression module. Reporting sensitivity and specificity rather than accuracy alone is nominally good practice, and the discussion draws the correct general point that the choice between MobileNet and Xception depends on whether missed cases or false positives matter more. But three reporting problems undercut this. The confusion matrix reports 131 + 136 + 9 + 4 = 280 images, which matches neither the stated 200-image validation set nor the 100-image test set, and no explanation is offered. Sensitivity and specificity are written throughout as '0.97%' and '0.93%', conflating proportions with percentages. And no AUC, F1 or confidence interval is given, so a difference of one percentage point between MobileNet and Xception - on a partition of at most a few hundred images - is presented as a meaningful model ranking." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-112" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional in the trivial sense that photographs have no time dimension. There is no ethics statement, no consent, and no discussion of either. This is the most serious governance failure in the review, and it is worth stating precisely why. The dataset consists of identifiable photographs of children, obtained without their knowledge or their families' consent, in which one class was collected specifically because those images appeared in autism contexts - so the dataset itself asserts a health status about identifiable minors. Training on that dataset propagates the assertion; publishing a mobile application built on it would extend the assertion to new children photographed by whoever downloads it. None of this is acknowledged. No funding statement and no competing-interests declaration appear either." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-112" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None is proposed. The introduction states an intention to test the model on images of children below 36 months 'to assess its efficacy in early detection', and no such analysis is reported. The conclusion contains no future-work content beyond restating the results." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-112" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Software only: Google Colab with TensorFlow and Keras, three ImageNet-pretrained networks for classification, YOLOv8 variants for expression recognition. No acquisition equipment exists because no data were collected. The imaging characteristics of the source photographs - resolution, sensor, compression, colour profile - are unknown and unexamined, which is precisely the information needed to assess whether the classes are separable on grounds unrelated to the children." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-112" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "There is none, and the substitute is source of retrieval. An image is labelled autistic because it appeared on a website about autism and non-autistic because it did not. No diagnosis, criterion, instrument, clinician or verification underlies either label. Both directions of error are unbounded: an autism-website photograph may depict a sibling, a parent, a stock model or a child whose diagnostic status is unstated, while a randomly gathered photograph may depict an autistic child. Because the label is a property of where a file was found rather than of the person depicted, the quantity the model predicts is image provenance, and the paper's reported 95% accuracy is best read as a measure of how distinguishable the two collections are. That distinguishability has many possible sources - camera type, resolution, JPEG compression, lighting, background, pose, cropping convention, the tendency of advocacy imagery towards particular framings - none of which is examined." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-112" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "There is no limitations section and no constraint is acknowledged anywhere, which for a study with this design is itself the finding. The unaddressed problems begin with the dataset and are not remediable by any modelling choice. Autistic images were scraped from autism-focused websites and non-autistic images gathered randomly from the internet, so the classes differ in provenance and therefore in every photographic property that provenance determines; a model trained to separate them has an easier and entirely non-clinical route to high accuracy, and no analysis in the paper tests which route it took. Neither label is verified against any diagnosis. The number of distinct children is unknown, so split integrity cannot be established even in principle. Augmentation appears to precede partitioning. Training accuracy reached 100%. The confusion matrix does not correspond to any stated partition. Vertical flipping is applied to faces. Sensitivity and specificity are written as percentages of a proportion throughout ('0.97% sensitivity'). The introduction promises a sub-36-month analysis that never appears. The expression module's proposed variant is outperformed by the smallest baseline it is compared against. And no ethics approval, consent or discussion accompanies a system built from photographs of identifiable children and proposed for distribution as a consumer mobile application." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-112" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Reported in outline and internally inconsistent in detail. Available: the dataset composition, the three architectures, the appended layer configuration (1,024 neurons, ReLU, L2 at 0.015, dropout 0.4, softmax output), the RMSprop optimiser, batch size 80, 100-epoch cap with early stopping at patience ten, the augmentation list, and the platform. Unavailable: the Kaggle dataset identifier or version, code, the split assignment or seed, and the image-to-child mapping. Two mutually inconsistent input sizes are given (96 x 96 in the dataset section, 224 x 224 x 3 in the transfer learning section) without reconciliation. The confusion matrix sums to 280 images while the stated validation and test partitions contain 200 and 100. And the order of augmentation relative to partitioning - the single most important procedural fact for interpreting the result - is left ambiguous by the text's ordering of subsections." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-112" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cropped facial photographs, resized (to 96 x 96 in one passage and 224 x 224 x 3 in another) and rescaled to [0, 1], with an extensive augmentation list: rotation, horizontal and vertical flipping, zooming and cropping, brightness and contrast adjustment, noise injection, shearing and scaling. Two elements deserve comment. Vertical flipping produces upside-down faces, which has no rationale for a task premised on facial landmark geometry and would be excluded by anyone reasoning about the construct rather than reaching for a standard augmentation set. And brightness, contrast and noise augmentation are described as helping the model generalise across imaging conditions - which is the right instinct but addresses only the appearance of the problem, since systematic imaging differences between the two source collections would remain available through resolution, compression and framing regardless." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-112" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The aim is an AI-powered mobile application that identifies autistic children from facial photographs, combined with a facial expression recognition module, intended for use by families and psychiatrists. Findings: MobileNet reached 95% validation accuracy with sensitivity 0.97 and specificity 0.93, alongside 100% training accuracy; Xception 94% (sensitivity 0.92, specificity 0.95); InceptionV3 89% (sensitivity 0.95, specificity 0.83). The expression module reports precision 0.988 and mAP50 0.991 for the proposed variant - against 0.992 and 0.99 for the smallest YOLOv8 baseline, so the proposed model is marginally worse than the lightest comparator on its own task, a result the paper presents as demonstrating 'a good balance of accuracy and efficiency'. The two modules are never combined, tested against each other, or shown to inform one another, despite the paper's claim to provide 'a more complete picture of a child's condition'. What no result in the paper addresses is what the autism classifier is responding to. Given that the two image classes were assembled from different internet sources, the reported accuracy is consistent with a model that has learned to distinguish autism-website photographs from general internet photographs, and no analysis in the paper can rule that out." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-112" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Published 2024 by the Department of Computer Engineering at the Arab Academy for Science, Technology and Maritime Transport, Alexandria, with no funding statement. The framing is access and speed - traditional manual assessment is time-consuming, AI 'offers expedited decision-making' - and the deliverable is a consumer mobile application 'designed to be user-friendly for families and psychiatrists alike'. For this review the study functions as a negative exemplar marking the boundary of the field, and it is worth setting out precisely what it exemplifies. First, a label derived from image provenance rather than diagnosis: an image is autistic because it was found on an autism website. Second, class-confounded data collection, in which the two classes come from different sources so that every photographic property distinguishing those sources is available to the classifier - the same failure mode this review has recorded in an acoustic study where autistic and comparison children were recorded on different devices, but here operating on the entire dataset rather than one feature family. Third, a physiognomic premise adopted from a single citation without engagement with the history of inferring conditions from facial structure. Fourth, a proposed consumer deployment - parents photographing their children to receive an autism determination - advanced without diagnostic validation, without any interpretability check on what the model uses, and without ethical consideration of the photographs of identifiable children on which it is built or of the consequences of a false result delivered to a family by an app. The review should record that this branch of the literature exists, that it reports accuracies comparable to or higher than the most carefully conducted studies charted here, and that those accuracies carry no evidential weight." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-112" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "There are no participants in the ordinary sense - the study analyses 2,836 photographs, 1,418 labelled autistic and 1,418 not, obtained from a public Kaggle dataset. The provenance is stated plainly and is the study's decisive feature: 'the images of autistic children's faces were sourced from online platforms focusing on autism disorder, while the images of non-autistic children's faces were randomly gathered from the internet'. So the two classes are not two groups of children assessed under common conditions but two collections of photographs assembled from different corners of the internet for different reasons. The number of distinct children behind the images is unknown and cannot be recovered, so it is impossible to know whether ten photographs represent ten children or one, or whether the same child appears on both sides of the training-test split. Age is stated as 24-72 months for both classes, but this is a claim in the dataset description rather than a verified attribute of scraped photographs. Nothing else about the children is known." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-112" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Claimed but not performed. The paper states that it combines 'facial expression recognition with autism classification, thus providing a more complete picture of a child's condition', but the two components are trained on different datasets for different label spaces, evaluated with different metrics in separate tables, and never joined, compared or shown to inform one another. No fusion architecture, joint training, feature sharing or ablation is described. The claim to combine them is a description of the software containing two modules, not of any analysis relating them." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-112" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Proceedings of ICMISI 2024, the International Conference on Machine Intelligence and Smart Innovation, IEEE, pages 87-91 - a five-page general machine-intelligence conference paper with no clinical or biomedical scope. The format accounts for the brevity but not for the absence of an ethics statement, of a limitations section, or of any check on what the classifier responds to. The paper carries internal inconsistencies - two input sizes, a confusion matrix matching no stated partition, sensitivity written as a percentage of a proportion - that a substantive review would be expected to catch." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-112" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The autism classification component does not target behaviour at all - it targets facial morphology, on the stated premise that autistic children have an 'expanded upper face and a truncated mid-facial region' and 'differences in both the arrangement and dimensions of facial landmarks'. That is a claim about anatomy, not about what a child does, and it places this study outside the behavioural framing that organises the rest of this review. The expression recognition component does target behaviour - emotional facial expression - but it is trained on AffectNet, a general-population emotion dataset with no autism labels, and its output is never connected to the autism classification. So the paper's title claim to identify 'emotional and facial symptoms' rests on two modules that address different constructs on different data and are never integrated. For the review, the study is best understood as marking a boundary: the point at which automated autism detection stops analysing behaviour and begins inferring diagnosis from appearance." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-112" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Keywords: autism spectrum disorder (ASD), Deep Learning, Convolutional Neural Networks (CNNs), Facial Image Analysis, Early Detection, Human-Computer Interaction (HCI), Artificial Intelligence (AI), Transfer Learning, Emotional and Facial Symptom Identification, YOLO Architecture, Augmentation Techniques, Facial Expression Recognition, Assistive Technology. Thirteen keywords for a five-page paper, most of them method labels. 'Emotional and Facial Symptom Identification' is the phrase that carries the paper's conflation of morphology and expression, and 'Assistive Technology' frames a diagnostic classifier as an aid to the people it classifies." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-112" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "'Autistic children' and 'non-autistic children' are the working terms, with 'typically developing (TD)' appearing occasionally. The register is medical-model with some notable slips: autism is 'characterized by early brain abnormalities', and the evaluation section refers to the model having halted 'after evaluating ten patients' when it means an early-stopping patience of ten epochs. The framing that matters, however, is not terminological but conceptual. The paper's premise is physiognomic: it opens by citing research that 'has identified distinct facial features common among autistic children: expanded upper face and a truncated mid-facial region, underscoring the potential of facial analysis in aiding early detection', and the method section asserts that autistic children 'exhibit distinct facial feature variations, showcasing differences in both the arrangement and dimensions of facial landmarks'. Inferring a neurodevelopmental condition from face shape is a claim with a long and discredited history, and the paper adopts it from a single citation with no engagement with that history, no discussion of the evidence base, and no consideration of what a facial autism classifier would mean for the people it classifies. There is no neurodiversity framing and no autistic-community involvement - which is a particular absence given that the autistic images were taken from autism-focused websites, that is, from spaces created by and for autistic people and their families, and repurposed as training data without acknowledgement." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-112" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No study setting exists. Images were downloaded from Kaggle and processed in Google Colab. The absence of a setting is not incidental: because the photographs were captured by unknown people, with unknown devices, in unknown circumstances, for unknown purposes, there is no acquisition chain to standardise and no way to establish that the two classes were photographed comparably. Every other study in this review that uses cameras controls the device, the distance, the lighting or at least the protocol; this one controls nothing, and the two classes are known to come from different sources." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-112" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:study_design "Secondary computational analysis of a scraped public image dataset; a transfer-learning model comparison with an attached facial expression recognition module. No participants, no …" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: ; comparison: 1,418 images" ] ] ;
    slr:content_sha256 "017c25af765b75a0f09d15a30806230fd641e1d44cc3019a6f43f3a8ff7967ca" ;
