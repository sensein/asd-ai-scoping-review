            oa:hasTarget <https://doi.org/10.3390/jcm9051260> ;
            slr:claim_label "Between-group comparisons used the Wilcoxon signed-rank test, a paired test, for two independent groups." ;
            slr:relevance_score "0.9"^^xsd:float ],
        [ a oa:Annotation ;
