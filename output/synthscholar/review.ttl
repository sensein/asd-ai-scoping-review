    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "Five-fold cross-validation with test folds explicitly held blind, iterative undersampling to convergence for class balance, confidence intervals on every AUC, an explicit chance-classifier baseline, and an IQ-matched subsample replication." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "unclear" ;
