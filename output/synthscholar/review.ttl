            slr:decision_rationale "Supervised machine-learning classification of children with ASD versus typically developing children from centre-of-pressure postural sway variables - computational model on behavioral (motor/postural) data with an autism identification target." ;
            slr:screening_stage "title_abstract" ],
        [ a prov:Activity,
                slr:ScreeningDecisionRecord ;
            dcterms:title "Signal Processing: Image Communication 94 (2021) 116198" ;
            bibo:pmid "local_684969f6" ;
            slr:assessed_on "full_text" ;
            slr:decision "include" ;
            slr:decision_rationale "Full text confirms supervised binary classification of autism from eye-tracking scanpaths on the public Saliency4ASD dataset, with multilayer perceptron, branched MLP, ResNet18/50 and LSTM architectures, extensive ablation over inputs and representations, and accuracy, sensitivity, specificity and AUC reported on both a validation split and a blind test set whose labels were withheld and scored by the challenge organisers." ;
            slr:full_text_source "user_supplied_pdf" ;
            slr:screening_stage "full_text" ],
        [ a prov:Activity,
                slr:ScreeningDecisionRecord ;
            dcterms:title "Artificial Intelligence-Based Detection of Autism Spectrum Disorder Using Linguistic Features" ;
            bibo:pmid "local_786b6280" ;
