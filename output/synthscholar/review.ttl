            oa:hasTarget <https://doi.org/10.1038/s41746-020-0227-5> ;
            slr:claim_label "Each participant contributed a single aggregate feature vector, explicitly avoiding nested repeated measures in the machine learning data." ;
            slr:relevance_score "0.95"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
