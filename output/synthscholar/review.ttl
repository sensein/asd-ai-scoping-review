            slr:decision "include" ;
            slr:decision_rationale "Full text confirms supervised binary classification over the public Kaggle autism facial-image dataset using MobileNetV2 features and an LSTM/DBN/HKELM ensemble. Human-verified corpus; retained per review protocol." ;
            slr:full_text_source "user_supplied_pdf" ;
            slr:screening_stage "full_text" ],
        [ a prov:Activity,
                slr:ScreeningDecisionRecord ;
            dcterms:title "Application of Machine Learning Techniques to Detect the Children with Autism Spectrum Disorder" ;
            bibo:pmid "local_87fe26aa" ;
            slr:assessed_on "title_abstract" ;
