                    slr:tool_name "user_supplied_pdf" ] ;
            slr:artifact_kind <https://w3id.org/slr-ontology/ArtifactKindEnum#source_text_extract> ;
            slr:content_hash "7ad56c01ae859302404d01d80f56591d6e15e183f88730cb3491bb374b414601" ;
            slr:content_size_bytes 59141 ;
            slr:content_withheld "Extracted publisher text removed for redistribution; content_hash retained." ;
            slr:created_at_time "2026-08-14T05:29:22.559723+00:00"^^xsd:dateTime ;
