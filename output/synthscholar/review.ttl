    slr:journal "Sensors, 19(10), Article 2377" ;
    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "Subject-level fold partitioning stated and enforced with both groups evenly split, class priors set to 0.5, permutation testing against chance, a paired statistical comparison between models, and an alternative-technique benchmark reported as null." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "Age- and IQ-matched groups with near-identical means and IQ restricted above 85, but the ASD age range extends to 29 against a control maximum of 21, both groups are heavily male on very small female counts, and no formal comparability tests are reported." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "Trial counts per subject are specified and the exclusion rule for trials without AOI transitions is stated, but the number of trials excluded per group is not reported, and that exclusion may fall disproportionately on ASD subjects given their noted tendency toward stray fixations." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "Prior ICD-10 clinical diagnosis independently re-confirmed by the research team with ADOS-2, with controls screened for absence of any neurodevelopmental history." ] ;
            slr:overall_judgment "low" ;
            slr:tool_used "QUADAS-2" ] .

<urn:slr:article:90d49b4eba84> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Autism spectrum disorder (ASD) is one of the common diseases that affects the language and even the behavior of the subjects. Since the large variations in the symptoms and severities of ASD, the diagnosis becomes a challenging problem. It has been witnessed that deep neural networks have been widely used and achieve good performance in various applications of visual data analysis. In this paper, we propose SP-ASDNet which utilizes both convolutional neural networks (CNNs) and long short-term memory (LSTM) networks to classify whether an observer is typical developed (TD) or has ASD, based on the scanpath of the corresponding observer’s gaze at the given image. The proposed SPASDNet is submitted to 2019 Saliency4ASD grand challenge and achieves 74.22% accuracy for validation." ;
    dcterms:bibliographicCitation "Tao Y; Shyu ML (2019). SP-ASDNet: CNN-LSTM Based ASD Classification Model using Observer ScanPaths. *2019 IEEE International Conference on Multimedia & Expo Workshops (ICMEW)*." ;
    dcterms:creator "Shyu ML",
        "Tao Y" ;
    dcterms:title "SP-ASDNet: CNN-LSTM Based ASD Classification Model using Observer ScanPaths" ;
    bibo:pmid "local_08b8027d" ;
    fabio:hasPublicationYear 2019 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are participants and recruitment adequately described?" ;
                            slr:justification "No counts, ages, genders or selection criteria for either group." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the sample appropriate and adequate for the stated target?" ;
                            slr:justification "Unknown sample; unit of analysis is the scanpath rather than the person." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are comparison groups matched?" ;
                            slr:justification "No demographic information at all." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the reference saliency model appropriate for the population?" ;
                            slr:justification "SalGAN was trained on SALICON, which the authors acknowledge covers a large age range and does not reflect children's saliency distribution, with no child saliency dataset available to retrain." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the behavioral data acquisition described reproducibly?" ;
                            slr:justification "No eye tracker, viewing conditions, durations or calibration - the data are inherited." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are predictors defined without knowledge of outcome?" ;
                            slr:justification "Saliency prediction and feature extraction are fully automatic and label-independent." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the reference standard appropriate and independently applied?" ;
                            slr:justification "No diagnostic information." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the validation-to-test gap acknowledged?" ;
                            slr:justification "The authors state the blind-test performance is much lower and 'could indicate the submitted models being overfitted'." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is model selection separated from the reported validation figure?" ;
                            slr:justification "Six configurations were compared on the same validation set from which the 74.22% headline is taken." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is a genuinely blind held-out evaluation performed?" ;
                            slr:justification "The organiser's test set had labels withheld from the authors." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the internal split participant-independent?" ;
                            slr:justification "Partitioned by image, so the same children's scanpaths span training and validation." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is class imbalance or threshold behaviour addressed?" ;
                            slr:justification "Model A shows 0.8771 recall against 0.5319 precision on the blind test with no rebalancing or threshold discussion." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is stimulus-level variation in performance examined?" ;
                            slr:justification "Per-image accuracy distribution tabulated and best and worst images inspected, showing dependence on the presence of faces and direct gaze." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is code available?" ;
                            slr:justification "The SalGAN implementation is linked to a public repository; the authors' own model is not released." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is blind-test performance reported honestly?" ;
                            slr:justification "All three submitted models' blind-test results are published alongside validation results, with overfitting named as the likely cause." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are ethics and data provenance reported?" ;
                            slr:justification "No ethics, consent or provenance statement." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are limitations of the upstream components acknowledged?" ;
                            slr:justification "SalGAN's training population mismatch and the untested influence of saliency quality on classification are both stated." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the dataset accessible or its access conditions stated?" ;
                            slr:justification "A public Grand Challenge benchmark is used and cited; no access route given." ;
                            slr:rating "Partly" ] ;
                    slr:overall_concern "some concerns" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Validation accuracy across six model configurations; accuracy, recall, precision and F1 on the organiser's blind test set for three submitted models; and a frequency distribution of per-image accuracy across the validation set. Reporting precision and recall separately on the blind test is what makes the error profile visible - model A achieves 0.8771 recall against 0.5319 precision, revealing it is largely defaulting to the ASD label. No AUC, specificity or confidence intervals." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-032" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Evaluation on an organiser-held blind test set with labels withheld is a genuine strength and permits direct comparison against other entrants. Batch normalisation, dropout and a small architecture are used as overfitting controls, and the sensitivity of performance to visual feature dimensionality is explored empirically. But the internal split is partitioned by image rather than participant, model selection was performed on that same validation set across a six-configuration grid, and the resulting 17-19 point drop on the blind test is acknowledged by the authors as probable overfitting. There is no cross-validation, no participant-level partitioning, no permutation testing, no class-imbalance handling despite the precision-recall asymmetry, and no calibration or deployment analysis." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-032" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Supervised deep learning combining convolutional and recurrent architectures: shallow CNNs for per-patch visual encoding and a two-layer LSTM for sequence modelling, with a pretrained generative adversarial saliency model (SalGAN) used upstream as a frozen feature source. No conventional machine-learning comparators are included, and no ablation isolates the contribution of the saliency map versus the raw image." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-032" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Setting not reported - entirely secondary analysis of the Saliency4ASD benchmark, with no description of the original acquisition conditions, viewing durations, eye tracker or calibration." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-032" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2019. The paper documents the intersection of two technical trends: deep saliency prediction models (EML-Net, SalGAN, SAM with attention mechanisms) that have displaced conventional saliency models since 2014, and the application of those models to autism classification. It notes that a saliency prediction dataset for children with ASD exists but comprises only 13 children over 500 images, and cites a prior deep architecture performing ASD classification from sets of images along with an algorithm for selecting the most discriminative image contents. The existence of the Saliency4ASD challenge with a blind test track is itself evidence of the field's move toward benchmark evaluation, and the fact that two entries in this corpus independently report the same validation-to-test collapse makes that benchmark unusually informative." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-032" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "IEEE International Conference on Multimedia and Expo Workshops (ICMEW) 2019, as an entry to the Saliency4ASD Grand Challenge track 2 - a multimedia and computer-vision venue, not an autism or clinical venue." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-032" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Reasonable for a four-page challenge entry. The source dataset is a public benchmark with an organiser-defined blind test set. The CNN architectures are fully tabulated (layer type, channel count, kernel size, stride), the patch size (225, a=112), LSTM length (40), zero-padding rules, optimiser, learning rate, momentum, batch size, epochs and model-selection criterion are all specified, and the SalGAN implementation is linked to a public repository. What is missing: no code release for the authors' own model, no random seeds, no participant information, and no statement of how many scanpaths entered training and validation." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-032" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Fusion of behavioural and stimulus-derived information at two levels. Per fixation, a 1024-dimensional CNN encoding of the saliency-map patch is concatenated with the fixation duration, giving a 1025-dimensional vector that combines spatial-saliency context with temporal information. Across fixations, a two-layer LSTM integrates the sequence, explicitly to capture 'the temporal information and sequential dependency of the scanpaths'. No fusion across behavioural modalities and no integration with clinical or demographic data - the latter being impossible given the dataset." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-032" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Not reported. Class labels are inherited from the Saliency4ASD challenge dataset with no description of how diagnoses were established or how typically developing status was confirmed." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-032" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No acquisition hardware. Software: the SalGAN generator pretrained on SALICON (referenced to a public GitHub implementation) for saliency prediction; custom shallow CNNs in two variants with full layer specifications given in a table; a two-layer LSTM of length 40 with max-pooling; batch normalisation and dropout. Training on an NVIDIA P100 GPU with 16GB memory, Adam optimiser, learning rate 1e-5, momentum 0.9, batch size 8, 30 epochs." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-032" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Nothing reported. No participant counts beyond 14 viewers per image per group, no ages, no age ranges, no standard deviations, no gender distribution, and no matching or comparability information for either group. The paper notes that scanpath counts per image vary because some children looked outside the image, but gives no participant-level accounting." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-032" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Reported by the authors: the blind-test performance 'is much lower than that of the validation dataset, which could indicate the submitted models being overfitted', with a call to further investigate the structure of visual attention to mitigate this. They also note candidly that SalGAN was trained on SALICON, 'collected from subjects over a large age range and thus not perfectly reflected the saliency distribution of the children', and that no public large-scale child saliency dataset exists to retrain it. They further acknowledge that the influence of saliency prediction quality on final classification has not been exhaustively tested. Identifiable in review: the internal split is partitioned by image, not participant, so the same children appear in both training and validation; model selection across two CNN variants, three feature dimensionalities and two normalisation settings was performed on that same validation set, compounding optimism; no participant counts, ages, genders or diagnostic information exist; the unit of analysis is the scanpath rather than the person; and blind-test precision of 0.5319-0.5684 with recall up to 0.8771 for model A indicates the best-recall model achieves it by over-calling ASD." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-032" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional; single-session viewing per the source dataset, with no temporal or longitudinal component. Data are fixation coordinates over public stimulus images, so re-identification risk is minimal. No ethics approval, consent or provenance statement appears - common for secondary benchmark use but not acknowledged as such." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-032" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None reported. No cognitive, linguistic, adaptive or severity measures and no comorbidity information." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-032" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A distinctive representation: rather than encoding fixation coordinates directly, each fixation is represented by the local neighbourhood of a predicted saliency map, so the model sees the saliency context of what was fixated. Duration is appended per fixation, and the sequence is processed recurrently with zero-padding to fixed length 40 and max-pooling over LSTM outputs. This preserves fixation order and duration while abstracting away absolute position." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-032" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two groups by dataset label - ASD and typically developing - with 14 of each viewing every image, though the paper notes 'some of the images have less than 14 scanpaths from the TD or ASD groups' because some children did not look inside the image bounds. The total number of distinct participants is never stated, so the actual sample size is unrecoverable. No other-diagnosis group." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-032" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Gaze: fixation locations and durations during image viewing. As with Wu et al. on the same benchmark, gaze is not analysed in isolation but relative to a computational model of typical viewing - here by sampling a predicted saliency map at each fixation, so the representation encodes how salient the fixated locations were to a general-population saliency model rather than where the child looked in absolute coordinates." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-032" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Index terms: Autism Spectrum Disorder (ASD), Deep Neural Network (DNN), Long-Short Term Memory (LSTM) Network, Saliency Prediction. Task vocabulary: 'objectively assess', 'early-stage detection', 'monitoring the efficiency of the ASD remediation protocol', 'observer scanpaths'. The framing is predominantly technical, with autism described as a 'disease' in the opening sentences." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-032" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No feature-level interpretability - no saliency analysis, attention visualisation or ablation of the model itself. But the per-image accuracy analysis functions as a stimulus-level interpretability result and is a genuine contribution: accuracy varied from below 0.5 to above 0.8 across validation images, and inspection of the best and worst five showed that 'when there is a person, especially when the person is looking at the camera when the image was taken, the model performs better', while natural scenes without faces performed worse. This implies that reported aggregate accuracies on this benchmark are heavily dependent on stimulus composition." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-032" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Investigate and integrate attention mechanisms into the architecture; explore incorporating additional image features; and - notably - 'a thorough investigation on the differences in the scanpaths between ASD and TD children will also be conducted', an explicit acknowledgement that the model was built and evaluated without establishing what behavioural difference it is exploiting." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-032" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Goal: objective scanpath-based ASD screening, motivated by the observation that comprehensive ASD evaluation 'requires the assessment from well-trained specialists, which is not available in less-developed regions'. Main findings: 74.22% validation accuracy; 55.66-57.90% on the organiser's blind test set, which the authors attribute to overfitting; performance peaked at 1024 visual features and degraded at both 512 and 2048; and per-image accuracy varied widely with images containing people, particularly looking at the camera, classified better than natural scenes without faces." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-032" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "'children with ASD', 'people with ASD', 'the subjects', 'typical developed (TD)', 'TD children', 'normal observer', 'normal people'. Mixed and somewhat inconsistent - the comparison group is variously 'typical developed', 'normal observer' and 'normal people', and autism is described in the opening lines as 'one of the common diseases' and 'a developmental disease', which is more pathologising than most of the corpus." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-032" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Image viewing with gaze recording, per the source dataset; no task instruction, duration or presentation detail is given. The analysis pipeline adds a computational stage: SalGAN generates a reference saliency map representing where a general-population observer would look, and 225x225 patches are cropped from that map at each fixation location, so the model sees not where the child looked in absolute terms but what the predicted saliency landscape looked like at each fixated point." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-032" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "Not reported in this paper - viewing durations per image are not stated" ;
                    slr:study_design "Cross-sectional classification study on a shared benchmark with an organiser-provided blind test set; entry to the Saliency4ASD Grand Challenge track 2" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: 14 children with ASD viewed each image; total distinct participants not stated; comparison: 14 per image; total distinct participants not stated" ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "A CNN-LSTM operating on saliency-map patches sampled at fixation locations classified ASD from typically developing observers at 74.22% on an image-partitioned validation split, but fell to 55.66-57.90% on the organiser's blind test set. The authors state directly that this gap 'could indicate the submitted models being overfitted'. Two secondary findings are informative: performance was sensitive",
                        "Validation: best 74.22% accuracy (model A, 1024 visual features, with batch normalisation); model B with batch normalisation 74.19%; without batch normalisation 73.21% and 73.48%; performance degraded at 512 features (58.60%, 60.79%) and at 2048 features (68.89%, 68.05%). Blind test set: model A with BN 0.5566 accuracy, 0.8771 recall, 0.5319 precision, 0.6577 F1; model B with BN 0.5739, 0.5936, 0." ;
                    slr:outcome "Accuracy on the validation set across model configurations; accuracy, recall, precision and F1 on the organiser's blind test set; and a frequency distribution of per-image accuracy" ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "Validation: best 74.22% accuracy (model A, 1024 visual features, with batch normalisation); model B with batch normalisation 74.19%; without batch normalisation 73.21% and 73.48%; performance degraded at 512 features (58.60%, 60.79%) and at 2048 features (68.89%, 68.05%). Blind test set: model A with BN 0.5566 accuracy, 0.8771 recall, 0.5319 precision, 0.6577 F1; model B with BN 0.5739, 0.5936, 0.; A CNN-LSTM operating on saliency-map patches sampled at fixation locations classified ASD from typically developing observers at 74.22% on an image-partitioned validation split, but fell to 55.66-57.90% on the organiser's blind test set. The authors state directly that this gap 'could indicate the submitted models being overfitted'. Two secondary findings are informative: performance was sensitive" ] ] ;
