    slr:journal "2024 IEEE 3rd International Conference on Computing and Machine Intelligence (ICMI)" ;
    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Sixty-four children assembled from four archived corpora, with the typically developing class partly drawn from two corpora containing no autistic children, so corpus of origin is partly correlated with class. Age and sex composition by diagnostic group is unreported, in a study whose leading feature the paper itself shows to increase with age. Developmentally delayed children present in a source corpus were deliberately excluded." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "Features are standard psycholinguistic quantities computed by documented rules against TalkBank's transcription guide, with count-based measures normalised as ratios to the investigator specifically to handle differing transcript lengths - careful handling of cross-corpus comparability. But session protocols differ in length, structure and investigator role across the four corpora, and half the features are ratios to that investigator's output; and the headline accuracies followed removal of features selected on the same data." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "Diagnoses are inherited from established research archives whose contributing studies performed documented clinical ascertainment, so the labels are genuine - materially better than the folder-membership and hashtag labels elsewhere in this review. But this paper transmits no instrument, criteria, clinician qualification or date, and the typically developing designation for two corpora rests on their being collected from typically developing populations with no screening described." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "Each child contributes one transcript and one feature vector, so the split unit is the person and no within-participant leakage is possible. Evaluation is a 75/25 split repeated over 50 random draws, with the number justified by a stated stability criterion, and ROC variability bands are reported. No attrition or excluded transcripts beyond the stated exclusion of developmentally delayed children." ] ;
            slr:overall_judgment "high" ;
            slr:tool_used "QUADAS-2" ] .

<urn:slr:article:e03dbcffcbc9> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Artiﬁcial intelligence (AI) and machine learning (ML) have made signiﬁcant advances in the early detection and diagnosis of autism spectrum disorder (ASD), overcoming the limits of previous screening methods. These AI-based technologies offer more objective, scalable, and efﬁcient methods for identifying risk behaviors associated with ASD. This article presents a novel approach for enhancing the detection and classiﬁcation of ASD by integrating squeeze-and-excitation, multiscale attention mechanisms, and convolutional neural networks (CNNs) with automated hyperparameter optimization using the white shark optimization (WSO) algorithm. By leveraging attention mechanisms to focus on relevant facial features across multiple scales, this method enhances feature extraction, improves classiﬁcation accuracy, and provides a robust framework for analyzing complex facial imaging data. An extensive autism dataset, encompassing both facial and multimodal datasets, was utilized in this study, including subjects from the non-ASD control (NC) group and individuals diagnosed with ASD. Experimental results demonstrate that the proposed model signiﬁcantly outperforms state-of-the-art methods, achieving a high accuracy of 95.36%, precision of 92.62%, and an F1-score of 95.5% for ASD detection and classiﬁcation. This proposed model is a promising tool for the accurate and early identiﬁcation of ASD, which is crucial for effective treatment and management. By providing deeper insights into distinctive facial patterns and morphological features associated with ASD, the model enables physicians to make more informed decisions and develop targeted treatment plans, ultimately improving patient outcomes. Subjects Bioinformatics, Algorithms and Analysis of Algorithms, Artiﬁcial Intelligence, Data Science" ;
    dcterms:bibliographicCitation "Ismail WN; Ali MAS (2024). Multiscale attention-based network to enhance detection and classification of autism spectrum disorders using convolutional neural network. *PeerJ Computer Science, 11, Article e3*." ;
    dcterms:creator "Ali MAS",
        "Ismail WN" ;
    dcterms:title "Multiscale attention-based network to enhance detection and classification of autism spectrum disorders using convolutional neural network" ;
    bibo:pmid "local_b9e05a8f" ;
    fabio:hasPublicationYear 2024 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Participant selection and spectrum representativeness" ;
                            slr:justification "Images harvested from the internet by third parties. The number of distinct children is unknown; the paper's table labels 2,866 images as 'Total individuals'. No ascertainment process, no spectrum description, no clinical setting." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Comparison group adequacy" ;
                            slr:justification "Controls are images from non-autism-related internet sources and frames from unrelated kindergarten videos. The comparison group differs from the index group in how it reached the internet, and possibly in nothing about the children themselves." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Confounder control" ;
                            slr:justification "No demographic variable is available for either class, and the sex distribution is explicitly recorded as unspecified. Age, sex, ancestry and image-acquisition conditions are all free to differ systematically between classes and none can be tested." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Handling of missing data and attrition" ;
                            slr:justification "Split sizes are reported precisely for both corpora, but the number of MTCNN face-detection failures is not given, no image-quality exclusion criteria are stated, and 28 test images were reassigned to training by a similarity rule." ;
                            slr:rating "Unclear" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Reference standard quality" ;
                            slr:justification "None exists. No diagnostic instrument, clinician judgement or medical record for any image; the label is image provenance. The paper nonetheless describes the positive class as diagnosed individuals." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Outcome measurement blinding" ;
                            slr:justification "Classification is fully automated from image data with no human rater involved at inference." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Measurement standardisation" ;
                            slr:justification "Uncontrolled consumer photographs and video frames with unknown and class-correlated acquisition conditions. Preprocessing standardises geometry and pixel range but cannot standardise camera, lighting, pose, expression or compression." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Index test definition and prespecification" ;
                            slr:justification "Hyperparameters selected by a metaheuristic search over six ranges whose evaluation partition is unstated; no prespecified operating threshold; four model configurations compared on the same data." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Preprocessing and feature selection nesting" ;
                            slr:justification "The white shark search over learning rate, layer widths, batch size, depth and kernel size does not state which partition its fitness was computed on. Fitness is described as evaluated 'across folds' although no cross-validation scheme is defined elsewhere." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Performance estimation and chance level" ;
                            slr:justification "Confidence intervals of plus or minus 0.4 percentage points are reported on test sets as small as 68 images, where one image is worth 1.47 points and an exact binomial interval around 95% spans roughly 87% to 99%. No chance or trivial baseline; no positive predictive value at any realistic prevalence despite an assembled 1:1 ratio." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Sample size adequacy for the modelling" ;
                            slr:justification "A deep attention architecture with metaheuristic hyperparameter search trained on 951 images and evaluated on 68 in the video corpus. Image counts also overstate the effective sample, since the number of distinct children is unknown in both datasets." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Data splitting and leakage control" ;
                            slr:justification "The best treatment of this issue in the facial-photograph branch: leakage was measured rather than assumed, found at 0.9714 maximum similarity, and addressed by perceptual-cluster splitting with a documented sweep and threshold. But perceptual similarity is a proxy for identity rather than a measurement of it, the reassignment step edits the test set using the model's own feature space, and none of it touches the provenance confound that determines what the labels mean." ;
                            slr:rating "Unclear" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Acknowledgement of limitations" ;
                            slr:justification "Computational cost is named, the absence of clinical validation of the Grad-CAM heatmaps is stated in the authors' own voice with a concrete remedy, and the ablation admits that the paper's own multiscale contribution underperforms without the hyperparameter search. But the provenance confound, the absent reference standard, the missing demographics and the implausible intervals are all unmentioned, and the conclusion tells clinicians that the highlighted facial traits 'indicate the condition'." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Completeness of methods reporting" ;
                            slr:justification "Dataset URLs, preprocessing, exact split sizes, the leakage algorithm in pseudocode with thresholds and cluster sweep, the full training regime, hyperparameter bounds, hardware and software environment, and the metric definitions are all reported. The computational description is among the most complete in the corpus; what is missing is entirely on the human side." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Data, code and protocol availability" ;
                            slr:justification "Both datasets public with URLs given; code on GitHub and archived on Zenodo with a DOI and a version tag. Among the strongest availability records in this review." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Reporting of results and uncertainty" ;
                            slr:justification "A broad metric suite with curves and significance tests, and an internally consistent headline triple - but intervals narrower than a single test image, no chance baseline, no prevalence-adjusted predictive value, and no statement of how many runs underlie the reported means." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Ethics, consent and conflicts" ;
                            slr:justification "No ethics statement, no institutional approval and no consent statement anywhere in the paper, for a study trained on identifiable photographs and video frames of children scraped from personal websites, Facebook pages and YouTube. Funding, competing interests, author contributions and generative-AI use are all declared, so the omission is specific to human-subjects considerations." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "unclear" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The broadest metric set in this branch: accuracy, precision, recall, F1, Cohen's kappa, specificity, AUC and AUC-PR, with confusion matrices, ROC and precision-recall curves, means and standard deviations across runs, 95% intervals, McNemar's test and paired t-tests. The apparatus is well beyond what most facial-image papers in this review report, and the headline triple is internally coherent - 95.36% accuracy with 92.62% precision and 95.5% F1 implies recall 98.6% and specificity 92.2% at a 1:1 ratio, which reproduces the stated accuracy exactly. Two failures nonetheless undercut the reporting. The intervals are not compatible with the data: every one is the mean plus or minus 0.4 percentage points, accompanied by a standard deviation of 0.03, on test sets as small as 68 images where a single misclassification moves accuracy by 1.47 points; an exact binomial interval around 95% on 68 images spans roughly 87% to 99%. And no positive predictive value is computed for any realistic prevalence, despite a 1:1 class ratio that exists only because the datasets were assembled that way - at a population rate near 1-2%, a specificity of 92% would place the great majority of positive calls on non-autistic children." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-122" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Keywords: artificial intelligence (misspelled as 'artificial intellgent' in the published keyword list), multi-scale view convolutional neural network (SE-MSF-CNN), autism spectrum disorder, white shark optimisation. The set is entirely method-facing - three of four terms name the architecture or the optimiser - with no term describing the population, the data source, the behaviour or the clinical question. That distribution is characteristic of the branch and is one reason these papers are hard to locate from a clinical search. Terms recurring in the body: squeeze-and-excitation, multiscale attention, Grad-CAM, explainable artificial intelligence, transfer learning, craniofacial anomalies, facial masculinity, cosine similarity, K-Means, leakage." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-122" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Grad-CAM heatmaps are computed over the attention-generated feature maps and presented as ensuring 'transparency and reliability in decision-making'. The authors then add the qualification that distinguishes this paper from others in the branch: the heatmaps were never shown to clinicians, so their diagnostic meaning is unassessed, and collaboration with psychiatrists or autism specialists is recommended to establish whether the highlighted regions are informative. That is the correct caveat and it is stated in the authors' own voice. Its limits should be clear, though. Saliency identifies where in the image the model looked, not what property it responded to, and every candidate explanation for the result - craniofacial shape, expression, apparent age, ancestry, image resolution, crop convention - is located in the same face region. A heatmap centred on the eyes and mouth is therefore equally consistent with a facial phenotype and with the model having learned to recognise the photographic style of images that appear on autism support pages. The conclusion nevertheless instructs clinicians that they 'must recognize these facial traits or regions, as they indicate the condition', which asserts precisely what the heatmaps cannot establish." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-122" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two directions are named: clinical validation of the Grad-CAM heatmaps by psychiatrists or autism specialists, which is the right next step for the interpretability claim; and reduction of the computational cost for real-time use. Not proposed, and needed before any of the reported figures could support the paper's clinical claims: evaluation on a cohort with documented diagnoses, reporting of the demographic composition of each class, a test of whether the model's output survives matching on age and sex, and an assessment of whether the classifier's decisions track image provenance rather than facial phenotype." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-122" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "There is none. No child in either corpus is known to the authors to have received a diagnostic assessment. In the Piosenka dataset the positive label means an image was found on a website or Facebook page with autism-related content; in the YTUIA dataset it means a video was collected into a corpus of self-stimulatory behaviour, half from YouTube and half from therapists and professional organisations. Neither carries a clinician judgement, a diagnostic instrument, a medical record or any documented ascertainment. The paper cites no reference standard, does not identify the absence as a limitation, and describes the positive class throughout as 'individuals diagnosed with ASD' - a description the data cannot support. The YTUIA positives at least depict a behaviour that is associated with autism, which places them a step above pure provenance labelling; but the modelling target is the face crop rather than the behaviour, so even that association does not transfer to what the model is trained on. This is the same reference-standard failure recorded for the other Piosenka-based papers in this review, and it bounds every figure the paper reports." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-122" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional and retrospective, with no longitudinal element and no repeat measurement. The ethics reporting is the notable gap: the paper contains no ethics statement, no institutional review board approval and no consent statement of any kind - a full-text search returns no occurrence of 'ethic' or 'consent'. Analysis of public datasets frequently proceeds without fresh approval, and PeerJ's declaration structure elicited funding, competing-interests, author-contribution and data-availability statements from these authors, so the omission is specific to human-subjects considerations. The data are identifiable photographs and video frames of children, harvested from personal websites, Facebook pages and YouTube, whose families posted them to seek support or raise awareness and did not consent to their use as training data for an autism classifier. The paper's conclusion envisages clinical deployment of a model built on that material without touching the question. Funding from King Faisal University grant KFU250488 is declared with a no-role statement, competing interests are declared as none, and the authors disclose that generative AI was used to correct the English." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-122" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "PeerJ Computer Science 11:e3134, submitted 8 April 2025, accepted 29 July 2025, published 2 October 2025, open access under CC-BY 4.0, academic editor Davide Chicco, with subject areas listed as bioinformatics, algorithms, artificial intelligence and data science. The venue is a computer science journal, which shapes what the review process attended to: the paper's statistical comparison of model variants, its ablation design, its code archiving on Zenodo and its leakage analysis are all above the norm for this branch, while the absence of any ethics statement, any diagnostic reference standard and any demographic description passed without comment. PeerJ's declaration structure elicited funding, competing-interests, author-contribution and data-availability statements from these authors but has no field that would have prompted a human-subjects declaration. The bibliographic record also carries an inconsistency worth noting for the corpus: the supplied metadata dates the article to 2024 while the article itself is a 2025 publication." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-122" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "RGB face crops, normalised to [0, 1], obtained by third-party cropping in dataset 1 and by MTCNN detection with alignment, cropping and resizing in dataset 2. No landmark coordinates, no morphometric derivations, no temporal sequence. The representation therefore cannot express any of the specific craniofacial or expression-dynamic constructs the introduction invokes, and it retains every source-dependent property of the image - resolution, compression, illumination, pose, background - that is free to vary with class given how the two classes were harvested." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-122" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. No task, paradigm or elicitation procedure exists in either corpus. The children in the Piosenka images were photographed for reasons unrelated to any study, and the YTUIA videos were recorded by families and organisations for their own purposes. This has a specific analytic consequence the paper does not draw: the introduction motivates the work through evidence about facial expression dynamics - that autistic infants 'exhibit more complex facial expressions than their typically developing classmates, particularly in the eyebrows and lips' - but nothing in an uncontrolled still photograph or an isolated video frame holds expression, pose, gaze, emotional context or elicitation constant, so a difference in expression between classes cannot be distinguished from a difference in the circumstances under which the two classes of image were taken." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-122" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Better than most of this branch on the computational side and empty on the human side. Fully reported: both dataset URLs, the preprocessing pipeline, the final split sizes for both corpora, the leakage-detection procedure in pseudocode with its cosine thresholds, cluster sweep from 30 to 150 and reassignment rule, the training regime including early stopping with patience 5, checkpointing on best validation loss and learning-rate reduction by a factor of 0.1 on a plateau of 3, the hyperparameter search bounds, the white shark configuration, the hardware and software environment, and the full metric suite with McNemar and paired t-tests. Code is on GitHub and archived on Zenodo with a DOI, which places this paper in the minority of the corpus that permits computational replication. Not reported: the number of distinct individuals behind either image count, any demographic composition, which data partition the hyperparameter fitness was evaluated on, the number of runs behind the reported means, and how the confidence intervals were computed. The stated search dimension of 3 is also inconsistent with the six hyperparameter ranges tabulated." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-122" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Almost entirely absent, and the paper marks the absence in its own table. Age is given as a range of 1-11 for dataset 1 and not at all for dataset 2; the sex distribution is recorded as 'Females/Males: -' with the note 'Gender distribution unspecified'; and no information exists on ancestry, socioeconomic status, cognitive level, language, comorbidity or medication for either class. No between-class comparison of any characteristic is possible, and none is attempted. Two consequences follow directly. Because autism is diagnosed roughly four times more often in boys, and because facial classifiers are known to key strongly on sex-linked morphology, an unmeasured sex imbalance between classes is a live and untestable alternative explanation for the entire result. And because the two classes were harvested from different regions of the internet - autism advocacy and support content on one side, general and kindergarten content on the other - they are likely to differ in the geography, ancestry and photographic circumstances of the children depicted, none of which can be checked. The reported cross-dataset transfer does not resolve this, since both corpora were constructed on the same principle." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-122" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None in the sense this review uses the term. The paper's 'multiscale fusion' combines feature maps at different spatial resolutions within a single network operating on a single image modality, and the abstract's reference to 'both facial and multimodal datasets' is not borne out by the methods - both corpora are collections of still images. The multiscale ablation is nonetheless informative and is reported honestly: without the hyperparameter search, adding multiscale fusion lowered accuracy from 0.89 to 0.85, and the authors state that 'adding multi-scale fusion may not have yielded better results'. Only in combination with white shark optimisation does the fuller architecture win, which means the architectural contribution and the search contribution are not separable in the reported comparison." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-122" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The most developed validation section in the facial-image branch of this review, and worth recording carefully because it is the one place where a paper in that branch takes leakage seriously. The authors recognised that the video-derived corpus risks subject-level and temporal leakage under frame-level splitting, and rather than asserting the problem away they measured it: ResNet-50 features for all 1,163 images, maximum training-test cosine similarity of 0.9714, correctly interpreted as 'a substantial likelihood of leakage'. They then applied K-Means over the deep features, swept cluster counts from 30 to 150, split clusters rather than images 80/10/10, and reassigned test images exceeding 0.90 similarity to a training image back into the training set, adopting the 100-cluster configuration for its balance of test-set size (68 images), final similarity (0.8989) and reassignment count (28). The same check on the Piosenka corpus returned 0.90, and the original split was kept. Compared with the four other Piosenka-based papers charted here, all of which split images without comment, this is a substantial advance. Three qualifications bound it. Perceptual similarity is a proxy for identity and not a measurement of it - two images of one child under different lighting can fall below any threshold while two different children in matched conditions can exceed it - so the paper's claim to have confirmed 'the absence of subject- or frame-level leakage' asserts more than a cosine threshold can support. The reassignment step edits the test set using the model's own feature space, moving out precisely the images most similar to training data, which makes the reported performance conditional on a data-dependent curation rule. And the leakage machinery addresses only within-corpus duplication; it does nothing about the confound that determines what the labels mean, since a model that has learned to recognise images sourced from autism-related web content will do so equally well on perfectly disjoint subjects. The cross-dataset evaluation deserves the same reading. Training on one corpus and testing on the other reached 89-90% in both directions, which the paper offers as robustness. But both corpora were built by the same principle - autism-labelled material harvested from autism-associated online sources, controls from general online sources - so a confound common to both transfers exactly as a genuine phenotype would. Transfer between two datasets that share a construction bias is not independent confirmation; transfer to a clinically ascertained cohort would be, and is not attempted. The remaining gaps are the unstated evaluation partition for the hyperparameter fitness, the absence of any chance or prevalence baseline, and confidence intervals incompatible with the test set sizes." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-122" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "There are no participants. The units are images: 2,866 in the Piosenka Kaggle collection, split 1,433 autism-labelled and 1,433 control, described as ages 1-11; and 1,163 face crops extracted with MTCNN from the YTUIA/SSBD video corpus, split after re-clustering into 951 training, 144 validation and 68 test. The number of distinct children behind either figure is unknown and unreported - the paper's own table labels the 2,866 images as 'Total individuals', which is the conflation this review has repeatedly recorded in the image-classification branch. The provenance of each class is stated plainly and is the decisive fact: the autism images were 'taken from websites and Facebook pages that included autism-related content', while the YTUIA positives derive from 100 videos assembled to depict self-stimulatory behaviour, of which 50 came from YouTube and 50 from therapists and professional organisations, with controls being 'YouTube videos featuring kindergarten activities within the relevant age range'. In both corpora, therefore, the class label records where material was found rather than any assessment of the child depicted." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-122" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. No cognitive, severity, adaptive or language measure exists for any image in either corpus, and none could, given how the data were assembled. The introduction cites literature relating intercanthal distance and facial midline height to autism severity, which would make a severity analysis the natural test of whether the model has learned anything morphological - but no severity data exist to run it against, and the point is not raised." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-122" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two limitations are stated and both are real. The computational cost of a deep multiscale attention architecture combined with metaheuristic search is acknowledged as a barrier to real-time deployment. And the interpretability claim is qualified honestly: 'clinical users or experts did not validate our heatmaps, limiting our ability to assess their potential clinical utility', with a concrete remedy proposed. The ablation discussion adds a third, unprompted admission - that multiscale fusion alone did not improve on squeeze-and-excitation alone. What is not stated is more consequential. The provenance confound is never raised, although the paper supplies the evidence for it in its own description of where the images came from. No diagnostic reference standard exists for either corpus and this is not identified as a limitation. Demographics are absent and marked as absent, yet the possibility that age, sex or ancestry imbalance drives the result is not discussed. The 1:1 class ratio bears no relation to prevalence and no positive predictive value is computed. The confidence intervals - uniformly the mean plus or minus 0.4 points, on a test set of 68 images where one image is worth 1.47 points - cannot be describing the uncertainty in the accuracy estimate; an exact binomial interval around 95% on 68 images runs from roughly 87% to 99%. The cross-dataset result is offered as robustness without noting that both corpora were built the same way. And the ethics of the underlying images is untouched." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-122" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Published 2025 by information systems and computer science groups at Al Yamamah University Riyadh, Minia University and King Faisal University, funded by King Faisal University grant KFU250488. The framing is the standard early-detection appeal - screening is subjective, expertise is scarce, and a facial-image classifier would be objective, scalable and non-invasive - built on a physiognomic literature the introduction reviews approvingly and the conclusion endorses, telling clinicians that facial traits 'indicate the condition'. For this review the paper occupies an unusual position, and its value lies in the tension between its two halves. Methodologically it is the best-executed study in the facial-photograph branch: it is the only one to test for leakage rather than assume its absence, and it found a maximum training-test similarity of 0.9714 in the video-derived corpus, which is direct evidence that the naive frame-level splitting practised by the papers it draws on does leak; it is one of the few in the whole corpus to archive its code with a DOI; it reports a full metric suite with significance testing; its ablation honestly records that its own architectural contribution underperforms without the accompanying hyperparameter search; and it evaluates across datasets in both directions. Substantively, none of that reaches the problem, because the labels in both corpora encode where an image was found rather than any assessment of the child in it - a fact the paper states in its own methods and never revisits. The cross-dataset result sharpens rather than resolves this: two corpora built by the same principle, autism-labelled material from autism-associated online sources against controls from general online sources, will share their confounds, so 89-90% transfer between them is what a provenance-driven model would produce as readily as a phenotype-driven one. The lesson the review should carry from this paper is that methodological rigour applied downstream of a corrupted label does not repair it, and can make an uninterpretable result look better validated than the less careful papers alongside it. Two further points belong in the discussion: no ethics or consent statement appears anywhere in a paper whose training data are identifiable photographs of children scraped from personal websites, Facebook pages and YouTube; and the reported confidence intervals of plus or minus 0.4 percentage points on a 68-image test set are narrower than a single test image, which is a reporting failure that the journal's statistical framing did not catch." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-122" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Consistently medical and deficit-framed, with the diagnostic label used as an attribute of appearance. Autism is 'a complex neurodevelopmental disorder that affects both cognitive and social development' posing 'a significant concern in modern healthcare'. The facial framing is the distinctive feature: the introduction assembles a physiognomic case - 'craniofacial anomalies make neuro-developmental disorders like ASD more likely to happen', autism severity 'has been associated with a wider intercanthal distance and a lower height of the facial midline', and 'facial asymmetry and facial masculinity are good signs that someone has significant ASD symptoms'. The conclusion instructs clinicians that they 'must recognize these facial traits or regions, as they indicate the condition'. Person-first phrasing appears alongside 'individuals diagnosed with ASD' and 'the non-ASD control group'. There is no neurodiversity framing, no autistic-community involvement, and no acknowledgement that a facial-appearance classifier trained on photographs of children scraped from support and awareness pages carries a different set of ethical questions from a behavioural measurement." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-122" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The stated aim is to improve facial-image-based autism detection by combining squeeze-and-excitation channel attention, multiscale feature fusion and convolutional networks with automated hyperparameter search using the white shark optimisation algorithm, motivated by four claimed gaps in prior work: limited modelling of long-range dependencies by CNNs, insufficient local inductive bias when images are treated as token sequences, weak interpretability, and inadequate splitting strategies. The headline finding is 95.36% accuracy, 92.62% precision and 95.5% F1 - a triple that is arithmetically consistent with a recall of 98.6% and a specificity of 92.2% at the reported 1:1 ratio, which is worth noting because internal inconsistency is common in this branch. Three secondary findings carry more weight than the headline. The ablation shows that the paper's own multiscale fusion contribution reduces accuracy relative to squeeze-and-excitation alone when the hyperparameter search is removed (0.85 against 0.89), and the authors state this plainly rather than burying it. The leakage investigation on the video-derived corpus found a maximum training-test cosine similarity of 0.9714 before intervention, which is direct evidence that naive frame-level splitting of that dataset - the standard practice in the papers it is drawn from - leaks. And bidirectional cross-dataset evaluation reached 89-90%, which the paper presents as robustness and which is better read as evidence that whatever the model has learned is common to two corpora built by the same web-scraping principle." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-122" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No acquisition equipment exists. Computation used an NVIDIA Tesla T4 GPU on Google Colab under Python 3.8 with 12 GB RAM and 16 GB GPU memory, batch sizes between 32 and 128. MTCNN performed face detection on the video frames, followed by alignment, cropping and resizing; pixel values were normalised to [0, 1]. A pretrained ResNet-50 supplied the feature space for the leakage analysis. Because the images come from unknown consumer cameras and phones under unknown conditions, every acquisition variable that a purpose-built study would control - focal length, sensor, resolution, illumination, distance, compression - varies freely and, critically, may vary systematically with class, since the two classes were harvested from different kinds of online source." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-122" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No study setting exists. Both corpora are secondary web collections assembled by third parties, and the computational work was done on Google Colab. This matters more here than in most secondary-data studies in this review, because the setting is precisely what generates the labels: the Piosenka positive class is defined by having been found on autism-related websites and Facebook pages, and the YTUIA classes are defined by being drawn from a self-stimulatory-behaviour video corpus versus unrelated kindergarten videos. In a study where the data collection setting differs systematically between classes and no other ascertainment exists, the setting is the confound rather than a background detail." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-122" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Deep convolutional networks with channel attention and multiscale feature fusion, in four configurations - SE-CNN and SE-MSF-CNN, each with and without white shark optimisation. White shark optimisation is a swarm metaheuristic that adjusts learning rate, layer widths, batch size, depth and kernel size against a fitness combining accuracy, F1 and loss. The reported configuration is ten agents over two iterations, roughly twenty fitness evaluations, which is a very shallow search for a six-dimensional space - and the tabulated dimension of 3 does not match the six ranges given. The evaluation partition for the fitness function is not stated, which matters: if fitness was computed on the test partition, the reported test performance is a selection maximum rather than a held-out estimate. Comparison across configurations is supported by McNemar's test and paired t-tests with p below 0.01, more statistical care than is usual in this branch, applied to a comparison whose foundation - the labels - is the unexamined part." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-122" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Nominally facial morphology and expression; operationally, whatever separates two sets of internet images. The motivating literature is specific - intercanthal distance, facial midline height, facial asymmetry, facial masculinity, and increased complexity of eyebrow and lip movement in autistic infants - but none of it is operationalised. The representation is a raw RGB face crop, so no morphometric measurement is extracted, no landmark geometry is computed, and no temporal information is retained, which rules out expression dynamics entirely. What the network can key on is unconstrained: craniofacial shape, but equally facial expression at the captured instant, head pose, apparent age, ancestry, image resolution, compression artefacts, illumination, background and crop convention. The paper's leakage analysis inadvertently demonstrates how much non-diagnostic structure the images carry - a maximum training-test cosine similarity of 0.9714 in a pretrained ResNet-50 feature space, on a corpus that supposedly contains different children." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-122" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:study_design "Retrospective algorithm-development study on two secondary public image corpora, with within-dataset evaluation, an ablation study, statistical comparison of model variants and bid…" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: ; comparison: 1,433 images labelled non-ASD control in dataset 1; controls in dataset 2 are frames from 'YouTube videos featuring kindergarten activities within the relevant age range'" ] ] ;
    slr:content_sha256 "afa0cc4def9842bae59f4d2579dc0099b8fa3f652949cf315711c76368384b39" ;
