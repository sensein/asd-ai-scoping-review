    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Labels inherited from the public dataset with no diagnostic instrument, criterion, assessor or date reported for any participant." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "Subject-wise aggregation and evaluation adopted explicitly to prevent leakage, with fold-wise means and standard deviations reported. However, test folds hold only five or six people, and the within-subject resampling step that generates additional subject-level samples is not located unambiguously relative to the fold split." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "Nine interpretable handcrafted scanpath descriptors with stated definitions, a specified 20-fixation truncation rule and participant-level aggregation; permutation importance explicitly excluded from model selection. But no hyperparameters beyond k=3, no seed and no software are given." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Twenty-eight participants from a public dataset with no age, sex, cognitive ability, recruitment source, country or task information reported, and no summary of the originating collection." ] ;
            slr:overall_judgment "high" ;
            slr:tool_used "QUADAS-2" ] .

<urn:slr:article:12377c334ffd> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "It is unclear whether postural sway characteristics could be used as diagnostic biomarkers for autism spectrum disorder (ASD). The purpose of this study was to develop and validate an automated identiﬁcation of postural control patterns in children with ASD using a machine learning approach. 50 children aged 5–12 years old were recruited and assigned into two groups: ASD (n = 25) and typically developing groups (n = 25). Participants were instructed to stand barefoot on two feet and maintain a stationary stance for 20 s during two conditions: (1) eyes open and (2) eyes closed. The center of pressure (COP) data were collected using a force plate. COP variables were computed, including linear displacement, total distance, sway area, and complexity. Six supervised machine learning classiﬁers were trained to classify the ASD postural control based on these COP variables. All machine learning classiﬁers successfully identiﬁed ASD postural control patterns based on the COP features with high accuracy rates (>0.800). The naïve Bayes method was the optimal means to identify ASD postural control with the highest accuracy rate (0.900), speciﬁcity (1.000), precision (1.000), F1 score (0.898) and satisfactory sensitivity (0.826). By increasing the sample size and analyzing more data/features of postural control, a better classiﬁcation performance would be expected. The use of computer-aided machine learning to assess COP data is efﬁcient, accurate, with minimum human intervention and thus, could beneﬁt the diagnosis of ASD. 2020 Elsevier Ltd. All rights reserved." ;
    dcterms:bibliographicCitation "Li Y; Mache MA; Todd TA (2020). Automated identification of postural control for children with autism spectrum disorder using a machine learning approach. *Journal of Biomechanics, 113, 110073*." ;
    dcterms:creator "Li Y",
        "Mache MA",
        "Todd TA" ;
    dcterms:title "Automated identification of postural control for children with autism spectrum disorder using a machine learning approach" ;
    bibo:pmid "local_878c259f" ;
    fabio:hasPublicationYear 2020 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are comparison groups matched on the variables that matter?" ;
                            slr:justification "Age-matched with near-identical means, and body mass and height closely comparable - the relevant covariates for postural measures." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are participants and recruitment adequately described?" ;
                            slr:justification "Demographics, anthropometrics, inclusion and exclusion criteria all reported; recruitment route and diagnostic route are not." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are competing causes of the measured impairment excluded?" ;
                            slr:justification "Neurological disorders other than ASD, chronic medical disorders, visual impairments and balance-affecting physical impairments all excluded." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the sample appropriate and adequate for the stated target?" ;
                            slr:justification "n=50 with an a priori power analysis for the group comparison, but modest for a classification claim; ASD sample restricted to children able to follow instructions." ;
                            slr:rating "Partly" ] ;
                    slr:overall_concern "some concerns" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the reference standard appropriate and independently applied?" ;
                            slr:justification "Unspecified prior clinical diagnosis; controls unscreened for autistic traits." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the task appropriate for the population?" ;
                            slr:justification "20-second duration justified against the difficulty of keeping autistic children still, with supporting validity evidence cited; foot placement left natural." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the behavioral data acquisition described reproducibly?" ;
                            slr:justification "Force plate, sampling rate, filter order and cutoff with selection method, stance instructions, trial duration with justification, trial count and acceptability criteria all specified." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are predictors defined without knowledge of outcome?" ;
                            slr:justification "COP variables are computed automatically from force-plate traces by a fixed pipeline." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "some concerns" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is there external or independent validation?" ;
                            slr:justification "None; larger samples named as the only future direction." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is uncertainty quantified?" ;
                            slr:justification "No confidence intervals, despite specificity and precision of exactly 1.000 on 25 controls." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is algorithm selection separated from performance estimation?" ;
                            slr:justification "Best of six algorithms reported from the same five-fold cross-validation, with no nested structure." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the feature-to-sample ratio reasonable?" ;
                            slr:justification "12 features against 50 participants - among the healthiest ratios in the corpus." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are outliers checked?" ;
                            slr:justification "Chauvenet's criterion applied explicitly because outliers could influence classification accuracy; none detected." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the validation participant-independent?" ;
                            slr:justification "Each child contributes one feature vector, so five-fold folds are participant-level by construction." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "some concerns" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the dataset accessible or its access conditions stated?" ;
                            slr:justification "No data availability statement." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is a negative result reported?" ;
                            slr:justification "Sample entropy did not differentiate the groups, reported plainly despite the introduction citing prior reduced-complexity findings." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is code available?" ;
                            slr:justification "None, though classifier parameters are supplied in an appendix and the software version is given." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are limitations discussed?" ;
                            slr:justification "No limitations section; only a single sentence on sample size and feature count." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are ethics and consent reported?" ;
                            slr:justification "IRB approval of the protocol, telephone eligibility screening with legal guardians, and informed consent from legal guardians on arrival." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are metrics defined transparently?" ;
                            slr:justification "All five metric formulas printed with the positive class defined as ASD, and confusion matrices supplied for every classifier." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "some concerns" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Single modality, but with a designed within-modality manipulation: the same six COP variables are measured under eyes-open and eyes-closed conditions and both sets are supplied jointly to the classifiers, giving 12 features. This effectively fuses two sensory conditions, allowing the models to exploit how each child's sway changes when visual input is removed. No integration with clinical, cognitive or demographic data, though anthropometrics were collected." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-037" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No cognitive, linguistic, adaptive or autism-severity measures are reported. Anthropometrics (height, body mass) are measured and reported for both groups, which is the relevant covariate set for postural biomechanics. Comorbidity is handled by explicit exclusion of neurological disorders other than ASD, chronic medical disorders, visual impairments and physical impairments affecting balance - a well-targeted exclusion list that removes the most plausible competing explanations for balance differences." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-037" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Quiet standing balance, barefoot on two feet with arms relaxed, for 20 seconds, under randomised eyes-open and eyes-closed conditions, with three acceptable trials per condition. The 20-second duration is justified explicitly against the practical difficulty of keeping autistic children still for longer, citing evidence that 15 seconds gives acceptable construct and concurrent validity in children. Foot placement was deliberately left unconstrained 'to enable participants to adopt a natural stance to more closely reflect any strategy they might use to maintain balance in their natural environment' - an ecological-validity choice made at the cost of some standardisation. Trial acceptability criteria are stated explicitly, and environmental distraction was minimised by keeping investigators and guardians quiet." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-037" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No data or code release. Method reporting is otherwise strong: force plate manufacturer and sampling rate, filter order and cutoff with the selection method, all six COP variable definitions, sample entropy parameters, the outlier check and its criterion, trial acceptability criteria, the ANOVA design, the cross-validation scheme, the metric formulas with the positive class defined, the software version, and classifier parameters supplied in an appendix. Confusion matrices for all classifiers are also provided in an appendix. The analysis is re-implementable in principle on comparable force-plate data." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-037" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two groups of 25: children with ASD and age-matched typically developing children, total 50. Both groups are characterised in a demographic table with sample size, sex breakdown, body mass, height and age. No other-diagnosis comparison group, though neurological disorders other than ASD were an explicit exclusion for both groups." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-037" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional; a single laboratory session totalling roughly two minutes of recorded standing per child, with no follow-up. The data are numeric force-plate traces, not identifiable media, so privacy risk is minimal. Institutional Review Board approval of the study protocol is reported, eligibility was screened by telephone with legal guardians, and informed consent was obtained from legal guardians on arrival at the laboratory. No child assent statement is reported." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-037" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2020. The paper situates itself carefully in two literatures. On postural control it notes that reduced postural stability in ASD is 'well-established', with prior force-plate studies reporting greater sway displacement, areas, standard deviations, velocities and root mean square, and two studies reporting decreased COP complexity. On machine learning it observes that classifiers have already distinguished impaired postural stability in multiple sclerosis, Parkinson's disease and vestibular dysfunction, and have been applied in autism to eye gaze, cognitive function, pregnancy risk factors and hand movements - but concludes that 'to our knowledge, there has been no study that utilized machine learning approaches to study postural control features in children with ASD'. It thus documents the transfer of an established clinical-biomechanics method into the autism domain." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-037" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Hardware: a Kistler force plate sampling centre-of-pressure at 60 Hz; standard anthropometric measurement of height and body mass. Software: MATLAB R2020a with the Machine Learning Toolbox for classification and performance evaluation; a fourth-order low-pass Butterworth filter with a 10 Hz cutoff selected by residual analysis; sample entropy computed with sequence length 2 and matching tolerance 0.15 times the COP standard deviation." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-037" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A prior diagnosis of ASD by a physician or a licensed psychologist was an inclusion criterion, but no diagnostic instrument, criteria or confirmation procedure is described, and no autism-trait screening was applied to controls. Two further inclusion requirements - the ability to understand and communicate with examiners and the ability to perform the required tasks - restrict the ASD sample to children who could follow standing instructions, which bounds generalisability toward more able children." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-037" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Handcrafted low-dimensional biomechanical features: 12 scalar summaries of centre-of-pressure behaviour per child, spanning two theoretically distinct constructs - sway magnitude and sway complexity. The 12-features-to-50-participants ratio is among the healthiest in the corpus and materially reduces overfitting risk relative to the high-dimensional representations used elsewhere." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-037" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Motor behavior: kinetic postural control, specifically centre-of-pressure excursion during quiet standing, capturing both the magnitude of sway (displacement, path length, area) and its temporal regularity (sample entropy). This is the only study in the corpus to measure static postural control with a force plate, complementing the gait, reach and imitation studies in the motor strand." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-037" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Goal: develop and validate automated identification of ASD postural control patterns, framed around the open question of whether postural sway can serve as a diagnostic biomarker. Main findings: all six classifiers exceeded 0.800 accuracy; naive Bayes achieved 0.900 accuracy with 1.000 specificity, 1.000 precision, 0.898 F1 and 0.826 sensitivity; k-nearest neighbour was second at 0.860. The underlying group difference is greater sway magnitude in ASD across displacement, distance and area, with no group difference in sample entropy complexity." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-037" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Supervised learning with an unusually broad comparison: discriminant analysis, k-nearest neighbour, naive Bayes, decision trees, support vector machine and random forest, each briefly explained with a citation. The rationale is stated explicitly - because features, sample sizes and data structures differ, 'no one algorithm works best for every dataset', so researchers usually implement several and explore the best. The authors also note that basic supervised algorithms are chosen because they are 'computationally efficient and relevant to small sample sizes'." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-037" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Author keywords: Developmental disorder, Postural stability, Force plate, Artificial intelligence, Standing, Balance. Task vocabulary: 'diagnostic biomarkers', 'automated identification', 'computer-aided machine learning', 'postural control patterns'. The vocabulary is biomechanical rather than clinical-diagnostic, and the biomarker claim is posed as an open question rather than asserted." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-037" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Five-fold cross-validation with participant-level folds by construction, since each child contributes a single 12-feature vector - this avoids the window-level and image-level leakage that affects much of the corpus. Outliers were formally checked with Chauvenet's criterion because they 'could influence the classification accuracy', and none were found. Sample size was justified by a priori power analysis. What is absent: any nested structure separating algorithm selection from performance estimation, so reporting the best of six on the same folds carries selection optimism; no external or independent validation; no permutation testing against chance; no class-imbalance issue (25/25); no confidence intervals despite metrics of exactly 1.000; and no deployment or real-time analysis, though efficiency and minimal human intervention are cited as practical advantages." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-037" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "'children with autism spectrum disorder', 'children with ASD', 'individuals with ASD', 'autistic postural control patterns', 'typically developing children', 'children with typical development', 'healthy controls'. Predominantly person-first with 'typically developing' used consistently for the comparison group, though 'healthy controls' appears once. The paper's framing is biomechanical rather than pathologising." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-037" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Laboratory setting - a biomechanics laboratory with force-plate instrumentation. Newly collected data; no existing dataset used." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-037" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No model-derived feature importance, but interpretability is supplied by a properly conducted univariate analysis that precedes and motivates the classification. The mixed-model ANOVA establishes that children with ASD sway significantly more in displacement, distance and area regardless of visual condition, with no group-by-condition interaction, and that both groups sway more with eyes closed. The negative result is equally informative and is reported plainly: sample entropy did not differentiate the groups, despite the introduction citing two prior studies reporting reduced COP complexity in ASD and interpreting it as 'a repetitive and restricted postural control pattern'. So the classification signal here is magnitude, not complexity." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-037" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Accuracy, sensitivity, specificity, precision and F1, with all five formulas printed explicitly and 'positive' defined as ASD - a level of metric transparency few corpus studies match - plus confusion matrices for every classifier in an appendix. Headline: 0.900 accuracy, 1.000 specificity, 1.000 precision, 0.898 F1, 0.826 sensitivity for naive Bayes. No AUC and no confidence intervals, which matters given that specificity and precision of exactly 1.000 on 25 controls carry wide uncertainty." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-037" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "ASD n=25 (14 female, 11 male), age 6.9 (1.8) years, body mass 32.7 (11.5) kg, height 126 (13) cm. TD n=25 (10 female, 15 male), age 7.2 (2.0) years, body mass 30.3 (12.4) kg, height 128 (12) cm. Recruitment range 5-12 years. Groups are explicitly age-matched with near-identical means and overlapping standard deviations, and anthropometrics are reported and closely comparable - which matters for postural measures since body mass and height affect sway. Sex is not matched, with the ASD group 56% female against 40% in controls, but both proportions are far higher than the corpus norm, making this one of very few studies here where autistic girls are well represented. Sample size is justified by an a priori power analysis (power 0.80) against previously published postural sway data, indicating 10-13 per group would suffice for the group comparison, with the larger n=25 chosen because 'a larger sample size will improve the accuracy and success of machine learning classifiers'." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-037" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Increase the sample size and analyse more postural control data and features, with the expectation of better classification performance. No proposals for external validation, comparison against other developmental conditions, or clinical deployment are made." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-037" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Journal of Biomechanics - a biomechanics and movement science journal, neither autism-specific nor computational, and the only representative of that field in this corpus." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-037" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Reported by the authors only briefly, in the abstract and conclusions: 'By increasing the sample size and analyzing more data/features of postural control, a better classification performance would be expected'. There is no dedicated limitations section. Identifiable in review: n=50 with five-fold cross-validation means roughly 10 children per test fold, so 0.900 accuracy is about 45 of 50 correct and the exact 1.000 specificity and precision reflect zero false positives among 25 controls - values that will not be stable at this scale; the headline is the best of six algorithms evaluated on the same cross-validation with no nested selection or external validation; no diagnostic instrument is named; inclusion criteria requiring comprehension of instructions and task performance restrict the ASD sample to more able children; sex is not matched (56% versus 40% female); and the negative sample entropy result contradicts two prior studies cited in the introduction without the discrepancy being discussed in the extracted text." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-037" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "Single session; 20-second quiet stance per trial, three acceptable trials per condition, two conditions (eyes open, eyes closed) in randomised order" ;
                    slr:study_design "Cross-sectional case-control classification study with a preceding mixed-model ANOVA of group differences" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: 25; comparison: 25" ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "All six classifiers exceeded 0.800 accuracy. Naive Bayes was best: accuracy 0.900, specificity 1.000, precision 1.000, F1 0.898, sensitivity 0.826. K-nearest neighbour was second: accuracy 0.860 with other metrics between 0.833 and 0.950",
                        "Twelve centre-of-pressure features from 40 seconds of quiet standing classified children with ASD from age-matched typically developing children at up to 0.900 accuracy, with all six tested algorithms exceeding 0.800. The underlying group difference is in sway magnitude - children with ASD showed significantly greater displacement, path distance and sway area in both eyes-open and eyes-closed cond" ;
                    slr:outcome "Accuracy, sensitivity, specificity, precision and F1 score, with the formulas given explicitly and 'positive' defined as ASD, plus confusion matrices for all classifiers in an appendix" ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "All six classifiers exceeded 0.800 accuracy. Naive Bayes was best: accuracy 0.900, specificity 1.000, precision 1.000, F1 0.898, sensitivity 0.826. K-nearest neighbour was second: accuracy 0.860 with other metrics between 0.833 and 0.950; Twelve centre-of-pressure features from 40 seconds of quiet standing classified children with ASD from age-matched typically developing children at up to 0.900 accuracy, with all six tested algorithms exceeding 0.800. The underlying group difference is in sway magnitude - children with ASD showed significantly greater displacement, path distance and sway area in both eyes-open and eyes-closed cond" ] ] ;
