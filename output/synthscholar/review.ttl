        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "The recordings were realised with a video camera placed on a tree-legged support. The setting was designed so that the child would feel comfortable. Therefore, the meeting was conducted in the room where they usually play." ] ;
