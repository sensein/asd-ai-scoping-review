        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "To test this idea, for each subject/trial/eye, we removed the temporal information from the associated scanpath by randomly permuting the scanpath string characters. Then, we used the same combination of ScanMatch and t-SNE as above to compute analogous, dimension-reduced scanpath representation scores that could now reﬂect only the frequencies of AOI hits but not the order in which the AOIs were looked at." ] ;
            oa:hasTarget <urn:slr:article:90465004ce07> ;
