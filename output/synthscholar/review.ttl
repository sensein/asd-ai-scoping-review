    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "No recruitment, exclusions, data quality, missingness handling beyond 'cleaning any missing values', or per-fold results are reported, and the abstract's 88-91% accuracy range is unreconciled with the text's 88%." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Diagnosis reported only as 'confirmed to have ASD' with no instrument, criteria or diagnostician, and no traceable source for the labels; control status asserted without any screening." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "No participant characteristics of any kind are reported beyond group sizes; matching on age and sex is asserted without a single figure or test; and the dataset is secondary and unidentified, so nothing can be recovered from a source." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
