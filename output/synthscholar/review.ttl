    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "The features producing the headline result were constructed from the six coherence values identified as significantly different in a group comparison using all 41 participants, so feature construction was informed by every participant's diagnosis. Four classifiers were compared across two feature conditions over 63 candidate features with the maximum reported, and it is not stated whether forward feature selection was nested within the cross-validation loop. No threshold or operating point was prespecified." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Case-control sampling with autistic children from a psychiatric hospital and typically developing children from local communities. Eligibility required at least average non-verbal intelligence and conversational competence, excluding autistic children with intellectual disability. The sample is 85% male, drawn from a single city, and the two groups differ significantly in non-verbal IQ (102 versus 118, p = .015) and by 15 months in mean age (p = .066), neither adjusted for. Two of 23 comparison children were lost to technical problems before analysis without characterisation." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "All 41 analysed participants contributed a single feature vector and leave-one-out cross-validation partitions participants, so evaluation units are independent and no within-participant leakage is possible. Inclusion required videos longer than 45 s and all qualified, so no differential exclusion occurred at that stage. Against this, two comparison children were lost before analysis without description, the interval between diagnosis and recording is unreported, and the recordings are shared with the group's other publications on this cohort without the overlap being flagged." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "Multi-clinician DSM-IV consensus - licensed psychiatrist with at least five years' experience, evaluation by a senior clinician, and escalation to two further senior clinicians on disagreement - which is a defensible clinical standard and better than a single unblinded judgement. But no standardised instrument was administered, no inter-rater reliability is quantified, DSM-IV rather than DSM-5 was applied, no severity measure was obtained, and community-recruited comparison children were not screened with any autism instrument." ] ;
            slr:overall_judgment "high" ;
            slr:tool_used "QUADAS-2" ] .

<urn:slr:article:3316ae46ffa0> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Autism Spectrum Disorder (ASD) poses significant challenges in diagnosis due to its diverse symptomatology and the complexity of early detection. Atypical gait and gesture patterns, prominent behavioural markers of ASD, hold immense potential for facilitating early intervention and optimising treatment outcomes. These patterns can be efficiently and non-intrusively captured using modern computational techniques, making them valuable for ASD recognition. Various types of research have been conducted to detect ASD through deep learning, including facial feature analysis, eye gaze analysis, and movement and gesture analysis. In this study, we optimise a dual-stream architecture that combines image classification and skeleton recognition models to analyse video data for body motion analysis. The first stream processes Skepxels—spatial representations derived from skeleton data—using ConvNeXt-Base, a robust image recognition model that efficiently captures aggregated spatial embeddings. The second stream encodes angular features, embedding relative joint angles into the skeleton sequence and extracting spatiotemporal dynamics using Multi-Scale Graph 3D Convolutional Network(MSG3D), a combination of Graph Convolutional Networks (GCNs) and Temporal Convolutional Networks (TCNs). We replace the ViT model from the original architecture with ConvNeXt-Base to evaluate the efficacy of CNN-based models in capturing gesture-related features for ASD detection. Additionally, we experimented with a Stack Transformer in the second stream instead of MSG3D but found it to result in lower performance accuracy, thus highlighting the importance of GCN-based models for motion analysis. The integration of these two streams ensures comprehensive feature extraction, capturing both global and detailed motion patterns. A pairwise Euclidean distance loss is employed during training to enhance the consistency and robustness of feature representations. The results from our experiments demonstrate that the two-stream approach, combining ConvNeXt-Base and MSG3D, offers a promising method for effective autism detection. This approach not only enhances accuracy but also contributes valuable insights into optimising deep learning models for gesture-based recognition. By integrating image classification and skeleton recognition, we can better capture both global and detailed motion patterns, which are crucial for improving early ASD diagnosis and intervention strategies." ;
    dcterms:bibliographicCitation "Shin J; Miah ASM; Kakizaki M; Hassan N; Tomioka Y (2025). Autism Spectrum Disorder Detection Using Skeleton-Based Body Movement Analysis via Dual-Stream Deep Learning. *Electronics, 14(11), Article 2231*." ;
    dcterms:creator "Hassan N",
        "Kakizaki M",
        "Miah ASM",
        "Shin J",
        "Tomioka Y" ;
    dcterms:title "Autism Spectrum Disorder Detection Using Skeleton-Based Body Movement Analysis via Dual-Stream Deep Learning" ;
    bibo:pmid "local_879ec69b" ;
    fabio:hasPublicationYear 2025 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Confounder control" ;
                            slr:justification "No age distribution by diagnostic group across a 4-to-12 span in which gait matures substantially, and no sex information, in a domain where gait differs by sex. No cognitive, language or comorbidity data." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Handling of missing data and attrition" ;
                            slr:justification "Nine of every ten walking trials per child were discarded, with the retained trial chosen on the basis of the diagnosis and a clinician's recommendation - an outcome-informed data reduction, not a neutral quality filter." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Participant selection and spectrum representativeness" ;
                            slr:justification "Two convenience corpora, 100 and 61 children, with no ascertainment described and no spectrum characterisation. A severe-symptom subset available in one dataset is not analysed." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Comparison group adequatecy" ;
                            slr:justification "The Gait dataset provides a 50:50 autistic and typically developing contrast recorded under matched conditions - a structural advantage over the branch's usual asymmetries. But DREAM's non-spectrum comparison class was discarded, so that experiment has no non-autistic group at all." ;
                            slr:rating "Unclear" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Reference standard quality" ;
                            slr:justification "No diagnostic instrument, criteria or procedure reported for either corpus, and DREAM's label structure is collapsed by discarding one of three classes." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Measurement standardisation" ;
                            slr:justification "Within each corpus both classes were recorded on the same sensor under the same protocol, and the skeleton representation excludes appearance entirely. Across corpora the sensors and joint coverage differ, which the paper documents; neither task protocol is described." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Index test definition and prespecification" ;
                            slr:justification "Architectures, loss, optimiser and training schedule are fully specified, with the epoch extension justified by observed convergence. But six backbones were compared on the same cross-validation results that supply the headline, making it a best-of-six selection." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Outcome measurement blinding" ;
                            slr:justification "Model inference is automated, but the trial-selection step in the Gait dataset was explicitly informed by the child's diagnosis." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Performance estimation and chance level" ;
                            slr:justification "Accuracy only, with no sensitivity, specificity, precision, recall, F1, AUC or confusion matrix for any proposed model. Chance is 50% on the Gait dataset by construction and undeterminable on DREAM, whose class distribution is described as biased and never quantified. Dispersion across runs is reported, which is a genuine strength." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Data splitting and leakage control" ;
                            slr:justification "Necessarily participant-level on the Gait dataset, since each child contributes one sample. Sample-level with no participant partitioning described on DREAM, where 1,833 samples come from 61 children." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Preprocessing and feature selection nesting" ;
                            slr:justification "Representations are learned and no feature selection is performed, but architecture selection across six backbones used the reported cross-validation results." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Sample size adequacy for the modelling" ;
                            slr:justification "Deep dual-stream models on 100 samples in one corpus, with test folds of ten children where a single case moves accuracy by ten percentage points and the six architectures span 2.2 points." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "unclear" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Acknowledgement of limitations" ;
                            slr:justification "Three limitations named in the conclusion, including the paper's own computational cost as an obstacle to the real-time clinical use it proposes. The outcome-informed trial selection, the DREAM splitting, the absent demographics and the missing sensitivity and specificity are all unaddressed." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Completeness of methods reporting" ;
                            slr:justification "Both datasets with public locations and one with a DOI, sensor models and joint counts with their differences explained, sample counts, the class exclusion, nine software packages with versions, hardware, optimiser and schedule with the reason for extension, cross-validation scheme with fold sizes and repetition counts per dataset, and the configuration flag needed in the inherited codebase." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Reporting of results and uncertainty" ;
                            slr:justification "Mean, maximum, minimum and standard deviation across repeated cycles for every architecture on both datasets, plus per-epoch curves - dispersion reporting better than most of this corpus. But accuracy is the only metric, with no confusion matrices or confidence intervals." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Ethics, consent and conflicts" ;
                            slr:justification "No ethics statement, conventional for secondary analysis of public corpora. The paper does engage substantively with privacy, positioning skeleton data as an answer to the anonymity concerns raised for gaze and video data. Funding and competing interests declared." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Data, code and protocol availability" ;
                            slr:justification "Both source datasets public and identified, one with a Dryad DOI and access date; the inherited codebase is cited with a required configuration flag noted; the authors' own code is not released." ;
                            slr:rating "Unclear" ] ;
                    slr:overall_concern "unclear" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Inherited and undescribed for both corpora - no diagnostic instrument, criteria, clinician qualification or assessment date appears anywhere. The Gait Fullbody Dataset carries binary autistic and typically developing labels from its creators; DREAM carries a three-level label - non-spectrum, ASD and AUT - of which the non-spectrum class was discarded, following the prior study whose architecture this work extends. Discarding the non-spectrum group has a consequence the paper does not draw: the DREAM experiment is then a discrimination between two autism-related categories rather than between autism and non-autism, so its 70.19% is not comparable to the Gait dataset's autism-versus-typical task and the two figures cannot be read as measurements of the same thing. The reference-standard issue that most affects validity, however, is procedural rather than definitional. The methods state that in the Gait dataset each child performed ten walking trials and 'the most optimal trial was selected based on the disease and the doctor's recommendation'. Selecting which of a child's trials enters the dataset on the basis of that child's diagnosis is selection on the outcome: it means the 100 modelled samples are not a random sample of each child's walking but the trial a clinician judged most suitable given what the child was known to have. Whatever separation the models achieve is conditioned on that choice, and no splitting scheme downstream can undo it." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-133" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Walking trials in one corpus and robot-assisted therapy sessions in the other, neither described in detail. The gait paradigm is well chosen for the review's purposes: walking requires no verbal ability, imposes no social demand, is producible by very young children, and yields a motor signal that can be measured objectively - which the paper argues explicitly, noting that diagnosis 'often requires speech-based tests' but 'at the early detection stage, many young children may not yet be able to speak'. That argument identifies a real gap in the assessment landscape, since the language-based measures charted elsewhere in this review are inapplicable to precisely the youngest and least verbal children for whom early detection matters most. Two things weaken the execution. Only one of ten walking trials per child is retained, and that trial was chosen with knowledge of the diagnosis, so within-child variability - which is itself a candidate marker in motor studies - is discarded by a non-blind procedure. And in DREAM the recorded movements arise from therapy interaction with only upper-body joints available, so the gait construct that motivates the paper is not measurable in the second dataset at all." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-133" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional secondary analysis with no longitudinal element. No ethics statement appears, which is conventional for analysis of two public corpora collected under their originators' governance. The paper does address a related concern substantively, and its argument deserves recording: it notes that prior eye-tracking work 'raised concerns about ensuring anonymity' and identifies 'the issue of privacy protection associated with gaze data', then positions skeleton representation as the answer. Joint coordinates carry no face, appearance, clothing, room or lighting information, so a skeleton corpus is inherently less identifying than the video or photograph corpora that dominate this branch. That is a real privacy property of the modality, argued as a motivation rather than noted as a side effect, and it aligns with the same reasoning that led the Geneva group charted elsewhere in this review to render pose as skeleton-on-black and to release a de-identified pose subsample when raw video could not be shared. Funding from the University of Aizu Competitive Research Fund is declared, competing interests are declared as none, and both datasets are identified with public locations." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-133" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Absent for both corpora beyond the stated age ranges of 4 to 12 and 3 to 7 years. No age distribution by diagnostic group, no sex, no cognitive or language measure, no ancestry and no comorbidity. Two of these are specifically damaging for a gait study. Walking kinematics mature substantially across 4 to 12 years - stride length, cadence, arm swing, double-support time and postural stability all change - so if the autistic and typically developing groups differ in age composition, a gait classifier and an age classifier would be behaviourally indistinguishable, and nothing reported allows the check. And gait differs by sex from middle childhood, with no sex information available in either corpus. The DREAM corpus additionally spans 3 to 7 years with ages recorded in months, so finer age information exists in the source data and is not used. The paper does not report demographic composition for either dataset or acknowledge these as confounds." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-133" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Three-dimensional joint coordinate sequences, re-expressed two ways - as Skepxel images and as angle-augmented graph sequences. The skeleton representation functions as a designed confound control of the same kind used by the Geneva pose study charted elsewhere in this review: face, expression, clothing, body habitus, room, lighting and background are all absent by construction, so a classifier operating on it cannot exploit the appearance and setting confounds that dominate the photograph branch. It also carries the privacy property the paper argues for, since joint coordinates do not identify a child by appearance. The limitation is coverage: 25 full-body joints in one corpus against 10 upper-body joints in the other, so the two experiments do not measure the same thing, and the paper's own figure contrasting the joint layouts makes this visible without drawing the inference for the 25-point performance gap." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-133" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two representational streams over one sensor, aligned by a pairwise Euclidean distance loss during training and then tested separately. Stream one encodes skeleton sequences as Skepxels for an image backbone; stream two embeds relative joint angles and applies MSG3D, combining graph convolution over the skeletal topology with temporal convolution over time. The design rationale is stated clearly - the loss 'minimises the distance between the Skepxel embedding, which captures spatiotemporal features, and the GCN embedding, which models structural joint relationships', promoting co-learning of complementary representations - and the ablation supports the graph component, with a Stack Transformer substitution lowering accuracy. This is representational rather than sensor fusion, but it is a coherent idea coherently tested. What is missing is a decomposition of how much each stream contributes to the final figure, which would be the natural complement to the architecture ablation that is reported." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-133" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No study setting. The Gait Fullbody Dataset records walking trials captured by Kinect v2, and DREAM was collected during robot-assisted therapy sessions with Kinect v1. The paper documents the sensor difference carefully - Kinect v2 detects 25 joints, Kinect v1 detects 20, and DREAM omits the lower body leaving 10 - which is exactly the kind of acquisition detail that determines cross-corpus comparability and that most secondary-analysis studies in this review omit. It does not, however, examine the settings themselves: what the children were doing during DREAM sessions, how a robot's presence shapes movement, or whether the walking protocol was standardised in distance, speed or footwear. Within each corpus, both classes were recorded under the same conditions, so the acquisition confound that affects the photograph and clinic-versus-school audio studies charted elsewhere in this review does not arise here - a genuine structural advantage of using purpose-built research corpora." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-133" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A dual-stream architecture derived from a prior design, with two deliberate substitutions tested: ConvNeXt-Base replacing the original ViT-B in the image stream to assess whether CNN backbones capture gesture features effectively, and a Stack Transformer trialled against MSG3D in the sequence stream. Six image backbones were compared in total - ViT-B, ConvNeXt-Base, Swin-V2-B, ShuffleNetV2-X2, ResNet-152 and MaxViT-T - spanning transformer, convolutional and hybrid families. The comparison is even-handed and the reference implementation is reported alongside the alternatives rather than only the winner. Its most valuable outcome is a negative one: across six architectures the accuracy spread is 2.2 points on one dataset and 1.3 on the other, against a 25-point gap between the datasets, so architectural choice is nearly irrelevant to performance here. For a literature in which most papers are organised around a new architecture, that is a finding worth propagating." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-133" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Accuracy only, but reported with dispersion - average, maximum, minimum and standard deviation across repeated cross-validation cycles for every architecture on both datasets, plus per-epoch accuracy and loss curves. The dispersion reporting is a real strength and is what makes the architecture comparison interpretable: standard deviations of 0.71 to 1.82 on the Gait dataset against a 2.2-point spread between backbones show immediately that the architectural differences are barely larger than run-to-run noise, and the paper is able to note that ShuffleNet was more stable than MaxViT at the same mean accuracy. What is absent is everything a screening claim requires. No sensitivity, specificity, precision, recall, F1, AUC or confusion matrix is reported for any proposed model, so the balance between missed cases and false alarms is unknown, and no positive predictive value at any realistic prevalence is computed. Accuracy on a 50:50 corpus tells a clinician very little, and on DREAM - where the class distribution is described as biased but never quantified - it tells them nothing at all." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-133" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The aim is to optimise a dual-stream skeleton architecture for autism detection, replacing the vision transformer of a prior design with a convolutional backbone to test whether CNN-based models capture gesture features effectively, and comparing MSG3D against a Stack Transformer in the temporal stream. The headline results are 95.4% on the Gait Fullbody Dataset and 70.19% on DREAM. The more informative findings are in the ablation tables. Across six image backbones the Gait results span 93.2% to 95.4% and the DREAM results 68.92% to 70.19% - so architecture choice moves accuracy by around two points on one dataset and one point on the other, while the gap between the two datasets is 25 points. That is a clean demonstration that in this branch the data determine performance and the model barely matters, which is a useful corrective to a literature organised around architectural novelty. The paper also reports that substituting a Stack Transformer for MSG3D lowered accuracy, and it reports its own reference implementation (ViT-B at 94.8%) alongside the alternatives rather than only the winner. What the study does not establish is what the 25-point gap means: the two corpora differ in sensor generation, joint coverage (25 full-body against 10 upper-body), task (walking against robot-assisted therapy), label structure (autism versus typical against two autism-related classes) and splitting unit (child against sample), and no analysis separates these." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-133" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The conclusion names three limitations: generalisability requires further optimisation, 'particularly for datasets with biased label distributions'; 'the computational complexity of dual-stream models also poses challenges for real-time clinical applications'; and future work should pursue lightweight architectures, improved augmentation and pre-training. Naming one's own computational cost as an obstacle to the clinical use one proposes is candid, and identifying label imbalance as the source of the DREAM shortfall is a reasonable diagnosis even if not the only one. There is no separate limitations section, and several substantial issues go unaddressed. The Gait dataset's single retained trial per child was selected 'based on the disease and the doctor's recommendation' - the methods quote it and nothing follows. No participant-level partitioning is described for DREAM, where 1,833 samples come from 61 children. No demographic information exists for either corpus, in a domain where gait varies strongly with age and sex. No sensitivity, specificity, AUC or confusion matrix is reported for any proposed model, so a screening claim rests on accuracy alone. The 95.4% is a best-of-six architecture selection on test folds of ten children, where one child is worth ten percentage points and the six backbones span 2.2 points. And the paper reports, without comment, that the Gait dataset's own creators moved from approximately 60% accuracy without augmentation to 92% with seven augmentation techniques - a 32-point gain from augmentation alone, which is as clear a statement of augmentation-driven inflation as this review has found, quoted as background rather than treated as a warning." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-133" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Lightweight architectures to make dual-stream inference tractable in real time; improved augmentation and pre-training; and multimodal extension combining audio and visual data with skeleton. Not proposed, and needed: participant-level partitioning for DREAM; sensitivity and specificity alongside accuracy; demographic reporting and age-stratified analysis; use of all ten walking trials per child rather than one clinician-selected trial, which would both remove the outcome-informed selection and make within-child movement variability available as a feature; and joint-level attribution, which skeleton data make straightforward and which would connect model behaviour to describable gait characteristics." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-133" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Keywords: autism diagnosis; Graph Convolutional Networks (GCNs); Convolutional Neural Network (CNN); Temporal Convolutional Networks (TCNs); effective feature extraction; MSG3D; skeleton points. Almost entirely architectural - six of seven terms name a method or component, with 'autism diagnosis' the only clinical term and no reference to gait, movement, children or screening. Terms carried through the body: Skepxels, dual-stream, pairwise Euclidean distance loss, Kinect, joint angles, gait, gesture, early detection." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-133" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None attempted, and the omission is more notable here than in most of this review because the modality invites it. Skeleton data are inherently interpretable: joints have names, angles have physical meaning, and time is explicit, so a joint-level or phase-level attribution would map directly onto describable gait characteristics - stride variability, arm swing amplitude and asymmetry, trunk sway, turning smoothness - which are the terms in which the clinical motor literature the paper cites is written. The Geneva pose study charted elsewhere in this review shows what such an analysis yields when its model confidences are regressed on clinical item scores. Here nothing connects the 95.4% to any nameable property of how the children walked, so the study establishes that a classifier can separate the groups and contributes nothing to understanding what it separates them on. Given that no demographic data exist either, the possibility that the models respond to age- or sex-related gait maturation rather than to autism cannot be examined from any direction." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-133" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Predominantly medical, with 'patients with ASD' used repeatedly and autism described as a set of 'complex developmental disabilities' with symptoms such as 'a lack of eye contact and an obsession with certain behaviours'. Two passages show more thought than the register suggests. The introduction gives an accurate and unusually careful account of rising prevalence, noting that the doubling of diagnoses between 2015 and 2024 occurred despite the stricter DSM-5 criteria expected to reduce it, and attributing the net increase to awareness and earlier diagnosis - concluding that 'many patients with ASD have not yet surfaced'. That is the correct reading of the epidemiological trend and stands against the alarm framing used elsewhere in this corpus. And the account of the access barrier is concrete rather than rhetorical: 'the high barrier to visiting a hospital, along with the fact that many children are not yet able to speak. Deciding to visit a hospital often requires recognising signs within the household', with the proposed role for the technology being to give families 'a clearer motivation to visit a hospital' rather than to substitute for assessment. No neurodiversity framing appears and no autistic person is reported as involved." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-133" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Whole-body movement kinematics, and the construct argument is one of the better ones in this review. Gait and gesture are presented as 'prominent behavioural markers' that can be 'efficiently and non-intrusively captured', and the case for preferring them to language-based assessment is made explicitly: diagnosis 'often requires speech-based tests', yet at the early detection stage 'many young children may not yet be able to speak'. That identifies a genuine coverage gap - the transcript-based and conversational measures charted elsewhere in this review are inapplicable to non-speaking and pre-verbal children, who are precisely the population early detection targets. The operationalisation is only partly matched to the argument. In the Gait dataset the construct is walking, measured across 25 full-body joints, which is the right instrument for the claim. In DREAM only 10 upper-body joints are available and the movements arise from therapy interaction, so gait is not measurable and the second experiment addresses a different construct under the same label. And no interpretability analysis connects the models to any nameable movement characteristic, so what aspect of gait the 95.4% reflects - stride variability, arm swing, postural sway, turning - is unknown, despite skeleton data making such an analysis unusually accessible." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-133" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two arrangements with materially different properties, reported clearly enough that both can be assessed. On the Gait Fullbody Dataset the split unit is necessarily the child, because each of the 100 children contributes exactly one sample, so 10-fold cross-validation partitions 90 children against 10; each configuration was run through five complete cycles giving 50 training runs, with mean, maximum, minimum and standard deviation reported. That is sound practice and the dispersion reporting is better than most of this corpus. On DREAM, 1,833 samples from 61 children were split 1,650 against 183 per fold with no participant-level partitioning described - roughly 30 samples per child distributed across folds - so within-participant leakage is unaddressed. The instructive result is the direction of the difference: the leak-prone dataset produced the lower figure, 70.19% against 95.4%, which means the gap between them cannot be explained by leakage and must lie in sensor coverage, task, label structure or class balance. That inversion is worth carrying into the synthesis, because it is a counterexample to the assumption that leakage always explains the highest numbers in a branch. Three issues nonetheless bound the Gait figure despite its clean split unit. The single sample per child was chosen from ten trials 'based on the disease and the doctor's recommendation', so the modelled data were selected with knowledge of the outcome - a threat that operates entirely upstream of cross-validation and that no splitting scheme addresses. The 95.4% is the best of six architectures whose spread is 2.2 points against run-to-run standard deviations reaching 1.82, on test folds of ten children where a single child moves accuracy by ten percentage points, so the difference between the reported winner and the reference implementation's 94.8% is not resolvable. And the DREAM experiment discards the non-spectrum class, making it a two-way discrimination among autism-related labels rather than an autism-versus-non-autism task, with the resulting class balance never quantified so that no chance baseline exists for its 70.19%. Finally, the paper transmits without comment the single clearest piece of evidence in this review for augmentation-driven inflation: the Gait dataset's own creators reported approximately 60% accuracy without augmentation and 92% after applying seven augmentation techniques including noise addition, scaling and flipping. A 32-point gain from augmenting a 100-sample dataset is a statement about the augmentation, not about gait, and it is quoted here as motivating background." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-133" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Published May 2025 by the School of Computer Science and Engineering at the University of Aizu, Japan, funded by the university's Competitive Research Fund. The framing is screening-oriented and modest in its target: because 'deciding to visit a hospital often requires recognising signs within the household', a video-based assessment could give families 'a clearer motivation to visit a hospital' - an aim scoped as prompting help-seeking rather than replacing assessment, which is among the better-calibrated translational positions in this review. For the synthesis the study contributes four things. Its modality argument fills a real gap: diagnosis 'often requires speech-based tests' yet 'many young children may not yet be able to speak', so a movement-based measure reaches the youngest and least verbal children whom the language-based studies charted elsewhere here cannot assess. Its skeleton representation is a designed confound control, discarding face, appearance, clothing, room and lighting entirely, and the paper argues the accompanying privacy advantage explicitly against the anonymity concerns raised for eye-tracking and video data - the same reasoning that led the Geneva group to render pose as skeleton-on-black. Its architecture comparison produces a valuable negative result: across six image backbones the accuracy spread is 2.2 points on one dataset and 1.3 on the other, against a 25-point gap between the two datasets, so in this branch the data determine performance and the architecture barely matters - a corrective to a literature organised around architectural novelty. And the direction of that 25-point gap is instructive, since the corpus with unaddressed within-participant leakage produced the lower figure, which is a counterexample to the assumption that leakage always explains the highest numbers. Three cautions travel with it. The Gait dataset's single modelled trial per child was chosen from ten 'based on the disease and the doctor's recommendation' - selection on the outcome, quoted in the methods and never examined. No sensitivity, specificity or confusion matrix is reported for any model, and no demographic data exist for either corpus in a domain where gait varies strongly with age and sex. And the paper transmits, as motivating background, the clearest evidence of augmentation-driven inflation in this review: the Gait dataset's own creators went from approximately 60% accuracy without augmentation to 92% with seven augmentation techniques applied to 100 samples." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-133" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Microsoft Kinect v2 for the Gait Fullbody Dataset, giving 25 three-dimensional joint coordinates, and Kinect v1 for DREAM, giving 20 joints of which 10 upper-body positions are recorded. The paper explains the difference and its consequence for comparability, with a figure contrasting the two joint layouts. Kinect-class depth sensing is consumer hardware, which matters for the deployment argument: skeleton capture requires no markers, no wearables, no calibration by the family and no clinical instrumentation, and produces data that cannot identify the child by appearance. Analysis used Python 3.10 with nine named packages at stated versions on an RTX 3090 with 48 GB RAM, trained with SGD at learning rate 0.001 and batch size 12 - a fuller software and hardware specification than almost any other study in this review provides." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-133" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Among the more reproducible computational records in the corpus. Reported: both datasets with public access locations, one with a Dryad DOI and access date; sensor models, joint counts and the difference between the two Kinect generations with a figure; sample counts for both corpora; the exclusion of the non-spectrum class; the complete software stack with version numbers for nine packages; the hardware; optimiser, learning rate and batch size; the epoch schedule with the reason for its extension; the cross-validation scheme with fold sizes and repetition counts stated separately for each dataset, including why DREAM was run three times rather than five; mean, maximum, minimum and standard deviation for every architecture on both datasets; and the specific configuration flag needed to enable Skepxels in the inherited codebase. Not reported: whether DREAM splitting respected participants, any demographic composition, per-class counts for DREAM, sensitivity and specificity, and the authors' own code." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-133" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two public corpora used in parallel. The Gait Fullbody Dataset, created by Al-Jubouri and colleagues, contains 100 children aged 4 to 12 - 50 autistic and 50 typically developing - recorded with a Kinect v2 capturing 25 joint coordinates, with each child performing ten walking trials of which one was retained, giving 100 samples. A separate subset of nine children with severe symptoms is available and is not analysed here. The DREAM dataset contains 61 children aged 3 to 7, recorded with Kinect v1 during robot-assisted therapy, yielding 3,121 samples of which 1,833 were used after the non-spectrum class was excluded; only 10 upper-body joints are recorded, since Kinect v1 detects 20 joints and DREAM omits the lower body. No age distribution, sex, cognitive level, language ability or clinical characterisation is available for either corpus. Two structural facts shape everything downstream. In the Gait dataset each child contributes exactly one sample, so cross-validation necessarily partitions children - a property that arises from the data rather than from a design decision, but that gives this study the participant-level split unit most of the video branch lacks. And that single retained sample was chosen from ten trials 'based on the disease and the doctor's recommendation', so the modelled data were selected with knowledge of the outcome." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-133" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None used. The Gait Fullbody Dataset includes a subset of nine children with severe symptoms, and the paper's methodology section states that the architecture is proposed 'for ASD detection and severity assessment' - but no severity analysis is performed, no result for the severe subset is reported, and severity appears nowhere in the results. DREAM's three-level labelling likewise encodes a gradient that is collapsed by discarding one class. No cognitive, adaptive or language measure exists for either corpus." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-133" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Electronics 14(11):2231, MDPI, open access under CC BY; received 26 April 2025, revised 21 May, accepted 26 May, published 30 May 2025 - a 34-day review cycle. An electronics and computing venue, and the profile matches: the software stack is versioned to nine packages, the hardware is specified, the cross-validation scheme is stated separately for each dataset with fold sizes and repetition counts, and every architecture is reported with mean, max, min and standard deviation. What a clinical venue would have required is absent: no sensitivity or specificity, no demographic composition, no examination of the outcome-informed trial selection quoted in the methods, and no discussion of what the 25-point gap between the two datasets implies about the construct being measured." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-133" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:study_design "Retrospective algorithm-development and architecture-comparison study on two public skeleton datasets, with repeated cross-validation and an ablation across six image backbones and…" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: ; comparison: 50 typically developing children in Gait Fullbody. In DREAM the non-spectrum class was excluded from the analysis, following the prior study the architecture is derived from." ] ] ;
    slr:content_sha256 "b37bf8e43950938e2b30cc62336bf0b3a6359e801b80e57d1bb4193a836a1c9e" ;
