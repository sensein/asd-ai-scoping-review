    slr:journal "npj Digital Medicine" ;
    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "The model and its abstention thresholds were locked before the trial on prior data; all three inputs were blinded from one another and from the output; endpoints were pre-specified with FDA-agreed floors under prospective registration." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "Complete flow diagram from 711 enrolled to 425 completers with reasons, COVID-19 impact quantified by sites closed and visits lost, and an estimated pandemic-free drop-out rate given." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "DSM-5 diagnosis by a specialist with over five years of experience using structured observation, interview, medical review and standardised instruments, independently confirmed by a blinded second specialist with a third adjudicating disagreements; reference-standard reliability and specialist certainty are themselves reported." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "Consecutive prospective enrolment from primary care referral across 14 sites in six states, with a clinically realistic composition (28.7% autism, 61.9% other developmental condition, 9.4% neurotypical), full flow accounting with COVID-19 attrition quantified, and completers shown to be demographically similar to non-completers." ] ;
            slr:overall_judgment "low" ;
            slr:tool_used "QUADAS-2" ] .

<urn:slr:article:665e8c7a855d> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Atypical facial expression is one of the early symptoms of autism spectrum disorder (ASD) characterized by reduced regularity and lack of coordination of facial movements. Automatic quantiﬁcation of these behaviors can offer novel biomarkers for screening, diagnosis, and treatment monitoring of ASD. In this work, 40 toddlers with ASD and 396 typically developing toddlers were shown developmentally-appropriate and engaging movies presented on a smart tablet during a well-child pediatric visit. The movies consisted of social and non-social dynamic scenes designed to evoke certain behavioral and affective responses. The front-facing camera of the tablet was used to capture the toddlers’ face. Facial landmarks’ dynamics were then automatically computed using computer vision algorithms. Subsequently, the complexity of the landmarks’ dynamics was estimated for the eyebrows and mouth regions using multiscale entropy. Compared to typically developing toddlers, toddlers with ASD showed higher complexity (i.e., less predictability) in these landmarks’ dynamics. This complexity in facial dynamics contained novel information not captured by traditional facial affect analyses. These results suggest that computer vision analysis of facial landmark movements is a promising approach for detecting and quantifying early behavioral symptoms associated with ASD." ;
    dcterms:bibliographicCitation "Babu PRK; Di Martino JM; Chang Z; Perochon S; Carpenter KLH; Compton S; Espinosa S; Dawson G; Sapiro G (2023). Exploring Complexity of Facial Dynamics in Autism Spectrum Disorder. *IEEE Tr*." ;
    dcterms:creator "Babu PRK",
        "Carpenter KLH",
        "Chang Z",
        "Compton S",
        "Dawson G",
        "Di Martino JM",
        "Espinosa S",
        "Perochon S",
        "Sapiro G" ;
    dcterms:title "Exploring Complexity of Facial Dynamics in Autism Spectrum Disorder" ;
    bibo:pmid "local_fbaf69bf" ;
    fabio:hasPublicationYear 2023 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Confounder control" ;
                            slr:justification "Two candidate confounds are handled properly: percentage of missing data and landmark variation are both shown to correlate weakly with the outcome, tested for group difference, and entered as ANCOVA covariates individually and jointly, with the group difference preserved. But three demographic differences - age (3.6 months), sex (29 points) and race/ethnicity (30 points White, 25 points Hispanic/Latino) - are reported and none is adjusted, in a paper that demonstrably knows how to run ANCOVA." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Comparison group adequacy" ;
                            slr:justification "Typically developing toddlers from the same clinics, all screened with M-CHAT-R/F - screened rather than assumed, which is better than almost anything else in this corpus. But screen-negative children did not receive ADOS-T, and the developmental-delay comparison that would test differential specificity sits in a supplementary appendix rather than in the main analysis." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Handling of missing data and attrition" ;
                            slr:justification "The most careful treatment in this corpus. Missing points are excluded at the embedding-vector level inside the entropy computation, with a worked example showing why concatenation would bias the estimate; a 40% validity threshold is applied per movie with a cited justification; missing-data percentage is shown not to differ between groups and is used as a covariate. The only gap is that per-movie analysed counts appear graphically rather than in a table." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Participant selection and spectrum representativeness" ;
                            slr:justification "Consecutive well-child attenders at four primary care clinics, with autism ascertained prospectively at 9.2% prevalence - much closer to a deployment population than the case-control norm here. Limits: caregiver education is very high (82.8% college degree), ADOS-T scores are tightly clustered (7.64 +/- 1.69) suggesting a narrow severity band, no cognitive measure exists, and the 40% valid-data threshold silently removes children who could not sustain attention." ;
                            slr:rating "Unclear" ] ;
                    slr:overall_concern "unclear" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Index test definition and prespecification" ;
                            slr:justification "Regions chosen a priori with cited rationales; entropy parameters taken from prior literature with a sensitivity appendix; filter cut-off justified physiologically; integration window and validity threshold specified in advance; no feature selection. The only in-sample choice is restricting the secondary classification to social movies." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Reference standard quality" ;
                            slr:justification "Universal M-CHAT-R/F within routine care, ADOS-Toddler by a child psychologist for screen-positives and concern-flagged children, ADOS-T totals reported, and the single discordant case disclosed explicitly. Comparison group screened rather than assumed." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Outcome measurement blinding" ;
                            slr:justification "The entire measurement chain from face detection through entropy is automated and label-free. The affect estimator used as comparator was previously validated against human frame-by-frame coding on 136,450 frames with an intraclass correlation of 0.9." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Measurement standardisation" ;
                            slr:justification "Identical iPad, camera, frame rate, movie set and 60 cm placement for every child, with a standardised room arrangement (caregiver holds child, others stand behind). Head motion is removed by affine normalisation to a canonical face rather than left as a confound, and camera-relative pose angles are estimated explicitly." ;
                            slr:rating "Low" ] ;
                    slr:overall_concern "low" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Sample size adequacy for the modelling" ;
                            slr:justification "436 participants overall is large for this corpus, but only 40 are autistic, and the analysed number per movie is smaller still after the 40% validity threshold. The authors state directly that the sample 'did not have sufficient power to determine the impact of demographic characteristics on the results', which is the correct acknowledgement given three unadjusted demographic imbalances." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Performance estimation and chance level" ;
                            slr:justification "Effect sizes reported for every statistical comparison and interpreted as a gradient, ANCOVA confound adjustment, DeLong AUC comparisons, and an internal non-social control condition - stronger than anything else here. But the classification arm lacks confidence intervals, quotes no numeric AUC, gives no majority-class baseline (about 91% at 9.2% prevalence), and reports precision and recall arithmetically incompatible with the stated class ratio, implying an undisclosed balancing step." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Data splitting and leakage control" ;
                            slr:justification "Leave-one-out cross-validation over participants, with one feature vector per child per movie, so within-participant leakage is impossible. The primary claims rest on group comparisons rather than on a fitted predictive model, where cross-validation is not the operative safeguard." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Preprocessing and feature selection nesting" ;
                            slr:justification "No feature selection occurs - two prespecified features. Preprocessing parameters are fixed a priori from literature and shown insensitive in an appendix, so none is fitted to the outcome." ;
                            slr:rating "Low" ] ;
                    slr:overall_concern "unclear" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Data, code and protocol availability" ;
                            slr:justification "No code, no data, no stimulus set, no preregistration. The pipeline rests on the group's own previously published components, which aids conceptual reconstruction but not verification." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Completeness of methods reporting" ;
                            slr:justification "The most complete in this review: recruitment pathway, all exclusion criteria, room and device arrangement, all six movies with durations and content, the full preprocessing chain with justified parameters, the entropy formulation with its missing-data rule and a worked numerical example, the across-subject normalisation, and every statistical test named to the Python function. Five supplementary appendices carry sensitivity and secondary analyses." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Acknowledgement of limitations" ;
                            slr:justification "Three limitations stated, all real, including the important one that adult-trained detectors were applied to toddlers and that the sample lacked power to assess demographic effects. Not acknowledged: the unadjusted age, sex and race differences specifically; the in-sample selection of social movies for the classification analysis; the undisclosed class handling; and the fact that ADOS-T scores were obtained but never related to the biomarker." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Ethics, consent and conflicts" ;
                            slr:justification "Duke University Health System IRB approval under two named protocol numbers; written informed consent from caregivers or legal guardians; inability to consent in English or Spanish disclosed as an exclusion criterion. Funding from eight sources itemised with an explicit no-role statement. The competing-interests disclosure is the most detailed in this corpus, covering technology licensed to Apple, patents, company directorships, advisory boards and consulting - and is accompanied by a structural mitigation, with data analysis independently and continuously reviewed by a named conflict-free co-author." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Reporting of results and uncertainty" ;
                            slr:justification "Effect sizes accompany every significance test and are interpreted, confound adjustments are reported, and three convergent analyses support the redundancy conclusion. But the classification arm has no confidence intervals, no numeric AUC, no chance baseline, and an unexplained class-handling step." ;
                            slr:rating "Unclear" ] ;
                    slr:overall_concern "low" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Published 2021/2023 by the Duke University Electrical and Computer Engineering department with the Duke Center for Autism and Brain Development and Duke Children's Primary Care - an engineering-psychiatry-primary care collaboration, funded by an NIH Autism Center of Excellence award, two further NIMH R01s, the Marcus and Simons Foundations, NSF, ONR and NGA, plus Apple, Microsoft, Amazon Web Services and Google. The framing is scalability of assessment: standardised observational assessment requires highly trained clinicians, manual facial coding from video is complex and time-intensive, and neither deploys at scale, so computer vision is proposed to make quantification universal. The positioning within the group's own programme is explicit and unusually candid - the paper states that it replicates the affect-related analysis of its own prior work on a larger dataset with redesigned stimuli, and then argues that the new complexity measure is 'an independent and more powerful measure' than the group's earlier one. Self-supersession of this kind is rare in this literature. The paper also carries an internal methodological critique of its own field, noting in a footnote that multiscale entropy is widely used in health research without addressing the across-subject comparability problem, with the result that 'often authors report lower MSE for data that is clearly more complex and vice-versa'. Commercially, this is one of the most conflicted studies in the corpus - several authors have licensed the underlying app technology to Apple and benefited financially - and it is also the only one to describe a structural mitigation, with data analysis independently reviewed throughout by a named conflict-free co-author." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-103" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Four directions, each following from a specific gap. Study complexity and coordination of facial dynamics during live interpersonal interaction rather than passive viewing, motivated by evidence that autistic people have difficulty with affect coordination in social exchange - the natural extension of a measure built on temporal predictability. Apply the same complexity analysis to head motion as an index of postural control, exploiting data the pipeline already produces. Pursue the preliminary supplementary finding that integrated entropy may separate autism from developmental or language delay, which is the differential-diagnosis question most of this corpus avoids. And combine the facial-complexity biomarker with gaze indices, response to name, motor signatures and other measures before any automated decision tool is deployed - stated as a precondition rather than an aspiration. Absent from the list, and worth adding: test-retest reliability, prospective external validation, and the relationship between entropy and ADOS-T severity." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-103" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Four hundred and thirty-six toddlers aged 17-36 months, comprising 40 with autism and 396 typically developing, recruited at four paediatric primary care clinics during routine well-child visits. The recruitment route is the defining feature and separates this study from almost every other in the corpus: children were not enrolled as known cases and known controls, but as consecutive clinic attenders who received the M-CHAT-R/F as part of standard care and were referred for ADOS-Toddler evaluation only if they screened positive or if a caregiver or clinician raised a developmental concern. The resulting 9.2% autism prevalence is far closer to a real screening population than the near-balanced designs elsewhere here. Exclusion criteria are stated in full and are practical rather than diagnostic: known hearing or vision impairment, child too upset, caregiver not interested or without time or needing to care for siblings or unable to consent in English or Spanish, child did not complete the procedures, and missing clinical information. The analysed sample varies by movie because only participants with at least 40% valid landmark data for a given movie were included, and those per-movie counts are shown graphically rather than tabulated - the one place where the participant accounting is less transparent than the rest of the paper." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-103" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Sound at the level that matters most and loose at the margins. The classifier uses leave-one-out cross-validation over participants, so the split unit is the child and no within-participant leakage is possible - though this is easier to achieve here than elsewhere because each participant contributes a single feature vector per movie rather than many segments. More importantly, the paper's primary claims are not predictive at all: they are group comparisons with effect sizes, supported by ANCOVA adjustment for two prespecified confounds and by an internal control condition (non-social movies), which is a design where cross-validation is not the relevant safeguard and where the reported statistics carry their own uncertainty. Three looser points. The classification analysis was restricted to the four social movies because the group comparisons on the same data had shown larger effect sizes there, so that restriction is in-sample; the effect is modest, since the choice was made on a prespecified social/non-social distinction rather than by searching over movies individually, but it should be stated. No class handling is described for the decision tree, and reported precision near 70% with recall near 89% cannot be produced from 40 autistic against 396 typically developing participants - so an undisclosed balancing or subsampling step exists, and without knowing it the accuracy figures cannot be placed against the correct baseline. And no majority-class baseline is given, which at 9.2% prevalence would be about 91%, so the reported 76-79% accuracies would be below trivial on the unbalanced sample and are only meaningful under whatever balancing was applied. None of this affects the study's principal finding, which rests on non-parametric group comparisons with large effect sizes, confound adjustment and an internal control - a design that is more robust than a cross-validated accuracy figure and that this corpus contains too few of." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-103" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Three questions, stated as hypotheses in advance. Whether the complexity of facial landmark dynamics differentiates autistic from typically developing toddlers; whether that complexity is higher specifically in the eyebrow region, on the basis of prior work on eyebrow raising in this cohort, and the mouth region, on the basis of atypical vocalisation literature; and whether the complexity measure adds information beyond the group's own previously published affect-based analysis or merely duplicates it. Findings: autistic toddlers showed significantly higher multiscale entropy in both regions, with a clear social/non-social gradient - during social movies p < .0001 with large to very large effect sizes (r = .51-.82), during non-social movies still significant but only medium (r = .32-.40). Integrated entropy over the first 20 scales gave p < .00001 with large or very large effects for all social movies. Eyebrows and mouth did not differ from each other (p > .05, r < 0.1), so the hypothesis of regional specificity was not supported in the sense of one region dominating. The autistic group also showed a significantly wider range of integrated entropy across the six movies (eyebrows p = .001, r = .33; mouth p = .0002, r = .39), meaning their facial responsiveness varied more between contents. On the third question, correlations between integrated entropy and positive-affect energy were moderate for two movies and negligible for four, and adding affect to the classifier did not improve on entropy alone - while affect alone performed worse - so the measures are largely independent and the complexity measure is the more informative of the two. Classification with a decision tree on social movies gave 76.6-78.3% accuracy with entropy alone; logistic regression gave odds ratios up to 1.8 for entropy against 0.8 for affect." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-103" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Index terms: Autism spectrum disorder, affective state, facial dynamics, complexity, sample entropy, multiscale entropy. Four of the six name the measurement rather than the application, and neither 'machine learning', 'deep learning', 'classification' nor 'diagnosis' appears - which accurately reflects a paper whose contribution is a biomarker and its statistical characterisation rather than a classifier. 'Complexity' and 'sample entropy' locate the work in the physiological time-series tradition rather than the affective-computing one, despite the venue. Terms carried through the body: integrated entropy, landmarks' dynamics, coarse-graining, canonical face model, pose-invariant affect, social versus non-social movies, biomarker, well-child visit." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-103" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "IEEE Transactions on Affective Computing 14(2):919-928, April-June 2023; manuscript received 30 April 2021, revised 4 September 2021, accepted 16 September 2021, published online 20 September 2021 - so the work predates its issue date by nearly two years. The venue is an affective-computing journal, and the paper is in part an argument against that field's dominant framing: rather than recognising emotions, it discards expression identity entirely and measures only the predictability of movement, then demonstrates that this carries information the affect pipeline misses. Five supplementary appendices are hosted with the article, containing the entropy-parameter sensitivity analysis, the across-subject normalisation discussion, the developmental-delay comparison, the head-motion analysis and the confound correlation values. The paper is unusually well supplied with methodological detail for its length, and the appendices carry material that would otherwise have been omitted." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-103" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The strongest methods reporting encountered in this review. Reproducible from the text: the full recruitment and screening pathway, all five exclusion criteria, the seating and device arrangement with the 60 cm distance, all six movies with durations and content, the 30 fps capture, the complete preprocessing chain including the affine canonical-face normalisation, the 15 Hz low-pass cut-off with its physiological justification (260 ms to produce an expression, 150-250 ms for a valid one), the removal of non-attending intervals, the entropy parameters m = 2 and r = 0.15 sigma with their literature sources and a supplementary sensitivity analysis, the exact rule for handling missing data inside the entropy computation with a worked numerical example, the 40% validity threshold and its consequence for per-movie sample size, the 20-scale integration window, the affect-energy definition with its 10-frame moving average, and every statistical test named down to the Python function. Two methodological contributions are presented as such rather than buried: the modification of multiscale entropy to handle partially missing time series without concatenation artefacts, and its normalisation to permit across-subject comparison - the latter accompanied by the pointed footnote that despite MSE's popularity in health research 'this problem has never been addressed before, and often authors report lower MSE for data that is clearly more complex and vice-versa'. Not available: code, data, the movies, and the decision-tree configuration. Five supplementary appendices hold further analyses, including the developmental-delay comparison and the head-motion work." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-103" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two metric sets for two purposes, both appropriate. For the primary group comparisons: exact p-values with effect size r reported for every test at every scale and every movie, ANCOVA-adjusted significance after controlling for missing-data percentage and landmark variation individually and jointly, Spearman correlations for the redundancy analysis, and within-group Wilcoxon tests for the eyebrow-versus-mouth comparison. Reporting effect sizes systematically alongside p-values, and interpreting them (medium for non-social, large to very large for social), is better statistical practice than anything else in this corpus and is what allows the social/non-social gradient to be read as a graded finding rather than a binary significant/not-significant one. For the secondary classification: accuracy, precision and recall for three feature sets across four movies under leave-one-out cross-validation, ROC curves with AUCs compared by DeLong's method, and logistic-regression odds ratios. Gaps: no confidence intervals on any classification metric; AUC values are shown graphically but not quoted numerically in the retrieved text; no majority-class baseline, which at 9.2% prevalence would be about 91% and therefore above the reported accuracies; and no positive or negative predictive value at the study's own prevalence, which for a primary-care screening tool is the number that would matter most. The precision-recall combination reported (about 70% and about 89%) is also arithmetically incompatible with a 40:396 class ratio, implying an undisclosed balancing step." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-103" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Partial, and better than most here on severity while silent on cognition. ADOS-Toddler total scores were obtained for the diagnosed children and are reported as a group mean of 7.64 +/- 1.69, giving a genuine quantitative severity index - the study is one of relatively few in this corpus where such a score exists at all. But it is used only descriptively. No analysis relates integrated entropy to ADOS-T score, so the question that would most strengthen the biomarker claim - whether facial-dynamics complexity tracks symptom severity within the autistic group, rather than merely separating groups - is not asked. The tight standard deviation (1.69) also indicates a fairly homogeneous severity range, which limits what such an analysis could have shown and constrains generalisation to more or less affected children. No cognitive, developmental or language measure was administered to either group, which matters for a paradigm requiring 17-36 month olds to attend to a screen for several minutes: developmental level governs sustained attention, and the paper's own 40% valid-data threshold removes children who looked away too much, so cognitive and attentional capacity silently shapes who is analysed. The authors partly address this by verifying that missing-data percentage does not differ significantly between groups and by entering it as an ANCOVA covariate, which is a good empirical substitute for a developmental measure but not a replacement for one." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-103" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The most complete demographic reporting in this corpus, and the completeness is what makes the imbalances visible. Table 1 gives, per group: sex (autistic 77.5% male versus typically developing 48.9%), race (White/Caucasian 47.5% versus 77.7%; African American 15.0% versus 8.6%; other 37.5% versus 13.6%), Hispanic/Latino ethnicity (32.5% versus 7.3%), M-CHAT-R/F positivity (87.5% versus 0.25%), ADOS-T total (7.64 +/- 1.69 in the autistic group), and age in months (24.21 +/- 4.72 versus 20.62 +/- 3.21). Caregiver education is reported for the whole sample: 82.8% college degree, 15.5% more than high school, 1.8% no high school. Three of these differences matter and none is adjusted for. The age gap of 3.6 months is large at 17-36 months, a period of rapid change in facial expressivity, affect regulation and attention, and it runs in the direction that would be expected to produce more, not less, behavioural regulation in the older autistic group - so it does not obviously explain the finding, but it is a live confound in a study that goes to the trouble of ANCOVA-adjusting two other covariates. The sex difference reflects autism's true sex ratio rather than a sampling error, but sex differences in facial expressivity in toddlerhood are documented. The racial and ethnic difference is the one with a technical as well as a demographic dimension: the autistic group is 30 percentage points less White and over four times as likely to be Hispanic/Latino, and the paper's own stated limitation is that landmark and affect detectors were trained primarily on adults - detector accuracy is also known to vary by skin tone and facial morphology, so differential measurement error across groups cannot be excluded. The authors acknowledge the general problem, stating that the sample 'did not have sufficient power to determine the impact of demographic characteristics on the results'." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-103" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "'Toddlers with ASD' and 'typically developing (TD) toddlers', used consistently and person-first throughout, with 'children with autism' also appearing. The register is notably measured for this literature. Autistic children are described as experiencing 'challenges in establishing social communication' and 'differences in use of facial expressions', and the paper speaks of 'atypical' and 'ambiguous' expressions rather than of deficits or abnormality - though 'atypical facial expression' is called an 'early symptom' and the language of biomarkers, symptoms and risk is used throughout. There is no burden framing, no cost-to-society argument, and no claim that autistic people cannot live independently, all of which appear in other papers charted here. Two interpretive passages are worth noting for their care. The explanation offered for the finding is framed as speculation and is symmetrical rather than deficit-laden: typically developing toddlers may respond more predictably because they share an understanding of the movies' social meaning, whereas autistic children's responses 'may be more idiosyncratic' - idiosyncrasy rather than impairment. And the authors note that neutral expressions 'might be interpreted by others as more ambiguous', locating the communicative difficulty in the interpretation as much as in the expression. There is no neurodiversity framing and no autistic-community involvement statement." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-103" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The three stated limitations are accurate and appropriately weighted: adult-trained landmark and affect detectors applied to toddlers, the possibility that other complexity measures would discriminate better, and insufficient power to determine how demographic characteristics affect the results. The last is an honest acknowledgement of a real problem, since the groups differ substantially on three demographic axes. The unstated limitations are fewer than in any other study charted here but include some that matter. The 3.6-month age gap between groups is never adjusted for, which is conspicuous in a paper that constructs ANCOVA models for two other covariates - the direction of the gap makes it an unlikely explanation of the finding, but it should have been modelled. The racial and ethnic composition differs sharply (47.5% versus 77.7% White; 32.5% versus 7.3% Hispanic/Latino), and this interacts with the acknowledged limitation about the detectors: landmark localisation accuracy varies with facial morphology and skin tone, so differential measurement error is a specific possibility, not a generic caveat. The decision to run the classification only on social movies was taken after seeing which movies produced larger effect sizes in the same data. No class handling is described for the decision tree, and the reported precision of about 70% with recall near 89% cannot arise from a 40:396 ratio without some balancing, so an undisclosed step exists in the classification pipeline. Per-movie analysed sample sizes appear only in figures. And ADOS-T totals were collected but never correlated with the entropy measure, leaving the biomarker's relationship to severity untested." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-103" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Spontaneous facial movement, characterised by its temporal predictability rather than its content - which is the study's conceptual contribution and distinguishes it from the affect-recognition tradition. Two regions were prespecified with stated rationales: the eyebrows, following the group's earlier finding about eyebrow raising in this cohort and the possibility that it indexes attentional engagement; and the mouth, on the basis of literature linking atypical vocalisation and mouth movement to autism. For each region the landmark points are averaged into a one-dimensional signal, head motion having first been removed by affine normalisation so that what remains is facial deformation rather than head movement. Multiscale entropy then quantifies how unpredictable that signal is across temporal scales. The authors are careful to explain what this does and does not capture, and the explanation is worth stating precisely because the distinction is often blurred elsewhere: a signal with large but highly periodic excursions gives low entropy, and so does a nearly stable signal with small excursions, while only irregular non-periodic movement gives high entropy. So the measure is not amplitude, not frequency and not variability, but predictability - and the paper backs this up empirically by showing that integrated entropy correlates only weakly (0.2-0.42) with landmark variation. The finding is that autistic toddlers' facial movement is less predictable in both regions, that the difference is amplified by social content, and that their responsiveness also varies more across different movies. The interpretation offered is that typically developing toddlers respond more predictably because they share an understanding of the movies' social meaning while autistic toddlers respond more idiosyncratically - explicitly labelled as speculation." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-103" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "An ordinary consumer iPad with its front-facing camera at 30 frames per second, running a purpose-built application - no research-grade sensor, no eye tracker, no wearable, no additional hardware. That choice is the point: the entire measurement chain is a device already present in most homes and clinics, which is what makes the scalability claim credible rather than aspirational. Analysis components are all published and cited: a face detection algorithm, a low-dimensional facial embedding used to identify and track the child's face specifically among those of caregiver, siblings and clinical staff, a 49-point landmark detector, and the group's own pose-invariant affect estimator, itself previously validated against human frame-by-frame coding of 136,450 frames with an intraclass correlation of 0.9. Statistical work used Python with pingouin (Mann-Whitney U, Wilcoxon, ANCOVA), scipy (Spearman) and scikit-learn (logistic regression), each named at function level. The one component with a stated weakness is the perception layer: the landmark and affect algorithms were trained primarily on adults, which the authors list as a limitation while noting their prior validation in toddlers." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-103" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Interpretability is structural rather than added afterwards, because the feature is a single quantity with a stated physical meaning. The paper explains precisely what integrated entropy measures and, importantly, what it does not: not amplitude, not variability, not frequency, but predictability, with the specific consequence that both a highly periodic large-excursion signal and a nearly stable small-excursion signal yield low entropy. That distinction is then tested rather than asserted, through the weak correlation (0.2-0.42) between integrated entropy and landmark variation, and through ANCOVA adjustment for variation as a covariate. Region selection was hypothesis-driven and prespecified with citations, so the analysis is confirmatory rather than exploratory in its choice of features. The social/non-social contrast functions as an interpretive control, showing that the effect is amplified by social content but present without it. The redundancy analysis against affect is itself an interpretability exercise - establishing that the measure is not simply detecting smiles. And the substantive interpretation offered is clearly labelled as speculation and is symmetrical rather than deficit-framed. What is missing is individual-level explanation: no error analysis, no examination of which children were misclassified, and no link between entropy and ADOS-T severity, which would have been the strongest available evidence that the measure tracks the construct it claims to index." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-103" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Deliberately simple, and the simplicity is appropriate to the claim. The primary analyses are conventional non-parametric statistics: Mann-Whitney U for between-group comparison, Wilcoxon signed-rank for within-group, with effect size r reported for every significant test, and ANCOVA to adjust for two prespecified confounds. The modelling contribution is not a classifier but the entropy estimator itself - a modification of multiscale entropy that handles partially missing time series by admitting only fully observed embedding vectors into the coefficient counts, and that normalises per participant so complexity can be compared across people. The authors flag the second point sharply, noting in a footnote that despite MSE's popularity in health research the across-subject comparison problem 'has never been addressed before, and often authors report lower MSE for data that is clearly more complex and vice-versa'. The classification component is a secondary demonstration using a decision tree with Gini splitting and leave-one-out cross-validation, plus logistic regression for odds ratios. No deep learning appears anywhere. Given 40 autistic participants and two features, this is the right choice, and the paper does not pretend otherwise - the classifier is presented as evidence of feasibility rather than as the result." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-103" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Four paediatric primary care clinics in the Duke Children's Primary Care network, with data captured during routine well-child visits. This is the study's most consequential design property and it addresses the corpus's most pervasive external-validity problem. Because recruitment is by clinic attendance rather than by diagnostic status, the sample is not a set of specialist-clinic cases contrasted with community controls but a screening cohort in which autism is identified prospectively at 9.2% prevalence. The measurement is embedded in the visit rather than added to it: the child sits on the caregiver's lap, an iPad is placed at 60 cm, and the movies play for a few minutes while the front camera records. Practical constraints of the setting are reported honestly as exclusion criteria - the child was too upset, the caregiver had no time or needed to mind siblings, consent could not be given in English or Spanish - which is a realistic account of what limits deployment in primary care and is more informative than a laboratory study's silence on the same issues. The one respect in which the setting is not fully representative is socioeconomic: 82.8% of caregivers held a college degree, which is far above the US population and reflects the catchment of an academic health system." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-103" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two scalar features per participant per movie: integrated entropy of the eyebrow region and of the mouth region, each being the cumulative sum of sample entropy across the first 20 coarse-grained scales of the landmark time series. The pipeline that produces them is where the work sits. Forty-nine landmarks are tracked at 30 fps; the child's face is isolated from those of caregiver, siblings and clinicians by facial embedding; eye-corner and nose landmarks drive an affine transform to a canonical face so that head motion is removed rather than confounded with expression; head-pose angles are estimated separately; signal above 15 Hz is filtered as noise on the physiologically motivated grounds that a facial expression takes at least 260 ms; non-attending intervals are excised; and the remaining landmark points within each region are averaged into a single time series. Sample entropy uses m = 2 and r = 0.15 sigma, both taken from prior literature with an appendix showing insensitivity to the choice. The missing-data rule is stated with a worked numerical example: only embedding vectors free of missing points contribute to the counts, because concatenating across gaps would inflate Cm without inflating Cm+1 and so bias the entropy. A minimum 40% valid-data requirement per movie applies. The representation deliberately discards expression identity, amplitude and timing, retaining only predictability - which is what makes it complementary to the affect measure rather than a variant of it." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-103" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional, single session, no follow-up, and no test-retest reliability of the entropy measure - which matters for a biomarker proposed for treatment monitoring, since sensitivity to change requires knowing the measurement's stability. Governance is exemplary by the standards of this corpus. The study was approved by the Duke University Health System Institutional Review Board under two protocol numbers (Pro00085434, Pro00085435), written informed consent was obtained from caregivers or legal guardians, and inability to consent in English or Spanish is disclosed as an exclusion criterion rather than passed over. Funding from eight sources including four NIH grants and four technology companies is itemised, with an explicit statement that 'the funders had no direct role in the study design, data analysis, decision to publish, or preparation of the manuscript'. The competing-interests statement is the longest in this corpus and is unusually forthcoming: several authors developed technology licensed to Apple and have benefited financially, one is CEO of a company and holds a granted patent plus three applications alongside numerous advisory and consulting relationships, and another was affiliated with Apple at publication. Crucially, a structural mitigation is described rather than merely asserted: 'Data analysis for this project is constantly independently reviewed by Scott Compton, who has no conflict of interest related to this work', and Compton is a named co-author. Given the commercial stakes attached to a tablet-based autism screening app, an independent analysis reviewer is the right safeguard and is worth noting as a practice other groups could adopt." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-103" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No cross-sensor fusion, but the paper contains the corpus's cleanest test of whether two measures from the same modality carry redundant information, and the test is designed as discriminant validity rather than as an accuracy chase. The comparison measure is the group's own previously published affect analysis - the energy of the first derivative of neutral, positive and negative affect probability time series, computed as a 10-frame moving average of the rate of change followed by cumulative sum. Three lines of evidence are brought to bear. Correlation: Spearman r between integrated entropy and positive-affect energy is moderate for Blowing Bubbles (.49 eyebrows, .60 mouth) and Mechanical Puppy (.41, .49) but negligible for the other four movies (.01-.15), and the mouth correlates more strongly than the eyebrows, which the authors note is expected because smiling is a mouth event. Classification: decision trees using entropy alone reach 76.6-78.3% accuracy, using affect alone 61.6-75.0%, and using both 63.3-79.5% - so adding affect does not help and in two of four movies hurts, while AUCs compared by DeLong's method favour entropy alone in three of four movies. Logistic regression: entropy gives odds ratios up to 1.8 while affect gives 0.8, i.e. below unity. The conclusion that the two measures are largely independent and that entropy is the stronger is therefore supported by three convergent analyses rather than by a single accuracy comparison. The general lesson for the review is that a partially correlated second measure can be genuinely non-redundant, and that testing for redundancy explicitly - rather than reporting that fusion improved accuracy - is the more informative design." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-103" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Six short movies, each under 90 seconds, presented on a tablet during the clinic visit, with the social/non-social split used as an internal control rather than as incidental variety. The four social movies feature human actors making eye contact, smiling, gesturing, reciting nursery rhymes and behaving comically - Blowing Bubbles (64 s), Spinning Top (53 s), Rhymes and Toys (49 s) and Make Me Laugh (56 s) - and two of them deliberately include both successful and failed attempts, which creates natural moments for affective response. The two non-social movies show dynamic toys or animations: Mechanical Puppy (25 s) and Dog in Grass Right-Right-Left (40 s), the latter using a structured spatial sequence. The design has three strengths worth carrying into the synthesis. It is short, passive and requires nothing of the child, so it can be administered opportunistically to 17-36 month olds in a clinic room. The social/non-social contrast provides a within-subject test of whether the measured signal is specific to social content, and the answer - large effects for social movies, medium effects for non-social - is more informative than a single accuracy figure, because it shows the complexity difference is amplified by social content but not created by it. And the environment is controlled in a low-tech way that suits the setting: caregiver holds the child, tablet at a fixed 60 cm, everyone else stands behind the pair to reduce distraction. The limitation is that passive viewing elicits a narrower behavioural range than interaction, and the authors identify live interpersonal interaction as the natural next step." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-103" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Among the strongest in this review, and structurally different from the case-control norm because the diagnostic pathway is the clinical one rather than a research recruitment. Every toddler received the M-CHAT-R/F, a validated caregiver screening instrument, as part of routine well-child care. Children screening positive, and children about whom a caregiver or clinician expressed developmental concern, were then evaluated by a child psychologist using the ADOS-Toddler module, the age-appropriate observational gold standard. Mean ADOS-T total in the autistic group was 7.64 +/- 1.69. Two features deserve particular credit. The comparison group is screened rather than assumed: 396 typically developing toddlers all completed M-CHAT-R/F, so undetected autism in the comparison group is reduced (though not eliminated, since M-CHAT-R/F sensitivity is imperfect and only screen-positive or concern-flagged children received ADOS-T). And the single discordant case is reported explicitly - one typically developing child screened positive, was evaluated with ADOS-T, and was not diagnosed - a level of transparency about the reference-standard pathway that no other study charted here provides. The limitation is the one intrinsic to a two-stage design: children who screened negative and prompted no concern did not receive ADOS-T, so the comparison group's status rests on a screening instrument rather than on the diagnostic one." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-103" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:study_design "Cross-sectional two-group study embedded in routine paediatric primary care; primarily a biomarker-characterisation study with statistical group comparison, extended by a secondary…" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: ; comparison: 396" ] ] ;
