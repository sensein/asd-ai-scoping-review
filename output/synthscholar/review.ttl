    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "A 70/15/15 subject-level split is described but cannot be located to any consistent sample; none of the named metrics (sensitivity, specificity, PPV, NPV, AUC, calibration) is reported as a number; the experiments are described as simulations; and results are presented as bar charts binned into low, medium and high." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "No diagnostic instrument administration, criterion or assessor is described for any dataset; the named sources are screening instruments, not diagnoses; and one results scheme includes a category defined as a 50% probability of yes and a 50% probability of no." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "No participants and no coherent sample description: 25,000 positive cases are reported from a 10,000-sample MRI dataset, a 25,000-to-1,200 ratio is described as class balance, and the study population's age is given as 0-36 months, 12-36 months and 3-6 years in three different places." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Partition count differs between sections (six versus four); the modality set differs between sections; the representation of questionnaire data by a 224x224 convolutional backbone is never specified; and aggregated feature vectors appear as illustrative example values." ] ;
            slr:overall_judgment "high" ;
            slr:tool_used "QUADAS-2" ] .

<urn:slr:article:272c3ab22999> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Frontiers in Medicine 01 frontiersin.org Diagnosing autism spectrum disorder based on eye tracking technology using deep learning models Mosleh Hmoud Al-Adhaileh 1,2*, Saleh N. M. Alsubari 3, Abdullah H. Al-Nefaie 1,4, Sultan Ahmad 5,6* and Asma Abdulmana Alhamadi 7 1 King Salman Center for Disability Research, Riyadh, Saudi Arabia, 2 Deanship of E-Learning and Distance Education and Information Technology, King Faisal University, Al-Ahsa, Saudi Arabia, 3 Department of Computer Science, College of Technology and Business, Riyadh Elem University, Riyadh, Saudi Arabia, 4 Department of Quantitative Methods, School of Business, King Faisal University, Al-Ahsa, Saudi Arabia, 5 Department of Computer Science, College of Computer Engineering and Sciences, Prince Sattam Bin Abdulaziz University, Al-Kharj, Saudi Arabia, 6 School of Computer Science and Engineering, Lovely Professional University, Phagwara, India, 7 Department of Humanities, College of Science and Theoretical Studies, Saudi Electronic University, Riyadh, Saudi Arabia" ;
    dcterms:bibliographicCitation "Al-Adhaileh MH; Alsubari SNM; Al-Nefaie AH; Ahmad S; Alhamadi AA (2025). Diagnosing autism spectrum disorder based on eye tracking technology using deep learning models. *Frontiers in Medicine, 12*." ;
    dcterms:creator "Ahmad S",
        "Al-Adhaileh MH",
        "Al-Nefaie AH",
        "Alhamadi AA",
        "Alsubari SNM" ;
    dcterms:title "Diagnosing autism spectrum disorder based on eye tracking technology using deep learning models" ;
    bibo:pmid "local_7432ffd7" ;
    fabio:hasPublicationYear 2025 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Participants appropriate to the question" ;
                            slr:justification "59 children, labels inherited without any stated diagnostic procedure; ASD 86% male versus TD 43% male." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Sample size justified" ;
                            slr:justification "No sample-size or power consideration. The million-row figure is presented as size while the effective n remains 59, and the row count matches Excel's worksheet limit." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Data source and eligibility described" ;
                            slr:justification "Source dataset identified by figshare URL, which is a genuine strength, but recruitment, setting country, dates and eligibility criteria of the original collection are absent." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Predictors defined and measured appropriately" ;
                            slr:justification "CARS_Score, a clinical autism severity instrument, is used as an input feature - direct target leakage. Tracking_Ratio, a data-quality index, is also retained." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Predictors assessed blind to outcome" ;
                            slr:justification "Mutual-information feature selection ranked features against the class label over the entire dataset, so predictor choice was made with full sight of the outcomes later used for testing." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Preprocessing applied without leakage" ;
                            slr:justification "Mean imputation and feature ranking both computed on the pooled dataset before cross-validation." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Outcome determined independently of predictors" ;
                            slr:justification "The predictor set contains the CARS score, which is one of the instruments by which the outcome is determined." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Outcome definition and ascertainment" ;
                            slr:justification "Outcome is the archived group label with no stated reference standard, cut-off or assessor." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Validation design guards against optimism" ;
                            slr:justification "Row-level stratified CV without participant grouping; early stopping on the reported partition; no external validation." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Analysis unit matches the clinical claim" ;
                            slr:justification "Diagnostic claims are made about children; every reported metric is computed over gaze samples. No participant-level result exists in the paper." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Limitations and overinterpretation" ;
                            slr:justification "No limitations section of any kind; the conclusion advances directly to clinical application." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Performance measures adequate" ;
                            slr:justification "No AUC, no specificity as a separate figure, no calibration, no PPV/NPV at a realistic prevalence. Statistical testing compares fold accuracies to an arbitrary 95% constant rather than to chance or a clinical comparator, treating five dependent folds as independent observations." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "SMI RED mobile eye tracker at 60 Hz with a 17-inch stimulus display, participant at ~60 cm. Compute: 7th-generation Intel Core i7, 8 GB RAM, 16 GB GPU. Software is described only as a suitable computational framework for neural network training - no library, no version, no seed. Calibration procedure, data-quality thresholds and drift handling are not described, which matters because Tracking_Ratio (a data-quality index) is one of the retained features." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-141" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No fusion of behavioural modalities - eye tracking only. There is, however, an undeclared fusion of a different kind: the clinical instrument score (CARS) is concatenated with the behavioural features into a single input vector. That is not multimodal behavioural fusion; it is the insertion of the outcome's own measurement instrument into the predictor set. Multimodal work is named as future rather than present." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-141" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "ASD, autism spectrum disorder, children diagnosed with ASD, autism group, non-ASD, typically developing (TD) children. Diagnosis-first, deficit-oriented phrasing predominates: children with ASD typically have difficulty focusing, reduced attention to important stimuli, autism and non-autism profiles. There is no mention of autistic community perspectives, no identity-first alternative, and no acknowledgement that the sample carries clinical labels assigned by others." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-141" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Visual attention allocation during free viewing - fixation position (point of regard, left and right eye), gaze direction vectors in three dimensions, and the categorical annotation of what was being looked at (Category_Right, Category_Left) alongside stimulus identity. The behavioural construct is therefore where the child looks, sampled instantaneously, with no aggregation into fixations, saccades, dwell times or AOI proportions." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-141" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None applied to the model. A Pearson correlation heatmap and the mutual-information ranking characterise the input data before fitting. No post-hoc attribution, no attention weights (attention is proposed as future work), no ablation showing performance with CARS_Score removed - the single experiment that would have settled what the model learned." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-141" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two groups from a single archived dataset: 29 children with ASD and 30 typically developing children, 59 in total. The unit actually analysed is not the child but the gaze sample: 1,048,575 rows. That figure deserves attention - 1,048,576 is the maximum row count of a Microsoft Excel worksheet, so the analysed set is almost certainly a spreadsheet-truncated slice of the source recording rather than the complete data, and the paper never remarks on it. Per-child row counts, per-group row counts and per-fold composition are all unreported." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-141" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Stratified 5-fold cross-validation on 1,048,575 gaze-sample rows, stratified by class only. This is the review's clearest instance of within-participant leakage at the finest possible granularity: with 59 children and roughly 17,800 rows each, every test fold is virtually guaranteed to contain samples drawn from the same recording session, the same child and the same stimulus presentation as the training rows, differing by fractions of a second. A model can reach 99.78% by recognising individual children rather than autism. Three further defects compound it. First, mutual-information feature selection was run on the whole dataset before cross-validation, so the folds were chosen using their own test labels. Second, mean imputation of missing values was likewise computed over the whole dataset. Third, early stopping restores the weights that minimise loss on the same partition whose accuracy is then reported. The 0.11% standard deviation across folds is presented as evidence of stability; it is better read as confirmation that the five folds are near-identical resamples of one recording set. No participant-level split, no external cohort, and no held-out site is attempted anywhere in the paper." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-141" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Partial and, on the decisive points, poor. Reproducible: the source dataset is openly archived on figshare with a resolvable URL, and the preprocessing sequence is narrated step by step. Not reproducible: no code, no software or version names, no random seed, no complete hyperparameter specification, no statement of the mutual-information threshold or scores that produced exactly 16 features, no per-fold row counts, and no per-child row counts. A reader cannot verify whether the 16 selected features are the same ones the mutual-information ranking would yield on their machine, nor reconstruct the folds." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-141" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "CARS_Score is present in the data but is never reported as a participant characteristic - no mean, no range, no distribution by group. Instead it is consumed as a model input feature. No IQ, developmental quotient, adaptive-behaviour, language or comorbidity measure is reported for any participant." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-141" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A 16-element tabular vector per gaze sample: trial and stimulus identifiers, Tracking_Ratio, Point_of_Regard right/left X and Y, six gaze-vector components, Category_Right, Category_Left, #Stimulus, and CARS_Score. Min-max scaled to [0,1], reshaped to (1,16). Two of these deserve separate note. CARS_Score is a clinician-administered autism severity instrument: within this dataset it is effectively a monotone function of the label, so its inclusion is direct target leakage and by itself can account for a near-perfect result. Tracking_Ratio is a signal-quality index that plausibly differs systematically between groups for reasons of compliance rather than social attention. Stimulus and trial identifiers encode session structure." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-141" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Not confirmed by this study. Labels are inherited wholesale from the figshare dataset. The presence of a CARS_Score field implies that the original collectors administered the Childhood Autism Rating Scale, but this paper reports no cut-off, no administrator qualification, no ADOS or ADI-R, no DSM or ICD criterion, and no statement of who made the diagnoses or when. The TD group's status as non-autistic is likewise asserted rather than evidenced - no screening instrument is named." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-141" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Supervised deep learning for binary classification: a standalone LSTM (64 units, dropout, sigmoid) and a hybrid 1-D CNN plus LSTM. The recurrent framing is nominal - the input tensor has exactly one timestep, so the LSTM has no sequence to traverse and reduces to a gated dense transformation of a 16-dimensional vector. The paper says this explicitly (even though the input consisted of only a single timestep) without recognising that it removes the entire justification for the architecture." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-141" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Free viewing of mixed static and dynamic stimuli. Dynamic content comprised short videos with engaging elements such as cartoon characters and balloons designed to attract children's attention; static content comprised images of faces, objects and scenes. No areas of interest are defined, no fixation or saccade extraction is performed, and no social-versus-nonsocial contrast is computed - the abstract's framing as social attention tasks is inherited from the dataset description rather than operationalised in the analysis." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-141" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Sparse and, where present, alarming. Table 2 reports sex and a single pooled mean age of 7.88 years - no SD, no range, no per-group age. Sex composition is 25 male / 4 female in ASD (86.2% male) versus 13 male / 17 female in TD (43.3% male), a 42.9-point gap. This is the largest sex imbalance in the review's charted corpus, exceeding the 32-point gap in local_4ceee075. Because sex systematically affects gaze behaviour towards faces, a classifier reading gaze coordinates can score highly by learning sex. No race, ethnicity, socioeconomic status, language, geography or recruitment source is reported for either group." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-141" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None acknowledged. There is no limitations section, no threats-to-validity paragraph, and no caveat anywhere in the discussion or conclusion. The paper moves directly from 99.78% to promise for clinical application. Every issue this review identifies - row-level splitting, unnested feature selection, CARS as an input, the sex imbalance, imputation before splitting, the Excel-shaped row count - passes unmentioned." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-141" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two directions: incorporating attention mechanisms into the deep learning models so the model focuses on the most relevant features, and extending to multimodal data combining eye-tracking with other behavioural or physiological signals. Neither addresses the validity problems in the present design; both propose adding capacity to a pipeline whose reported ceiling is already 99.78%." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-141" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "autism spectrum disorder; eye-tracking; deep learning; diagnosing; ASD. Purely method-and-condition; nothing on validation, generalisation, participants or clinical deployment." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-141" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2025, published 9 October, 32 days from submission to acceptance. Framing is unqualified diagnostic replacement: the system successfully diagnosed ASD, the approach shows promise for clinical application, assisting healthcare professionals in diagnosing ASD more accurately through advanced artificial intelligence technology. The comparison table positions the contribution purely as a higher accuracy number than nine listed predecessors, with no comparison of study design, split scheme or sample. It belongs to the review's leaderboard genre, in which the reported figure rather than the estimand is the unit of scientific progress." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-141" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional, no follow-up. Ethics reporting is absent entirely - no approval statement, no committee, no consent statement, and the word ethic does not appear in the article. This is a study of clinically labelled disabled children published in a medical journal with a full data-availability statement and no ethics statement of any kind. Only the public status of the source dataset is offered, which addresses data access, not the ethics of the analysis or of the diagnostic claim being made." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-141" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Data collection setting is described second-hand: a dedicated experimental room, participant seated about 60 cm from a 17-inch display, session length about five minutes, stimulus order varied between participants, infrared reflection tracking. The country, clinic type, recruitment channel and date of the original collection are not stated. The analysis itself was run on a desktop workstation." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-141" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Frontiers in Medicine 12:1690177 - an open-access general medical journal, not a computing venue. This matters for the review's venue analysis: the paper's audience is clinical, its abstract advises healthcare professionals, and no clinical reviewer flagged the absence of an ethics statement, the absence of a limitations section, or the use of a diagnostic instrument as a model input." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-141" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Accuracy, precision, recall/sensitivity, F1, per-class values and per-fold confusion matrices; means with standard deviations across the five folds. Missing: specificity as a separate figure, AUC or any threshold-free measure, calibration, positive and negative predictive value at a stated prevalence, and any participant-level metric. Because the analysis unit is the gaze sample, none of the reported numbers is a diagnostic accuracy in the clinical sense - not one figure in the paper describes how often a child would be correctly classified." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-141" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The stated goal is to implement deep learning on eye-tracking data from social attention tasks to diagnose ASD, and to identify the feature-selection strategy that lets the model reach high accuracy. Note that maximising accuracy is written into the objectives themselves - one of the listed research questions asks for the feature selection strategy that can assist the deep learning model in achieving high accuracy, which is a statement of intent to optimise the reported number rather than to estimate a diagnostic property. The headline finding is CNN-LSTM accuracy 99.78% (SD 0.11%), reported as outperforming previous studies and showing promise for clinical application." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-141" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "LSTM versus CNN-LSTM. A narrative comparison table (Table 1) lists nine prior studies with accuracies from 75% to 98.33%, but those figures are other authors' and are not re-run here." ;
                    slr:study_design "Retrospective secondary analysis of a single publicly archived eye-tracking dataset; supervised binary classification with stratified 5-fold cross-validation. No prospective recrui…" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: 29 children with ASD; comparison: 30 typically developing children" ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "CNN-LSTM mean accuracy 99.78% (SD 0.11% across folds); per-class average precision/recall/F1 of 99.81/99.85/99.83 for non-ASD and 99.72/99.63/99.67 for ASD. The standalone LSTM is reported as lower but still above 99%." ;
                    slr:outcome "Accuracy, precision, recall/sensitivity, F1, per-class breakdown, and confusion matrices for each of the five folds. Specificity is not reported separately; AUC, calibration and predictive values are absent." ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "CNN-LSTM mean accuracy 99.78% (SD 0.11% across folds); per-class average precision/recall/F1 of 99.81/99.85/99.83 for non-ASD and 99.72/99.63/99.67 for ASD. The standalone LSTM is reported as lower but still above 99%." ] ] ;
    slr:content_sha256 "f1b821befad639c20c476877597ecb83ff9efdebf80b94b5feb97c05e772cab7" ;
