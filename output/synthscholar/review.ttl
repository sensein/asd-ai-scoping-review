                    slr:judgment "unclear" ;
                    slr:supporting_quote "Image and scanpath counts are reported precisely for both the internal split (240/5542 and 60/1411) and the blind test (100 images), but participant counts and any exclusions are not." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "high" ;
