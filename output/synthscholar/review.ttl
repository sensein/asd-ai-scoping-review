    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "Cycle and trial counts are precisely reported for both datasets and trial counts are equalised across subjects, but no recruitment period, exclusions or session details are given." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Cross-validation splits gait cycles and trials rather than participants, with the authors stating that the same subject and even the same trial can appear in both training and test folds; hyperparameters were also grid-searched on the same cross-validation whose scores are reported." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "high" ;
