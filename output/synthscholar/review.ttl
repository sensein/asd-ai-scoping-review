                    slr:judgment "unclear" ;
                    slr:supporting_quote "10-fold cross-validation with identical splits and training-fold normalisation, plus 100 bootstrap runs for selection stability, but the sparsity operating point, hyperparameters and best method were all selected against the same estimate - which the authors acknowledge may be over-optimistic." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
