    slr:journal "Biomedical Signal Proces" ;
    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Thirty male children at a single residential special school, with no age distribution, cognitive level, comorbidity or current medication recorded, and no non-autistic participants. Severity-level class sizes are never reported, and the four capture settings drew on overlapping groups of 10, 12, 4 and 4 children whose severity distribution is unstated." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "No diagnostic ascertainment is described for any child, and the severity labels that the classifiers predict have no stated source anywhere in the paper - the ABC is discussed as background but never reported as administered. The claim that the classifiers outperform the clinical ABC method is therefore uninterpretable and, if the ABC supplied the labels, logically incoherent." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "An 80-20 split over 1,500 images from 30 children, approximately 50 images each, with no participant-level partitioning mentioned and no cross-validation for the severity task. Since severity is a fixed per-child attribute, identifying the child recovers the label. The 20 videos collected for real-time testing, which would have provided a held-out evaluation, are never analysed." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Skin temperature, the primary feature, was measured across outdoor play, classroom, dining and veranda settings with no ambient-temperature compensation, no environmental logging and no per-setting normalisation, so thermal environment and physical exertion are confounded with any physiological signal. Distance to subject, viewing angle and camera specifications beyond emissivity are unreported. Facial-mood labels for these thermal images have no stated provenance." ] ;
            slr:overall_judgment "high" ;
            slr:tool_used "QUADAS-2" ] .

<urn:slr:article:ceb7a2194e61> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "With the rise of Autism Spectrum Disorders (ASD) incidence rate, a new screening method that is capable of diagnosing ASD in a more accurate and convenient way is urgently needed. Unlike traditional scales, electroencephalogram (EEG), and eye movement based methods, the acoustic analysis based method has inherent advantages in data collection and rich algorithms that can be employed in speech processing. In this paper, three methods are compared for the construction of acoustic features based on time-frequency independent component analysis (TF-ICA): (1) extracting and combining the rows of the unmixing matrix of each frequency point to build the feature vector; (2) using the separation results of each frequency point as time-frequency feature; (3) extracting time-domain features from the outputs of TF-ICA. Finally, the features are compared by a deep learning classiﬁer on an ASD speech dataset. It is concluded from the experimental results that method 1 obtained the highest recognition rate of 98.51%." ;
    dcterms:bibliographicCitation "Chen L; Zhang C; Gao X (2022). Speech Signal Analysis of Autistic Children Based on Time-Frequency Domain Distinguishing Feature Extraction. *2022 IEEE 34th International Conference on Tools with Artificial*." ;
    dcterms:creator "Chen L",
        "Gao X",
        "Zhang C" ;
    dcterms:title "Speech Signal Analysis of Autistic Children Based on Time-Frequency Domain Distinguishing Feature Extraction" ;
    bibo:pmid "local_65974fc7" ;
    fabio:hasPublicationYear 2022 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are participants and recruitment adequately described?" ;
                            slr:justification "Approximate counts and recruitment partners only; no ages, sexes or clinical information." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is developmental or language level measured?" ;
                            slr:justification "None, in a study whose outcome is speech production and where pronunciation ability drove data loss." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is differential data loss reported?" ;
                            slr:justification "Less than a third of recordings were usable, attributed to autistic children's pronunciation difficulty, with no retention rate by group." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are comparison groups matched?" ;
                            slr:justification "No demographic information on which matching could be assessed." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the recording configuration described?" ;
                            slr:justification "No microphone, device, distance, room or channel count - critical for a multichannel ICA method." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the elicitation protocol described?" ;
                            slr:justification "Words, phrases and sentences with words at 95%; no prompt list, script, examiner role or session structure." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the reference standard appropriate and independently applied?" ;
                            slr:justification "No diagnostic procedure reported at any point." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the meaning of the primary feature established?" ;
                            slr:justification "The unmixing matrix's interpretation depends on the observation channels, which are described ambiguously and never disambiguated." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the signal-processing chain described reproducibly?" ;
                            slr:justification "Mixing model, STFT parameters, independence criterion, update rule, sorting and amplitude compensation all given with equations." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the classifier cross-validated?" ;
                            slr:justification "Cross-validation is used only for SVM hyperparameter selection; performance comes from a single split of 181 test recordings." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the unit of analysis the participant?" ;
                            slr:justification "Recording-wise 80:20 split with roughly six utterances per child spanning both sides." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are all three methods reported?" ;
                            slr:justification "Including the near-chance Method 2, which could have been omitted." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are metrics beyond accuracy reported?" ;
                            slr:justification "Precision, recall and F1 for both classifiers under all six conditions." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is selection over candidate features corrected?" ;
                            slr:justification "Method 2's 59.71% is the best of 256 frequency sequences with no correction and no reported distribution." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are internally inconsistent results reconciled?" ;
                            slr:justification "Method 2's near-chance separated signals are not reconciled with Method 1's near-perfect unmixing matrix." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is uncertainty quantified?" ;
                            slr:justification "No confidence intervals, no repetitions, no chance baseline." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are ethics and consent reported?" ;
                            slr:justification "No statement anywhere, despite purpose-collecting roughly 7,000 recordings from children via special education schools." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the dataset accessible?" ;
                            slr:justification "Presented as filling a gap in public data but not released or offered." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is a limitations section present?" ;
                            slr:justification "Only the dataset size is acknowledged, and only as an explanation for the CNN's weaker performance." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is code available?" ;
                            slr:justification "Not mentioned." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are any acoustic or behavioural findings reported?" ;
                            slr:justification "No group means, directions or characterisations of speech anywhere." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the framing of the comparison group appropriate?" ;
                            slr:justification "'Normal children' throughout, with autistic speech formally modelled as neurotypical speech convolved with 'dysfunctional' factors." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "high" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two classifiers applied uniformly across all three feature methods, which makes the method comparison interpretable in that respect. The SVM is specified - radial basis function kernel with C and gamma selected by cross-validation, with the search surface plotted - and justified on small-sample grounds, that it 'still has good generalization ability under finite small samples'. The CNN is not specified at all: no layer count, filter sizes, depth, optimiser, learning rate, batch size or epoch count appears, only the general claim that convolution 'provides translation invariant convolution in time and space'. It underperforms the SVM under every one of the six conditions, by margins from 2.9 to 5.6 percentage points, which the authors attribute to insufficient training data. No baseline, chance level or permutation test is reported for any condition, which matters most for Method 2 where 59.71% needs to be judged against both chance and the 256-way selection that produced it." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-092" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Three representations of the same recordings, differing in where they intercept the ICA pipeline, and the choice among them is the paper's contribution. Method 1's representation is the unusual one and the one carrying the headline: the coefficients of the 2x2 unmixing matrix at each of 256 frequency points, concatenated. These are not properties of the child's voice in any direct sense - they are the parameters of a linear demixing operator estimated from the observation channels - and their interpretation depends entirely on what those channels are, which the paper does not establish. Method 2's representation is the separated component sequences, one per frequency point, of which the single best-performing was reported. Method 3's is conventional: MFCC, LPCC and PLP computed on reconstructed audio, and the authors note that separation 'eliminates the influence of certain noises and makes the speech data more pure', while sensibly cautioning that speech processing 'need not overly pursue the complete elimination of noise' since aggressive denoising distorts speech." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-092" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. No cognitive, language, adaptive, severity, comorbidity or medication information for either group, and no exclusion criteria. One relevant observation is made in passing and is important: 'the quality of children's word pronunciation was poor because some ASD children can't pronounce normally, or it's difficult for them to pronounce as required, finally, less than 1/3 of the data was usable'. That establishes that expressive speech ability varied substantially within the autistic group and that data loss was driven by it, but no measure of that ability was collected and the retention rate is not reported separately by group." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-092" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The most consequential reporting gap in the paper. No microphone, recording device, sampling arrangement beyond the 48 kHz rate, room, distance or channel count is described; a photograph is referenced in place of a methods description. This matters because the entire analysis rests on a two-input two-output convolutive mixing model, and the paper's own equations describe the two observation channels ambiguously. Equation 1 sets up a general M-receiver model, which implies multiple microphones. Equation 2 then simplifies to two channels and states that 'x(n) are the ASD children's speech signal and the normal children's speech signal, respectively' - which describes not two microphones recording one speaker but one recording from each group. Under that reading each ICA would operate on a paired autistic and comparison utterance, and the resulting unmixing matrix would depend on the pairing, which requires the labels. The analytic chain is otherwise well specified: STFT with window 512 and offset 256 giving 256 frequency sequences, negative entropy as the independence criterion with the definition given, a fixed-point update rule, and permutation sorting with amplitude compensation before reconstruction." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-092" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Accuracy, precision, recall and F1 reported for both classifiers under all six feature conditions - a complete and consistently applied panel, and the metric definitions are given. Reporting all three methods including the near-chance one is to the paper's credit, since Method 2's 59.71% could easily have been omitted. What is missing bears directly on how the numbers should be read. There is no confidence interval anywhere, on a test set of 181 recordings where a single reclassification moves accuracy by half a percentage point. There is no chance or trivial baseline, so Method 2's result is uninterpretable as stated - especially given that it is the maximum over 256 candidate frequency sequences, a selection that would elevate the apparent performance of pure noise. And there is no per-child aggregation, so the reported figures describe how well one-second recordings are classified rather than how well children are." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-092" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Goal: compare three acoustic feature constructions derived from time-frequency ICA for distinguishing autistic from comparison children's speech. Main findings: unmixing-matrix features reached 98.51% accuracy with SVM and 95.59% with CNN; separated frequency-point sequences reached only 59.71% and 55.19%, this being the best of 256 sequences; cepstral features on separated signals reached 91.00-92.89% with SVM, with PLP best and MFCC worst; and SVM outperformed CNN under every condition, which the authors attribute to the small dataset." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-092" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Nothing. No diagnostic instrument, criterion, clinician role, setting or timing is reported anywhere in the paper. The only relevant information is the recruitment route - cooperation with a medical university, an autism association and special education schools - which establishes that participants were engaged with autism services but not how their diagnoses were made or verified. The comparison group's status is likewise unestablished, with 'normal children' asserted and no screening described. The paper's introduction observes that 'ASD diagnosing can be difficult because there are no standard and quantified medical tests like blood tests to diagnose the disorder', which makes the absence of any account of how the reference labels were obtained more conspicuous rather than less." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-092" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Single modality with no fusion, but the three-method comparison is the paper's structure and its internal inconsistency is the most informative thing in it. Methods 1 and 2 are two views of the same computation: the ICA produces an unmixing matrix, which is applied to the observations to produce separated components. Method 1 uses the matrix, Method 2 uses its outputs. The reported results are 98.51% and 59.71%. If the separation were extracting genuinely different vocal sources for the two groups, the separated signals should carry that difference, yet they classify barely above chance even after the most favourable of 256 frequency sequences is selected. Method 3, which reconstructs time-domain speech from those same separated components and extracts standard cepstral features, then recovers 91-93% - which suggests the discriminative information is present in the reconstructed audio but not in the individual frequency-point sequences, and is consistent with ordinary speaker- and speech-level acoustic differences. Taken together the three results do not form a coherent picture, and the paper's explanation - that the unmixing matrix captures 'the essential distinctions between the two types of children's speech' - does not address why the separation those same matrices perform yields near-chance signals." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-092" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The weakest dimension, with three compounding problems. The split is by recording: 408 autistic and 428 comparison recordings train, the remainder test, described as randomly selected from 511 and 506 recordings originating in more than 80 and more than 60 children - so approximately six utterances per child are randomly assigned between the two sets and utterances from the same child appear on both sides. For one-second single-word samples from the same speaker in the same session, this approaches speaker identification rather than group classification, and it is the same failure that Kanhirakadavath and colleagues quantified on gaze images as a fall from 97% to 73% when the unit was corrected. There is no cross-validation of the classifier, no repetition and no confidence interval, so the reported figures come from one partition of 181 test recordings. And Method 2's headline of 59.71% is the best of 256 frequency sequences, chosen after inspecting all of them, with no correction and no report of the distribution across the other 255. Layered over all of this is the unresolved question of what the two ICA observation channels are: if the equations mean what they say, each unmixing matrix is estimated from a paired autistic and comparison utterance, so Method 1's features would be functions of a label-dependent pairing and the 98.51% would not measure classification at all. The paper provides no information with which to exclude that reading." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-092" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Proceedings of the 2022 IEEE 34th International Conference on Tools with Artificial Intelligence (ICTAI), DOI 10.1109/ICTAI56018.2022.00164. All three authors are from the School of Computer Science and Technology at Anhui University, with no clinical, psychological or speech-science affiliation, though the data collection is credited to cooperation with Anhui Medical University, the Anhui Autism Association and special education schools. Funded by two Anhui provincial science programmes. The venue is an artificial intelligence tools conference, and the paper's profile matches: the signal-processing derivation is developed at length with full equations while the participants, the diagnostic basis, the recording configuration and the ethics are absent." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-092" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "'ASD children' throughout, against 'normal children' - the comparison group is called normal in the title framing, the abstract, every table and every figure caption, with 'typically developing' never used. That alone would place the paper at the normative end of this corpus, but the framing goes further and is embedded in the method rather than only in the wording. The generative model states that 'we consider the speech data of a ASD children as the convolution of pure normal children's speech data with all the filter banks representing the \"dysfunctional\" factors', so neurotypical speech is formally the undistorted source signal and autism is a distortion applied to it, alongside noise. The discussion repeats this, describing autistic speech as 'formed by the convolution of normal children's speech signals and all filter sets representing physiologically dysfunctional factors'. This is the only study in the corpus in which the deficit framing is a mathematical assumption of the model rather than a descriptive choice, and it determines the feature construction: Method 1's features exist only because the unmixing matrix is interpreted as the inverse of a hypothesised dysfunction filter." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-092" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Nothing whatsoever. No ages, no age ranges, no sexes, no IQ, no language level, no matching and no statistical comparison of any kind for either group. Even the participant counts are approximate. This is the least characterised sample in the corpus among studies that collected their own data rather than reusing a public benchmark - the benchmark-reuse papers at least have the excuse of inheriting an undocumented dataset, whereas this group recruited the children themselves over roughly two years and reports none of what they must have known. For a speech study the omission of age is especially consequential, since fundamental frequency, formant structure and articulatory precision change substantially across childhood and would separate any two groups differing in age composition." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-092" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two groups described only in aggregate: 'more than 80 ASD children and more than 60 normal children', from whom about 4,000 and 3,000 recordings respectively were collected in cooperation with Anhui Medical University, the Anhui Autism Association and special education schools. After quality exclusion 'less than 1/3 of the data was usable', and 511 autistic and 506 comparison recordings were randomly selected for analysis. Participant counts are given imprecisely ('more than'), no exact numbers are stated, and the mapping between children and recordings is never specified - so the analysed sample is roughly six recordings per child but the actual distribution is unknown. No other-diagnosis comparison group. The critical structural fact is that all analysis, splitting and reporting operates on recordings, and children are never used as a unit at any stage." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-092" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. No feature importance, attribution, group comparison, effect size or acoustic characterisation appears anywhere, and Method 1's representation admits none in principle - an unmixing-matrix coefficient at frequency point k has no interpretation as a property of a child's voice. The one interpretive claim offered is theoretical rather than empirical: that because autistic speech is modelled as neurotypical speech convolved with dysfunction filters, 'the unmixing matrix can be regarded as the inverse matrix of these filter banks', so extracting it 'is equivalent to extracting the inherent distinguishing features representing the vocal system of both, reflecting the essential distinctions between the two types of children's speech'. This is an argument from the assumed generative model to the meaning of the features, not evidence that the features mean what is claimed, and it is not tested. Method 3, using standard cepstral features, would have supported conventional acoustic interpretation and none is attempted." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-092" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "There is no limitations section and only one limitation is acknowledged anywhere - that the dataset is small, offered as the explanation for the CNN underperforming the SVM and as the motivation for the sole future direction. Not acknowledged: that recordings from the same child are distributed across training and test; that the sample is entirely uncharacterised demographically and clinically; that no diagnostic procedure is reported; that the 59.71% figure for Method 2 is the maximum over 256 frequency sequences; that Method 2's near-chance result is difficult to reconcile with Method 1's near-perfect one; that the two-channel configuration underpinning the whole method is never described; that less than a third of collected recordings were usable and the loss was driven by the autistic children's pronunciation difficulty, so the analysed autistic sample is the more verbally able subset; and that no ethics approval is reported." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-092" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "One direction: 'One of our main tasks in future is to further enrich the dataset', motivated by the observation that the CNN needs more labelled data than are available. No proposal is made to group by child, characterise the participants, document the diagnostic procedure, describe the recording configuration, or validate on independent data." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-092" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Index terms: Autism Spectrum Disorders, Independent Component Analysis, Deep Learning, Time-Frequency Feature. Three of four are signal-processing or machine-learning terms and none is clinical, which accurately identifies a paper whose contribution is a feature-construction comparison rather than a finding about speech." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-092" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional, with recordings accumulated over roughly two years and no follow-up. No ethics committee approval, consent statement or institutional review is mentioned anywhere, despite the study having purpose-collected approximately 7,000 speech recordings from more than 140 children recruited through special education schools and an autism association. Funding from two Anhui provincial science programmes is acknowledged. The dataset is presented as a contribution, with the authors noting that 'currently, there is no available public speech dataset for ASD children, which creates a big obstacle for related research', but no release, access route or sharing commitment is offered." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-092" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2022. The framing is a comparative argument for acoustic screening over the alternatives, and it is made concretely: methods based on eye movement, EEG and gut microbiome analysis 'all require expensive equipment, and the detection process is complex', while 'the scale based method highly depends on the subjective experience of doctors', so acoustic analysis 'provides a new path which is more simple and reliable for autism screening'. The related work is engaged specifically rather than generically, contrasting the study's use of speech against a prior study using infant cry - 'they focused on cry which is more random than the speech voice' - which is a reasonable methodological distinction. The paper also identifies a genuine infrastructure gap that this review can corroborate: 'currently, there is no available public speech dataset for ASD children, which creates a big obstacle for related research', a statement consistent with the fact that no speech study in this corpus shares its recordings, in contrast to the eye-tracking literature where a single public image dataset supports at least three of the charted studies. The paper's own corpus, roughly 7,000 recordings from over 140 children, would have been a substantial contribution to that gap had it been released." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-092" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "China, with collection organised through Anhui Medical University, the Anhui Autism Association and special education schools. The recording environment is not described in text at all - a figure is referenced showing the collection setup, but no room, distance, microphone or channel configuration is stated. This gap is not merely a reporting deficiency here but a methodological one, because time-frequency ICA is a multichannel technique: it requires at least two observation channels to separate sources, and which two signals constitute those channels determines entirely what the unmixing matrix represents. Without the recording configuration the paper's central feature construction cannot be reconstructed or evaluated." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-092" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Nominally the acoustic properties of autistic children's speech, but the construct is defined by a generative assumption rather than by any behavioural theory. The paper's model is that an autistic child's utterance equals a neurotypical utterance convolved with a filter bank representing 'all the dysfunctional factors', plus noise - so the target is whatever linear transfer function distinguishes the two groups' vocal production, treated as a property of 'the vocal system' rather than of prosody, articulation, phonation or pragmatics. Nothing in the analysis identifies which acoustic dimension is involved, and no group difference in any interpretable quantity is reported. The paper opens with a figure asserting 'noticeable distinctions' between an autistic and a comparison child's waveform, spectrum and spectrogram for the same content, but this is a single illustrative pair with no quantification. Compared with the other speech studies in this corpus - which measure pitch, jitter, shimmer, harmonics-to-noise ratio, rhythm or disfluency and report directions of effect - this study contributes no characterisation of speech at all." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-092" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Mathematically detailed and empirically opaque. Fully specified: the convolutive mixing model, the frequency-domain formulation, the negative-entropy independence criterion with its definition, the fixed-point update equation, the STFT window and offset, the resulting number of frequency sequences, the three feature constructions and the SVM kernel with its cross-validated parameter search. Not reported: recording equipment or channel configuration; participant ages, sexes, diagnoses or severity; the elicitation protocol or prompt set; whether lexical content was matched between groups; the CNN architecture, depth, training regime or any hyperparameter; how the 1,017 analysed recordings map to children; the retention rate by group; the criterion for selecting the 126th frequency sequence beyond it performing best; ethics approval; and any data or code release." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-092" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Elicited single-word production, with words constituting 95% of the corpus and phrases and sentences the remainder, each analysed sample trimmed to exactly one second at 48 kHz - a duration chosen because it 'not only ensured the integrity of the speech signal but also reduced the computational effort'. No prompt list, elicitation script, examiner instruction or session structure is described. Single-word production is the most constrained speech paradigm in the corpus, which has one methodological advantage - lexical content can in principle be held constant across children, removing a source of acoustic variation - and one significant cost, that prosodic, pragmatic and conversational features cannot be measured at all, so the study cannot address the prosodic constructs that motivate most speech work in autism. Whether lexical content was in fact matched between groups is not stated." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-092" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "One-second speech samples at 48 kHz; each child contributed multiple samples, with roughly 4,000 autistic and 3,000 comparison recordings collected over about two years" ;
                    slr:study_design "Cross-sectional case-control classification comparing three feature-extraction pipelines on a purpose-collected speech corpus" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Chinese children with autism attending special education services" ;
                    slr:sample_size_text "ASD/index: 'more than 80' children, contributing 511 of the analysed utterances; comparison: 'more than 60' children, contributing 506 of the analysed utterances" ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "Method 1: SVM 98.51% accuracy, 97.36% precision, 98.15% recall, 97.25% F1; CNN 95.59%. Method 2: SVM 59.71%, CNN 55.19% - near chance, and this is the best of 256 frequency sequences. Method 3: with PLP features SVM 92.89% and CNN 90.43%; with LPCC SVM 91.47% and CNN 85.92%; with MFCC SVM 91.00% and CNN 89.34%",
                        "Three feature representations derived from the same time-frequency ICA pipeline gave sharply divergent results on the same 1,017 one-second utterances. Features taken from the unmixing matrix reached 98.51% accuracy with an SVM; conventional cepstral features computed on the ICA-separated signals reached 91-93%; and the separated frequency-domain sequences themselves reached only 59.71%, barely ab" ;
                    slr:outcome "Accuracy (described as speech recognition rate), precision, recall and F1, reported for both classifiers under all three methods and, for Method 3, separately for each of the three cepstral feature families" ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "Method 1: SVM 98.51% accuracy, 97.36% precision, 98.15% recall, 97.25% F1; CNN 95.59%. Method 2: SVM 59.71%, CNN 55.19% - near chance, and this is the best of 256 frequency sequences. Method 3: with PLP features SVM 92.89% and CNN 90.43%; with LPCC SVM 91.47% and CNN 85.92%; with MFCC SVM 91.00% and CNN 89.34%; Three feature representations derived from the same time-frequency ICA pipeline gave sharply divergent results on the same 1,017 one-second utterances. Features taken from the unmixing matrix reached 98.51% accuracy with an SVM; conventional cepstral features computed on the ICA-separated signals reached 91-93%; and the separated frequency-domain sequences themselves reached only 59.71%, barely ab" ] ] ;
