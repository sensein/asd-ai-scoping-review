        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "as each gait cycle in the first set of tests is being used as an individual data point to be classified, there is a situation where the training data and the testing data can both contain data points from the same subject and even from the same trial. The impact this will have on the results is potentially limited" ] ;
            oa:hasTarget <urn:slr:article:51915c87b5e5> ;
