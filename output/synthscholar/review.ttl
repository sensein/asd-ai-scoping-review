    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "All 55 recruited participants appear in the analyses and the two classification tables account for every subject, but no enrolment-to-analysis flow, exclusions or missing data are described." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "Control status is rigorously established by dual validated screening with stated thresholds, but the clinical labels rest on unspecified prior diagnoses with no instrument, criteria or date reported." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Greedy forward feature selection over a feature vector of six families across 12 segments against 55 subjects, with no statement that selection was recomputed within the leave-one-subject-out folds; perfect recall on both majority classes (37/37 and 22/22) is the signature of exactly this leak." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
