        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "Some studies suggested reduced IMC in ASD, while others either reported a complex profile of IMC or no significant group differences in IMC during conversations. Variations in participant characteristics, tasks, and analytical approaches across studies might contribute to discrepancies" ] ;
            oa:hasTarget <urn:slr:article:12accba36eb4> ;
