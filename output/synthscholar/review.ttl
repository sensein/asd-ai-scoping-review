<urn:slr:article:06efef346587> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Frontiers in Psychology 01 frontiersin.org A deep learning latent variable model to identify children with autism through motor abnormalities Nicola Milano 1†, Roberta Simeoli 1,2*†, Angelo Rega 1,2 and Davide Marocco 1 1 Department of Humanistic Studies, University of Naples Federico II, Napoli, Italy, 2 Neapolisanit S.R.L. Rehabilitation Center, Ottaviano, Italy" ;
    dcterms:bibliographicCitation "Milano N; Simeoli R; Rega A; Marocco D (2023). A deep learning latent variable model to identify children with autism through motor abnormalities. *Frontiers in Psychology, 14, Article 1194760*." ;
    dcterms:creator "Marocco D",
        "Milano N",
        "Rega A",
        "Simeoli R" ;
    dcterms:title "A deep learning latent variable model to identify children with autism through motor abnormalities" ;
    bibo:pmid "local_a22f97df" ;
    fabio:hasPublicationYear 2023 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Confounder control" ;
                            slr:justification "Age is roughly matched (7 +/- 1.4 versus 6y8m +/- 1) with no test reported. IQ is reported only as ranges, is asymmetric, and is not adjusted for despite the task being a cognitive test and the analysis being restricted to correct trials. Sex is neither matched nor reported. Most specifically, the autistic group was undergoing psychomotor therapy at the recruiting centre while controls were not - a motor-training difference confounded with diagnosis in a study measuring motor kinematics." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Participant selection and spectrum representativeness" ;
                            slr:justification "Thirty autistic children from a single rehabilitation centre, comorbidity excluded by design, IQ 59-109, ages 5-10, sex unreported. Excluding comorbidity removes the substantial fraction of autistic children who present with ADHD, anxiety or language disorder, so the modelled population is narrower than the clinical one. No severity data means representativeness cannot be assessed at all." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Comparison group adequacy" ;
                            slr:justification "Typically developing schoolchildren only. No developmental delay, ADHD, motor disorder or language disorder group, so the study cannot address whether the kinematic signature is autism-specific or a general marker of atypical development - a particular concern given that six autistic participants have IQ below the control group's floor." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Handling of missing data and attrition" ;
                            slr:justification "No attrition is reported among the 60 children and all appear in the analysis. But only correctly performed tasks were retained, and neither per-group error rates nor per-child retained-trajectory counts are given, so an unmeasured and plausibly group-dependent amount of data was removed." ;
                            slr:rating "Unclear" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Index test definition and prespecification" ;
                            slr:justification "Latent dimensionality chosen by PCA on a latent space fitted to all the data; class-conditional Gaussians used for inference and proposed as clinical thresholds fitted to all 1,500 observations; no prespecified operating point or threshold." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Measurement standardisation" ;
                            slr:justification "Identical tablet and software for every child, fixed seating geometry (table 65-70 cm, tablet within 20 cm of the edge, examiner opposite), 40 Hz logging, and instructions delivered according to the Leiter-3 manual with gesture guides and no vocal aid. Acquisition does not differ by group, which removes the recording-chain confound that undermines several other studies charted here." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Outcome measurement blinding" ;
                            slr:justification "Feature extraction and modelling are fully automated from logged coordinates; no human rating enters the measurement pipeline. The examiner administering the task was presumably not blind to group, but the examiner does not score anything." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Reference standard quality" ;
                            slr:justification "DSM-5 plus ADOS-2 by qualified clinicians for the autism group, with comorbidity excluded; controls excluded for suspected autism signs, developmental abnormality or psychiatric/neurological history, plus exclusion of any child about whom a clinician or teacher was uncertain. Among the strongest in this corpus, weakened only by the non-reporting of ADOS-2 scores and the absence of a screening instrument for controls." ;
                            slr:rating "Low" ] ;
                    slr:overall_concern "unclear" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Sample size adequacy for the modelling" ;
                            slr:justification "Sixty children for a deep generative model plus predictor. The 1,500-row dataset gives an appearance of adequate sample that the 60 independent units do not support, and the paper itself attributes its need for supervised training to 'the sample size and its characteristics'." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Data splitting and leakage control" ;
                            slr:justification "The dataset is explicitly 60 children x 25 tasks = 1,500 observations, and 10-fold cross-validation is applied to those observations with no statement that a child's rows were kept together. Each test row therefore has ~22-23 same-child siblings in training. Kinematic profiles are close to individual motor signatures, so the model can separate children rather than groups." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Preprocessing and feature selection nesting" ;
                            slr:justification "All 12 features are used, so no feature selection occurs, but the two decisions that shape the representation - reducing the latent space from 10 to 2 dimensions via PCA, and fitting the class-conditional bivariate Gaussians - were both made on the complete dataset rather than within training folds." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Performance estimation and chance level" ;
                            slr:justification "Accuracy is the only metric: no sensitivity, specificity, precision, F1, AUC or confusion matrix, so the error profile is unknown. The +/- 5.6% is a fold standard deviation, not a confidence interval, and carries little meaning under observation-level folds. Chance is unambiguously 50% given the balanced design, but no baseline or permutation test is reported, and no participant-level accuracy is computed despite the participant-level latent plot being presented." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Reporting of results and uncertainty" ;
                            slr:justification "One number for the entire classification result, with no class-conditional metrics, no confusion matrix, no AUC and no confidence interval. The participant-level accuracy that the paper's own Figure 3 invites is never computed. Feature effects from the Monte Carlo analysis are presented graphically without effect sizes or uncertainty." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Completeness of methods reporting" ;
                            slr:justification "Task, hardware, capture rate, seating, all 12 feature definitions, the extraction package and the full three-term loss with its weighting are specified precisely. The network itself is not: no layer widths, optimiser, learning rate, batch size, epochs, seeds or code, despite two pages of textbook exposition on what neural networks are. The fold-assignment procedure is not described." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Acknowledgement of limitations" ;
                            slr:justification "A single stated limitation, and a conceptual one: that supervision was needed so the model still depends on traditional assessment for ground truth. Nothing about the observation-level cross-validation, the single-metric reporting, the in-sample fitting of the latent structure and class densities, the restriction to correct trials, the IQ asymmetry, the unreported sex distribution, or the psychomotor-therapy confound." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Ethics, consent and conflicts" ;
                            slr:justification "Approved by the Ethical Committee of Psychological Research of the Department of Humanities, University of Naples Federico II, with written informed consent from legal guardians. The conflict-of-interest statement discloses that two authors were employed by the rehabilitation centre that supplied the autistic participants - material and correctly declared. Funding is not reported." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Data, code and protocol availability" ;
                            slr:justification "Raw data offered by the authors without undue reservation - a real if informal commitment. No code, no preregistration, no analysis plan, and no deposited dataset." ;
                            slr:rating "Unclear" ] ;
                    slr:overall_concern "high" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Author keywords: machine learning, autism spectrum disorder, ASD, motor abnormalities, deep learning, early detection, diagnosis. Unusually, both 'early detection' and 'diagnosis' appear, which is a stronger clinical claim than the paper's own discussion supports - the text positions the method as supplying 'additional indicators of disorder or suspected diagnosis' and supporting clinicians rather than diagnosing. 'Motor abnormalities' is the theoretical stake, asserting that motor difference is a hallmark rather than an incidental correlate. Terms carried through the body: variational autoencoder, latent variable model, latent space, generative model, kinematics, touch-based functions, trajectory, straightness, directional change, embodied cognition, predictive coding, threshold values." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-097" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "'Children with autism', 'autism spectrum disorder (ASD)', 'ASD group', 'typically developing (TD) group'. Person-first phrasing predominates but slips into group-as-noun usage in the results and discussion ('classify ASD and TD individuals', 'ASD trajectories', 'the ASD one'). The framing is firmly medical: autism is 'a by-birth neurodevelopmental disorder', characterised by 'communication and social impairment and restricted, repetitive, and stereotyped behaviours', and the target construct is 'motor abnormalities' throughout - abnormality rather than difference. One usage requires comment: the six autistic children with IQ 59-70 are described as having 'mild mental retardation', with the WHO (2016) cited as the source of the classification. That terminology is outdated in English-language practice, where intellectual disability is standard, and its appearance in a 2023 paper is worth noting even allowing for translation from Italian and for the cited WHO/ICD source. There is no neurodiversity framing and no autistic-community involvement statement, though the stated purpose - to give clinicians objective quantitative indicators to supplement a process the authors criticise as subjective and examiner-dependent - is a clinician-support rather than a replacement agenda." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-097" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Goal: to move beyond descriptive comparison of touchscreen motion features - which the group's own earlier work (Simeoli et al., 2020) had found insufficient to distinguish the groups significantly - by using a variational autoencoder to learn a low-dimensional latent distribution of movement, and then to interrogate that latent space to identify which kinematic features drive classification and at what values. The framing is explicitly dual: not merely a diagnostic classifier but 'a new quantitative method to assess ASD', with the theoretical grounding in embodied cognition and predictive coding and the claim that motor abnormality is an underrated defining feature of autism. Findings: task-level cross-validated accuracy 91.2% +/- 5.6%; a latent space in which the two groups occupy distinct, approximately Gaussian regions, with cleaner separation when participants are plotted as the mean of their 25 tasks than task by task; latent structure stable across initialisations up to rotation; and, from Monte Carlo perturbation of one feature at a time, the finding that sdSpeed, MaxAcceleration, MinAcceleration and sdAcceleration have the largest capacity to move a participant across the latent space and reverse their classification, while sdDC, MeanSpeed, MaxSpeed and MeanLength map preferentially into the TD region and are judged marginal. The fitted class densities give signed rules - higher MaxAcceleration and sdAcceleration, and lower MaxSpeed and MinAcceleration, increase the probability of ASD assignment - which the authors offer to clinicians as candidate threshold values." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-097" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The best interpretability work in this corpus, and it is not an add-on but the paper's purpose. Three techniques are layered. First, the latent space is made analytically tractable by construction: the VAE's KL term drives it towards a diagonal Gaussian, so two-dimensional class-conditional Gaussians can be fitted to the ASD and TD point clouds and a genuine probability density function evaluated for any point rather than a black-box score. Second, feature influence is measured causally within the model rather than by correlation: for each participant, each of the 12 features is resampled 100 times from a Gaussian while the other 11 are held fixed, and the resulting displacement of that participant's latent projection is tracked, identifying not only which features move a subject but at which values the class assignment flips. Figure 5 aggregates this into per-feature density maps over the latent space and Figure 6 into class-probability curves against raw feature values. Third, the outputs are expressed in clinically usable form: signed, feature-specific rules (higher MaxAcceleration and sdAcceleration, lower MaxSpeed and MinAcceleration increase ASD probability) explicitly offered as candidate threshold values for joint use by clinicians. The design also embeds an interpretability-motivated safety property, replacing the predictor with density evaluation at inference so a participant in an unpopulated region is not confidently misassigned. The caveats are that no uncertainty is attached to any of these feature effects, no group-level statistics on the features themselves are reported (the earlier descriptive paper failed to find significant differences, which is the stated motivation for this analysis), and the whole latent geometry was learned on data containing the test observations, so the thresholds are in-sample." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-097" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A variational autoencoder with an attached supervised predictor - the only VAE in this corpus and one of few genuinely generative models here. The encoder maps the 12 features to the parameters (mean and standard deviation) of a diagonal Gaussian latent distribution; a latent vector is sampled and passed both to a symmetric decoder that reconstructs the input and to a predictor MLP with a tanh intermediate layer and a softmax output over the two classes. The composite loss has three equally weighted terms: mean squared reconstruction error, the Kullback-Leibler divergence between the learned latent distribution and a zero-mean unit-variance diagonal Gaussian, and binary cross-entropy on the prediction. The architectural rationale is stated clearly and is the paper's conceptual contribution: the KL regularisation forces a well-behaved latent geometry, and the predictor loss forces the two classes into separable regions of it, because if the class-conditional latent distributions overlap too much the stochastic sampling makes the prediction loss stagnate. The result is a latent space in which classification and generative description coexist. At inference the predictor is then set aside in favour of two fitted bivariate Gaussians over the latent points, on the explicit grounds that density-based assignment is more conservative for inputs that land in unvisited regions - a deliberate outlier-aware design choice that is unusual and clinically sensible." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-097" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Published 2023 from the Department of Humanistic Studies, University of Naples Federico II, in collaboration with the Neapolisanit S.R.L. Rehabilitation Center, where two of the four authors were employed and from which the autistic participants were recruited - disclosed appropriately in the competing-interests statement. No funding is reported. The framing is a critique of existing assessment: the authors list four specific constraints of gold-standard tools - no explicit sensory-functioning assessment, dependence on examiner expertise and subjective evaluation, limited ecological validity, and the time demanded - and position quantitative motor measurement as the remedy. The paper is explicitly a second pass at the group's own earlier dataset, whose descriptive analysis had failed to separate the groups significantly, which makes it an unusually transparent instance of a common pattern in this corpus: conventional statistics find nothing, a deep model is applied to the same data, and separation appears. The stated ambition is to move eventually to unsupervised latent organisation so that the model no longer depends on clinical labels for ground truth - a 2023-era aspiration that the paper's own sample size prevents it from testing." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-097" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A tablet reimplementation, built in Unity and C#, of five subtests of the Leiter-3 Cognitive Battery, administered following the original test's instruction procedure with the examiner switching between subtests as the manual prescribes. Each scene shows up to five draggable cards at the bottom and up to eight placeholders at the top that capture cards dragged nearby, with distracting stimuli and image detail increasing across five difficulty levels; each child completed 25 tasks, five per level. Instructions were delivered by pointing and gesture without vocal aid, after which the child worked unaided. The design has real strengths: it is a standardised, clinically meaningful task rather than an ad hoc game, it varies difficulty systematically, and it captures fine motor behaviour as a by-product of a cognitive assessment the child would plausibly undergo anyway - which is the most translationally attractive property of the whole approach, since it means no additional testing burden. Two design decisions constrain interpretation. A task counted as complete when all cards had been placed regardless of correctness, but only correctly performed tasks were analysed 'to avoid the noise of the cognitive mistakes for the classification process'. This conditions the analysed sample on cognitive success and, if the groups differ in error rate - which is likely given the IQ ranges and six autistic children below the TD floor - removes trials differentially by group, changing what the retained trajectories represent. No error rates per group are reported, so the size of this effect cannot be assessed. And features are averaged to task level, so within-task temporal structure and trial-to-trial variability, both plausibly informative about motor control, are discarded before modelling." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-097" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Twelve hand-crafted scalar features per task observation: four speed statistics (mean, max, min, SD), four acceleration statistics (mean, max, min, SD), and four path-geometry descriptors (STH straightness, DC directional change, sdDC directional-change variability, MeanLength). Features are computed per trajectory - one dragging movement from first tap to finger lift - using the R traj package, then averaged across the trajectories within a task, giving one 12-vector per child per task and 1,500 rows overall. The 40 Hz raw coordinate stream is therefore reduced twice before the network sees anything: once to per-trajectory summary statistics, once again by averaging across trajectories. No sequence model, no raw-signal input, no learned front end, and no representation of within-task variability across trajectories except through the SD features. The bottleneck is 10 latent dimensions at training, reduced to 2 for analysis after PCA showed the first two components carried 95% of the latent variance - so the effective representation of a child's movement on a task is a point in a plane." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-097" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Four directions. Enlarge the dataset in both size and feature relevance so that the latent space organises without supervision, which is the authors' stated ambition and would remove their reliance on clinical labels as ground truth. Generate as many candidate features as possible so a globally optimal feature set for autism identification can be determined, citing Zhao et al. (2021). Collect more clinical data so the latent space is more densely covered and new participants are less likely to fall into unvisited regions - a coverage argument that follows directly from their decision to classify by fitted density rather than by the predictor network. And combine these kinematic measures with traditional behavioural and cognitive scales into a multimodal risk indicator supporting clinicians rather than replacing them. Absent from the list, and more pressing than any of these, are participant-level validation, an independent cohort, a clinical comparison group, and test-retest reliability for the features proposed as clinical thresholds." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-097" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Among the better-specified in this corpus. Autism required satisfaction of two independent criteria - DSM-5 clinical criteria and the ADOS-2 - with diagnoses made by 'qualified doctors and professionals in the sector', and the absence of comorbidity was an explicit inclusion requirement. This is a dual-criterion standard including a gold-standard observational instrument, which places it above the single-clinician, registry-label or unspecified approaches seen elsewhere here. Typically developing status was established negatively rather than by instrument: no confirmed neurodevelopmental disorder, no suspected signs of autism, no developmental abnormality, no psychiatric or neurological history, plus an unusual and sensible catch-all whereby 'any child whose clinician or teacher was uncertain about the child's diagnosis or health was excluded'. That conservative rule reduces the risk of undetected autistic traits in the control group, though no screening instrument (SCQ, SRS, CAST) was administered to confirm it. Three details limit the standard's usefulness. The ADOS-2 module, algorithm scores and comparison scores are never reported, so the instrument is used as a gate and then discarded as data. Diagnosing clinicians are described only generically. And there is no statement of the interval between diagnosis and testing." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-097" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Split, in the same pattern as several engineering-led studies in this corpus. Reproducible: the tablet specification, the 40 Hz sampling, the seating and table geometry, the five Leiter-3 subtests and 25-task structure, the definition of a trajectory (first tap to finger lift), all 12 features with their formulas or plain definitions in Table 1, the extraction package, and the three-term VAE loss written out in full with the equal weighting stated. Not reproducible: the network architecture and every training hyperparameter, the fold assignment procedure, random seeds, the Monte Carlo perturbation's sampling distribution parameters beyond 'N(mu_fi, sigma_fi)', and any code. Raw data are offered on request without undue reservation, which is a genuine commitment though weaker than deposition. The paper also reports no participant-level accuracy despite plotting participant-level latent means, so the single most useful number for a reader wanting to compare against other studies is absent." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-097" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Partial. Reported: group sizes (30/30), mean and SD of age per group (7 +/- 1.4 versus 6 years 8 months +/- 1), age range 5-10, and IQ ranges per group from the Leiter-3 (ASD 59-109, TD 74-110), with the note that six autistic children scored between 59 and 70 and that no severe or profound impairment was present. Recruitment source is given for both groups. Not reported: sex distribution for either group - a striking omission in a 60-child study where sex ratio is both clinically salient and trivially available; race or ethnicity; socioeconomic status; parental education; language level; medication; and any positive comorbidity data, since comorbidity was an exclusion criterion. Two features of what is reported deserve emphasis. First, IQ is given only as a range, with no mean or SD, so the distributions cannot be compared - yet the ranges are visibly asymmetric and six autistic children sit below the TD group's floor of 74, which matters because the index task is a reimplementation of a cognitive test and the analysis is restricted to correctly performed trials. Second, the two groups differ systematically in more than diagnosis: the autistic children were recruited from a rehabilitation centre and were actively receiving psychomotor therapy, i.e. motor intervention, while the controls came from a mainstream school, so exposure to motor training is confounded with group membership in a study whose outcome is motor kinematics." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-097" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Hardware and capture: an Android 6.0 tablet, 241.9 x 149.5 x 8.5 mm with a 9.6 inch 1280 x 800 screen at 60 Hz refresh, running custom software written in Unity and C# that logged finger position at 40 Hz. Cognitive assessment: Leiter-3 International Performance Scale. Feature extraction: RStudio with the traj package, citing Leffondree et al. (2004) and Sylvestre et al. (2006) - a specific, checkable toolchain. Modelling software is not named at all: no TensorFlow, PyTorch, Keras or equivalent, and no architecture details beyond 'a simple multilayer perceptron' predictor with a tanh intermediate layer and softmax output. The imbalance in the Methods is conspicuous - roughly two pages explain what a feed-forward neural network and backpropagation are, at textbook level, while the actual network used in the experiments has no stated layer sizes, learning rate, optimiser, batch size or epoch count." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-097" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Fine motor control during goal-directed touchscreen dragging - specifically the kinematic profile of moving a finger from a card to a target placeholder, characterised along three dimensions. Speed: mean, maximum, minimum and standard deviation. Acceleration: mean, maximum, minimum and standard deviation. Path geometry: STH (straightness, the ratio of start-to-end distance to actual path length, an index of linearity), DC (directional change over time, an index of nonlinearity), sdDC (its standard deviation, a measure of irregularity), and MeanLength (the number of finite trajectories drawn per task). The behavioural hypothesis, grounded in embodied cognition and predictive coding, is that impaired active perception in autism produces abnormalities in planning and in serial and prospective coordination, which should surface as measurably different movement kinematics even in a simple drag. The group's earlier descriptive work had found autistic trajectories to show low linearity, high maximum speed and acceleration, and low minimum speed and acceleration, but without significant group separation; the present analysis partly reverses the speed direction, finding that lower MaxSpeed increases ASD probability while higher MaxAcceleration does. Note what is not modelled: no social behaviour, no gaze, no language, no gross motor activity - this is one of the most narrowly motoric behavioural targets in the corpus, and deliberately so." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-097" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The stated limitation is real but tangential: that supervision was required at the outset, so the ground truth still comes from traditional assessment, whereas an ideal VAE application would organise the latent space unsupervised. The unstated limitations are more consequential. The decisive one is the validation unit. The dataset is described unambiguously as 1,500 x 12 observations built from 60 children x 25 tasks, and 10-fold cross-validation is applied to those observations. Nothing indicates that a child's 25 rows were kept together, so in a standard k-fold split roughly 22-23 of each test observation's sibling rows - same child, same hand, same session, adjacent difficulty levels - are in the training set. A model with a 12-dimensional input and a 2-dimensional latent bottleneck can readily encode a child's individual motor signature, and the reported 91.2% is therefore substantially a measure of within-child consistency rather than of between-child generalisation. The tell is in the paper's own figures: Figure 3, which averages a participant's 25 tasks to a single point, shows cleaner separation than the task-level Figure 2, yet no accuracy is computed at that level, which is exactly the number a participant-disjoint evaluation would produce. Beyond validation: accuracy is the only metric reported, with no sensitivity, specificity, AUC or confusion matrix; the reduction from 10 to 2 latent dimensions was chosen by PCA on a latent space fitted to all the data; the analysis is restricted to correctly performed tasks, conditioning on cognitive success in a way that plausibly differs by group and is never quantified; IQ ranges are asymmetric with six autistic children below the TD floor and no means, SDs or test reported; sex is not reported at all; and the autistic group was in active psychomotor therapy while controls were not, confounding motor training with diagnosis in a study of motor kinematics." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-097" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two groups of 30, total 60 children aged 5-10 years. ASD group: 30 children, mean age 7 years +/- 1.4, recruited from the Neapolisanit S.R.L. Rehabilitation Center where they were receiving psychomotor and speech therapy, all diagnosed under both DSM-5 criteria and ADOS-2, with no existing comorbidities as an inclusion requirement. TD group: 30 children, mean age 6 years 8 months +/- 1, recruited from a primary school, with no confirmed neurodevelopmental disorder and excluded for suspected autism signs, developmental abnormalities, or any current or past psychiatric or neurological history. All 60 had normal vision and no sensory or motor deficits, and any child about whom a clinician or teacher was uncertain was excluded. No attrition or exclusions after enrolment are reported. The modelled dataset, however, is not 60 rows but 1,500: each child contributed 25 task observations (five tasks at each of five difficulty levels), and it is these observations, not the children, that are the unit of the reported cross-validation." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-097" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cognitive ability was measured in every participant with the Leiter-3 International Performance Scale, a non-verbal instrument appropriate for this population, and reported as a per-group range (ASD 59-109, TD 74-110) with the six autistic children in the 59-70 band identified. No means, SDs or statistical comparison are given. Autism severity was not measured or reported at all: ADOS-2 was administered for diagnosis but no severity, comparison or algorithm score is carried into the paper, so the position of these 30 children on the spectrum is unknown, no analysis relates model output to symptom severity, and it cannot be checked whether the model succeeds preferentially on more affected children. No language, adaptive-functioning or motor-competence measure was obtained, the last being a notable gap in a study whose entire signal is motor. There is also a structural entanglement peculiar to this design: the Leiter-3 serves simultaneously as the cognitive measure and, in tablet form, as the experimental task, so the kinematic features are recorded while children perform the very test used to characterise their cognitive ability, and only trials they completed correctly are analysed. Cognitive ability is therefore not an independent covariate here - it conditions which trajectories exist in the dataset." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-097" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Frontiers in Psychology 14, article 1194760, Original Research, in a psychology rather than an engineering or clinical venue - which shows in the structure. Roughly two pages of the Methods are a textbook exposition of artificial neural networks and backpropagation aimed at a psychology readership, while the network actually used has no reported layer widths, learning rate, optimiser or epoch count; conversely the theoretical framing in embodied cognition and predictive coding is developed at length. Editorial and review handling is disclosed by name, as Frontiers requires. Received 27 March 2023, accepted 21 April 2023, published 18 May 2023 - a 25-day review turnaround - under CC BY." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-097" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None - a single modality with 12 features from one sensor stream. The study is nonetheless relevant to the fusion question in two ways. First, the authors' explicit future direction is to combine these kinematic measures with 'the traditional behavioural and cognitive scale' into a multimodal risk measure - a clinician-facing rather than sensor-facing conception of fusion, in which the computational signal supplements standardised assessment rather than being fused with another sensor. Second, and more interestingly, the design already contains an implicit two-channel structure that goes unexploited: the tablet records both what the child does cognitively (which cards go where, and whether the answer is correct) and how the child moves while doing it. The paper deliberately discards the first channel, analysing only correctly performed tasks so that cognitive errors do not contaminate the motor signal. Since Leiter-3 performance is itself diagnostically informative and the two groups' IQ ranges differ, the discarded channel is not noise but a second modality that the design chose to suppress rather than fuse." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-097" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The critical weakness, and it is unacknowledged. The dataset is stated plainly: 60 participants x 25 tasks = 1,500 observations of 12 features, with a parallel 1,500-element label vector repeating each child's diagnosis 25 times. Cross-validation is 10-fold over that observation set, giving 91.2% +/- 5.6%. There is no statement that a child's 25 rows were assigned to a single fold, and the description ('we used the k-fold cross-validation with k = 10 and returning the average accuracy', applied to 'the collected dataset') implies observation-level partitioning. Under that scheme every test observation has roughly 22-23 siblings from the same child, same session and same hand in the training data, differing only in Leiter-3 subtest and difficulty level. Movement kinematics are strongly individual - speed and acceleration profiles are close to a motor signature - so a 12-input, 2-latent model can separate children rather than groups and score highly, exactly the leakage Keles et al. quantified directly elsewhere in this corpus by identifying individuals from behaviour at many times chance. Two internal signals support this reading: the authors themselves note that the clustering is 'even more evident' when participants are plotted as the mean of their tasks than task by task, which is what one expects when within-child consistency is high; and they never compute the participant-level accuracy that this observation invites. Secondary issues compound it. The choice of two latent dimensions was made from PCA on a latent space learned from the entire dataset. The class-conditional Gaussians used for the interpretability analysis and proposed as clinical thresholds are fitted to all 1,500 points. Only accuracy is reported. And the balanced 50/50 design, while making chance interpretable, is 25-50 times the population prevalence at which the proposed screening support would operate. The corrective is straightforward and would be a genuinely valuable result: split the 60 children into folds, train on one set of children and test on unseen children, report participant-level sensitivity and specificity as well as accuracy, and refit the latent Gaussians within training folds only. Given 60 children and a well-specified reference standard including ADOS-2, that study is within reach of this dataset." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-097" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two sites in Campania, Italy, and the pairing is itself a confound. Autistic children came from the Neapolisanit S.R.L. Rehabilitation Center, which is also the employer of two of the four authors, and were undergoing psychomotor and speech therapy there. Typically developing children came from a mainstream primary school. Testing conditions were standardised across both groups - the same tablet, a table 65-70 cm high with the tablet within 20 cm of the edge, the examiner seated opposite, the same instruction protocol - so the acquisition chain does not differ by group in the way it does in some other studies in this corpus. But the recruitment geometry is the classic case-control one at 50% prevalence, and it carries a specific extra risk here: the autistic group's ongoing psychomotor therapy is an intervention directed precisely at the motor system whose kinematics constitute the study's entire feature set. Whether that therapy makes autistic movement more or less like typical movement, it makes the two groups differ in motor training history as well as in diagnosis." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-097" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Accuracy alone: 91.2% +/- 5.6% across 10 folds. This is the thinnest metric reporting of any study charted in this review that reports a headline number at all. There is no sensitivity, no specificity, no precision or recall, no F1, no AUC or ROC curve, no confusion matrix, and no per-class breakdown, so it is impossible to tell whether errors fall preferentially on autistic or typically developing observations - which is precisely the information a clinician evaluating a screening aid needs. The +/- 5.6% is a fold standard deviation, not a confidence interval, and with observation-level folds it does not carry the meaning it would under participant-level splitting. There is also no participant-level accuracy at all, despite Figure 3 plotting exactly the per-participant aggregation that would yield one, and despite the paper's own observation that the separation is clearer at that level. The balanced design (750 versus 750) at least makes 50% the unambiguous chance floor, so no prevalence adjustment is needed to read the number - but nor is any positive or negative predictive value offered for the screening use the discussion proposes." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-097" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional, single session, no follow-up, no test-retest reliability for any kinematic feature - which matters for a proposal to use feature values as clinical thresholds, since a threshold is only useful if the measurement is stable within a child across occasions. Ethics reporting is complete and appropriate: the study was reviewed and approved by the Ethical Committee of Psychological Research of the Department of Humanities, University of Naples Federico II, and written informed consent was obtained from participants' legal guardians. The conflict-of-interest statement discloses that two authors were employed by Neapolisanit S.R.L., the rehabilitation centre from which the autistic participants were recruited - a material disclosure, correctly made. Funding is not reported." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-097" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:study_design "Cross-sectional two-group diagnostic-classification study; a new modelling analysis of a dataset the same group collected and previously described descriptively (Simeoli et al., 20…" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: ; comparison: 30" ] ] ;
    slr:content_sha256 "65eae6e792aff63d4c426d1a0a81648c093b158352d448d61524c2606ee41b5a" ;
    slr:full_text_artifact [ a slr:StoredArtifact ;
            prov:wasDerivedFrom <urn:slr:article:06efef346587> ;
