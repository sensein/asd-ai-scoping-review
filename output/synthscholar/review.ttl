    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "No train-test split, cross-validation scheme or partitioning unit is stated anywhere. With 17 participants the reported 89-94% must derive from epoch-level evaluation, and with four controls a participant-disjoint arrangement is barely constructible; the number and distribution of segments are not reported." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "The acquisition chain is fully specified - 16-channel g.tec montage with named electrode positions, ground and reference, 0.1-60 Hz bandpass with 60 Hz notch, 256 Hz sampling - and both groups were recorded on the same equipment under the same resting protocol, so no acquisition asymmetry arises. But no artefact rejection is described, the eleven features are not individually identified, and medication effects on EEG are unrecorded." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "No diagnostic instrument, criteria, clinician qualification or date is described for the autistic group, and no screening procedure for the four comparison children; the labels are inherited from the source corpus with none of its documentation transmitted." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Seventeen participants - 13 autistic and 4 typically developing boys - with a comparison group too small to characterise typical EEG variation, no age distribution by group across a 9-to-16 window in which EEG spectra change substantially, no cognitive, comorbidity or medication information, and an all-male sample." ] ;
            slr:overall_judgment "high" ;
            slr:tool_used "QUADAS-2" ] .

<urn:slr:article:3c2b7ea0e8c0> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "With the increasing prevalence of Autism Spectrum Disorders (ASD), very early detection has become a key priority research topic, as early interventions can increase the chances of success. Since atypical communication is a hallmark of ASD, automated acoustic-prosodic analyses have received prominent attention. Existing studies, however, have focused on verbal children, typically over the age of three (when many children may be reliably diagnosed) and as high as early teens. Here, an acoustic-prosodic analysis of pre-verbal vocalizations (e.g., babbles, cries) of 18-month old toddlers is performed. Data was obtained from a prospective longitudinal study looking at high-risk siblings of children with ASD who were also diagnosed with ASD, as well as low-risk age-matched typically developing controls. Several acousticprosodic features were extracted and used to train support vector machine and probabilistic neural network classiﬁers; classiﬁcation accuracy as high as 97% was obtained. Our ﬁndings suggest that markers of autism may be present in pre-verbal vocalizations of 18-month old toddlers, thus may be used to assist clinicians with very early detection of ASD." ;
    dcterms:bibliographicCitation "Santos JF; Brosh N; Falk TH; Zwaigenbaum L; Bryson SE; Roberts W; Smith IM; Szatmari P; Brian JA (2013). Very early detection of Autism Spectrum Disorders based on acoustic analysis of pre-verbal vocalizations of 18-month old toddlers. **." ;
    dcterms:creator "Brian JA",
        "Brosh N",
        "Bryson SE",
        "Falk TH",
        "Roberts W",
        "Santos JF",
        "Smith IM",
        "Szatmari P",
        "Zwaigenbaum L" ;
    dcterms:title "Very early detection of Autism Spectrum Disorders based on acoustic analysis of pre-verbal vocalizations of 18-month old toddlers" ;
    bibo:pmid "local_76fc33d0" ;
    fabio:hasPublicationYear 2013 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are comparison groups matched?" ;
                            slr:justification "Age-matched explicitly; gender similar but matching not claimed." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the sample appropriate for the stated screening target?" ;
                            slr:justification "High-risk siblings, not a general screening population; n=43 is very small for a diagnostic claim." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are participants and recruitment adequately described?" ;
                            slr:justification "Group sizes, sex ratios and ages given in Table 1; cohort provenance described." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the behavioral data acquisition described reproducibly?" ;
                            slr:justification "Recording, segmentation thresholds, sampling rates and the full feature list are specified." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the reference standard appropriate and independently applied?" ;
                            slr:justification "Blinded clinician diagnosis at 36 months using ADOS and ADI-R." ;
                            slr:rating "Yes" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are predictors defined without knowledge of outcome?" ;
                            slr:justification "Acoustic features are computed automatically and are outcome-independent." ;
                            slr:rating "Yes" ] ;
                    slr:overall_concern "low" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Is the validation scheme free of leakage?" ;
                            slr:justification "Instance-level cross-validation over 4522 vocalisations from 43 children with no stated subject-independent split." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is model selection separated from performance estimation?" ;
                            slr:justification "Grid search and LOO used for hyperparameters, but on the same data as the reported 10-fold results." ;
                            slr:rating "Partly" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the sample size adequate for the number of features?" ;
                            slr:justification "Dozens of features with statistics across three combinations against 43 participants." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is there external or independent validation?" ;
                            slr:justification "None reported." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Are sample bias and imbalance discussed?" ;
                            slr:justification "Only the absence of non-ASD language-disorder toddlers is acknowledged." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Are ethics, consent and privacy handling reported?" ;
                            slr:justification "Funding and family thanks only; no consent or data-protection statement despite identifiable audio/video." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is the dataset accessible or its access conditions stated?" ;
                            slr:justification "No data availability statement." ;
                            slr:rating "No" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Is code or an implementation available?" ;
                            slr:justification "None; DTREG and VoiceSauce named but no scripts or parameters released." ;
                            slr:rating "No" ] ;
                    slr:overall_concern "high" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Clinic setting (videotaped ADOS assessments). Existing data: a subset of the ongoing Canadian Infant Sibling Study database, analysed retrospectively." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-001" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Hardware: video recording of ADOS sessions (audio at 44 kHz, downsampled to 16 kHz). Software: VoiceSauce (UCLA SPAP Laboratory), in-house MATLAB scripts, DTREG for classifier training and evaluation." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-001" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "ASD group (n=23, high-risk siblings later diagnosed) and typically developing low-risk controls (n=20); both explicitly reported with sizes in Table 1. No other-diagnosis group." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-001" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Feature importance from the classifiers' inherent selection (DTREG). Most informative: vocal-quality measures H1*-A3* (selected by both classifiers) and H4, H1 variability, F0 range, shimmer, energy, jitter, A2." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-001" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2013 - the earliest study in this corpus. The paper characterises the field as having focused on verbal children over age three and positions itself as pushing the age range down to 18 months; it does not otherwise analyse field-level trends." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-001" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Accuracy, sensitivity, specificity, AUC. Headline: 97.7% / 95.6% / 100.0% / 0.97 (PNN, FC3)." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-001" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "ICASSP 2013 (IEEE International Conference on Acoustics, Speech and Signal Processing) - a technology/computational (signal-processing) venue, not an autism or clinical venue." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-001" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Speech/voice: pre-verbal vocalisations (babble, cry, squeal, laugh, whine, yell, single words) - acoustic and prosodic properties, not linguistic content." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-001" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Supervised learning. Algorithms: support vector machine with RBF kernel, and probabilistic neural network (Parzen-window Bayes network)." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-001" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Index terms: Autism, biomarker, prosody, SVM, PNN. Task vocabulary: 'very early detection', 'automated acoustic-prosodic analysis', 'markers of autism', 'assist clinicians with very early diagnosis'." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-001" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No dataset access statement; the Infant Sibling Database is a restricted clinical cohort. No code availability, no seeds, no hyperparameter table; feature set and classifier settings are described narratively only. Not reproducible as reported." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-001" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Goal: very early detection (screening) as binary ASD vs TD classification at 18 months. Main finding: PNN reached 97.7% accuracy / 95.6% sensitivity / 100% specificity (AUC 0.97), outperforming SVM by up to 55.6% relative accuracy, indicating ASD markers are present in pre-verbal vocalisations." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-001" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Standardized developmental and language tests are mentioned as part of the cohort protocol but no cognitive, linguistic or adaptive scores are reported for the analysed sample. Comorbidities not described; other non-ASD language disorders explicitly absent from the sample." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-001" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Include toddlers with other non-ASD language development disorders to test specificity; extend the acoustic analysis to the 9- and 12-month assessments." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-001" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Single modality; no fusion. No combination with clinical scores or demographics." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-001" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "'children with ASD', 'toddlers with ASD', 'ASD group', 'typically developing (TD) controls', 'control', 'high-risk siblings', 'low-risk'. Person-first/diagnosis-first language throughout; no identity-first ('autistic') usage." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-001" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Blinded experienced clinician at age three using medical history, ADOS and ADI-R; ADOS Module 1 sessions also provided the recordings." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-001" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "ASD n=23, 15M/8F, age 18 +/- 0.42 months; controls n=20, 13M/7F, age 18 +/- 0.23 months. Controls explicitly described as age-matched; gender matching not claimed." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-001" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Reported/identifiable bias: very small sample (n=43); single national cohort; high-risk-sibling recruitment means the ASD group is not a general-population sample; male-skewed (28/43 male); English-speaking homes only; instance-level analysis with unequal vocalisation counts per group (2592 control vs 1930 ASD instances). Authors acknowledge only that non-ASD language-disorder toddlers were not included. Reviewer-identified: probable subject leakage in cross-validation and absence of any external validation." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-001" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "ADOS Module 1 semi-structured assessment (24-52 min), designed for preverbal children; vocalisations manually segmented/labelled into speech, babble, cry, squeal, laugh, other, then automatically re-segmented by energy thresholding." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-001" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Underlying cohort is longitudinal (from 6 months, reassessed every 3-12 months, diagnosis at 36 months) but the analysis is cross-sectional at the 18-month visit. Data are highly sensitive (video/audio of identifiable toddlers); the paper describes no anonymization, consent or data-protection procedure." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-001" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "10-fold cross-validation plus leave-one-out and grid search for hyperparameters, described as guarding against overfitting. No external or independent test set, no held-out site, no class-imbalance handling, no statistical comparison between classifiers, no deployment or real-time claim beyond 'may be used to assist clinicians'. Subject-independence of folds is not stated." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-001" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Handcrafted acoustic-prosodic features computed per 25 ms frame and summarised per vocalisation instance as mean, standard deviation and range (three nested feature combinations FC1-FC3)." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-001" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "Single 18-month assessment analysed; ADOS sessions 24-52 minutes; participants followed from 6 months with reassessment every 3-12 months and final diagnosis at 36 months" ;
                    slr:study_design "Retrospective secondary analysis of a prospective longitudinal infant-sibling cohort; cross-sectional classification at the 18-month assessment" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder (high-risk siblings later diagnosed)" ;
                    slr:sample_size_text "ASD/index: 23; comparison: 20" ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "PNN with feature combination FC3 (mean, SD, range): 97.7% accuracy, 95.6% sensitivity, 100.0% specificity, AUC 0.97. Best SVM (FC1): 79.1% accuracy, 82.6% sensitivity, 75.0% specificity, AUC 0.87",
                        "Sufficient discriminability exists in pre-verbal vocalisations of 18-month-olds to separate toddlers later diagnosed with ASD from typically developing controls; PNN outperformed SVM across all feature combinations, and vocal-quality measures (notably H1*-A3*) plus F0 range were the most discriminative features. The authors present this as the youngest age range reported in the acoustic-prosodic a" ;
                    slr:outcome "Accuracy, sensitivity, specificity, AUC" ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "PNN with feature combination FC3 (mean, SD, range): 97.7% accuracy, 95.6% sensitivity, 100.0% specificity, AUC 0.97. Best SVM (FC1): 79.1% accuracy, 82.6% sensitivity, 75.0% specificity, AUC 0.87; Sufficient discriminability exists in pre-verbal vocalisations of 18-month-olds to separate toddlers later diagnosed with ASD from typically developing controls; PNN outperformed SVM across all feature combinations, and vocal-quality measures (notably H1*-A3*) plus F0 range were the most discriminative features. The authors present this as the youngest age range reported in the acoustic-prosodic a" ] ] ;
    slr:content_sha256 "b7836323cad8de3cbf264c70bbe1778ddce9b210bb6bc54c6e4aec91abac6a18" ;
