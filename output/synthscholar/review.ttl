            slr:relevance_score "0.92"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "ResNet50 (ours) 62.13% 0.710 0.537 0.667 0.644 ... Scan-path & Saliency [27] 59.84% ... RM3ASD [40] 59.30% ... SP-ASDNet [29] 57.90%" ] ;
