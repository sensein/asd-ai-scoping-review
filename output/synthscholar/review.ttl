        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "We aligned the number of participants among all the groups using the SRS-2 scores of 16 participants (8 males and 8 females) in descending order, and the data from 15 ASD participants (9 males and 6 females) and 15 Sz participants (7 males and 8 females)." ] ;
            oa:hasTarget <https://doi.org/10.3389/fdgth.2023.952433> ;
