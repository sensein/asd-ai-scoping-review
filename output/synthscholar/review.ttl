    slr:journal "Electronics, 14(11), Article 2231" ;
    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "In the Gait dataset, one of ten walking trials per child was retained, selected 'based on the disease and the doctor's recommendation' - selection on the outcome, upstream of all modelling. Within each corpus both classes were recorded under matched conditions and the skeleton representation excludes appearance, which are genuine strengths, but the two corpora differ in sensor generation and joint coverage (25 full-body against 10 upper-body) and neither task protocol is described." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Labels inherited from both corpora with no instrument, criteria, clinician qualification or date reported for either. DREAM's three-level structure is collapsed by discarding one class, and the resulting distribution is described as biased but never quantified." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Two convenience corpora with no demographic characterisation beyond age ranges of 4 to 12 and 3 to 7 years. No age distribution by group in a domain where gait matures rapidly across that span, no sex information in a domain where gait differs by sex, and no cognitive, language or comorbidity data. The DREAM non-spectrum class was discarded, converting that experiment into a discrimination among autism-related labels." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "On the Gait dataset each child contributes exactly one sample, so cross-validation necessarily partitions children, with five complete cycles and dispersion reported - sound practice. On DREAM, 1,833 samples from 61 children were split without any participant-level partitioning described, leaving within-participant leakage unaddressed. No attrition is reported for either." ] ;
            slr:overall_judgment "high" ;
            slr:tool_used "QUADAS-2" ] .

<urn:slr:article:3dafd8b400d2> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "The incidence rate of autism spectrum disorder (ASD) has been rising in the past decades, and has reached 1 ∼ 2%. Clinical ASD screening requires long testing time, complicated doctor training and high cost. Therefore, an objective and accurate automated method is urgently needed for large-scale early screening of autistic children. The lack of response to one’s own name is one of the early warning signals of ASD. Response to name is included in various ASD early screening and diagnostic assessments. In this paper, we propose an algorithm that combines automatic name detection with human pose tracking and head pose estimation in computer vision. The final prediction is determined by the combination of shoulder rotation angle, head pose information and duration. The experimental data comes from the process of clinical screening for ASD, which has less laboratory control, more realistic child response, and a flexible number of accompanying parents. Thirty subjects including 29 children with ASD and 1 typical developing (TD) child participated in the experiment. The experimental results show that the consistency between our proposed method and clinical diagnosis achieves 93.3%, which indicates our method can play an effective auxiliary role in the early screening of ASD." ;
    dcterms:bibliographicCitation "Song C; Wang S; Chen M; Li H; Jia F; Zhao Y (2023). A multimodal discrimination method for the response to name behavior of autistic children based on human pose tracking and head pose estimation. *Displa*." ;
    dcterms:creator "Chen M",
        "Jia F",
        "Li H",
        "Song C",
        "Wang S",
        "Zhao Y" ;
    dcterms:title "A multimodal discrimination method for the response to name behavior of autistic children based on human pose tracking and head pose estimation" ;
    bibo:pmid "local_c6853fe2" ;
    fabio:hasPublicationYear 2023 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Participant selection and spectrum representativeness" ;
                            slr:justification "Thirty children from one tertiary hospital, selected only by ADOS-2 module, with a single overall mean age of 3.65 years and no age range, sex, IQ, language or severity data. Twenty-nine of thirty are autistic. Nothing can be established about which children the pipeline works for, and body proportions and postural control vary widely across the 12-month-to-5-year span the included modules cover." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Confounder control" ;
                            slr:justification "No covariates are measured, so none can be controlled. The specific uncontrolled factor that matters is postural and motor variation with age: the 90 degree shoulder threshold is applied uniformly to children who may differ by several years in development, and it is measured in 2-D image coordinates from a single uncalibrated fixed camera, so seating position and orientation relative to camera C1 confound the angle." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Comparison group adequacy" ;
                            slr:justification "One typically developing child among 30 participants. This is not a comparison group, and no between-group analysis is attempted or possible, yet the paper's framing is early autism screening throughout." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Handling of missing data and attrition" ;
                            slr:justification "No attrition is reported and all 30 children appear in the results. Perception failures are acknowledged only anecdotally - one child's mask prevented facial landmark detection - with no systematic accounting of detection, tracking or landmark failure rates across the 109 events." ;
                            slr:rating "Unclear" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Measurement standardisation" ;
                            slr:justification "The camera rig is fixed and identical across sessions (four cameras, common 1.44 m height, stated focal length, 25 fps, 1280 x 720) and the clinical protocol is followed as written, so acquisition is consistent. But no camera calibration is performed, the caller's side varies between sessions so the contributing rear camera varies, and the number of accompanying parents is deliberately unconstrained - all accepted as realism, at the cost of standardisation." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Index test definition and prespecification" ;
                            slr:justification "Five decision constants set by hand and reported on the same data; the trained detector fitted on images of the same 30 children. No development set, no held-out participants, no prespecified operating point." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Outcome measurement blinding" ;
                            slr:justification "The automated judgement is fully deterministic and never sees the clinician's score, so the index test is blind to the reference standard by construction. The converse does not hold - but the clinician scored in real time during the session, before any automated output existed." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Reference standard quality" ;
                            slr:justification "A single experienced clinician scores each child, unblinded and while simultaneously conducting the assessment, with no second rater and no inter-rater reliability statistic - on an item requiring a real-time judgement about eye contact made from behind the child. The scoring rule is explicit and well specified, which prevents a worse rating, but the standard is one person's uncorroborated judgement." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Sample size adequacy for the modelling" ;
                            slr:justification "Thirty children, of whom one is not autistic. One misclassified child moves participant-level accuracy by 3.3 points, so the headline improvement from 83.3% to 93.3% rests on three children." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Preprocessing and feature selection nesting" ;
                            slr:justification "No feature selection occurs - all features are hand-specified and both angle definitions are fixed a priori, which removes selection bias as a mechanism. The threshold constants nonetheless play the same role as fitted parameters and were chosen with the evaluation data in view." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Performance estimation and chance level" ;
                            slr:justification "No chance-agreement baseline despite 17 of 30 children scoring 5 and each contributing five non-response events, so the 98.2% event-level figure sits above an unstated and high floor. No weighted kappa or ICC for what is an ordinal agreement problem, no confidence intervals, and the 109 events are treated as independent although they cluster within 30 children and are serially dependent." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Data splitting and leakage control" ;
                            slr:justification "No split of any kind. Decision thresholds hand-set and evaluated on the same 30 children; YOLOv3 retrained on more than 1,700 images drawn from those same 30 subjects, so the detector has seen every child it is evaluated on. No estimate exists of performance on an unseen participant." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Acknowledgement of limitations" ;
                            slr:justification "No limitations section. The two error cases are analysed well and the methods contain a correct and creditable scope disclaimer that the study assesses response to name rather than autism risk - but that disclaimer is contradicted by the abstract's 'consistency ... with clinical diagnosis' and by the conclusion's proposal of deployment for early autism screening in remote areas. Nothing is said about the absence of validation, the chance-agreement floor, the single unblinded rater, or the demographic gaps." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Ethics, consent and conflicts" ;
                            slr:justification "Parental informed consent obtained before each session and faces mosaicked in published figures - appropriate handling for clinical video of preschool children with disabilities. But the ethics statement is a single clause, 'these experiments have passed an ethical review', with no committee, institution or approval number named. Funding and competing interests are declared." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Completeness of methods reporting" ;
                            slr:justification "Unusually complete for the pipeline: camera count, height, focal length, resolution and frame rate with each camera's role; the clinical protocol and its full 0-5 scoring tree; the angle computation written out as three equations; every threshold constant stated numerically with a rationale for the duration constant; and every third-party model named, including the size of the custom detection training set. A competent group could rebuild the system from the text." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Data, code and protocol availability" ;
                            slr:justification "Data declared confidential; no code, no retrained detector weights, no annotations, no preregistration. The reliance on published third-party models partially offsets this at the level of reconstructibility but not of verifiability." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Reporting of results and uncertainty" ;
                            slr:justification "Results are reported at both aggregation levels with the full 6 x 6 score confusion matrix published and the two errors diagnosed concretely - all creditable. But there are no confidence intervals, no chance-corrected agreement statistic, no per-component error rates, and the inverted positive/negative convention, though stated, invites misreading of the sensitivity and specificity figures." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "unclear" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Single site: the Department of Developmental and Behavioral Pediatrics, The First Hospital of Jilin University, Changchun, with engineering from Jilin University's School of Communication Engineering. The setting is the study's most distinctive feature and is used deliberately rather than incidentally. Recording took place during actual ADOS-2 screening sessions rather than in a purpose-built experiment, with four fixed cameras installed in the assessment room and the clinical protocol left untouched: the clinician stands where the protocol requires, calls in a natural tone, repeats and reinforces as the manual specifies, and an unspecified and varying number of parents may be present. The authors argue explicitly that this yields 'less laboratory control, more realistic child response, and a flexible number of accompanying parents', and they are right that this is the correct target distribution for a tool meant to sit inside a clinic. It also creates the engineering problem the pipeline is built to solve - the scene contains multiple adults, so person re-identification is needed simply to know which skeleton belongs to the child. The countervailing point is that the sample is a referred clinical series at a tertiary hospital with 29 of 30 children already autistic, which is the opposite of the community screening population the conclusion invokes when it proposes deployment 'in remote areas with underdeveloped medical care'." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-098" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Author keywords: Autism spectrum disorder (ASD); Response to name; Human pose tracking; Head pose estimation; Early screening. Three of the five are computer-vision technique names and one is the specific behaviour targeted, which accurately reflects a paper whose contribution is a perception pipeline for one clinical item. 'Early screening' is the only application term and it overstates the work, since the sample contains a single non-autistic child. Terms carried through the body: multimodal discrimination, shoulder rotation angle, automatic name calling detection, multiple object tracking, person re-identification, Euler angle, yaw, Response to name Dataset, computer-aided diagnosis, ADOS-2 modules." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-098" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "There is no limitations section, though the discussion analyses the two residual errors carefully and the methods contain an important and creditable scope disclaimer - 'although RTN deficiency is closely associated with ASD, our experiment is an assessment of the response to name, not an assessment of autism risk'. The unaddressed limitations are substantial and several are structural. First, there is no validation of any kind: the five decision constants were chosen by hand and reported on the same 30 children, and the one trained component, YOLOv3, was retrained on 1,700 images of those same 30 children, so the detector has seen every participant it is evaluated on. Nothing in the paper estimates performance on an unseen child. Second, no chance baseline is computed, and the sample makes one essential: 17 of 30 children scored 5, so a rule that always predicted non-response would agree with the clinician on a majority of children and on a still larger majority of the 109 calls, since each non-responding child contributes five non-response events. For an ordinal agreement problem of this shape the natural statistic is a weighted kappa, and none is reported. Third, the 109 events are treated as independent for the headline 98.2% although they cluster within 30 children and are strongly serially dependent. Fourth, the reference standard is one unblinded clinician with no second rater and no reliability statistic, on an item that requires a real-time judgement about eye contact from behind the child. Fifth, the shoulder angle is a 2-D image-plane measurement from an uncalibrated fixed camera, so it confounds true rotation with seating position and posture. Sixth, the demographic reporting is too thin to establish for whom the method works. Finally, the framing is inconsistent: the abstract reports agreement with 'clinical diagnosis' and the conclusion invokes early autism screening in underserved regions, while the actual comparator is one clinician's score of one behavioural item in a sample that contains a single non-autistic child." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-098" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Capture: four Hikvision RGB cameras with 2.8 mm lenses mounted at a common height of 1.44 m, recording 1280 x 720 at 25 fps, of which three are used - C1 at the child's left front for body pose and C3/C4 at left and right rear for head pose, the pair being necessary because the clinician may stand on either side. Audio is captured alongside and converted to 16 kHz 16-bit PCM for the speech service. Software stack, all named and all off-the-shelf except for retraining: iFlytek (HKUST Xunfei) real-time speech transcription, a deep fully-convolutional ASR that returns timestamped text and thereby locates each name call; YOLOv3 for person detection, deliberately retrained on more than 1,700 images from the study's own 30 subjects rather than using COCO weights, on accuracy grounds; HRNet for top-down 2-D pose estimation, chosen for its high-resolution feature maintenance and repeated multi-scale fusion; OSNet person re-identification to associate detections across frames and assign a stable ID, without which the child's skeleton could not be distinguished from the clinician's and the parents'; OpenFace for face detection, landmarks and 3-D head Euler angles. Implementation in Python and PyTorch. What is missing is any calibration: the cameras' geometry is fixed and stated but no intrinsic or extrinsic calibration is performed, and the shoulder rotation angle is computed directly in 2-D image coordinates, so a given physical torso rotation maps to different measured angles depending on where the child is seated and how they are oriented with respect to C1." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-098" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Accuracy at two aggregation levels (30 participants and 109 test events), sensitivity, specificity, and a 6 x 6 confusion matrix of clinician against predicted 0-5 scores. The positive/negative convention is inverted from ordinary usage and stated explicitly - a true positive is a non-response correctly judged as a non-response - so sensitivity 84.6% refers to detecting failures to respond and specificity 100% to correctly recognising genuine responses. Reporting both aggregation levels and publishing the full score-level confusion matrix is better practice than most of this corpus. But the metric set is wrong for the problem in two ways. First, this is an ordinal agreement task between an automated scorer and a human scorer, for which the appropriate statistic is a weighted kappa or an intraclass correlation, and none is reported - so nothing corrects for the very high chance agreement created by 17 of 30 children scoring 5 and by every one of a non-responding child's five calls being a non-response event. The 98.2% event-level figure in particular is close to uninterpretable without that correction. Second, no confidence intervals are given, and with 30 children a single misclassification moves the participant-level accuracy by 3.3 points, so the reported improvement from 83.3% to 93.3% rests on three children. There is also no AUC, which is defensible since the system emits no score, and no evaluation of the perception components in isolation, so detection, tracking and landmark failures are folded silently into the end-to-end number." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-098" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two distinct reference standards operate in this study and the paper does not clearly separate them. For group membership, the 29 autistic children were assessed by professional clinicians using ADOS-2 at the Department of Developmental and Behavioral Pediatrics of a university teaching hospital, with module assignment reported; but no ADOS-2 score, no DSM or ICD criteria, no diagnosing-clinician description and no diagnostic date are given, and the single typically developing child's status is not characterised at all. For the study's actual outcome, the reference is an experienced clinician's 0-5 response-to-name score, assigned during the same session under an explicitly stated rule set. This second standard is well defined operationally - the rule tree in Fig. 2 is unambiguous - and it is the appropriate comparator for what the system does. Its weaknesses are that a single clinician scored each child, that this clinician was necessarily unblinded (they were conducting the assessment and calling the child's name), that no second rater or reliability statistic exists, and that the score is therefore an individual judgement rather than a consensus. Since response to name is exactly the kind of item where a clinician standing behind a child must judge in real time whether a head turn counted as a response with eye contact, the absence of any inter-rater reliability is a real gap: the paper's headline number is agreement with one person's uncorroborated judgement." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-098" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Thirty children in total: 29 with autism and 1 typically developing, mean age 3.65 years. Selection was by ADOS-2 module - only children assessed with the TM, M1 or M2 modules were included, i.e. children from 12 months upward with little or no fluent oral expression, excluding the M3 and M4 modules used for verbally fluent older children and adults. There is no comparison group in any meaningful sense; the single typically developing participant cannot support a between-group contrast and the paper never attempts one. A second and more relevant unit of analysis exists: 109 individual name-call test events, since each child receives up to five calls (three in natural tone at about 3 s intervals, then up to two reinforced calls by clinician or parent). These 109 events are the denominator for the study's highest reported figure of 98.2%, but they are not independent - they cluster within 30 children and are strongly serially dependent, because a child who ignores the first call usually ignores the remaining four. Table 2 shows the consequence: 17 of the 30 children scored 5, meaning they did not respond to any of the five calls." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-098" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Displays 76, article 102360, Elsevier - a display-technology and human-visual-interface journal, recommended for publication by a named handling editor. The venue is an unusual home for a clinical assessment study and explains the emphasis: camera geometry, multi-view capture, pose and landmark estimation and frame-level signal processing are described in detail, while the clinical apparatus around them - demographics, diagnostic scores, rater reliability, chance-corrected agreement - is thin or absent. Received 2 November 2022, revised 25 November 2022, accepted 18 December 2022, available online 5 January 2023." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-098" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A hybrid that is unusual in this corpus: four deep neural networks are used as perception front ends, but no model is trained on the behaviour and the decision itself is a hand-written rule. The deep components are YOLOv3 for person detection (retrained on the study's own images rather than using COCO weights, on accuracy grounds), HRNet for top-down 2-D pose estimation (selected for its high-resolution feature maintenance and repeated multi-scale fusion), OSNet re-identification for multi-object tracking (necessary because the scene contains the child, the clinician and a variable number of parents, so the child's skeleton must be identified and followed), OpenFace for facial landmarks and 3-D head Euler angles, and a commercial deep fully-convolutional ASR for name-call timestamps. Above these sits a three-branch threshold cascade with five hand-set constants. The architectural choice is defensible for the task - the clinical scoring rule is itself a deterministic decision tree over observable orienting behaviour, so encoding it directly rather than learning it from 109 examples is the right call at this sample size, and it makes every judgement auditable. The cost is that nothing adapts: the thresholds cannot accommodate a child whose habitual posture or motor control differs, the paper's own two error cases are both threshold-boundary failures, and there is no probability or confidence attached to any judgement, so no case can be flagged as uncertain and referred back to the clinician - which is precisely what an assistive scoring tool ought to do." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-098" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "One behaviour, examined more closely than any other single behaviour in this corpus: response to one's own name. The clinical definition adopted is precise - the child should turn and face the caller with eye contact rather than glance to the side - and the paper's decomposition of it into measurable components is the substantive contribution. Torso orientation is captured as the angle between the left-right shoulder vector at each frame and the same vector at the first frame after the call, so the measurement is relative to the child's own starting posture rather than to an absolute frame. Head orientation is captured as the yaw Euler angle from facial landmarks, with the mere detection of a face by the rear camera also serving as evidence that the child turned towards the caller. Response latency is captured by the ordinal 0-5 score, which encodes how many calls and reinforcements were needed. The authors are explicit about why body pose is needed alongside head pose, and the reasoning is behavioural rather than technical: prior work used head pose and gaze only, but some responsive children turn only the head with little shoulder movement, while some unresponsive children rotate slightly while manipulating toys, so neither channel alone separates response from non-response. What is not measured, despite being in the clinical definition, is eye contact itself - gaze is approximated by head direction on the stated assumption that the two agree, an approximation that is reasonable in general but is exactly the point at which a glance to the side, which the protocol says does not count as a response, becomes indistinguishable from a genuine orienting response." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-098" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No future-work section is provided. The conclusion's forward-looking claims are about deployment rather than research: that the method reduces the professional-knowledge requirement for assessment, provides efficient and objective computer-aided screening, and could support early autism screening in remote areas with underdeveloped medical care. Judged against the evidence, the research steps that would need to come first are clear and unstated: evaluation on children not used to train the detector; a balanced sample containing a meaningful number of non-autistic children so that the item score's discriminative value can be assessed; a second, blinded clinician rater with reported reliability so the reference standard is not one person's judgement; chance-corrected agreement statistics appropriate to an ordinal score; and threshold selection on a development set separate from the evaluation set. The wider point this study raises for the review, and does not itself pursue, is whether automating individual ADOS-2 items one at a time is a viable route to instrument automation - it is the only paper in this corpus attempting it, and the answer depends on error rates the paper cannot currently estimate." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-098" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Goal: to automate the judgement of response to name during real clinical ADOS-2 assessments, by combining automatic speech recognition (to timestamp the name calls) with human pose tracking (to measure shoulder rotation) and head pose estimation (to measure head yaw), and to show that adding body pose to the head-pose-only approach used in prior work improves agreement with clinicians. Three contributions are claimed: a four-camera multi-view capture rig; a 'Response to name Dataset' drawn from live ADOS-2 screening rather than a controlled laboratory protocol, with more natural child behaviour and an unrestricted number of accompanying parents; and the finding that combining shoulder rotation angle, head pose and response duration improves accuracy over pose alone. Findings: shoulder pose alone agreed with the clinician for 25 of 30 children (83.3%) and 104 of 109 calls (95.4%); adding head pose raised this to 28 of 30 (93.3%) and 107 of 109 (98.2%), with sensitivity 84.6% and specificity 100% under an inverted convention in which the 'positive' class is non-response. The two residual participant-level errors are diagnosed concretely: one child responded too slowly to accumulate the required 10 frames above the shoulder threshold and was also wearing a mask, which blocked the facial-landmark fallback; the other turned their head too fast for 8 frames of yaw to be detected. The score-level confusion matrix shows the modal outcome to be clinician 5 / predicted 5 in 17 children." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-098" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Three-stream fusion with a clearly reported ablation, and the fusion architecture is a hand-written cascade rather than a learned combination. Audio and video are fused at the segmentation stage: the ASR stream supplies timestamps for each name call, which cut the video into 3 s response windows, and the authors note that this removes the manual-annotation error that would otherwise attach to onset marking. Body pose and head pose are then fused at the decision stage in a three-branch rule: shoulder rotation above 90 degrees for more than 10 frames gives a positive response outright; shoulder rotation below 20 degrees on every frame gives a negative response outright; and only in the ambiguous 20-90 degree band does head yaw adjudicate, with more than 8 frames of detected yaw giving a positive response. The ablation is reported for the two visual streams and is the paper's central quantitative claim: pose alone gives 83.3% of participants and 95.4% of events, pose plus head pose gives 93.3% and 98.2%. In participant terms that is three additional children correctly scored out of 30, so the confidence interval on the improvement is wide even though the direction is plausible. Two features of this fusion design are worth carrying into the synthesis. It is complementary by explicit behavioural argument rather than by empirical search - each stream is introduced to cover a named failure mode of the other - which is a more defensible basis for multimodality than the accuracy-chasing seen in several other studies here. And the multi-view arrangement is itself a form of fusion driven by the clinical protocol: two rear cameras are required because the caller may stand on either side, so which camera contributes the head-pose evidence depends on the geometry of the assessment rather than on a fixed sensor assignment." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-098" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "'Autistic children' and 'children with ASD' are both used, with 'autistic children' predominating in the title, abstract and conclusion - identity-first language, which is unusual in this corpus and may reflect translation from Chinese as much as a deliberate stance. Other usages are less careful: 'the number of autistic patients has been rising', 'more than 10 million people have been diagnosed with ASD', and 'children with autism have a low quality of life, require family care, and bring huge economic costs to society'. That last sentence, in the opening paragraph, frames autistic children primarily as a burden and is the starkest instance of deficit-and-cost framing encountered so far in this review. Clinically the vocabulary is standard medical-model: 'neurodevelopmental disorder', 'incidence rate', 'RTN deficiency', 'symptoms', 'no medicine can reliably relieve the symptoms of ASD'. There is no neurodiversity framing and no autistic-community involvement. Set against this, the study's practical stance towards children is respectful in a way several others here are not: it works within a real clinical assessment rather than imposing an experimental protocol, accepts a flexible number of accompanying parents, and mosaics participants' faces in published figures for privacy even at the cost of obscuring the detected landmarks." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-098" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional single session with no follow-up and no test-retest assessment. Since the pipeline is proposed as a clinical scoring aid, the absence of any repeat measurement means nothing is known about whether the same child assessed twice would receive the same automated score. Ethics reporting is minimal but present in both required elements: 'these experiments have passed an ethical review', with no committee, institution or approval number named, and informed consent obtained from the children's parents before each session. A privacy measure is also implemented and disclosed - participants' faces are mosaicked in the published figures, with the authors noting that this may obscure the facial joints they wish to illustrate - and the data are declared confidential rather than released. For video recorded on preschool children with disabilities during clinical assessment, the consent and privacy handling is appropriate; the ethics statement is thinner than the norm and would not satisfy most journals' current reporting requirements." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-098" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The ADOS-2 response-to-name press, executed as the manual prescribes and left unmodified. The child sits at a table absorbed in toys; the clinician stands behind and to one side and calls the child's name in a natural voice; if the child turns and makes eye contact the item ends, otherwise the call is repeated up to three times at roughly 3 s intervals; then up to two reinforced calls follow, delivered with a changed tone or by a parent. Scoring runs 0 (responds to the first call) through 5 (no response after all five). Two properties make this paradigm unusually well suited to automation. It has a precise onset - the moment the name is spoken - which the ASR component recovers automatically and which the authors correctly identify as removing a source of manual-annotation error; and it has a precise, short response window of 3 s fixed by the protocol itself. Two properties make it hard. The clinically defined response is 'turn and face the implementer with eye contact rather than glance to the side', which is a conjunction of orientation and gaze that no single sensor captures, and which the cascade approximates rather than measures - eye contact per se is never assessed, only head yaw and whether a face was detected by the rear camera. And the caller's position varies between left and right rear, which is why two rear cameras are required and why the head-pose channel depends on the child turning towards whichever camera happens to be behind the caller." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-098" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Published 2023 by Jilin University's School of Communication Engineering with the Department of Developmental and Behavioral Pediatrics of The First Hospital of Jilin University, funded by the Science and Technology Development Plan of Jilin Province and the National Natural Science Foundation of China. The framing is capacity-driven and quantified: the opening cites autism prevalence rising to 1-2%, more than 10 million diagnosed people in China of whom about 3 million are children, and the striking statistic that 'globally, less than 5% of assessments use the ASD gold standard diagnostic tool, which is mainly due to the long test time, complex training of evaluators and high cost'. That last figure is the clearest statement in this corpus of why instrument automation, as opposed to diagnosis replacement, might matter. The paper positions its own contribution against three named prior response-to-name systems (Bidwell, Petric, Liu, Wang), arguing that all previous work relied on face, head pose and gaze while ignoring body pose - so the framing is incremental within a small, well-identified subliterature. Its most creditable move is the methods-section disclaimer that the work assesses response to name and not autism risk, which sits in unresolved tension with the abstract and conclusion." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-098" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Fully interpretable by construction, and this is the study's clearest methodological strength. Every judgement reduces to two physically meaningful quantities - degrees of shoulder rotation relative to the child's posture when their name was called, and degrees of head yaw - together with counts of how many of the 75 frames satisfied a stated threshold. Figures 6 and 7 plot both series for worked examples against their thresholds, so a clinician or auditor can replay any decision frame by frame against the video and see exactly why it came out as it did. The design rationale is also explained in behavioural terms rather than defended by performance: shoulder rotation alone fails in two named directions, missing responsive children who turn only the head and falsely flagging unresponsive children who shift slightly while playing with toys, and head pose is introduced specifically to adjudicate that band. Even the duration constant is argued from evidence rather than tuned, being derived from the observation that gaze fixation during concentration lasts at least 0.2 s and then doubled to 0.4 s to allow for timing error in children's rotation. Three interpretability limits remain. Nothing quantifies how close a judgement was to its threshold, so no case can be surfaced as borderline. The perception layer beneath the rule is entirely opaque and unevaluated on this population, so a wrong answer caused by a tracking identity switch would look identical to one caused by a genuine behavioural boundary case. And eye contact, which the clinical definition requires, is never measured - head direction stands in for gaze on an assumption stated but not tested." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-098" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Two scalar angle time series per 3 s response window, each sampled at 25 fps and therefore up to 75 frames long, reduced to threshold-crossing frame counts before the decision. The shoulder rotation series is computed frame by frame as theta_t = arccos(v_0 . v_t / |v_0||v_t|) converted to degrees, where v_t is the vector from the right to the left shoulder joint at frame t and v_0 is the same vector at the first frame after the name call - so the measurement is self-referenced to the child's posture at call onset rather than to any absolute frame, which is a sensible choice that removes dependence on how the child happened to be sitting. The head series is the OpenFace yaw Euler angle, accompanied by an implicit binary of whether a face was detected at all by the relevant rear camera. Both series are then summarised only by counting frames that satisfy a threshold, so the representation discards the shape of the movement entirely: peak angular velocity, smoothness, whether the turn was completed or aborted, and whether the child returned to the toys are all invisible. Nothing is learned from the raw joint coordinates, and no representation of the temporal profile of orienting survives into the decision." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-098" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Strong on specification, absent on artefacts. Every decision constant is stated numerically - the 3 s response window, the 90 degree and 20 degree shoulder thresholds, the 10-frame (0.4 s) and 8-frame duration thresholds - and the angle computation is written out as three equations from the shoulder vector through the arccosine to the degree conversion. The camera rig, frame rate, resolution, focal length and mounting height are given, as are the roles of each camera, the clinical protocol and its full scoring rule, the exact third-party models used, and the size of the custom detection training set. A competent group could rebuild the system from the paper. What cannot be reproduced is any number in it: the data are declared confidential, the retrained YOLOv3 weights and the 1,700-image annotations are not released, no code is available, and the ASR component is a commercial service whose behaviour may change. There is also no preregistration and no independent evaluation of the perception components (detection, tracking, landmark) in isolation, so their error rates on this population are unknown and are folded silently into the end-to-end figure." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-098" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The thinnest demographic reporting of any included study charted so far. What is given: n = 30, of whom 29 autistic and 1 typically developing; a single overall mean age of 3.65 years; and the ADOS-2 modules from which participants were drawn (TM, M1, M2), which implies limited or absent fluent language across the sample. What is absent: sex distribution, age range or standard deviation, per-group age, IQ or developmental quotient, language level beyond the module implication, socioeconomic status, race or ethnicity, comorbidity, medication, and any ADOS-2 total, algorithm or comparison score. Because the sample is 29 autistic children and 1 control, the usual concern about group matching does not arise, but a different problem does: without age spread, sex, or developmental level it is impossible to judge for whom the vision pipeline works. Body proportions, head size, motor control and sitting posture all vary sharply across the 12-month to roughly 5-year span that modules TM through M2 encompass, and a shoulder-rotation threshold of 90 degrees measured in 2-D image coordinates is not obviously age-invariant. All data come from one hospital in Changchun, so the sample is also geographically and culturally homogeneous." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-098" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "There is no validation strategy, and this is the study's decisive methodological gap. No training/test split, no cross-validation, no development set, no held-out participants: the five decision constants were set by hand and are reported on the same 30 children and 109 calls used to define them, and the single trained component, YOLOv3, was retrained on more than 1,700 images drawn from those same 30 subjects, so the person detector has seen every child it is subsequently evaluated on. Nothing in the paper estimates how the pipeline would behave on a child it has never encountered. Compounding this, no chance-agreement floor is computed although the data make one essential: with 17 of 30 children scoring 5 and each of those children contributing five non-response events, a trivial always-predict-non-response rule would already agree with the clinician on well over half the participants and on a substantially larger share of the 109 calls, so the 98.2% event-level figure is being reported against an unstated and high baseline. For an ordinal agreement problem the correct summary is a weighted kappa or ICC; accuracy without chance correction systematically overstates agreement in exactly this configuration. The 109 events are also treated as independent although they cluster within 30 children and are serially dependent by the protocol's own logic. Finally, the reference standard against which all of this is measured is a single unblinded clinician with no second rater, so even a perfectly validated system could only be shown to reproduce one person's uncorroborated judgements. The corrective study is well within reach of this group and would be worth more than the current numbers: fix the thresholds on a development subset, evaluate on children whose images never entered detector training, add a second blinded rater and report inter-rater reliability, and report weighted kappa alongside accuracy at both aggregation levels." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-098" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No cognitive, language, adaptive or global severity measure was administered or reported. The only quantitative symptom measure in the study is the response-to-name score itself, and it is genuinely informative: Table 2 shows that 17 of the 30 children failed to respond after all five calls, with the remainder distributed across the lower scores. That distribution is a symptom-severity profile for one ADOS-2 item, and it is reported honestly. But it is also the paper's undoing statistically, because a majority of children and a larger majority of the 109 calls fall into the single 'no response' category, and no chance-corrected agreement statistic is computed against that floor. Beyond this item, nothing: no ADOS-2 calibrated severity score despite ADOS-2 having been administered in full to every child, no developmental quotient, no language measure beyond the coarse module assignment, and no motor assessment - the last being relevant since the system's primary signal is torso rotation and children in this age and module range vary widely in postural control." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-098" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:study_design "Cross-sectional method-development and agreement study; a computer-vision pipeline is applied to video of routine clinical ADOS-2 assessments and its per-call response judgements a…" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: ; comparison: 1" ] ] ;
    slr:content_sha256 "cd597207fd7fe24554a1d76c75900f260f602b9c9e374d0f254a2c38239e32be" ;
