            slr:media_type "text/plain" ] ;
    slr:journal "Frontiers in Medicine, 12" ;
    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Convenience secondary use of a single archived dataset of 59 children. No inclusion or exclusion criteria, no consecutive or random sampling, no recruitment description. The comparison group differs from the ASD group by 42.9 percentage points in sex composition, a difference directly relevant to gaze behaviour and unaddressed by design or analysis. Age is reported as one pooled mean with no group breakdown, so age matching cannot be assessed." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "The index test is a CNN-LSTM whose input vector includes CARS_Score, a clinician-administered autism severity instrument - the model is given a measurement of the target condition as a predictor. Feature selection and mean imputation were performed on the complete dataset before cross-validation, so the index test was constructed with knowledge of the test folds' labels. No prespecified decision threshold at the child level exists, because the model classifies gaze samples rather than children." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "The reference standard is unspecified. Labels are inherited from a public dataset with no statement of diagnostic criteria, instrument, cut-off, or assessor qualification, and no screening evidence for the TD group. CARS is implied by the presence of a score field but never described as a reference procedure." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Row-level stratified 5-fold cross-validation over 1,048,575 gaze samples from 59 children places samples from the same child, session and stimulus on both sides of every split. All 59 children entered the analysis at every stage, but the unit of analysis is not the unit of interest, and the interval between reference standard and index data is undocumented." ] ;
            slr:overall_judgment "high" ;
            slr:tool_used "QUADAS-2" ] .

<urn:slr:article:2acd51f637a5> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Background: As the demand for early and accurate diagnosis of autism spectrum disorder (ASD) increases, the integration of machine learning (ML) and explainable artificial intelligence (XAI) is emerging as a critical advancement that promises to revolutionize intervention strategies by improving both accuracy and transparency. Methods: This paper presents a method that combines XAI techniques with a rigorous data-preprocessing pipeline to improve the accuracy and interpretability of ML-based diagnostic tools. Our preprocessing pipeline included outlier removal, missing data handling, and selecting pertinent features based on clinical expert advice. Using R and the caret package (version 6.0.94), we developed and compared several ML algorithms, validated using 10-fold cross-validation and optimized by grid search hyperparameter tuning. XAI techniques were employed to improve model transparency, offering insights into how features contribute to predictions, thereby enhancing clinician trust. Results: Rigorous data-preprocessing improved the models’ generalizability and real-world applicability across diverse clinical datasets, ensuring a robust performance. Neural networks and extreme gradient boosting models achieved the best performance in terms of accuracy, precision, and recall. XAI techniques demonstrated that behavioral features significantly influenced model predictions, leading to greater interpretability. Conclusions: This study successfully developed highly precise and interpretable ML models for ASD diagnosis, connecting advanced ML methods with practical clinical application and supporting the adoption of AI-driven diagnostic tools by healthcare professionals. This study’s findings contribute to personalized intervention strategies and early diagnostic practices, ultimately improving outcomes and quality of life for individuals with ASD." ;
    dcterms:bibliographicCitation "Jeon I; Kim M; So D; Kim EY; Nam Y; Kim S; Shim S; Kim J; Moon J (2025). Reliable Autism Spectrum Disorder Diagnosis for Pediatrics Using Machine Learning and Explainable AI. *Diagnostics, 14(22)*." ;
    dcterms:creator "Jeon I",
        "Kim EY",
        "Kim J",
        "Kim M",
        "Kim S",
        "Moon J",
        "Nam Y",
        "Shim S",
        "So D" ;
    dcterms:title "Reliable Autism Spectrum Disorder Diagnosis for Pediatrics Using Machine Learning and Explainable AI" ;
    bibo:pmid "local_183eaef4" ;
    fabio:hasPublicationYear 2025 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Sample size justified" ;
                            slr:justification "No justification; 1,985 reduced to 634 with no per-step counts and no class composition for the removed records." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Participants appropriate to the question" ;
                            slr:justification "Public spreadsheet records with no described collection procedure; 68% removed on unstated criteria; class balance never reported." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Data source and eligibility described" ;
                            slr:justification "Kaggle URL and access date given and the preprocessed analysis dataset deposited as supplementary material, but no eligibility criteria, collection setting or provenance for the original data." ;
                            slr:rating "Unclear" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Predictors defined and measured appropriately" ;
                            slr:justification "CARS, SRS, AQ10 total, Q-CHAT-10 score and the ten AQ-10 items are all supplied as predictors of an autism-traits label - four instrument measurements of the target condition inside the feature vector." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Model development guarded against optimism" ;
                            slr:justification "Grid-search tuning within caret and child-level folds, but the nesting of tuning inside the outer folds is not specified." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Predictors assessed blind to outcome" ;
                            slr:justification "Expert-guided feature selection and outlier/inconsistency removal were carried out on the complete dataset before cross-validation, with no stated criterion and no indication of outcome blinding." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Outcome definition and ascertainment" ;
                            slr:justification "Outcome is a binary ASD_traits spreadsheet field with no clinical ascertainment described, while the paper's title and text claim diagnosis." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Outcome determined independently of predictors" ;
                            slr:justification "It is not - the predictor set contains four instruments used to determine autism traits, including the item-level constituents of the AQ-10 total." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Analysis unit matches the clinical claim" ;
                            slr:justification "One record per child; folds partition children; no within-participant leakage." ;
                            slr:rating "Low" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Performance measures adequate" ;
                            slr:justification "Accuracy, F1, precision, recall and prAUC with formal Wilcoxon and Friedman comparison, but no specificity for any model, no class balance and therefore no baseline, and no confidence intervals; the neural network reports precision and recall of 1.0000 alongside prAUC 0.9601." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Validation design guards against optimism" ;
                            slr:justification "10-fold cross-validation with per-fold reporting and repeat experiments at 2, 4 and 5 folds prompted by the authors' own overfitting concern - a rare and correct instinct - but record removal and feature selection preceded all of it." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Limitations and overinterpretation" ;
                            slr:justification "No limitations section, but an explicit and genuine overfitting investigation. Against that, the abstract claims improved generalizability and real-world applicability across diverse clinical datasets on the basis of one dataset, and the future work proposes only a change of programming language." ;
                            slr:rating "Unclear" ] ;
                    slr:overall_concern "unclear" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No participants were recruited. The ASD Children Traits dataset was downloaded from Kaggle: 1,985 cases with 28 variables, covering children aged 1-18. Preprocessing then reduced this to 634 cases and 19 variables - 68% of the records and a third of the variables removed as outliers, inconsistencies or erroneous data identified by clinical experts. Neither the raw nor the preprocessed dataset's class balance is reported anywhere, so the number of ASD and non-ASD cases behind every result in the paper is unknown. This matters more than usual because the introduction states explicitly that ASD assessment datasets tend to over-represent ASD cases and that this can bias models toward the majority class - a problem the authors identify and then never quantify in their own data." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-154" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Split. The artefact-level reporting is among the best in the charted corpus: the source dataset has a URL and access date, the preprocessed 634-case analysis dataset is deposited as a supplementary spreadsheet, fold-by-fold metrics for all eight models appear in an appendix, caret's version is given, each model family is defined by equation, and the k-NN k-sweep is reported in full. The decisive step is nevertheless irreproducible. Preprocessing removed 1,351 of 1,985 records and 9 of 28 variables on the basis of clinical experts identifying inconsistencies and erroneous data, with no criterion stated, no counts per step, no class composition for the removed records and no indication of whether the removal was made blind to the outcome. Since that step is credited in the abstract with improving generalizability and real-world applicability, and since it is the largest single transformation in the pipeline, the study cannot be reproduced in the respect that matters most." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-154" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Four instrument scores are present - Social Responsiveness Scale, CARS, AQ10 total and Q-CHAT-10 - and all four are used as model inputs rather than reported as participant characteristics. Not one mean, range or class-wise distribution appears for any of them. This is the study's central analytic problem, examined under RQ4.2 and RQ4.5." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-154" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "ASD, autism spectrum disorder, children with ASD, individuals with ASD, patients, ASD traits, non-ASD. The register is clinical and generally neutral, with person-first phrasing throughout and an explicit concern for quality of life for individuals with ASD. The consistent use of patient for records in a downloaded Kaggle file - patient case identifiers, patient consent, patient information - is worth noting: it treats spreadsheet rows as clinical subjects while the study has no clinical relationship with any of them." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-154" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. The dependent variable is ASD_traits, a binary yes/no field in a Kaggle spreadsheet. No clinical assessment, diagnostic instrument administration, criterion, assessor or date exists for any case, and the originating collection procedure is not described at all. The paper nonetheless frames the task as ASD diagnosis throughout, titles itself Reliable Autism Spectrum Disorder Diagnosis for Pediatrics, and opens by criticising clinician-administered instruments for introducing variability and potential bias - a criticism made in favour of a label whose provenance is entirely unknown." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-154" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No task or paradigm. Tabular records combining AQ-10 item responses, four instrument scores, comorbidity flags and demographics, with a rater field recording whether a family member, healthcare professional or other person completed the assessment. The rater field is retained as a predictor rather than analysed as a source of measurement heterogeneity." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-154" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional secondary analysis. Ethics is formally addressed and formally waived: ethical review and approval were waived due to the use of publicly available data without any identifiable information, and patient consent was waived because the dataset is widely accepted and publicly available, has been used in numerous research studies establishing a general consensus regarding its use for research purposes, and has been de-identified. The reasoning is at least stated, which distinguishes it from the many charted studies with no ethics statement at all; but the specific argument - that prior reuse establishes a consensus legitimising further reuse - is a citation-count justification for a governance question, and it is offered for a dataset whose own collection consent is never established." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-154" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "There is no limitations section, but the discussion contains the most genuine act of self-scrutiny in the charted corpus. The authors write that because of the exceptionally high-performance metrics observed in our initial model evaluations, we were concerned about the potential for overfitting, and they respond by re-running the entire comparison at 2-fold, 4-fold and 5-fold. They report that the neural network's perfect scores in certain folds indicate a potential risk of overfitting to specific data characteristics, and that identical metrics for the neural network and k-NN in some tables may indicate redundancy or overfitting in the model implementation or data processing. That instinct is correct and is exercised properly. What it does not reach is the cause: no fold count can diagnose a problem that lies in the feature set rather than the partition, and the one experiment that would have settled it - refitting without the SRS, CARS, AQ10 and Q-CHAT-10 scores - is never run. Unmentioned elsewhere: the unreported class balance, the unspecified 68% record removal, the absence of any external dataset behind a claim of applicability across diverse clinical datasets, and the unknown provenance of the label." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-154" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A single direction: migrate from R to Python for access to more advanced machine-learning libraries and better collaboration with the childcare research community. This is a tooling preference rather than a scientific direction, and it addresses none of the study's own identified concerns - not the overfitting the authors flag, not external validation, and not the missing clinical ground truth." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-154" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Accuracy, F1, precision, recall and area under the precision-recall curve, per model and per fold, at four fold counts, with per-fold tables in an appendix. The choice of prAUC is thoughtful and explicitly justified by the expected class imbalance. Two absences matter. Specificity is never reported for any model, so the false-positive behaviour of a system proposed for paediatric screening is invisible; and the class balance is never given, so neither the prAUC baseline nor the majority-class accuracy can be computed. The reported neural-network figures are accuracy 1.0000, F1 1.0000, precision 1.0000 and recall 1.0000 - a model that misclassifies no child in any of ten folds - with prAUC 0.9601, a combination that is itself internally odd, since a classifier with perfect precision and recall should have a precision-recall curve area of 1." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-154" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No instrumentation. R with caret 6.0.94, iml for SHAP and permutation importance, lime for LIME, glmnet and class for two of the models. The paper devotes an entire subsection to arguing that R is accessible to non-expert clinicians and offers practical guidelines for its use - a genuine attempt at translation - and then does not release the script that would make those guidelines operational." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-154" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No modality fusion - a single tabular source. There is, however, a fusion of instrument types within the feature vector that is the study's defining characteristic: AQ-10 item responses, an AQ-10 total, a Q-CHAT-10 total, an SRS score and a CARS severity rating all sit in the same 19-variable input alongside the ASD_traits label they are designed to determine." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-154" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Autistic traits as captured by the ten AQ-10 items, characterised in the XAI discussion as communication patterns, repetitive actions and frequency of eye contact. All behaviour is second-hand and questionnaire-mediated, reported by a family member, healthcare professional or unspecified other." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-154" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "On the axes that defeat most of this literature, the design is sound. The analysis unit is the child, the folds partition children, there is no within-participant leakage, hyperparameters are grid-searched, per-fold results are published, model differences are tested with Wilcoxon signed-rank and Friedman statistics rather than eyeballed, and the k-NN sweep is reported. The authors then did what almost no one in this corpus does: they distrusted their own result. Concerned about the potential for overfitting given exceptionally high metrics, they re-ran the full comparison at 2, 4 and 5 folds, observed that the neural network scored perfectly at 4 and 5 folds but fell to 0.8691 at 2, and noted that this indicates a potential risk of overfitting to specific data characteristics. That is the right instinct pointed at the wrong object. Varying the fold count tests partition sensitivity; it cannot detect leakage that lives in the feature set. Here the feature set contains four separate instrument measurements of the target condition - CARS, SRS, AQ10 and Q-CHAT-10 - plus the item-level constituents of the AQ-10 total, all predicting a binary ASD_traits label. Under those conditions accuracy 1.0000 is not overfitting; it is the model reading the answer off the input, and no resampling scheme will change it. Two further issues compound this. The preprocessing removed 68% of the records and a third of the variables through expert identification of inconsistencies and erroneous data, performed on the whole dataset before cross-validation and with no stated criterion, no per-class counts and no indication of outcome blinding - a step credited in the abstract with improving generalizability. And the class balance is never reported, so neither a majority-class baseline nor a prAUC reference exists, and the perfect scores cannot be positioned against anything. The abstract's claim that rigorous preprocessing improved real-world applicability across diverse clinical datasets is made from a single dataset with no external cohort." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-154" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A 19-field tabular row containing, together: the ten AQ-10 behavioural items, the AQ10 total score, the Q-CHAT-10 score, the Social Responsiveness Scale score, the CARS severity rating, seven comorbidity flags and demographics - with ASD_traits as the target. This is the review's most concentrated instance of target leakage by instrument inclusion. CARS is a clinician-administered autism severity scale; SRS measures social impairment severity; AQ10 and Q-CHAT-10 are autism screening totals whose thresholds define exactly the kind of traits-present label being predicted; and the ten AQ-10 items are the summands of the AQ10 total. Four separate measurements of the target condition, plus the item-level constituents of one of them, are supplied to the model as predictors of that condition. A perfect neural-network score under this arrangement is the expected outcome, not an anomaly - and it explains why even logistic regression, a linear model on 19 variables, reaches 0.9858." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-154" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Three methods, applied properly and to the best models only: permutation feature importance, LIME with reported probability and explanation-fit values, and SHAP, with the authors concluding that SHAP gives the most consistent and reliable explanations for both global and local behaviour. The substantive finding is that the A1-A10 behavioural items dominate while demographic variables such as age and ethnicity contribute little, which the paper reads as evidence that behaviour rather than demography drives ASD prediction and as grounds for clinician trust. The reading is understandable and wrong in an instructive way: the model weights the AQ-10 items heavily because the label is an autism-traits determination made from those items, so the explanation confirms the pipeline's internal arithmetic rather than validating a clinical insight. The XAI apparatus here is the most carefully executed in the charted corpus and is applied to a model whose behaviour it cannot make meaningful." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-154" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "autism spectrum disorder; clinical diagnosis; data preprocessing; healthcare analytics; machine learning; patient outcomes; personalized intervention; explainable artificial intelligence. Eight terms spanning condition, method, application and aspiration; validation and participants are absent, and clinical diagnosis names something the study does not have." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-154" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Eight classical classifiers compared under a common protocol - random forest, SVM, gradient boosting machine, XGBoost, C5.0, a neural network, k-nearest neighbours and logistic regression - with grid-search tuning in caret and formal statistical comparison by Wilcoxon signed-rank and Friedman tests. No deep learning on raw signals; the comparison is fair in form and the statistical apparatus is more rigorous than anything else in the charted corpus." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-154" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Published 8 November 2024 (indexed here under 2025), 40 days from submission. Framing is translational and confident: the integration of ML and XAI promises to revolutionize intervention strategies, the study successfully developed highly precise and interpretable ML models for ASD diagnosis, and the findings support the adoption of AI-driven diagnostic tools by healthcare professionals and contribute to personalized intervention strategies. The paper positions itself in a comparison table against ten prior studies, with the distinguishing contribution in every row being the absence of XAI in the others - so novelty is claimed on the explanation layer while the estimand goes unexamined. Its most interesting feature is that a team including practising clinicians, applying correct cross-validation, formal statistical testing and three explanation methods, arrived at accuracy 1.0000 and treated it as a result to be defended by resampling rather than as a signal to inspect the feature list." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-154" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Diagnostics 14(22):2504 (MDPI) - an open-access clinical diagnostics journal, with paediatric and psychiatric clinicians among the authors. The clinical involvement is real and shaped the feature selection; it did not surface that four instrument measurements of the target condition were sitting in the predictor set, which is precisely the observation clinical expertise is best placed to make. The paper cleared review in 40 days." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-154" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No study setting. A downloaded Kaggle file analysed in R. The authorship is notable for this corpus - it includes practising paediatric and psychiatric clinicians from a university hospital, and their input is credited with guiding the feature-selection step." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-154" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Variables are present but distributions are not. Age spans 1-18 years with no mean or SD; sex is coded M/F with no counts; ethnicity is coded across 11 categories (Asian, Black, Hispanic, Latino, Middle Eastern, Mixed, Native Indian, Others, Pacifica, South Asian, White European) with no counts; family history and rater type (family member, healthcare professional, other) are recorded. Seven comorbidity flags are retained as model inputs - speech/language delay, learning disorder, genetic disorders, depression, global developmental delay/intellectual disability, social/behavioural issues, anxiety disorder - and not one prevalence figure is given for any of them. The dataset is described as comprehensively capturing socioeconomic status, but no socioeconomic variable appears in either variable table." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-154" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The stated goal is to combine explainable AI with a rigorous, clinically guided preprocessing pipeline to make ML-based ASD diagnosis both accurate and interpretable, and to provide practical R-based guidelines for non-expert clinicians. Headline findings: under 10-fold cross-validation the neural network reached accuracy, precision, recall and F1 of exactly 1.0000, with GBM and XGBoost at 0.9984 and logistic regression at 0.9858; Wilcoxon and Friedman tests confirmed significant differences between models; and PFI, LIME and SHAP all identified the A1-A10 behavioural items as dominant with demographic variables contributing little." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-154" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "Internal, across the eight algorithms, with Wilcoxon signed-rank tests comparing the neural network against each other model on fold-wise metrics and a Friedman test across all models. No external ben" ;
                    slr:study_design "Retrospective secondary analysis of a single public tabular dataset, with an expert-guided preprocessing pipeline, eight classifiers compared under 10-fold cross-validation with gr…" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: Not reported for either the raw or the preprocessed dataset.; comparison: Not reported. The introduction notes that ASD assessment datasets typically over-represent ASD cases, but the study's own class balance is never given." ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "Under 10-fold cross-validation the neural network achieved accuracy 1.0000, F1 1.0000, precision 1.0000 and recall 1.0000, with prAUC 0.9601; GBM and XGBoost both reached accuracy 0.9984 with precision 1.0000; logistic regression 0.9858, SVM 0.9874, C5.0 0.9701, random forest 0.9463 and k-NN 0.8883. The neural network again reached perfect scores at 4-fold and 5-fold, but fell to 0.8691 at 2-fold." ;
                    slr:outcome "Accuracy, F1, precision, recall and area under the precision-recall curve, per model and per fold, at four different fold counts; Wilcoxon signed-rank p-values for pairwise comparison and Friedman chi-squared statistics across models; a k-value sweep for k-NN." ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "Under 10-fold cross-validation the neural network achieved accuracy 1.0000, F1 1.0000, precision 1.0000 and recall 1.0000, with prAUC 0.9601; GBM and XGBoost both reached accuracy 0.9984 with precision 1.0000; logistic regression 0.9858, SVM 0.9874, C5.0 0.9701, random forest 0.9463 and k-NN 0.8883. The neural network again reached perfect scores at 4-fold and 5-fold, but fell to 0.8691 at 2-fold." ] ] ;
