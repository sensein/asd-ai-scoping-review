    slr:journal "Proceedings of the 12th In" ;
    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "Image counts per class are reported (328 non-ASD, 219 ASD) and the augmentation volume is stated, but the mapping from 59 children to 547 images is not given and no participant-level exclusions or data-quality failures are described." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "The unit of analysis is the scanpath image, with 547 images from 59 children plus 2,735 augmented derivatives, and no statement that cross-validation folds were participant-independent - so images and their own augmented near-duplicates can span training and test sets." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Diagnosis rests on unspecified multidisciplinary clinic examination with CARS severity rating and no standardised observational instrument; control status rests on school recruitment plus consideration of parental concerns, with no screening." ],
                [ a slr:RoBDomainJudgment ;
