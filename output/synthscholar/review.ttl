    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Labels are behaviour-segment annotations, not diagnoses; no clinical assessment exists for any child, while the title and abstract claim diagnostic and screening application." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Seventy-five YouTube videos posted by parents and caretakers, with no recruitment, eligibility, demographics or count of distinct children; no non-autistic comparison group exists, so all four classes come from the same population." ],
                [ a slr:RoBDomainJudgment ;
