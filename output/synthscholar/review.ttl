            slr:assessed_on "full_text" ;
            slr:decision "include" ;
            slr:decision_rationale "Full text confirms a primary system-development study with a small proof-of-concept evaluation: a multi-camera RGBD vision pipeline built on the Robot Operating System performing face detection, recognition, segmentation and tracking, landmark detection, head pose and gaze estimation, and Hidden Markov Model-based visual focus of attention estimation, coupled bidirectionally to a robot whose behaviour adapts to the child's performance. Six children aged 36 to 48 months took part in one session each. Included as part of the verified corpus, and charted with the record made explicit that no classifier is trained or evaluated for autism, the group comparison is qualitative, and the risk group has no confirmed diagnosis - so the study contributes as measurement-infrastructure and joint-attention-paradigm work rather than as a detection result." ;
            slr:full_text_source "user_supplied_pdf" ;
            slr:screening_stage "full_text" ],
