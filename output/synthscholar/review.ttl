        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "Although basic research has shown that eye movements differ in disorder groups for each presenting emotion, machine learning models that take this into account have not been examined. Therefore, we propose a modeling method that takes into account the differences in gaze scanning patterns for each facial expression." ] ;
            oa:hasTarget <https://doi.org/10.3389/fdgth.2023.952433> ;
            slr:claim_label "The contribution is framed as building a known behavioural fact into the model architecture rather than as chasing accuracy - and the ablation across three problems then shows that per-stimulus weighting helps when group differences are selective across stimuli and not when they are uniform." ;
            slr:relevance_score "0.91"^^xsd:float ],
        [ a oa:Annotation ;
            oa:hasBody [ a dcterms:Text ;
                    rdf:value "it is also important to consider the ethical implications of early screening in educational settings, including the risk of stigmatization and the responsible use of the generated information. Screening should be understood as an initial support for identifying warning signs and guiding the search for specialized clinical evaluation, not as a definitive diagnosis." ] ;
            oa:hasTarget <urn:slr:article:b4a900945ede> ;
