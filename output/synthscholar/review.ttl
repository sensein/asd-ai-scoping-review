    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "low" ;
                    slr:supporting_quote "All predictors derive from the eye-tracking record; no clinical instrument score, diagnostic measure or demographic variable enters the feature set. Algorithms were selected for interpretability and the four feature sets are pre-defined by granularity rather than by label-driven selection." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "Participant-level stratified 5-fold cross-validation with one row per child and no within-participant duplication. However, up to 158 variables are used for 93 children, no interval or fold variance is reported, and the headline figures are the best over four feature sets, several algorithms and four group comparisons with no correction." ],
                [ a slr:RoBDomainJudgment ;
