    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "The 300/100 image split is stated and applied to all participants, but the split is over stimuli with all 28 children present in both partitions, and no per-participant accounting is given." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "No participant characteristics of any kind are reported - no ages, sexes, IQ, severity or recruitment route for either the 14 autistic or 14 typically developing children - and the paper's own Discussion identifies age as decisive for the behaviour being modelled." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Twenty-three classifiers and a three-parameter hyperparameter grid were compared before selection, with the selection table (68.5%) and the test result (0.59) left unreconciled; features are computed per subject-image pair so the classifier operates on scanpaths rather than children." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "The autism label is inherited from the benchmark with no diagnostic instrument, criterion or clinician role reported, and no summary of the source dataset's ascertainment." ] ;
            slr:overall_judgment "high" ;
