    slr:journal "Frontiers in Digital Health, 7, Article" ;
    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Raw audio from unspecified recording equipment under unspecified conditions, with no acoustic normalisation or channel compensation reported, in a corpus where the two binary classes were recorded in different physical environments. No task or elicitation is described for either corpus, so the prosodic signal cannot be separated from differences in what the children were doing." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Two convenience corpora assembled for other purposes. One contains only autistic children with no control group; the other contains clinical and typical groups recorded in different physical settings. Participant counts are internally inconsistent - 64 typically developing children are claimed within a corpus stated to have 67 participants in total, leaving three for all three atypical classes - and per-class child counts are never given. No age distribution, cognitive level, language ability or socioeconomic information is reported for any group." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Labels inherited from the source corpora with no diagnostic procedure, instrument, criteria or clinician qualification described for either. The CPSD categories are pre-DSM-5, PDD-NOS having been eliminated in 2013, so the four-class task reproduces a superseded nosology. The typically developing group is defined only by absence of prior difficulties." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "unclear" ;
                    slr:supporting_quote "Partition sizes are reported completely for all classes and all evaluation sets, splitting is speaker-disjoint with the rationale stated, a development partition is maintained separately from test, and minority-class upsampling is confined to training with evaluation distributions left intact - all better than the corpus norm. But the development-to-test inversion (78.0% against 94.8%) is unexplained, the number of speakers per class is unknown, and no uncertainty estimate accompanies any figure." ] ;
            slr:overall_judgment "high" ;
            slr:tool_used "QUADAS-2" ] .

<https://doi.org/10.3389/fpsyt.2022.899521> a fabio:Expression,
