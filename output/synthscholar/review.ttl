    slr:journal "International Journal of Intelligent Engineering and Systems, 18(3)" ;
    slr:risk_of_bias_assessment [ a slr:RiskOfBiasAssessment ;
            slr:domain_judgments [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Flow and timing" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Single unrepeated image-level split with no deduplication on a corpus known to repeat faces; a 200-image test set supporting a four-way ranking claim; validation accuracy 4.5 points below test accuracy on equal-sized partitions, reported without comment." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Reference standard" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Labels are folder assignments on web-sourced photographs. No clinical diagnosis, instrument, criterion or assessor exists for any image, and the labelling process is not described at all." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Patient selection" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "No participants. Images from a public web-scraped corpus with no recruitment, eligibility, provenance or demographic information; the number of distinct children is unknown and duplicates are acknowledged to exist in the corpus but not removed. Class counts are not reported for any partition." ],
                [ a slr:RoBDomainJudgment ;
                    slr:domain_name "Index test" ;
                    slr:judgment "high" ;
                    slr:supporting_quote "Architecture partially described but with neither novel component parameterised, no epoch or batch count, no seed, no augmentation list and no ablation isolating any stage. Preprocessing and augmentation ordering relative to the split is unstated." ] ;
            slr:overall_judgment "high" ;
            slr:tool_used "QUADAS-2" ] .

<https://doi.org/10.22266/ijies2025.0531.01> a fabio:Expression,
        slr:IncludedSource ;
    dcterms:abstract "Autism Spectrum Disorder (ASD) is a neurodevelopmental disorder with ineffective brain functions leading to challenges in verbal and non-verbal communication, social behavior, and learning disabilities. Early detection of ASD in children can help determine the required therapies to stabilize physical and psychological behaviors. The accurate diagnosis of ASD has been primarily obtained through analysis of behavioral changes and facial features. Estimating the presence of ASD in children from static facial images is very challenging due to many challenges in the quality and resolution of the images. This paper develops an advanced Deep Learning (DL)-based framework of DeepDeblur-Denoising Optimized Convolutional Neural Network (DeepDeblur-DOCNN) for screening and detection of ASD in children images with the presence of noise and blur. The proposed DeepDeblurDOCNN framework utilizes the DeepDeblur method in the first stage for image sharpening. Then, it employs a novel DOCNN in the second stage for joint denoising and classification. In this proposed DeepDeblur-DOCNN framework, the DOCNN is enhanced by combining the features of denoising network and CNN with Fire Hawk Optimizer (FHO) for parameter tuning to improve the training process. By combining denoising and classification tasks in a single DOCNN, the model can leverage the denoised image and perform better feature learning for more accurate classification predictions. Experiments are conducted using the Kaggle ASD Children Facial dataset containing 2940 facial images. The results showed that the proposed model is more effective for ASD diagnosis, with 96.94% detection accuracy with reduced model complexity." ;
    dcterms:bibliographicCitation "Vijayan N; Vanitha DV (2025). Received: October 26, 2024. Revised: March 1, 2025. 1. *International Journal of Intelligent Engineering and Systems, 18(4*. https://doi.org/10.22266/ijies2025.0531.01" ;
    dcterms:creator "Vanitha DV",
        "Vijayan N" ;
    dcterms:title "Received: October 26, 2024. Revised: March 1, 2025. 1" ;
    bibo:doi "10.22266/ijies2025.0531.01" ;
    bibo:pmid "local_e04bcd32" ;
    fabio:hasPublicationYear 2025 ;
    slr:appraisal [ a slr:CriticalAppraisal ;
            slr:domain_1_sample [ a slr:SamplePopulationDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Participants appropriate to the question" ;
                            slr:justification "No participants; unlabelled web-sourced photographs with unknown numbers of distinct children." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Data source and eligibility described" ;
                            slr:justification "Kaggle source and class balance stated; no provenance, eligibility, collection method or demographics." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Sample size justified" ;
                            slr:justification "No justification; image count treated as sample size and the whole dataset used as the evaluation set." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_2_data_collection [ a slr:DataCollectionDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Predictors defined and measured appropriately" ;
                            slr:justification "Resizing described as discarding pixels precedes a pipeline whose purpose is information recovery; output resolution unstated." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Predictors assessed blind to outcome" ;
                            slr:justification "Feature learning is automatic and label-independent, but the Fire Hawk Optimizer tuned parameters against an unstated objective on an unstated partition." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Image-quality claims supportable" ;
                            slr:justification "PSNR, MSE and SSIM require a sharp ground-truth reference that does not exist for web-downloaded photographs; how references were obtained is never stated." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_3_methods [ a slr:MethodsAnalysisDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Outcome determined independently of predictors" ;
                            slr:justification "Formally independent, but the label's own validity is unestablished." ;
                            slr:rating "Unclear" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Outcome definition and ascertainment" ;
                            slr:justification "Outcome is a Kaggle folder label; no clinical ascertainment of any kind." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ;
            slr:domain_4_bias_transparency [ a slr:BiasTransparencyDomain ;
                    slr:items [ a slr:AppraisalItem ;
                            slr:item_text "Comparison appropriate" ;
                            slr:justification "Ranked against five literature figures on different image counts and unstated protocols, asserted to be under the same conditions to ensure fair comparison, while this study's own figure is a training-set score." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Performance measures adequate" ;
                            slr:justification "No specificity, no numeric AUC, no calibration, no confidence intervals; the reported figures reconcile with a confusion matrix over the full dataset rather than a held-out set." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Limitations and overinterpretation" ;
                            slr:justification "No limitations section, no future work, no ethics statement; presented as effective for ASD diagnosis with reduced complexity." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Analysis unit matches the clinical claim" ;
                            slr:justification "Claims concern screening children; metrics are computed over images with unknown per-child counts." ;
                            slr:rating "High" ],
                        [ a slr:AppraisalItem ;
                            slr:item_text "Validation design guards against optimism" ;
                            slr:justification "The defined 400-image test set is never used; the reported accuracy is computed over all 2,940 images, 86% of which were training images." ;
                            slr:rating "High" ] ;
                    slr:overall_concern "high" ] ] ;
    slr:charting_record [ a slr:ChartingRecord ;
            slr:custom_charting_answer [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No fusion of modalities - a single image source. The pipeline stacks three processing stages (deblurring, denoising, classification) over one photograph, which is depth rather than multimodality." ;
                    slr:question_id "RQ3.2" ;
                    slr:source_id "S-153" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "A two-stage pipeline: DeepDeblur, a convolution/deconvolution network learning a blurred-to-sharp mapping, followed by DOCNN, a CNN in which one layer set denoises and the next classifies, with a Fire Hawk Optimizer tuning parameters. Three separable components are each claimed as a contribution and none is ablated, so the reader cannot tell whether the deblurring stage, the denoising branch or the metaheuristic contributes anything to the classification result." ;
                    slr:question_id "RQ4.1" ;
                    slr:source_id "S-153" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Autism spectrum disorder; Face recognition; DeepDeblur; Denoising optimized convolutional neural network; Fire hawk optimizer. Four of five terms name pipeline components; face recognition rather than screening or classification is used for the task." ;
                    slr:question_id "RQ5.1" ;
                    slr:source_id "S-153" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "The stated goal is to make facial-image ASD screening robust to poor image quality by adding a deblurring stage and a joint denoising-classification network with metaheuristic parameter tuning. Headline findings: accuracy 96.94%, precision 97.28%, recall 96.62%, F-measure 96.95%, against five literature figures between 92.0% and 96.63%; and, for the deblurring stage, 91.22% blur removed with PSNR 32.75 dB and SSIM 0.96 against Deepblur, Wiener filtering and blind deconvolution." ;
                    slr:question_id "RQ2.1" ;
                    slr:source_id "S-153" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No task or paradigm. Static photographs with no stimulus, interaction or session. The construct measured is facial appearance, framed as a diagnostic route parallel to behavioural analysis." ;
                    slr:question_id "RQ2.3" ;
                    slr:source_id "S-153" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "ASD, autism spectrum disorder, autistic and non-autistic faces, autistic patients, children. The register is medical and dated: ASD is introduced as a neurodevelopmental disorder with ineffective brain functions and as a conventional developmental neuro-disorder, and deep learning is credited with developing interactive systems to assist in the reintegration and treatment of autistic patients. No autistic or community perspective appears." ;
                    slr:question_id "RQ1.2" ;
                    slr:source_id "S-153" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. No cognitive, adaptive, language or severity measure; none obtainable from photographs." ;
                    slr:question_id "RQ1.5" ;
                    slr:source_id "S-153" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No participants. 2,940 images from the Kaggle ASD Children Facial dataset, balanced at 1,470 autistic and 1,470 non-autistic - the fourteenth charted reuse of this corpus in the review. The number of distinct children is unknown and never raised, and the corpus is known to contain repeated images of the same faces. The paper states a split of 2,540 training images (1,270 per class) and 400 test images (200 per class), but the confusion matrix it then reports covers all 2,940 images, so the population behind the headline figure is the whole dataset rather than the held-out 400." ;
                    slr:question_id "RQ1.1" ;
                    slr:source_id "S-153" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. There is no limitations section, no threats-to-validity discussion and no caveat. The single occurrence of limitations is a generic sentence in the introduction about facial-feature analysis being affected by image quality and expression variation - which is the problem the paper sets out to solve, not a limitation of its solution. Nothing is said about the dataset's provenance, the absent diagnostic labels, the mismatch between the stated split and the reported evaluation, or the absence of any ablation." ;
                    slr:question_id "RQ2.7" ;
                    slr:source_id "S-153" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. Labels are Kaggle folder names on photographs of unknown provenance. No clinical diagnosis, instrument, criterion, assessor or date exists for a single image. The paper opens by observing correctly that there is no medical screening or test like a blood test or scan for ASD and that diagnosis requires developmental history and behavioural assessment - and then treats folder labels on downloaded photographs as sufficient ground truth for a diagnostic classifier." ;
                    slr:question_id "RQ1.4" ;
                    slr:source_id "S-153" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Accuracy, precision, recall, F-measure, a confusion matrix and an ROC curve for classification; percentage blur removed, PSNR, MSE and SSIM for deblurring. Specificity is not reported, no AUC value is given numerically, no calibration or predictive values appear, and no confidence interval accompanies any figure. The reported accuracy of 96.94% reconciles exactly with the confusion-matrix counts - 2,850 correct out of 2,940 - which is the problem rather than a reassurance, because 2,940 is the entire dataset and not the 400-image test set the methods section defines." ;
                    slr:question_id "RQ4.3" ;
                    slr:source_id "S-153" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. No saliency, attribution or feature analysis, and no ablation of the three pipeline stages. In a paper whose thesis is that image quality restoration improves ASD detection, no experiment isolates the contribution of restoration to the classification outcome - the deblurring metrics and the classification metrics are reported side by side but never linked." ;
                    slr:question_id "RQ4.4" ;
                    slr:source_id "S-153" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "2025 (received 26 October 2024, revised 1 March 2025). Framing is diagnostic and efficiency-oriented: the model is offered for screening and detection of ASD in children, as computer-aided diagnosis, and as achieving higher accuracy with reduced model complexity and less execution time. There is no limitations section and no future work; the contribution is stated entirely as a position above five quoted figures on the same public image corpus, and the paper's own account of why ASD diagnosis is difficult - that there is no blood test or scan and that developmental history and behaviour must be assessed - is not reconciled with what it then does." ;
                    slr:question_id "RQ5.3" ;
                    slr:source_id "S-153" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. No age, sex, ethnicity, geography, socioeconomic status or recruitment source for any image, and no acknowledgement that this information is absent. One of the studies the paper summarises in its own literature review notes that model reliability depends on dataset quality and race factors, so the concern is present in the article's field of view and is not applied to its own data." ;
                    slr:question_id "RQ1.3" ;
                    slr:source_id "S-153" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Resized, deblurred and denoised RGB face images at unstated resolution. Resizing is described as adjusting the facial image for ratio and resolution with the loss of pixels - an unusual admission that information is discarded before the pipeline whose purpose is to recover information begins." ;
                    slr:question_id "RQ4.2" ;
                    slr:source_id "S-153" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. There is no future-work section; the paper ends on the claim of higher accuracy with reduced model complexity." ;
                    slr:question_id "RQ2.9" ;
                    slr:source_id "S-153" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "International Journal of Intelligent Engineering and Systems 18(4) - an open-access computing journal, the same venue as local_6e7174c0. Review did not surface the mismatch between the stated 400-image test set and the 2,940-image evaluation, the absent ethics statement, or the reporting of reference-dependent image-quality metrics for photographs that have no sharp reference." ;
                    slr:question_id "RQ5.2" ;
                    slr:source_id "S-153" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Very low, with one distinctive problem. The dataset source, class balance, split sizes and MATLAB version are stated, and a 25-symbol notation table with loss definitions (L2, total variation, facial semantic, total) is provided - superficially detailed. But no architecture, learning rate, batch size, epoch count, image resolution, optimiser budget or search space is given; there is no code or seed; the reported result does not correspond to the stated split; and the deblurring evaluation reports PSNR, MSE and SSIM, all of which are computed against a sharp ground-truth reference image. No such reference exists for a photograph downloaded from the web. Either the blur was synthetically added to already-degraded web images so that a reference existed - in which case the deblurring result describes recovery from artificial corruption and says nothing about real image quality - or the metrics were computed against something unstated. The paper does not say which." ;
                    slr:question_id "RQ2.6" ;
                    slr:source_id "S-153" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "Cross-sectional. There is no ethics statement, no consent statement and no exemption claim, and no consideration of where photographs of identifiable children came from or under what terms they may be reused, deblurred, denoised and redistributed in figures - the paper reproduces sample faces at five processing stages in Figure 3." ;
                    slr:question_id "RQ2.4" ;
                    slr:source_id "S-153" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No acquisition instrumentation. Implementation in MATLAB R2021a. No toolbox versions, hardware, runtime, seed or code. The proposed pipeline's components - DeepDeblur, DOCNN and the Fire Hawk Optimizer - are described by loss functions and a notation table rather than by any reproducible configuration." ;
                    slr:question_id "RQ2.5" ;
                    slr:source_id "S-153" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "This study's decisive problem is that the reported result does not come from its stated evaluation design. The methods define an image-level split of 2,940 images into 2,540 for training and 400 for testing, balanced within each. The results section then states that out of 2,940 images used for evaluation the model correctly classified 1,430 autism images and 1,420 non-autism images, 2,850 correct with 90 misclassified - and 2,850/2,940 is precisely 96.94%, the headline accuracy carried into the abstract and the comparison table. The reported performance is therefore a resubstitution figure computed over the whole dataset, with 86% of the evaluated images having been used to fit the model. The 400-image test set is defined and never used to produce a number. Three further issues compound this. The corpus is the web-scraped autism face collection that repeats individuals, so even a correctly executed image-level split would not separate children. The Fire Hawk Optimizer tuned unspecified parameters against an unspecified objective on an unspecified partition. And the comparison table ranks 96.94% against five literature figures spanning 92.0% to 96.63% obtained on different image counts (2,636 to 3,014) under unstated protocols, with the paper asserting that the comparisons are done under the same conditions used in the existing methods to ensure fair comparison - a claim that cannot hold when this study's own figure is a training-set score." ;
                    slr:question_id "RQ4.5" ;
                    slr:source_id "S-153" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "None. No behaviour is observed, elicited or measured. The target is static facial appearance recovered from deblurring and denoising." ;
                    slr:question_id "RQ3.1" ;
                    slr:source_id "S-153" ],
                [ a slr:ChartingQuestionAnswer ;
                    slr:answer_text "No study setting. Images downloaded from Kaggle; experiments run in MATLAB R2021a with no hardware, runtime or environment described." ;
                    slr:question_id "RQ2.2" ;
                    slr:source_id "S-153" ] ;
            slr:section_b_design [ a slr:StudyDesign ;
                    slr:country_region "Deblurring: Deepblur, Wiener filtering and blind deconvolution. Classification: literature-quoted figures for MobileNet (94.6% on 3,014 images), CNN-Xception (96.63% on 2,636), MobileNetV2 (92.0% on 2" ;
                    slr:study_design "Retrospective secondary analysis of a public facial-image dataset; a two-stage deblurring-plus-classification pipeline with metaheuristic parameter tuning, evaluated on a stated im…" ] ;
            slr:section_c_primary_sample [ a slr:PrimarySample ;
                    slr:population_studied "Autism spectrum disorder" ;
                    slr:sample_size_text "ASD/index: 1,470 autistic images; comparison: 1,470 non-autistic images" ] ;
            slr:section_f_methods_results [ a slr:MethodsAndResults ;
                    slr:key_results "Accuracy 96.94%, precision 97.28%, recall 96.62%, F-measure 96.95%. Deblurring: 91.22% blur removed, PSNR 32.75 dB, MSE 0.115, SSIM 0.96, against Deepblur (87.67%, 30.43 dB, 0.176, 0.77), Wiener filtering and blind deconvolution." ;
                    slr:outcome "Classification: accuracy, precision, recall, F-measure, a confusion matrix and an ROC curve. Deblurring: percentage blur removed, PSNR, MSE and SSIM." ] ;
            slr:section_g_synthesis [ a slr:SynthesisFields ;
                    slr:summary_of_findings "Accuracy 96.94%, precision 97.28%, recall 96.62%, F-measure 96.95%. Deblurring: 91.22% blur removed, PSNR 32.75 dB, MSE 0.115, SSIM 0.96, against Deepblur (87.67%, 30.43 dB, 0.176, 0.77), Wiener filtering and blind deconvolution." ] ] ;
    slr:content_sha256 "307c37714b6acc9ecb37da34fb311db5409a1ad9b18eed060c02c9869224ab40" ;
